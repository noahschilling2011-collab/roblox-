</Properties>
<Item class="LocalScript" referent="PF37">
<Properties>
<string name="Name">Client</string>
<ProtectedString name="Source">--!strict
-- Einstiegspunkt des Clients: startet alle Controller in fester Reihenfolge.
-- Konvention: Jeder Controller liegt unter Controllers/&lt;Name&gt;.luau und exportiert
-- eine Tabelle mit einer init()-Funktion.

local CONTROLLER_STARTUP_ORDER = {
	"EffectsController", -- zuerst: stellt Sounds/Effekte für alle anderen bereit
	"UIController",
	"PlanetBuilderController",
	"EventNotifierController",
	"ShopController",
	"LeaderboardController",
	"PlanetNameController",
	"TutorialController",
}

local controllersFolder = script:WaitForChild("Controllers")

for _, controllerName in CONTROLLER_STARTUP_ORDER do
	local moduleInstance = controllersFolder:WaitForChild(controllerName) :: ModuleScript
	local controller = (require)(moduleInstance) :: { init: () -&gt; () }

	-- Controller dürfen in init() auf Remotes warten, deshalb entkoppelt starten.
	task.spawn(function()
		local ok, err = pcall(controller.init)
		if ok then
			print(`[PlanetForge] {controllerName} gestartet`)
		else
			warn(`[PlanetForge] {controllerName} konnte nicht starten: {err}`)
		end
	end)
end
</ProtectedString>
</Properties>
<Item class="Folder" referent="PF36">
<Properties>
<string name="Name">Controllers</string>
</Properties>
<Item class="ModuleScript" referent="PF28">
<Properties>
<string name="Name">EffectsController</string>
<ProtectedString name="Source">--!strict
-- EffectsController: zentrales "Juice"-Modul des Clients.
--
-- Bietet anderen Controllern Sounds, fliegende Energie-Zahlen, Partikel-
-- Bursts am eigenen Planeten und Screen-Shake an. Alle Sounds hängen an
-- einer SoundGroup in SoundService; die Gesamtlautstärke kommt zentral aus
-- GameConfig.SOUND_MASTER_VOLUME. Es werden ausschließlich Engine-eigene
-- rbxasset://-Sounddateien verwendet (immer verfügbar, keine Moderation).
--
-- Startet als ERSTER Controller, alle Funktionen sind aber auch vor init()
-- gefahrlos aufrufbar (sie tun dann einfach nichts).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ConfigFolder = Shared:WaitForChild("Config")

local GameConfig = require(ConfigFolder:WaitForChild("GameConfig") :: ModuleScript) :: {
	SOUND_MASTER_VOLUME: number,
}

local ACCENT_COLOR = Color3.fromRGB(214, 160, 72)

type SoundDef = { file: string, pitch: number, volume: number }

-- Nur Engine-Sounddateien (rbxasset://), damit nie etwas fehlt.
local SOUND_DEFS: { [string]: SoundDef } = {
	collect = { file = "rbxasset://sounds/electronicpingshort.wav", pitch = 1.15, volume = 0.6 },
	pop = { file = "rbxasset://sounds/snap.mp3", pitch = 1.0, volume = 0.7 },
	tick = { file = "rbxasset://sounds/electronicpingshort.wav", pitch = 1.7, volume = 0.18 },
	reveal = { file = "rbxasset://sounds/swoosh.wav", pitch = 1.0, volume = 0.8 },
	fanfare = { file = "rbxasset://sounds/impact_water.mp3", pitch = 1.35, volume = 0.8 },
}

local EffectsController = {}

local localPlayer = Players.LocalPlayer

local soundGroup: SoundGroup? = nil
local effectsGui: ScreenGui? = nil
local shakeCounter = 0

-- Spielt einen benannten Sound (optional mit abweichender Tonhöhe).
function EffectsController.playSound(name: string, pitchOverride: number?)
	local def = SOUND_DEFS[name]
	local group = soundGroup
	if def == nil or group == nil then
		return
	end

	local sound = Instance.new("Sound")
	sound.SoundId = def.file
	sound.Volume = def.volume
	sound.PlaybackSpeed = pitchOverride or def.pitch
	sound.SoundGroup = group
	sound.Parent = SoundService
	sound:Play()
	task.delay(4, function()
		sound:Destroy()
	end)
end

-- "+N ⚡" fliegt vom Sammel-Button hoch zum Energie-Zähler.
function EffectsController.flyEnergyToCounter(amount: number)
	local gui = effectsGui
	if gui == nil then
		return
	end

	local playerGui = localPlayer:FindFirstChild("PlayerGui")
	if playerGui == nil then
		return
	end
	local mainGui = playerGui:FindFirstChild("PlanetForgeUI")
	if mainGui == nil then
		return
	end
	local buttonBar = mainGui:FindFirstChild("ButtonBar")
	local header = mainGui:FindFirstChild("Header")
	local sourceButton = if buttonBar ~= nil then buttonBar:FindFirstChild("CollectEnergy") else nil
	local targetLabel = if header ~= nil then header:FindFirstChild("Energy") else nil
	if sourceButton == nil or not sourceButton:IsA("GuiObject") or targetLabel == nil or not targetLabel:IsA("GuiObject") then
		return
	end

	local source = (sourceButton :: GuiObject).AbsolutePosition
		+ (sourceButton :: GuiObject).AbsoluteSize / 2
	local target = (targetLabel :: GuiObject).AbsolutePosition
		+ (targetLabel :: GuiObject).AbsoluteSize / 2

	local label = Instance.new("TextLabel")
	label.Name = "FlyingEnergy"
	label.BackgroundTransparency = 1
	label.AnchorPoint = Vector2.new(0.5, 0.5)
	label.Position = UDim2.new(0, source.X, 0, source.Y)
	label.Size = UDim2.new(0, 120, 0, 24)
	label.Font = Enum.Font.GothamBold
	label.TextSize = 20
	label.TextColor3 = ACCENT_COLOR
	label.TextStrokeTransparency = 0.5
	label.Text = `+{amount} ⚡`
	label.Parent = gui

	local flight = TweenService:Create(
		label,
		TweenInfo.new(0.65, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
		{ Position = UDim2.new(0, target.X, 0, target.Y), TextSize = 12 }
	)
	flight:Play()
	flight.Completed:Once(function()
		local fade = TweenService:Create(label, TweenInfo.new(0.15), { TextTransparency = 1, TextStrokeTransparency = 1 })
		fade:Play()
		fade.Completed:Once(function()
			label:Destroy()
		end)
	end)
end

-- Kurzer Partikel-Burst am eigenen Planetenkern (rein lokal).
function EffectsController.burstAtOwnPlanet(color: Color3?)
	local plots = Workspace:FindFirstChild("PlanetPlots")
	local plot = if plots ~= nil then plots:FindFirstChild(`Plot_{localPlayer.UserId}`) else nil
	local core = if plot ~= nil then plot:FindFirstChild("Core") else nil
	if core == nil or not core:IsA("BasePart") then
		return
	end

	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "LocalBurst"
	local burstColor = color or ACCENT_COLOR
	emitter.Color = ColorSequence.new(burstColor)
	emitter.LightEmission = 0.7
	emitter.Rate = 0
	emitter.Lifetime = NumberRange.new(0.4, 0.9)
	emitter.Speed = NumberRange.new(8, 14)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Size = NumberSequence.new(0.7)
	emitter.Parent = core
	emitter:Emit(14)
	task.delay(1.5, function()
		emitter:Destroy()
	end)
end

-- Kurzer, abklingender Screen-Shake (z. B. bei legendären Funden).
function EffectsController.screenShake(intensity: number?)
	local camera = Workspace.CurrentCamera
	if camera == nil then
		return
	end

	local strength = intensity or 1
	local duration = 0.35
	shakeCounter += 1
	local bindName = `PlanetForgeShake_{shakeCounter}`
	local rng = Random.new()
	local startedAt = os.clock()

	RunService:BindToRenderStep(bindName, Enum.RenderPriority.Camera.Value + 1, function()
		local elapsed = os.clock() - startedAt
		if elapsed &gt;= duration then
			RunService:UnbindFromRenderStep(bindName)
			return
		end
		local falloff = 1 - elapsed / duration
		local amplitude = 0.35 * strength * falloff
		local offset = CFrame.new(
			rng:NextNumber(-amplitude, amplitude),
			rng:NextNumber(-amplitude, amplitude),
			0
		) * CFrame.Angles(0, 0, math.rad(rng:NextNumber(-1, 1) * strength * falloff))
		camera.CFrame = camera.CFrame * offset
	end)
end

function EffectsController.init()
	-- Zentrale SoundGroup mit Lautstärke aus GameConfig.
	local group = Instance.new("SoundGroup")
	group.Name = "PlanetForgeSounds"
	group.Volume = math.clamp(GameConfig.SOUND_MASTER_VOLUME, 0, 1)
	group.Parent = SoundService
	soundGroup = group

	-- Eigene Ebene für fliegende Zahlen und ähnliche Overlay-Effekte.
	local playerGui = localPlayer:WaitForChild("PlayerGui")
	local gui = Instance.new("ScreenGui")
	gui.Name = "PlanetForgeEffects"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 30
	gui.Parent = playerGui
	effectsGui = gui
end

return EffectsController
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="PF29">
<Properties>
<string name="Name">EventNotifierController</string>
<ProtectedString name="Source">--!strict
-- EventNotifierController: zeigt globale Live-Events als Banner oben Mitte an.
-- Pro Event ein dezenter Farbakzent, Countdown "endet in M:SS" (jede Sekunde
-- aktualisiert). Während "schwarzes_loch" wird zusätzlich ein
-- ColorCorrectionEffect (Saturation -0.5) in Lighting gesetzt und danach
-- sauber wieder entfernt.

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ConfigFolder = Shared:WaitForChild("Config")
local ControllersFolder = script.Parent :: Instance

local Remotes = require(Shared:WaitForChild("Remotes") :: ModuleScript) :: {
	getEvent: (name: string) -&gt; RemoteEvent,
	getFunction: (name: string) -&gt; RemoteFunction,
}
local EventConfig = require(ConfigFolder:WaitForChild("EventConfig") :: ModuleScript) :: {
	Events: { [string]: { id: string, displayName: string, announceText: string } },
}
local UIController = require(ControllersFolder:WaitForChild("UIController") :: ModuleScript) :: {
	showToast: (message: string, kind: string) -&gt; (),
}

-- Farbschema (identisch zum UIController).
local PANEL_COLOR = Color3.fromRGB(30, 32, 44)
local TEXT_COLOR = Color3.fromRGB(235, 238, 245)
local SUBTEXT_COLOR = Color3.fromRGB(158, 164, 186)

-- Dezenter Farbakzent pro Event.
local ACCENT_COLORS: { [string]: Color3 } = {
	meteoritenschauer = Color3.fromRGB(255, 150, 70),
	goldener_regen = Color3.fromRGB(255, 210, 90),
	kreaturen_spawn = Color3.fromRGB(120, 220, 130),
	alien_invasion = Color3.fromRGB(170, 110, 255),
	schwarzes_loch = Color3.fromRGB(140, 120, 255),
}
local DEFAULT_ACCENT = Color3.fromRGB(66, 133, 244)

local BLACK_HOLE_EVENT_ID = "schwarzes_loch"
local FADE_SECONDS = 0.4

local EventNotifierController = {}

-- Restsekunden -&gt; "M:SS" (z. B. 95 -&gt; "1:35").
local function formatCountdown(seconds: number): string
	local clamped = math.max(0, math.floor(seconds))
	local minutes = clamped // 60
	local remainder = clamped % 60
	return `{minutes}:{string.format("%02d", remainder)}`
end

local function addCorner(parent: Instance, radius: number)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = parent
end

local function createLabel(parent: Instance, name: string, text: string): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamMedium
	label.TextColor3 = TEXT_COLOR
	label.TextSize = 14
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Text = text
	label.Parent = parent
	return label
end

function EventNotifierController.init()
	local player = Players.LocalPlayer
	local playerGui = player:WaitForChild("PlayerGui") :: PlayerGui

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "PlanetForgeEventUI"
	screenGui.ResetOnSpawn = false
	screenGui.IgnoreGuiInset = true
	screenGui.DisplayOrder = 8

	-- Banner oben Mitte (unterhalb der Kopfleiste des UIControllers).
	local banner = Instance.new("CanvasGroup")
	banner.Name = "EventBanner"
	banner.AnchorPoint = Vector2.new(0.5, 0)
	banner.Position = UDim2.new(0.5, 0, 0, 60)
	banner.Size = UDim2.new(0, 480, 0, 78)
	banner.BackgroundColor3 = PANEL_COLOR
	banner.Visible = false
	addCorner(banner, 12)

	local stroke = Instance.new("UIStroke")
	stroke.Color = DEFAULT_ACCENT
	stroke.Thickness = 2
	stroke.Parent = banner

	local titleLabel = createLabel(banner, "Title", "")
	titleLabel.Position = UDim2.new(0, 16, 0, 10)
	titleLabel.Size = UDim2.new(1, -180, 0, 22)
	titleLabel.Font = Enum.Font.GothamBold
	titleLabel.TextSize = 18

	local countdownLabel = createLabel(banner, "Countdown", "")
	countdownLabel.AnchorPoint = Vector2.new(1, 0)
	countdownLabel.Position = UDim2.new(1, -16, 0, 12)
	countdownLabel.Size = UDim2.new(0, 150, 0, 20)
	countdownLabel.TextSize = 14
	countdownLabel.TextXAlignment = Enum.TextXAlignment.Right

	local announceLabel = createLabel(banner, "Announce", "")
	announceLabel.Position = UDim2.new(0, 16, 0, 36)
	announceLabel.Size = UDim2.new(1, -32, 0, 34)
	announceLabel.TextSize = 13
	announceLabel.TextColor3 = SUBTEXT_COLOR
	announceLabel.TextWrapped = true
	announceLabel.TextYAlignment = Enum.TextYAlignment.Top

	banner.Parent = screenGui
	screenGui.Parent = playerGui

	-- Generation entwertet alte Countdown-Schleifen, wenn ein neues Event
	-- startet oder das aktuelle endet.
	local generation = 0
	local activeTween: Tween? = nil
	local colorCorrection: ColorCorrectionEffect? = nil

	local function cancelActiveTween()
		local tween = activeTween
		if tween ~= nil then
			tween:Cancel()
			activeTween = nil
		end
	end

	-- Lighting-Effekt für das Schwarze Loch setzen bzw. sauber entfernen.
	local function setBlackHoleEffect(enabled: boolean)
		if enabled then
			if colorCorrection == nil then
				local effect = Instance.new("ColorCorrectionEffect")
				effect.Name = "PlanetForgeSchwarzesLoch"
				effect.Saturation = -0.5
				effect.Parent = Lighting
				colorCorrection = effect
			end
		else
			local effect = colorCorrection
			if effect ~= nil then
				effect:Destroy()
				colorCorrection = nil
			end
		end
	end

	local function hideBanner()
		if not banner.Visible then
			return
		end
		cancelActiveTween()
		local tween = TweenService:Create(banner, TweenInfo.new(FADE_SECONDS), { GroupTransparency = 1 })
		activeTween = tween
		tween:Play()
		tween.Completed:Once(function()
			-- Nur verstecken, wenn nicht inzwischen ein neues Event läuft.
			if activeTween == tween then
				banner.Visible = false
				activeTween = nil
			end
		end)
	end

	local function onEventStarted(eventId: any, endsAt: any)
		if typeof(eventId) ~= "string" or typeof(endsAt) ~= "number" then
			return
		end
		local def = EventConfig.Events[eventId]
		if def == nil then
			warn(`[PlanetForge] Unbekanntes globales Event vom Server: {eventId}`)
			return
		end

		generation += 1
		local myGeneration = generation

		local accent = ACCENT_COLORS[eventId] or DEFAULT_ACCENT
		titleLabel.Text = def.displayName
		titleLabel.TextColor3 = accent
		announceLabel.Text = def.announceText
		stroke.Color = accent
		countdownLabel.Text = `endet in {formatCountdown(endsAt - os.time())}`

		cancelActiveTween()
		banner.GroupTransparency = 0
		banner.Visible = true

		setBlackHoleEffect(eventId == BLACK_HOLE_EVENT_ID)

		-- Countdown jede Sekunde aktualisieren; bei Ablauf selbst ausblenden
		-- (falls GlobalEventEnded z. B. durch einen Rejoin verpasst wurde).
		task.spawn(function()
			while generation == myGeneration do
				local remaining = endsAt - os.time()
				if remaining &lt;= 0 then
					break
				end
				countdownLabel.Text = `endet in {formatCountdown(remaining)}`
				task.wait(1)
			end
			if generation == myGeneration then
				generation += 1
				hideBanner()
				setBlackHoleEffect(false)
			end
		end)
	end

	local function onEventEnded(_eventId: any)
		generation += 1
		hideBanner()
		setBlackHoleEffect(false)
		UIController.showToast("Event vorbei", "info")
	end

	Remotes.getEvent("GlobalEventStarted").OnClientEvent:Connect(onEventStarted)
	Remotes.getEvent("GlobalEventEnded").OnClientEvent:Connect(onEventEnded)
end

return EventNotifierController
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="PF30">
<Properties>
<string name="Name">LeaderboardController</string>
<ProtectedString name="Source">--!strict
-- LeaderboardController: Ranglisten-Panel (🏆) am rechten Bildschirmrand.
-- Zeigt die globalen Top-Listen "Meiste Likes" und "Meiste Gesamt-Energie"
-- aus dem LeaderboardUpdated-Event. Die Server-Spielerliste (leaderstats)
-- ergänzt das um die Live-Werte im aktuellen Server.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")

local Remotes = require(Shared:WaitForChild("Remotes") :: ModuleScript) :: {
	getEvent: (name: string) -&gt; RemoteEvent,
	getFunction: (name: string) -&gt; RemoteFunction,
}

type LeaderboardEntry = { userId: number, name: string, value: number }
type LeaderboardSnapshot = { likes: { LeaderboardEntry }, energy: { LeaderboardEntry } }

-- Farbschema (identisch zum UIController).
local PANEL_COLOR = Color3.fromRGB(30, 32, 44)
local ROW_COLOR = Color3.fromRGB(44, 47, 63)
local STROKE_COLOR = Color3.fromRGB(70, 75, 100)
local TEXT_COLOR = Color3.fromRGB(235, 238, 245)
local SUBTEXT_COLOR = Color3.fromRGB(158, 164, 186)
local SECTION_COLOR = Color3.fromRGB(214, 160, 72)
local HIGHLIGHT_COLOR = Color3.fromRGB(120, 90, 200) -- eigene Platzierung

local PANEL_WIDTH = 280

local LeaderboardController = {}

local localPlayer = Players.LocalPlayer

local listFrame: Frame? = nil
local lastSnapshot: LeaderboardSnapshot = { likes = {}, energy = {} }

local function addCorner(instance: Instance, radius: number)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = instance
end

local function addStroke(instance: Instance, color: Color3)
	local stroke = Instance.new("UIStroke")
	stroke.Color = color
	stroke.Thickness = 1
	stroke.Parent = instance
end

-- Tausendertrennung mit Punkt (1.234.567).
local function formatNumber(value: number): string
	local text = tostring(math.floor(value))
	local formatted = text
	while true do
		local replaced, count = string.gsub(formatted, "^(-?%d+)(%d%d%d)", "%1.%2")
		formatted = replaced
		if count == 0 then
			break
		end
	end
	return formatted
end

-- Baut die Listen im Panel neu auf.
local function rebuildList()
	local frame = listFrame
	if frame == nil then
		return
	end
	for _, child in frame:GetChildren() do
		if not child:IsA("UIListLayout") then
			child:Destroy()
		end
	end

	local order = 0

	local function addSection(title: string, entries: { LeaderboardEntry }, unit: string)
		order += 1
		local header = Instance.new("TextLabel")
		header.Name = `Header_{order}`
		header.BackgroundTransparency = 1
		header.Size = UDim2.new(1, 0, 0, 22)
		header.Font = Enum.Font.GothamBold
		header.TextSize = 13
		header.TextColor3 = SECTION_COLOR
		header.TextXAlignment = Enum.TextXAlignment.Left
		header.Text = title
		header.LayoutOrder = order
		header.Parent = frame

		if #entries == 0 then
			order += 1
			local hint = Instance.new("TextLabel")
			hint.Name = `Hint_{order}`
			hint.BackgroundTransparency = 1
			hint.Size = UDim2.new(1, 0, 0, 30)
			hint.Font = Enum.Font.GothamMedium
			hint.TextSize = 11
			hint.TextColor3 = SUBTEXT_COLOR
			hint.TextWrapped = true
			hint.TextXAlignment = Enum.TextXAlignment.Left
			hint.Text = "Noch keine Einträge - die Liste aktualisiert sich alle 2 Minuten."
			hint.LayoutOrder = order
			hint.Parent = frame
			return
		end

		for rank, entry in entries do
			order += 1
			local row = Instance.new("Frame")
			row.Name = `Row_{order}`
			row.Size = UDim2.new(1, 0, 0, 26)
			row.BackgroundColor3 = if entry.userId == localPlayer.UserId then HIGHLIGHT_COLOR else ROW_COLOR
			row.LayoutOrder = order
			addCorner(row, 6)
			row.Parent = frame

			local rankLabel = Instance.new("TextLabel")
			rankLabel.BackgroundTransparency = 1
			rankLabel.Position = UDim2.new(0, 8, 0, 0)
			rankLabel.Size = UDim2.new(0, 24, 1, 0)
			rankLabel.Font = Enum.Font.GothamBold
			rankLabel.TextSize = 12
			rankLabel.TextColor3 = SECTION_COLOR
			rankLabel.TextXAlignment = Enum.TextXAlignment.Left
			rankLabel.Text = `{rank}.`
			rankLabel.Parent = row

			local nameLabel = Instance.new("TextLabel")
			nameLabel.BackgroundTransparency = 1
			nameLabel.Position = UDim2.new(0, 34, 0, 0)
			nameLabel.Size = UDim2.new(1, -120, 1, 0)
			nameLabel.Font = Enum.Font.GothamMedium
			nameLabel.TextSize = 12
			nameLabel.TextColor3 = TEXT_COLOR
			nameLabel.TextXAlignment = Enum.TextXAlignment.Left
			nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
			nameLabel.Text = entry.name
			nameLabel.Parent = row

			local valueLabel = Instance.new("TextLabel")
			valueLabel.BackgroundTransparency = 1
			valueLabel.AnchorPoint = Vector2.new(1, 0)
			valueLabel.Position = UDim2.new(1, -8, 0, 0)
			valueLabel.Size = UDim2.new(0, 84, 1, 0)
			valueLabel.Font = Enum.Font.GothamBold
			valueLabel.TextSize = 12
			valueLabel.TextColor3 = TEXT_COLOR
			valueLabel.TextXAlignment = Enum.TextXAlignment.Right
			valueLabel.Text = `{formatNumber(entry.value)} {unit}`
			valueLabel.Parent = row
		end
	end

	addSection("❤️ Meiste Likes", lastSnapshot.likes, "Likes")
	addSection("⚡ Meiste Gesamt-Energie", lastSnapshot.energy, "")
end

local function buildUI()
	local playerGui = localPlayer:WaitForChild("PlayerGui")

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "PlanetForgeLeaderboard"
	screenGui.ResetOnSpawn = false
	screenGui.Parent = playerGui

	local toggleButton = Instance.new("TextButton")
	toggleButton.Name = "LeaderboardToggle"
	toggleButton.AnchorPoint = Vector2.new(1, 0.5)
	toggleButton.Position = UDim2.new(1, -12, 0.25, 0)
	toggleButton.Size = UDim2.new(0, 110, 0, 40)
	toggleButton.BackgroundColor3 = PANEL_COLOR
	toggleButton.Font = Enum.Font.GothamBold
	toggleButton.TextSize = 14
	toggleButton.TextColor3 = TEXT_COLOR
	toggleButton.Text = "🏆 Rangliste"
	addCorner(toggleButton, 10)
	addStroke(toggleButton, STROKE_COLOR)
	toggleButton.Parent = screenGui

	local panel = Instance.new("ScrollingFrame")
	panel.Name = "LeaderboardPanel"
	panel.AnchorPoint = Vector2.new(1, 0)
	panel.Position = UDim2.new(1, -130, 0.25, -20)
	panel.Size = UDim2.new(0, PANEL_WIDTH, 0.55, 0)
	panel.BackgroundColor3 = PANEL_COLOR
	panel.ScrollBarThickness = 6
	panel.AutomaticCanvasSize = Enum.AutomaticSize.Y
	panel.CanvasSize = UDim2.new(0, 0, 0, 0)
	panel.Visible = false
	addCorner(panel, 12)
	addStroke(panel, STROKE_COLOR)
	panel.Parent = screenGui

	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, 10)
	padding.PaddingBottom = UDim.new(0, 10)
	padding.PaddingLeft = UDim.new(0, 10)
	padding.PaddingRight = UDim.new(0, 10)
	padding.Parent = panel

	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, 4)
	layout.Parent = panel

	toggleButton.Activated:Connect(function()
		panel.Visible = not panel.Visible
	end)

	listFrame = panel
	rebuildList()
end

function LeaderboardController.init()
	Remotes.getEvent("LeaderboardUpdated").OnClientEvent:Connect(function(snapshot: any)
		if typeof(snapshot) ~= "table" then
			return
		end
		local likes = if typeof(snapshot.likes) == "table" then snapshot.likes else {}
		local energy = if typeof(snapshot.energy) == "table" then snapshot.energy else {}
		lastSnapshot = { likes = likes, energy = energy }
		rebuildList()
	end)

	buildUI()
end

return LeaderboardController
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="PF31">
<Properties>
<string name="Name">PlanetBuilderController</string>
<ProtectedString name="Source">--!strict
-- PlanetBuilderController: Bau-Menü am linken Bildschirmrand.
-- Aufklappbares Panel "Biome" (Kauf über PlaceBiome) und Abschnitt
-- "Meine Slots" mit den 12 Planeten-Slots (Upgrade über UpgradeBiome).
-- Der letzte PlanetUpdated-Snapshot wird lokal gecacht, um freie Slots und
-- Upgrade-Kosten anzuzeigen; der Server bleibt autoritativ.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ConfigFolder = Shared:WaitForChild("Config")
local ControllersFolder = script.Parent :: Instance

local Remotes = require(Shared:WaitForChild("Remotes") :: ModuleScript) :: {
	getEvent: (name: string) -&gt; RemoteEvent,
	getFunction: (name: string) -&gt; RemoteFunction,
}
local GameConfig = require(ConfigFolder:WaitForChild("GameConfig") :: ModuleScript) :: {
	PLANET_SLOTS: number,
}

type BiomeDef = {
	id: string,
	displayName: string,
	baseCost: number,
	maxLevel: number,
	color: Color3,
	unlockAtLifetimeEnergy: number,
}
type PlacedBiome = { biomeId: string, slot: number, level: number, placedAt: number }
type PlanetSnapshot = { biomes: { PlacedBiome }, visits: number, likes: number }
type BiomeRow = { button: TextButton, swatch: Frame, nameLabel: TextLabel, costLabel: TextLabel, lockLabel: TextLabel }
type SlotRow = { infoLabel: TextLabel, upgradeButton: TextButton }

local BiomeConfig = require(ConfigFolder:WaitForChild("BiomeConfig") :: ModuleScript) :: {
	Biomes: { [string]: BiomeDef },
	getSortedIds: () -&gt; { string },
	getUpgradeCost: (biomeId: string, currentLevel: number) -&gt; number,
}
local UIController = require(ControllersFolder:WaitForChild("UIController") :: ModuleScript) :: {
	showToast: (message: string, kind: string) -&gt; (),
}

-- Farbschema (identisch zum UIController).
local PANEL_COLOR = Color3.fromRGB(30, 32, 44)
local ROW_COLOR = Color3.fromRGB(44, 47, 63)
local STROKE_COLOR = Color3.fromRGB(70, 75, 100)
local TEXT_COLOR = Color3.fromRGB(235, 238, 245)
local SUBTEXT_COLOR = Color3.fromRGB(158, 164, 186)
local LOCKED_TEXT_COLOR = Color3.fromRGB(110, 114, 132)
local LOCK_HINT_COLOR = Color3.fromRGB(214, 160, 72)
local CANNOT_AFFORD_COLOR = Color3.fromRGB(214, 110, 110)
local UPGRADE_BUTTON_COLOR = Color3.fromRGB(52, 96, 178)
local UPGRADE_MAX_COLOR = Color3.fromRGB(60, 64, 84)

local PlanetBuilderController = {}

-- Lokaler Cache aus PlanetUpdated / EnergyChanged.
local lastSnapshot: PlanetSnapshot? = nil
local currentEnergy = 0
local lifetimeEnergy = 0

local biomeRows: { [string]: BiomeRow } = {}
local slotRows: { SlotRow } = {}

-- 1234567 -&gt; "1.234.567" (deutsche Tausendertrennung mit Punkt).
local function formatNumber(value: number): string
	local text = tostring(math.floor(value + 0.5))
	while true do
		local replaced: number
		text, replaced = text:gsub("^(-?%d+)(%d%d%d)", "%1.%2")
		if replaced == 0 then
			break
		end
	end
	return text
end

local function addCorner(parent: Instance, radius: number)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = parent
end

local function createLabel(parent: Instance, name: string, text: string, position: UDim2, size: UDim2): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamMedium
	label.TextColor3 = TEXT_COLOR
	label.TextSize = 13
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Text = text
	label.Position = position
	label.Size = size
	label.Parent = parent
	return label
end

-- Ruft eine RemoteFunction auf; bei ok=false erscheint die deutsche
-- Fehlermeldung des Servers als Toast, bei Erfolg optional eine Bestätigung.
local function invokeRemote(functionName: string, successMessage: string?, ...: any)
	local args = table.pack(...)
	task.spawn(function()
		local ok, serverOk, payload = pcall(function()
			return Remotes.getFunction(functionName):InvokeServer(table.unpack(args, 1, args.n))
		end)
		if not ok then
			UIController.showToast("Verbindungsfehler – bitte erneut versuchen.", "error")
		elseif serverOk ~= true then
			UIController.showToast(if typeof(payload) == "string" then payload else "Aktion fehlgeschlagen.", "error")
		elseif successMessage ~= nil then
			UIController.showToast(successMessage, "success")
		end
	end)
end

-- Klick auf eine Biom-Zeile: nächsten freien Slot suchen und kaufen.
local function onBiomeClicked(biomeId: string)
	local def = BiomeConfig.Biomes[biomeId]
	if def == nil then
		return
	end
	if lifetimeEnergy &lt; def.unlockAtLifetimeEnergy then
		UIController.showToast(
			`{def.displayName} ist noch gesperrt – ab {formatNumber(def.unlockAtLifetimeEnergy)} Gesamt-Energie.`,
			"error"
		)
		return
	end

	local snapshot = lastSnapshot
	if snapshot == nil then
		UIController.showToast("Dein Planet lädt noch – versuche es gleich erneut.", "error")
		return
	end

	local occupied: { [number]: boolean } = {}
	for _, placed in snapshot.biomes do
		occupied[placed.slot] = true
	end
	for slot = 1, GameConfig.PLANET_SLOTS do
		if not occupied[slot] then
			invokeRemote("PlaceBiome", `{def.displayName} platziert!`, biomeId, slot)
			return
		end
	end
	UIController.showToast(`Alle {GameConfig.PLANET_SLOTS} Slots sind belegt.`, "error")
end

-- Klick auf den Upgrade-Button eines Slots.
local function onUpgradeClicked(slot: number)
	local snapshot = lastSnapshot
	if snapshot == nil then
		return
	end
	for _, placed in snapshot.biomes do
		if placed.slot == slot then
			local def = BiomeConfig.Biomes[placed.biomeId]
			if def ~= nil and placed.level &gt;= def.maxLevel then
				UIController.showToast("Dieses Biom ist bereits auf Maximalstufe.", "info")
			else
				invokeRemote("UpgradeBiome", "Biom verbessert!", slot)
			end
			return
		end
	end
end

-- Sperr-/Kostenanzeige der Biom-Liste aktualisieren.
local function refreshBiomeRows()
	for biomeId, row in biomeRows do
		local def = BiomeConfig.Biomes[biomeId]
		if def == nil then
			continue
		end
		if lifetimeEnergy &lt; def.unlockAtLifetimeEnergy then
			row.nameLabel.TextColor3 = LOCKED_TEXT_COLOR
			row.costLabel.TextColor3 = LOCKED_TEXT_COLOR
			row.swatch.BackgroundTransparency = 0.65
			row.button.AutoButtonColor = false
			row.lockLabel.Text = `Gesperrt – ab {formatNumber(def.unlockAtLifetimeEnergy)} Gesamt-Energie`
			row.lockLabel.Visible = true
		else
			row.nameLabel.TextColor3 = TEXT_COLOR
			-- Kosten rot einfärben, wenn die aktuelle Energie nicht reicht.
			row.costLabel.TextColor3 = if currentEnergy &gt;= def.baseCost then SUBTEXT_COLOR else CANNOT_AFFORD_COLOR
			row.swatch.BackgroundTransparency = 0
			row.button.AutoButtonColor = true
			row.lockLabel.Visible = false
		end
	end
end

-- Slot-Übersicht aus dem gecachten Snapshot neu aufbauen.
local function refreshSlotRows()
	local bySlot: { [number]: PlacedBiome } = {}
	local snapshot = lastSnapshot
	if snapshot ~= nil then
		for _, placed in snapshot.biomes do
			bySlot[placed.slot] = placed
		end
	end

	for slot, row in slotRows do
		local placed = bySlot[slot]
		if placed == nil then
			row.infoLabel.Text = "frei"
			row.infoLabel.TextColor3 = SUBTEXT_COLOR
			row.upgradeButton.Visible = false
		else
			local def = BiomeConfig.Biomes[placed.biomeId]
			local displayName = if def ~= nil then def.displayName else placed.biomeId
			local maxLevel = if def ~= nil then def.maxLevel else 5
			row.infoLabel.Text = `{displayName}  Lv. {placed.level}`
			row.infoLabel.TextColor3 = TEXT_COLOR
			row.upgradeButton.Visible = true
			if placed.level &gt;= maxLevel then
				row.upgradeButton.Text = "Max"
				row.upgradeButton.BackgroundColor3 = UPGRADE_MAX_COLOR
				row.upgradeButton.AutoButtonColor = false
			else
				local cost = BiomeConfig.getUpgradeCost(placed.biomeId, placed.level)
				row.upgradeButton.Text = `Upgrade ({formatNumber(cost)})`
				row.upgradeButton.BackgroundColor3 = UPGRADE_BUTTON_COLOR
				row.upgradeButton.AutoButtonColor = true
			end
		end
	end
end

local function createBiomeRow(parent: Instance, def: BiomeDef, order: number): BiomeRow
	local row = Instance.new("TextButton")
	row.Name = def.id
	row.LayoutOrder = order
	row.Size = UDim2.new(1, -8, 0, 46)
	row.BackgroundColor3 = ROW_COLOR
	row.Text = ""
	row.AutoButtonColor = true
	addCorner(row, 8)
	row.Parent = parent

	local swatch = Instance.new("Frame")
	swatch.Name = "Swatch"
	swatch.Position = UDim2.new(0, 8, 0, 8)
	swatch.Size = UDim2.new(0, 10, 1, -16)
	swatch.BackgroundColor3 = def.color
	swatch.BorderSizePixel = 0
	addCorner(swatch, 4)
	swatch.Parent = row

	local nameLabel =
		createLabel(row, "BiomeName", def.displayName, UDim2.new(0, 28, 0, 5), UDim2.new(0.5, -28, 0, 18))
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.TextSize = 14

	local costText = `Kosten: {formatNumber(def.baseCost)}`
	local costLabel = createLabel(row, "Cost", costText, UDim2.new(0, 28, 0, 24), UDim2.new(0.5, -28, 0, 16))
	costLabel.TextSize = 11
	costLabel.TextColor3 = SUBTEXT_COLOR

	local lockLabel = createLabel(row, "Lock", "", UDim2.new(1, -8, 0, 0), UDim2.new(0.5, -32, 1, 0))
	lockLabel.AnchorPoint = Vector2.new(1, 0)
	lockLabel.TextSize = 10
	lockLabel.TextColor3 = LOCK_HINT_COLOR
	lockLabel.TextXAlignment = Enum.TextXAlignment.Right
	lockLabel.TextWrapped = true
	lockLabel.Visible = false

	row.Activated:Connect(function()
		onBiomeClicked(def.id)
	end)

	return { button = row, swatch = swatch, nameLabel = nameLabel, costLabel = costLabel, lockLabel = lockLabel }
end

local function createSlotRow(parent: Instance, slot: number, order: number): SlotRow
	local row = Instance.new("Frame")
	row.Name = `Slot{slot}`
	row.LayoutOrder = order
	row.Size = UDim2.new(1, -8, 0, 40)
	row.BackgroundColor3 = ROW_COLOR
	addCorner(row, 8)
	row.Parent = parent

	local slotLabel = createLabel(row, "SlotNumber", `Slot {slot}`, UDim2.new(0, 10, 0, 0), UDim2.new(0, 52, 1, 0))
	slotLabel.TextSize = 11
	slotLabel.TextColor3 = SUBTEXT_COLOR

	local infoLabel = createLabel(row, "Info", "frei", UDim2.new(0, 66, 0, 0), UDim2.new(1, -206, 1, 0))
	infoLabel.TextColor3 = SUBTEXT_COLOR

	local upgradeButton = Instance.new("TextButton")
	upgradeButton.Name = "Upgrade"
	upgradeButton.AnchorPoint = Vector2.new(1, 0.5)
	upgradeButton.Position = UDim2.new(1, -8, 0.5, 0)
	upgradeButton.Size = UDim2.new(0, 126, 0, 28)
	upgradeButton.BackgroundColor3 = UPGRADE_BUTTON_COLOR
	upgradeButton.Font = Enum.Font.GothamBold
	upgradeButton.TextSize = 11
	upgradeButton.TextColor3 = TEXT_COLOR
	upgradeButton.Text = ""
	upgradeButton.Visible = false
	addCorner(upgradeButton, 6)
	upgradeButton.Activated:Connect(function()
		onUpgradeClicked(slot)
	end)
	upgradeButton.Parent = row

	return { infoLabel = infoLabel, upgradeButton = upgradeButton }
end

local function buildGui(playerGui: PlayerGui)
	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "PlanetForgeBuildUI"
	screenGui.ResetOnSpawn = false
	screenGui.IgnoreGuiInset = true
	screenGui.DisplayOrder = 9

	-- Toggle-Button klappt das Panel auf und zu.
	local toggleButton = Instance.new("TextButton")
	toggleButton.Name = "ToggleBiomes"
	toggleButton.Position = UDim2.new(0, 14, 0, 110)
	toggleButton.Size = UDim2.new(0, 150, 0, 38)
	toggleButton.BackgroundColor3 = PANEL_COLOR
	toggleButton.Font = Enum.Font.GothamBold
	toggleButton.TextSize = 15
	toggleButton.TextColor3 = TEXT_COLOR
	toggleButton.Text = "Biome"
	addCorner(toggleButton, 10)
	local stroke = Instance.new("UIStroke")
	stroke.Color = STROKE_COLOR
	stroke.Thickness = 1
	stroke.Parent = toggleButton
	toggleButton.Parent = screenGui

	local panel = Instance.new("Frame")
	panel.Name = "BuildPanel"
	panel.Position = UDim2.new(0, 14, 0, 154)
	panel.Size = UDim2.new(0, 330, 0.6, 0)
	panel.BackgroundColor3 = PANEL_COLOR
	panel.BackgroundTransparency = 0.05
	panel.Visible = false
	addCorner(panel, 10)
	panel.Parent = screenGui

	toggleButton.Activated:Connect(function()
		panel.Visible = not panel.Visible
	end)

	local scroll = Instance.new("ScrollingFrame")
	scroll.Name = "Content"
	scroll.Position = UDim2.new(0, 8, 0, 8)
	scroll.Size = UDim2.new(1, -16, 1, -16)
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.ScrollBarThickness = 6
	scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.ScrollingDirection = Enum.ScrollingDirection.Y
	scroll.Parent = panel

	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, 6)
	layout.Parent = scroll

	local order = 0
	local function nextOrder(): number
		order += 1
		return order
	end

	-- Abschnitt: Biom-Liste (sortiert nach Kosten).
	local biomeHeader = createLabel(scroll, "BiomeHeader", "Biome", UDim2.new(0, 0, 0, 0), UDim2.new(1, -8, 0, 24))
	biomeHeader.LayoutOrder = nextOrder()
	biomeHeader.Font = Enum.Font.GothamBold
	biomeHeader.TextSize = 16

	for _, biomeId in BiomeConfig.getSortedIds() do
		biomeRows[biomeId] = createBiomeRow(scroll, BiomeConfig.Biomes[biomeId], nextOrder())
	end

	-- Abschnitt: die 12 Slots des eigenen Planeten.
	local slotsHeader =
		createLabel(scroll, "SlotsHeader", "Meine Slots", UDim2.new(0, 0, 0, 0), UDim2.new(1, -8, 0, 24))
	slotsHeader.LayoutOrder = nextOrder()
	slotsHeader.Font = Enum.Font.GothamBold
	slotsHeader.TextSize = 16

	for slot = 1, GameConfig.PLANET_SLOTS do
		slotRows[slot] = createSlotRow(scroll, slot, nextOrder())
	end

	screenGui.Parent = playerGui
end

function PlanetBuilderController.init()
	local player = Players.LocalPlayer
	local playerGui = player:WaitForChild("PlayerGui") :: PlayerGui

	buildGui(playerGui)
	refreshBiomeRows()
	refreshSlotRows()

	-- Snapshot cachen und Slot-Übersicht aktualisieren.
	Remotes.getEvent("PlanetUpdated").OnClientEvent:Connect(function(snapshot: any)
		if typeof(snapshot) ~= "table" or typeof(snapshot.biomes) ~= "table" then
			return
		end
		lastSnapshot = snapshot :: PlanetSnapshot
		refreshSlotRows()
	end)

	-- Energie-Stände für Freischaltungen und Kostenfärbung übernehmen.
	Remotes.getEvent("EnergyChanged").OnClientEvent:Connect(function(newEnergy: any, newLifetimeEnergy: any)
		if typeof(newEnergy) == "number" then
			currentEnergy = newEnergy
		end
		if typeof(newLifetimeEnergy) == "number" then
			lifetimeEnergy = newLifetimeEnergy
		end
		refreshBiomeRows()
	end)
end

return PlanetBuilderController
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="PF32">
<Properties>
<string name="Name">PlanetNameController</string>
<ProtectedString name="Source">--!strict
-- PlanetNameController: kleines Panel oben links, um den eigenen Planeten
-- zu benennen (RenamePlanet). Der Server filtert den Namen (Pflicht) und
-- aktualisiert das Namensschild über dem Planetenkern.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ConfigFolder = Shared:WaitForChild("Config")
local ControllersFolder = script.Parent :: Instance

local Remotes = require(Shared:WaitForChild("Remotes") :: ModuleScript) :: {
	getEvent: (name: string) -&gt; RemoteEvent,
	getFunction: (name: string) -&gt; RemoteFunction,
}
local GameConfig = require(ConfigFolder:WaitForChild("GameConfig") :: ModuleScript) :: {
	PLANET_NAME_MAX_LENGTH: number,
}
local UIController = require(ControllersFolder:WaitForChild("UIController") :: ModuleScript) :: {
	showToast: (message: string, kind: string) -&gt; (),
}

-- Farbschema (identisch zum UIController).
local PANEL_COLOR = Color3.fromRGB(30, 32, 44)
local ROW_COLOR = Color3.fromRGB(44, 47, 63)
local STROKE_COLOR = Color3.fromRGB(70, 75, 100)
local TEXT_COLOR = Color3.fromRGB(235, 238, 245)
local SUBTEXT_COLOR = Color3.fromRGB(158, 164, 186)
local SAVE_BUTTON_COLOR = Color3.fromRGB(56, 160, 92)

local PlanetNameController = {}

local localPlayer = Players.LocalPlayer

local function addCorner(instance: Instance, radius: number)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = instance
end

local function addStroke(instance: Instance, color: Color3)
	local stroke = Instance.new("UIStroke")
	stroke.Color = color
	stroke.Thickness = 1
	stroke.Parent = instance
end

function PlanetNameController.init()
	local renameFunction = Remotes.getFunction("RenamePlanet")
	local playerGui = localPlayer:WaitForChild("PlayerGui")

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "PlanetForgeName"
	screenGui.ResetOnSpawn = false
	screenGui.Parent = playerGui

	local toggleButton = Instance.new("TextButton")
	toggleButton.Name = "NameToggle"
	toggleButton.Position = UDim2.new(0, 12, 0, 12)
	toggleButton.Size = UDim2.new(0, 160, 0, 36)
	toggleButton.BackgroundColor3 = PANEL_COLOR
	toggleButton.Font = Enum.Font.GothamBold
	toggleButton.TextSize = 13
	toggleButton.TextColor3 = TEXT_COLOR
	toggleButton.Text = "✏️ Planet benennen"
	addCorner(toggleButton, 10)
	addStroke(toggleButton, STROKE_COLOR)
	toggleButton.Parent = screenGui

	local panel = Instance.new("Frame")
	panel.Name = "NamePanel"
	panel.Position = UDim2.new(0, 12, 0, 54)
	panel.Size = UDim2.new(0, 240, 0, 96)
	panel.BackgroundColor3 = PANEL_COLOR
	panel.Visible = false
	addCorner(panel, 12)
	addStroke(panel, STROKE_COLOR)
	panel.Parent = screenGui

	local textBox = Instance.new("TextBox")
	textBox.Name = "NameInput"
	textBox.Position = UDim2.new(0, 10, 0, 10)
	textBox.Size = UDim2.new(1, -20, 0, 34)
	textBox.BackgroundColor3 = ROW_COLOR
	textBox.Font = Enum.Font.GothamMedium
	textBox.TextSize = 13
	textBox.TextColor3 = TEXT_COLOR
	textBox.PlaceholderText = `Neuer Name (3-{GameConfig.PLANET_NAME_MAX_LENGTH} Zeichen)`
	textBox.PlaceholderColor3 = SUBTEXT_COLOR
	textBox.Text = ""
	textBox.ClearTextOnFocus = false
	addCorner(textBox, 8)
	textBox.Parent = panel

	local saveButton = Instance.new("TextButton")
	saveButton.Name = "Save"
	saveButton.Position = UDim2.new(0, 10, 0, 52)
	saveButton.Size = UDim2.new(1, -20, 0, 32)
	saveButton.BackgroundColor3 = SAVE_BUTTON_COLOR
	saveButton.Font = Enum.Font.GothamBold
	saveButton.TextSize = 13
	saveButton.TextColor3 = TEXT_COLOR
	saveButton.Text = "Speichern"
	addCorner(saveButton, 8)
	saveButton.Parent = panel

	toggleButton.Activated:Connect(function()
		panel.Visible = not panel.Visible
	end)

	saveButton.Activated:Connect(function()
		local desiredName = textBox.Text
		task.spawn(function()
			local ok, success, payload = pcall(function()
				return renameFunction:InvokeServer(desiredName)
			end)
			if not ok then
				UIController.showToast("Verbindungsfehler - bitte erneut versuchen.", "error")
				return
			end
			if success == true and typeof(payload) == "string" then
				UIController.showToast(`Dein Planet heißt jetzt "{payload}"!`, "success")
				textBox.Text = ""
				panel.Visible = false
			elseif typeof(payload) == "string" then
				UIController.showToast(payload, "error")
			end
		end)
	end)
end

return PlanetNameController
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="PF33">
<Properties>
<string name="Name">ShopController</string>
<ProtectedString name="Source">--!strict
-- ShopController: Robux-Shop mit Kategorie-Tabs am rechten Bildschirmrand.
--
-- Tabs: "Gamepässe", "Einzelkäufe", "Meine Kosmetik". Jede Kauf-Zeile zeigt
-- eine Vorschau (Farb-Swatch + Kategorie-Icon), den Preis und - falls schon
-- freigeschaltet - ein "Im Besitz ✓"-Badge. Käufe laufen über die offiziellen
-- Roblox-Kaufdialoge; die Gutschrift macht ausschließlich der Server.
--
-- STUDIO-TESTMODUS: Ist eine Produkt-ID noch 0 und läuft das Spiel in Studio
-- (MonetizationConfig.testModeInStudio), zeigt der Button "Test-Kauf" und
-- simuliert den Kauf über SimulatePurchase - der Server prüft Studio hart.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ConfigFolder = Shared:WaitForChild("Config")
local ControllersFolder = script.Parent :: Instance

local Remotes = require(Shared:WaitForChild("Remotes") :: ModuleScript) :: {
	getEvent: (name: string) -&gt; RemoteEvent,
	getFunction: (name: string) -&gt; RemoteFunction,
}

type CosmeticDef = {
	id: string,
	displayName: string,
	description: string,
	category: string,
	visual: { color: Color3?, secondaryColor: Color3?, material: Enum.Material?, glow: boolean? },
}
type GamepassDef = {
	key: string,
	gamePassId: number,
	displayName: string,
	description: string,
	grantsCosmetics: { string },
}
type ProductDef = {
	key: string,
	productId: number,
	displayName: string,
	description: string,
	grantsCosmetic: string,
}

local MonetizationConfig = require(ConfigFolder:WaitForChild("MonetizationConfig") :: ModuleScript) :: {
	testModeInStudio: boolean,
	Categories: { string },
	CategoryNames: { [string]: string },
	Cosmetics: { [string]: CosmeticDef },
	Gamepasses: { [string]: GamepassDef },
	DeveloperProducts: { [string]: ProductDef },
	getGamepassKeys: () -&gt; { string },
	getProductKeys: () -&gt; { string },
}
local UIController = require(ControllersFolder:WaitForChild("UIController") :: ModuleScript) :: {
	showToast: (message: string, kind: string) -&gt; (),
}
local EffectsController = require(ControllersFolder:WaitForChild("EffectsController") :: ModuleScript) :: {
	playSound: (name: string, pitchOverride: number?) -&gt; (),
}

-- Farbschema (identisch zum UIController).
local PANEL_COLOR = Color3.fromRGB(30, 32, 44)
local ROW_COLOR = Color3.fromRGB(44, 47, 63)
local STROKE_COLOR = Color3.fromRGB(70, 75, 100)
local TEXT_COLOR = Color3.fromRGB(235, 238, 245)
local SUBTEXT_COLOR = Color3.fromRGB(158, 164, 186)
local BUY_BUTTON_COLOR = Color3.fromRGB(56, 160, 92)
local TEST_BUTTON_COLOR = Color3.fromRGB(214, 160, 72)
local DISABLED_BUTTON_COLOR = Color3.fromRGB(60, 64, 84)
local EQUIP_BUTTON_COLOR = Color3.fromRGB(52, 96, 178)
local EQUIPPED_BUTTON_COLOR = Color3.fromRGB(120, 90, 200)
local OWNED_BADGE_COLOR = Color3.fromRGB(76, 175, 110)
local TAB_ACTIVE_COLOR = Color3.fromRGB(52, 96, 178)

local PANEL_WIDTH = 340
local ROW_HEIGHT = 62

-- Kategorie-Icons für die Vorschau.
local CATEGORY_ICONS: { [string]: string } = {
	skin = "🪐",
	aura = "✨",
	wetter = "🌦️",
	haustier = "🐾",
}

local ShopController = {}

local localPlayer = Players.LocalPlayer

-- Lokaler Kosmetik-Stand aus CosmeticsUpdated.
local ownedSet: { [string]: boolean } = {}
local equipped: { [string]: string } = {}

local cosmeticsFrame: Frame? = nil
local equipFunction: RemoteFunction? = nil
local simulateFunction: RemoteFunction? = nil

-- Zeilen-Aktualisierer, die bei jedem CosmeticsUpdated laufen (Badges usw.).
local rowUpdaters: { () -&gt; () } = {}

local function addCorner(instance: Instance, radius: number)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = instance
end

local function addStroke(instance: Instance, color: Color3)
	local stroke = Instance.new("UIStroke")
	stroke.Color = color
	stroke.Thickness = 1
	stroke.Parent = instance
end

local function createLabel(parent: Instance, name: string, text: string): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamMedium
	label.TextColor3 = TEXT_COLOR
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Text = text
	label.Parent = parent
	return label
end

-- Testmodus aus Client-Sicht (der Server prüft zusätzlich hart).
local function isTestModeActive(): boolean
	return MonetizationConfig.testModeInStudio == true and RunService:IsStudio()
end

-- Vorschau: runder Farb-Swatch mit Kategorie-Icon.
local function createPreview(parent: Instance, color: Color3, category: string)
	local swatch = Instance.new("Frame")
	swatch.Name = "Preview"
	swatch.AnchorPoint = Vector2.new(0, 0.5)
	swatch.Position = UDim2.new(0, 8, 0.5, 0)
	swatch.Size = UDim2.new(0, 40, 0, 40)
	swatch.BackgroundColor3 = color
	addCorner(swatch, 20)
	addStroke(swatch, STROKE_COLOR)
	swatch.Parent = parent

	local icon = Instance.new("TextLabel")
	icon.BackgroundTransparency = 1
	icon.Size = UDim2.new(1, 0, 1, 0)
	icon.Font = Enum.Font.GothamBold
	icon.TextSize = 20
	icon.Text = CATEGORY_ICONS[category] or "🎁"
	icon.Parent = swatch
end

-- Kauf-Zeile für einen Gamepass oder ein Developer Product.
local function createPurchaseRow(
	parent: Instance,
	order: number,
	displayName: string,
	description: string,
	previewColor: Color3,
	previewCategory: string,
	assetId: number,
	infoType: Enum.InfoType,
	isOwned: () -&gt; boolean,
	onBuy: () -&gt; (),
	onTestBuy: () -&gt; ()
)
	local row = Instance.new("Frame")
	row.Name = `Row_{order}`
	row.Size = UDim2.new(1, 0, 0, ROW_HEIGHT)
	row.BackgroundColor3 = ROW_COLOR
	row.LayoutOrder = order
	addCorner(row, 8)
	row.Parent = parent

	createPreview(row, previewColor, previewCategory)

	local nameLabel = createLabel(row, "Name", displayName)
	nameLabel.Position = UDim2.new(0, 56, 0, 8)
	nameLabel.Size = UDim2.new(1, -160, 0, 18)
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.TextSize = 14

	local descLabel = createLabel(row, "Desc", description)
	descLabel.Position = UDim2.new(0, 56, 0, 28)
	descLabel.Size = UDim2.new(1, -160, 0, 28)
	descLabel.TextSize = 11
	descLabel.TextColor3 = SUBTEXT_COLOR
	descLabel.TextWrapped = true
	descLabel.TextYAlignment = Enum.TextYAlignment.Top

	local buyButton = Instance.new("TextButton")
	buyButton.Name = "Buy"
	buyButton.AnchorPoint = Vector2.new(1, 0.5)
	buyButton.Position = UDim2.new(1, -8, 0.5, 0)
	buyButton.Size = UDim2.new(0, 88, 0, 34)
	buyButton.Font = Enum.Font.GothamBold
	buyButton.TextSize = 12
	buyButton.TextColor3 = TEXT_COLOR
	addCorner(buyButton, 8)
	buyButton.Parent = row

	local ownedBadge = Instance.new("TextLabel")
	ownedBadge.Name = "OwnedBadge"
	ownedBadge.AnchorPoint = Vector2.new(1, 0.5)
	ownedBadge.Position = UDim2.new(1, -8, 0.5, 0)
	ownedBadge.Size = UDim2.new(0, 88, 0, 34)
	ownedBadge.BackgroundColor3 = OWNED_BADGE_COLOR
	ownedBadge.Font = Enum.Font.GothamBold
	ownedBadge.TextSize = 12
	ownedBadge.TextColor3 = TEXT_COLOR
	ownedBadge.Text = "Im Besitz ✓"
	ownedBadge.Visible = false
	addCorner(ownedBadge, 8)
	ownedBadge.Parent = row

	-- Kaufweg bestimmen: echte ID -&gt; Roblox-Dialog; ID 0 im Studio-Testmodus
	-- -&gt; Test-Kauf; sonst deaktiviert.
	if assetId ~= 0 then
		buyButton.Text = "Kaufen"
		buyButton.BackgroundColor3 = BUY_BUTTON_COLOR
		buyButton.Activated:Connect(onBuy)
		task.spawn(function()
			local ok, info = pcall(function()
				return MarketplaceService:GetProductInfo(assetId, infoType)
			end)
			if ok and typeof(info) == "table" and typeof(info.PriceInRobux) == "number" then
				buyButton.Text = `{info.PriceInRobux} R$`
			end
		end)
	elseif isTestModeActive() then
		buyButton.Text = "Test-Kauf"
		buyButton.BackgroundColor3 = TEST_BUTTON_COLOR
		buyButton.Activated:Connect(onTestBuy)
	else
		buyButton.Text = "Bald..."
		buyButton.BackgroundColor3 = DISABLED_BUTTON_COLOR
		buyButton.AutoButtonColor = false
	end

	-- Badge/Button live umschalten, sobald sich der Besitz ändert.
	table.insert(rowUpdaters, function()
		local owned = isOwned()
		ownedBadge.Visible = owned
		buyButton.Visible = not owned
	end)
end

-- Test-Kauf über den Server simulieren (nur Studio; Server prüft hart).
local function requestTestPurchase(kind: string, key: string)
	local remote = simulateFunction
	if remote == nil then
		return
	end
	task.spawn(function()
		local ok, serverOk, message = pcall(function()
			return remote:InvokeServer(kind, key)
		end)
		if not ok then
			UIController.showToast("Verbindungsfehler – bitte erneut versuchen.", "error")
		elseif serverOk ~= true and typeof(message) == "string" then
			UIController.showToast(message, "error")
		else
			EffectsController.playSound("collect")
		end
	end)
end

local function runRowUpdaters()
	for _, update in rowUpdaters do
		update()
	end
end

-- "Meine Kosmetik" neu aufbauen (nach jedem CosmeticsUpdated).
local function rebuildCosmeticsSection()
	local frame = cosmeticsFrame
	if frame == nil then
		return
	end
	for _, child in frame:GetChildren() do
		if not (child:IsA("UIListLayout") or child:IsA("UIPadding")) then
			child:Destroy()
		end
	end

	local order = 0
	local ownedAny = false

	for _, category in MonetizationConfig.Categories do
		local ids: { string } = {}
		for cosmeticId in ownedSet do
			local def = MonetizationConfig.Cosmetics[cosmeticId]
			if def ~= nil and def.category == category then
				table.insert(ids, cosmeticId)
			end
		end
		table.sort(ids)
		if #ids == 0 then
			continue
		end
		ownedAny = true

		order += 1
		local header = createLabel(frame, `Cat_{category}`, MonetizationConfig.CategoryNames[category] or category)
		header.Size = UDim2.new(1, 0, 0, 20)
		header.Font = Enum.Font.GothamBold
		header.TextSize = 12
		header.TextColor3 = TEST_BUTTON_COLOR
		header.LayoutOrder = order

		for _, cosmeticId in ids do
			local def = MonetizationConfig.Cosmetics[cosmeticId]
			local isEquipped = equipped[category] == cosmeticId

			order += 1
			local row = Instance.new("Frame")
			row.Name = `Own_{cosmeticId}`
			row.Size = UDim2.new(1, 0, 0, 48)
			row.BackgroundColor3 = ROW_COLOR
			row.LayoutOrder = order
			addCorner(row, 8)
			row.Parent = frame

			local preview = Instance.new("Frame")
			preview.AnchorPoint = Vector2.new(0, 0.5)
			preview.Position = UDim2.new(0, 8, 0.5, 0)
			preview.Size = UDim2.new(0, 30, 0, 30)
			preview.BackgroundColor3 = def.visual.color or TEXT_COLOR
			addCorner(preview, 15)
			preview.Parent = row

			local icon = Instance.new("TextLabel")
			icon.BackgroundTransparency = 1
			icon.Size = UDim2.new(1, 0, 1, 0)
			icon.Font = Enum.Font.GothamBold
			icon.TextSize = 15
			icon.Text = CATEGORY_ICONS[def.category] or "🎁"
			icon.Parent = preview

			local nameLabel = createLabel(row, "Name", def.displayName)
			nameLabel.AnchorPoint = Vector2.new(0, 0.5)
			nameLabel.Position = UDim2.new(0, 46, 0.5, 0)
			nameLabel.Size = UDim2.new(1, -150, 0, 18)
			nameLabel.TextSize = 13

			local equipButton = Instance.new("TextButton")
			equipButton.Name = "Equip"
			equipButton.AnchorPoint = Vector2.new(1, 0.5)
			equipButton.Position = UDim2.new(1, -8, 0.5, 0)
			equipButton.Size = UDim2.new(0, 88, 0, 28)
			equipButton.Font = Enum.Font.GothamBold
			equipButton.TextSize = 12
			equipButton.TextColor3 = TEXT_COLOR
			equipButton.Text = if isEquipped then "Ablegen" else "Ausrüsten"
			equipButton.BackgroundColor3 = if isEquipped then EQUIPPED_BUTTON_COLOR else EQUIP_BUTTON_COLOR
			addCorner(equipButton, 8)
			equipButton.Parent = row

			equipButton.Activated:Connect(function()
				local remote = equipFunction
				if remote == nil then
					return
				end
				task.spawn(function()
					local ok, success, err = pcall(function()
						return remote:InvokeServer(category, if isEquipped then nil else cosmeticId)
					end)
					if not ok then
						UIController.showToast("Verbindungsfehler – bitte erneut versuchen.", "error")
					elseif success ~= true and typeof(err) == "string" then
						UIController.showToast(err, "error")
					else
						EffectsController.playSound("pop")
					end
				end)
			end)
		end
	end

	if not ownedAny then
		local hint = createLabel(frame, "Empty", 'Noch keine Kosmetik – hol dir etwas aus den Tabs „Gamepässe" oder „Einzelkäufe"!')
		hint.Size = UDim2.new(1, 0, 0, 44)
		hint.TextSize = 12
		hint.TextColor3 = SUBTEXT_COLOR
		hint.TextWrapped = true
		hint.LayoutOrder = 1
	end
end

-- Scrollbaren Tab-Inhalt anlegen.
local function createTabContent(parent: Instance): ScrollingFrame
	local frame = Instance.new("ScrollingFrame")
	frame.Position = UDim2.new(0, 0, 0, 44)
	frame.Size = UDim2.new(1, 0, 1, -44)
	frame.BackgroundTransparency = 1
	frame.ScrollBarThickness = 6
	frame.AutomaticCanvasSize = Enum.AutomaticSize.Y
	frame.CanvasSize = UDim2.new(0, 0, 0, 0)
	frame.Visible = false
	frame.Parent = parent

	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, 8)
	padding.PaddingLeft = UDim.new(0, 10)
	padding.PaddingRight = UDim.new(0, 10)
	padding.PaddingBottom = UDim.new(0, 8)
	padding.Parent = frame

	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, 6)
	layout.Parent = frame

	return frame
end

local function buildUI()
	local playerGui = localPlayer:WaitForChild("PlayerGui")

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "PlanetForgeShop"
	screenGui.ResetOnSpawn = false
	screenGui.Parent = playerGui

	local toggleButton = Instance.new("TextButton")
	toggleButton.Name = "ShopToggle"
	toggleButton.AnchorPoint = Vector2.new(1, 0.5)
	toggleButton.Position = UDim2.new(1, -12, 0.35, 0)
	toggleButton.Size = UDim2.new(0, 110, 0, 40)
	toggleButton.BackgroundColor3 = PANEL_COLOR
	toggleButton.Font = Enum.Font.GothamBold
	toggleButton.TextSize = 14
	toggleButton.TextColor3 = TEXT_COLOR
	toggleButton.Text = "🛒 Shop"
	addCorner(toggleButton, 10)
	addStroke(toggleButton, STROKE_COLOR)
	toggleButton.Parent = screenGui

	local panel = Instance.new("Frame")
	panel.Name = "ShopPanel"
	panel.AnchorPoint = Vector2.new(1, 0.5)
	panel.Position = UDim2.new(1, -130, 0.5, 0)
	panel.Size = UDim2.new(0, PANEL_WIDTH, 0.72, 0)
	panel.BackgroundColor3 = PANEL_COLOR
	panel.Visible = false
	addCorner(panel, 12)
	addStroke(panel, STROKE_COLOR)
	panel.Parent = screenGui

	toggleButton.Activated:Connect(function()
		panel.Visible = not panel.Visible
	end)

	-- Tab-Leiste.
	local tabBar = Instance.new("Frame")
	tabBar.Name = "Tabs"
	tabBar.Position = UDim2.new(0, 8, 0, 8)
	tabBar.Size = UDim2.new(1, -16, 0, 30)
	tabBar.BackgroundTransparency = 1
	tabBar.Parent = panel

	local tabLayout = Instance.new("UIListLayout")
	tabLayout.FillDirection = Enum.FillDirection.Horizontal
	tabLayout.SortOrder = Enum.SortOrder.LayoutOrder
	tabLayout.Padding = UDim.new(0, 6)
	tabLayout.Parent = tabBar

	local gamepassContent = createTabContent(panel)
	gamepassContent.Name = "GamepassContent"
	local productContent = createTabContent(panel)
	productContent.Name = "ProductContent"
	local cosmeticsContent = createTabContent(panel)
	cosmeticsContent.Name = "CosmeticsContent"

	local tabs: { { button: TextButton, content: ScrollingFrame } } = {}

	local function selectTab(selectedIndex: number)
		for index, tab in tabs do
			local active = index == selectedIndex
			tab.content.Visible = active
			tab.button.BackgroundColor3 = if active then TAB_ACTIVE_COLOR else ROW_COLOR
		end
	end

	local function addTab(order: number, title: string, content: ScrollingFrame)
		local button = Instance.new("TextButton")
		button.Name = `Tab_{order}`
		button.LayoutOrder = order
		button.Size = UDim2.new(0, 104, 1, 0)
		button.BackgroundColor3 = ROW_COLOR
		button.Font = Enum.Font.GothamBold
		button.TextSize = 11
		button.TextColor3 = TEXT_COLOR
		button.Text = title
		addCorner(button, 8)
		button.Parent = tabBar

		table.insert(tabs, { button = button, content = content })
		local index = #tabs
		button.Activated:Connect(function()
			selectTab(index)
		end)
	end

	addTab(1, "Gamepässe", gamepassContent)
	addTab(2, "Einzelkäufe", productContent)
	addTab(3, "Meine Kosmetik", cosmeticsContent)
	selectTab(1)

	-- Gamepass-Zeilen (Vorschau = erste enthaltene Kosmetik).
	local order = 0
	for _, key in MonetizationConfig.getGamepassKeys() do
		local def = MonetizationConfig.Gamepasses[key]
		local firstCosmetic = MonetizationConfig.Cosmetics[def.grantsCosmetics[1]]
		order += 1
		createPurchaseRow(
			gamepassContent,
			order,
			def.displayName,
			def.description,
			if firstCosmetic ~= nil then firstCosmetic.visual.color or TEXT_COLOR else TEXT_COLOR,
			if firstCosmetic ~= nil then firstCosmetic.category else "skin",
			def.gamePassId,
			Enum.InfoType.GamePass,
			function()
				for _, cosmeticId in def.grantsCosmetics do
					if not ownedSet[cosmeticId] then
						return false
					end
				end
				return true
			end,
			function()
				MarketplaceService:PromptGamePassPurchase(localPlayer, def.gamePassId)
			end,
			function()
				requestTestPurchase("gamepass", key)
			end
		)
	end

	-- Einzelkauf-Zeilen.
	for _, key in MonetizationConfig.getProductKeys() do
		local def = MonetizationConfig.DeveloperProducts[key]
		local cosmetic = MonetizationConfig.Cosmetics[def.grantsCosmetic]
		order += 1
		createPurchaseRow(
			productContent,
			order,
			def.displayName,
			def.description,
			if cosmetic ~= nil then cosmetic.visual.color or TEXT_COLOR else TEXT_COLOR,
			if cosmetic ~= nil then cosmetic.category else "skin",
			def.productId,
			Enum.InfoType.Product,
			function()
				return ownedSet[def.grantsCosmetic] == true
			end,
			function()
				MarketplaceService:PromptProductPurchase(localPlayer, def.productId)
			end,
			function()
				requestTestPurchase("product", key)
			end
		)
	end

	-- Hinweis im Testmodus.
	if isTestModeActive() then
		order += 1
		local hint = createLabel(gamepassContent, "TestHint", 'Studio-Testmodus aktiv: „Test-Kauf" schaltet ohne Robux frei (nur in Studio).')
		hint.Size = UDim2.new(1, 0, 0, 30)
		hint.TextSize = 10
		hint.TextColor3 = TEST_BUTTON_COLOR
		hint.TextWrapped = true
		hint.LayoutOrder = order
	end

	cosmeticsFrame = cosmeticsContent
	rebuildCosmeticsSection()
	runRowUpdaters()
end

function ShopController.init()
	equipFunction = Remotes.getFunction("EquipCosmetic")
	simulateFunction = Remotes.getFunction("SimulatePurchase")

	Remotes.getEvent("CosmeticsUpdated").OnClientEvent:Connect(function(ownedArg: any, equippedArg: any)
		ownedSet = {}
		if typeof(ownedArg) == "table" then
			for _, cosmeticId in ownedArg :: { any } do
				if typeof(cosmeticId) == "string" then
					ownedSet[cosmeticId] = true
				end
			end
		end

		equipped = {}
		if typeof(equippedArg) == "table" then
			for category, cosmeticId in equippedArg :: { [any]: any } do
				if typeof(category) == "string" and typeof(cosmeticId) == "string" then
					equipped[category] = cosmeticId
				end
			end
		end

		rebuildCosmeticsSection()
		runRowUpdaters()
	end)

	buildUI()
end

return ShopController
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="PF34">
<Properties>
<string name="Name">TutorialController</string>
<ProtectedString name="Source">--!strict
-- TutorialController: geführte First-Time Experience.
--
-- Zeigt für neue Spieler vier Schritte mit Textbox und pulsierendem
-- Highlight auf dem jeweils richtigen Bedienelement:
--   1  Platziere deine erste Wiese  (Biome-Menü + leerer Slot pulsiert)
--   2  Sammle Energie ein           ("Energie sammeln"-Button pulsiert)
--   3  Kaufe ein Upgrade            (Biome-Menü pulsiert)
--   4  Suche deinen ersten Fund     ("Fund suchen"-Button pulsiert)
--
-- Der Fortschritt liegt im Profil (tutorialStep, TutorialService validiert
-- autoritativ); dieses Tutorial erscheint deshalb nur einmal. Zusätzlich
-- bekommen leere Slots und der Sammel-Button dezente Hinweis-Schilder,
-- solange der Spieler unter GameConfig.TUTORIAL_HINT_LIFETIME_LIMIT
-- Lifetime-Energie hat.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ConfigFolder = Shared:WaitForChild("Config")
local ControllersFolder = script.Parent :: Instance

local Remotes = require(Shared:WaitForChild("Remotes") :: ModuleScript) :: {
	getEvent: (name: string) -&gt; RemoteEvent,
	getFunction: (name: string) -&gt; RemoteFunction,
}
local GameConfig = require(ConfigFolder:WaitForChild("GameConfig") :: ModuleScript) :: {
	PLANET_SLOTS: number,
	COLLECT_AMOUNT: number,
	TUTORIAL_STEP_COUNT: number,
	TUTORIAL_HINT_LIFETIME_LIMIT: number,
}
local UIController = require(ControllersFolder:WaitForChild("UIController") :: ModuleScript) :: {
	showToast: (message: string, kind: string) -&gt; (),
}

-- Farbschema (identisch zum UIController) plus Gold-Akzent für Highlights.
local PANEL_COLOR = Color3.fromRGB(30, 32, 44)
local STROKE_COLOR = Color3.fromRGB(70, 75, 100)
local TEXT_COLOR = Color3.fromRGB(235, 238, 245)
local SUBTEXT_COLOR = Color3.fromRGB(158, 164, 186)
local ACCENT_COLOR = Color3.fromRGB(214, 160, 72)
local SKIP_COLOR = Color3.fromRGB(60, 64, 84)

local DONE_STEP = GameConfig.TUTORIAL_STEP_COUNT + 1
local PULSE_INFO = TweenInfo.new(0.7, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)

type StepDef = {
	text: string,
	target: "biome" | "collect" | "loot",
	highlightSlot: boolean, -- zusätzlich einen leeren Slot in der Welt pulsieren lassen
}

local STEPS: { StepDef } = {
	{ text = 'Öffne links „Biome" und platziere deine erste Wiese! 🌿', target = "biome", highlightSlot = true },
	{ text = 'Super! Jetzt drücke unten auf „Energie sammeln". ⚡', target = "collect", highlightSlot = false },
	{ text = 'Kaufe ein Upgrade: Öffne „Biome" und drücke bei deiner Wiese auf „Upgrade"!', target = "biome", highlightSlot = false },
	{ text = 'Fast geschafft: Suche deinen ersten Fund! 🎁', target = "loot", highlightSlot = false },
}

local TutorialController = {}

local localPlayer = Players.LocalPlayer

local currentStep = 0
local advanceInFlight = false
local lifetimeEnergy = 0

-- Zwischenspeicher aus PlanetUpdated für Bedingungen und Slot-Suche.
local snapshotBiomeCount = 0
local snapshotMaxLevel = 0
local snapshotCollectibles = 0
local occupiedSlots: { [number]: boolean } = {}

-- UI-Referenzen (in buildUI gesetzt).
local tutorialFrame: Frame? = nil
local stepLabel: TextLabel? = nil
local textLabel: TextLabel? = nil

-- Aktive Highlight-Objekte des aktuellen Schritts (werden bei Wechsel entsorgt).
local activeHighlights: { Instance } = {}
local activeTweens: { Tween } = {}

-- Hinweis-Schilder (unabhängig vom Tutorial, solange Lifetime &lt; Limit).
local slotHints: { [number]: BillboardGui } = {}
local collectHint: TextLabel? = nil
local hintsRemoved = false

local tutorialActionFunction: RemoteFunction? = nil

local function addCorner(instance: Instance, radius: number)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = instance
end

-- Sucht ein GUI-Objekt über einen Pfad aus WaitForChild-Schritten (mit Timeout).
local function waitForPath(root: Instance, path: { string }, timeout: number): Instance?
	local current: Instance? = root
	for _, name in path do
		if current == nil then
			return nil
		end
		current = current:WaitForChild(name, timeout)
	end
	return current
end

local function clearHighlights()
	for _, tween in activeTweens do
		tween:Cancel()
	end
	table.clear(activeTweens)
	for _, instance in activeHighlights do
		instance:Destroy()
	end
	table.clear(activeHighlights)
end

-- Pulsierender Gold-Rahmen um einen GUI-Button.
local function highlightButton(button: Instance)
	if not button:IsA("GuiObject") then
		return
	end
	local stroke = Instance.new("UIStroke")
	stroke.Name = "TutorialPulse"
	stroke.Color = ACCENT_COLOR
	stroke.Thickness = 3
	stroke.Transparency = 0
	stroke.Parent = button

	local tween = TweenService:Create(stroke, PULSE_INFO, { Transparency = 0.75 })
	tween:Play()

	table.insert(activeHighlights, stroke)
	table.insert(activeTweens, tween)
end

-- Pulsierendes Highlight + Pfeil-Schild über einem leeren Slot in der Welt.
local function highlightEmptySlot()
	task.spawn(function()
		local plots = Workspace:WaitForChild("PlanetPlots", 15)
		if plots == nil then
			return
		end
		local plot = plots:WaitForChild(`Plot_{localPlayer.UserId}`, 15)
		if plot == nil then
			return
		end

		-- Ersten freien Slot laut Snapshot nehmen (Standard: Slot 1).
		local slotNumber = 1
		for candidate = 1, GameConfig.PLANET_SLOTS do
			if not occupiedSlots[candidate] then
				slotNumber = candidate
				break
			end
		end
		local slotPart = plot:FindFirstChild(`Slot_{slotNumber}`)
		if slotPart == nil or not slotPart:IsA("BasePart") then
			return
		end

		-- Falls der Schritt inzwischen weitergesprungen ist: nichts anheften.
		if currentStep ~= 1 then
			return
		end

		local highlight = Instance.new("Highlight")
		highlight.Name = "TutorialSlotPulse"
		highlight.FillColor = ACCENT_COLOR
		highlight.OutlineColor = TEXT_COLOR
		highlight.FillTransparency = 0.4
		highlight.Adornee = slotPart
		highlight.Parent = slotPart

		local billboard = Instance.new("BillboardGui")
		billboard.Name = "TutorialSlotArrow"
		billboard.Size = UDim2.new(0, 140, 0, 40)
		billboard.StudsOffset = Vector3.new(0, 6, 0)
		billboard.AlwaysOnTop = true
		billboard.Adornee = slotPart
		billboard.Parent = slotPart

		local arrow = Instance.new("TextLabel")
		arrow.BackgroundTransparency = 1
		arrow.Size = UDim2.new(1, 0, 1, 0)
		arrow.Font = Enum.Font.GothamBold
		arrow.TextSize = 18
		arrow.TextColor3 = ACCENT_COLOR
		arrow.TextStrokeTransparency = 0.4
		arrow.Text = "⬇ Hier bauen!"
		arrow.Parent = billboard

		local tween = TweenService:Create(highlight, PULSE_INFO, { FillTransparency = 0.85 })
		tween:Play()

		table.insert(activeHighlights, highlight)
		table.insert(activeHighlights, billboard)
		table.insert(activeTweens, tween)
	end)
end

-- Setzt das Highlight passend zum Schritt (Buttons liegen in anderen ScreenGuis).
local function applyStepHighlight(step: number)
	clearHighlights()
	local def = STEPS[step]
	if def == nil then
		return
	end

	task.spawn(function()
		local playerGui = localPlayer:WaitForChild("PlayerGui")
		local target: Instance? = nil
		if def.target == "biome" then
			target = waitForPath(playerGui, { "PlanetForgeBuildUI", "ToggleBiomes" }, 10)
		elseif def.target == "collect" then
			target = waitForPath(playerGui, { "PlanetForgeUI", "ButtonBar", "CollectEnergy" }, 10)
		elseif def.target == "loot" then
			target = waitForPath(playerGui, { "PlanetForgeUI", "ButtonBar", "RollLoot" }, 10)
		end
		-- Nur anheften, wenn der Schritt noch aktuell ist (WaitForChild kann dauern).
		if target ~= nil and currentStep == step then
			highlightButton(target)
		end
	end)

	if def.highlightSlot then
		highlightEmptySlot()
	end
end

local function buildUI()
	local playerGui = localPlayer:WaitForChild("PlayerGui")

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "PlanetForgeTutorial"
	screenGui.ResetOnSpawn = false
	screenGui.DisplayOrder = 20
	screenGui.Parent = playerGui

	local frame = Instance.new("Frame")
	frame.Name = "TutorialBox"
	frame.AnchorPoint = Vector2.new(0.5, 1)
	frame.Position = UDim2.new(0.5, 0, 1, -78)
	frame.Size = UDim2.new(0, 520, 0, 64)
	frame.BackgroundColor3 = PANEL_COLOR
	frame.Visible = false
	addCorner(frame, 12)
	local stroke = Instance.new("UIStroke")
	stroke.Color = ACCENT_COLOR
	stroke.Thickness = 2
	stroke.Parent = frame
	frame.Parent = screenGui

	local step = Instance.new("TextLabel")
	step.Name = "StepLabel"
	step.BackgroundTransparency = 1
	step.Position = UDim2.new(0, 14, 0, 8)
	step.Size = UDim2.new(0, 200, 0, 14)
	step.Font = Enum.Font.GothamBold
	step.TextSize = 11
	step.TextColor3 = ACCENT_COLOR
	step.TextXAlignment = Enum.TextXAlignment.Left
	step.Text = ""
	step.Parent = frame

	local text = Instance.new("TextLabel")
	text.Name = "TaskText"
	text.BackgroundTransparency = 1
	text.Position = UDim2.new(0, 14, 0, 24)
	text.Size = UDim2.new(1, -140, 0, 34)
	text.Font = Enum.Font.GothamMedium
	text.TextSize = 15
	text.TextColor3 = TEXT_COLOR
	text.TextXAlignment = Enum.TextXAlignment.Left
	text.TextWrapped = true
	text.Text = ""
	text.Parent = frame

	local skipButton = Instance.new("TextButton")
	skipButton.Name = "Skip"
	skipButton.AnchorPoint = Vector2.new(1, 0.5)
	skipButton.Position = UDim2.new(1, -10, 0.5, 0)
	skipButton.Size = UDim2.new(0, 108, 0, 30)
	skipButton.BackgroundColor3 = SKIP_COLOR
	skipButton.Font = Enum.Font.GothamMedium
	skipButton.TextSize = 12
	skipButton.TextColor3 = SUBTEXT_COLOR
	skipButton.Text = "Überspringen"
	addCorner(skipButton, 8)
	skipButton.Parent = frame

	skipButton.Activated:Connect(function()
		local remote = tutorialActionFunction
		if remote == nil then
			return
		end
		task.spawn(function()
			pcall(function()
				return remote:InvokeServer("skip")
			end)
		end)
	end)

	tutorialFrame = frame
	stepLabel = step
	textLabel = text
end

local function setStep(step: number)
	local wasActive = currentStep &gt;= 1 and currentStep &lt;= GameConfig.TUTORIAL_STEP_COUNT
	currentStep = step

	local frame = tutorialFrame
	if frame == nil then
		return
	end

	if step &gt;= DONE_STEP or STEPS[step] == nil then
		clearHighlights()
		frame.Visible = false
		if wasActive then
			UIController.showToast("Tutorial abgeschlossen – viel Spaß beim Bauen! 🎉", "success")
		end
		return
	end

	local def = STEPS[step];
	(stepLabel :: TextLabel).Text = `TUTORIAL – SCHRITT {step} VON {GameConfig.TUTORIAL_STEP_COUNT}`;
	(textLabel :: TextLabel).Text = def.text
	frame.Visible = true
	applyStepHighlight(step)
end

-- Meldet dem Server, dass der aktuelle Schritt geschafft sein sollte.
local function requestAdvance()
	if advanceInFlight or currentStep &lt; 1 or currentStep &gt;= DONE_STEP then
		return
	end
	local remote = tutorialActionFunction
	if remote == nil then
		return
	end
	advanceInFlight = true
	task.spawn(function()
		pcall(function()
			return remote:InvokeServer("advance")
		end)
		advanceInFlight = false
	end)
end

-- Prüft die lokale Sicht der Schritt-Bedingung und stößt ggf. "advance" an.
local function evaluateProgress()
	if currentStep == 1 and snapshotBiomeCount &gt;= 1 then
		requestAdvance()
	elseif currentStep == 2 and lifetimeEnergy &gt;= GameConfig.COLLECT_AMOUNT then
		requestAdvance()
	elseif currentStep == 3 and snapshotMaxLevel &gt;= 2 then
		requestAdvance()
	elseif currentStep == 4 and snapshotCollectibles &gt;= 1 then
		requestAdvance()
	end
end

-- Dezente Hinweis-Schilder über leeren Slots (nur für Einsteiger).
local function updateSlotHints()
	if hintsRemoved then
		return
	end

	task.spawn(function()
		local plots = Workspace:FindFirstChild("PlanetPlots")
		local plot = if plots ~= nil then plots:FindFirstChild(`Plot_{localPlayer.UserId}`) else nil
		if plot == nil then
			return
		end

		for slotNumber = 1, GameConfig.PLANET_SLOTS do
			local shouldShow = not occupiedSlots[slotNumber]
			local existing = slotHints[slotNumber]

			if shouldShow and existing == nil then
				local slotPart = plot:FindFirstChild(`Slot_{slotNumber}`)
				if slotPart ~= nil and slotPart:IsA("BasePart") then
					local billboard = Instance.new("BillboardGui")
					billboard.Name = "SlotHint"
					billboard.Size = UDim2.new(0, 90, 0, 22)
					billboard.StudsOffset = Vector3.new(0, 2.5, 0)
					billboard.MaxDistance = 120
					billboard.Adornee = slotPart

					local label = Instance.new("TextLabel")
					label.BackgroundTransparency = 1
					label.Size = UDim2.new(1, 0, 1, 0)
					label.Font = Enum.Font.GothamMedium
					label.TextSize = 12
					label.TextColor3 = SUBTEXT_COLOR
					label.TextTransparency = 0.25
					label.TextStrokeTransparency = 0.7
					label.Text = "Bau-Platz"
					label.Parent = billboard

					billboard.Parent = slotPart
					slotHints[slotNumber] = billboard
				end
			elseif not shouldShow and existing ~= nil then
				existing:Destroy()
				slotHints[slotNumber] = nil
			end
		end
	end)
end

local function removeAllHints()
	if hintsRemoved then
		return
	end
	hintsRemoved = true
	for slotNumber, billboard in slotHints do
		billboard:Destroy()
		slotHints[slotNumber] = nil
	end
	if collectHint ~= nil then
		collectHint:Destroy()
		collectHint = nil
	end
end

-- Kleines "+5 ⚡"-Schild im Sammel-Button für Einsteiger.
local function attachCollectHint()
	task.spawn(function()
		local playerGui = localPlayer:WaitForChild("PlayerGui")
		local button = waitForPath(playerGui, { "PlanetForgeUI", "ButtonBar", "CollectEnergy" }, 10)
		if button == nil or hintsRemoved then
			return
		end

		local hint = Instance.new("TextLabel")
		hint.Name = "BeginnerHint"
		hint.BackgroundTransparency = 1
		hint.AnchorPoint = Vector2.new(0.5, 1)
		hint.Position = UDim2.new(0.5, 0, 1, -1)
		hint.Size = UDim2.new(1, 0, 0, 12)
		hint.Font = Enum.Font.GothamMedium
		hint.TextSize = 10
		hint.TextColor3 = SUBTEXT_COLOR
		hint.Text = `gibt +{GameConfig.COLLECT_AMOUNT} ⚡`
		hint.Parent = button

		collectHint = hint
	end)
end

function TutorialController.init()
	tutorialActionFunction = Remotes.getFunction("TutorialAction")

	buildUI()
	attachCollectHint()

	Remotes.getEvent("TutorialUpdated").OnClientEvent:Connect(function(step: any)
		if typeof(step) == "number" then
			setStep(step)
		end
	end)

	Remotes.getEvent("PlanetUpdated").OnClientEvent:Connect(function(snapshot: any)
		if typeof(snapshot) ~= "table" or typeof(snapshot.biomes) ~= "table" then
			return
		end
		snapshotBiomeCount = 0
		snapshotMaxLevel = 0
		table.clear(occupiedSlots)
		for _, placed in snapshot.biomes :: { any } do
			if typeof(placed) == "table" and typeof(placed.slot) == "number" then
				snapshotBiomeCount += 1
				occupiedSlots[placed.slot] = true
				if typeof(placed.level) == "number" and placed.level &gt; snapshotMaxLevel then
					snapshotMaxLevel = placed.level
				end
			end
		end
		snapshotCollectibles = if typeof(snapshot.collectibles) == "table" then #(snapshot.collectibles :: { any }) else 0

		updateSlotHints()
		evaluateProgress()
	end)

	Remotes.getEvent("EnergyChanged").OnClientEvent:Connect(function(_newEnergy: any, lifetime: any)
		if typeof(lifetime) ~= "number" then
			return
		end
		lifetimeEnergy = lifetime
		if lifetimeEnergy &gt;= GameConfig.TUTORIAL_HINT_LIFETIME_LIMIT then
			removeAllHints()
		end
		evaluateProgress()
	end)

	-- Falls das initiale TutorialUpdated verpasst wurde (Race beim Beitritt):
	-- aktuellen Stand aktiv abfragen.
	task.spawn(function()
		task.wait(2)
		if currentStep == 0 and tutorialActionFunction ~= nil then
			local ok, serverOk, step = pcall(function()
				return (tutorialActionFunction :: RemoteFunction):InvokeServer("status")
			end)
			if ok and serverOk == true and typeof(step) == "number" and currentStep == 0 then
				setStep(step)
			end
		end
	end)
end

return TutorialController
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="PF35">
<Properties>
<string name="Name">UIController</string>
<ProtectedString name="Source">--!strict
-- UIController: baut das komplette HUD von Planet Forge zur Laufzeit per
-- Instance.new auf (Kopfleiste, Aktionsbuttons, Toast-Feed, Loot-Popup,
-- Statistikzeile). Andere Controller zeigen Meldungen über
-- UIController.showToast(message, kind) an.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ConfigFolder = Shared:WaitForChild("Config")

local Remotes = require(Shared:WaitForChild("Remotes") :: ModuleScript) :: {
	getEvent: (name: string) -&gt; RemoteEvent,
	getFunction: (name: string) -&gt; RemoteFunction,
}
local GameConfig = require(ConfigFolder:WaitForChild("GameConfig") :: ModuleScript) :: {
	LOOT_ROLL_COST: number,
}
local RarityConfig = require(ConfigFolder:WaitForChild("RarityConfig") :: ModuleScript) :: {
	Tiers: { [string]: { displayName: string, color: Color3 } },
	TierOrder: { string },
}
local CollectibleConfig = require(ConfigFolder:WaitForChild("CollectibleConfig") :: ModuleScript) :: {
	Collectibles: { [string]: { displayName: string } },
}
local EffectsController = require(script.Parent:WaitForChild("EffectsController") :: ModuleScript) :: {
	playSound: (name: string, pitchOverride: number?) -&gt; (),
	flyEnergyToCounter: (amount: number) -&gt; (),
	burstAtOwnPlanet: (color: Color3?) -&gt; (),
	screenShake: (intensity: number?) -&gt; (),
}

-- Farbschema: dunkle Panels, helle Schrift.
local PANEL_COLOR = Color3.fromRGB(30, 32, 44)
local STROKE_COLOR = Color3.fromRGB(70, 75, 100)
local TEXT_COLOR = Color3.fromRGB(235, 238, 245)
local SUBTEXT_COLOR = Color3.fromRGB(158, 164, 186)

local TOAST_LIFETIME_SECONDS = 4
local FADE_SECONDS = 0.35
local LOOT_POPUP_SECONDS = 3
local LOOT_SUSPENSE_SECONDS = 1.5 -- Spannungsaufbau vor dem Reveal
local LOOT_SUSPENSE_TICK = 0.12

-- Ab diesen Stufen gibt es Screen-Shake + Glow beim Reveal.
local HIGH_TIER: { [string]: boolean } = {
	Legendary = true,
	Mythic = true,
	Cosmic = true,
}

local TOAST_COLORS: { [string]: Color3 } = {
	info = Color3.fromRGB(66, 133, 244),
	success = Color3.fromRGB(76, 175, 110),
	error = Color3.fromRGB(214, 72, 72),
}

local UIController = {}

-- Wird in init() gesetzt; showToast() wartet notfalls kurz darauf.
local toastContainer: Frame? = nil
local toastOrder = 0
local lootPopupGeneration = 0
local activeLootTween: Tween? = nil

-- 1234567 -&gt; "1.234.567" (deutsche Tausendertrennung mit Punkt).
local function formatNumber(value: number): string
	local text = tostring(math.floor(value + 0.5))
	while true do
		local replaced: number
		text, replaced = text:gsub("^(-?%d+)(%d%d%d)", "%1.%2")
		if replaced == 0 then
			break
		end
	end
	return text
end

local function addCorner(parent: Instance, radius: number)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = parent
end

local function addStroke(parent: Instance, color: Color3): UIStroke
	local stroke = Instance.new("UIStroke")
	stroke.Color = color
	stroke.Thickness = 1
	stroke.Parent = parent
	return stroke
end

local function createLabel(parent: Instance, name: string, text: string): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamMedium
	label.TextColor3 = TEXT_COLOR
	label.TextSize = 14
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Text = text
	label.Parent = parent
	return label
end

-- Zeigt eine farbige Einblendung im Feed rechts oben (info/success/error).
local function showToastInternal(message: string, kind: string)
	local container = toastContainer
	if container == nil then
		return
	end

	local accentColor = TOAST_COLORS[kind] or TOAST_COLORS.info

	toastOrder += 1
	local toast = Instance.new("CanvasGroup")
	toast.Name = "Toast"
	toast.LayoutOrder = toastOrder
	toast.Size = UDim2.new(1, 0, 0, 0)
	toast.AutomaticSize = Enum.AutomaticSize.Y
	toast.BackgroundColor3 = PANEL_COLOR
	toast.BorderSizePixel = 0
	addCorner(toast, 8)

	local accent = Instance.new("Frame")
	accent.Name = "Accent"
	accent.Size = UDim2.new(0, 4, 1, 0)
	accent.BackgroundColor3 = accentColor
	accent.BorderSizePixel = 0
	accent.Parent = toast

	local label = createLabel(toast, "Message", message)
	label.Position = UDim2.new(0, 14, 0, 0)
	label.Size = UDim2.new(1, -24, 0, 0)
	label.AutomaticSize = Enum.AutomaticSize.Y
	label.TextWrapped = true

	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, 10)
	padding.PaddingBottom = UDim.new(0, 10)
	padding.Parent = toast

	toast.Parent = container

	-- Nach 4 s ausfaden und entfernen.
	task.delay(TOAST_LIFETIME_SECONDS, function()
		local tween = TweenService:Create(toast, TweenInfo.new(FADE_SECONDS), { GroupTransparency = 1 })
		tween:Play()
		tween.Completed:Once(function()
			toast:Destroy()
		end)
	end)
end

-- Öffentliche API für andere Controller (z. B. PlanetBuilderController).
function UIController.showToast(message: string, kind: string)
	if toastContainer ~= nil then
		showToastInternal(message, kind)
		return
	end
	-- UI ist evtl. noch nicht aufgebaut: kurz warten (max. 10 s), dann anzeigen.
	task.spawn(function()
		local deadline = os.clock() + 10
		while toastContainer == nil and os.clock() &lt; deadline do
			task.wait(0.1)
		end
		if toastContainer ~= nil then
			showToastInternal(message, kind)
		end
	end)
end

-- Ruft eine argumentlose RemoteFunction auf; bei ok=false erscheint die
-- deutsche Fehlermeldung des Servers als Toast, bei Erfolg läuft onSuccess.
local function invokeAction(functionName: string, onSuccess: ((payload: any) -&gt; ())?)
	task.spawn(function()
		local ok, serverOk, payload = pcall(function()
			return Remotes.getFunction(functionName):InvokeServer()
		end)
		if not ok then
			UIController.showToast("Verbindungsfehler – bitte erneut versuchen.", "error")
			return
		end
		if serverOk ~= true then
			local message = if typeof(payload) == "string" then payload else "Aktion fehlgeschlagen."
			UIController.showToast(message, "error")
			return
		end
		if onSuccess ~= nil then
			onSuccess(payload)
		end
	end)
end

local function createActionButton(
	parent: Instance,
	order: number,
	text: string,
	functionName: string,
	onSuccess: ((payload: any) -&gt; ())?
): TextButton
	local button = Instance.new("TextButton")
	button.Name = functionName
	button.LayoutOrder = order
	button.Size = UDim2.new(0, 168, 1, 0)
	button.BackgroundColor3 = PANEL_COLOR
	button.Font = Enum.Font.GothamBold
	button.TextSize = 15
	button.TextColor3 = TEXT_COLOR
	button.Text = text
	button.AutoButtonColor = true
	addCorner(button, 10)
	addStroke(button, STROKE_COLOR)
	button.Activated:Connect(function()
		invokeAction(functionName, onSuccess)
	end)
	button.Parent = parent
	return button
end

type GuiRefs = {
	energyLabel: TextLabel,
	lifetimeLabel: TextLabel,
	statsLabel: TextLabel,
	lootPopup: CanvasGroup,
	lootName: TextLabel,
	lootRarity: TextLabel,
	lootStroke: UIStroke,
}

local function buildGui(playerGui: PlayerGui): GuiRefs
	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "PlanetForgeUI"
	screenGui.ResetOnSpawn = false
	screenGui.IgnoreGuiInset = true
	screenGui.DisplayOrder = 10

	-- Kopfleiste oben: Energie, Lifetime-Energie, Statistikzeile.
	local header = Instance.new("Frame")
	header.Name = "Header"
	header.AnchorPoint = Vector2.new(0.5, 0)
	header.Position = UDim2.new(0.5, 0, 0, 8)
	header.Size = UDim2.new(0, 640, 0, 44)
	header.BackgroundColor3 = PANEL_COLOR
	header.BackgroundTransparency = 0.05
	addCorner(header, 10)
	addStroke(header, STROKE_COLOR)
	header.Parent = screenGui

	local energyLabel = createLabel(header, "Energy", "Energie: 0")
	energyLabel.Position = UDim2.new(0, 16, 0, 0)
	energyLabel.Size = UDim2.new(0, 230, 1, 0)
	energyLabel.Font = Enum.Font.GothamBold
	energyLabel.TextSize = 18

	local lifetimeLabel = createLabel(header, "Lifetime", "Gesamt: 0")
	lifetimeLabel.Position = UDim2.new(0, 254, 0, 0)
	lifetimeLabel.Size = UDim2.new(0, 170, 1, 0)
	lifetimeLabel.TextSize = 12
	lifetimeLabel.TextColor3 = SUBTEXT_COLOR

	local statsLabel = createLabel(header, "Stats", "Besuche: 0  |  Likes: 0")
	statsLabel.AnchorPoint = Vector2.new(1, 0)
	statsLabel.Position = UDim2.new(1, -16, 0, 0)
	statsLabel.Size = UDim2.new(0, 200, 1, 0)
	statsLabel.TextSize = 12
	statsLabel.TextColor3 = SUBTEXT_COLOR
	statsLabel.TextXAlignment = Enum.TextXAlignment.Right

	-- Buttonleiste unten Mitte.
	local buttonBar = Instance.new("Frame")
	buttonBar.Name = "ButtonBar"
	buttonBar.AnchorPoint = Vector2.new(0.5, 1)
	buttonBar.Position = UDim2.new(0.5, 0, 1, -14)
	buttonBar.Size = UDim2.new(0, 540, 0, 50)
	buttonBar.BackgroundTransparency = 1
	buttonBar.Parent = screenGui

	local barLayout = Instance.new("UIListLayout")
	barLayout.FillDirection = Enum.FillDirection.Horizontal
	barLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	barLayout.SortOrder = Enum.SortOrder.LayoutOrder
	barLayout.Padding = UDim.new(0, 10)
	barLayout.Parent = buttonBar

	-- Einsammeln mit Juice: Sound, fliegende "+N ⚡"-Zahl, Partikel am Planeten.
	createActionButton(buttonBar, 1, "Energie sammeln", "CollectEnergy", function(payload: any)
		local amount = if typeof(payload) == "number" then payload else 0
		EffectsController.playSound("collect")
		if amount &gt; 0 then
			EffectsController.flyEnergyToCounter(amount)
		end
		EffectsController.burstAtOwnPlanet(Color3.fromRGB(255, 224, 130))
	end)
	createActionButton(buttonBar, 2, `Fund suchen ({GameConfig.LOOT_ROLL_COST})`, "RollLoot")
	createActionButton(buttonBar, 3, "Nach Hause", "GoHome", function()
		EffectsController.playSound("pop", 0.9)
	end)

	-- Toast-Feed rechts oben.
	local toasts = Instance.new("Frame")
	toasts.Name = "Toasts"
	toasts.AnchorPoint = Vector2.new(1, 0)
	toasts.Position = UDim2.new(1, -14, 0, 64)
	toasts.Size = UDim2.new(0, 300, 1, -160)
	toasts.BackgroundTransparency = 1
	toasts.Parent = screenGui

	local toastLayout = Instance.new("UIListLayout")
	toastLayout.FillDirection = Enum.FillDirection.Vertical
	toastLayout.SortOrder = Enum.SortOrder.LayoutOrder
	toastLayout.Padding = UDim.new(0, 8)
	toastLayout.Parent = toasts

	-- Loot-Popup (zentriert, standardmäßig unsichtbar).
	local lootPopup = Instance.new("CanvasGroup")
	lootPopup.Name = "LootPopup"
	lootPopup.AnchorPoint = Vector2.new(0.5, 0.5)
	lootPopup.Position = UDim2.new(0.5, 0, 0.4, 0)
	lootPopup.Size = UDim2.new(0, 340, 0, 128)
	lootPopup.BackgroundColor3 = PANEL_COLOR
	lootPopup.Visible = false
	addCorner(lootPopup, 12)
	local lootStroke = addStroke(lootPopup, STROKE_COLOR)
	lootStroke.Thickness = 2
	lootPopup.Parent = screenGui

	local lootTitle = createLabel(lootPopup, "Title", "Neuer Fund!")
	lootTitle.Position = UDim2.new(0, 0, 0, 14)
	lootTitle.Size = UDim2.new(1, 0, 0, 18)
	lootTitle.TextXAlignment = Enum.TextXAlignment.Center
	lootTitle.TextColor3 = SUBTEXT_COLOR
	lootTitle.TextSize = 13

	local lootName = createLabel(lootPopup, "Name", "")
	lootName.Position = UDim2.new(0, 12, 0, 40)
	lootName.Size = UDim2.new(1, -24, 0, 30)
	lootName.TextXAlignment = Enum.TextXAlignment.Center
	lootName.Font = Enum.Font.GothamBold
	lootName.TextSize = 22

	local lootRarity = createLabel(lootPopup, "Rarity", "")
	lootRarity.Position = UDim2.new(0, 12, 0, 78)
	lootRarity.Size = UDim2.new(1, -24, 0, 22)
	lootRarity.TextXAlignment = Enum.TextXAlignment.Center
	lootRarity.TextSize = 16

	screenGui.Parent = playerGui
	toastContainer = toasts

	return {
		energyLabel = energyLabel,
		lifetimeLabel = lifetimeLabel,
		statsLabel = statsLabel,
		lootPopup = lootPopup,
		lootName = lootName,
		lootRarity = lootRarity,
		lootStroke = lootStroke,
	}
end

function UIController.init()
	local player = Players.LocalPlayer
	local playerGui = player:WaitForChild("PlayerGui") :: PlayerGui

	local refs = buildGui(playerGui)

	-- Energie-Anzeige aktuell halten.
	Remotes.getEvent("EnergyChanged").OnClientEvent:Connect(function(newEnergy: any, lifetimeEnergy: any)
		if typeof(newEnergy) == "number" then
			refs.energyLabel.Text = `Energie: {formatNumber(newEnergy)}`
		end
		if typeof(lifetimeEnergy) == "number" then
			refs.lifetimeLabel.Text = `Gesamt: {formatNumber(lifetimeEnergy)}`
		end
	end)

	-- Statistikzeile (Besuche/Likes) aus dem Planeten-Snapshot.
	Remotes.getEvent("PlanetUpdated").OnClientEvent:Connect(function(snapshot: any)
		if typeof(snapshot) ~= "table" then
			return
		end
		local visits = if typeof(snapshot.visits) == "number" then snapshot.visits else 0
		local likes = if typeof(snapshot.likes) == "number" then snapshot.likes else 0
		refs.statsLabel.Text = `Besuche: {formatNumber(visits)}  |  Likes: {formatNumber(likes)}`
	end)

	-- Server-Benachrichtigungen in den Toast-Feed leiten.
	Remotes.getEvent("Notification").OnClientEvent:Connect(function(message: any, kind: any)
		if typeof(message) ~= "string" then
			return
		end
		showToastInternal(message, if typeof(kind) == "string" then kind else "info")
	end)

	-- Loot-Popup mit Spannungsaufbau: 1,5 s durchlaufende Seltenheiten,
	-- dann Reveal in der echten Rarity-Farbe; ab Legendär Shake + Glow.
	Remotes.getEvent("LootObtained").OnClientEvent:Connect(function(collectibleId: any, rarity: any, _uid: any)
		if typeof(collectibleId) ~= "string" or typeof(rarity) ~= "string" then
			return
		end

		local collectibleDef = CollectibleConfig.Collectibles[collectibleId]
		local tierDef = RarityConfig.Tiers[rarity]
		local tierColor = if tierDef ~= nil then tierDef.color else TEXT_COLOR

		-- Generation zählt mit, damit sich überlappende Popups nicht gegenseitig
		-- vorzeitig ausblenden oder alte Spannungsphasen weiterlaufen.
		lootPopupGeneration += 1
		local generation = lootPopupGeneration

		-- Einen noch laufenden Fade-Out-Tween abbrechen, sonst blendet er das
		-- gerade neu gezeigte Popup Frame für Frame wieder aus.
		if activeLootTween ~= nil then
			activeLootTween:Cancel()
			activeLootTween = nil
		end

		refs.lootName.Text = "???"
		refs.lootRarity.Text = ""
		refs.lootStroke.Color = STROKE_COLOR
		refs.lootStroke.Thickness = 2
		refs.lootPopup.GroupTransparency = 0
		refs.lootPopup.Visible = true

		task.spawn(function()
			-- Spannungsphase: Seltenheitsstufen rotieren durch.
			local tierOrder = RarityConfig.TierOrder
			local elapsed = 0
			local index = 0
			while elapsed &lt; LOOT_SUSPENSE_SECONDS do
				if generation ~= lootPopupGeneration then
					return
				end
				index = index % #tierOrder + 1
				local cycleTier = RarityConfig.Tiers[tierOrder[index]]
				if cycleTier ~= nil then
					refs.lootRarity.Text = cycleTier.displayName
					refs.lootRarity.TextColor3 = cycleTier.color
					refs.lootStroke.Color = cycleTier.color
				end
				EffectsController.playSound("tick")
				task.wait(LOOT_SUSPENSE_TICK)
				elapsed += LOOT_SUSPENSE_TICK
			end
			if generation ~= lootPopupGeneration then
				return
			end

			-- Reveal.
			refs.lootName.Text = if collectibleDef ~= nil then collectibleDef.displayName else collectibleId
			refs.lootRarity.Text = if tierDef ~= nil then tierDef.displayName else rarity
			refs.lootRarity.TextColor3 = tierColor
			refs.lootStroke.Color = tierColor
			EffectsController.playSound("reveal")

			if HIGH_TIER[rarity] == true then
				EffectsController.playSound("fanfare")
				EffectsController.screenShake(1)
				EffectsController.burstAtOwnPlanet(tierColor)
				-- Glow: Rahmen kurz aufblitzen lassen.
				refs.lootStroke.Thickness = 6
				local glow = TweenService:Create(refs.lootStroke, TweenInfo.new(0.6), { Thickness = 3 })
				glow:Play()
			end

			task.delay(LOOT_POPUP_SECONDS, function()
				if generation ~= lootPopupGeneration then
					return
				end
				local tween =
					TweenService:Create(refs.lootPopup, TweenInfo.new(FADE_SECONDS), { GroupTransparency = 1 })
				activeLootTween = tween
				tween:Play()
				tween.Completed:Once(function()
					if activeLootTween == tween then
						activeLootTween = nil
					end
					if generation == lootPopupGeneration then
						refs.lootPopup.Visible = false
					end
				end)
			end)
		end)
	end)
end

return UIController
</ProtectedString>
</Properties>
