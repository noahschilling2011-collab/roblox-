<Item class="ModuleScript" referent="PF1">
<Properties>
<string name="Name">BiomeConfig</string>
<ProtectedString name="Source">--!strict
-- Konfiguration aller Biome, die auf einem Planeten platziert werden können.
-- Balancing-Canon: Kosten, Freischaltungsschwellen und Einkommenswerte hier
-- ändern, nicht in den Services.

export type BiomeDef = {
	id: string,
	displayName: string,
	description: string,
	baseCost: number,
	upgradeCostMultiplier: number,
	baseEnergyPerMinute: number,
	maxLevel: number,
	color: Color3,
	unlockAtLifetimeEnergy: number,
}

-- Für alle Biome identisch (Canon).
local MAX_LEVEL = 5
local UPGRADE_COST_MULTIPLIER = 1.75

local BiomeConfig = {}

BiomeConfig.Biomes = {
	wiese = {
		id = "wiese",
		displayName = "Wiese",
		description = "Saftiges Gras und erste Blumen – der bescheidene Anfang jedes Planeten.",
		baseCost = 25,
		upgradeCostMultiplier = UPGRADE_COST_MULTIPLIER,
		baseEnergyPerMinute = 1,
		maxLevel = MAX_LEVEL,
		color = Color3.fromRGB(124, 200, 84),
		unlockAtLifetimeEnergy = 0,
	},
	wald = {
		id = "wald",
		displayName = "Wald",
		description = "Dichte Baumkronen voller Leben. Hier raschelt es an jeder Ecke.",
		baseCost = 100,
		upgradeCostMultiplier = UPGRADE_COST_MULTIPLIER,
		baseEnergyPerMinute = 2,
		maxLevel = MAX_LEVEL,
		color = Color3.fromRGB(34, 120, 45),
		unlockAtLifetimeEnergy = 0,
	},
	wueste = {
		id = "wueste",
		displayName = "Wüste",
		description = "Endlose Dünen unter glühender Sonne. Karg, aber voller verborgener Schätze.",
		baseCost = 250,
		upgradeCostMultiplier = UPGRADE_COST_MULTIPLIER,
		baseEnergyPerMinute = 4,
		maxLevel = MAX_LEVEL,
		color = Color3.fromRGB(230, 195, 120),
		unlockAtLifetimeEnergy = 500,
	},
	ozean = {
		id = "ozean",
		displayName = "Ozean",
		description = "Tiefblaues Wasser, das deinen Planeten zum Leuchten bringt.",
		baseCost = 500,
		upgradeCostMultiplier = UPGRADE_COST_MULTIPLIER,
		baseEnergyPerMinute = 8,
		maxLevel = MAX_LEVEL,
		color = Color3.fromRGB(30, 110, 200),
		unlockAtLifetimeEnergy = 1000,
	},
	dschungel = {
		id = "dschungel",
		displayName = "Dschungel",
		description = "Undurchdringliches Grün voller exotischer Rufe und seltener Kreaturen.",
		baseCost = 1000,
		upgradeCostMultiplier = UPGRADE_COST_MULTIPLIER,
		baseEnergyPerMinute = 15,
		maxLevel = MAX_LEVEL,
		color = Color3.fromRGB(18, 150, 72),
		unlockAtLifetimeEnergy = 2500,
	},
	eiswelt = {
		id = "eiswelt",
		displayName = "Eiswelt",
		description = "Glitzernde Gletscher und ewiger Frost – eiskalt, aber wunderschön.",
		baseCost = 2500,
		upgradeCostMultiplier = UPGRADE_COST_MULTIPLIER,
		baseEnergyPerMinute = 30,
		maxLevel = MAX_LEVEL,
		color = Color3.fromRGB(170, 225, 250),
		unlockAtLifetimeEnergy = 5000,
	},
	vulkan = {
		id = "vulkan",
		displayName = "Vulkan",
		description = "Brodelnde Lava und rauchende Krater. Rohe Energie direkt aus dem Planetenkern.",
		baseCost = 5000,
		upgradeCostMultiplier = UPGRADE_COST_MULTIPLIER,
		baseEnergyPerMinute = 60,
		maxLevel = MAX_LEVEL,
		color = Color3.fromRGB(200, 60, 30),
		unlockAtLifetimeEnergy = 10000,
	},
	pilzwald = {
		id = "pilzwald",
		displayName = "Pilzwald",
		description = "Riesige, leuchtende Pilze in schillernden Farben – ein Wald wie aus einem Traum.",
		baseCost = 10000,
		upgradeCostMultiplier = UPGRADE_COST_MULTIPLIER,
		baseEnergyPerMinute = 120,
		maxLevel = MAX_LEVEL,
		color = Color3.fromRGB(170, 90, 200),
		unlockAtLifetimeEnergy = 25000,
	},
	kristallfelder = {
		id = "kristallfelder",
		displayName = "Kristallfelder",
		description = "Felder aus singenden Kristallen, die pure Energie in den Himmel strahlen.",
		baseCost = 25000,
		upgradeCostMultiplier = UPGRADE_COST_MULTIPLIER,
		baseEnergyPerMinute = 250,
		maxLevel = MAX_LEVEL,
		color = Color3.fromRGB(90, 230, 220),
		unlockAtLifetimeEnergy = 50000,
	},
	kosmische_ebene = {
		id = "kosmische_ebene",
		displayName = "Kosmische Ebene",
		description = "Ein Riss ins Universum selbst: Sterne, Nebel und unendliche Kraft.",
		baseCost = 100000,
		upgradeCostMultiplier = UPGRADE_COST_MULTIPLIER,
		baseEnergyPerMinute = 600,
		maxLevel = MAX_LEVEL,
		color = Color3.fromRGB(120, 80, 255),
		unlockAtLifetimeEnergy = 250000,
	},
} :: { [string]: BiomeDef }

-- Gibt alle Biom-IDs sortiert nach baseCost (aufsteigend) zurück.
function BiomeConfig.getSortedIds(): { string }
	local ids: { string } = {}
	for id in BiomeConfig.Biomes do
		table.insert(ids, id)
	end
	table.sort(ids, function(a, b)
		return BiomeConfig.Biomes[a].baseCost &lt; BiomeConfig.Biomes[b].baseCost
	end)
	return ids
end

-- Upgrade-Kosten von Level `currentLevel` auf `currentLevel + 1`:
-- baseCost * upgradeCostMultiplier ^ currentLevel, abgerundet.
function BiomeConfig.getUpgradeCost(biomeId: string, currentLevel: number): number
	local def = BiomeConfig.Biomes[biomeId]
	assert(def ~= nil, `Unbekanntes Biom: {biomeId}`)
	return math.floor(def.baseCost * def.upgradeCostMultiplier ^ currentLevel)
end

return BiomeConfig
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="PF2">
<Properties>
<string name="Name">CollectibleConfig</string>
<ProtectedString name="Source">--!strict
-- Konfiguration aller Sammelobjekte (Tiere, Pflanzen, Artefakte).
-- Objekte mit `ultraRare = true` gehören NICHT zum normalen Loot-Pool:
-- Sie werden separat über RarityConfig.UltraRares gewürfelt und tauchen
-- deshalb bewusst nicht in getIdsByRarity() auf.

local Types = require(script.Parent.Parent.Types)

export type CollectibleDef = {
	id: string,
	displayName: string,
	description: string,
	rarity: Types.RarityTier,
	category: "Tier" | "Pflanze" | "Artefakt",
	tradable: boolean,
	ultraRare: boolean?, -- true = nur über Ultra-Rare-Wurf erhältlich
}

local CollectibleConfig = {}

CollectibleConfig.Collectibles = {
	-- ===== Common (6) =====
	feldmaus = {
		id = "feldmaus",
		displayName = "Feldmaus",
		description = "Ein flinker kleiner Nager, der durchs Gras huscht.",
		rarity = "Common",
		category = "Tier",
		tradable = true,
	},
	wiesenfalter = {
		id = "wiesenfalter",
		displayName = "Wiesenfalter",
		description = "Ein zarter Schmetterling mit weißen Flügeln.",
		rarity = "Common",
		category = "Tier",
		tradable = true,
	},
	gaensebluemchen = {
		id = "gaensebluemchen",
		displayName = "Gänseblümchen",
		description = "Klein, weiß und überall – der Klassiker jeder Wiese.",
		rarity = "Common",
		category = "Pflanze",
		tradable = true,
	},
	loewenzahn = {
		id = "loewenzahn",
		displayName = "Löwenzahn",
		description = "Pustet man ihn an, fliegen die Samen zu neuen Planeten.",
		rarity = "Common",
		category = "Pflanze",
		tradable = true,
	},
	kieselstein = {
		id = "kieselstein",
		displayName = "Glatter Kieselstein",
		description = "Vom Wasser rundgeschliffen. Liegt gut in der Hand.",
		rarity = "Common",
		category = "Artefakt",
		tradable = true,
	},
	tonscherbe = {
		id = "tonscherbe",
		displayName = "Alte Tonscherbe",
		description = "Bruchstück eines uralten Gefäßes. Wer hat es wohl geformt?",
		rarity = "Common",
		category = "Artefakt",
		tradable = true,
	},

	-- ===== Uncommon (6) =====
	rotfuchs = {
		id = "rotfuchs",
		displayName = "Rotfuchs",
		description = "Schlau und scheu – zeigt sich nur geduldigen Beobachtern.",
		rarity = "Uncommon",
		category = "Tier",
		tradable = true,
	},
	schneehase = {
		id = "schneehase",
		displayName = "Schneehase",
		description = "Sein weißes Fell macht ihn im Eis fast unsichtbar.",
		rarity = "Uncommon",
		category = "Tier",
		tradable = true,
	},
	glockenblume = {
		id = "glockenblume",
		displayName = "Glockenblume",
		description = "Läutet leise, wenn der Wind über den Planeten streicht.",
		rarity = "Uncommon",
		category = "Pflanze",
		tradable = true,
	},
	kaktusbluete = {
		id = "kaktusbluete",
		displayName = "Kaktusblüte",
		description = "Blüht nur eine Nacht lang mitten in der Wüste.",
		rarity = "Uncommon",
		category = "Pflanze",
		tradable = true,
	},
	bernstein = {
		id = "bernstein",
		displayName = "Bernsteinklumpen",
		description = "Uraltes Baumharz mit einem winzigen Käfer darin.",
		rarity = "Uncommon",
		category = "Artefakt",
		tradable = true,
	},
	kompass = {
		id = "kompass",
		displayName = "Rostiger Kompass",
		description = "Zeigt nicht nach Norden, sondern immer zum nächsten Schatz.",
		rarity = "Uncommon",
		category = "Artefakt",
		tradable = true,
	},

	-- ===== Rare (4) =====
	polarwolf = {
		id = "polarwolf",
		displayName = "Polarwolf",
		description = "Sein Heulen hallt über die Gletscher der Eiswelt.",
		rarity = "Rare",
		category = "Tier",
		tradable = true,
	},
	lavasalamander = {
		id = "lavasalamander",
		displayName = "Lavasalamander",
		description = "Badet in flüssiger Lava, als wäre sie warmes Wasser.",
		rarity = "Rare",
		category = "Tier",
		tradable = true,
	},
	mondblume = {
		id = "mondblume",
		displayName = "Mondblume",
		description = "Öffnet ihre silbernen Blüten nur im Licht der Monde.",
		rarity = "Rare",
		category = "Pflanze",
		tradable = true,
	},
	sternenkarte = {
		id = "sternenkarte",
		displayName = "Uralte Sternenkarte",
		description = "Zeigt Galaxien, die noch niemand besucht hat.",
		rarity = "Rare",
		category = "Artefakt",
		tradable = true,
	},

	-- ===== Epic (3) =====
	phoenixkueken = {
		id = "phoenixkueken",
		displayName = "Phönixküken",
		description = "Glüht sanft und wird aus seiner eigenen Asche neu geboren.",
		rarity = "Epic",
		category = "Tier",
		tradable = true,
	},
	geisterorchidee = {
		id = "geisterorchidee",
		displayName = "Geisterorchidee",
		description = "Halb durchsichtig – manche behaupten, sie flüstert nachts.",
		rarity = "Epic",
		category = "Pflanze",
		tradable = true,
	},
	meteoritensplitter = {
		id = "meteoritensplitter",
		displayName = "Meteoritensplitter",
		description = "Noch warm vom Sturz durch die Atmosphäre.",
		rarity = "Epic",
		category = "Artefakt",
		tradable = true,
	},

	-- ===== Legendary (2, regulär) =====
	sternenwal = {
		id = "sternenwal",
		displayName = "Sternenwal",
		description = "Gleitet lautlos zwischen den Planeten und singt Lieder aus Sternenstaub.",
		rarity = "Legendary",
		category = "Tier",
		tradable = true,
	},
	weltenbaum_setzling = {
		id = "weltenbaum_setzling",
		displayName = "Weltenbaum-Setzling",
		description = "Ein junger Trieb des Baumes, der einst alle Welten verband.",
		rarity = "Legendary",
		category = "Pflanze",
		tradable = true,
	},

	-- ===== Ultra-Rares (nur über RarityConfig.UltraRares erhältlich) =====
	kristall = {
		id = "kristall",
		displayName = "Leuchtender Kristall",
		description = "Ein 1-zu-10.000-Fund, der in allen Farben des Universums schimmert.",
		rarity = "Legendary",
		category = "Artefakt",
		tradable = true,
		ultraRare = true,
	},
	goldener_drache = {
		id = "goldener_drache",
		displayName = "Goldener Drache",
		description = "Ein 1-zu-100.000-Fund. Sein Schuppenglanz überstrahlt ganze Galaxien.",
		rarity = "Mythic",
		category = "Tier",
		tradable = true,
		ultraRare = true,
	},
	kosmischer_kern = {
		id = "kosmischer_kern",
		displayName = "Kosmischer Kern",
		description = "Ein 1-zu-1.000.000-Fund: das pulsierende Herz eines vergangenen Universums.",
		rarity = "Cosmic",
		category = "Artefakt",
		tradable = true,
		ultraRare = true,
	},
} :: { [string]: CollectibleDef }

-- Gibt alle regulären Sammelobjekt-IDs einer Seltenheitsstufe zurück.
-- Ultra-Rares werden bewusst ausgefiltert (separater Wurf) und alphabetisch
-- sortiert, damit die Auswahl deterministisch bleibt.
function CollectibleConfig.getIdsByRarity(rarity: string): { string }
	local ids: { string } = {}
	for id, def in CollectibleConfig.Collectibles do
		if def.rarity == rarity and def.ultraRare ~= true then
			table.insert(ids, id)
		end
	end
	table.sort(ids)
	return ids
end

return CollectibleConfig
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="PF3">
<Properties>
<string name="Name">EventConfig</string>
<ProtectedString name="Source">--!strict
-- Konfiguration der globalen Live-Events (serverweit, alle Spieler gleichzeitig).
-- Der Scheduler (GlobalEventService) würfelt gemäß GameConfig alle
-- EVENT_CHECK_INTERVAL_SECONDS und wählt dann gewichtet aus dieser Liste.
-- Nicht betroffene Multiplikatoren stehen immer auf 1.

export type GlobalEventDef = {
	id: string,
	displayName: string,
	description: string,
	announceText: string,
	durationSeconds: number,
	weight: number,
	energyMultiplier: number,
	lootLuckMultiplier: number,
}

local EventConfig = {}

EventConfig.Events = {
	meteoritenschauer = {
		id = "meteoritenschauer",
		displayName = "Meteoritenschauer",
		description = "Meteoriten mit seltenen Materialien schlagen überall ein. Fund-Glück verdreifacht.",
		announceText = "Meteoritenschauer! Seltene Materialien regnen vom Himmel – Fund-Glück x3!",
		durationSeconds = 300,
		weight = 30,
		energyMultiplier = 1,
		lootLuckMultiplier = 3,
	},
	goldener_regen = {
		id = "goldener_regen",
		displayName = "Goldener Regen",
		description = "Goldene Tropfen laden alle Planeten auf. Sämtliche Energie-Einnahmen verdoppelt.",
		announceText = "Goldener Regen! Alle Energie-Einnahmen sind verdoppelt – sammelt, was das Zeug hält!",
		durationSeconds = 360,
		weight = 25,
		energyMultiplier = 2,
		lootLuckMultiplier = 1,
	},
	kreaturen_spawn = {
		id = "kreaturen_spawn",
		displayName = "Seltene Kreaturen",
		description = "Scheue, seltene Kreaturen zeigen sich überall. Fund-Glück verfünffacht.",
		announceText = "Seltene Kreaturen gesichtet! Fund-Glück x5 – jetzt oder nie!",
		durationSeconds = 300,
		weight = 15,
		energyMultiplier = 1,
		lootLuckMultiplier = 5,
	},
	alien_invasion = {
		id = "alien_invasion",
		displayName = "Alien-Invasion",
		description = "Außerirdische Besucher bringen Chaos und Beute: Energie x1.5 und Fund-Glück x1.5.",
		announceText = "Alien-Invasion! Die Besucher bringen Energie x1.5 UND Fund-Glück x1.5 mit!",
		durationSeconds = 480,
		weight = 20,
		energyMultiplier = 1.5,
		lootLuckMultiplier = 1.5,
	},
	schwarzes_loch = {
		id = "schwarzes_loch",
		displayName = "Schwarzes Loch",
		description = "Ein Schwarzes Loch verzerrt Raum und Zeit. Alle Energie-Einnahmen verdreifacht.",
		announceText = "Ein Schwarzes Loch ist aufgetaucht! 10 Minuten lang Energie x3 – haltet euch fest!",
		durationSeconds = 600,
		weight = 10,
		energyMultiplier = 3,
		lootLuckMultiplier = 1,
	},
} :: { [string]: GlobalEventDef }

return EventConfig
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="PF4">
<Properties>
<string name="Name">GameConfig</string>
<ProtectedString name="Source">--!strict
-- Globale Spielkonstanten. Balancing-Werte bitte hier ändern, nicht in den Services.

local GameConfig = {
	-- Planet
	PLANET_SLOTS = 12, -- Anzahl Biom-Slots pro Planet
	PLOT_SPACING_STUDS = 512, -- Abstand zwischen Spielerplaneten in der Welt
	PLOT_HEIGHT_STUDS = 120, -- Höhe der schwebenden Planeten über dem Ursprung

	-- Energie
	START_ENERGY = 50,
	COLLECT_AMOUNT = 5, -- Energie pro manuellem Einsammeln
	COLLECT_COOLDOWN_SECONDS = 6,
	PASSIVE_INCOME_INTERVAL_SECONDS = 60, -- Taktung des passiven Biom-Einkommens

	-- Loot
	LOOT_ROLL_COST = 25, -- Energiekosten pro Fund-Wurf

	-- Handel
	MAX_TRADE_ITEMS_PER_SIDE = 4,
	TRADE_LOCK_SECONDS = 3, -- Sicherheitspause nach beidseitigem Akzeptieren

	-- Daten
	PROFILE_SCHEMA_VERSION = 4, -- v2: Kosmetik; v3: Tagesbonus/Name; v4: Tutorial
	DATASTORE_NAME = "PlanetForge_v1",
	AUTOSAVE_INTERVAL_SECONDS = 120,

	-- Globale Events
	EVENT_CHECK_INTERVAL_SECONDS = 60, -- wie oft der Event-Scheduler würfelt
	EVENT_MIN_GAP_SECONDS = 15 * 60, -- Mindestabstand zwischen zwei globalen Events
	EVENT_START_CHANCE = 0.25, -- Chance pro Prüfintervall, dass ein Event startet

	-- Rangliste
	LEADERBOARD_REFRESH_SECONDS = 120, -- Schreib- und Lese-Takt der globalen Ranglisten
	LEADERBOARD_TOP_N = 20, -- Anzahl der angezeigten Plätze
	LEADERBOARD_STORE_LIKES = "PF_Rangliste_Likes_v1",
	LEADERBOARD_STORE_ENERGY = "PF_Rangliste_Energie_v1",

	-- Tagesbonus (Energie je aufeinanderfolgendem Login-Tag; Tag 7+ = letzter Wert)
	DAILY_REWARDS = { 50, 100, 150, 250, 350, 450, 600 },

	-- Planetenname
	PLANET_NAME_MAX_LENGTH = 24,

	-- Tutorial (First-Time Experience)
	TUTORIAL_STEP_COUNT = 4, -- Schritte: Wiese bauen, Energie sammeln, Upgrade, Fund
	TUTORIAL_STEP_REWARD = 15, -- Energie-Belohnung pro abgeschlossenem Schritt
	TUTORIAL_HINT_LIFETIME_LIMIT = 100, -- Hinweis-Schilder verschwinden ab dieser Lifetime-Energie

	-- Sound (Client): zentrale Lautstärke der PlanetForge-Soundgruppe (0..1)
	SOUND_MASTER_VOLUME = 0.5,
}

return GameConfig
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="PF5">
<Properties>
<string name="Name">MonetizationConfig</string>
<ProtectedString name="Source">--!strict
-- Monetarisierung: Gamepässe, Developer Products und der Kosmetik-Katalog.
--
-- GRUNDSATZ (siehe docs/MONETARISIERUNG.md): Für Robux gibt es ausschließlich
-- Kosmetik – Planeten-Skins, Auren, Wettereffekte und Haustiere. Niemals
-- Energie, Fund-Würfe, Loot-Chancen oder andere Spielvorteile.
--
-- EINRICHTUNG: Die IDs unten sind Platzhalter (0). Im Roblox Creator Dashboard
-- unter "Monetarisierung" die Gamepässe bzw. Developer Products anlegen und
-- die echten IDs hier eintragen. Solange eine ID 0 ist, zeigt der Shop den
-- Eintrag als "Bald verfügbar" an und Käufe sind deaktiviert.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types = require(ReplicatedStorage.Shared.Types)

-- Rein optische Eigenschaften; die Anwendung übernimmt PlanetService bzw.
-- MonetizationService (Haustiere).
export type CosmeticVisual = {
	color: Color3?, -- Hauptfarbe (Kern, Partikel, Haustier-Körper)
	secondaryColor: Color3?, -- zweite Farbe für Verläufe
	material: Enum.Material?, -- Material für Kern-Skins und Haustiere
	glow: boolean?, -- true = zusätzliches PointLight
}

export type CosmeticDef = {
	id: Types.CosmeticId,
	displayName: string,
	description: string,
	category: Types.CosmeticCategory,
	visual: CosmeticVisual,
}

export type GamepassDef = {
	key: string,
	gamePassId: number, -- PLATZHALTER: echte ID aus dem Creator Dashboard eintragen
	displayName: string,
	description: string,
	grantsCosmetics: { Types.CosmeticId },
}

export type ProductDef = {
	key: string,
	productId: number, -- PLATZHALTER: echte ID aus dem Creator Dashboard eintragen
	displayName: string,
	description: string,
	grantsCosmetic: Types.CosmeticId,
}

local MonetizationConfig = {}

-- STUDIO-TESTMODUS: Solange Produkt-IDs 0 sind, simuliert ein Klick im Shop
-- den erfolgreichen Kauf - ABER ausschliesslich in Roblox Studio. Der Server
-- prüft RunService:IsStudio() hart (MonetizationService.isTestPurchaseAllowed);
-- in einem veröffentlichten Spiel hat dieses Flag deshalb NIE eine Wirkung.
-- So lassen sich Equip, Haustiere und Effekte ohne echte IDs testen.
MonetizationConfig.testModeInStudio = true

MonetizationConfig.Categories = { "skin", "aura", "wetter", "haustier" }

MonetizationConfig.CategoryNames = {
	skin = "Planeten-Skin",
	aura = "Aura",
	wetter = "Wettereffekt",
	haustier = "Haustier",
}

MonetizationConfig.Cosmetics = {
	-- Planeten-Skins: verändern Material und Farbe des Planetenkerns.
	skin_gold = {
		id = "skin_gold",
		displayName = "Goldener Kern",
		description = "Dein Planetenkern glänzt in purem Gold.",
		category = "skin",
		visual = { color = Color3.fromRGB(226, 176, 44), material = Enum.Material.Metal, glow = true },
	},
	skin_lava = {
		id = "skin_lava",
		displayName = "Lava-Kern",
		description = "Ein glühender Kern aus flüssigem Gestein.",
		category = "skin",
		visual = { color = Color3.fromRGB(255, 96, 32), material = Enum.Material.Neon, glow = true },
	},
	skin_eis = {
		id = "skin_eis",
		displayName = "Eiskern",
		description = "Kristallklares Eis, kalt und wunderschön.",
		category = "skin",
		visual = { color = Color3.fromRGB(160, 220, 255), material = Enum.Material.Ice, glow = false },
	},
	skin_galaxie = {
		id = "skin_galaxie",
		displayName = "Galaxie-Kern",
		description = "Ein Kern wie ein Fenster ins Universum.",
		category = "skin",
		visual = {
			color = Color3.fromRGB(88, 60, 160),
			secondaryColor = Color3.fromRGB(180, 120, 255),
			material = Enum.Material.Glass,
			glow = true,
		},
	},

	-- Auren: Partikel, die den Planetenkern umspielen.
	aura_sternenstaub = {
		id = "aura_sternenstaub",
		displayName = "Sternenstaub-Aura",
		description = "Feiner Sternenstaub funkelt um deinen Planeten.",
		category = "aura",
		visual = { color = Color3.fromRGB(255, 255, 220) },
	},
	aura_regenbogen = {
		id = "aura_regenbogen",
		displayName = "Regenbogen-Aura",
		description = "Ein schimmernder Regenbogen-Schleier.",
		category = "aura",
		visual = { color = Color3.fromRGB(255, 80, 80), secondaryColor = Color3.fromRGB(80, 130, 255) },
	},

	-- Wettereffekte: Atmosphäre über dem Planeten.
	wetter_aurora = {
		id = "wetter_aurora",
		displayName = "Aurora",
		description = "Polarlichter tanzen über deinem Planeten.",
		category = "wetter",
		visual = { color = Color3.fromRGB(80, 255, 180), secondaryColor = Color3.fromRGB(120, 80, 255) },
	},
	wetter_sternschnuppen = {
		id = "wetter_sternschnuppen",
		displayName = "Sternschnuppen",
		description = "Ein steter Strom von Sternschnuppen.",
		category = "wetter",
		visual = { color = Color3.fromRGB(255, 240, 180) },
	},

	-- Haustiere: schweben dekorativ neben dem Besitzer.
	haustier_mini_komet = {
		id = "haustier_mini_komet",
		displayName = "Mini-Komet",
		description = "Ein kleiner Komet, der dir treu folgt.",
		category = "haustier",
		visual = { color = Color3.fromRGB(150, 200, 255), material = Enum.Material.Neon, glow = true },
	},
	haustier_sternenwelpe = {
		id = "haustier_sternenwelpe",
		displayName = "Sternenwelpe",
		description = "Ein verspielter Funke aus purem Sternenlicht.",
		category = "haustier",
		visual = { color = Color3.fromRGB(255, 210, 120), material = Enum.Material.Neon, glow = true },
	},
} :: { [string]: CosmeticDef }

-- Gamepässe: einmaliger Kauf, dauerhafte Freischaltung (auch nach Rejoin).
MonetizationConfig.Gamepasses = {
	gp_kosmische_sammlung = {
		key = "gp_kosmische_sammlung",
		gamePassId = 0,
		displayName = "Kosmische Sammlung",
		description = "Galaxie-Kern-Skin und Sternenstaub-Aura für deinen Planeten.",
		grantsCosmetics = { "skin_galaxie", "aura_sternenstaub" },
	},
	gp_wettermeister = {
		key = "gp_wettermeister",
		gamePassId = 0,
		displayName = "Wettermeister",
		description = "Aurora und Sternschnuppen als Wettereffekte.",
		grantsCosmetics = { "wetter_aurora", "wetter_sternschnuppen" },
	},
	gp_haustier_freund = {
		key = "gp_haustier_freund",
		gamePassId = 0,
		displayName = "Haustier-Freund",
		description = "Mini-Komet und Sternenwelpe begleiten dich.",
		grantsCosmetics = { "haustier_mini_komet", "haustier_sternenwelpe" },
	},
} :: { [string]: GamepassDef }

-- Developer Products: schalten je eine Kosmetik dauerhaft frei.
-- (Bereits gekaufte Produkte zeigt der Shop als "Im Besitz" an.)
MonetizationConfig.DeveloperProducts = {
	prod_skin_gold = {
		key = "prod_skin_gold",
		productId = 0,
		displayName = "Goldener Kern",
		description = "Schaltet den goldenen Planetenkern frei.",
		grantsCosmetic = "skin_gold",
	},
	prod_skin_lava = {
		key = "prod_skin_lava",
		productId = 0,
		displayName = "Lava-Kern",
		description = "Schaltet den Lava-Planetenkern frei.",
		grantsCosmetic = "skin_lava",
	},
	prod_skin_eis = {
		key = "prod_skin_eis",
		productId = 0,
		displayName = "Eiskern",
		description = "Schaltet den Eis-Planetenkern frei.",
		grantsCosmetic = "skin_eis",
	},
	prod_aura_regenbogen = {
		key = "prod_aura_regenbogen",
		productId = 0,
		displayName = "Regenbogen-Aura",
		description = "Schaltet die Regenbogen-Aura frei.",
		grantsCosmetic = "aura_regenbogen",
	},
} :: { [string]: ProductDef }

-- Sortierte Schlüssel für stabile Shop-Anzeige.
function MonetizationConfig.getGamepassKeys(): { string }
	local keys = {}
	for key in MonetizationConfig.Gamepasses do
		table.insert(keys, key)
	end
	table.sort(keys)
	return keys
end

function MonetizationConfig.getProductKeys(): { string }
	local keys = {}
	for key in MonetizationConfig.DeveloperProducts do
		table.insert(keys, key)
	end
	table.sort(keys)
	return keys
end

-- Findet ein Developer Product anhand seiner Roblox-Produkt-ID (für ProcessReceipt).
function MonetizationConfig.findProductByProductId(productId: number): ProductDef?
	for _, def in MonetizationConfig.DeveloperProducts do
		if def.productId ~= 0 and def.productId == productId then
			return def
		end
	end
	return nil
end

return MonetizationConfig
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="PF6">
<Properties>
<string name="Name">RarityConfig</string>
<ProtectedString name="Source">--!strict
-- Konfiguration der Seltenheitsstufen und Ultra-Rare-Würfe.
-- Die Gewichte gelten für den normalen Loot-Pool; Mythic und Cosmic haben
-- Gewicht 0 und sind AUSSCHLIESSLICH über die Ultra-Rare-Würfe erhältlich.

export type TierDef = {
	displayName: string,
	color: Color3,
	weight: number,
}

export type UltraRareDef = {
	collectibleId: string,
	oneIn: number,
}

local RarityConfig = {}

-- Reihenfolge von häufig nach selten (für Sortierung und UI).
RarityConfig.TierOrder = {
	"Common",
	"Uncommon",
	"Rare",
	"Epic",
	"Legendary",
	"Mythic",
	"Cosmic",
} :: { string }

RarityConfig.Tiers = {
	Common = {
		displayName = "Gewöhnlich",
		color = Color3.fromRGB(170, 170, 170), -- grau
		weight = 60,
	},
	Uncommon = {
		displayName = "Ungewöhnlich",
		color = Color3.fromRGB(76, 175, 80), -- grün
		weight = 25,
	},
	Rare = {
		displayName = "Selten",
		color = Color3.fromRGB(66, 133, 244), -- blau
		weight = 10,
	},
	Epic = {
		displayName = "Episch",
		color = Color3.fromRGB(156, 39, 176), -- violett
		weight = 4,
	},
	Legendary = {
		displayName = "Legendär",
		color = Color3.fromRGB(255, 152, 0), -- orange
		weight = 1,
	},
	Mythic = {
		displayName = "Mythisch",
		color = Color3.fromRGB(255, 215, 0), -- gold
		weight = 0, -- nicht im normalen Pool
	},
	Cosmic = {
		displayName = "Kosmisch",
		color = Color3.fromRGB(0, 229, 255), -- türkis
		weight = 0, -- nicht im normalen Pool
	},
} :: { [string]: TierDef }

-- Ultra-Rares werden VOR dem normalen Tier-Wurf einzeln gewürfelt,
-- die seltensten zuerst. Loot-Glück verbessert die Chance:
-- effektiv oneIn(max(1, math.floor(n / lootLuckMultiplier))).
RarityConfig.UltraRares = {
	{ collectibleId = "kosmischer_kern", oneIn = 1000000 }, -- Cosmic
	{ collectibleId = "goldener_drache", oneIn = 100000 }, -- Mythic
	{ collectibleId = "kristall", oneIn = 10000 }, -- Legendary
} :: { UltraRareDef }

return RarityConfig
</ProtectedString>
</Properties>
</Item>
</Item>
<Item class="ModuleScript" referent="PF8">
<Properties>
<string name="Name">Remotes</string>
<ProtectedString name="Source">--!strict
-- Zentrale Definition aller RemoteEvents und RemoteFunctions.
-- Der Server erstellt die Instanzen einmalig über Remotes.init(),
-- Server und Client holen sie über Remotes.getEvent() / Remotes.getFunction().
--
-- Konventionen für Signaturen:
--
--   RemoteEvents (Server -&gt; Client):
--     EnergyChanged(newEnergy: number, lifetimeEnergy: number)
--     PlanetUpdated(snapshot: { biomes: {...}, collectibles: {...}, visits: number, likes: number })
--     LootObtained(collectibleId: string, rarity: string, uid: string)
--     GlobalEventStarted(eventId: string, endsAt: number)
--     GlobalEventEnded(eventId: string)
--     TradeUpdated(tradeSnapshot: any?) -- nil = keine aktive Handelssitzung
--     Notification(message: string, kind: "info" | "success" | "error")
--     CosmeticsUpdated(owned: { string }, equipped: { [string]: string })
--     LeaderboardUpdated(boards: { likes: { LBEntry }, energy: { LBEntry } })
--       mit LBEntry = { userId: number, name: string, value: number }
--     TutorialUpdated(step: number) -- 1..4 = offener Schritt, 5 = abgeschlossen
--
--   RemoteFunctions (Client -&gt; Server), geben immer (ok: boolean, payload: any?) zurück:
--     PlaceBiome(biomeId: string, slot: number)
--     UpgradeBiome(slot: number)
--     CollectEnergy()
--     RollLoot()
--     RequestVisit(targetUserId: number)
--     GoHome()
--     LikePlanet(targetUserId: number)
--     TradeAction(action: "invite" | "acceptInvite" | "setOffer" | "toggleAccept" | "cancel", payload: any?)
--     EquipCosmetic(category: string, cosmeticId: string?) -- nil = Kategorie ablegen
--     RenamePlanet(name: string) -- gibt bei ok den gefilterten Namen zurück
--     TutorialAction(action: "advance" | "skip") -- Server validiert den Fortschritt
--     SimulatePurchase(kind: "gamepass" | "product", key: string)
--       NUR Studio-Testmodus (Server prüft RunService:IsStudio() hart)

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local FOLDER_NAME = "PlanetForgeRemotes"

local EVENT_NAMES = {
	"EnergyChanged",
	"PlanetUpdated",
	"LootObtained",
	"GlobalEventStarted",
	"GlobalEventEnded",
	"TradeUpdated",
	"Notification",
	"CosmeticsUpdated",
	"LeaderboardUpdated",
	"TutorialUpdated",
}

local FUNCTION_NAMES = {
	"PlaceBiome",
	"UpgradeBiome",
	"CollectEnergy",
	"RollLoot",
	"RequestVisit",
	"GoHome",
	"LikePlanet",
	"TradeAction",
	"EquipCosmetic",
	"RenamePlanet",
	"TutorialAction",
	"SimulatePurchase",
}

local Remotes = {}

local function getFolder(): Folder
	return ReplicatedStorage:WaitForChild(FOLDER_NAME) :: Folder
end

-- Erstellt alle Remote-Instanzen. Darf nur einmal und nur auf dem Server laufen.
function Remotes.init()
	assert(RunService:IsServer(), "Remotes.init() darf nur auf dem Server aufgerufen werden")
	assert(
		ReplicatedStorage:FindFirstChild(FOLDER_NAME) == nil,
		"Remotes.init() wurde bereits aufgerufen"
	)

	local folder = Instance.new("Folder")
	folder.Name = FOLDER_NAME

	for _, name in EVENT_NAMES do
		local remote = Instance.new("RemoteEvent")
		remote.Name = name
		remote.Parent = folder
	end

	for _, name in FUNCTION_NAMES do
		local remote = Instance.new("RemoteFunction")
		remote.Name = name
		remote.Parent = folder
	end

	folder.Parent = ReplicatedStorage
end

function Remotes.getEvent(name: string): RemoteEvent
	return getFolder():WaitForChild(name) :: RemoteEvent
end

function Remotes.getFunction(name: string): RemoteFunction
	return getFolder():WaitForChild(name) :: RemoteFunction
end

return Remotes
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="PF9">
<Properties>
<string name="Name">Types</string>
<ProtectedString name="Source">--!strict
-- Gemeinsame Typdefinitionen für Planet Forge.
-- Diese Typen beschreiben das Datenmodell eines Spielerplaneten und werden
-- von Server und Client gleichermaßen verwendet.

export type BiomeId = string
export type CollectibleId = string
export type GlobalEventId = string
export type CosmeticId = string

-- Kategorien kaufbarer Kosmetik (nur Optik, niemals Spielvorteile).
export type CosmeticCategory = "skin" | "aura" | "wetter" | "haustier"

export type RarityTier = "Common" | "Uncommon" | "Rare" | "Epic" | "Legendary" | "Mythic" | "Cosmic"

-- Ein auf dem Planeten platziertes Biom (belegt genau einen Slot).
export type PlacedBiome = {
	biomeId: BiomeId,
	slot: number, -- 1 .. GameConfig.PLANET_SLOTS
	level: number, -- Ausbaustufe, 1 .. BiomeConfig.Biomes[biomeId].maxLevel
	placedAt: number, -- Unix-Zeitstempel (os.time())
}

-- Ein konkretes Sammelobjekt im Besitz eines Spielers.
-- `uid` identifiziert die Instanz eindeutig (wichtig für den Handel).
export type OwnedCollectible = {
	uid: string,
	collectibleId: CollectibleId,
	obtainedAt: number,
	source: "loot" | "event" | "trade",
}

-- Persistenter Spielstand eines Spielers.
export type PlayerProfile = {
	version: number, -- Schema-Version für spätere Migrationen
	energy: number,
	lifetimeEnergy: number, -- insgesamt jemals verdiente Energie (steuert Freischaltungen)
	biomes: { PlacedBiome },
	collectibles: { OwnedCollectible },
	visits: number, -- wie oft dieser Planet besucht wurde
	likes: number, -- Bewertungen anderer Spieler
	createdAt: number,
	ownedCosmetics: { CosmeticId }, -- per Robux freigeschaltete Kosmetik
	equippedCosmetics: { [string]: CosmeticId }, -- Kategorie -&gt; ausgerüstete Kosmetik
	planetName: string, -- vom Spieler vergebener, gefilterter Name ("" = Standard)
	dailyStreak: number, -- aufeinanderfolgende Login-Tage (Tagesbonus)
	lastDailyClaimDay: number, -- UTC-Tagesnummer des letzten Tagesbonus (os.time() / 86400)
	tutorialStep: number, -- nächster offener Tutorial-Schritt (1..4); 5 = abgeschlossen
}

-- Ein aktuell laufendes globales Event.
export type ActiveGlobalEvent = {
	eventId: GlobalEventId,
	startedAt: number,
	endsAt: number,
}

-- Eine Seite einer Handelssitzung.
export type TradeSide = {
	userId: number,
	offeredUids: { string }, -- uids aus OwnedCollectible
	offeredEnergy: number,
	accepted: boolean,
}

-- Zustand einer Handelssitzung zwischen genau zwei Spielern.
export type TradeSession = {
	id: string,
	sides: { TradeSide }, -- immer genau 2 Einträge
	state: "negotiating" | "locked" | "completed" | "cancelled",
	createdAt: number,
}

return {}
</ProtectedString>
</Properties>
</Item>
<Item class="Folder" referent="PF11">
<Properties>
<string name="Name">Util</string>
</Properties>
<Item class="ModuleScript" referent="PF10">
<Properties>
<string name="Name">WeightedRandom</string>
<ProtectedString name="Source">--!strict
-- Hilfsfunktionen für gewichtete Zufallsauswahl und "1 zu n"-Würfe.
-- Alle Loot-Würfe laufen ausschließlich auf dem Server (server-autoritativ).

export type WeightedEntry&lt;T&gt; = {
	value: T,
	weight: number,
}

local defaultRng = Random.new()

local WeightedRandom = {}

-- Wählt einen Eintrag proportional zu seinem Gewicht aus.
function WeightedRandom.pick&lt;T&gt;(entries: { WeightedEntry&lt;T&gt; }, rng: Random?): T
	assert(#entries &gt; 0, "WeightedRandom.pick benötigt mindestens einen Eintrag")
	local random = rng or defaultRng

	local totalWeight = 0
	for _, entry in entries do
		assert(entry.weight &gt; 0, "Gewichte müssen positiv sein")
		totalWeight += entry.weight
	end

	local roll = random:NextNumber() * totalWeight
	for _, entry in entries do
		roll -= entry.weight
		if roll &lt;= 0 then
			return entry.value
		end
	end

	-- Fließkomma-Restfall: letzten Eintrag zurückgeben.
	return entries[#entries].value
end

-- Gibt mit einer Chance von exakt 1 zu n `true` zurück
-- (z. B. n = 10_000 für den Leuchtenden Kristall).
function WeightedRandom.oneIn(n: number, rng: Random?): boolean
	assert(n &gt;= 1, "n muss &gt;= 1 sein")
	local random = rng or defaultRng
	return random:NextInteger(1, math.floor(n)) == 1
end

return WeightedRandom
</ProtectedString>
</Properties>
</Item>
</Item>
</Item>
</Item>
<Item class="ServerScriptService" referent="PF41">
<Properties>
<string name="Name">ServerScriptService</string>
</Properties>
<Item class="Script" referent="PF27">
<Properties>
<string name="Name">Server</string>
<ProtectedString name="Source">--!strict
-- Einstiegspunkt des Servers.
-- Erstellt zuerst alle Remotes und startet danach die Services in fester Reihenfolge.
-- Konvention: Jeder Service liegt unter Services/&lt;Name&gt;.luau und exportiert
-- eine Tabelle mit einer init()-Funktion, die schnell zurückkehrt
-- (langlaufende Schleifen gehören in task.spawn innerhalb des Services).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes") :: ModuleScript) :: any

Remotes.init()

-- Reihenfolge ist bewusst gewählt: erst Daten, dann die darauf aufbauenden Systeme.
local SERVICE_STARTUP_ORDER = {
	"DataService",
	"PlanetService",
	"EnergyService",
	"LootService",
	"GlobalEventService",
	"VisitService",
	"TradeService",
	"MonetizationService",
	"LeaderboardService",
	"DailyRewardService",
	"TutorialService",
	"SelfCheckService", -- immer zuletzt: prüft den fertigen Aufbau
}

local servicesFolder = script:WaitForChild("Services")

for _, serviceName in SERVICE_STARTUP_ORDER do
	local moduleInstance = servicesFolder:WaitForChild(serviceName) :: ModuleScript
	local service = (require)(moduleInstance) :: { init: () -&gt; () }

	local ok, err = pcall(service.init)
	if ok then
		print(`[PlanetForge] {serviceName} gestartet`)
	else
		warn(`[PlanetForge] {serviceName} konnte nicht starten: {err}`)
	end
end

print("[PlanetForge] Server bereit")
</ProtectedString>
</Properties>
<Item class="Folder" referent="PF26">
<Properties>
<string name="Name">Services</string>
</Properties>
<Item class="ModuleScript" referent="PF13">
<Properties>
<string name="Name">BiomeVisuals</string>
<ProtectedString name="Source">--!strict
-- BiomeVisuals: prozedurale Deko-Sets für die Biom-Slots (KEIN Service,
-- reine Bau-Hilfe für den PlanetService).
--
-- Jedes Biom bekommt ein kleines Set aus 3-6 einfachen Parts (Wald =
-- Stämme + Kronen, Wüste = Dünen + Kaktus, Ozean = Wasserscheibe usw.).
-- Höhere Level erzeugen sichtbar mehr Objekte. Die Platzierung ist pro
-- Slot und Level deterministisch (gleicher Seed -&gt; gleicher Look), damit
-- der Planet nach einem Rejoin identisch aussieht.
--
-- BiomeVisuals.build(slotPart, biomeId, level, withPop) ersetzt das
-- Deko-Model unter dem Slot; withPop = true lässt die Teile mit einem
-- Scale-Pop-Tween erscheinen (beim Bauen/Upgraden).

local TweenService = game:GetService("TweenService")

local SLOT_TOP_OFFSET = 0.5 -- halbe Slot-Dicke: Deko steht auf der Oberfläche
local SCATTER_RADIUS = 4.6 -- Streuradius um die Slot-Mitte
local POP_SECONDS = 0.3

export type BuilderFn = (model: Model, top: Vector3, level: number, rng: Random) -&gt; ()

local BiomeVisuals = {}

-- Anzahl Deko-Objekte je Level (Level 1 = 3, Level 5 = 7).
local function objectCount(level: number): number
	return math.clamp(2 + level, 3, 7)
end

local function newPart(
	model: Model,
	shape: Enum.PartType,
	size: Vector3,
	color: Color3,
	material: Enum.Material,
	cframe: CFrame,
	transparency: number?
): BasePart
	local part = Instance.new("Part")
	part.Shape = shape
	part.Size = size
	part.Color = color
	part.Material = material
	part.CFrame = cframe
	part.Transparency = transparency or 0
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Parent = model
	return part
end

-- Zufälliger Punkt auf der Slot-Oberfläche (deterministisch über rng).
local function scatter(top: Vector3, rng: Random, radius: number?): Vector3
	local r = (radius or SCATTER_RADIUS) * math.sqrt(rng:NextNumber())
	local angle = rng:NextNumber() * 2 * math.pi
	return top + Vector3.new(math.cos(angle) * r, 0, math.sin(angle) * r)
end

local function yaw(rng: Random): CFrame
	return CFrame.Angles(0, rng:NextNumber() * 2 * math.pi, 0)
end

--------------------------------------------------------------------------
-- Bausteine
--------------------------------------------------------------------------

local function buildTree(model: Model, base: Vector3, rng: Random, trunkHeight: number, crownColor: Color3)
	newPart(
		model,
		Enum.PartType.Cylinder,
		Vector3.new(trunkHeight, 0.6, 0.6),
		Color3.fromRGB(96, 67, 43),
		Enum.Material.Wood,
		CFrame.new(base + Vector3.new(0, trunkHeight / 2, 0)) * CFrame.Angles(0, 0, math.rad(90))
	)
	local crownSize = trunkHeight * 0.9 + rng:NextNumber() * 0.6
	newPart(
		model,
		Enum.PartType.Ball,
		Vector3.new(crownSize, crownSize, crownSize),
		crownColor,
		Enum.Material.Grass,
		CFrame.new(base + Vector3.new(0, trunkHeight + crownSize * 0.35, 0))
	)
end

local function buildCactus(model: Model, base: Vector3, rng: Random)
	local height = 1.6 + rng:NextNumber() * 1.2
	local green = Color3.fromRGB(88, 148, 82)
	newPart(
		model,
		Enum.PartType.Cylinder,
		Vector3.new(height, 0.7, 0.7),
		green,
		Enum.Material.Grass,
		CFrame.new(base + Vector3.new(0, height / 2, 0)) * CFrame.Angles(0, 0, math.rad(90))
	)
	-- Ein kleiner Seitenarm.
	newPart(
		model,
		Enum.PartType.Cylinder,
		Vector3.new(0.9, 0.5, 0.5),
		green,
		Enum.Material.Grass,
		CFrame.new(base + Vector3.new(0.55, height * 0.6, 0)) * CFrame.Angles(0, 0, math.rad(35))
	)
end

--------------------------------------------------------------------------
-- Biom-Baumeister (einer pro Canon-Biom)
--------------------------------------------------------------------------

BiomeVisuals.Builders = {
	wiese = function(model: Model, top: Vector3, level: number, rng: Random)
		for i = 1, objectCount(level) do
			local base = scatter(top, rng)
			if i % 2 == 0 then
				-- Grasbüschel: flachgedrückte grüne Kugel.
				local s = 0.7 + rng:NextNumber() * 0.6
				newPart(model, Enum.PartType.Ball, Vector3.new(s * 1.6, s, s * 1.6),
					Color3.fromRGB(96, 170, 84), Enum.Material.Grass, CFrame.new(base + Vector3.new(0, s * 0.3, 0)))
			else
				-- Blume: dünner Stiel + bunte Blüte.
				local petals = { Color3.fromRGB(235, 120, 150), Color3.fromRGB(240, 200, 90), Color3.fromRGB(150, 140, 235) }
				newPart(model, Enum.PartType.Cylinder, Vector3.new(0.9, 0.12, 0.12),
					Color3.fromRGB(90, 150, 70), Enum.Material.Grass,
					CFrame.new(base + Vector3.new(0, 0.45, 0)) * CFrame.Angles(0, 0, math.rad(90)))
				newPart(model, Enum.PartType.Ball, Vector3.new(0.4, 0.4, 0.4),
					petals[rng:NextInteger(1, #petals)], Enum.Material.SmoothPlastic,
					CFrame.new(base + Vector3.new(0, 0.95, 0)))
			end
		end
	end,

	wald = function(model: Model, top: Vector3, level: number, rng: Random)
		for _ = 1, objectCount(level) - 1 do
			buildTree(model, scatter(top, rng), rng, 1.8 + rng:NextNumber() * 1.4, Color3.fromRGB(58, 125, 60))
		end
		-- Ein Findling als Akzent.
		newPart(model, Enum.PartType.Ball, Vector3.new(0.9, 0.7, 0.9),
			Color3.fromRGB(120, 118, 112), Enum.Material.Slate, CFrame.new(scatter(top, rng)) * yaw(rng))
	end,

	wueste = function(model: Model, top: Vector3, level: number, rng: Random)
		for i = 1, objectCount(level) do
			local base = scatter(top, rng)
			if i % 3 == 0 then
				buildCactus(model, base, rng)
			else
				-- Düne: flache Sandkugel.
				local s = 1.2 + rng:NextNumber() * 1.4
				newPart(model, Enum.PartType.Ball, Vector3.new(s * 1.8, s * 0.5, s * 1.3),
					Color3.fromRGB(214, 186, 130), Enum.Material.Sand,
					CFrame.new(base + Vector3.new(0, s * 0.12, 0)) * yaw(rng))
			end
		end
	end,

	ozean = function(model: Model, top: Vector3, level: number, rng: Random)
		-- Wasserscheibe über fast dem ganzen Slot, mit Glasglanz.
		newPart(model, Enum.PartType.Cylinder, Vector3.new(0.35, 11, 11),
			Color3.fromRGB(60, 140, 210), Enum.Material.Glass,
			CFrame.new(top + Vector3.new(0, 0.18, 0)) * CFrame.Angles(0, 0, math.rad(90)), 0.35)
		for _ = 1, objectCount(level) - 2 do
			-- Kleine Felsen, die aus dem Wasser ragen.
			local s = 0.5 + rng:NextNumber() * 0.7
			newPart(model, Enum.PartType.Ball, Vector3.new(s, s * 0.8, s),
				Color3.fromRGB(105, 110, 120), Enum.Material.Slate,
				CFrame.new(scatter(top, rng, 3.6) + Vector3.new(0, 0.3, 0)) * yaw(rng))
		end
		-- Dezentes Funkeln auf der Wasseroberfläche.
		local sparkleAnchor = newPart(model, Enum.PartType.Block, Vector3.new(0.2, 0.2, 0.2),
			Color3.new(1, 1, 1), Enum.Material.SmoothPlastic, CFrame.new(top + Vector3.new(0, 0.6, 0)), 1)
		local emitter = Instance.new("ParticleEmitter")
		emitter.Color = ColorSequence.new(Color3.fromRGB(220, 245, 255))
		emitter.LightEmission = 0.8
		emitter.Rate = 2
		emitter.Lifetime = NumberRange.new(0.8, 1.4)
		emitter.Speed = NumberRange.new(0.5, 1)
		emitter.Size = NumberSequence.new(0.25)
		emitter.Parent = sparkleAnchor
	end,

	dschungel = function(model: Model, top: Vector3, level: number, rng: Random)
		for _ = 1, objectCount(level) - 1 do
			buildTree(model, scatter(top, rng), rng, 2.6 + rng:NextNumber() * 1.6, Color3.fromRGB(38, 105, 44))
		end
		-- Grosses Blatt als Unterholz-Akzent.
		newPart(model, Enum.PartType.Block, Vector3.new(1.6, 0.1, 0.9),
			Color3.fromRGB(52, 130, 58), Enum.Material.Grass,
			CFrame.new(scatter(top, rng) + Vector3.new(0, 0.3, 0)) * yaw(rng) * CFrame.Angles(math.rad(20), 0, 0))
	end,

	eiswelt = function(model: Model, top: Vector3, level: number, rng: Random)
		for i = 1, objectCount(level) do
			local base = scatter(top, rng)
			if i % 2 == 0 then
				-- Eiskristall: gekippter Block.
				local h = 1.2 + rng:NextNumber() * 1.6
				newPart(model, Enum.PartType.Block, Vector3.new(0.6, h, 0.6),
					Color3.fromRGB(170, 220, 250), Enum.Material.Ice,
					CFrame.new(base + Vector3.new(0, h / 2, 0)) * yaw(rng) * CFrame.Angles(math.rad(rng:NextNumber() * 14 - 7), 0, math.rad(45)), 0.15)
			else
				-- Schneehaufen.
				local s = 0.9 + rng:NextNumber() * 0.9
				newPart(model, Enum.PartType.Ball, Vector3.new(s * 1.5, s * 0.6, s * 1.2),
					Color3.fromRGB(240, 246, 252), Enum.Material.Snow,
					CFrame.new(base + Vector3.new(0, s * 0.15, 0)) * yaw(rng))
			end
		end
	end,

	vulkan = function(model: Model, top: Vector3, level: number, rng: Random)
		-- Vulkankegel in der Slot-Mitte: zwei gestapelte Zylinder + Lavakuppe.
		newPart(model, Enum.PartType.Cylinder, Vector3.new(1.4, 4.6, 4.6),
			Color3.fromRGB(62, 58, 56), Enum.Material.Basalt,
			CFrame.new(top + Vector3.new(0, 0.7, 0)) * CFrame.Angles(0, 0, math.rad(90)))
		newPart(model, Enum.PartType.Cylinder, Vector3.new(1.2, 2.8, 2.8),
			Color3.fromRGB(52, 48, 46), Enum.Material.Basalt,
			CFrame.new(top + Vector3.new(0, 1.9, 0)) * CFrame.Angles(0, 0, math.rad(90)))
		local lava = newPart(model, Enum.PartType.Ball, Vector3.new(1.8, 1.1, 1.8),
			Color3.fromRGB(255, 96, 32), Enum.Material.Neon, CFrame.new(top + Vector3.new(0, 2.6, 0)))
		-- Glut-Partikel aus dem Krater.
		local emitter = Instance.new("ParticleEmitter")
		emitter.Color = ColorSequence.new(Color3.fromRGB(255, 140, 40), Color3.fromRGB(255, 60, 20))
		emitter.LightEmission = 1
		emitter.Rate = 3 + level
		emitter.Lifetime = NumberRange.new(0.6, 1.2)
		emitter.Speed = NumberRange.new(2, 4)
		emitter.Size = NumberSequence.new(0.3)
		emitter.Parent = lava
		-- Lavabrocken drumherum (mehr pro Level).
		for _ = 1, objectCount(level) - 2 do
			local s = 0.5 + rng:NextNumber() * 0.6
			newPart(model, Enum.PartType.Ball, Vector3.new(s, s * 0.8, s),
				Color3.fromRGB(90, 60, 50), Enum.Material.CrackedLava,
				CFrame.new(scatter(top, rng) + Vector3.new(0, s * 0.3, 0)) * yaw(rng))
		end
	end,

	pilzwald = function(model: Model, top: Vector3, level: number, rng: Random)
		local caps = { Color3.fromRGB(206, 74, 74), Color3.fromRGB(150, 96, 208) }
		for i = 1, objectCount(level) do
			local base = scatter(top, rng)
			local stemHeight = 0.9 + rng:NextNumber() * 1.3
			newPart(model, Enum.PartType.Cylinder, Vector3.new(stemHeight, 0.5, 0.5),
				Color3.fromRGB(226, 214, 190), Enum.Material.SmoothPlastic,
				CFrame.new(base + Vector3.new(0, stemHeight / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)))
			local capSize = 0.9 + rng:NextNumber() * 0.8
			-- Ab Level 3 leuchtet jeder dritte Pilz.
			local glowing = level &gt;= 3 and i % 3 == 0
			newPart(model, Enum.PartType.Ball, Vector3.new(capSize, capSize * 0.55, capSize),
				caps[rng:NextInteger(1, #caps)],
				if glowing then Enum.Material.Neon else Enum.Material.SmoothPlastic,
				CFrame.new(base + Vector3.new(0, stemHeight + capSize * 0.15, 0)))
		end
	end,

	kristallfelder = function(model: Model, top: Vector3, level: number, rng: Random)
		local colors = { Color3.fromRGB(110, 230, 230), Color3.fromRGB(170, 120, 255) }
		for i = 1, objectCount(level) do
			local base = scatter(top, rng)
			local h = 1.4 + rng:NextNumber() * 2
			local crystal = newPart(model, Enum.PartType.Block, Vector3.new(0.55, h, 0.55),
				colors[i % 2 + 1],
				if i % 2 == 0 then Enum.Material.Neon else Enum.Material.Glass,
				CFrame.new(base + Vector3.new(0, h / 2, 0)) * yaw(rng) * CFrame.Angles(math.rad(rng:NextNumber() * 16 - 8), 0, math.rad(45)), 0.1)
			if level &gt;= 3 and i == 1 then
				local light = Instance.new("PointLight")
				light.Color = crystal.Color
				light.Range = 8
				light.Brightness = 0.8
				light.Parent = crystal
			end
		end
	end,

	kosmische_ebene = function(model: Model, top: Vector3, level: number, rng: Random)
		for i = 1, objectCount(level) do
			local base = scatter(top, rng)
			if i % 2 == 0 then
				-- Schwebender Felsbrocken.
				local s = 0.5 + rng:NextNumber() * 0.8
				newPart(model, Enum.PartType.Block, Vector3.new(s, s * 0.8, s),
					Color3.fromRGB(70, 66, 92), Enum.Material.Slate,
					CFrame.new(base + Vector3.new(0, 1.2 + rng:NextNumber() * 2, 0)) * yaw(rng) * CFrame.Angles(math.rad(20), 0, math.rad(15)))
			else
				-- Kleiner leuchtender Stern.
				newPart(model, Enum.PartType.Ball, Vector3.new(0.35, 0.35, 0.35),
					Color3.fromRGB(255, 235, 170), Enum.Material.Neon,
					CFrame.new(base + Vector3.new(0, 0.8 + rng:NextNumber() * 2.4, 0)))
			end
		end
		-- Sanftes Sternenflimmern über dem Slot.
		local anchor = newPart(model, Enum.PartType.Block, Vector3.new(0.2, 0.2, 0.2),
			Color3.new(1, 1, 1), Enum.Material.SmoothPlastic, CFrame.new(top + Vector3.new(0, 2, 0)), 1)
		local emitter = Instance.new("ParticleEmitter")
		emitter.Color = ColorSequence.new(Color3.fromRGB(200, 190, 255))
		emitter.LightEmission = 1
		emitter.Rate = 2
		emitter.Lifetime = NumberRange.new(1, 2)
		emitter.Speed = NumberRange.new(0.3, 0.8)
		emitter.Size = NumberSequence.new(0.2)
		emitter.Parent = anchor
	end,
} :: { [string]: BuilderFn }

--------------------------------------------------------------------------
-- Öffentliche API
--------------------------------------------------------------------------

-- Baut das Deko-Set eines Slots neu auf (ersetzt ein vorhandenes).
function BiomeVisuals.build(slotPart: BasePart, biomeId: string, level: number, withPop: boolean)
	local existing = slotPart:FindFirstChild("Deko")
	if existing ~= nil then
		existing:Destroy()
	end

	local builder = BiomeVisuals.Builders[biomeId]
	if builder == nil then
		warn(`[PlanetForge] Kein Deko-Set für Biom {biomeId}`)
		return
	end

	local model = Instance.new("Model")
	model.Name = "Deko"

	local top = slotPart.Position + Vector3.new(0, SLOT_TOP_OFFSET, 0)
	-- Deterministischer Seed pro Slot-Position und Level.
	local seed = math.floor(math.abs(slotPart.Position.X) * 7 + math.abs(slotPart.Position.Z) * 13) + level * 101
	builder(model, top, level, Random.new(seed))

	model.Parent = slotPart

	-- Scale-Pop: Teile wachsen mit Back-Easing auf ihre Zielgröße.
	if withPop then
		for _, child in model:GetDescendants() do
			if child:IsA("BasePart") then
				local targetSize = child.Size
				child.Size = targetSize * 0.05
				TweenService:Create(
					child,
					TweenInfo.new(POP_SECONDS, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
					{ Size = targetSize }
				):Play()
			end
		end
	end
end

-- Entfernt das Deko-Set (leerer Slot).
function BiomeVisuals.clear(slotPart: BasePart)
	local existing = slotPart:FindFirstChild("Deko")
	if existing ~= nil then
		existing:Destroy()
	end
end

return BiomeVisuals
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="PF14">
<Properties>
<string name="Name">DailyRewardService</string>
<ProtectedString name="Source">--!strict
-- DailyRewardService: Tagesbonus mit Login-Streak.
--
-- Beim ersten Beitritt eines UTC-Tages erhält der Spieler automatisch Energie.
-- Aufeinanderfolgende Tage erhöhen den Streak (Tag 1..7); ein verpasster Tag
-- setzt auf Tag 1 zurück. Die Belohnungshöhen stehen in
-- GameConfig.DAILY_REWARDS (Tag 7+ = letzter Eintrag, der Streak-Zähler
-- läuft für die Anzeige weiter).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage.Shared.Remotes)
local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)

local DataService = require(script.Parent.DataService)
local EnergyService = require(script.Parent.EnergyService)

local SECONDS_PER_DAY = 24 * 60 * 60

local notificationEvent: RemoteEvent? = nil

local DailyRewardService = {}

-- UTC-Tagesnummer (ganze Tage seit Unix-Epoche).
local function currentDayNumber(): number
	return math.floor(os.time() / SECONDS_PER_DAY)
end

-- Belohnung für einen Streak-Tag (über die Tabellenlänge hinaus: letzter Wert).
local function rewardForStreak(streak: number): number
	local rewards = GameConfig.DAILY_REWARDS
	local index = math.clamp(streak, 1, #rewards)
	return rewards[index]
end

local function claimIfDue(player: Player)
	local profile = DataService.waitForProfile(player)
	if profile == nil then
		return -- Spieler bereits weg
	end

	local today = currentDayNumber()
	if profile.lastDailyClaimDay &gt;= today then
		return -- heute schon kassiert (oder Uhr lief rückwärts: nie doppelt zahlen)
	end

	local newStreak: number
	if profile.lastDailyClaimDay == today - 1 then
		newStreak = profile.dailyStreak + 1
	else
		newStreak = 1
	end

	local reward = rewardForStreak(newStreak)
	profile.lastDailyClaimDay = today
	profile.dailyStreak = newStreak
	DataService.markDirty(player)

	EnergyService.grantEnergy(player, reward)

	if notificationEvent ~= nil then
		(notificationEvent :: RemoteEvent):FireClient(
			player,
			`Tagesbonus Tag {newStreak}: +{reward} Energie! Komm morgen wieder für mehr.`,
			"success"
		)
	end
end

function DailyRewardService.init()
	notificationEvent = Remotes.getEvent("Notification")

	Players.PlayerAdded:Connect(function(player)
		task.spawn(claimIfDue, player)
	end)
	for _, player in Players:GetPlayers() do
		task.spawn(claimIfDue, player)
	end
end

return DailyRewardService
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="PF15">
<Properties>
<string name="Name">DataService</string>
<ProtectedString name="Source">--!strict
-- DataService: Persistenz der Spielerprofile über DataStoreService.
--
-- HINWEIS FÜR PRODUKTION:
-- Dieses Skelett nutzt bewusst einfaches Last-Writer-Wins OHNE Session-Locking.
-- Für einen echten Launch ist Session-Locking nötig (z. B. via ProfileStore),
-- damit parallele Sessions desselben Spielers (Server-Wechsel, Absturz-Rejoins)
-- den Spielstand nicht gegenseitig überschreiben.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types = require(ReplicatedStorage.Shared.Types)
local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)

local KEY_PREFIX = "player_"
local MAX_LOAD_ATTEMPTS = 3
local LOAD_BACKOFF_SECONDS = { 1, 2, 4 } -- Wartezeit nach dem 1./2./3. Fehlversuch
local WAIT_POLL_SECONDS = 0.1

-- Ein Session-Eintrag pro eingeloggtem Spieler.
type SessionEntry = {
	profile: Types.PlayerProfile,
	dirty: boolean, -- true = beim nächsten Autosave sichern
	saveable: boolean, -- false = Laden schlug fehl; niemals speichern, sonst würde ein alter Stand überschrieben
}

local sessions: { [Player]: SessionEntry } = {}

-- DataStore-Handle; wird auf nil gesetzt, wenn kein API-Zugriff möglich ist
-- (z. B. in Studio ohne aktivierten Studio-API-Zugriff).
local store: DataStore? = nil

local DataService = {}

-- Tiefe Kopie eines (JSON-artigen) Wertes.
local function deepCopy(value: any): any
	if typeof(value) == "table" then
		local copy = {}
		for key, child in value do
			copy[key] = deepCopy(child)
		end
		return copy
	end
	return value
end

-- Frisches Standardprofil (tiefe Kopie pro Spieler, niemals geteilt).
local function buildDefaultProfile(): Types.PlayerProfile
	return {
		version = GameConfig.PROFILE_SCHEMA_VERSION,
		energy = GameConfig.START_ENERGY,
		lifetimeEnergy = 0,
		biomes = {},
		collectibles = {},
		visits = 0,
		likes = 0,
		createdAt = os.time(),
		ownedCosmetics = {},
		equippedCosmetics = {},
		planetName = "",
		dailyStreak = 0,
		lastDailyClaimDay = 0,
		tutorialStep = 1,
	}
end

-- Schema-Migration: fehlende Felder aus dem Standardprofil ergänzen und
-- die Versionsnummer hochsetzen. Unbekannte/kaputte Daten -&gt; Standardprofil.
local function migrateProfile(loaded: any): Types.PlayerProfile
	local default = buildDefaultProfile()
	if typeof(loaded) ~= "table" then
		return default
	end

	local version = loaded.version
	if typeof(version) ~= "number" or version &lt; GameConfig.PROFILE_SCHEMA_VERSION then
		for key, defaultValue in default :: { [string]: any } do
			if loaded[key] == nil then
				loaded[key] = deepCopy(defaultValue)
			end
		end
		loaded.version = GameConfig.PROFILE_SCHEMA_VERSION
	end

	return loaded :: Types.PlayerProfile
end

-- Lädt das Profil eines Spielers mit bis zu MAX_LOAD_ATTEMPTS Versuchen.
-- Rückgabe: (profile, saveable). saveable = false bedeutet: nur Standardprofil,
-- darf nicht gespeichert werden.
local function loadProfile(player: Player): (Types.PlayerProfile, boolean)
	local dataStore = store
	if dataStore == nil then
		warn(`[PlanetForge] Kein DataStore-Zugriff - Standardprofil für {player.Name} (wird nicht gespeichert)`)
		return buildDefaultProfile(), false
	end

	local key = KEY_PREFIX .. player.UserId
	for attempt = 1, MAX_LOAD_ATTEMPTS do
		local ok, result = pcall(function()
			return dataStore:GetAsync(key)
		end)

		if ok then
			if result == nil then
				-- Neuer Spieler: frisches Standardprofil, darf gespeichert werden.
				return buildDefaultProfile(), true
			end
			return migrateProfile(result), true
		end

		local message = tostring(result)
		warn(`[PlanetForge] Laden fehlgeschlagen für {player.Name} (Versuch {attempt}/{MAX_LOAD_ATTEMPTS}): {message}`)

		-- Studio ohne API-Zugriff: sauber degradieren statt weiter zu versuchen.
		if string.find(string.lower(message), "studio", 1, true) ~= nil then
			store = nil
			warn("[PlanetForge] Studio ohne DataStore-API-Zugriff erkannt - es wird nichts gespeichert")
			break
		end

		if attempt &lt; MAX_LOAD_ATTEMPTS then
			task.wait(LOAD_BACKOFF_SECONDS[attempt])
		end
	end

	warn(`[PlanetForge] Alle Ladeversuche fehlgeschlagen - Standardprofil für {player.Name} (wird nicht gespeichert)`)
	return buildDefaultProfile(), false
end

-- Speichert einen Session-Eintrag via UpdateAsync (Last-Writer-Wins, siehe Kopfkommentar).
local function saveProfile(player: Player, entry: SessionEntry): boolean
	local dataStore = store
	if dataStore == nil or not entry.saveable then
		return false
	end

	local key = KEY_PREFIX .. player.UserId
	-- Tiefe Kopie, damit spätere Änderungen den laufenden Schreibvorgang nicht stören.
	local snapshot = deepCopy(entry.profile)

	local ok, err = pcall(function()
		dataStore:UpdateAsync(key, function()
			return snapshot
		end)
	end)

	if ok then
		entry.dirty = false
		return true
	end

	warn(`[PlanetForge] Speichern fehlgeschlagen für {player.Name}: {err}`)
	return false
end

local function onPlayerAdded(player: Player)
	local profile, saveable = loadProfile(player)

	-- Spieler könnte den Server während des (yieldenden) Ladens verlassen haben.
	if player.Parent == nil then
		return
	end

	sessions[player] = {
		profile = profile,
		dirty = false,
		saveable = saveable,
	}
end

local function onPlayerRemoving(player: Player)
	local entry = sessions[player]
	sessions[player] = nil
	if entry ~= nil then
		saveProfile(player, entry)
	end
end

function DataService.init()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(GameConfig.DATASTORE_NAME)
	end)
	if ok then
		store = result
	else
		warn(`[PlanetForge] GetDataStore fehlgeschlagen: {result}`)
	end

	Players.PlayerAdded:Connect(function(player)
		task.spawn(onPlayerAdded, player)
	end)
	Players.PlayerRemoving:Connect(onPlayerRemoving)

	-- Spieler, die vor init() beigetreten sind (z. B. Studio-Solo-Test).
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end

	-- Autosave-Schleife: sichert regelmäßig nur veränderte Profile.
	-- Die dirty-Einträge werden erst ohne Yield eingesammelt: saveProfile yieldet
	-- (UpdateAsync), und ein während der Iteration beitretender Spieler würde
	-- `sessions` mitten in der Schleife verändern (undefiniertes Verhalten).
	task.spawn(function()
		while true do
			task.wait(GameConfig.AUTOSAVE_INTERVAL_SECONDS)

			local toSave = {}
			for player, entry in sessions do
				if entry.dirty then
					table.insert(toSave, { player = player, entry = entry })
				end
			end

			for _, item in toSave do
				-- Nur speichern, wenn der Spieler noch da ist (sonst hat
				-- PlayerRemoving bereits gesichert und aufgeräumt).
				if sessions[item.player] == item.entry then
					saveProfile(item.player, item.entry)
				end
			end
		end
	end)

	-- Beim Server-Shutdown alle verbliebenen Profile sichern und synchron warten.
	game:BindToClose(function()
		local pending = 0
		for player, entry in sessions do
			pending += 1
			task.spawn(function()
				saveProfile(player, entry)
				pending -= 1
			end)
		end
		while pending &gt; 0 do
			task.wait(WAIT_POLL_SECONDS)
		end
	end)
end

-- Gibt das Profil zurück oder nil, solange es noch nicht geladen ist.
function DataService.getProfile(player: Player): Types.PlayerProfile?
	local entry = sessions[player]
	if entry ~= nil then
		return entry.profile
	end
	return nil
end

-- Yieldet, bis das Profil geladen ist. Gibt nil zurück, sobald der Spieler weg ist.
function DataService.waitForProfile(player: Player): Types.PlayerProfile?
	while player.Parent ~= nil do
		local entry = sessions[player]
		if entry ~= nil then
			return entry.profile
		end
		task.wait(WAIT_POLL_SECONDS)
	end
	return nil
end

-- Markiert das Profil, damit es beim nächsten Autosave gesichert wird.
function DataService.markDirty(player: Player)
	local entry = sessions[player]
	if entry ~= nil then
		entry.dirty = true
	end
end

return DataService
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="PF16">
<Properties>
<string name="Name">EnergyService</string>
<ProtectedString name="Source">--!strict
-- EnergyService: autoritative Energie-Ökonomie von Planet Forge.
-- Verwaltet Guthaben (energy) und Lebenszeit-Statistik (lifetimeEnergy),
-- das manuelle Einsammeln (CollectEnergy) und das passive Biom-Einkommen.
-- Alle Beträge werden serverseitig validiert; der Client meldet nur Wünsche.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types = require(ReplicatedStorage.Shared.Types)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local BiomeConfig = require(ReplicatedStorage.Shared.Config.BiomeConfig)

local DataService = require(script.Parent.DataService)
local GlobalEventService = require(script.Parent.GlobalEventService)

local EnergyService = {}

-- Zeitpunkt (os.clock) des letzten manuellen Einsammelns pro Spieler.
local lastCollectAt: { [Player]: number } = {}

local energyChangedEvent: RemoteEvent? = nil

-- Prüft, ob ein Betrag eine nicht-negative, endliche Zahl ist.
local function isValidAmount(amount: any): boolean
	return typeof(amount) == "number"
		and amount == amount -- filtert NaN
		and amount ~= math.huge -- filtert +unendlich (&gt;= 0 filtert -unendlich)
		and amount &gt;= 0
end

-- Informiert den Besitzer über seinen aktuellen Energiestand.
local function fireEnergyChanged(player: Player, profile: Types.PlayerProfile)
	local event = energyChangedEvent
	if event == nil then
		event = Remotes.getEvent("EnergyChanged")
		energyChangedEvent = event
	end
	event:FireClient(player, profile.energy, profile.lifetimeEnergy)
end

-- Aktuelles Guthaben; 0 solange das Profil noch nicht geladen ist.
function EnergyService.getEnergy(player: Player): number
	local profile: Types.PlayerProfile? = DataService.getProfile(player)
	if profile == nil then
		return 0
	end
	return profile.energy
end

-- Schreibt Energie MIT Event-Multiplikator gut und erhöht auch lifetimeEnergy.
-- Rundet nach dem Multiplikator ab (mindestens 1, wenn baseAmount &gt;= 1).
-- Gibt den tatsächlich gutgeschriebenen Betrag zurück (0 bei Fehlern).
function EnergyService.grantEnergy(player: Player, baseAmount: number): number
	local profile: Types.PlayerProfile? = DataService.getProfile(player)
	if profile == nil or not isValidAmount(baseAmount) then
		return 0
	end

	local multiplier = GlobalEventService.getEnergyMultiplier()
	if not isValidAmount(multiplier) or multiplier &lt;= 0 then
		multiplier = 1
	end

	local amount = math.floor(baseAmount * multiplier)
	if baseAmount &gt;= 1 then
		amount = math.max(amount, 1)
	end
	if amount &lt;= 0 then
		return 0
	end

	profile.energy += amount
	profile.lifetimeEnergy += amount
	DataService.markDirty(player)
	fireEnergyChanged(player, profile)
	return amount
end

-- Schreibt Energie OHNE Multiplikator und OHNE lifetimeEnergy gut
-- (z. B. für Handel oder Erstattungen).
function EnergyService.addRaw(player: Player, amount: number)
	local profile: Types.PlayerProfile? = DataService.getProfile(player)
	if profile == nil or not isValidAmount(amount) then
		return
	end

	local rounded = math.floor(amount)
	if rounded &lt;= 0 then
		return
	end

	profile.energy += rounded
	DataService.markDirty(player)
	fireEnergyChanged(player, profile)
end

-- Prüft das Guthaben und zieht den Betrag ab. true = erfolgreich abgebucht.
function EnergyService.trySpend(player: Player, amount: number): boolean
	local profile: Types.PlayerProfile? = DataService.getProfile(player)
	if profile == nil or not isValidAmount(amount) then
		return false
	end

	local cost = math.floor(amount)
	if profile.energy &lt; cost then
		return false
	end

	profile.energy -= cost
	DataService.markDirty(player)
	fireEnergyChanged(player, profile)
	return true
end

-- Summiert das Biom-Einkommen (Energie pro Minute) eines Profils.
local function computeIncomePerMinute(profile: Types.PlayerProfile): number
	local perMinute = 0
	for _, placed in profile.biomes do
		local def = BiomeConfig.Biomes[placed.biomeId]
		if def ~= nil then
			perMinute += def.baseEnergyPerMinute * placed.level
		end
	end
	return perMinute
end

function EnergyService.init()
	energyChangedEvent = Remotes.getEvent("EnergyChanged")

	-- Manuelles Einsammeln: fester Betrag mit Cooldown pro Spieler.
	local collectFunction = Remotes.getFunction("CollectEnergy")
	collectFunction.OnServerInvoke = function(player: Player): (boolean, any?)
		local profile: Types.PlayerProfile? = DataService.getProfile(player)
		if profile == nil then
			return false, "Dein Spielstand wird noch geladen."
		end

		local now = os.clock()
		local last = lastCollectAt[player]
		if last ~= nil then
			local remaining = GameConfig.COLLECT_COOLDOWN_SECONDS - (now - last)
			if remaining &gt; 0 then
				return false, `Noch {string.format("%.1f", remaining)} Sekunden Abklingzeit.`
			end
		end

		lastCollectAt[player] = now
		local granted = EnergyService.grantEnergy(player, GameConfig.COLLECT_AMOUNT)
		return true, granted
	end

	-- Initialen Energiestand senden, sobald das Profil geladen ist,
	-- damit die UI von Anfang an korrekte Werte zeigt.
	local function onPlayerAdded(player: Player)
		task.spawn(function()
			local profile: Types.PlayerProfile? = DataService.waitForProfile(player)
			if profile ~= nil and player.Parent ~= nil then
				fireEnergyChanged(player, profile)
			end
		end)
	end

	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in Players:GetPlayers() do
		onPlayerAdded(player)
	end

	Players.PlayerRemoving:Connect(function(player: Player)
		lastCollectAt[player] = nil
	end)

	-- Passives Biom-Einkommen: alle PASSIVE_INCOME_INTERVAL_SECONDS wird das
	-- Minuten-Einkommen anteilig auf das Intervall skaliert und gutgeschrieben.
	task.spawn(function()
		local intervalMinutes = GameConfig.PASSIVE_INCOME_INTERVAL_SECONDS / 60
		while true do
			task.wait(GameConfig.PASSIVE_INCOME_INTERVAL_SECONDS)
			for _, player in Players:GetPlayers() do
				local profile: Types.PlayerProfile? = DataService.getProfile(player)
				if profile ~= nil then
					local income = computeIncomePerMinute(profile) * intervalMinutes
					if income &gt; 0 then
						EnergyService.grantEnergy(player, income)
					end
				end
			end
		end
	end)
end

return EnergyService
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="PF17">
<Properties>
<string name="Name">GlobalEventService</string>
<ProtectedString name="Source">--!strict
-- GlobalEventService: serverweite Live-Events (Meteoritenschauer, Goldener Regen, ...).
-- Ein Scheduler würfelt gemäß GameConfig regelmäßig, ob ein Event startet.
-- Aktive Events liefern Energie- und Loot-Glück-Multiplikatoren für andere Services.
--
-- Cross-Server-Synchronisation läuft über MessagingService (Topic PF_GLOBAL_EVENT):
-- Der startende Server publiziert das Event, alle anderen übernehmen es.
-- HINWEIS FÜR PRODUKTION: Für echte Eindeutigkeit (genau EIN Server startet Events)
-- braucht es eine MemoryStore-basierte Wahl eines Leader-Servers.
-- Hier bewusst einfach gehalten: identische startedAt-Werte werden nicht doppelt
-- übernommen, seltene Kollisionen zweier Server sind für dieses Skelett akzeptabel.

local MessagingService = game:GetService("MessagingService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types = require(ReplicatedStorage.Shared.Types)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local EventConfig = require(ReplicatedStorage.Shared.Config.EventConfig)
local WeightedRandom = require(ReplicatedStorage.Shared.Util.WeightedRandom)

local MESSAGING_TOPIC = "PF_GLOBAL_EVENT"

local rng = Random.new()

-- Aktuell laufendes Event (nil = keines aktiv).
local activeEvent: Types.ActiveGlobalEvent? = nil
-- 0 bedeutet: noch nie ein Event gelaufen -&gt; der Mindestabstand ist sofort erfüllt.
local lastEventEndedAt = 0

-- Gewichtete Auswahl-Liste einmalig aus der Konfiguration aufbauen.
local weightedEvents: { WeightedRandom.WeightedEntry&lt;EventConfig.GlobalEventDef&gt; } = {}
for _, def in EventConfig.Events do
	table.insert(weightedEvents, { value = def, weight = def.weight })
end

local GlobalEventService = {}

-- Beendet das übergebene Event, falls es noch das aktive ist.
-- Der Identitätsvergleich verhindert Doppel-Enden (task.delay UND Watchdog).
local function endEvent(expected: Types.ActiveGlobalEvent)
	if activeEvent ~= expected then
		return
	end
	activeEvent = nil
	lastEventEndedAt = os.time()

	Remotes.getEvent("GlobalEventEnded"):FireAllClients(expected.eventId)

	local def = EventConfig.Events[expected.eventId]
	if def ~= nil then
		Remotes.getEvent("Notification"):FireAllClients(`{def.displayName} ist vorbei.`, "info")
	end
end

-- Setzt ein Event als aktiv, informiert alle Clients und plant das Ende.
-- publish = true nur beim lokal gestarteten Event (nicht beim Übernehmen von anderen Servern).
local function startEvent(def: EventConfig.GlobalEventDef, startedAt: number, endsAt: number, publish: boolean)
	local newEvent: Types.ActiveGlobalEvent = {
		eventId = def.id,
		startedAt = startedAt,
		endsAt = endsAt,
	}
	activeEvent = newEvent

	Remotes.getEvent("GlobalEventStarted"):FireAllClients(def.id, endsAt)
	Remotes.getEvent("Notification"):FireAllClients(def.announceText, "info")

	-- Ende präzise planen; der Watchdog im Scheduler fängt verpasste Enden ab.
	task.delay(math.max(endsAt - os.time(), 0), function()
		endEvent(newEvent)
	end)

	if publish then
		local ok, err = pcall(function()
			MessagingService:PublishAsync(MESSAGING_TOPIC, {
				eventId = def.id,
				startedAt = startedAt,
				endsAt = endsAt,
			})
		end)
		if not ok then
			warn(`[PlanetForge] Event-Broadcast fehlgeschlagen: {err}`)
		end
	end
end

-- Nachricht eines anderen Servers (oder das Echo der eigenen) verarbeiten.
local function onCrossServerMessage(message: { Data: any })
	local data = message.Data
	if typeof(data) ~= "table" then
		return
	end

	local eventId = data.eventId
	local startedAt = data.startedAt
	local endsAt = data.endsAt
	if typeof(eventId) ~= "string" or typeof(startedAt) ~= "number" or typeof(endsAt) ~= "number" then
		return
	end

	local def = EventConfig.Events[eventId]
	if def == nil or endsAt &lt;= os.time() then
		return
	end

	local current = activeEvent
	if current ~= nil then
		-- Dasselbe Event läuft bereits (u. a. das Echo der eigenen Publish-Nachricht):
		-- identische startedAt-Werte nicht doppelt übernehmen. Läuft lokal ein
		-- anderes Event, wird es bewusst nicht unterbrochen.
		return
	end

	startEvent(def, startedAt, endsAt, false)
end

-- Scheduler-Tick: Watchdog für das laufende Event bzw. Startwurf für ein neues.
local function schedulerTick()
	local current = activeEvent
	if current ~= nil then
		-- Watchdog: falls task.delay das Ende verpasst hat (endsAt erreicht).
		if os.time() &gt;= current.endsAt then
			endEvent(current)
		end
		return
	end

	if os.time() - lastEventEndedAt &lt; GameConfig.EVENT_MIN_GAP_SECONDS then
		return
	end
	if rng:NextNumber() &gt;= GameConfig.EVENT_START_CHANCE then
		return
	end

	local def = WeightedRandom.pick(weightedEvents, rng)
	local startedAt = os.time()
	startEvent(def, startedAt, startedAt + def.durationSeconds, true)
end

function GlobalEventService.init()
	-- Cross-Server-Nachrichten abonnieren (SubscribeAsync yieldet -&gt; task.spawn).
	task.spawn(function()
		local ok, err = pcall(function()
			MessagingService:SubscribeAsync(MESSAGING_TOPIC, onCrossServerMessage)
		end)
		if not ok then
			warn(`[PlanetForge] Event-Subscribe fehlgeschlagen: {err}`)
		end
	end)

	-- Später beitretende Spieler bekommen ein laufendes Event direkt gemeldet.
	Players.PlayerAdded:Connect(function(player)
		local current = activeEvent
		if current ~= nil and os.time() &lt; current.endsAt then
			Remotes.getEvent("GlobalEventStarted"):FireClient(player, current.eventId, current.endsAt)
			local def = EventConfig.Events[current.eventId]
			if def ~= nil then
				Remotes.getEvent("Notification"):FireClient(player, def.announceText, "info")
			end
		end
	end)

	-- Endlosschleife des Schedulers gehört nicht in init selbst -&gt; task.spawn.
	task.spawn(function()
		while true do
			task.wait(GameConfig.EVENT_CHECK_INTERVAL_SECONDS)
			schedulerTick()
		end
	end)
end

-- Das aktuell laufende Event oder nil.
function GlobalEventService.getActiveEvent(): Types.ActiveGlobalEvent?
	return activeEvent
end

-- Energie-Multiplikator des aktiven Events, sonst 1.
function GlobalEventService.getEnergyMultiplier(): number
	local current = activeEvent
	if current == nil then
		return 1
	end
	local def = EventConfig.Events[current.eventId]
	if def == nil then
		return 1
	end
	return def.energyMultiplier
end

-- Loot-Glück-Multiplikator des aktiven Events, sonst 1.
function GlobalEventService.getLootLuckMultiplier(): number
	local current = activeEvent
	if current == nil then
		return 1
	end
	local def = EventConfig.Events[current.eventId]
	if def == nil then
		return 1
	end
	return def.lootLuckMultiplier
end

return GlobalEventService
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="PF18">
<Properties>
<string name="Name">LeaderboardService</string>
<ProtectedString name="Source">--!strict
-- LeaderboardService: Ranglisten für Planet Forge.
--
-- Zwei Ebenen:
--   1. leaderstats: die eingebaute Roblox-Spielerliste zeigt Energie, Likes
--      und Besuche aller Spieler im aktuellen Server (live, alle 5 s).
--   2. Globale Ranglisten über OrderedDataStores ("Meiste Likes" und
--      "Meiste Gesamt-Energie" über alle Server hinweg): Werte werden
--      periodisch und beim Verlassen geschrieben, die Top-Liste wird
--      periodisch gelesen und per LeaderboardUpdated an alle Clients
--      verteilt (Anzeige: LeaderboardController).
--
-- In Studio ohne DataStore-Zugriff degradiert der Service sauber:
-- leaderstats funktionieren weiter, die globalen Listen bleiben leer.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types = require(ReplicatedStorage.Shared.Types)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)

local DataService = require(script.Parent.DataService)

local LEADERSTATS_UPDATE_SECONDS = 5

export type LeaderboardEntry = {
	userId: number,
	name: string,
	value: number,
}

export type LeaderboardSnapshot = {
	likes: { LeaderboardEntry },
	energy: { LeaderboardEntry },
}

local likesStore: OrderedDataStore? = nil
local energyStore: OrderedDataStore? = nil

local leaderboardUpdatedEvent: RemoteEvent? = nil

-- Zuletzt gelesene Top-Listen (werden neuen Spielern direkt geschickt).
local lastSnapshot: LeaderboardSnapshot = { likes = {}, energy = {} }

-- Cache für Namen von Spielern, die nicht (mehr) im Server sind.
local nameCache: { [number]: string } = {}

local LeaderboardService = {}

-- Erstellt die leaderstats-Werte für die eingebaute Spielerliste.
local function createLeaderstats(player: Player)
	if player:FindFirstChild("leaderstats") ~= nil then
		return
	end
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"

	for _, statName in { "Energie", "Likes", "Besuche" } do
		local value = Instance.new("IntValue")
		value.Name = statName
		value.Value = 0
		value.Parent = stats
	end

	stats.Parent = player
end

local function updateLeaderstats(player: Player, profile: Types.PlayerProfile)
	local stats = player:FindFirstChild("leaderstats")
	if stats == nil then
		return
	end
	local energie = stats:FindFirstChild("Energie")
	if energie ~= nil and energie:IsA("IntValue") then
		energie.Value = math.floor(profile.energy)
	end
	local likes = stats:FindFirstChild("Likes")
	if likes ~= nil and likes:IsA("IntValue") then
		likes.Value = profile.likes
	end
	local besuche = stats:FindFirstChild("Besuche")
	if besuche ~= nil and besuche:IsA("IntValue") then
		besuche.Value = profile.visits
	end
end

-- Schreibt die Bestwerte eines Spielers in die OrderedDataStores.
local function publishScores(player: Player)
	local profile = DataService.getProfile(player)
	if profile == nil then
		return
	end

	if likesStore ~= nil then
		local ok, err = pcall(function()
			(likesStore :: OrderedDataStore):SetAsync(tostring(player.UserId), profile.likes)
		end)
		if not ok then
			warn(`[PlanetForge] Rangliste (Likes) schreiben fehlgeschlagen: {err}`)
		end
	end

	if energyStore ~= nil then
		local ok, err = pcall(function()
			(energyStore :: OrderedDataStore):SetAsync(tostring(player.UserId), math.floor(profile.lifetimeEnergy))
		end)
		if not ok then
			warn(`[PlanetForge] Rangliste (Energie) schreiben fehlgeschlagen: {err}`)
		end
	end
end

-- Löst eine UserId in einen Anzeigenamen auf (Server-Spieler zuerst, dann Cache/API).
local function resolveName(userId: number): string
	local online = Players:GetPlayerByUserId(userId)
	if online ~= nil then
		return online.DisplayName
	end
	local cached = nameCache[userId]
	if cached ~= nil then
		return cached
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	if ok and typeof(name) == "string" then
		nameCache[userId] = name
		return name
	end
	return `Spieler {userId}`
end

-- Liest die Top-N-Einträge eines OrderedDataStores.
local function fetchTop(store: OrderedDataStore?): { LeaderboardEntry }
	if store == nil then
		return {}
	end

	local ok, pages = pcall(function()
		return (store :: OrderedDataStore):GetSortedAsync(false, GameConfig.LEADERBOARD_TOP_N)
	end)
	if not ok then
		warn(`[PlanetForge] Rangliste lesen fehlgeschlagen: {pages}`)
		return {}
	end

	local entries: { LeaderboardEntry } = {}
	local okPage, page = pcall(function()
		return (pages :: DataStorePages):GetCurrentPage()
	end)
	if not okPage or typeof(page) ~= "table" then
		return {}
	end

	for _, item in page :: { { key: string, value: number } } do
		local userId = tonumber(item.key)
		if userId ~= nil and typeof(item.value) == "number" and item.value &gt; 0 then
			table.insert(entries, {
				userId = userId,
				name = resolveName(userId),
				value = item.value,
			})
		end
	end
	return entries
end

local function broadcastSnapshot()
	if leaderboardUpdatedEvent == nil then
		return
	end
	(leaderboardUpdatedEvent :: RemoteEvent):FireAllClients(lastSnapshot)
end

function LeaderboardService.init()
	leaderboardUpdatedEvent = Remotes.getEvent("LeaderboardUpdated")

	-- OrderedDataStores holen (kann in Studio ohne API-Zugriff fehlschlagen).
	local okLikes, likesResult = pcall(function()
		return DataStoreService:GetOrderedDataStore(GameConfig.LEADERBOARD_STORE_LIKES)
	end)
	if okLikes then
		likesStore = likesResult
	else
		warn(`[PlanetForge] OrderedDataStore (Likes) nicht verfügbar: {likesResult}`)
	end

	local okEnergy, energyResult = pcall(function()
		return DataStoreService:GetOrderedDataStore(GameConfig.LEADERBOARD_STORE_ENERGY)
	end)
	if okEnergy then
		energyStore = energyResult
	else
		warn(`[PlanetForge] OrderedDataStore (Energie) nicht verfügbar: {energyResult}`)
	end

	Players.PlayerAdded:Connect(function(player)
		createLeaderstats(player)
		task.spawn(function()
			local profile = DataService.waitForProfile(player)
			if profile ~= nil then
				updateLeaderstats(player, profile)
			end
			-- Aktuellen Ranglisten-Stand direkt an den neuen Spieler schicken.
			if leaderboardUpdatedEvent ~= nil then
				(leaderboardUpdatedEvent :: RemoteEvent):FireClient(player, lastSnapshot)
			end
		end)
	end)

	Players.PlayerRemoving:Connect(function(player)
		task.spawn(publishScores, player)
	end)

	for _, player in Players:GetPlayers() do
		createLeaderstats(player)
	end

	-- Live-Aktualisierung der leaderstats im Server.
	task.spawn(function()
		while true do
			task.wait(LEADERSTATS_UPDATE_SECONDS)
			for _, player in Players:GetPlayers() do
				local profile = DataService.getProfile(player)
				if profile ~= nil then
					updateLeaderstats(player, profile)
				end
			end
		end
	end)

	-- Periodisch eigene Werte schreiben und die globalen Top-Listen lesen.
	task.spawn(function()
		while true do
			for _, player in Players:GetPlayers() do
				publishScores(player)
			end

			lastSnapshot = {
				likes = fetchTop(likesStore),
				energy = fetchTop(energyStore),
			}
			broadcastSnapshot()

			task.wait(GameConfig.LEADERBOARD_REFRESH_SECONDS)
		end
	end)
end

return LeaderboardService
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="PF19">
<Properties>
<string name="Name">LootService</string>
<ProtectedString name="Source">--!strict
-- LootService: server-autoritative Fund-Würfe (Loot-Rolls).
-- Ablauf eines Wurfs: Zuerst werden alle Ultra-Rares einzeln gewürfelt
-- (seltenste zuerst, der erste Treffer gewinnt). Trifft keiner, wird eine
-- Seltenheitsstufe gewichtet gewürfelt und daraus ein zufälliges Objekt
-- des normalen Pools gezogen. Loot-Glück aus globalen Events verbessert
-- ausschließlich die Ultra-Rare-Chancen.

local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types = require(ReplicatedStorage.Shared.Types)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local RarityConfig = require(ReplicatedStorage.Shared.Config.RarityConfig)
local CollectibleConfig = require(ReplicatedStorage.Shared.Config.CollectibleConfig)
local WeightedRandom = require(ReplicatedStorage.Shared.Util.WeightedRandom)

local DataService = require(script.Parent.DataService)
local EnergyService = require(script.Parent.EnergyService)
local GlobalEventService = require(script.Parent.GlobalEventService)
local PlanetService = require(script.Parent.PlanetService)

local LootService = {}

local rng = Random.new()

-- Serverweite Ankündigungstexte für Ultra-Rare-Funde
-- (vorformuliert, damit die deutsche Deklination stimmt).
local ULTRA_RARE_ANNOUNCEMENTS: { [string]: string } = {
	kosmischer_kern = "hat einen Kosmischen Kern gefunden!",
	goldener_drache = "hat einen Goldenen Drachen gefunden!",
	kristall = "hat einen Leuchtenden Kristall gefunden!",
}

-- Würfelt ein Sammelobjekt. Gibt (collectibleId, rarity, isUltraRare) zurück;
-- collectibleId ist nil, wenn die Konfiguration keinen Kandidaten hergibt
-- (sollte nie passieren und wird vom Aufrufer mit Erstattung abgefangen).
local function rollCollectible(): (string?, string, boolean)
	local lootLuck = GlobalEventService.getLootLuckMultiplier()
	if typeof(lootLuck) ~= "number" or lootLuck ~= lootLuck or lootLuck &lt; 1 then
		lootLuck = 1
	end

	-- 1) Ultra-Rares: seltenste zuerst, der erste Treffer gewinnt.
	-- Loot-Glück verkürzt die Odds: oneIn(max(1, floor(n / lootLuck))).
	for _, entry in RarityConfig.UltraRares do
		local effectiveOneIn = math.max(1, math.floor(entry.oneIn / lootLuck))
		if WeightedRandom.oneIn(effectiveOneIn, rng) then
			local def = CollectibleConfig.Collectibles[entry.collectibleId]
			if def ~= nil then
				return entry.collectibleId, def.rarity, true
			end
			warn(`[PlanetForge] LootService: Ultra-Rare {entry.collectibleId} hat keine Collectible-Definition`)
		end
	end

	-- 2) Normaler Pool: Seltenheitsstufe gewichtet würfeln
	-- (nur Stufen mit weight &gt; 0; Mythic/Cosmic bleiben außen vor).
	local tierEntries: { WeightedRandom.WeightedEntry&lt;string&gt; } = {}
	for _, tierName in RarityConfig.TierOrder do
		local tierDef = RarityConfig.Tiers[tierName]
		if tierDef ~= nil and tierDef.weight &gt; 0 then
			table.insert(tierEntries, { value = tierName, weight = tierDef.weight })
		end
	end
	if #tierEntries == 0 then
		return nil, "Common", false
	end

	local tierName = WeightedRandom.pick(tierEntries, rng)

	-- 3) Zufälliges Objekt aus dem Pool der gewürfelten Stufe.
	local ids = CollectibleConfig.getIdsByRarity(tierName)
	if #ids == 0 then
		return nil, tierName, false
	end

	return ids[rng:NextInteger(1, #ids)], tierName, false
end

function LootService.init()
	local lootObtainedEvent = Remotes.getEvent("LootObtained")
	local notificationEvent = Remotes.getEvent("Notification")

	local rollFunction = Remotes.getFunction("RollLoot")
	rollFunction.OnServerInvoke = function(player: Player): (boolean, any?)
		local profile: Types.PlayerProfile? = DataService.getProfile(player)
		if profile == nil then
			return false, "Dein Spielstand wird noch geladen."
		end

		-- Einsatz abbuchen; der Server ist autoritativ über das Guthaben.
		if not EnergyService.trySpend(player, GameConfig.LOOT_ROLL_COST) then
			return false, "Nicht genug Energie."
		end

		local collectibleId, rarity, isUltraRare = rollCollectible()
		if collectibleId == nil then
			-- Konfigurationsfehler: Einsatz erstatten statt Energie zu verbrennen.
			warn(`[PlanetForge] LootService: kein Sammelobjekt für Stufe {rarity} verfügbar`)
			EnergyService.addRaw(player, GameConfig.LOOT_ROLL_COST)
			return false, "Beim Fund-Wurf ist etwas schiefgelaufen. Deine Energie wurde erstattet."
		end

		local owned: Types.OwnedCollectible = {
			uid = HttpService:GenerateGUID(false),
			collectibleId = collectibleId,
			obtainedAt = os.time(),
			source = "loot",
		}
		table.insert(profile.collectibles, owned)
		DataService.markDirty(player)

		lootObtainedEvent:FireClient(player, collectibleId, rarity, owned.uid)
		PlanetService.sendSnapshot(player)

		-- Ultra-Rare-Funde werden serverweit gefeiert.
		if isUltraRare then
			local announcement = ULTRA_RARE_ANNOUNCEMENTS[collectibleId]
			if announcement == nil then
				local def = CollectibleConfig.Collectibles[collectibleId]
				local displayName = if def ~= nil then def.displayName else collectibleId
				announcement = `hat {displayName} gefunden!`
			end
			notificationEvent:FireAllClients(`{player.Name} {announcement}`, "success")
		end

		return true, {
			collectibleId = collectibleId,
			rarity = rarity,
			uid = owned.uid,
		}
	end
end

return LootService
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="PF20">
<Properties>
<string name="Name">MonetizationService</string>
<ProtectedString name="Source">--!strict
-- MonetizationService: Robux-Käufe (Gamepässe + Developer Products) und
-- Verwaltung der Kauf-Kosmetik.
--
-- GRUNDSATZ: Für Robux gibt es ausschließlich Kosmetik (siehe
-- docs/MONETARISIERUNG.md und MonetizationConfig). Dieser Service vergibt
-- daher niemals Energie, Funde oder andere Spielvorteile.
--
-- Ablauf:
--   - Beim Beitritt werden alle konfigurierten Gamepässe geprüft
--     (UserOwnsGamePassAsync) und deren Kosmetik dauerhaft freigeschaltet.
--   - Kauf im Spiel: Der Client öffnet den Roblox-Kaufdialog selbst
--     (MarketplaceService.Prompt...); der Server verarbeitet das Ergebnis über
--     PromptGamePassPurchaseFinished bzw. ProcessReceipt.
--   - EquipCosmetic rüstet besessene Kosmetik pro Kategorie aus/ab.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Types = require(ReplicatedStorage.Shared.Types)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local MonetizationConfig = require(ReplicatedStorage.Shared.Config.MonetizationConfig)

local DataService = require(script.Parent.DataService)
local PlanetService = require(script.Parent.PlanetService)

local PET_FOLLOW_OFFSET = Vector3.new(4, 3, 0) -- rechts neben und über dem Kopf
local PET_LERP_ALPHA = 0.25
local PET_UPDATE_SECONDS = 0.05
local PET_SIZE = 1.6

local cosmeticsUpdatedEvent: RemoteEvent? = nil
local notificationEvent: RemoteEvent? = nil

-- Aktive Haustier-Modelle pro Spieler.
local activePets: { [Player]: Model } = {}

local MonetizationService = {}

local function fireCosmeticsUpdated(player: Player)
	local profile = DataService.getProfile(player)
	if profile == nil or cosmeticsUpdatedEvent == nil then
		return
	end
	cosmeticsUpdatedEvent:FireClient(player, profile.ownedCosmetics, profile.equippedCosmetics)
end

local function notify(player: Player, message: string, kind: string)
	if notificationEvent ~= nil then
		notificationEvent:FireClient(player, message, kind)
	end
end

local function ownsCosmetic(profile: Types.PlayerProfile, cosmeticId: string): boolean
	for _, owned in profile.ownedCosmetics do
		if owned == cosmeticId then
			return true
		end
	end
	return false
end

-- Entfernt und (falls ausgerüstet) erzeugt das Haustier eines Spielers neu.
local function applyPet(player: Player)
	local existing = activePets[player]
	if existing ~= nil then
		existing:Destroy()
		activePets[player] = nil
	end

	local profile = DataService.getProfile(player)
	if profile == nil then
		return
	end

	local petId = profile.equippedCosmetics.haustier
	local petDef = if petId ~= nil then MonetizationConfig.Cosmetics[petId] else nil
	if petDef == nil or petDef.category ~= "haustier" then
		return
	end

	-- Zusammengesetztes Mini-Model: Körper + Augen mit Pupillen; die
	-- Schwebe-Animation (Sine-Bobbing) macht die Folgeschleife.
	local petColor = petDef.visual.color or Color3.new(1, 1, 1)
	local pet = Instance.new("Model")
	pet.Name = `Pet_{player.UserId}`

	local function petPart(name: string, size: Vector3, color: Color3, material: Enum.Material, offset: CFrame): BasePart
		local part = Instance.new("Part")
		part.Name = name
		part.Shape = Enum.PartType.Ball
		part.Size = size
		part.Color = color
		part.Material = material
		part.CFrame = offset
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.Parent = pet
		return part
	end

	local body = petPart(
		"Body",
		Vector3.new(PET_SIZE, PET_SIZE, PET_SIZE),
		petColor,
		petDef.visual.material or Enum.Material.Neon,
		CFrame.new()
	)
	-- Augen vorn (-Z), leicht nach außen versetzt.
	for side = -1, 1, 2 do
		local eyeOffset = CFrame.new(side * PET_SIZE * 0.22, PET_SIZE * 0.12, -PET_SIZE * 0.38)
		petPart(`Eye{side}`, Vector3.new(0.42, 0.42, 0.42), Color3.new(1, 1, 1), Enum.Material.SmoothPlastic, eyeOffset)
		petPart(
			`Pupil{side}`,
			Vector3.new(0.2, 0.2, 0.2),
			Color3.fromRGB(25, 25, 30),
			Enum.Material.SmoothPlastic,
			eyeOffset * CFrame.new(0, 0, -0.14)
		)
	end

	if petDef.visual.glow == true then
		local light = Instance.new("PointLight")
		light.Color = petColor
		light.Range = 12
		light.Brightness = 1
		light.Parent = body
	end

	pet.PrimaryPart = body

	-- Startposition: direkt beim Charakter (falls vorhanden), sonst beim Plot.
	local character = player.Character
	local root = if character ~= nil then character:FindFirstChild("HumanoidRootPart") else nil
	if root ~= nil and root:IsA("BasePart") then
		pet:PivotTo((root :: BasePart).CFrame * CFrame.new(PET_FOLLOW_OFFSET))
	else
		local origin = PlanetService.getPlotOrigin(player)
		if origin ~= nil then
			pet:PivotTo(origin * CFrame.new(PET_FOLLOW_OFFSET))
		end
	end

	pet.Parent = workspace
	activePets[player] = pet
end

-- Schaltet Kosmetik dauerhaft frei und meldet dem Client den neuen Stand.
local function grantCosmetics(player: Player, cosmeticIds: { string }, sourceName: string)
	local profile = DataService.getProfile(player)
	if profile == nil then
		return
	end

	local grantedAny = false
	for _, cosmeticId in cosmeticIds do
		local def = MonetizationConfig.Cosmetics[cosmeticId]
		if def == nil then
			warn(`[PlanetForge] Unbekannte Kosmetik in Konfiguration: {cosmeticId}`)
		elseif not ownsCosmetic(profile, cosmeticId) then
			table.insert(profile.ownedCosmetics, cosmeticId)
			grantedAny = true
		end
	end

	if grantedAny then
		DataService.markDirty(player)
		fireCosmeticsUpdated(player)
		notify(player, `Freigeschaltet: {sourceName} – öffne den Shop zum Ausrüsten!`, "success")
	end
end

-- Prüft alle konfigurierten Gamepässe für einen Spieler (pcall pro Pass).
local function checkGamepasses(player: Player)
	for _, def in MonetizationConfig.Gamepasses do
		if def.gamePassId == 0 then
			continue -- Platzhalter: Pass wurde im Dashboard noch nicht angelegt
		end
		local ok, owns = pcall(function()
			return MarketplaceService:UserOwnsGamePassAsync(player.UserId, def.gamePassId)
		end)
		if ok and owns == true then
			grantCosmetics(player, def.grantsCosmetics, def.displayName)
		elseif not ok then
			warn(`[PlanetForge] UserOwnsGamePassAsync fehlgeschlagen ({def.key}): {owns}`)
		end
	end
end

-- Handler für EquipCosmetic(category, cosmeticId?).
local function onEquipCosmetic(player: Player, categoryArg: any, cosmeticArg: any): (boolean, any?)
	if typeof(categoryArg) ~= "string" or MonetizationConfig.CategoryNames[categoryArg] == nil then
		return false, "Unbekannte Kosmetik-Kategorie."
	end

	local profile = DataService.getProfile(player)
	if profile == nil then
		return false, "Dein Profil ist noch nicht geladen."
	end

	if cosmeticArg == nil then
		-- Kategorie ablegen.
		profile.equippedCosmetics[categoryArg] = nil
	else
		if typeof(cosmeticArg) ~= "string" then
			return false, "Ungültige Kosmetik."
		end
		local def = MonetizationConfig.Cosmetics[cosmeticArg]
		if def == nil or def.category ~= categoryArg then
			return false, "Diese Kosmetik passt nicht zur Kategorie."
		end
		if not ownsCosmetic(profile, cosmeticArg) then
			return false, "Diese Kosmetik besitzt du noch nicht."
		end
		profile.equippedCosmetics[categoryArg] = cosmeticArg
	end

	DataService.markDirty(player)
	fireCosmeticsUpdated(player)
	PlanetService.applyCosmetics(player)
	if categoryArg == "haustier" then
		applyPet(player)
	end
	return true, nil
end

-- Verarbeitet Developer-Product-Käufe. Muss idempotent und robust sein:
-- Roblox ruft ProcessReceipt erneut auf, solange nicht PurchaseGranted
-- zurückgegeben wurde.
local function processReceipt(receiptInfo: { [string]: any }): Enum.ProductPurchaseDecision
	local productDef = MonetizationConfig.findProductByProductId(receiptInfo.ProductId)
	if productDef == nil then
		warn(`[PlanetForge] Unbekanntes Developer Product: {receiptInfo.ProductId}`)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local player = Players:GetPlayerByUserId(receiptInfo.PlayerId)
	if player == nil then
		return Enum.ProductPurchaseDecision.NotProcessedYet -- Spieler offline: später erneut
	end

	local profile = DataService.getProfile(player)
	if profile == nil then
		return Enum.ProductPurchaseDecision.NotProcessedYet -- Profil lädt noch
	end

	grantCosmetics(player, { productDef.grantsCosmetic }, productDef.displayName)
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

-- Studio-Testmodus: Käufe dürfen NUR simuliert werden, wenn das Config-Flag
-- gesetzt ist UND der Server in Roblox Studio läuft. In einem
-- veröffentlichten Spiel gibt diese Funktion immer false zurück - das ist
-- die harte Absicherung, die der SelfCheckService zusätzlich überwacht.
function MonetizationService.isTestPurchaseAllowed(): boolean
	return MonetizationConfig.testModeInStudio == true and RunService:IsStudio()
end

-- Handler für SimulatePurchase(kind, key): simuliert im Studio-Testmodus
-- den erfolgreichen Kauf eines noch nicht konfigurierten Produkts (ID 0),
-- damit Equip/Haustiere/Effekte ohne echte IDs testbar sind.
local function onSimulatePurchase(player: Player, kindArg: any, keyArg: any): (boolean, any?)
	if not MonetizationService.isTestPurchaseAllowed() then
		return false, "Test-Käufe sind nur im Studio-Testmodus möglich."
	end
	if typeof(kindArg) ~= "string" or typeof(keyArg) ~= "string" then
		return false, "Ungültige Anfrage."
	end

	if kindArg == "gamepass" then
		local def = MonetizationConfig.Gamepasses[keyArg]
		if def == nil then
			return false, "Unbekannter Gamepass."
		end
		if def.gamePassId ~= 0 then
			return false, "Dieser Gamepass hat eine echte ID - bitte regulär kaufen."
		end
		grantCosmetics(player, def.grantsCosmetics, `{def.displayName} (Test)`)
		return true, nil
	elseif kindArg == "product" then
		local def = MonetizationConfig.DeveloperProducts[keyArg]
		if def == nil then
			return false, "Unbekanntes Produkt."
		end
		if def.productId ~= 0 then
			return false, "Dieses Produkt hat eine echte ID - bitte regulär kaufen."
		end
		grantCosmetics(player, { def.grantsCosmetic }, `{def.displayName} (Test)`)
		return true, nil
	end

	return false, "Unbekannte Kaufart."
end

local function onPlayerAdded(player: Player)
	local profile = DataService.waitForProfile(player)
	if profile == nil then
		return -- Spieler bereits weg
	end

	checkGamepasses(player)
	fireCosmeticsUpdated(player)
	PlanetService.applyCosmetics(player)
	applyPet(player)
end

local function onPlayerRemoving(player: Player)
	local pet = activePets[player]
	if pet ~= nil then
		pet:Destroy()
	end
	activePets[player] = nil
end

function MonetizationService.init()
	cosmeticsUpdatedEvent = Remotes.getEvent("CosmeticsUpdated")
	notificationEvent = Remotes.getEvent("Notification")
	Remotes.getFunction("EquipCosmetic").OnServerInvoke = onEquipCosmetic
	Remotes.getFunction("SimulatePurchase").OnServerInvoke = onSimulatePurchase

	if MonetizationService.isTestPurchaseAllowed() then
		print("[PlanetForge] Studio-Testmodus für den Shop ist AKTIV (nur in Studio wirksam).")
	end

	-- Gamepass-Kauf im laufenden Spiel: Kosmetik sofort gutschreiben.
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(
		function(player: Player, gamePassId: number, wasPurchased: boolean)
			if not wasPurchased then
				return
			end
			for _, def in MonetizationConfig.Gamepasses do
				if def.gamePassId ~= 0 and def.gamePassId == gamePassId then
					grantCosmetics(player, def.grantsCosmetics, def.displayName)
					break
				end
			end
		end
	)

	-- Developer Products (nur ein ProcessReceipt pro Spiel möglich).
	MarketplaceService.ProcessReceipt = processReceipt

	Players.PlayerAdded:Connect(function(player)
		task.spawn(onPlayerAdded, player)
	end)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end

	-- Haustier-Folgeschleife: sanftes Nachschweben hinter dem Besitzer
	-- plus Sine-Bobbing (jedes Haustier leicht phasenversetzt).
	task.spawn(function()
		while true do
			task.wait(PET_UPDATE_SECONDS)
			for player, pet in activePets do
				local character = player.Character
				if character == nil then
					continue
				end
				local root = character:FindFirstChild("HumanoidRootPart")
				if root == nil or not root:IsA("BasePart") then
					continue
				end
				local bob = math.sin(os.clock() * 2.4 + player.UserId % 7) * 0.45
				local target = (root :: BasePart).CFrame * CFrame.new(PET_FOLLOW_OFFSET + Vector3.new(0, bob, 0))
				pet:PivotTo(pet:GetPivot():Lerp(target, PET_LERP_ALPHA))
			end
		end
	end)
end

return MonetizationService
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="PF21">
<Properties>
<string name="Name">PlanetService</string>
<ProtectedString name="Source">--!strict
-- PlanetService: verwaltet die Planeten-Plots der Spieler sowie Bau und
-- Ausbau von Biomen. Der Server ist autoritativ: alle Client-Eingaben
-- (PlaceBiome/UpgradeBiome) werden hier vollständig validiert.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextService = game:GetService("TextService")
local Workspace = game:GetService("Workspace")

local Types = require(ReplicatedStorage.Shared.Types)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local BiomeConfig = require(ReplicatedStorage.Shared.Config.BiomeConfig)
local MonetizationConfig = require(ReplicatedStorage.Shared.Config.MonetizationConfig)

local DataService = require(script.Parent.DataService)
local EnergyService = require(script.Parent.EnergyService)
local BiomeVisuals = require(script.Parent.BiomeVisuals)

local PLOTS_FOLDER_NAME = "PlanetPlots"
local POSITIONS_PER_RING = 12 -- Plots pro Ring; danach beginnt ein weiterer Ring
local CORE_DIAMETER = 24 -- Durchmesser des Planetenkerns in Studs
local SLOT_DIAMETER = 14 -- Durchmesser einer Slot-Plattform in Studs
local SLOT_THICKNESS = 1
local SLOT_RING_RADIUS = 22 -- Abstand der Slot-Plattformen vom Planetenzentrum
local SLOT_Y_OFFSET = -2 -- Plattformen leicht unterhalb des Kern-Äquators (begehbar)
local SPAWN_HEIGHT_OFFSET = CORE_DIAMETER / 2 + 4 -- Spawnpunkt oberhalb des Kerns

local CORE_COLOR = Color3.fromRGB(105, 100, 95)
local EMPTY_SLOT_COLOR = Color3.fromRGB(120, 120, 120)

-- Snapshot-Form für das Remote-Event PlanetUpdated.
export type PlanetSnapshot = {
	biomes: { Types.PlacedBiome },
	collectibles: { Types.OwnedCollectible },
	visits: number,
	likes: number,
}

local plotIndices: { [Player]: number } = {}
local plotOrigins: { [Player]: CFrame } = {}
local usedIndices: { [number]: boolean } = {}
local characterConnections: { [Player]: RBXScriptConnection } = {}

local planetUpdatedEvent: RemoteEvent? = nil

local PlanetService = {}

-- Tiefe Kopie eines (JSON-artigen) Wertes.
local function deepCopy(value: any): any
	if typeof(value) == "table" then
		local copy = {}
		for key, child in value do
			copy[key] = deepCopy(child)
		end
		return copy
	end
	return value
end

local function buildSnapshot(profile: Types.PlayerProfile): PlanetSnapshot
	return {
		biomes = deepCopy(profile.biomes),
		collectibles = deepCopy(profile.collectibles),
		visits = profile.visits,
		likes = profile.likes,
	}
end

local function getPlotsRoot(): Folder
	local existing = Workspace:FindFirstChild(PLOTS_FOLDER_NAME)
	if existing ~= nil and existing:IsA("Folder") then
		return existing
	end
	local folder = Instance.new("Folder")
	folder.Name = PLOTS_FOLDER_NAME
	folder.Parent = Workspace
	return folder
end

local function getPlotFolder(player: Player): Folder?
	local child = getPlotsRoot():FindFirstChild(`Plot_{player.UserId}`)
	if child ~= nil and child:IsA("Folder") then
		return child
	end
	return nil
end

-- Kleinster freier Plot-Index (Indizes werden beim Verlassen wieder frei).
local function assignPlotIndex(player: Player): number
	local index = 1
	while usedIndices[index] do
		index += 1
	end
	usedIndices[index] = true
	plotIndices[player] = index
	return index
end

-- Plot-Ursprung: Kreis um den Weltursprung; bei mehr als POSITIONS_PER_RING
-- Spielern folgt ein zweiter (dritter, ...) Ring mit größerem Radius.
local function computePlotOrigin(index: number): CFrame
	local ring = math.floor((index - 1) / POSITIONS_PER_RING)
	local slotInRing = (index - 1) % POSITIONS_PER_RING
	local radius = GameConfig.PLOT_SPACING_STUDS * (ring + 1)
	local angle = (slotInRing / POSITIONS_PER_RING) * 2 * math.pi
	return CFrame.new(math.cos(angle) * radius, GameConfig.PLOT_HEIGHT_STUDS, math.sin(angle) * radius)
end

local function createSlotLabel(parent: BasePart, text: string)
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "SlotLabel"
	billboard.Size = UDim2.fromOffset(140, 36)
	billboard.StudsOffset = Vector3.new(0, 4, 0)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = 250

	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.5
	label.Text = text
	label.Parent = billboard

	billboard.Parent = parent
end

-- Farbe, Material und Beschriftung eines Slots setzen.
local function setSlotAppearance(part: BasePart, color: Color3, material: Enum.Material, labelText: string)
	part.Color = color
	part.Material = material
	local billboard = part:FindFirstChild("SlotLabel")
	if billboard ~= nil then
		local label = billboard:FindFirstChild("Label")
		if label ~= nil and label:IsA("TextLabel") then
			label.Text = labelText
		end
	end
end

-- Slot-Visual an den Profilstand angleichen (placed = nil -&gt; leerer Slot).
local function updateSlotVisual(player: Player, slotNumber: number, placed: Types.PlacedBiome?, withPop: boolean?)
	local plotFolder = getPlotFolder(player)
	if plotFolder == nil then
		return
	end
	local slotPart = plotFolder:FindFirstChild(`Slot_{slotNumber}`)
	if slotPart == nil or not slotPart:IsA("BasePart") then
		return
	end

	if placed == nil then
		setSlotAppearance(slotPart, EMPTY_SLOT_COLOR, Enum.Material.Concrete, `Slot {slotNumber}`)
		BiomeVisuals.clear(slotPart)
		return
	end

	local def = BiomeConfig.Biomes[placed.biomeId]
	if def == nil then
		warn(`[PlanetForge] Unbekanntes Biom im Profil von {player.Name}: {placed.biomeId}`)
		return
	end
	setSlotAppearance(slotPart, def.color, Enum.Material.Grass, `{def.displayName} (Lv. {placed.level})`)
	-- Prozedurales Deko-Set (mehr Objekte pro Level); Pop-Tween nur bei Aktionen.
	BiomeVisuals.build(slotPart, placed.biomeId, placed.level, withPop == true)
end

-- Baut Kern und leere Slot-Plattformen für einen Spieler auf.
local function buildPlot(player: Player, origin: CFrame)
	local folder = Instance.new("Folder")
	folder.Name = `Plot_{player.UserId}`

	local core = Instance.new("Part")
	core.Name = "Core"
	core.Shape = Enum.PartType.Ball
	core.Size = Vector3.new(CORE_DIAMETER, CORE_DIAMETER, CORE_DIAMETER)
	core.Anchored = true
	core.Material = Enum.Material.Slate
	core.Color = CORE_COLOR
	core.CFrame = origin
	core.Parent = folder

	for slotNumber = 1, GameConfig.PLANET_SLOTS do
		local angle = ((slotNumber - 1) / GameConfig.PLANET_SLOTS) * 2 * math.pi
		local offset = Vector3.new(
			math.cos(angle) * SLOT_RING_RADIUS,
			SLOT_Y_OFFSET,
			math.sin(angle) * SLOT_RING_RADIUS
		)

		local part = Instance.new("Part")
		part.Name = `Slot_{slotNumber}`
		part.Shape = Enum.PartType.Cylinder
		part.Size = Vector3.new(SLOT_THICKNESS, SLOT_DIAMETER, SLOT_DIAMETER)
		part.Anchored = true
		part.Material = Enum.Material.Concrete
		part.Color = EMPTY_SLOT_COLOR
		-- Zylinderachse liegt auf X; um 90° um Z gedreht zeigt die flache Seite nach oben.
		part.CFrame = origin * CFrame.new(offset) * CFrame.Angles(0, 0, math.rad(90))
		createSlotLabel(part, `Slot {slotNumber}`)
		part.Parent = folder
	end

	folder.Parent = getPlotsRoot()
end

-- Aktualisiert das Namensschild über dem Planetenkern.
-- Ohne eigenen Namen: "&lt;DisplayName&gt;s Planet".
local function updateNameTag(player: Player)
	local plotFolder = getPlotFolder(player)
	if plotFolder == nil then
		return
	end
	local core = plotFolder:FindFirstChild("Core")
	if core == nil or not core:IsA("BasePart") then
		return
	end

	local profile = DataService.getProfile(player)
	local customName = if profile ~= nil then profile.planetName else ""
	local displayText = if customName ~= "" then customName else `{player.DisplayName}s Planet`

	local billboard = core:FindFirstChild("NameTag")
	local nameLabel: TextLabel
	local ownerLabel: TextLabel
	if billboard ~= nil and billboard:IsA("BillboardGui") then
		nameLabel = billboard:FindFirstChild("PlanetName") :: TextLabel
		ownerLabel = billboard:FindFirstChild("OwnerName") :: TextLabel
	else
		local gui = Instance.new("BillboardGui")
		gui.Name = "NameTag"
		gui.Size = UDim2.new(0, 260, 0, 56)
		gui.StudsOffset = Vector3.new(0, CORE_DIAMETER / 2 + 8, 0)
		gui.AlwaysOnTop = false
		gui.MaxDistance = 350

		nameLabel = Instance.new("TextLabel")
		nameLabel.Name = "PlanetName"
		nameLabel.BackgroundTransparency = 1
		nameLabel.Size = UDim2.new(1, 0, 0, 32)
		nameLabel.Font = Enum.Font.GothamBold
		nameLabel.TextSize = 24
		nameLabel.TextColor3 = Color3.fromRGB(235, 238, 245)
		nameLabel.TextStrokeTransparency = 0.4
		nameLabel.Parent = gui

		ownerLabel = Instance.new("TextLabel")
		ownerLabel.Name = "OwnerName"
		ownerLabel.BackgroundTransparency = 1
		ownerLabel.Position = UDim2.new(0, 0, 0, 32)
		ownerLabel.Size = UDim2.new(1, 0, 0, 20)
		ownerLabel.Font = Enum.Font.GothamMedium
		ownerLabel.TextSize = 14
		ownerLabel.TextColor3 = Color3.fromRGB(158, 164, 186)
		ownerLabel.TextStrokeTransparency = 0.6
		ownerLabel.Parent = gui

		gui.Parent = core
	end

	nameLabel.Text = displayText
	ownerLabel.Text = `von {player.DisplayName}`
end

-- Handler für RenamePlanet(name): validiert, filtert (Roblox-Pflicht für
-- nutzergenerierten Text) und speichert den Planetennamen.
local function handleRenamePlanet(player: Player, nameArg: unknown): (boolean, any?)
	if typeof(nameArg) ~= "string" then
		return false, "Ungültiger Name."
	end

	-- Führende/abschließende Leerzeichen entfernen.
	local trimmed = string.gsub(nameArg :: string, "^%s*(.-)%s*$", "%1")
	if #trimmed &lt; 3 then
		return false, "Der Name braucht mindestens 3 Zeichen."
	end
	if #trimmed &gt; GameConfig.PLANET_NAME_MAX_LENGTH then
		return false, `Maximal {GameConfig.PLANET_NAME_MAX_LENGTH} Zeichen.`
	end

	local profile = DataService.getProfile(player)
	if profile == nil then
		return false, "Dein Profil ist noch nicht geladen."
	end

	-- Pflicht-Filterung für von Spielern eingegebenen Text.
	local okFilter, filtered = pcall(function()
		local result = TextService:FilterStringAsync(trimmed, player.UserId)
		return result:GetNonChatStringForBroadcastAsync()
	end)
	if not okFilter or typeof(filtered) ~= "string" then
		warn(`[PlanetForge] Namensfilter fehlgeschlagen: {filtered}`)
		return false, "Der Name konnte gerade nicht geprüft werden - versuche es gleich noch einmal."
	end

	profile.planetName = filtered
	DataService.markDirty(player)
	updateNameTag(player)
	return true, filtered
end

-- Holt oder erstellt einen ParticleEmitter mit festem Namen unter parent.
local function ensureEmitter(parent: Instance, name: string): ParticleEmitter
	local existing = parent:FindFirstChild(name)
	if existing ~= nil and existing:IsA("ParticleEmitter") then
		return existing
	end
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = name
	emitter.Parent = parent
	return emitter
end

-- Wendet die ausgerüstete Kauf-Kosmetik (Skin/Aura/Wetter) auf den Plot an.
-- Idempotent: stellt ohne ausgerüstete Kosmetik den Standard-Look wieder her.
-- Haustiere verwaltet der MonetizationService selbst.
function PlanetService.applyCosmetics(player: Player)
	local profile = DataService.getProfile(player)
	local plotFolder = getPlotFolder(player)
	if profile == nil or plotFolder == nil then
		return
	end
	local coreInstance = plotFolder:FindFirstChild("Core")
	if coreInstance == nil or not coreInstance:IsA("BasePart") then
		return
	end
	local core = coreInstance :: BasePart
	local equipped = profile.equippedCosmetics

	-- Skin: Farbe und Material des Planetenkerns.
	local skinId = equipped.skin
	local skinDef = if skinId ~= nil then MonetizationConfig.Cosmetics[skinId] else nil
	if skinDef ~= nil and skinDef.category == "skin" then
		core.Color = skinDef.visual.color or CORE_COLOR
		core.Material = skinDef.visual.material or Enum.Material.Slate
	else
		skinDef = nil
		core.Color = CORE_COLOR
		core.Material = Enum.Material.Slate
	end

	-- Glow-Licht des Skins.
	local light = core:FindFirstChild("CosmeticLight")
	if skinDef ~= nil and skinDef.visual.glow == true then
		local pointLight: PointLight
		if light ~= nil and light:IsA("PointLight") then
			pointLight = light
		else
			pointLight = Instance.new("PointLight")
			pointLight.Name = "CosmeticLight"
			pointLight.Range = 40
			pointLight.Brightness = 1.5
			pointLight.Parent = core
		end
		pointLight.Color = skinDef.visual.color or Color3.new(1, 1, 1)
	elseif light ~= nil then
		light:Destroy()
	end

	-- Aura: Partikel direkt am Kern.
	local auraId = equipped.aura
	local auraDef = if auraId ~= nil then MonetizationConfig.Cosmetics[auraId] else nil
	if auraDef ~= nil and auraDef.category == "aura" then
		local emitter = ensureEmitter(core, "AuraEmitter")
		local mainColor = auraDef.visual.color or Color3.new(1, 1, 1)
		emitter.Color = ColorSequence.new(mainColor, auraDef.visual.secondaryColor or mainColor)
		emitter.LightEmission = 0.8
		emitter.Rate = 14
		emitter.Lifetime = NumberRange.new(1.5, 2.5)
		emitter.Speed = NumberRange.new(3, 6)
		emitter.Size = NumberSequence.new(0.6)
		emitter.SpreadAngle = Vector2.new(180, 180)
	else
		local emitter = core:FindFirstChild("AuraEmitter")
		if emitter ~= nil then
			emitter:Destroy()
		end
	end

	-- Wetter: Partikel regnen aus einer unsichtbaren Fläche über dem Planeten.
	local wetterId = equipped.wetter
	local wetterDef = if wetterId ~= nil then MonetizationConfig.Cosmetics[wetterId] else nil
	local weatherInstance = plotFolder:FindFirstChild("WeatherPart")
	if wetterDef ~= nil and wetterDef.category == "wetter" then
		local weatherPart: BasePart
		if weatherInstance ~= nil and weatherInstance:IsA("BasePart") then
			weatherPart = weatherInstance
		else
			weatherPart = Instance.new("Part")
			weatherPart.Name = "WeatherPart"
			weatherPart.Size =
				Vector3.new(SLOT_RING_RADIUS * 2 + SLOT_DIAMETER, 1, SLOT_RING_RADIUS * 2 + SLOT_DIAMETER)
			weatherPart.Transparency = 1
			weatherPart.Anchored = true
			weatherPart.CanCollide = false
			weatherPart.CanQuery = false
			weatherPart.CFrame = (plotOrigins[player] or core.CFrame) * CFrame.new(0, CORE_DIAMETER * 1.5, 0)
			weatherPart.Parent = plotFolder
		end
		local emitter = ensureEmitter(weatherPart, "WeatherEmitter")
		local mainColor = wetterDef.visual.color or Color3.new(1, 1, 1)
		emitter.Color = ColorSequence.new(mainColor, wetterDef.visual.secondaryColor or mainColor)
		emitter.LightEmission = 0.6
		emitter.Rate = 20
		emitter.Lifetime = NumberRange.new(2, 3)
		emitter.Speed = NumberRange.new(8, 14)
		emitter.Size = NumberSequence.new(0.8)
		emitter.EmissionDirection = Enum.NormalId.Bottom
	elseif weatherInstance ~= nil then
		weatherInstance:Destroy()
	end
end

local function teleportToPlot(player: Player, character: Model)
	local origin = plotOrigins[player]
	if origin == nil then
		return
	end
	-- Auf das Root-Part warten, damit PivotTo zuverlässig greift.
	local root = character:WaitForChild("HumanoidRootPart", 10)
	if root == nil or plotOrigins[player] == nil then
		return
	end
	character:PivotTo(origin * CFrame.new(0, SPAWN_HEIGHT_OFFSET, 0))
end

local function findBiomeAtSlot(profile: Types.PlayerProfile, slot: number): Types.PlacedBiome?
	for _, placed in profile.biomes do
		if placed.slot == slot then
			return placed
		end
	end
	return nil
end

-- Validiert einen Slot-Parameter vom Client: Integer im Bereich 1..PLANET_SLOTS.
local function parseSlot(slotArg: unknown): number?
	if typeof(slotArg) ~= "number" then
		return nil
	end
	if slotArg ~= math.floor(slotArg) then
		return nil
	end
	if slotArg &lt; 1 or slotArg &gt; GameConfig.PLANET_SLOTS then
		return nil
	end
	return slotArg
end

-- Remote-Handler: PlaceBiome(biomeId, slot) -&gt; (ok, snapshot | Fehlermeldung)
-- Juice beim Bauen/Upgraden: Sound + Partikel-Burst direkt am Slot,
-- damit die Aktion sich für alle sichtbar "gut anfühlt".
local function playSlotJuice(player: Player, slotNumber: number, color: Color3, level: number)
	local plotFolder = getPlotFolder(player)
	if plotFolder == nil then
		return
	end
	local slotPart = plotFolder:FindFirstChild(`Slot_{slotNumber}`)
	if slotPart == nil or not slotPart:IsA("BasePart") then
		return
	end

	-- Pop-Sound (Engine-Sounddatei, 3D am Slot; Tonhöhe steigt leicht pro Level).
	local sound = Instance.new("Sound")
	sound.SoundId = "rbxasset://sounds/snap.mp3"
	sound.Volume = 0.8
	sound.PlaybackSpeed = 0.95 + level * 0.06
	sound.RollOffMaxDistance = 120
	sound.Parent = slotPart
	sound:Play()
	task.delay(3, function()
		sound:Destroy()
	end)

	-- Einmaliger Partikel-Burst in Biomfarbe.
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "BuildBurst"
	emitter.Color = ColorSequence.new(color)
	emitter.LightEmission = 0.6
	emitter.Rate = 0
	emitter.Lifetime = NumberRange.new(0.4, 0.8)
	emitter.Speed = NumberRange.new(6, 12)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Size = NumberSequence.new(0.6)
	emitter.Parent = slotPart
	emitter:Emit(18)
	task.delay(1.5, function()
		emitter:Destroy()
	end)
end

local function handlePlaceBiome(player: Player, biomeIdArg: unknown, slotArg: unknown): (boolean, any?)
	local profile = DataService.getProfile(player)
	if profile == nil then
		return false, "Deine Daten sind noch nicht geladen. Versuche es gleich erneut."
	end

	if typeof(biomeIdArg) ~= "string" then
		return false, "Ungültiges Biom."
	end
	local slot = parseSlot(slotArg)
	if slot == nil then
		return false, "Ungültiger Slot."
	end

	local def = BiomeConfig.Biomes[biomeIdArg]
	if def == nil then
		return false, "Dieses Biom existiert nicht."
	end
	if profile.lifetimeEnergy &lt; def.unlockAtLifetimeEnergy then
		return false, `{def.displayName} ist noch nicht freigeschaltet (benötigt {def.unlockAtLifetimeEnergy} Gesamt-Energie).`
	end
	if findBiomeAtSlot(profile, slot) ~= nil then
		return false, "Dieser Slot ist bereits belegt."
	end

	if not EnergyService.trySpend(player, def.baseCost) then
		return false, `Nicht genug Energie ({def.baseCost} benötigt).`
	end

	local placed: Types.PlacedBiome = {
		biomeId = def.id,
		slot = slot,
		level = 1,
		placedAt = os.time(),
	}
	table.insert(profile.biomes, placed)

	updateSlotVisual(player, slot, placed, true)
	playSlotJuice(player, slot, def.color, placed.level)
	DataService.markDirty(player)
	PlanetService.sendSnapshot(player)
	return true, buildSnapshot(profile)
end

-- Remote-Handler: UpgradeBiome(slot) -&gt; (ok, snapshot | Fehlermeldung)
local function handleUpgradeBiome(player: Player, slotArg: unknown): (boolean, any?)
	local profile = DataService.getProfile(player)
	if profile == nil then
		return false, "Deine Daten sind noch nicht geladen. Versuche es gleich erneut."
	end

	local slot = parseSlot(slotArg)
	if slot == nil then
		return false, "Ungültiger Slot."
	end

	local placed = findBiomeAtSlot(profile, slot)
	if placed == nil then
		return false, "Auf diesem Slot steht kein Biom."
	end

	local def = BiomeConfig.Biomes[placed.biomeId]
	if def == nil then
		return false, "Dieses Biom ist unbekannt."
	end
	if placed.level &gt;= def.maxLevel then
		return false, `{def.displayName} hat bereits die Maximalstufe erreicht.`
	end

	local cost = BiomeConfig.getUpgradeCost(placed.biomeId, placed.level)
	if not EnergyService.trySpend(player, cost) then
		return false, `Nicht genug Energie ({cost} benötigt).`
	end

	placed.level += 1

	updateSlotVisual(player, slot, placed, true)
	playSlotJuice(player, slot, def.color, placed.level)
	DataService.markDirty(player)
	PlanetService.sendSnapshot(player)
	return true, buildSnapshot(profile)
end

local function onPlayerAdded(player: Player)
	local index = assignPlotIndex(player)
	local origin = computePlotOrigin(index)
	plotOrigins[player] = origin

	-- Basis-Plot (Kern + leere Slots) sofort aufbauen, damit die Welt nicht leer wirkt.
	buildPlot(player, origin)
	updateNameTag(player) -- Standardname; nach dem Profil-Load ggf. eigener Name

	characterConnections[player] = player.CharacterAdded:Connect(function(character)
		task.spawn(teleportToPlot, player, character)
	end)
	local currentCharacter = player.Character
	if currentCharacter ~= nil then
		task.spawn(teleportToPlot, player, currentCharacter)
	end

	-- Auf das geladene Profil warten und die Biome darstellen.
	local profile = DataService.waitForProfile(player)
	if profile == nil then
		return -- Spieler hat den Server bereits verlassen (Aufräumen macht onPlayerRemoving)
	end

	for _, placed in profile.biomes do
		updateSlotVisual(player, placed.slot, placed)
	end
	updateNameTag(player)
	PlanetService.applyCosmetics(player)
	PlanetService.sendSnapshot(player)
end

local function onPlayerRemoving(player: Player)
	local connection = characterConnections[player]
	if connection ~= nil then
		connection:Disconnect()
	end
	characterConnections[player] = nil

	local index = plotIndices[player]
	if index ~= nil then
		usedIndices[index] = nil
	end
	plotIndices[player] = nil
	plotOrigins[player] = nil

	local plotFolder = getPlotFolder(player)
	if plotFolder ~= nil then
		plotFolder:Destroy()
	end
end

-- Weltraum-Stimmung: Sternenhimmel, Atmosphäre, dezentes Bloom und
-- Farbkorrektur. Idempotent - vorhandene PlanetForge-Effekte bleiben.
local function setupWorldAmbience()
	local Lighting = game:GetService("Lighting")

	Lighting.ClockTime = 0 -- Mitternacht: Sterne sichtbar
	Lighting.Brightness = 2
	Lighting.Ambient = Color3.fromRGB(28, 32, 52)
	Lighting.OutdoorAmbient = Color3.fromRGB(70, 78, 110)

	if Lighting:FindFirstChild("PlanetForgeSky") == nil then
		local sky = Instance.new("Sky")
		sky.Name = "PlanetForgeSky"
		sky.StarCount = 3000
		sky.SunAngularSize = 8
		sky.MoonAngularSize = 14
		sky.Parent = Lighting
	end

	if Lighting:FindFirstChild("PlanetForgeAtmosphere") == nil then
		local atmosphere = Instance.new("Atmosphere")
		atmosphere.Name = "PlanetForgeAtmosphere"
		atmosphere.Density = 0.25
		atmosphere.Color = Color3.fromRGB(70, 80, 130)
		atmosphere.Decay = Color3.fromRGB(20, 24, 44)
		atmosphere.Glare = 0.2
		atmosphere.Haze = 1.4
		atmosphere.Parent = Lighting
	end

	if Lighting:FindFirstChild("PlanetForgeBloom") == nil then
		local bloom = Instance.new("BloomEffect")
		bloom.Name = "PlanetForgeBloom"
		bloom.Intensity = 0.4
		bloom.Size = 24
		bloom.Threshold = 1.15
		bloom.Parent = Lighting
	end

	if Lighting:FindFirstChild("PlanetForgeColor") == nil then
		local color = Instance.new("ColorCorrectionEffect")
		color.Name = "PlanetForgeColor"
		color.Contrast = 0.05
		color.Saturation = 0.08
		color.TintColor = Color3.fromRGB(235, 240, 255)
		color.Parent = Lighting
	end
end

function PlanetService.init()
	setupWorldAmbience()

	planetUpdatedEvent = Remotes.getEvent("PlanetUpdated")

	Remotes.getFunction("PlaceBiome").OnServerInvoke = handlePlaceBiome
	Remotes.getFunction("UpgradeBiome").OnServerInvoke = handleUpgradeBiome
	Remotes.getFunction("RenamePlanet").OnServerInvoke = handleRenamePlanet

	Players.PlayerAdded:Connect(function(player)
		task.spawn(onPlayerAdded, player)
	end)
	Players.PlayerRemoving:Connect(onPlayerRemoving)

	-- Spieler, die vor init() beigetreten sind (z. B. Studio-Solo-Test).
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end
end

-- Ursprung des Planeten dieses Spielers (nil, falls noch kein Plot vergeben).
function PlanetService.getPlotOrigin(player: Player): CFrame?
	return plotOrigins[player]
end

-- Schickt dem Besitzer einen frischen Planeten-Snapshot (tiefe Kopie).
function PlanetService.sendSnapshot(player: Player)
	local profile = DataService.getProfile(player)
	if profile == nil then
		return
	end
	local event = planetUpdatedEvent
	if event == nil then
		event = Remotes.getEvent("PlanetUpdated")
		planetUpdatedEvent = event
	end
	event:FireClient(player, buildSnapshot(profile))
end

return PlanetService
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="PF22">
<Properties>
<string name="Name">SelfCheckService</string>
<ProtectedString name="Source">--!strict
-- SelfCheckService: Selbsttest beim Serverstart.
--
-- Prüft Konfiguration und Remote-Aufbau auf innere Konsistenz und meldet
-- Probleme als Warnungen in der Ausgabe (Studio: Output-Fenster). Der Test
-- verändert nichts am Spielzustand und blockiert den Start nicht - er macht
-- Konfigurationsfehler nur sofort sichtbar, statt sie erst im Spiel zu finden.
--
-- Läuft als letzter Service der Startreihenfolge (alle Remotes existieren dann).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local BiomeConfig = require(ReplicatedStorage.Shared.Config.BiomeConfig)
local RarityConfig = require(ReplicatedStorage.Shared.Config.RarityConfig)
local CollectibleConfig = require(ReplicatedStorage.Shared.Config.CollectibleConfig)
local EventConfig = require(ReplicatedStorage.Shared.Config.EventConfig)
local MonetizationConfig = require(ReplicatedStorage.Shared.Config.MonetizationConfig)

local BiomeVisuals = require(script.Parent.BiomeVisuals)
local MonetizationService = require(script.Parent.MonetizationService)

local SelfCheckService = {}

local checksRun = 0
local problems: { string } = {}

-- Abschnitts-Ergebnisse für die Zusammenfassung am Ende.
local sections: { { name: string, checks: number, problems: number } } = {}
local currentSection: { name: string, checks: number, problems: number }? = nil

local function beginSection(name: string)
	local section = { name = name, checks = 0, problems = 0 }
	table.insert(sections, section)
	currentSection = section
end

local function check(condition: boolean, message: string)
	checksRun += 1
	local section = currentSection
	if section ~= nil then
		section.checks += 1
	end
	if not condition then
		table.insert(problems, message)
		if section ~= nil then
			section.problems += 1
		end
	end
end

local function checkBiomes()
	local count = 0
	for biomeId, def in BiomeConfig.Biomes do
		count += 1
		check(def.id == biomeId, `Biom {biomeId}: id-Feld ({def.id}) weicht vom Schlüssel ab`)
		check(def.baseCost &gt; 0, `Biom {biomeId}: baseCost muss &gt; 0 sein`)
		check(def.baseEnergyPerMinute &gt; 0, `Biom {biomeId}: baseEnergyPerMinute muss &gt; 0 sein`)
		check(def.maxLevel &gt;= 1, `Biom {biomeId}: maxLevel muss &gt;= 1 sein`)
		check(def.unlockAtLifetimeEnergy &gt;= 0, `Biom {biomeId}: unlockAtLifetimeEnergy darf nicht negativ sein`)
		check(def.upgradeCostMultiplier &gt; 1, `Biom {biomeId}: upgradeCostMultiplier muss &gt; 1 sein`)
	end
	check(count == 10, `Erwartet 10 Biome, gefunden: {count}`)

	-- getSortedIds muss nach baseCost aufsteigend sortieren.
	local sorted = BiomeConfig.getSortedIds()
	check(#sorted == count, "getSortedIds() liefert nicht alle Biome")
	for index = 2, #sorted do
		local previous = BiomeConfig.Biomes[sorted[index - 1]]
		local current = BiomeConfig.Biomes[sorted[index]]
		check(previous.baseCost &lt;= current.baseCost, `getSortedIds(): {sorted[index - 1]} vor {sorted[index]} ist nicht aufsteigend`)
	end

	-- Stichprobe Upgrade-Formel: floor(baseCost * 1.75^level).
	local wiese = BiomeConfig.Biomes["wiese"]
	if wiese ~= nil then
		local expected = math.floor(wiese.baseCost * wiese.upgradeCostMultiplier)
		check(
			BiomeConfig.getUpgradeCost("wiese", 1) == expected,
			`getUpgradeCost(wiese, 1) = {BiomeConfig.getUpgradeCost("wiese", 1)}, erwartet {expected}`
		)
	end
end

local function checkRarityAndCollectibles()
	-- Tier-Gewichte: Common..Legendary &gt; 0, Mythic/Cosmic = 0 (nicht im normalen Pool).
	for _, tierName in { "Common", "Uncommon", "Rare", "Epic", "Legendary" } do
		local tier = RarityConfig.Tiers[tierName]
		check(tier ~= nil and tier.weight &gt; 0, `Seltenheit {tierName}: fehlt oder Gewicht nicht &gt; 0`)
	end
	for _, tierName in { "Mythic", "Cosmic" } do
		local tier = RarityConfig.Tiers[tierName]
		check(tier ~= nil and tier.weight == 0, `Seltenheit {tierName}: muss Gewicht 0 haben (nur Ultra-Rare-Wurf)`)
	end

	-- Ultra-Rares: seltenste zuerst, verweisen auf existierende Sammelobjekte.
	local previousOneIn = math.huge
	for _, ultra in RarityConfig.UltraRares do
		check(ultra.oneIn &gt;= 2, `Ultra-Rare {ultra.collectibleId}: oneIn muss &gt;= 2 sein`)
		check(ultra.oneIn &lt;= previousOneIn, `Ultra-Rares nicht von selten nach häufig sortiert ({ultra.collectibleId})`)
		previousOneIn = ultra.oneIn
		check(
			CollectibleConfig.Collectibles[ultra.collectibleId] ~= nil,
			`Ultra-Rare {ultra.collectibleId}: fehlt in CollectibleConfig`
		)
	end
	check(#RarityConfig.UltraRares == 3, `Erwartet 3 Ultra-Rares, gefunden: {#RarityConfig.UltraRares}`)

	-- Jedes Sammelobjekt hat eine gültige Seltenheit; jede Pool-Stufe hat Einträge.
	for collectibleId, def in CollectibleConfig.Collectibles do
		check(RarityConfig.Tiers[def.rarity] ~= nil, `Sammelobjekt {collectibleId}: unbekannte Seltenheit {def.rarity}`)
	end
	for _, tierName in { "Common", "Uncommon", "Rare", "Epic", "Legendary" } do
		check(#CollectibleConfig.getIdsByRarity(tierName) &gt; 0, `Kein Sammelobjekt im Pool der Stufe {tierName}`)
	end

	-- Ultra-Rares dürfen NICHT im normalen Pool auftauchen (werden separat gewürfelt).
	for _, ultra in RarityConfig.UltraRares do
		local def = CollectibleConfig.Collectibles[ultra.collectibleId]
		if def ~= nil then
			for _, poolId in CollectibleConfig.getIdsByRarity(def.rarity) do
				check(poolId ~= ultra.collectibleId, `Ultra-Rare {ultra.collectibleId} ist fälschlich im normalen Pool`)
			end
		end
	end
end

local function checkEvents()
	local count = 0
	for eventId, def in EventConfig.Events do
		count += 1
		check(def.id == eventId, `Event {eventId}: id-Feld weicht vom Schlüssel ab`)
		check(def.durationSeconds &gt; 0, `Event {eventId}: durationSeconds muss &gt; 0 sein`)
		check(def.weight &gt; 0, `Event {eventId}: weight muss &gt; 0 sein`)
		check(def.energyMultiplier &gt;= 1, `Event {eventId}: energyMultiplier darf nicht &lt; 1 sein`)
		check(def.lootLuckMultiplier &gt;= 1, `Event {eventId}: lootLuckMultiplier darf nicht &lt; 1 sein`)
	end
	check(count == 5, `Erwartet 5 globale Events, gefunden: {count}`)
end

local function checkMonetization()
	-- Jede von Gamepässen/Products vergebene Kosmetik muss im Katalog existieren.
	for key, def in MonetizationConfig.Gamepasses do
		for _, cosmeticId in def.grantsCosmetics do
			check(
				MonetizationConfig.Cosmetics[cosmeticId] ~= nil,
				`Gamepass {key}: vergibt unbekannte Kosmetik {cosmeticId}`
			)
		end
	end
	for key, def in MonetizationConfig.DeveloperProducts do
		check(
			MonetizationConfig.Cosmetics[def.grantsCosmetic] ~= nil,
			`Product {key}: vergibt unbekannte Kosmetik {def.grantsCosmetic}`
		)
	end

	-- Jede Kosmetik hat eine gültige Kategorie.
	for cosmeticId, def in MonetizationConfig.Cosmetics do
		check(
			MonetizationConfig.CategoryNames[def.category] ~= nil,
			`Kosmetik {cosmeticId}: unbekannte Kategorie {def.category}`
		)
	end

	-- Hinweis (keine Warnung): nicht konfigurierte Produkt-IDs auflisten.
	local unconfigured = 0
	for _, def in MonetizationConfig.Gamepasses do
		if def.gamePassId == 0 then
			unconfigured += 1
		end
	end
	for _, def in MonetizationConfig.DeveloperProducts do
		if def.productId == 0 then
			unconfigured += 1
		end
	end
	if unconfigured &gt; 0 then
		print(`[PlanetForge] Selbsttest-Hinweis: {unconfigured} Shop-Produkt(e) ohne ID (Creator Dashboard) - Käufe dafür sind deaktiviert.`)
	end
end

local function checkGameConfigAndRemotes()
	check(GameConfig.PLANET_SLOTS == 12, "PLANET_SLOTS muss 12 sein (Canon)")
	check(GameConfig.LOOT_ROLL_COST &gt; 0, "LOOT_ROLL_COST muss &gt; 0 sein")
	check(#GameConfig.DAILY_REWARDS &gt;= 1, "DAILY_REWARDS darf nicht leer sein")
	for index = 2, #GameConfig.DAILY_REWARDS do
		check(
			GameConfig.DAILY_REWARDS[index] &gt;= GameConfig.DAILY_REWARDS[index - 1],
			"DAILY_REWARDS sollte aufsteigend sein (höherer Streak = mehr Bonus)"
		)
	end
	check(GameConfig.LEADERBOARD_TOP_N &gt;= 1, "LEADERBOARD_TOP_N muss &gt;= 1 sein")
	check(GameConfig.PLANET_NAME_MAX_LENGTH &gt;= 3, "PLANET_NAME_MAX_LENGTH muss &gt;= 3 sein")

	-- Alle Remotes wurden von Remotes.init() erzeugt.
	local folder = ReplicatedStorage:FindFirstChild("PlanetForgeRemotes")
	check(folder ~= nil, "Remote-Ordner PlanetForgeRemotes fehlt (Remotes.init() nicht gelaufen?)")
	if folder ~= nil then
		local events = 0
		local functions = 0
		for _, child in folder:GetChildren() do
			if child:IsA("RemoteEvent") then
				events += 1
			elseif child:IsA("RemoteFunction") then
				functions += 1
			end
		end
		check(events == 10, `Erwartet 10 RemoteEvents, gefunden: {events}`)
		check(functions == 12, `Erwartet 12 RemoteFunctions, gefunden: {functions}`)

		-- Kritische Einzel-Remotes (Tutorial + Studio-Testmodus).
		for _, name in { "TutorialUpdated" } do
			local remote = folder:FindFirstChild(name)
			check(remote ~= nil and remote:IsA("RemoteEvent"), `RemoteEvent {name} fehlt`)
		end
		for _, name in { "TutorialAction", "SimulatePurchase" } do
			local remote = folder:FindFirstChild(name)
			check(remote ~= nil and remote:IsA("RemoteFunction"), `RemoteFunction {name} fehlt`)
		end
	end
end

local function checkTutorial()
	check(GameConfig.TUTORIAL_STEP_COUNT == 4, "TUTORIAL_STEP_COUNT muss 4 sein")
	check(GameConfig.TUTORIAL_STEP_REWARD &gt; 0, "TUTORIAL_STEP_REWARD muss &gt; 0 sein")
	check(GameConfig.TUTORIAL_HINT_LIFETIME_LIMIT &gt; 0, "TUTORIAL_HINT_LIFETIME_LIMIT muss &gt; 0 sein")
	-- Schritt 3 (Upgrade der Wiese) muss mit Start-Energie + Belohnungen +
	-- einmal Sammeln bezahlbar sein, sonst stockt das Tutorial.
	local wiese = BiomeConfig.Biomes["wiese"]
	if wiese ~= nil then
		local afterStep2 = GameConfig.START_ENERGY
			- wiese.baseCost
			+ GameConfig.COLLECT_AMOUNT
			+ 2 * GameConfig.TUTORIAL_STEP_REWARD
		check(
			afterStep2 &gt;= BiomeConfig.getUpgradeCost("wiese", 1),
			"Tutorial-Ökonomie: Upgrade in Schritt 3 ist mit Belohnungen nicht bezahlbar"
		)
	end
end

local function checkBiomeVisuals()
	-- Jedes Biom braucht ein prozedurales Deko-Set.
	for biomeId in BiomeConfig.Biomes do
		check(BiomeVisuals.Builders[biomeId] ~= nil, `Biom {biomeId}: kein Visual-Set in BiomeVisuals`)
	end
end

local function checkTestMode()
	-- Außerhalb von Studio dürfen Test-Käufe NIEMALS möglich sein.
	if not RunService:IsStudio() then
		check(
			MonetizationService.isTestPurchaseAllowed() == false,
			"KRITISCH: Studio-Testmodus ist außerhalb von Studio aktiv!"
		)
	else
		check(true, "") -- in Studio zählt der Testmodus als geprüft
	end
end

function SelfCheckService.init()
	local sectionRuns: { { name: string, fn: () -&gt; () } } = {
		{ name = "Biome", fn = checkBiomes },
		{ name = "Seltenheiten", fn = checkRarityAndCollectibles },
		{ name = "Events", fn = checkEvents },
		{ name = "Shop", fn = checkMonetization },
		{ name = "Konfig+Remotes", fn = checkGameConfigAndRemotes },
		{ name = "Tutorial", fn = checkTutorial },
		{ name = "Biom-Visuals", fn = checkBiomeVisuals },
		{ name = "Testmodus", fn = checkTestMode },
	}

	for _, section in sectionRuns do
		beginSection(section.name)
		local ok, err = pcall(section.fn)
		if not ok then
			check(false, `Abschnitt {section.name} ist selbst abgestürzt: {err}`)
		end
	end

	-- Übersichtliche Zusammenfassung: eine Zeile pro Abschnitt, dann Gesamt.
	local lines = {}
	for _, section in sections do
		local mark = if section.problems == 0 then "✓" else `✗ {section.problems}`
		table.insert(lines, `{section.name} {mark}`)
	end
	local overview = table.concat(lines, "  |  ")

	if #problems == 0 then
		print(`[PlanetForge] Selbsttest bestanden ({checksRun} Prüfungen): {overview}`)
	else
		warn(`[PlanetForge] Selbsttest: {#problems} Problem(e) bei {checksRun} Prüfungen: {overview}`)
		for _, problem in problems do
			warn(`[PlanetForge]   - {problem}`)
		end
	end
end

return SelfCheckService
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="PF23">
<Properties>
<string name="Name">TradeService</string>
<ProtectedString name="Source">--!strict
-- TradeService: sicheres 1:1-Handelssystem als Zustandsmaschine (Types.TradeSession).
--
-- Ablauf: invite -&gt; acceptInvite -&gt; (setOffer / toggleAccept)* -&gt; locked -&gt; completed.
--
-- DUPE-SCHUTZ:
--  * Während state == "locked" sind setOffer und erneutes toggleAccept verboten -
--    die Angebote können sich in der Sicherheitspause also nicht mehr ändern.
--  * Die Ausführung läuft in einem einzigen Thread OHNE Yields zwischen der
--    finalen Re-Validierung (Besitz, Energie, Online-Status) und dem Transfer.
--    Es kann daher kein anderer Code dazwischen Items entfernen oder Energie ausgeben.
--  * Schlägt irgendein Teil der Re-Validierung fehl, wird die Session komplett
--    abgebrochen - es gibt keine Teilausführung.

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types = require(ReplicatedStorage.Shared.Types)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local CollectibleConfig = require(ReplicatedStorage.Shared.Config.CollectibleConfig)

local DataService = require(script.Parent.DataService)
local EnergyService = require(script.Parent.EnergyService)
local PlanetService = require(script.Parent.PlanetService)

local TradeService = {}

-- Offene Einladungen: Ziel-UserId -&gt; UserId des Einladenden.
-- Eine neue Einladung an dasselbe Ziel ersetzt die alte.
local pendingInvites: { [number]: number } = {}

-- Aktive Sessions: UserId -&gt; TradeSession. Beide Seiten zeigen auf DIESELBE Session.
local sessions: { [number]: Types.TradeSession } = {}

local tradeUpdatedEvent: RemoteEvent? = nil
local notificationEvent: RemoteEvent? = nil

-- Beide Events werden in init() aufgelöst, bevor irgendein Handler laufen kann.
local function fireTradeUpdated(player: Player, snapshot: any)
	local event = assert(tradeUpdatedEvent, "TradeService.init() fehlt")
	event:FireClient(player, snapshot)
end

local function notify(player: Player, message: string, kind: string)
	local event = assert(notificationEvent, "TradeService.init() fehlt")
	event:FireClient(player, message, kind)
end

-- Sucht die Seite eines Spielers innerhalb einer Session.
local function findSide(session: Types.TradeSession, userId: number): Types.TradeSide?
	for _, side in session.sides do
		if side.userId == userId then
			return side
		end
	end
	return nil
end

-- Sucht ein Sammelobjekt per uid im Profil.
local function findOwned(profile: Types.PlayerProfile, uid: string): Types.OwnedCollectible?
	for _, owned in profile.collectibles do
		if owned.uid == uid then
			return owned
		end
	end
	return nil
end

-- Ansicht einer Seite fürs UI; liefert zu jeder uid zusätzlich die collectibleId,
-- damit der Client Namen anzeigen kann.
local function buildSideView(side: Types.TradeSide): { [string]: any }
	local owner = Players:GetPlayerByUserId(side.userId)
	local profile = if owner ~= nil then DataService.getProfile(owner) else nil
	local items = {}
	for _, uid in side.offeredUids do
		local owned = if profile ~= nil then findOwned(profile, uid) else nil
		table.insert(items, {
			uid = uid,
			collectibleId = if owned ~= nil then owned.collectibleId else "",
		})
	end
	return {
		offeredUids = table.clone(side.offeredUids),
		offeredItems = items,
		offeredEnergy = side.offeredEnergy,
		accepted = side.accepted,
	}
end

-- Baut den TradeUpdated-Snapshot aus Sicht eines Spielers.
local function buildSnapshotFor(session: Types.TradeSession, viewerUserId: number): any
	local youSide: Types.TradeSide? = nil
	local partnerSide: Types.TradeSide? = nil
	for _, side in session.sides do
		if side.userId == viewerUserId then
			youSide = side
		else
			partnerSide = side
		end
	end
	if youSide == nil or partnerSide == nil then
		return nil
	end

	local partnerPlayer = Players:GetPlayerByUserId(partnerSide.userId)
	local partnerView = buildSideView(partnerSide)
	partnerView.userId = partnerSide.userId
	partnerView.name = if partnerPlayer ~= nil then partnerPlayer.Name else "Unbekannt"
	return {
		id = session.id,
		state = session.state,
		you = buildSideView(youSide),
		partner = partnerView,
	}
end

-- Schickt beiden Teilnehmern den aktuellen Session-Stand.
local function sendSessionUpdate(session: Types.TradeSession)
	for _, side in session.sides do
		local player = Players:GetPlayerByUserId(side.userId)
		if player ~= nil then
			fireTradeUpdated(player, buildSnapshotFor(session, side.userId))
		end
	end
end

-- Bricht eine Session ab, räumt die Einträge auf und informiert beide Seiten.
local function cancelSession(session: Types.TradeSession, message: string?, kind: string?)
	if session.state == "completed" or session.state == "cancelled" then
		return
	end
	session.state = "cancelled"
	for _, side in session.sides do
		if sessions[side.userId] == session then
			sessions[side.userId] = nil
		end
		local player = Players:GetPlayerByUserId(side.userId)
		if player ~= nil then
			fireTradeUpdated(player, nil)
			if message ~= nil then
				notify(player, message, kind or "info")
			end
		end
	end
end

-- Validiert die rohe Client-Eingabe eines Angebots.
-- Rückgabe: (Fehlermeldung) ODER (nil, uids, energy).
local function validateOffer(player: Player, payload: any): (string?, { string }?, number?)
	if typeof(payload) ~= "table" then
		return "Ungültige Anfrage."
	end
	local rawUids = payload.uids
	local rawEnergy = payload.energy
	if typeof(rawUids) ~= "table" or typeof(rawEnergy) ~= "number" then
		return "Ungültige Anfrage."
	end

	local profile = DataService.getProfile(player)
	if profile == nil then
		return "Dein Spielstand wird noch geladen."
	end

	-- uids: echtes Array aus Strings, ohne Duplikate, begrenzte Länge.
	local uids: { string } = {}
	local seen: { [string]: boolean } = {}
	local count = 0
	for key, value in rawUids :: { [any]: any } do
		count += 1
		if count &gt; GameConfig.MAX_TRADE_ITEMS_PER_SIDE then
			return `Maximal {GameConfig.MAX_TRADE_ITEMS_PER_SIDE} Objekte pro Seite.`
		end
		if typeof(key) ~= "number" or key ~= count or typeof(value) ~= "string" then
			return "Ungültige Objektliste."
		end
		if seen[value] then
			return "Doppelte Objekte im Angebot."
		end
		seen[value] = true
		table.insert(uids, value)
	end

	-- Besitz und Handelbarkeit jedes Objekts prüfen.
	for _, uid in uids do
		local owned = findOwned(profile, uid)
		if owned == nil then
			return "Du besitzt eines der angebotenen Objekte nicht."
		end
		local def = CollectibleConfig.Collectibles[owned.collectibleId]
		if def == nil or not def.tradable then
			return "Eines der angebotenen Objekte ist nicht handelbar."
		end
	end

	-- Energie: nicht-negative, endliche Ganzzahl innerhalb des Guthabens.
	if rawEnergy ~= rawEnergy or rawEnergy == math.huge or rawEnergy &lt; 0 or rawEnergy ~= math.floor(rawEnergy) then
		return "Ungültiger Energiebetrag."
	end
	if rawEnergy &gt; EnergyService.getEnergy(player) then
		return "So viel Energie hast du nicht."
	end

	return nil, uids, rawEnergy
end

-- Finale Prüfung einer Seite direkt vor dem Transfer (ohne Yields).
local function validateSideForExecution(profile: Types.PlayerProfile, side: Types.TradeSide): boolean
	if #side.offeredUids &gt; GameConfig.MAX_TRADE_ITEMS_PER_SIDE then
		return false
	end
	for _, uid in side.offeredUids do
		local owned = findOwned(profile, uid)
		if owned == nil then
			return false
		end
		local def = CollectibleConfig.Collectibles[owned.collectibleId]
		if def == nil or not def.tradable then
			return false
		end
	end
	return side.offeredEnergy &gt;= 0 and profile.energy &gt;= side.offeredEnergy
end

-- Bewegt Sammelobjekte per uid von einem Profil ins andere (uid bleibt erhalten).
local function moveCollectibles(fromProfile: Types.PlayerProfile, toProfile: Types.PlayerProfile, uids: { string })
	local now = os.time()
	for _, uid in uids do
		for index, owned in fromProfile.collectibles do
			if owned.uid == uid then
				table.remove(fromProfile.collectibles, index)
				owned.source = "trade"
				owned.obtainedAt = now
				table.insert(toProfile.collectibles, owned)
				break
			end
		end
	end
end

local EXEC_FAILED_MESSAGE = "Der Handel konnte nicht ausgeführt werden und wurde abgebrochen."

-- Führt eine gesperrte Session atomar aus. Läuft nach TRADE_LOCK_SECONDS via task.delay.
local function executeTrade(session: Types.TradeSession)
	-- Wurde die Session inzwischen gecancelt oder ersetzt? Dann nichts tun.
	if session.state ~= "locked" then
		return
	end
	local sideA = session.sides[1]
	local sideB = session.sides[2]
	if sessions[sideA.userId] ~= session or sessions[sideB.userId] ~= session then
		return
	end

	local playerA = Players:GetPlayerByUserId(sideA.userId)
	local playerB = Players:GetPlayerByUserId(sideB.userId)
	local profileA = if playerA ~= nil then DataService.getProfile(playerA) else nil
	local profileB = if playerB ~= nil then DataService.getProfile(playerB) else nil
	if playerA == nil or playerB == nil or profileA == nil or profileB == nil then
		cancelSession(session, "Der Handel wurde abgebrochen, weil ein Spieler nicht mehr verfügbar ist.", "error")
		return
	end

	-- Ab hier KEINE Yields mehr bis zum Abschluss (siehe Dupe-Schutz im Kopfkommentar).
	if not validateSideForExecution(profileA, sideA) or not validateSideForExecution(profileB, sideB) then
		cancelSession(session, EXEC_FAILED_MESSAGE, "error")
		return
	end

	-- Energie zuerst abbuchen; trySpend prüft das Guthaben ein weiteres Mal.
	local spentA = sideA.offeredEnergy == 0 or EnergyService.trySpend(playerA, sideA.offeredEnergy)
	local spentB = spentA and (sideB.offeredEnergy == 0 or EnergyService.trySpend(playerB, sideB.offeredEnergy))
	if not (spentA and spentB) then
		if spentA then
			-- Bereits abgebuchte Energie von Seite A erstatten - keine Teilausführung.
			EnergyService.addRaw(playerA, sideA.offeredEnergy)
		end
		cancelSession(session, EXEC_FAILED_MESSAGE, "error")
		return
	end
	-- Gutschriften (addRaw ignoriert Beträge &lt;= 0 selbst).
	EnergyService.addRaw(playerB, sideA.offeredEnergy)
	EnergyService.addRaw(playerA, sideB.offeredEnergy)

	-- Sammelobjekte in beide Richtungen bewegen (Besitz wurde oben final geprüft).
	moveCollectibles(profileA, profileB, sideA.offeredUids)
	moveCollectibles(profileB, profileA, sideB.offeredUids)

	session.state = "completed"
	sessions[sideA.userId] = nil
	sessions[sideB.userId] = nil
	DataService.markDirty(playerA)
	DataService.markDirty(playerB)

	for _, player in { playerA, playerB } do
		fireTradeUpdated(player, nil)
		notify(player, "Handel erfolgreich abgeschlossen!", "success")
		PlanetService.sendSnapshot(player)
	end
end

local function handleInvite(player: Player, payload: any): (boolean, any?)
	if typeof(payload) ~= "table" then
		return false, "Ungültige Anfrage."
	end
	local targetUserId = payload.targetUserId
	if typeof(targetUserId) ~= "number" or targetUserId ~= math.floor(targetUserId) or targetUserId &lt; 1 or targetUserId == math.huge then
		return false, "Ungültige Spieler-ID."
	end
	if targetUserId == player.UserId then
		return false, "Du kannst nicht mit dir selbst handeln."
	end
	local target = Players:GetPlayerByUserId(targetUserId)
	if target == nil then
		return false, "Dieser Spieler ist nicht auf dem Server."
	end
	if sessions[player.UserId] ~= nil then
		return false, "Du bist bereits in einem Handel."
	end
	if sessions[targetUserId] ~= nil then
		return false, "Dieser Spieler ist bereits in einem Handel."
	end

	-- Ersetzt eine eventuell ältere Einladung an dasselbe Ziel.
	pendingInvites[targetUserId] = player.UserId
	notify(target, `{player.Name} möchte mit dir handeln - öffne das Handelsmenü.`, "info")
	return true, nil
end

local function handleAcceptInvite(player: Player, payload: any): (boolean, any?)
	if typeof(payload) ~= "table" or typeof(payload.fromUserId) ~= "number" then
		return false, "Ungültige Anfrage."
	end
	local fromUserId = payload.fromUserId
	if pendingInvites[player.UserId] ~= fromUserId then
		return false, "Diese Einladung existiert nicht (mehr)."
	end
	local fromPlayer = Players:GetPlayerByUserId(fromUserId)
	if fromPlayer == nil then
		pendingInvites[player.UserId] = nil
		return false, "Der Einladende ist nicht mehr online."
	end
	if sessions[fromUserId] ~= nil then
		return false, "Der Einladende ist bereits in einem Handel."
	end
	if sessions[player.UserId] ~= nil then
		return false, "Du bist bereits in einem Handel."
	end
	if DataService.getProfile(player) == nil or DataService.getProfile(fromPlayer) == nil then
		return false, "Ein Spielstand wird noch geladen."
	end

	pendingInvites[player.UserId] = nil
	local session: Types.TradeSession = {
		id = HttpService:GenerateGUID(false),
		sides = {
			{ userId = fromUserId, offeredUids = {}, offeredEnergy = 0, accepted = false },
			{ userId = player.UserId, offeredUids = {}, offeredEnergy = 0, accepted = false },
		},
		state = "negotiating",
		createdAt = os.time(),
	}
	sessions[fromUserId] = session
	sessions[player.UserId] = session
	sendSessionUpdate(session)
	return true, nil
end

local function handleSetOffer(player: Player, payload: any): (boolean, any?)
	local session = sessions[player.UserId]
	if session == nil then
		return false, "Du bist in keinem Handel."
	end
	if session.state ~= "negotiating" then
		return false, "Das Angebot ist bereits gesperrt."
	end
	local errorMessage, uids, energy = validateOffer(player, payload)
	if errorMessage ~= nil or uids == nil or energy == nil then
		return false, errorMessage or "Ungültige Anfrage."
	end
	local mySide = findSide(session, player.UserId)
	if mySide == nil then
		return false, "Interner Fehler in der Handelssitzung."
	end

	mySide.offeredUids = uids
	mySide.offeredEnergy = energy
	-- Jede Angebotsänderung setzt die Zustimmung BEIDER Seiten zurück.
	for _, side in session.sides do
		side.accepted = false
	end
	sendSessionUpdate(session)
	return true, nil
end

local function handleToggleAccept(player: Player): (boolean, any?)
	local session = sessions[player.UserId]
	if session == nil then
		return false, "Du bist in keinem Handel."
	end
	if session.state ~= "negotiating" then
		return false, "Das Angebot ist bereits gesperrt."
	end
	local mySide = findSide(session, player.UserId)
	if mySide == nil then
		return false, "Interner Fehler in der Handelssitzung."
	end

	mySide.accepted = not mySide.accepted
	local bothAccepted = session.sides[1].accepted and session.sides[2].accepted
	if bothAccepted then
		-- Beide haben zugestimmt: sperren und nach der Sicherheitspause ausführen.
		session.state = "locked"
	end
	sendSessionUpdate(session)
	if bothAccepted then
		task.delay(GameConfig.TRADE_LOCK_SECONDS, function()
			executeTrade(session)
		end)
	end
	return true, nil
end

local function handleCancel(player: Player): (boolean, any?)
	local session = sessions[player.UserId]
	if session == nil then
		return false, "Du bist in keinem Handel."
	end
	if session.state ~= "negotiating" and session.state ~= "locked" then
		return false, "Dieser Handel kann nicht mehr abgebrochen werden."
	end
	cancelSession(session, "Der Handel wurde abgebrochen.", "info")
	return true, nil
end

local function onPlayerRemoving(player: Player)
	local userId = player.UserId

	-- Einladungen AN diesen Spieler und VON diesem Spieler entfernen.
	pendingInvites[userId] = nil
	for targetUserId, fromUserId in pendingInvites do
		if fromUserId == userId then
			pendingInvites[targetUserId] = nil
		end
	end

	local session = sessions[userId]
	if session ~= nil then
		cancelSession(session, `{player.Name} hat den Handel verlassen.`, "info")
	end
end

function TradeService.init()
	tradeUpdatedEvent = Remotes.getEvent("TradeUpdated")
	notificationEvent = Remotes.getEvent("Notification")

	local tradeFunction = Remotes.getFunction("TradeAction")
	tradeFunction.OnServerInvoke = function(player: Player, action: any, payload: any): (boolean, any?)
		if typeof(action) ~= "string" then
			return false, "Ungültige Aktion."
		end
		if action == "invite" then
			return handleInvite(player, payload)
		elseif action == "acceptInvite" then
			return handleAcceptInvite(player, payload)
		elseif action == "setOffer" then
			return handleSetOffer(player, payload)
		elseif action == "toggleAccept" then
			return handleToggleAccept(player)
		elseif action == "cancel" then
			return handleCancel(player)
		end
		return false, "Unbekannte Aktion."
	end

	Players.PlayerRemoving:Connect(onPlayerRemoving)
end

return TradeService
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="PF24">
<Properties>
<string name="Name">TutorialService</string>
<ProtectedString name="Source">--!strict
-- TutorialService: serverseitiger Fortschritt der First-Time Experience.
--
-- Der Client (TutorialController) zeigt die geführten Schritte an und meldet
-- per TutorialAction("advance"), wenn er glaubt, dass der aktuelle Schritt
-- geschafft ist. Der Server bleibt autoritativ: Jeder Schritt wird gegen den
-- echten Profilzustand validiert, erst dann wird weitergeschaltet.
--
-- Schritte (profile.tutorialStep = nächster offener Schritt):
--   1  Platziere deine erste Wiese       (mindestens 1 Biom gebaut)
--   2  Sammle Energie ein                (lifetimeEnergy &gt;= COLLECT_AMOUNT)
--   3  Kaufe ein Upgrade                 (mindestens 1 Biom auf Level &gt;= 2)
--   4  Suche deinen ersten Fund          (mindestens 1 Sammelobjekt)
--   5  = abgeschlossen (kommt nie wieder)
--
-- Jeder abgeschlossene Schritt gibt eine kleine Energie-Belohnung
-- (GameConfig.TUTORIAL_STEP_REWARD), damit der Ablauf nie am Preis des
-- nächsten Schritts stockt. "skip" beendet das Tutorial sofort (Rückkehrer).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types = require(ReplicatedStorage.Shared.Types)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)

local DataService = require(script.Parent.DataService)
local EnergyService = require(script.Parent.EnergyService)

local DONE_STEP = GameConfig.TUTORIAL_STEP_COUNT + 1

local tutorialUpdatedEvent: RemoteEvent? = nil

local TutorialService = {}

-- Prüft, ob die Bedingung des angegebenen Schritts im Profil erfüllt ist.
local function isStepFulfilled(profile: Types.PlayerProfile, step: number): boolean
	if step == 1 then
		return #profile.biomes &gt;= 1
	elseif step == 2 then
		return profile.lifetimeEnergy &gt;= GameConfig.COLLECT_AMOUNT
	elseif step == 3 then
		for _, placed in profile.biomes do
			if placed.level &gt;= 2 then
				return true
			end
		end
		return false
	elseif step == 4 then
		return #profile.collectibles &gt;= 1
	end
	return false
end

local function fireUpdate(player: Player, step: number)
	if tutorialUpdatedEvent ~= nil then
		(tutorialUpdatedEvent :: RemoteEvent):FireClient(player, step)
	end
end

-- Handler für TutorialAction(action).
local function onTutorialAction(player: Player, actionArg: any): (boolean, any?)
	if typeof(actionArg) ~= "string" then
		return false, "Ungültige Aktion."
	end

	local profile = DataService.getProfile(player)
	if profile == nil then
		return false, "Dein Profil ist noch nicht geladen."
	end

	-- "status": aktueller Stand ohne Änderung (Client fragt nach dem Beitritt nach).
	if actionArg == "status" then
		return true, profile.tutorialStep
	end

	if profile.tutorialStep &gt;= DONE_STEP then
		return true, DONE_STEP -- längst fertig; nichts zu tun
	end

	if actionArg == "skip" then
		profile.tutorialStep = DONE_STEP
		DataService.markDirty(player)
		fireUpdate(player, DONE_STEP)
		return true, DONE_STEP
	end

	if actionArg ~= "advance" then
		return false, "Unbekannte Aktion."
	end

	-- Autoritative Prüfung: Der Schritt zählt nur, wenn das Profil ihn belegt.
	if not isStepFulfilled(profile, profile.tutorialStep) then
		return false, "Dieser Schritt ist noch nicht geschafft."
	end

	profile.tutorialStep += 1
	DataService.markDirty(player)

	-- Kleine Belohnung, damit der nächste Schritt immer bezahlbar ist.
	EnergyService.grantEnergy(player, GameConfig.TUTORIAL_STEP_REWARD)

	fireUpdate(player, profile.tutorialStep)
	return true, profile.tutorialStep
end

local function onPlayerAdded(player: Player)
	local profile = DataService.waitForProfile(player)
	if profile == nil then
		return
	end

	-- Falls ältere Profile (Migration) einen ungültigen Wert tragen: klemmen.
	if typeof(profile.tutorialStep) ~= "number" or profile.tutorialStep &lt; 1 then
		profile.tutorialStep = 1
	elseif profile.tutorialStep &gt; DONE_STEP then
		profile.tutorialStep = DONE_STEP
	end

	fireUpdate(player, profile.tutorialStep)
end

function TutorialService.init()
	tutorialUpdatedEvent = Remotes.getEvent("TutorialUpdated")
	Remotes.getFunction("TutorialAction").OnServerInvoke = onTutorialAction

	Players.PlayerAdded:Connect(function(player)
		task.spawn(onPlayerAdded, player)
	end)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end
end

return TutorialService
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="PF25">
<Properties>
<string name="Name">VisitService</string>
<ProtectedString name="Source">--!strict
-- VisitService: Besuche fremder Planeten, Rückkehr nach Hause und Likes.
-- Der Server ist autoritativ: alle Client-Eingaben werden hier vollständig
-- validiert. Besuche und Likes zählen pro (Besucher, Ziel) nur EINMAL pro
-- Server-Session (In-Memory-Sets, Aufräumen bei PlayerRemoving).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage.Shared.Remotes)

local DataService = require(script.Parent.DataService)
local PlanetService = require(script.Parent.PlanetService)

-- Versatz beim Besuch: ~20 Studs neben dem Ziel-Plot-Ursprung, leicht erhöht,
-- damit der Charakter auf den Slot-Plattformen bzw. dem Kernrand landet.
local VISIT_OFFSET = CFrame.new(20, 8, 0)
-- Versatz für die Heimkehr: oberhalb des eigenen Planetenkerns (Kernradius 12 + Puffer).
local HOME_OFFSET = CFrame.new(0, 16, 0)

-- Session-Sets: pro Besucher die Ziele, die bereits gezählt wurden.
local countedVisits: { [Player]: { [Player]: boolean } } = {}
local countedLikes: { [Player]: { [Player]: boolean } } = {}

local VisitService = {}

local function notify(player: Player, message: string, kind: string)
	Remotes.getEvent("Notification"):FireClient(player, message, kind)
end

-- Markiert (visitor, target) im gegebenen Session-Set.
-- Gibt true zurück, wenn das Paar neu war (also gezählt werden darf).
local function markOnce(map: { [Player]: { [Player]: boolean } }, visitor: Player, target: Player): boolean
	local set = map[visitor]
	if set == nil then
		set = {}
		map[visitor] = set
	end
	if set[target] then
		return false
	end
	set[target] = true
	return true
end

-- Gemeinsame Validierung für RequestVisit und LikePlanet.
-- Rückgabe: (target, nil) bei Erfolg, sonst (nil, deutsche Fehlermeldung).
local function resolveTarget(player: Player, targetUserIdArg: unknown): (Player?, string?)
	if typeof(targetUserIdArg) ~= "number" or targetUserIdArg ~= math.floor(targetUserIdArg) then
		return nil, "Ungültige Spieler-ID."
	end
	if targetUserIdArg == player.UserId then
		return nil, "Das ist dein eigener Planet."
	end

	local target = Players:GetPlayerByUserId(targetUserIdArg)
	if target == nil then
		return nil, "Dieser Spieler ist nicht auf diesem Server."
	end
	if PlanetService.getPlotOrigin(target) == nil then
		return nil, "Der Planet dieses Spielers ist noch nicht bereit."
	end
	return target, nil
end

-- Charakter des Spielers, sofern er ein HumanoidRootPart besitzt (sonst nil).
local function getCharacterWithRoot(player: Player): Model?
	local character = player.Character
	if character == nil then
		return nil
	end
	if character:FindFirstChild("HumanoidRootPart") == nil then
		return nil
	end
	return character
end

-- Remote-Handler: RequestVisit(targetUserId) -&gt; (ok, nil | Fehlermeldung)
local function handleRequestVisit(player: Player, targetUserIdArg: unknown): (boolean, any?)
	local target, errorMessage = resolveTarget(player, targetUserIdArg)
	if target == nil then
		return false, errorMessage
	end

	local character = getCharacterWithRoot(player)
	if character == nil then
		return false, "Dein Charakter ist gerade nicht bereit."
	end

	local origin = PlanetService.getPlotOrigin(target)
	if origin == nil then
		return false, "Der Planet dieses Spielers ist noch nicht bereit."
	end

	character:PivotTo(origin * VISIT_OFFSET)

	-- Besuchszähler: nur einmal pro (Besucher, Ziel) und Session erhöhen.
	-- Ist das Zielprofil noch nicht geladen, wird NICHT markiert, damit ein
	-- späterer Besuch noch zählen kann.
	local targetProfile = DataService.getProfile(target)
	if targetProfile ~= nil and markOnce(countedVisits, player, target) then
		targetProfile.visits += 1
		DataService.markDirty(target)
		PlanetService.sendSnapshot(target)
	end

	notify(player, `Du besuchst den Planeten von {target.Name}.`, "info")
	notify(target, `{player.Name} besucht deinen Planeten!`, "info")
	return true
end

-- Remote-Handler: GoHome() -&gt; (ok, nil | Fehlermeldung)
local function handleGoHome(player: Player): (boolean, any?)
	local origin = PlanetService.getPlotOrigin(player)
	if origin == nil then
		return false, "Dein Planet ist noch nicht bereit."
	end

	local character = getCharacterWithRoot(player)
	if character == nil then
		return false, "Dein Charakter ist gerade nicht bereit."
	end

	character:PivotTo(origin * HOME_OFFSET)
	notify(player, "Willkommen zurück auf deinem Planeten.", "info")
	return true
end

-- Remote-Handler: LikePlanet(targetUserId) -&gt; (ok, nil | Fehlermeldung)
local function handleLikePlanet(player: Player, targetUserIdArg: unknown): (boolean, any?)
	local target, errorMessage = resolveTarget(player, targetUserIdArg)
	if target == nil then
		return false, errorMessage
	end

	local targetProfile = DataService.getProfile(target)
	if targetProfile == nil then
		return false, "Die Daten dieses Spielers sind noch nicht geladen. Versuche es gleich erneut."
	end

	if not markOnce(countedLikes, player, target) then
		return false, "Du hast diesen Planeten in dieser Session bereits bewertet."
	end

	targetProfile.likes += 1
	DataService.markDirty(target)
	PlanetService.sendSnapshot(target)

	notify(player, `Dir gefällt der Planet von {target.Name}.`, "success")
	notify(target, `{player.Name} gefällt dein Planet!`, "success")
	return true
end

-- Session-Sets aufräumen: sowohl als Besucher als auch als Ziel austragen.
local function onPlayerRemoving(player: Player)
	countedVisits[player] = nil
	countedLikes[player] = nil
	for _, set in countedVisits do
		set[player] = nil
	end
	for _, set in countedLikes do
		set[player] = nil
	end
end

function VisitService.init()
	Remotes.getFunction("RequestVisit").OnServerInvoke = handleRequestVisit
	Remotes.getFunction("GoHome").OnServerInvoke = handleGoHome
	Remotes.getFunction("LikePlanet").OnServerInvoke = handleLikePlanet

	Players.PlayerRemoving:Connect(onPlayerRemoving)
end

return VisitService
</ProtectedString>
</Properties>
</Item>
</Item>
</Item>
</Item>
