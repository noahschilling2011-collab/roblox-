<Item class="ModuleScript" referent="GN13">
<Properties>
<string name="Name">AdminList</string>
<ProtectedString name="Source">-- ServerScriptService/AdminList.luau
--!strict
-- GHOSTNET :: Wer Admin ist.
--
-- ACHTUNG - diese Datei liegt bewusst in ServerScriptService und NICHT in
-- ReplicatedStorage. Alles unter ReplicatedStorage kann jeder Client lesen.
-- Eine Admin-Liste dort waere eine oeffentliche Ansage, wen man angreifen
-- muss.
--
-- NOAH TRAEGT SEINE USERID HIER EIN.
-- Die eigene UserId findet man so: Roblox-Profil im Browser oeffnen, die
-- Zahl in der Adresszeile hinter /users/ ist es. Nicht der Nutzername -
-- Nutzernamen kann man aendern, UserIds nicht.
--
-- Solange die Liste leer ist, gibt es im Live-Spiel schlicht keine Admins.
-- Im Studio ist der Testspieler automatisch Admin (siehe unten), damit man
-- ohne Eintrag entwickeln kann.

local RunService = game:GetService("RunService")

local AdminList = {}

-- Beispiel: { 1234567, 7654321 }
local USER_IDS: { number } = {}

-- Im Studio ist jeder Admin. Der Pfad ist doppelt abgesichert (IsStudio UND
-- dieses Flag) und existiert im Live-Spiel nicht.
local STUDIO_IS_ADMIN = true

function AdminList.IsAdmin(player: Player): boolean
	if not player or not player.Parent then
		return false
	end

	for _, id in USER_IDS do
		if player.UserId == id then
			return true
		end
	end

	if STUDIO_IS_ADMIN and RunService:IsStudio() then
		return true
	end

	return false
end

-- Die gefaehrlichsten Befehle (Geld geben, Trace setzen, Profil
-- zuruecksetzen) gibt es NUR im Studio. Selbst ein echter Admin kann sie im
-- Live-Spiel nicht ausloesen - damit ein gestohlener Account keinen Schaden
-- an der Wirtschaft anrichten kann.
function AdminList.IsStudioOnlyAllowed(): boolean
	return RunService:IsStudio()
end

function AdminList.Count(): number
	return #USER_IDS
end

return AdminList
</ProtectedString>
</Properties>
</Item>
<Item class="Script" referent="GN14">
<Properties>
<string name="Name">GhostNetServer</string>
<ProtectedString name="Source">-- ServerScriptService/GhostNetServer.server.luau
--!strict
-- GHOSTNET :: Server-Bootstrap. Startet die Systeme in fester Reihenfolge.
--
-- Die Reihenfolge ist kein Zufall: der SaveService haelt das Profil, aus dem
-- alle anderen lesen. Er muss stehen, bevor der erste Spieler etwas tun kann.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local AssetLibrary = require(ReplicatedStorage.Shared.AssetLibrary)
local Config = require(ReplicatedStorage.Shared.Config)
-- Das Requiren legt die Remote-Objekte an, bevor irgendein Client sie sucht.
require(ReplicatedStorage.Shared.Remotes)

local Systems = script.Parent:WaitForChild("Systems")

local TimeService = require(Systems.TimeService)
local SaveService = require(Systems.SaveService)
local EconomyService = require(Systems.EconomyService)
local TraceService = require(Systems.TraceService)
local HackTargets = require(Systems.HackTargets)
local HackService = require(Systems.HackService)
local SellService = require(Systems.SellService)
local ShopService = require(Systems.ShopService)
local RaidService = require(Systems.RaidService)
local MissionService = require(Systems.MissionService)
local MarketService = require(Systems.MarketService)
local InventoryService = require(Systems.InventoryService)
local RoadNetwork = require(Systems.RoadNetwork)
local VehicleChassis = require(Systems.VehicleChassis)
local VehicleService = require(Systems.VehicleService)
local PursuitService = require(Systems.PursuitService)
local TrafficService = require(Systems.TrafficService)
local GuardService = require(Systems.GuardService)
local MapService = require(Systems.MapService)
local MonetizationService = require(Systems.MonetizationService)
local AdminService = require(Systems.AdminService)

TimeService.Init() -- ganz zuerst: Licht und Uhr, davon haengen Ertraege ab
SaveService.Init() -- dann das Profil
EconomyService.Init() -- liest aus dem Profil
TraceService.Init() -- braucht Economy fuers Wipe beim Bust
HackTargets.Init() -- braucht das Profil fuer Cooldowns
HackService.Init() -- meldet sich beim TraceService fuer den Bust an
SellService.Init()
ShopService.Init()
-- Die letzten beiden haengen sich per OnHackResolved / OnSell an die
-- fertigen Services, muessen also nach ihnen kommen.
RaidService.Init()
MissionService.Init()
MarketService.Init() -- Kurse laufen unabhaengig von Spielern
InventoryService.Init() -- braucht Markt und Missionen (Unlock-Pruefung)
RoadNetwork.Init() -- Strassengraph, den Verkehr und Polizei teilen
VehicleChassis.Init()
VehicleService.Init() -- Besitz und Haendler
PursuitService.Init() -- vor dem Verkehr: der meldet Diebstaehle dorthin
TrafficService.Init()
GuardService.Init() -- meldet Alarme an den RaidService
MapService.Init() -- nach der Welt: sammelt ein, was gebaut wurde
MonetizationService.Init()
AdminService.Init() -- zuletzt: greift auf alle anderen zu

print(("[GHOSTNET] Server hochgefahren - Version %s"):format(Config.Version))

-- Zum Schluss: was an Vorlagen gefehlt hat. Die World-Skripte sind zu diesem
-- Zeitpunkt durch, also ist die Liste vollstaendig. Steht hier ganz unten,
-- damit sie nicht zwischen den Startmeldungen untergeht.
task.defer(AssetLibrary.Report)
</ProtectedString>
</Properties>
</Item>
<Item class="Folder" referent="GN40">
<Properties>
<string name="Name">Systems</string>
</Properties>
<Item class="ModuleScript" referent="GN15">
<Properties>
<string name="Name">AdminService</string>
<ProtectedString name="Source">-- ServerScriptService/Systems/AdminService.luau
--!strict
-- GHOSTNET :: Admin-Befehle.
--
-- SICHERHEIT ZUERST - das ist kein Nebensatz
--   Ein schlecht gebautes Admin-Panel ist der haeufigste Weg, auf dem
--   Roblox-Spiele zerstoert werden. Der Client kann JEDES RemoteEvent
--   feuern, das er sieht. Ein Admin-Remote, das dem Client glaubt, ist ein
--   Gratis-Geldautomat.
--
--   Deshalb gilt hier:
--   1. Die UserId-Liste liegt in ServerScriptService, nie in ReplicatedStorage.
--   2. JEDER Befehl prueft die Autorisierung in der ersten Zeile. Dass der
--      Knopf nur Admins angezeigt wird, ist voellig irrelevant.
--   3. Die gefaehrlichsten Befehle brauchen zusaetzlich IsStudio().
--   4. Jede Aktion wird geloggt: wer, was, wann, an wem.
--   5. Eigener Rate-Limit-Eintrag.

local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Goods = require(ReplicatedStorage.Shared.Goods)
local Missions = require(ReplicatedStorage.Shared.Missions)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local AdminList = require(script.Parent.Parent.AdminList)

local EconomyService = require(script.Parent.EconomyService)
local HackService = require(script.Parent.HackService)
local HackTargets = require(script.Parent.HackTargets)
local MarketService = require(script.Parent.MarketService)
local MissionService = require(script.Parent.MissionService)
local RateLimiter = require(script.Parent.RateLimiter)
local SaveService = require(script.Parent.SaveService)
local TraceService = require(script.Parent.TraceService)

local AdminService = {}

--==========================================================================
-- Hilfsfunktionen
--==========================================================================

local function reply(ok: boolean, text: string, extra: { [string]: any }?): { [string]: any }
	local payload: { [string]: any } = { Ok = ok, Text = text }
	if extra then
		for key, value in extra do
			payload[key] = value
		end
	end
	return payload
end

local function audit(admin: Player, command: string, detail: string)
	warn(("[GHOSTNET][ADMIN] %s (%d) -&gt; %s  %s"):format(admin.Name, admin.UserId, command, detail))
end

-- Zielspieler eines Befehls. Ohne Angabe der Admin selbst.
local function resolveTarget(admin: Player, name: any): Player?
	if typeof(name) ~= "string" or name == "" then
		return admin
	end
	for _, player in Players:GetPlayers() do
		if player.Name == name then
			return player
		end
	end
	return nil
end

local function clampNumber(value: any, low: number, high: number): number?
	if typeof(value) ~= "number" or value ~= value then
		return nil
	end
	return math.clamp(math.floor(value), low, high)
end

--==========================================================================
-- Befehle
--
-- studioOnly = true  -&gt;  greift live nicht, auch nicht fuer echte Admins.
--==========================================================================

type Command = {
	StudioOnly: boolean,
	Run: (admin: Player, payload: { [string]: any }) -&gt; { [string]: any },
}

local COMMANDS: { [string]: Command } = {}

--== Wirtschaft ============================================================

COMMANDS.SetCrypto = {
	StudioOnly = true,
	Run = function(admin, payload)
		local target = resolveTarget(admin, payload.Player)
		if not target then
			return reply(false, "Spieler nicht gefunden")
		end
		local profile = SaveService.Get(target)
		if not profile then
			return reply(false, "Profil nicht geladen")
		end

		local banked = clampNumber(payload.Banked, 0, 1e9)
		local unsold = clampNumber(payload.Unsold, 0, 1e9)
		if banked then
			profile.Banked = banked
		end
		if unsold then
			profile.Unsold = unsold
		end

		EconomyService.Sync(target)
		SaveService.RequestSave(target)
		audit(admin, "SetCrypto", ("%s bank=%s unsold=%s"):format(target.Name, tostring(banked), tostring(unsold)))
		return reply(true, ("%s: Bank %d, Unverkauft %d"):format(target.Name, profile.Banked, profile.Unsold))
	end,
}

COMMANDS.SetRig = {
	StudioOnly = true,
	Run = function(admin, payload)
		local target = resolveTarget(admin, payload.Player)
		if not target then
			return reply(false, "Spieler nicht gefunden")
		end
		local level = clampNumber(payload.Level, 1, Config.Rig.MaxLevel)
		if not level then
			return reply(false, "Level fehlt")
		end

		local component = payload.Component
		local applied = {}
		for _, name in Config.Rig.Components do
			if component == nil or component == name then
				EconomyService.SetRigLevel(target, name, level)
				table.insert(applied, name)
			end
		end
		if #applied == 0 then
			return reply(false, "Unbekanntes Bauteil")
		end

		EconomyService.Sync(target)
		SaveService.RequestSave(target)
		audit(admin, "SetRig", ("%s %s = %d"):format(target.Name, table.concat(applied, ","), level))
		return reply(true, ("%s: %s auf Stufe %d"):format(target.Name, table.concat(applied, ", "), level))
	end,
}

COMMANDS.SetTrace = {
	StudioOnly = true,
	Run = function(admin, payload)
		local target = resolveTarget(admin, payload.Player)
		if not target then
			return reply(false, "Spieler nicht gefunden")
		end
		local profile = SaveService.Get(target)
		if not profile then
			return reply(false, "Profil nicht geladen")
		end
		local value = clampNumber(payload.Value, 0, Config.Trace.Max)
		if not value then
			return reply(false, "Wert fehlt")
		end

		-- Ueber den Service, damit ein Wert von 100 auch wirklich einen Bust
		-- ausloest statt nur die Zahl zu setzen.
		profile.Trace = 0
		TraceService.Add(target, value)
		audit(admin, "SetTrace", ("%s = %d"):format(target.Name, value))
		return reply(true, ("%s: Trace auf %d"):format(target.Name, value))
	end,
}

COMMANDS.Bust = {
	StudioOnly = true,
	Run = function(admin, payload)
		local target = resolveTarget(admin, payload.Player)
		if not target then
			return reply(false, "Spieler nicht gefunden")
		end
		local profile = SaveService.Get(target)
		if not profile then
			return reply(false, "Profil nicht geladen")
		end
		profile.Trace = 0
		TraceService.Add(target, Config.Trace.Max)
		audit(admin, "Bust", target.Name)
		return reply(true, ("%s wurde gebustet"):format(target.Name))
	end,
}

--== Missionen =============================================================

COMMANDS.SetMission = {
	StudioOnly = true,
	Run = function(admin, payload)
		local target = resolveTarget(admin, payload.Player)
		if not target then
			return reply(false, "Spieler nicht gefunden")
		end
		local profile = SaveService.Get(target)
		if not profile then
			return reply(false, "Profil nicht geladen")
		end

		local missionId = payload.MissionId
		if typeof(missionId) ~= "string" or not Missions.Get(missionId) then
			return reply(false, "Unbekannte Mission")
		end

		-- Alle Vorgaenger als erledigt eintragen, sonst waere die Mission
		-- gar nicht verfuegbar.
		local story = profile.Story
		for _, mission in Missions.List do
			if mission.Id == missionId then
				break
			end
			if not Missions.IsCompleted(story, mission.Id) then
				table.insert(story.Completed, mission.Id)
			end
			local unlock = mission.Reward and mission.Reward.Unlock
			if typeof(unlock) == "string" and unlock ~= "" and not Missions.HasUnlock(story, unlock) then
				table.insert(story.Unlocks, unlock)
			end
		end

		local index = table.find(story.Completed, missionId)
		if index then
			table.remove(story.Completed, index)
		end
		story.Active = missionId
		story.Step = 1
		story.StepProgress = 0
		story.StepStartedAt = os.time()

		SaveService.RequestSave(target)
		MissionService.Sync(target)
		audit(admin, "SetMission", ("%s -&gt; %s"):format(target.Name, missionId))
		return reply(true, ("%s startet %s"):format(target.Name, missionId))
	end,
}

COMMANDS.ResetStory = {
	StudioOnly = true,
	Run = function(admin, payload)
		local target = resolveTarget(admin, payload.Player)
		if not target then
			return reply(false, "Spieler nicht gefunden")
		end
		local profile = SaveService.Get(target)
		if not profile then
			return reply(false, "Profil nicht geladen")
		end

		profile.Story.Active = ""
		profile.Story.Step = 1
		profile.Story.StepProgress = 0
		profile.Story.StepStartedAt = 0
		table.clear(profile.Story.Completed)
		table.clear(profile.Story.Unlocks)

		SaveService.RequestSave(target)
		MissionService.Sync(target)
		audit(admin, "ResetStory", target.Name)
		return reply(true, ("Story von %s zurueckgesetzt"):format(target.Name))
	end,
}

COMMANDS.GrantUnlock = {
	StudioOnly = true,
	Run = function(admin, payload)
		local target = resolveTarget(admin, payload.Player)
		if not target then
			return reply(false, "Spieler nicht gefunden")
		end
		local profile = SaveService.Get(target)
		if not profile then
			return reply(false, "Profil nicht geladen")
		end
		local key = payload.Unlock
		if typeof(key) ~= "string" or key == "" or #key &gt; 48 then
			return reply(false, "Unlock fehlt")
		end
		if not Missions.HasUnlock(profile.Story, key) then
			table.insert(profile.Story.Unlocks, key)
		end
		SaveService.RequestSave(target)
		MissionService.Sync(target)
		audit(admin, "GrantUnlock", ("%s -&gt; %s"):format(target.Name, key))
		return reply(true, ("%s hat jetzt %s"):format(target.Name, key))
	end,
}

--== Welt ==================================================================

COMMANDS.ListTargets = {
	StudioOnly = false,
	Run = function(admin, _payload)
		local rows: { { [string]: any } } = {}
		for id, target in HackTargets.All() do
			table.insert(rows, {
				Id = id,
				Name = target.DisplayName,
				Difficulty = target.Difficulty,
				RequiredLevel = target.RequiredLevel,
				Offline = HackTargets.IsDown(target),
				Cooldown = math.ceil(HackTargets.CooldownLeft(admin, id)),
				Position = target.Part.Position,
			})
		end
		table.sort(rows, function(a, b)
			return (a.Id :: string) &lt; (b.Id :: string)
		end)
		return reply(true, ("%d Ziele"):format(#rows), { Targets = rows })
	end,
}

COMMANDS.ClearCooldown = {
	StudioOnly = false,
	Run = function(admin, payload)
		local target = resolveTarget(admin, payload.Player)
		if not target then
			return reply(false, "Spieler nicht gefunden")
		end
		local profile = SaveService.Get(target)
		if not profile then
			return reply(false, "Profil nicht geladen")
		end

		local targetId = payload.TargetId
		if typeof(targetId) == "string" and targetId ~= "" then
			profile.Cooldowns[targetId] = nil
			audit(admin, "ClearCooldown", ("%s / %s"):format(target.Name, targetId))
		else
			table.clear(profile.Cooldowns)
			audit(admin, "ClearCooldown", ("%s / alle"):format(target.Name))
		end

		EconomyService.Sync(target)
		SaveService.RequestSave(target)
		return reply(true, "Cooldowns geloescht")
	end,
}

COMMANDS.Teleport = {
	StudioOnly = false,
	Run = function(admin, payload)
		local targetId = payload.TargetId
		if typeof(targetId) ~= "string" then
			return reply(false, "TargetId fehlt")
		end
		local target = HackTargets.Get(targetId)
		if not target then
			return reply(false, "Ziel nicht gefunden")
		end
		local character = admin.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if not root or not root:IsA("BasePart") then
			return reply(false, "Kein Character")
		end

		root.CFrame = CFrame.new(target.Part.Position + Vector3.new(0, 4, 8))
		audit(admin, "Teleport", targetId)
		return reply(true, ("Bei %s"):format(target.DisplayName))
	end,
}

--== Markt =================================================================

COMMANDS.MarketState = {
	StudioOnly = false,
	Run = function(_admin, _payload)
		local rows: { { [string]: any } } = {}
		for _, good in Goods.List do
			table.insert(rows, {
				Id = good.Id,
				Name = good.Name,
				Factor = MarketService.GetFactor(good.Id),
				Buy = MarketService.GetBuyPrice(good.Id),
				Sell = MarketService.GetSellPrice(good.Id),
			})
		end
		return reply(true, ("%d Waren"):format(#rows), { Market = rows })
	end,
}

COMMANDS.MarketEvent = {
	StudioOnly = true,
	Run = function(admin, payload)
		local group = payload.Group
		if typeof(group) ~= "string" or group == "" then
			return reply(false, "Group fehlt")
		end
		local strength = payload.Strength
		if typeof(strength) ~= "number" or strength ~= strength then
			strength = Config.Market.EventStrengthMax
		end
		MarketService.ForceEvent(group, math.clamp(strength, -0.9, 0.9))
		audit(admin, "MarketEvent", ("%s %.2f"):format(group, strength))
		return reply(true, ("Event auf %s ausgeloest"):format(group))
	end,
}

COMMANDS.SetPrice = {
	StudioOnly = true,
	Run = function(admin, payload)
		local goodId = payload.GoodId
		if not Goods.Exists(goodId) then
			return reply(false, "Unbekannte Ware")
		end
		local factor = payload.Factor
		if typeof(factor) ~= "number" or factor ~= factor then
			return reply(false, "Factor fehlt")
		end
		MarketService.SetFactor(goodId, factor)
		audit(admin, "SetPrice", ("%s = %.2f"):format(goodId, factor))
		return reply(true, ("%s auf Faktor %.2f"):format(goodId, factor))
	end,
}

--== Debug =================================================================

COMMANDS.Sessions = {
	StudioOnly = false,
	Run = function(_admin, _payload)
		local rows: { { [string]: any } } = {}
		for _, player in Players:GetPlayers() do
			table.insert(rows, {
				Name = player.Name,
				Ready = SaveService.IsReady(player),
				MemoryOnly = SaveService.IsMemoryOnly(player),
				Hacking = HackService.IsHacking(player),
				Trace = math.floor(TraceService.Get(player)),
				Tier = EconomyService.GetTier(player),
				Banked = EconomyService.GetBanked(player),
				Unsold = EconomyService.GetUnsold(player),
			})
		end
		return reply(true, ("%d Spieler"):format(#rows), { Sessions = rows })
	end,
}

-- Der wichtigste Befehl im ganzen Panel: ohne "Profil ausgeben" debuggt man
-- Speicherfehler blind.
COMMANDS.DumpProfile = {
	StudioOnly = false,
	Run = function(admin, payload)
		local target = resolveTarget(admin, payload.Player)
		if not target then
			return reply(false, "Spieler nicht gefunden")
		end
		local profile = SaveService.Get(target)
		if not profile then
			return reply(false, "Profil nicht geladen")
		end

		local ok, json = pcall(function()
			return HttpService:JSONEncode(profile)
		end)
		if not ok then
			return reply(false, "Profil laesst sich nicht als JSON schreiben")
		end

		-- Auch in die Server-Ausgabe, damit man es kopieren kann.
		print(("[GHOSTNET][ADMIN] Profil %s:\n%s"):format(target.Name, json))
		audit(admin, "DumpProfile", target.Name)
		return reply(true, ("Profil von %s"):format(target.Name), { Json = json })
	end,
}

COMMANDS.ForceSave = {
	StudioOnly = false,
	Run = function(admin, payload)
		local target = resolveTarget(admin, payload.Player)
		if not target then
			return reply(false, "Spieler nicht gefunden")
		end
		local saved = SaveService.SaveNow(target)
		audit(admin, "ForceSave", ("%s ok=%s"):format(target.Name, tostring(saved)))
		return reply(saved, if saved then "Gespeichert" else "Speichern fehlgeschlagen (siehe Ausgabe)")
	end,
}

--==========================================================================
-- Eingang
--==========================================================================

local function handle(player: Player, payload: any): { [string]: any }
	-- ERSTE ZEILE: Autorisierung. Nicht die zweite, nicht nach dem
	-- Typcheck - die erste.
	if not AdminList.IsAdmin(player) then
		warn(("[GHOSTNET][ADMIN] ABGELEHNT: %s (%d) hat einen Admin-Befehl versucht."):format(
			player.Name,
			player.UserId
		))
		return reply(false, "Nicht autorisiert")
	end

	if not RateLimiter.Check(player, "AdminCommand") then
		return reply(false, "Zu schnell")
	end
	if typeof(payload) ~= "table" then
		return reply(false, "Ungueltige Anfrage")
	end

	local name = (payload :: any).Command
	if typeof(name) ~= "string" then
		return reply(false, "Kein Befehl")
	end

	local command = COMMANDS[name]
	if not command then
		return reply(false, ("Unbekannter Befehl: %s"):format(name))
	end

	if command.StudioOnly and not AdminList.IsStudioOnlyAllowed() then
		warn(("[GHOSTNET][ADMIN] '%s' ist nur im Studio erlaubt - %s abgelehnt."):format(name, player.Name))
		return reply(false, "Dieser Befehl existiert im Live-Spiel nicht")
	end

	local ok, response = pcall(command.Run, player, payload)
	if not ok then
		warn(("[GHOSTNET][ADMIN] Befehl '%s' ist abgestuerzt: %s"):format(name, tostring(response)))
		return reply(false, "Befehl fehlgeschlagen")
	end
	return response
end

--==========================================================================

function AdminService.Init()
	Remotes.AdminCommand.OnServerInvoke = function(player: Player, payload: any): { [string]: any }
		local ok, response = pcall(handle, player, payload)
		if not ok then
			warn(("[GHOSTNET][ADMIN] Eingang abgestuerzt: %s"):format(tostring(response)))
			return reply(false, "Fehler")
		end
		return response
	end

	-- Der Client fragt beim Join, ob er das Panel ueberhaupt zeigen darf.
	-- Die Antwort ist reine Bequemlichkeit; jeder Befehl prueft nochmal.
	Players.PlayerAdded:Connect(function(player)
		task.defer(function()
			if AdminList.IsAdmin(player) and player.Parent then
				Remotes.AdminReady:FireClient(player, { Studio = AdminList.IsStudioOnlyAllowed() })
			end
		end)
	end)
	for _, player in Players:GetPlayers() do
		if AdminList.IsAdmin(player) then
			Remotes.AdminReady:FireClient(player, { Studio = AdminList.IsStudioOnlyAllowed() })
		end
	end

	print(("[GHOSTNET] AdminService bereit. %d eingetragene Admins%s."):format(
		AdminList.Count(),
		if AdminList.IsStudioOnlyAllowed() then " (+ Studio)" else ""
	))
end

return AdminService
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="GN16">
<Properties>
<string name="Name">EconomyService</string>
<ProtectedString name="Source">-- ServerScriptService/Systems/EconomyService.luau
--!strict
-- GHOSTNET :: Einzige Stelle, an der sich Crypto und Rig-Werte aendern.
--
-- Seit Phase 1 liegt der Zustand im Profil des SaveService statt in einem
-- eigenen Wallet im Arbeitsspeicher. Die Schnittstelle nach aussen ist
-- unveraendert geblieben: GetRig, GetTier, Snapshot, AwardUnsold, WipeUnsold,
-- Sync. Dazu kamen nur die Schreibwege, die Verkauf und Shop brauchen.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Types = require(ReplicatedStorage.Shared.Types)

local SaveService = require(script.Parent.SaveService)

type RigLevels = Types.RigLevels
type Profile = Types.Profile

local EconomyService = {}

-- Solange das Profil laedt, gibt es Startwerte zurueck statt zu crashen.
-- Geschrieben wird in dieser Zeit nichts - jeder Schreibweg prueft auf nil.
local function fallbackRig(): RigLevels
	local start = Config.Rig.StartLevels
	return { CPU = start.CPU, RAM = start.RAM, Cooling = start.Cooling, NetCard = start.NetCard }
end

--==========================================================================
-- Lesen
--==========================================================================

function EconomyService.GetRig(player: Player): RigLevels
	local profile = SaveService.Get(player)
	if not profile then
		return fallbackRig()
	end
	return table.clone(profile.Rig)
end

-- Tier ist abgeleitet, nicht gekauft: das SCHWAECHSTE Bauteil zaehlt.
-- Man kann sich also nicht mit einer einzelnen Komponente in eine hoehere
-- Zone schummeln.
function EconomyService.GetTier(player: Player): number
	local profile = SaveService.Get(player)
	if not profile then
		return 1
	end
	local rig = profile.Rig
	return math.min(rig.CPU, rig.RAM, rig.Cooling, rig.NetCard)
end

function EconomyService.GetRange(player: Player): number
	local profile = SaveService.Get(player)
	return Config.GetRange(if profile then profile.Rig.NetCard else Config.Rig.StartLevels.NetCard)
end

function EconomyService.GetBanked(player: Player): number
	local profile = SaveService.Get(player)
	return if profile then profile.Banked else 0
end

function EconomyService.GetUnsold(player: Player): number
	local profile = SaveService.Get(player)
	return if profile then profile.Unsold else 0
end

function EconomyService.Snapshot(player: Player): { [string]: any }
	local profile = SaveService.Get(player)
	if not profile then
		return { Banked = 0, Unsold = 0, Rig = fallbackRig(), Tier = 1, Ready = false }
	end
	-- Cooldowns als RESTSEKUNDEN, nicht als Zeitstempel: die Uhr des Clients
	-- kann anders gehen als die des Servers. Ohne das zeigt der HUD nach einem
	-- Rejoin "[E] BREACH" an, obwohl das Ziel noch gesperrt ist.
	local remaining: { [string]: number } = {}
	local now = os.time()
	for id, until_ in profile.Cooldowns do
		local left = until_ - now
		if left &gt; 0 then
			remaining[id] = left
		end
	end

	return {
		Banked = profile.Banked,
		Unsold = profile.Unsold,
		Rig = table.clone(profile.Rig),
		Tier = EconomyService.GetTier(player),
		Stats = table.clone(profile.Stats),
		Cooldowns = remaining,
		Ready = true,
	}
end

--==========================================================================
-- Schreiben
--==========================================================================

function EconomyService.Sync(player: Player)
	if not player.Parent then
		return
	end
	Remotes.EconomySync:FireClient(player, EconomyService.Snapshot(player))
end

-- Belohnung aus einem Hack landet im heissen Wallet, nicht auf der Bank.
function EconomyService.AwardUnsold(player: Player, amount: number)
	if amount &lt;= 0 then
		return
	end
	local profile = SaveService.Get(player)
	if not profile then
		return
	end
	profile.Unsold += math.floor(amount)
	EconomyService.Sync(player)
end

-- Direkt auf die Bank, ohne Umweg ueber den Hehler. Nur fuer Belohnungen,
-- die bewusst sicher sein sollen (Missionen mit Config.Mission.RewardToBank).
function EconomyService.AwardBanked(player: Player, amount: number)
	if amount &lt;= 0 then
		return
	end
	local profile = SaveService.Get(player)
	if not profile then
		return
	end
	profile.Banked += math.floor(amount)
	profile.Stats.Earned += math.floor(amount)
	EconomyService.Sync(player)
end

-- Wird beim Bust gebraucht. Liefert, wie viel verloren ging.
function EconomyService.WipeUnsold(player: Player): number
	local profile = SaveService.Get(player)
	if not profile then
		return 0
	end
	local lost = profile.Unsold
	profile.Unsold = 0
	EconomyService.Sync(player)
	return lost
end

-- Verkauf beim Hehler: alles Unverkaufte abzueglich Gebuehr auf die Bank.
-- Liefert (brutto, gebuehr, netto). Der Aufrufer prueft Distanz und Zustand,
-- gerechnet und gebucht wird ausschliesslich hier.
function EconomyService.SellUnsold(player: Player, feePercent: number): (number, number, number)
	local profile = SaveService.Get(player)
	if not profile or profile.Unsold &lt;= 0 then
		return 0, 0, 0
	end

	local gross = math.floor(profile.Unsold)
	local fee = math.floor(gross * feePercent)
	local net = gross - fee

	profile.Unsold = 0
	profile.Banked += net
	profile.Stats.Sales += 1
	profile.Stats.Earned += net

	EconomyService.Sync(player)
	return gross, fee, net
end

-- Abbuchen von der Bank. false = zu wenig Guthaben, es wurde nichts gebucht.
function EconomyService.SpendBanked(player: Player, amount: number): boolean
	local profile = SaveService.Get(player)
	if not profile then
		return false
	end
	local cost = math.floor(amount)
	if cost &lt;= 0 or profile.Banked &lt; cost then
		return false
	end
	profile.Banked -= cost
	return true
end

-- Rueckbuchung, wenn ein Kauf nach dem Abbuchen doch nicht klappt. Damit
-- laeuft auch der Fehlerfall ueber den EconomyService und nicht am Profil vorbei.
function EconomyService.RefundBanked(player: Player, amount: number)
	local profile = SaveService.Get(player)
	if not profile or amount &lt;= 0 then
		return
	end
	profile.Banked += math.floor(amount)
end

-- Rig-Stufe setzen. Prueft Bauteil und Grenzen selbst, damit sich hier kein
-- Aufrufer vertun kann.
function EconomyService.SetRigLevel(player: Player, component: string, level: number): boolean
	local profile = SaveService.Get(player)
	if not profile then
		return false
	end
	if typeof((profile.Rig :: any)[component]) ~= "number" then
		return false
	end
	local clamped = math.clamp(math.floor(level), 1, Config.Rig.MaxLevel)
	;(profile.Rig :: any)[component] = clamped
	profile.Stats.Upgrades += 1
	return true
end

-- Zaehler fuers Profil. Liegt hier, damit die Services nicht selbst im
-- Profil herumschreiben.
function EconomyService.CountHack(player: Player, success: boolean)
	local profile = SaveService.Get(player)
	if not profile then
		return
	end
	if success then
		profile.Stats.Hacks += 1
	else
		profile.Stats.Fails += 1
	end
end

function EconomyService.CountBust(player: Player)
	local profile = SaveService.Get(player)
	if profile then
		profile.Stats.Busts += 1
	end
end

function EconomyService.Init()
	-- Sobald das Profil steht, bekommt der Client seinen ersten Kontostand.
	SaveService.OnReady(function(player)
		EconomyService.Sync(player)
	end)

	-- Respawn: der Client baut sein HUD neu auf, also nochmal schicken.
	local function watchRespawn(player: Player)
		player.CharacterAdded:Connect(function()
			task.wait(0.5)
			if SaveService.IsReady(player) then
				EconomyService.Sync(player)
			end
		end)
	end

	Players.PlayerAdded:Connect(watchRespawn)
	for _, player in Players:GetPlayers() do
		watchRespawn(player)
	end

	print("[GHOSTNET] EconomyService bereit.")
end

return EconomyService
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="GN17">
<Properties>
<string name="Name">GuardService</string>
<ProtectedString name="Source">-- ServerScriptService/Systems/GuardService.luau
--!strict
-- GHOSTNET :: Wachen in der Bank.
--
-- SIE MELDEN, SIE GREIFEN NICHT AN. Das haelt die Mechanik bei Flucht statt
-- Kampf - und es ist der Grund, warum es in diesem Spiel keine Waffen gibt.
-- Eine Wache, die dich sieht, loest den Alarm aus. Dann rennst du.
--
-- LEISTUNG
--   Sichtkegel werden NUR geprueft, wenn ueberhaupt ein Spieler in der Naehe
--   ist, und nur alle Config.Bank.GuardTick Sekunden. Ein Raycast pro Wache
--   und Takt, nicht pro Frame.
--
-- Eine Wache ist ein Modell mit Tag "GhostNetGuard" und Attributen:
--   PatrolA / PatrolB   Weltpositionen als Vector3-Attribute
--   AlarmGroup          welche Alarm-Gruppe sie ausloest

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Geometry = require(ReplicatedStorage.Shared.Geometry)

local RaidService = require(script.Parent.RaidService)
local TimeService = require(script.Parent.TimeService)

local GuardService = {}

local B = Config.Bank

type Guard = {
	Model: Model,
	Root: BasePart,
	A: Vector3,
	B: Vector3,
	Alpha: number,
	Direction: number,
	Sight: number, -- Faktor auf die Sichtweite, aus dem Attribut SightFactor
	Seen: { [Player]: number },
}

local guards: { Guard } = {}

--==========================================================================

local function register(inst: Instance)
	if not inst:IsA("Model") then
		return
	end
	local root = inst.PrimaryPart or inst:FindFirstChild("Root")
	if not root or not root:IsA("BasePart") then
		warn(("[GHOSTNET] Wache '%s' hat keinen Root-Part."):format(inst:GetFullName()))
		return
	end

	local a = inst:GetAttribute("PatrolA")
	local b = inst:GetAttribute("PatrolB")

	-- Frueher haben alle Wachen nachts pauschal kuerzer gesehen. Seit die
	-- Stadt dauerhaft hell ist, gibt es keine Nacht mehr - also entscheidet
	-- jetzt der Ort: eine Wache im Inneren bekommt ueber das Attribut
	-- SightFactor eine kuerzere Sichtweite als eine draussen. Kein Wert
	-- gesetzt = Config.Cover.DefaultGuardSight.
	local sightAttribute = inst:GetAttribute("SightFactor")
	local sight = if typeof(sightAttribute) == "number"
		then math.clamp(sightAttribute, Config.Cover.MinGuardSight, 1)
		else Config.Cover.DefaultGuardSight

	table.insert(guards, {
		Model = inst,
		Root = root,
		A = if typeof(a) == "Vector3" then a else root.Position,
		B = if typeof(b) == "Vector3" then b else root.Position,
		Alpha = 0,
		Direction = 1,
		Sight = sight,
		Seen = {},
	})
end

local function unregister(inst: Instance)
	for index = #guards, 1, -1 do
		if guards[index].Model == inst then
			table.remove(guards, index)
		end
	end
end

--==========================================================================
-- Sicht
--==========================================================================

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true

-- Sieht diese Wache den Spieler? Winkel UND freie Sichtlinie - Waende
-- blockieren, sonst sieht die Wache durch den halben Tresorraum.
local function canSee(guard: Guard, player: Player, position: Vector3): boolean
	local toPlayer = position - guard.Root.Position
	local distance = toPlayer.Magnitude
	-- Zwei Faktoren: die Tageszeit (nur wirksam, wenn der Zyklus laeuft) und
	-- der Ort, an dem diese Wache steht.
	local range = B.GuardSightRange * TimeService.SightFactor() * guard.Sight
	if distance &gt; range or distance &lt; 0.1 then
		return false
	end

	local forward = guard.Root.CFrame.LookVector
	local angle = math.deg(math.acos(math.clamp(forward:Dot(toPlayer.Unit), -1, 1)))
	if angle &gt; B.GuardSightAngle then
		return false
	end

	local character = player.Character
	rayParams.FilterDescendantsInstances = { guard.Model, if character then character else guard.Model }
	local hit = workspace:Raycast(guard.Root.Position, toPlayer, rayParams)
	return hit == nil
end

local function patrol(guard: Guard, dt: number)
	if (guard.A - guard.B).Magnitude &lt; 1 then
		return
	end
	guard.Alpha += guard.Direction * (B.GuardPatrolSpeed * dt) / math.max(1, (guard.A - guard.B).Magnitude)
	if guard.Alpha &gt;= 1 then
		guard.Alpha = 1
		guard.Direction = -1
	elseif guard.Alpha &lt;= 0 then
		guard.Alpha = 0
		guard.Direction = 1
	end

	local target = guard.A:Lerp(guard.B, guard.Alpha)
	local look = if guard.Direction &gt; 0 then guard.B else guard.A
	-- PivotTo statt Root.CFrame: der Kopf ist ein eigener Anchored-Part.
	-- Mit .CFrame waere er an der Startposition stehen geblieben, waehrend
	-- der Rumpf patrouilliert - derselbe Fehler wie frueher beim Verkehr.
	guard.Model:PivotTo(CFrame.lookAt(target, Vector3.new(look.X, target.Y, look.Z)))
end

--==========================================================================

function GuardService.Init()
	for _, inst in CollectionService:GetTagged(Config.GuardTag) do
		register(inst)
	end
	CollectionService:GetInstanceAddedSignal(Config.GuardTag):Connect(register)
	CollectionService:GetInstanceRemovedSignal(Config.GuardTag):Connect(unregister)

	task.spawn(function()
		local last = os.clock()
		while true do
			task.wait(B.GuardTick)
			local now = os.clock()
			local dt = now - last
			last = now

			if #guards == 0 then
				continue
			end

			-- Sammle einmal alle lebenden Spieler, statt pro Wache erneut.
			local present: { { Player: Player, Position: Vector3 } } = {}
			for _, player in Players:GetPlayers() do
				local position = Geometry.AlivePosition(player)
				if position then
					table.insert(present, { Player = player, Position = position })
				end
			end

			for _, guard in guards do
				patrol(guard, dt)

				-- Sichtpruefung NUR, wenn ueberhaupt jemand in Reichweite ist.
				for _, entry in present do
					if (entry.Position - guard.Root.Position).Magnitude &gt; B.GuardSightRange then
						guard.Seen[entry.Player] = nil
						continue
					end

					if canSee(guard, entry.Player, entry.Position) then
						local seenFor = (guard.Seen[entry.Player] or 0) + dt
						guard.Seen[entry.Player] = seenFor
						if seenFor &gt;= B.GuardSpotSeconds then
							guard.Seen[entry.Player] = 0
							local group = guard.Model:GetAttribute("AlarmGroup")
							warn(("[GHOSTNET] Wache hat %s entdeckt - Alarm."):format(entry.Player.Name))
							RaidService.RaiseAlarm(
								entry.Player,
								if typeof(group) == "string" then group else "BANK",
								"Wache"
							)
						end
					else
						guard.Seen[entry.Player] = nil
					end
				end
			end
		end
	end)

	print(("[GHOSTNET] GuardService bereit. Sicht %d Studs, %d Grad - Wachen melden, sie greifen nicht an."):format(
		B.GuardSightRange,
		B.GuardSightAngle
	))
end

return GuardService
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="GN18">
<Properties>
<string name="Name">HackEffects</string>
<ProtectedString name="Source">-- ServerScriptService/Systems/HackEffects.luau
--!strict
-- GHOSTNET :: Was in der Welt passiert, wenn ein Hack klappt.
--
-- Das Attribut "OnSuccess" am Part ist ein Schluessel in diese Tabelle.
-- Ein neues Verhalten = ein neuer Eintrag hier. Der HackService kennt
-- keinen einzigen Objekttyp.

local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Types = require(ReplicatedStorage.Shared.Types)

type HackTarget = Types.HackTarget

local HackEffects = {}

--==========================================================================
-- Hilfsfunktionen
--==========================================================================

local function setLights(part: BasePart, enabled: boolean)
	for _, d in part:GetDescendants() do
		if d:IsA("Light") then
			d.Enabled = enabled
		end
	end
end

local function pulseLight(part: BasePart, color: Color3, duration: number)
	local existing = part:FindFirstChildOfClass("PointLight")
	local created = existing == nil

	local l: PointLight
	if existing then
		l = existing
	else
		l = Instance.new("PointLight")
		l.Parent = part
	end
	local oldColor, oldBright, oldRange = l.Color, l.Brightness, l.Range
	l.Color = color
	l.Brightness = 6
	l.Range = 18
	l.Enabled = true

	TweenService:Create(l, TweenInfo.new(duration, Enum.EasingStyle.Quad), { Brightness = 0 }):Play()
	task.delay(duration, function()
		if created then
			l:Destroy()
		else
			l.Color, l.Brightness, l.Range = oldColor, oldBright, oldRange
		end
	end)
end

-- Faerbt einen Part fuer die Dauer der Stoerung um und stellt danach
-- den Originalzustand wieder her.
local function recolorFor(part: BasePart, color: Color3, duration: number)
	local originalColor = part.Color
	TweenService:Create(part, TweenInfo.new(0.3), { Color = color }):Play()
	task.delay(duration, function()
		if part.Parent then
			TweenService:Create(part, TweenInfo.new(0.6), { Color = originalColor }):Play()
		end
	end)
end

--==========================================================================
-- Effekte
--==========================================================================

type EffectFn = (target: HackTarget, player: Player, duration: number) -&gt; ()

local Effects: { [string]: EffectFn } = {}

-- Standard, wenn ein Part keinen bekannten OnSuccess-Wert hat.
Effects.Offline = function(target, _player, duration)
	local part = target.Part
	setLights(part, false)
	recolorFor(part, Config.Theme.Ice, duration)
	task.delay(duration, function()
		if part.Parent then
			setLights(part, true)
		end
	end)
end

Effects.CameraOffline = function(target, _player, duration)
	local part = target.Part
	setLights(part, false)
	recolorFor(part, Config.Theme.Ice, duration)

	-- Kamera senkt den Kopf, solange sie tot ist.
	local original = part.CFrame
	TweenService:Create(part, TweenInfo.new(0.8, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		CFrame = original * CFrame.Angles(math.rad(-55), 0, 0),
	}):Play()

	task.delay(duration, function()
		if part.Parent then
			setLights(part, true)
			TweenService:Create(part, TweenInfo.new(1.0, Enum.EasingStyle.Quad), { CFrame = original }):Play()
		end
	end)
end

Effects.DoorOpen = function(target, _player, duration)
	local part = target.Part
	local original = part.CFrame
	local drop = part.Size.Y + 0.4

	part.CanCollide = false
	pulseLight(part, Config.Theme.Cyan, 0.8)
	TweenService:Create(part, TweenInfo.new(0.7, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
		CFrame = original * CFrame.new(0, -drop, 0),
	}):Play()

	task.delay(duration, function()
		if not part.Parent then
			return
		end
		local close = TweenService:Create(part, TweenInfo.new(0.9, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
			CFrame = original,
		})
		close:Play()
		close.Completed:Connect(function()
			if part.Parent then
				part.CanCollide = true
			end
		end)
	end)
end

Effects.AtmPayout = function(target, _player, duration)
	local part = target.Part
	pulseLight(part, Config.Theme.Amber, 1.2)
	recolorFor(part, Config.Theme.Amber, math.min(duration, 3))

	local sparks = Instance.new("ParticleEmitter")
	sparks.Color = ColorSequence.new(Config.Theme.Amber)
	sparks.Lifetime = NumberRange.new(0.4, 0.9)
	sparks.Rate = 90
	sparks.Speed = NumberRange.new(6, 12)
	sparks.SpreadAngle = Vector2.new(35, 35)
	sparks.Size = NumberSequence.new(0.18)
	sparks.Parent = part

	task.delay(1.1, function()
		sparks.Enabled = false
		task.delay(1.2, function()
			sparks:Destroy()
		end)
	end)
end

--==========================================================================
-- Aufruf durch den HackService
--==========================================================================

function HackEffects.Apply(target: HackTarget, player: Player)
	local fn = Effects[target.OnSuccess]
	if not fn then
		warn(("[GHOSTNET] Unbekannter OnSuccess-Effekt '%s' an %s - benutze 'Offline'."):format(
			target.OnSuccess,
			target.Part:GetFullName()
		))
		fn = Effects.Offline
	end

	local duration = math.max(1, target.DownTime)
	local call = table.pack(pcall(fn, target, player, duration))
	if not call[1] then
		warn(("[GHOSTNET] Effekt '%s' ist fehlgeschlagen: %s"):format(target.OnSuccess, tostring(call[2])))
	end
end

function HackEffects.Has(name: string): boolean
	return Effects[name] ~= nil
end

return HackEffects
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="GN19">
<Properties>
<string name="Name">HackService</string>
<ProtectedString name="Source">-- ServerScriptService/Systems/HackService.luau
--!strict
-- GHOSTNET :: Das eine Hack-Modul.
--
-- Hier laufen alle Hack-Sessions zusammen. Der Service kennt KEINEN
-- einzelnen Objekttyp - er liest nur Attribute und ruft ein Minispiel auf.
-- Ein neues Ziel in der Welt braucht deshalb keine Zeile Code.
--
-- SERVER-AUTORITAET
--   Der Client schickt ausschliesslich "ich habe X angeklickt". Der Server
--   fuehrt den Raetselzustand, die Uhr, die Versuche, die Distanz und den
--   Cooldown. Kein Remote nimmt jemals ein Ergebnis, eine Zeit oder einen
--   Betrag vom Client entgegen.

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Geometry = require(ReplicatedStorage.Shared.Geometry)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Types = require(ReplicatedStorage.Shared.Types)

local EconomyService = require(script.Parent.EconomyService)
local HackEffects = require(script.Parent.HackEffects)
local HackTargets = require(script.Parent.HackTargets)
local MonetizationService = require(script.Parent.MonetizationService)
local RateLimiter = require(script.Parent.RateLimiter)
local TimeService = require(script.Parent.TimeService)
local SaveService = require(script.Parent.SaveService)
local TraceService = require(script.Parent.TraceService)

type Session = Types.Session

local HackService = {}

-- Minispiel-Register. Phase 3 traegt SignalMatch / CodeCrack hier ein -
-- sonst aendert sich nichts.
local Minigames = {
	NodeBreach = require(script.Parent.Minigames.NodeBreach),
}

local sessions: { [Player]: Session } = {}

-- Wer mitbekommen will, dass ein Hack ausgegangen ist, meldet sich hier an -
-- genau wie bei TraceService.OnBust. Dadurch bleibt die Richtung
-- MissionService -&gt; HackService und kein Modul requiret rueckwaerts.
local resolvedCallbacks: { (Player, { [string]: any }) -&gt; () } = {}

function HackService.OnHackResolved(callback: (Player, { [string]: any }) -&gt; ())
	table.insert(resolvedCallbacks, callback)
end

-- Faktoren auf Ertrag und Trace, die von aussen kommen (Endgame-Entscheidung
-- aus Mission 10). Bewusst als Registrierung statt als Require: sonst
-- braeuchte der HackService den MissionService, der ihn schon kennt - und
-- damit haetten wir einen Kreis.
local rewardModifiers: { (Player) -&gt; number } = {}
local traceModifiers: { (Player) -&gt; number } = {}

function HackService.AddRewardModifier(fn: (Player) -&gt; number)
	table.insert(rewardModifiers, fn)
end

function HackService.AddTraceModifier(fn: (Player) -&gt; number)
	table.insert(traceModifiers, fn)
end

local function combined(list: { (Player) -&gt; number }, player: Player): number
	local factor = 1
	for _, fn in list do
		local ok, value = pcall(fn, player)
		if ok and typeof(value) == "number" and value &gt; 0 then
			factor *= value
		end
	end
	return factor
end

-- DECKUNG. Ein Ziel mit Attribut Exposed = true steht auf offener Strasse:
-- es zahlt mehr und kostet mehr Trace. Das ist der Nachfolger des alten
-- Nachtbonus - seit die Stadt dauerhaft hell ist, entscheidet der Ort ueber
-- das Risiko und nicht mehr die Uhrzeit. Siehe Config.Cover.
local function isExposed(part: BasePart): boolean
	local value = part:GetAttribute("Exposed")
	if typeof(value) == "boolean" then
		return value
	end
	return Config.TargetDefaults.Exposed
end

--==========================================================================
-- Hilfsfunktionen
--==========================================================================

local function now(): number
	return workspace:GetServerTimeNow()
end

local function isTable(v: any): boolean
	return typeof(v) == "table"
end

local function isCleanString(v: any, maxLen: number): boolean
	return typeof(v) == "string" and #v &gt; 0 and #v &lt;= maxLen
end

local function isInteger(v: any): boolean
	return typeof(v) == "number" and v == v and v % 1 == 0 and math.abs(v) &lt; 1e9
end

--==========================================================================
-- Abschluss einer Session
--==========================================================================

-- reason: SOLVED | TIMEOUT | NO_ATTEMPTS | OUT_OF_RANGE | ABORTED | TARGET_GONE | BUSTED
local function resolve(session: Session, success: boolean, reason: string)
	if session.Resolved then
		return
	end
	session.Resolved = true

	local player = session.Player
	if sessions[player] == session then
		sessions[player] = nil
	end

	local target = HackTargets.Get(session.TargetId)
	local reward = 0
	local traceDelta = 0
	local cooldown = 0

	if target then
		-- Trace faellt immer an, nur unterschiedlich stark. Weglaufen oder
		-- abbrechen ist also billiger, aber nie gratis.
		local factor = 1.0
		if not success then
			factor = if reason == "ABORTED" then Config.Trace.AbortFactor else Config.Trace.FailFactor
		end
		local cooling = EconomyService.GetRig(player).Cooling
		traceDelta = Config.GetTraceGain(target.TraceGain * factor, cooling)

		-- Offen stehende Ziele kosten mehr Trace. Der Aufschlag gilt auch bei
		-- Fehlschlag und Abbruch: gesehen wurde man auf offener Strasse so
		-- oder so, das ist ja gerade der Punkt.
		if isExposed(target.Part) then
			traceDelta *= Config.Cover.ExposedTraceFactor
		end

		-- Uebungsziel: erzeugt bewusst gar keinen Trace, damit niemand im
		-- Tutorial auffliegt, bevor er weiss, was der Balken bedeutet.
		if target.Part:GetAttribute("NoTrace") == true then
			traceDelta = 0
		end

		-- Gamepass ColdRig: dauerhaft weniger Trace. Zeitersparnis, kein
		-- Raetselvorteil - die Aufgabe selbst bleibt gleich schwer.
		traceDelta *= MonetizationService.TraceFactor(player)

		-- Endgame-Entscheidung und alles andere von aussen Angemeldete.
		traceDelta *= combined(traceModifiers, player)

		-- Co-Op: ein zweiter Spieler in Reichweite eines RequiresTwo-Ziels
		-- halbiert den Trace-Anstieg. Das ist der Grund, einen Freund
		-- mitzubringen - und er muss spuerbar sein.
		if
			target.Part:GetAttribute("RequiresTwo") == true
			and Geometry.HasNearbyOtherPlayer(player, target.Part, Config.Raid.CoopRange)
		then
			traceDelta *= Config.Raid.CoopTraceFactor
		end

		if success then
			-- Drei Faktoren, alle serverseitig:
			--   Tageszeit  nur wenn der Zyklus laeuft, sonst 1
			--   Deckung    offene Ziele zahlen mehr (Config.Cover)
			--   Angemeldet Endgame-Entscheidung aus Mission 10
			local exposure = if isExposed(target.Part) then 1 + Config.Cover.ExposedRewardBonus else 1
			reward = math.floor(
				target.Reward * TimeService.RewardMultiplier() * exposure * combined(rewardModifiers, player)
			)
			cooldown = target.Cooldown
			EconomyService.AwardUnsold(player, reward)
			HackTargets.SetCooldown(player, target.Id, cooldown)
			HackTargets.MarkDown(target, target.DownTime)
			HackEffects.Apply(target, player)
		else
			cooldown = Config.Cooldown.AfterFail
			HackTargets.SetCooldown(player, target.Id, cooldown)
		end

		EconomyService.CountHack(player, success)
	end

	-- Erst gutschreiben, dann den Trace anwenden: wer sich mit dem letzten
	-- Hack in den Bust treibt, verliert genau diese Beute auch wieder. Das
	-- ist der Moment, um den es geht.
	if traceDelta &gt; 0 then
		TraceService.Add(player, traceDelta)
	end

	if player.Parent then
		Remotes.HackResolved:FireClient(player, {
			SessionId = session.Id,
			Success = success,
			Reason = reason,
			Reward = reward,
			TraceDelta = traceDelta,
			Cooldown = cooldown,
			TargetId = session.TargetId,
			Effect = target and target.OnSuccess or "",
		})
	end

	if target then
		SaveService.RequestSave(player)
	end

	for _, callback in resolvedCallbacks do
		task.spawn(function()
			local ok, err = pcall(callback, player, {
				TargetId = session.TargetId,
				Success = success,
				Reason = reason,
				Reward = reward,
				Difficulty = session.Difficulty,
				HackType = session.HackType,
			})
			if not ok then
				warn(("[GHOSTNET] OnHackResolved-Callback fehlgeschlagen: %s"):format(tostring(err)))
			end
		end)
	end
end

-- Nur fuer Diagnose (AdminService). Sagt nichts ueber den Raetselzustand aus.
function HackService.IsHacking(player: Player): boolean
	local session = sessions[player]
	return session ~= nil and not session.Resolved
end

function HackService.AbortFor(player: Player, reason: string)
	local session = sessions[player]
	if session then
		resolve(session, false, reason)
	end
end

--==========================================================================
-- Start
--==========================================================================

-- Sagt dem Spieler, WARUM ein Start nicht geklappt hat. Ohne das klickt man
-- im Spiel ins Leere und haelt es fuer einen Bug.
local function deny(player: Player, targetId: string, reason: string, seconds: number?)
	if player.Parent then
		Remotes.HackDenied:FireClient(player, {
			TargetId = targetId,
			Reason = reason,
			Seconds = seconds or 0,
		})
	end
end

local function onRequestStart(player: Player, payload: any)
	if not RateLimiter.Check(player, "HackRequestStart") then
		return
	end
	if not isTable(payload) then
		return
	end

	local targetId = (payload :: any).TargetId
	if not isCleanString(targetId, 32) then
		return
	end

	if sessions[player] then
		return -- laeuft schon eine Session
	end

	-- Ohne geladenes Profil gibt es keinen Cooldown und kein Rig - dann wird
	-- gar nicht erst gestartet, statt mit Startwerten zu spielen.
	if not SaveService.IsReady(player) then
		deny(player, targetId, "LOADING")
		return
	end

	-- Nach einem Bust ist erstmal Ruhe.
	local lockLeft = TraceService.LockSecondsLeft(player)
	if lockLeft &gt; 0 then
		deny(player, targetId, "BUSTED", math.ceil(lockLeft))
		return
	end

	local target = HackTargets.Get(targetId)
	if not target or not target.Part.Parent then
		deny(player, targetId, "UNKNOWN_TARGET")
		return
	end

	if HackTargets.IsDown(target) then
		deny(player, target.Id, "OFFLINE")
		return
	end

	local cooldownLeft = HackTargets.CooldownLeft(player, target.Id)
	if cooldownLeft &gt; 0 then
		deny(player, target.Id, "COOLDOWN", math.ceil(cooldownLeft))
		return
	end

	if EconomyService.GetTier(player) &lt; target.RequiredLevel then
		-- Nicht nur "Tier zu niedrig", sondern WELCHES Bauteil bremst.
		-- Ohne das weiss der Spieler nicht, was er kaufen soll.
		local rig = EconomyService.GetRig(player)
		local weakest, weakestLevel = Config.Rig.Components[1], math.huge
		for _, component in Config.Rig.Components do
			local level = (rig :: any)[component] :: number
			if level &lt; weakestLevel then
				weakest, weakestLevel = component, level
			end
		end
		if player.Parent then
			Remotes.HackDenied:FireClient(player, {
				TargetId = target.Id,
				Reason = "LEVEL",
				Seconds = target.RequiredLevel,
				Weakest = (Config.Rig.Labels :: any)[weakest],
				WeakestLevel = weakestLevel,
			})
		end
		return
	end

	local minigame = (Minigames :: any)[target.HackType]
	if not minigame then
		warn(("[GHOSTNET] %s verlangt HackType '%s', den es nicht gibt."):format(
			target.Part:GetFullName(),
			target.HackType
		))
		deny(player, target.Id, "INTERNAL")
		return
	end

	-- Distanz IMMER serverseitig. Der Client bekommt hier kein Wort.
	local range = EconomyService.GetRange(player) + Config.Range.Tolerance
	local distance = HackTargets.DistanceFromPlayer(target, player)
	if not distance or distance &gt; range then
		-- Die konkrete Zahl mitschicken: "zu weit weg" allein sagt dem
		-- Spieler nicht, ob zwei Schritte reichen oder ein Upgrade noetig ist.
		deny(player, target.Id, "RANGE", if distance then math.ceil(distance - range) else 0)
		return
	end

	local rig = EconomyService.GetRig(player)
	local timeLimit = Config.GetTimeLimit(rig.CPU, target.Difficulty)
	local attempts = Config.GetAttempts(rig.RAM)

	local rng = Random.new()
	local public, state = minigame.Generate(target.Difficulty, rng)

	local session: Session = {
		Id = HttpService:GenerateGUID(false),
		Player = player,
		TargetId = target.Id,
		HackType = target.HackType,
		Difficulty = target.Difficulty,
		Range = range,
		ExpectedStep = 1,
		AttemptsLeft = attempts,
		Deadline = now() + timeLimit,
		StartedAt = now(),
		State = state,
		Resolved = false,
	}
	sessions[player] = session

	Remotes.HackSessionStarted:FireClient(player, {
		SessionId = session.Id,
		HackType = session.HackType,
		Label = minigame.Label(),
		Public = public,
		Deadline = session.Deadline,
		TimeLimit = timeLimit,
		Attempts = attempts,
		-- Attribut "Teaches" am Part: die HackUI erklaert das Raetsel dann
		-- im Spiel. Haengt bewusst am Objekt und nicht am Missionsfortschritt,
		-- damit der HackService den MissionService nicht kennen muss.
		Tutorial = target.Part:GetAttribute("Teaches") == true,
		Target = {
			Id = target.Id,
			Name = target.DisplayName,
			Difficulty = target.Difficulty,
			Reward = target.Reward,
		},
	})
end

--==========================================================================
-- Eingabe
--==========================================================================

local function onInput(player: Player, payload: any)
	if not RateLimiter.Check(player, "HackInput") then
		return
	end
	if not isTable(payload) then
		return
	end

	local session = sessions[player]
	if not session or session.Resolved then
		return
	end

	local p = payload :: any
	if not isCleanString(p.SessionId, 64) or p.SessionId ~= session.Id then
		return
	end
	if not isInteger(p.Step) or p.Step ~= session.ExpectedStep then
		return -- Wiederholung oder Luecke: verwerfen
	end
	if not isTable(p.Payload) then
		return
	end

	if now() &gt; session.Deadline then
		resolve(session, false, "TIMEOUT")
		return
	end

	local target = HackTargets.Get(session.TargetId)
	if not target or not target.Part.Parent then
		resolve(session, false, "TARGET_GONE")
		return
	end

	local distance = HackTargets.DistanceFromPlayer(target, player)
	if not distance or distance &gt; session.Range then
		resolve(session, false, "OUT_OF_RANGE")
		return
	end

	local minigame = (Minigames :: any)[session.HackType]
	local ok, result = pcall(minigame.Input, session.State, p.Payload)
	if not ok then
		warn(("[GHOSTNET] Minispiel '%s' ist abgestuerzt: %s"):format(session.HackType, tostring(result)))
		resolve(session, false, "ABORTED")
		return
	end

	-- Jede verarbeitete Eingabe zaehlt hoch, auch eine ungueltige.
	-- Damit kann derselbe Step nie zweimal wirken.
	session.ExpectedStep += 1

	if result.CostsAttempt then
		session.AttemptsLeft -= 1
	end

	Remotes.HackFeedback:FireClient(player, {
		SessionId = session.Id,
		Step = p.Step,
		Ok = result.Ok,
		Reason = result.Reason,
		AttemptsLeft = session.AttemptsLeft,
		Feedback = result.Feedback,
	})

	if result.Solved then
		resolve(session, true, "SOLVED")
	elseif session.AttemptsLeft &lt;= 0 then
		resolve(session, false, "NO_ATTEMPTS")
	end
end

--==========================================================================
-- Abbruch durch den Spieler
--==========================================================================

local function onAbort(player: Player, payload: any)
	if not RateLimiter.Check(player, "HackAbort") then
		return
	end
	if not isTable(payload) then
		return
	end
	local session = sessions[player]
	if not session then
		return
	end
	if (payload :: any).SessionId ~= session.Id then
		return
	end
	resolve(session, false, "ABORTED")
end

--==========================================================================
-- Wachhund: Zeit und Distanz, unabhaengig davon, ob der Client etwas sendet
--==========================================================================

local function watchdog()
	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator &lt; Config.Session.TickRate then
			return
		end
		accumulator = 0

		local t = now()
		for player, session in sessions do
			if session.Resolved then
				continue
			end

			if not player.Parent then
				session.Resolved = true
				sessions[player] = nil
				continue
			end

			if t &gt; session.Deadline then
				resolve(session, false, "TIMEOUT")
				continue
			end

			if t - session.StartedAt &lt; Config.Session.GraceAfterStart then
				continue
			end

			local target = HackTargets.Get(session.TargetId)
			if not target or not target.Part.Parent then
				resolve(session, false, "TARGET_GONE")
				continue
			end

			local distance = HackTargets.DistanceFromPlayer(target, player)
			if not distance or distance &gt; session.Range then
				resolve(session, false, "OUT_OF_RANGE")
			end
		end
	end)
end

--==========================================================================

function HackService.Init()
	Remotes.HackRequestStart.OnServerEvent:Connect(onRequestStart)
	Remotes.HackInput.OnServerEvent:Connect(onInput)
	Remotes.HackAbort.OnServerEvent:Connect(onAbort)

	-- Beim Bust fliegt eine laufende Session sofort raus. Die Anmeldung laeuft
	-- ueber den Callback, damit der TraceService den HackService nicht kennen
	-- muss (sonst haetten wir einen Require-Kreis).
	TraceService.OnBust(function(player: Player)
		HackService.AbortFor(player, "BUSTED")
	end)

	Players.PlayerRemoving:Connect(function(player)
		local session = sessions[player]
		if session then
			session.Resolved = true
			sessions[player] = nil
		end
	end)

	watchdog()

	local types = {}
	for name in Minigames do
		table.insert(types, name)
	end
	print(("[GHOSTNET] HackService bereit. Minispiele: %s"):format(table.concat(types, ", ")))
end

return HackService
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="GN20">
<Properties>
<string name="Name">HackTargets</string>
<ProtectedString name="Source">-- ServerScriptService/Systems/HackTargets.luau
--!strict
-- GHOSTNET :: Registry aller hackbaren Objekte.
--
-- Ein Hack-Ziel ist NUR ein BasePart mit dem Tag "GhostNetHackable".
-- Alle Eigenschaften kommen aus Attributen, fehlende aus Config.TargetDefaults.
-- Ein neues Ziel = neuer Part + Tag. Kein Code.
--
-- ZEITEN
--   Cooldowns liegen im Profil und benutzen os.time() (Unix-Zeit), damit sie
--   einen Serverwechsel ueberleben. Nur DownUntil - "die Kamera ist noch 30
--   Sekunden aus" - bleibt bei os.clock(): das ist ein reiner Kurzzeit-Timer
--   dieses Serverlaufs und gilt fuer alle Spieler gleichzeitig.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Geometry = require(ReplicatedStorage.Shared.Geometry)
local Types = require(ReplicatedStorage.Shared.Types)

local SaveService = require(script.Parent.SaveService)

type HackTarget = Types.HackTarget

local HackTargets = {}

local registry: { [string]: HackTarget } = {}
local byPart: { [BasePart]: HackTarget } = {}
local idCounter = 0

--==========================================================================
-- Attribute lesen
--==========================================================================

local function attrNumber(part: BasePart, name: string, default: number): number
	local v = part:GetAttribute(name)
	if typeof(v) == "number" then
		return v
	end
	return default
end

local function attrString(part: BasePart, name: string, default: string): string
	local v = part:GetAttribute(name)
	if typeof(v) == "string" and v ~= "" then
		return v
	end
	return default
end

local function readTarget(part: BasePart, id: string): HackTarget
	local d = Config.TargetDefaults

	local difficulty = math.clamp(math.floor(attrNumber(part, "Difficulty", d.Difficulty)), 1, 10)

	local reward = attrNumber(part, "Reward", d.Reward)
	if reward &lt; 0 then
		reward = Config.GetReward(difficulty)
	end

	local traceGain = attrNumber(part, "TraceGain", d.TraceGain)
	if traceGain &lt; 0 then
		traceGain = difficulty * Config.Trace.GainPerDifficulty
	end

	local cooldown = attrNumber(part, "Cooldown", d.Cooldown)
	if cooldown &lt; 0 then
		cooldown = Config.Cooldown.Default
	end

	local displayName = attrString(part, "DisplayName", d.DisplayName)
	if displayName == "" then
		displayName = part.Name
	end

	local existing = registry[id]
	return {
		Id = id,
		Part = part,
		DisplayName = displayName,
		Difficulty = difficulty,
		HackType = attrString(part, "HackType", d.HackType),
		Reward = math.floor(reward),
		TraceGain = traceGain,
		Cooldown = cooldown,
		RequiredLevel = math.max(1, math.floor(attrNumber(part, "RequiredLevel", d.RequiredLevel))),
		OnSuccess = attrString(part, "OnSuccess", d.OnSuccess),
		DownTime = attrNumber(part, "DownTime", d.DownTime),
		DownUntil = existing and existing.DownUntil or 0,
	}
end

--==========================================================================
-- Registrierung
--==========================================================================

-- Zaehlt hoch, bis eine Id wirklich frei ist. Frueher wurde nur einmal
-- generiert - ein Part mit gespeichertem Attribut "T0001" und ein Part ohne
-- Attribut bekamen dann dieselbe Id, und das erste Ziel war nicht mehr
-- erreichbar.
local function nextFreeId(): string
	repeat
		idCounter += 1
	until registry[("T%04d"):format(idCounter)] == nil
	return ("T%04d"):format(idCounter)
end

local function register(inst: Instance)
	if not inst:IsA("BasePart") then
		warn(("[GHOSTNET] '%s' hat den Hackable-Tag, ist aber kein BasePart."):format(inst:GetFullName()))
		return
	end
	local part = inst :: BasePart
	if byPart[part] then
		return
	end

	-- Stabile Id: bereits vergebene wiederverwenden, sonst eine freie neue.
	local id = part:GetAttribute("TargetId")
	if typeof(id) ~= "string" or id == "" or registry[id :: string] then
		id = nextFreeId()
		part:SetAttribute("TargetId", id)
	end

	local target = readTarget(part, id :: string)
	registry[id :: string] = target
	byPart[part] = target

	-- Live-Tuning im Studio: Attribut aendern -&gt; sofort uebernommen.
	part.AttributeChanged:Connect(function(attribute: string)
		if attribute == "TargetId" then
			return
		end
		local current = byPart[part]
		if current then
			local refreshed = readTarget(part, current.Id)
			registry[current.Id] = refreshed
			byPart[part] = refreshed
		end
	end)
end

local function unregister(inst: Instance)
	if not inst:IsA("BasePart") then
		return
	end
	local part = inst :: BasePart
	local target = byPart[part]
	if target then
		registry[target.Id] = nil
		byPart[part] = nil
	end
end

function HackTargets.Init()
	for _, inst in CollectionService:GetTagged(Config.HackableTag) do
		register(inst)
	end
	CollectionService:GetInstanceAddedSignal(Config.HackableTag):Connect(register)
	CollectionService:GetInstanceRemovedSignal(Config.HackableTag):Connect(unregister)

	print(("[GHOSTNET] HackTargets: %d Ziele registriert."):format(HackTargets.Count()))
end

function HackTargets.Count(): number
	local n = 0
	for _ in registry do
		n += 1
	end
	return n
end

function HackTargets.Get(id: string): HackTarget?
	return registry[id]
end

function HackTargets.All(): { [string]: HackTarget }
	return registry
end

--==========================================================================
-- Distanz
--==========================================================================

function HackTargets.DistanceTo(target: HackTarget, position: Vector3): number
	return Geometry.SurfaceDistance(target.Part, position)
end

-- Liefert Distanz oder nil, wenn der Spieler gerade keinen lebenden Character hat.
function HackTargets.DistanceFromPlayer(target: HackTarget, player: Player): number?
	local position = Geometry.AlivePosition(player)
	if not position then
		return nil
	end
	return Geometry.SurfaceDistance(target.Part, position)
end

--==========================================================================
-- Cooldowns (im Profil, damit ein Rejoin sie nicht loescht)
--==========================================================================

function HackTargets.CooldownLeft(player: Player, id: string): number
	local profile = SaveService.Get(player)
	if not profile then
		return 0
	end
	local until_ = profile.Cooldowns[id]
	if typeof(until_) ~= "number" then
		return 0
	end
	return math.max(0, until_ - os.time())
end

function HackTargets.SetCooldown(player: Player, id: string, seconds: number)
	local profile = SaveService.Get(player)
	if not profile then
		return
	end
	profile.Cooldowns[id] = os.time() + math.floor(seconds)
	SaveService.RequestSave(player)
end

--==========================================================================
-- "Down"-Zustand (Kamera aus, Tuer offen, ...)
-- Gilt fuer alle Spieler gleichzeitig und nur fuer diesen Serverlauf -
-- deshalb bewusst os.clock() statt os.time().
--==========================================================================

function HackTargets.IsDown(target: HackTarget): boolean
	return target.DownUntil &gt; os.clock()
end

function HackTargets.MarkDown(target: HackTarget, seconds: number)
	target.DownUntil = os.clock() + seconds
	target.Part:SetAttribute("Offline", true)
	task.delay(seconds, function()
		if target.DownUntil &lt;= os.clock() and target.Part.Parent then
			target.Part:SetAttribute("Offline", false)
		end
	end)
end

return HackTargets
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="GN21">
<Properties>
<string name="Name">InventoryService</string>
<ProtectedString name="Source">-- ServerScriptService/Systems/InventoryService.luau
--!strict
-- GHOSTNET :: Das Lager und der Handel.
--
-- SICHERHEIT - der Kern dieses Moduls
--   Der Client schickt ausschliesslich { GoodId, Amount, Action }. Den Preis
--   holt sich der Server selbst beim MarketService. Ein vom Client
--   geschickter Preis wird NIRGENDS gelesen - genau darueber werden
--   Handelssysteme in Roblox-Spielen sonst leergeraeumt.
--   Zusaetzlich: Menge muss eine positive Ganzzahl unter der Obergrenze
--   sein, Lagerplatz und Guthaben werden geprueft, bevor irgendetwas gebucht
--   wird.
--
-- RISIKO - sonst ist Handel nur Warten
--   * Lagerplatz ist begrenzt: man muss sich entscheiden.
--   * Ware im Lager ist heiss. Ein Bust kostet auch davon einen Teil, damit
--     der Handel am Trace-System haengt statt danebenher zu laufen.
--   * Ware mit hohem Risikowert ist manchmal Ausschuss. Das Rig-Tier senkt
--     die Quote - damit bekommt das Upgrade-System einen zweiten Zweck.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Goods = require(ReplicatedStorage.Shared.Goods)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local EconomyService = require(script.Parent.EconomyService)
local MarketService = require(script.Parent.MarketService)
local MissionService = require(script.Parent.MissionService)
local MonetizationService = require(script.Parent.MonetizationService)
local VehicleService = require(script.Parent.VehicleService)
local RateLimiter = require(script.Parent.RateLimiter)
local SaveService = require(script.Parent.SaveService)
local TraceService = require(script.Parent.TraceService)

local InventoryService = {}

local rng = Random.new()

--==========================================================================
-- Lager lesen
--==========================================================================

function InventoryService.Used(player: Player): number
	local profile = SaveService.Get(player)
	if not profile then
		return 0
	end
	local used = 0
	for _, amount in profile.Stash do
		used += amount
	end
	return used
end

function InventoryService.Slots(player: Player): number
	local base = Config.GetStashSlots(EconomyService.GetTier(player))
	-- Gamepass BigStash: reine Kapazitaet, kein Spielvorteil beim Raetsel.
	local slots = math.floor(base * (1 + MonetizationService.StashBonus(player)))
	-- Das ausgeparkte Fahrzeug zaehlt mit. Genau das ist der mechanische
	-- Grund fuer den Transporter.
	return slots + VehicleService.StashBonus(player)
end

function InventoryService.Snapshot(player: Player): { [string]: any }
	local profile = SaveService.Get(player)
	local stash: { { [string]: any } } = {}

	if profile then
		for _, good in Goods.List do
			local amount = profile.Stash[good.Id]
			if amount and amount &gt; 0 then
				table.insert(stash, {
					Id = good.Id,
					Name = good.Name,
					Amount = amount,
					Sell = MarketService.GetSellPrice(good.Id) or 0,
				})
			end
		end
	end

	return {
		Stash = stash,
		Used = InventoryService.Used(player),
		Slots = InventoryService.Slots(player),
		-- Fuer die Anzeige "wie oft ist die Ware Ausschuss" - abhaengig vom
		-- eigenen Rig, deshalb pro Spieler und nicht im Marktpaket.
		Tier = EconomyService.GetTier(player),
	}
end

function InventoryService.Sync(player: Player)
	if player.Parent then
		Remotes.InventorySync:FireClient(player, InventoryService.Snapshot(player))
	end
end

--==========================================================================
-- Bust: das Lager ist genauso heiss wie das Bargeld
--==========================================================================

local function onBust(player: Player)
	if Config.Market.BustStashLossPercent &lt;= 0 then
		return
	end
	local profile = SaveService.Get(player)
	if not profile then
		return
	end

	local lost = 0
	for goodId, amount in profile.Stash do
		local remove = math.floor(amount * Config.Market.BustStashLossPercent + 0.5)
		if remove &gt; 0 then
			profile.Stash[goodId] = math.max(0, amount - remove)
			if profile.Stash[goodId] == 0 then
				profile.Stash[goodId] = nil
			end
			lost += remove
		end
	end

	if lost &gt; 0 then
		warn(("[GHOSTNET] Bust kostet %s zusaetzlich %d Einheiten Ware."):format(player.Name, lost))
		InventoryService.Sync(player)
		SaveService.RequestSave(player)
	end
end

--==========================================================================
-- Handel
--==========================================================================

local function result(ok: boolean, reason: string, extra: { [string]: any }?): { [string]: any }
	local payload: { [string]: any } = { Ok = ok, Reason = reason }
	if extra then
		for key, value in extra do
			payload[key] = value
		end
	end
	return payload
end

local function validAmount(value: any): number?
	if typeof(value) ~= "number" or value ~= value then
		return nil
	end
	if value % 1 ~= 0 or value &lt; 1 or value &gt; Config.Market.MaxPerTrade then
		return nil
	end
	return value
end

local function buy(player: Player, goodId: string, amount: number): { [string]: any }
	local profile = SaveService.Get(player)
	if not profile then
		return result(false, "LOADING")
	end

	local free = InventoryService.Slots(player) - InventoryService.Used(player)
	if amount &gt; free then
		return result(false, "NO_SPACE", { Free = math.max(0, free), Slots = InventoryService.Slots(player) })
	end

	-- Preis kommt vom Server, nicht vom Client.
	local unit = MarketService.GetBuyPrice(goodId)
	if not unit then
		return result(false, "UNKNOWN_GOOD")
	end
	local total = unit * amount

	if profile.Banked &lt; total then
		return result(false, "FUNDS", { Cost = total, Missing = total - profile.Banked, Unit = unit })
	end
	if not EconomyService.SpendBanked(player, total) then
		return result(false, "FUNDS", { Cost = total, Unit = unit })
	end

	profile.Stash[goodId] = (profile.Stash[goodId] or 0) + amount
	profile.Stats.GoodsBought += amount

	EconomyService.Sync(player)
	InventoryService.Sync(player)
	SaveService.RequestSave(player)

	-- BUY-Schritte in Missionen. Die Richtung ist bewusst
	-- InventoryService -&gt; MissionService, nie umgekehrt.
	MissionService.NotifyBuy(player, goodId, amount)

	return result(true, "OK", { Unit = unit, Total = total, Amount = amount, GoodId = goodId })
end

local function sell(player: Player, goodId: string, amount: number): { [string]: any }
	local profile = SaveService.Get(player)
	if not profile then
		return result(false, "LOADING")
	end

	local owned = profile.Stash[goodId] or 0
	if owned &lt; amount then
		return result(false, "NOT_OWNED", { Owned = owned })
	end

	local good = Goods.Get(goodId)
	local unit = MarketService.GetSellPrice(goodId)
	if not good or not unit then
		return result(false, "UNKNOWN_GOOD")
	end

	-- Faelschungen: pro Einheit gewuerfelt. Das Rig-Tier senkt die Quote.
	local risk = Config.GetFakeRisk(good.Risk, EconomyService.GetTier(player))
	local fakes = 0
	for _ = 1, amount do
		if rng:NextNumber() &lt; risk then
			fakes += 1
		end
	end

	local sold = amount - fakes
	local total = unit * sold

	profile.Stash[goodId] = owned - amount
	if profile.Stash[goodId] &lt;= 0 then
		profile.Stash[goodId] = nil
	end
	profile.Stats.GoodsSold += amount

	-- Erloes aus dem Darknet ist SAUBER: gehandelt wird vom Rechner aus, das
	-- muss nicht mehr durch den Hehler. Sonst waere Handel doppelt bestraft.
	if total &gt; 0 then
		EconomyService.AwardBanked(player, total)
	else
		EconomyService.Sync(player)
	end

	InventoryService.Sync(player)
	SaveService.RequestSave(player)

	return result(true, "OK", {
		Unit = unit,
		Total = total,
		Amount = amount,
		Sold = sold,
		Fakes = fakes,
		GoodId = goodId,
	})
end

--==========================================================================
-- Remote
--==========================================================================

local function onTrade(player: Player, payload: any): { [string]: any }
	if not RateLimiter.Check(player, "Trade") then
		return result(false, "RATE")
	end
	if typeof(payload) ~= "table" then
		return result(false, "BAD_PAYLOAD")
	end

	-- Das Darknet ist erst ab M03 offen. Ohne diese Pruefung koennte ein
	-- Client die Remote einfach direkt feuern und den Hub ueberspringen.
	if not MissionService.HasUnlock(player, Config.Market.RequiredUnlock) then
		return result(false, "LOCKED")
	end

	local action = (payload :: any).Action
	local goodId = (payload :: any).GoodId
	if action ~= "BUY" and action ~= "SELL" then
		return result(false, "BAD_PAYLOAD")
	end
	if not Goods.Exists(goodId) then
		return result(false, "UNKNOWN_GOOD")
	end

	local amount = validAmount((payload :: any).Amount)
	if not amount then
		return result(false, "BAD_AMOUNT", { Max = Config.Market.MaxPerTrade })
	end

	if action == "BUY" then
		return buy(player, goodId, amount)
	end
	return sell(player, goodId, amount)
end

--==========================================================================

function InventoryService.Init()
	Remotes.Trade.OnServerInvoke = function(player: Player, payload: any): { [string]: any }
		local ok, response = pcall(onTrade, player, payload)
		if not ok then
			warn(("[GHOSTNET] Trade ist abgestuerzt: %s"):format(tostring(response)))
			return result(false, "INTERNAL")
		end
		return response
	end

	TraceService.OnBust(onBust)

	SaveService.OnReady(function(player)
		InventoryService.Sync(player)
	end)

	print(("[GHOSTNET] InventoryService bereit. Lager %d Plaetze, max %d pro Kauf."):format(
		Config.Market.SlotsBase,
		Config.Market.MaxPerTrade
	))
end

return InventoryService
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="GN22">
<Properties>
<string name="Name">MapService</string>
<ProtectedString name="Source">-- ServerScriptService/Systems/MapService.luau
--!strict
-- GHOSTNET :: Was steht wo - einmal serverseitig gesammelt.
--
-- WARUM DER SERVER DAS SCHICKT UND NICHT DER CLIENT ES SELBST SUCHT
--   Mit StreamingEnabled hat der Client entfernte Teile gar nicht geladen.
--   Eine Karte, die per CollectionService im Workspace nachschaut, wuerde
--   also genau das zeigen, was ohnehin schon zu sehen ist - und damit nichts
--   nuetzen. Deshalb sammelt der Server einmal alles ein und schickt eine
--   Liste aus Position, Art und Name.
--
-- WAS HIER NICHT DRINSTEHT
--   Keine Loesungen, keine Schwierigkeitsdetails, keine Cooldowns. Die Karte
--   verraet WO etwas steht, nicht WIE man es knackt. Ein Hack-Ziel ist ohnehin
--   ein sichtbares Objekt in der Welt - das ist kein Geheimnis.
--
-- KEIN EIGENER TAKT
--   Die Welt aendert sich fast nie: Objekte werden beim Serverstart gebaut.
--   Deshalb wird nur bei Tag-Aenderungen neu gesammelt, und das gebuendelt
--   (Config.Map.SyncDebounce) - sonst feuert der Weltaufbau hunderte Pakete.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local RoadNetwork = require(script.Parent.RoadNetwork)

local MapService = {}

local M = Config.Map

type Poi = {
	Kind: string,
	Name: string,
	X: number,
	Z: number,
}

-- Einmal gerechnet und dann wiederverwendet: die Liste aendert sich nur,
-- wenn jemand ein getaggtes Objekt hinzufuegt oder entfernt.
local cached: { [string]: any }? = nil
local dirty = true
local pending = false

--==========================================================================
-- Sammeln
--==========================================================================

local function positionOf(instance: Instance): Vector3?
	if instance:IsA("BasePart") then
		return instance.Position
	end
	if instance:IsA("Model") then
		local ok, pivot = pcall(function()
			return instance:GetPivot()
		end)
		if ok then
			return pivot.Position
		end
	end
	return nil
end

local function labelOf(instance: Instance, fallback: string): string
	local display = instance:GetAttribute("DisplayName")
	if typeof(display) == "string" and display ~= "" then
		return display
	end
	return fallback
end

local function collect(tag: string, kind: string, fallback: string, into: { Poi }, limit: number?)
	local count = 0
	for _, instance in CollectionService:GetTagged(tag) do
		if limit and count &gt;= limit then
			break
		end
		if not instance:IsDescendantOf(workspace) then
			continue
		end
		local position = positionOf(instance)
		if not position then
			continue
		end

		-- Offen stehende Ziele bekommen eine eigene Farbe: der Spieler soll
		-- auf der Karte sehen koennen, wo mehr Geld und mehr Risiko liegt.
		local resolved = kind
		if kind == "TARGET" and instance:GetAttribute("Exposed") == true then
			resolved = "EXPOSED"
		end

		table.insert(into, {
			Kind = resolved,
			Name = labelOf(instance, fallback),
			-- Nur X und Z. Die Karte ist zweidimensional, und jedes Feld,
			-- das nicht geschickt wird, ist gespartes Netzwerk.
			X = math.round(position.X),
			Z = math.round(position.Z),
		})
		count += 1
	end
end

local function build(): { [string]: any }
	local pois: { Poi } = {}

	collect(Config.FenceTag, "FENCE", "Hehler", pois)
	collect(Config.DealerTag, "DEALER", "Autohaus", pois)
	collect(Config.VehicleSpawnTag, "GARAGE", "Garage", pois)
	collect(Config.ContactTag, "CONTACT", "Kontakt", pois)
	-- Ziele zuletzt und begrenzt: davon gibt es die meisten, und bei einer
	-- Punktwolke sieht man die wichtigen Orte nicht mehr.
	collect(Config.HackableTag, "TARGET", "Ziel", pois, M.MaxTargets)

	-- Strassennetz. Kommt aus demselben Graphen, auf dem Verkehr und Polizei
	-- fahren - es kann also gar keine zweite, abweichende Karte geben.
	local nodes: { { number } } = {}
	local edges: { { number } } = {}
	local seen: { [string]: boolean } = {}

	for _, node in RoadNetwork.All() do
		nodes[node.Id] = { math.round(node.Position.X), math.round(node.Position.Z) }
		for _, linkId in node.Links do
			local key = if node.Id &lt; linkId
				then ("%d-%d"):format(node.Id, linkId)
				else ("%d-%d"):format(linkId, node.Id)
			if seen[key] then
				continue
			end
			seen[key] = true
			table.insert(edges, { node.Id, linkId })
		end
	end

	return {
		Nodes = nodes,
		Edges = edges,
		Pois = pois,
	}
end

local function data(): { [string]: any }
	if dirty or not cached then
		cached = build()
		dirty = false
	end
	return cached :: { [string]: any }
end

--==========================================================================
-- Senden
--==========================================================================

function MapService.SyncTo(player: Player)
	if player.Parent then
		Remotes.MapSync:FireClient(player, data())
	end
end

local function broadcast()
	local payload = data()
	for _, player in Players:GetPlayers() do
		Remotes.MapSync:FireClient(player, payload)
	end
end

-- Gebuendelt: der Weltaufbau taggt hunderte Objekte hintereinander, und
-- jedes einzeln zu senden waere sinnlos teuer.
local function markDirty()
	dirty = true
	if pending then
		return
	end
	pending = true
	task.delay(M.SyncDebounce, function()
		pending = false
		broadcast()
	end)
end

--==========================================================================

function MapService.Init()
	for _, tag in { Config.HackableTag, Config.FenceTag, Config.DealerTag, Config.VehicleSpawnTag, Config.ContactTag } do
		CollectionService:GetInstanceAddedSignal(tag):Connect(markDirty)
		CollectionService:GetInstanceRemovedSignal(tag):Connect(markDirty)
	end

	Players.PlayerAdded:Connect(function(player)
		-- Kurz warten: beim Beitritt waehrend des Weltaufbaus waere die
		-- Liste sonst halb leer, und nachgeliefert wird erst beim naechsten
		-- Tag-Ereignis.
		task.delay(M.SyncDebounce, MapService.SyncTo, player)
	end)
	for _, player in Players:GetPlayers() do
		task.defer(MapService.SyncTo, player)
	end

	print("[GHOSTNET] MapService bereit.")
end

return MapService
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="GN23">
<Properties>
<string name="Name">MarketService</string>
<ProtectedString name="Source">-- ServerScriptService/Systems/MarketService.luau
--!strict
-- GHOSTNET :: Die Preise im Darknet.
--
-- WARUM SICH DIE PREISE BEWEGEN MUESSEN
--   Ein fester Kurs macht aus Handel einen Knopf, der 100 in 120 verwandelt.
--   Das ist kein Spiel. Erst wenn ein Preis steigen UND fallen kann, wird
--   aus "kaufen" eine Entscheidung.
--
-- MEAN REVERSION
--   Ein reiner Zufallslauf driftet nach ein paar Stunden ins Absurde -
--   irgendwann kostet ein Datenpaket 40.000. Deshalb zieht jeder Tick den
--   Kurs ein Stueck zum Basispreis zurueck. Der Kurs schwankt, aber er
--   entgleist nicht.
--
-- SERVERWEIT, NICHT PRO SPIELER
--   Alle sehen denselben Kurs. Nur so kann jemand "Ausweise sind gerade
--   oben" in den Chat schreiben, und nur so wirkt ein Event wie ein
--   Ereignis statt wie ein Zufall.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Goods = require(ReplicatedStorage.Shared.Goods)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local TimeService = require(script.Parent.TimeService)

local MarketService = {}

type Quote = {
	Factor: number, -- Kursfaktor, 1.0 = Basispreis
	History: { number }, -- die letzten Faktoren, fuer den Mini-Chart
}

type MarketEvent = {
	Group: string,
	Strength: number, -- positiv = Preise hoch
	TicksLeft: number,
	Text: string,
}

local quotes: { [string]: Quote } = {}
local activeEvent: MarketEvent? = nil
local rng = Random.new()

--==========================================================================
-- Preise
--==========================================================================

function MarketService.GetFactor(goodId: string): number
	local quote = quotes[goodId]
	return if quote then quote.Factor else 1.0
end

-- Was der Spieler beim Kauf zahlt bzw. beim Verkauf bekommt. Diese beiden
-- Funktionen sind die EINZIGE Preisquelle; der InventoryService fragt hier
-- und liest niemals einen Preis aus einem Client-Paket.
function MarketService.GetBuyPrice(goodId: string): number?
	local good = Goods.Get(goodId)
	if not good then
		return nil
	end
	return Config.GetBuyPrice(good.Base, MarketService.GetFactor(goodId))
end

function MarketService.GetSellPrice(goodId: string): number?
	local good = Goods.Get(goodId)
	if not good then
		return nil
	end
	return Config.GetSellPrice(good.Base, MarketService.GetFactor(goodId))
end

-- Vollstaendige Marktlage fuer die UI.
function MarketService.Snapshot(): { [string]: any }
	local entries: { { [string]: any } } = {}
	for _, good in Goods.List do
		local quote = quotes[good.Id]
		table.insert(entries, {
			Id = good.Id,
			Name = good.Name,
			Blurb = good.Blurb,
			Group = good.Group,
			Base = good.Base,
			Risk = good.Risk,
			Factor = if quote then quote.Factor else 1.0,
			Buy = Config.GetBuyPrice(good.Base, if quote then quote.Factor else 1.0),
			Sell = Config.GetSellPrice(good.Base, if quote then quote.Factor else 1.0),
			History = if quote then table.clone(quote.History) else { 1.0 },
		})
	end

	return {
		Goods = entries,
		Event = if activeEvent
			then { Group = activeEvent.Group, Text = activeEvent.Text, TicksLeft = activeEvent.TicksLeft }
			else nil,
		TickSeconds = Config.Market.TickSeconds,
	}
end

local function broadcast()
	local snapshot = MarketService.Snapshot()
	for _, player in Players:GetPlayers() do
		Remotes.MarketSync:FireClient(player, snapshot)
	end
end

function MarketService.SyncTo(player: Player)
	if player.Parent then
		Remotes.MarketSync:FireClient(player, MarketService.Snapshot())
	end
end

--==========================================================================
-- Bewegung
--==========================================================================

local function rollEvent()
	if activeEvent then
		activeEvent.TicksLeft -= 1
		if activeEvent.TicksLeft &lt;= 0 then
			activeEvent = nil
		end
		return
	end

	if rng:NextNumber() &gt; Config.Market.EventChancePerTick then
		return
	end

	-- Eine Gruppe zufaellig auswaehlen.
	local groups: { string } = {}
	local seen: { [string]: boolean } = {}
	for _, good in Goods.List do
		if not seen[good.Group] then
			seen[good.Group] = true
			table.insert(groups, good.Group)
		end
	end
	if #groups == 0 then
		return
	end

	local group = groups[rng:NextInteger(1, #groups)]
	local up = rng:NextNumber() &lt; 0.5
	local strength = rng:NextNumber(Config.Market.EventStrengthMin, Config.Market.EventStrengthMax)
	if not up then
		strength = -strength
	end

	local text = if up
		then ("RAZZIA // %s knapp:  +%d%%"):format(group, math.floor(strength * 100 + 0.5))
		else ("LECK // %s ueberschwemmt:  %d%%"):format(group, math.floor(strength * 100 - 0.5))

	activeEvent = {
		Group = group,
		Strength = strength,
		TicksLeft = Config.Market.EventDurationTicks,
		Text = text,
	}

	print(("[GHOSTNET] Markt-Event: %s"):format(text))
	for _, player in Players:GetPlayers() do
		Remotes.MarketEvent:FireClient(player, { Text = text, Group = group })
	end
end

local function tickPrices()
	rollEvent()

	for _, good in Goods.List do
		local quote = quotes[good.Id]
		if not quote then
			continue
		end

		-- 1. Zufallsschritt im Rahmen der Volatilitaet. Tagsueber gedaempft:
		--    ruhige Kurse am Tag, wilde nachts - passend zum Nachtbonus.
		local swing = good.Volatility * TimeService.MarketVolatilityFactor()
		local drift = rng:NextNumber(-swing, swing)

		-- 2. Rueckkehr zum Basispreis (1.0). Das ist der Anker, ohne den
		--    der Kurs davonlaeuft.
		local pull = (1.0 - quote.Factor) * Config.Market.MeanReversion

		-- 3. Ein laufendes Event zieht die ganze Gruppe.
		local eventPush = 0
		if activeEvent and activeEvent.Group == good.Group then
			eventPush = activeEvent.Strength / Config.Market.EventDurationTicks
		end

		quote.Factor = math.clamp(
			quote.Factor + drift + pull + eventPush,
			Config.Market.MinFactor,
			Config.Market.MaxFactor
		)

		table.insert(quote.History, quote.Factor)
		while #quote.History &gt; Config.Market.HistoryPoints do
			table.remove(quote.History, 1)
		end
	end

	broadcast()
end

--==========================================================================
-- Eingriffe von aussen (nur AdminService)
--==========================================================================

function MarketService.SetFactor(goodId: string, factor: number)
	local quote = quotes[goodId]
	if not quote then
		return
	end
	quote.Factor = math.clamp(factor, Config.Market.MinFactor, Config.Market.MaxFactor)
	table.insert(quote.History, quote.Factor)
	while #quote.History &gt; Config.Market.HistoryPoints do
		table.remove(quote.History, 1)
	end
	broadcast()
end

function MarketService.ForceEvent(group: string, strength: number)
	local text = if strength &gt;= 0
		then ("RAZZIA // %s knapp:  +%d%%"):format(group, math.floor(strength * 100 + 0.5))
		else ("LECK // %s ueberschwemmt:  %d%%"):format(group, math.floor(strength * 100 - 0.5))

	activeEvent = {
		Group = group,
		Strength = strength,
		TicksLeft = Config.Market.EventDurationTicks,
		Text = text,
	}
	for _, player in Players:GetPlayers() do
		Remotes.MarketEvent:FireClient(player, { Text = text, Group = group })
	end
	broadcast()
end

--==========================================================================

function MarketService.Init()
	local valid, errors = Goods.Validate()
	if not valid then
		for _, message in errors do
			warn(("[GHOSTNET] Warenkatalog: %s"):format(message))
		end
	end

	for _, good in Goods.List do
		-- Kein Kaltstart auf exakt 1.0: sonst sehen alle Waren beim
		-- Serverstart gleich langweilig aus.
		local start = 1.0 + rng:NextNumber(-good.Volatility, good.Volatility)
		quotes[good.Id] = { Factor = start, History = { start } }
	end

	Players.PlayerAdded:Connect(function(player)
		task.defer(MarketService.SyncTo, player)
	end)
	for _, player in Players:GetPlayers() do
		task.defer(MarketService.SyncTo, player)
	end

	task.spawn(function()
		while true do
			task.wait(Config.Market.TickSeconds)
			local ok, err = pcall(tickPrices)
			if not ok then
				warn(("[GHOSTNET] Markt-Tick fehlgeschlagen: %s"):format(tostring(err)))
			end
		end
	end)

	print(("[GHOSTNET] MarketService bereit. %d Waren, Takt %ds."):format(
		Goods.Count(),
		Config.Market.TickSeconds
	))
end

return MarketService
</ProtectedString>
</Properties>
</Item>
<Item class="Folder" referent="GN25">
<Properties>
<string name="Name">Minigames</string>
</Properties>
<Item class="ModuleScript" referent="GN24">
<Properties>
<string name="Name">NodeBreach</string>
<ProtectedString name="Source">-- ServerScriptService/Systems/Minigames/NodeBreach.luau
--!strict
-- GHOSTNET :: Minispiel A - NODE-BREACH
--
-- SCHNITTSTELLE, an die sich JEDES Minispiel haelt (SignalMatch, CodeCrack,
-- IceBreaker kommen spaeter mit exakt diesen drei Funktionen):
--
--   Generate(difficulty, rng) -&gt; publicState, serverState
--       publicState  geht an den Client, enthaelt NIE etwas Geheimes.
--       serverState  bleibt auf dem Server.
--
--   Input(serverState, payload) -&gt; InputResult
--       Prueft eine einzelne Spielereingabe. Der Server entscheidet, ob sie
--       gilt, ob sie einen Versuch kostet und ob das Raetsel geloest ist.
--
--   Label() -&gt; string   (Anzeigename im Fake-OS)
--
-- SPIELREGELN
--   Vom START-Knoten einen zusammenhaengenden Pfad zum EXIT legen. Unterwegs
--   muessen ALLE Relay-Knoten mitgenommen werden. Sichtbares ICE ist
--   unpassierbar. Zusaetzlich steckt verstecktes ICE im Gitter - das sieht
--   aus wie ein freier Knoten und kostet beim Reintappen einen Versuch.
--   Genau dafuer ist das RAM-Upgrade da.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Types = require(ReplicatedStorage.Shared.Types)

type InputResult = Types.InputResult
type State = Types.NodeBreachState

local NodeBreach = {}

-- Zelltypen
local OPEN = 0
local ICE = 1
local RELAY = 2
local START = 3
local EXIT = 4
local MASKED = 5 -- nur serverseitig; der Client sieht hier OPEN

function NodeBreach.Label(): string
	return "NODE-BREACH"
end

--==========================================================================
-- Gitter-Helfer
--==========================================================================

local function toXY(idx: number, w: number): (number, number)
	local x = (idx - 1) % w + 1
	local y = math.floor((idx - 1) / w) + 1
	return x, y
end

local function toIdx(x: number, y: number, w: number): number
	return (y - 1) * w + x
end

local function neighbours(idx: number, w: number, h: number): { number }
	local x, y = toXY(idx, w)
	local out = {}
	if x &gt; 1 then
		table.insert(out, toIdx(x - 1, y, w))
	end
	if x &lt; w then
		table.insert(out, toIdx(x + 1, y, w))
	end
	if y &gt; 1 then
		table.insert(out, toIdx(x, y - 1, w))
	end
	if y &lt; h then
		table.insert(out, toIdx(x, y + 1, w))
	end
	return out
end

local function isAdjacent(a: number, b: number, w: number, h: number): boolean
	for _, n in neighbours(a, w, h) do
		if n == b then
			return true
		end
	end
	return false
end

local function manhattan(a: number, b: number, w: number): number
	local ax, ay = toXY(a, w)
	local bx, by = toXY(b, w)
	return math.abs(ax - bx) + math.abs(ay - by)
end

--==========================================================================
-- Pfadsuche
-- Zufaellige Tiefensuche mit Drang Richtung Exit. Findet immer einen Weg,
-- weil zu diesem Zeitpunkt noch jede Zelle frei ist.
--==========================================================================

local function shuffle(t: { number }, rng: Random)
	for i = #t, 2, -1 do
		local j = rng:NextInteger(1, i)
		t[i], t[j] = t[j], t[i]
	end
end

local function findPath(rng: Random, w: number, h: number, startIdx: number, exitIdx: number): { number }
	local visited: { [number]: boolean } = { [startIdx] = true }
	local stack: { number } = { startIdx }

	while #stack &gt; 0 do
		local cur = stack[#stack]
		if cur == exitIdx then
			return table.clone(stack)
		end

		local options = neighbours(cur, w, h)
		shuffle(options, rng)

		-- Meistens zuerst den Nachbarn probieren, der naeher am Exit liegt.
		-- Das haelt die Pfade brauchbar kurz, ohne sie berechenbar zu machen.
		if rng:NextNumber() &lt; 0.65 then
			table.sort(options, function(a, b)
				return manhattan(a, exitIdx, w) &lt; manhattan(b, exitIdx, w)
			end)
		end

		local moved = false
		for _, n in options do
			if not visited[n] then
				visited[n] = true
				table.insert(stack, n)
				moved = true
				break
			end
		end

		if not moved then
			table.remove(stack)
		end
	end

	return {}
end

local function tierFor(difficulty: number)
	for _, tier in Config.NodeBreach.Tiers do
		if difficulty &lt;= tier.MaxDifficulty then
			return tier
		end
	end
	return Config.NodeBreach.Tiers[#Config.NodeBreach.Tiers]
end

--==========================================================================
-- Generierung
--==========================================================================

function NodeBreach.Generate(difficulty: number, rng: Random): (Types.NodeBreachPublic, State)
	local tier = tierFor(difficulty)
	local w, h = tier.Width, tier.Height

	local startIdx = toIdx(1, h, w) -- unten links
	local exitIdx = toIdx(w, 1, w) -- oben rechts

	-- Mehrere Pfade erzeugen, den mit der angenehmsten Laenge behalten.
	local wanted = w + h + Config.NodeBreach.PathLengthBonus
	local best: { number } = {}
	local bestScore = math.huge
	for _ = 1, Config.NodeBreach.PathSearchTries do
		local candidate = findPath(rng, w, h, startIdx, exitIdx)
		if #candidate &gt; 0 then
			local score = math.abs(#candidate - wanted)
			if score &lt; bestScore then
				best, bestScore = candidate, score
			end
		end
	end

	-- Notnagel: gerade Treppe. Kann eigentlich nicht eintreten, aber ein
	-- leeres Gitter waere ein unloesbares Raetsel - das lassen wir nicht zu.
	if #best == 0 then
		best = { startIdx }
		local x, y = 1, h
		while x &lt; w do
			x += 1
			table.insert(best, toIdx(x, y, w))
		end
		while y &gt; 1 do
			y -= 1
			table.insert(best, toIdx(x, y, w))
		end
	end

	local inPath: { [number]: boolean } = {}
	for _, idx in best do
		inPath[idx] = true
	end

	-- Zellen anlegen
	local cells: { number } = table.create(w * h, OPEN)
	for i = 1, w * h do
		cells[i] = OPEN
	end

	-- Relays gleichmaessig auf dem Loesungspfad verteilen (ohne Start/Exit).
	local interior = #best - 2
	local relayCount = math.clamp(tier.Relays, 0, math.max(0, interior))
	for r = 1, relayCount do
		local pos = math.floor(r * (interior + 1) / (relayCount + 1)) + 1
		pos = math.clamp(pos, 2, #best - 1)
		local idx = best[pos]
		if cells[idx] == RELAY then
			-- Kollision: naechsten freien Pfadknoten nehmen.
			for k = pos + 1, #best - 1 do
				if cells[best[k]] ~= RELAY then
					idx = best[k]
					break
				end
			end
		end
		cells[idx] = RELAY
	end
	-- tatsaechlich gesetzte Relays zaehlen
	local relayTotal = 0
	for _, v in cells do
		if v == RELAY then
			relayTotal += 1
		end
	end

	-- ICE neben dem Pfad streuen.
	for i = 1, w * h do
		if not inPath[i] then
			local roll = rng:NextNumber()
			if roll &lt; tier.Ice then
				cells[i] = ICE
			elseif roll &lt; tier.Ice + tier.MaskedIce then
				cells[i] = MASKED
			end
		end
	end

	cells[startIdx] = START
	cells[exitIdx] = EXIT

	local state: State = {
		Width = w,
		Height = h,
		Cells = cells,
		Start = startIdx,
		Exit = exitIdx,
		RelayTotal = relayTotal,
		RelaysVisited = 0,
		Path = { startIdx },
		InPath = { [startIdx] = true },
		Revealed = {},
		Solution = best,
	}

	-- Oeffentliche Sicht: verstecktes ICE als freier Knoten getarnt.
	local publicCells = table.create(w * h, OPEN)
	for i = 1, w * h do
		publicCells[i] = if cells[i] == MASKED then OPEN else cells[i]
	end

	local public: Types.NodeBreachPublic = {
		Width = w,
		Height = h,
		Cells = publicCells,
		Start = startIdx,
		Exit = exitIdx,
		Relays = relayTotal,
	}

	return public, state
end

--==========================================================================
-- Eingabe
--==========================================================================

local function result(ok: boolean, reason: string, costs: boolean, solved: boolean, feedback: { [string]: any }): InputResult
	return { Ok = ok, Reason = reason, CostsAttempt = costs, Solved = solved, Feedback = feedback }
end

function NodeBreach.Input(state: State, payload: any): InputResult
	-- Payload-Form pruefen. Alles, was nicht exakt passt, fliegt raus.
	if typeof(payload) ~= "table" then
		return result(false, "BAD_PAYLOAD", false, false, {})
	end
	local node = (payload :: any).Node
	if typeof(node) ~= "number" or node ~= node or node % 1 ~= 0 then
		return result(false, "BAD_PAYLOAD", false, false, {})
	end
	local total = state.Width * state.Height
	if node &lt; 1 or node &gt; total then
		return result(false, "BAD_PAYLOAD", false, false, {})
	end

	local head = state.Path[#state.Path]

	local function pack(extra: { [string]: any }?): { [string]: any }
		local f: { [string]: any } = {
			Path = table.clone(state.Path),
			RelaysLeft = state.RelayTotal - state.RelaysVisited,
		}
		if extra then
			for k, v in extra do
				f[k] = v
			end
		end
		return f
	end

	-- Zurueckgehen: auf den vorletzten Knoten klicken nimmt den letzten weg.
	if #state.Path &gt;= 2 and node == state.Path[#state.Path - 1] then
		local removed = table.remove(state.Path) :: number
		state.InPath[removed] = nil
		if state.Cells[removed] == RELAY then
			state.RelaysVisited -= 1
		end
		return result(true, "BACKTRACK", false, false, pack())
	end

	if node == head then
		return result(false, "ALREADY_HERE", false, false, pack())
	end

	if not isAdjacent(head, node, state.Width, state.Height) then
		return result(false, "NOT_ADJACENT", false, false, pack())
	end

	if state.InPath[node] then
		return result(false, "REVISIT", false, false, pack())
	end

	local cell = state.Cells[node]

	if cell == ICE then
		return result(false, "ICE", false, false, pack())
	end

	-- Verstecktes ICE: der einzige Fall, der einen Versuch kostet.
	if cell == MASKED then
		state.Cells[node] = ICE
		state.Revealed[node] = true
		return result(false, "MASKED_ICE", true, false, pack({ Reveal = node }))
	end

	if cell == EXIT then
		if state.RelaysVisited &lt; state.RelayTotal then
			return result(false, "RELAYS_MISSING", false, false, pack())
		end
		table.insert(state.Path, node)
		state.InPath[node] = true
		return result(true, "SOLVED", false, true, pack())
	end

	table.insert(state.Path, node)
	state.InPath[node] = true
	if cell == RELAY then
		state.RelaysVisited += 1
	end

	return result(true, "OK", false, false, pack({ Relay = cell == RELAY }))
end

return NodeBreach
</ProtectedString>
</Properties>
</Item>
</Item>
<Item class="ModuleScript" referent="GN26">
<Properties>
<string name="Name">MissionService</string>
<ProtectedString name="Source">-- ServerScriptService/Systems/MissionService.luau
--!strict
-- GHOSTNET :: Das Missions-Rueckgrat.
--
-- WAS ER TUT
--   Haelt pro Spieler die aktive Mission und den Schritt-Index IM PROFIL,
--   prueft serverseitig, ob ein Schritt erfuellt ist, und schaltet beim
--   Abschluss dauerhafte Unlocks frei.
--
-- WAS ER NICHT TUT
--   Er kennt keine einzelne Mission. Missionsinhalte stehen als Daten in
--   Shared/Missions.luau; die Regeln dazu sind dort pur und ohne Roblox
--   pruefbar. Dieses Modul ist nur die Mechanik drumherum.
--
-- SERVER-AUTORITAET
--   Der Client meldet NIE "Schritt fertig". Er darf genau drei Dinge sagen:
--   "ich nehme Mission X an", "ich breche ab", "ich spreche Kontakt Y an".
--   Alles andere leitet der Server aus dem ab, was ohnehin schon passiert:
--   geloeste Hacks, Verkaeufe, Distanz zu Wegpunkten, Ablauf von Wartezeiten.
--
-- KEIN REQUIRE-KREIS
--   HackService und SellService kennen den MissionService nicht. Er meldet
--   sich bei ihnen per OnHackResolved / OnSell an - dasselbe Muster, das
--   TraceService.OnBust bereits vormacht.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Geometry = require(ReplicatedStorage.Shared.Geometry)
local Missions = require(ReplicatedStorage.Shared.Missions)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Types = require(ReplicatedStorage.Shared.Types)

local EconomyService = require(script.Parent.EconomyService)
local HackService = require(script.Parent.HackService)
local HackTargets = require(script.Parent.HackTargets)
local RateLimiter = require(script.Parent.RateLimiter)
local SaveService = require(script.Parent.SaveService)
local SellService = require(script.Parent.SellService)

type Mission = Missions.Mission
type Step = Missions.Step
type Story = Types.Story

local MissionService = {}

-- Damit der Marker nicht jeden Takt neu geschickt wird.
local lastMarker: { [Player]: string } = {}

-- Wer mitbekommen will, dass eine Mission fertig ist (Phase B fuer das
-- Tutorial, Phase C fuer Darknet-Freischaltungen).
local completeCallbacks: { (Player, Mission) -&gt; () } = {}

function MissionService.OnMissionComplete(callback: (Player, Mission) -&gt; ())
	table.insert(completeCallbacks, callback)
end

--==========================================================================
-- Zugriff aufs Profil
--==========================================================================

local function storyOf(player: Player): Story?
	local profile = SaveService.Get(player)
	return if profile then profile.Story else nil
end

local function activeMission(story: Story): Mission?
	if story.Active == "" then
		return nil
	end
	return Missions.Get(story.Active)
end

local function currentStep(mission: Mission, story: Story): Step?
	return mission.Steps[story.Step]
end

--==========================================================================
-- Die Entscheidung aus Mission 10
--
-- "CASH"  = bei Meridian anheuern. Halber Trace-Anstieg, aber weniger Beute.
-- "BURN"  = alles veroeffentlichen. Mehr Ertrag, haerteres Spiel.
--
-- Einmal pro Woche umstellbar. Ohne das fuehlen sich Spieler eingesperrt und
-- hoeren auf.
--==========================================================================

function MissionService.GetAllegiance(player: Player): string
	local story = storyOf(player)
	return if story then story.Allegiance else ""
end

-- Faktoren, die andere Services abfragen. Sie liegen hier, weil die
-- Entscheidung Teil der Story ist.
function MissionService.TraceFactor(player: Player): number
	return if MissionService.GetAllegiance(player) == "CASH" then Config.Endgame.CashTraceFactor else 1
end

function MissionService.RewardFactor(player: Player): number
	local choice = MissionService.GetAllegiance(player)
	if choice == "CASH" then
		return Config.Endgame.CashRewardFactor
	elseif choice == "BURN" then
		return Config.Endgame.BurnRewardFactor
	end
	return 1
end

function MissionService.PursuitFactor(player: Player): number
	return if MissionService.GetAllegiance(player) == "BURN" then Config.Endgame.BurnPursuitFactor else 1
end

local function onEndgameChoice(player: Player, payload: any)
	if not RateLimiter.Check(player, "EndgameChoice") then
		return
	end
	if typeof(payload) ~= "table" then
		return
	end
	local choice = (payload :: any).Choice
	if choice ~= "CASH" and choice ~= "BURN" then
		return
	end

	local story = storyOf(player)
	if not story then
		return
	end
	-- Erst nach Mission 10 waehlbar.
	if not Missions.HasUnlock(story, "ENDGAME") then
		return
	end

	local now = os.time()
	if story.Allegiance ~= "" and now - story.AllegianceAt &lt; Config.Endgame.SwitchCooldown then
		MissionService.Sync(player)
		return
	end

	story.Allegiance = choice
	story.AllegianceAt = now
	SaveService.RequestSave(player)
	MissionService.Sync(player)
	print(("[GHOSTNET] %s hat sich fuer '%s' entschieden."):format(player.Name, choice))
end

-- Fuer Phase B und C: "darf der Spieler Ladenueberfaelle / das Darknet?"
function MissionService.HasUnlock(player: Player, key: string): boolean
	local story = storyOf(player)
	if not story then
		return false
	end
	return Missions.HasUnlock(story, key)
end

function MissionService.IsCompleted(player: Player, missionId: string): boolean
	local story = storyOf(player)
	if not story then
		return false
	end
	return Missions.IsCompleted(story, missionId)
end

--==========================================================================
-- Weltobjekte zu einem Schritt finden
--==========================================================================

local function taggedPartWithAttribute(tag: string, attribute: string, value: string): BasePart?
	for _, inst in CollectionService:GetTagged(tag) do
		if inst:IsA("BasePart") and inst:IsDescendantOf(workspace) and inst:GetAttribute(attribute) == value then
			return inst
		end
	end
	return nil
end

function MissionService.FindWaypoint(id: string): BasePart?
	return taggedPartWithAttribute(Config.WaypointTag, "WaypointId", id)
end

function MissionService.FindContact(id: string): BasePart?
	return taggedPartWithAttribute(Config.ContactTag, "ContactId", id)
end

-- Wohin der Marker im HUD zeigen soll. nil = kein Marker fuer diesen Schritt.
local function markerFor(player: Player, step: Step): (Vector3?, string)
	if step.Type == "GOTO" and step.Target then
		local part = MissionService.FindWaypoint(step.Target)
		return (if part then part.Position else nil), step.Text
	elseif step.Type == "HACK" and step.TargetId then
		local target = HackTargets.Get(step.TargetId)
		return (if target and target.Part.Parent then target.Part.Position else nil), step.Text
	elseif step.Type == "TALK" and step.ContactId then
		local part = MissionService.FindContact(step.ContactId)
		return (if part then part.Position else nil), step.Text
	elseif step.Type == "SELL" then
		local fence = SellService.NearestFence(player)
		return (if fence then fence.Position else nil), step.Text
	end
	return nil, step.Text
end

--==========================================================================
-- An den Client schicken
--==========================================================================

local function syncWaypoint(player: Player, step: Step?)
	if not player.Parent then
		return
	end

	local position: Vector3? = nil
	local label = ""
	if step then
		position, label = markerFor(player, step)
	end

	-- Nur bei echter Aenderung senden, sonst laeuft der Takt als Paketflut.
	local key = if position then ("%d|%d|%d|%s"):format(position.X, position.Y, position.Z, label) else ""
	if lastMarker[player] == key then
		return
	end
	lastMarker[player] = key

	Remotes.WaypointSync:FireClient(player, {
		Position = position,
		Label = label,
	})
end

function MissionService.Sync(player: Player)
	if not player.Parent then
		return
	end
	local story = storyOf(player)
	if not story then
		return
	end

	local mission = activeMission(story)
	if not mission then
		local available = Missions.FirstAvailable(story)
		Remotes.MissionSync:FireClient(player, {
			Active = "",
			Completed = table.clone(story.Completed),
			Unlocks = table.clone(story.Unlocks),
			Available = if available then available.Id else "",
			AvailableTitle = if available then available.Title else "",
			Allegiance = story.Allegiance,
			AllegianceSwitchIn = math.max(
				0,
				Config.Endgame.SwitchCooldown - (os.time() - story.AllegianceAt)
			),
		})
		syncWaypoint(player, nil)
		return
	end

	local step = currentStep(mission, story)
	local texts: { string } = {}
	for _, entry in mission.Steps do
		table.insert(texts, entry.Text)
	end

	Remotes.MissionSync:FireClient(player, {
		Active = mission.Id,
		Title = mission.Title,
		Briefing = mission.Briefing,
		StepIndex = story.Step,
		StepCount = #mission.Steps,
		StepText = if step then step.Text else "",
		StepType = if step then step.Type else "",
		StepProgress = story.StepProgress,
		StepRequired = if step then Missions.Required(step) else 1,
		StepSeconds = if step and step.Type == "WAIT" then step.Seconds else nil,
		StepStartedAt = story.StepStartedAt,
		ContactId = if step then step.ContactId else nil,
		Steps = texts,
		Completed = table.clone(story.Completed),
		Unlocks = table.clone(story.Unlocks),
		Allegiance = story.Allegiance,
		AllegianceSwitchIn = math.max(
			0,
			Config.Endgame.SwitchCooldown - (os.time() - story.AllegianceAt)
		),
	})

	syncWaypoint(player, step)
end

--==========================================================================
-- Missionen starten und abschliessen
--==========================================================================

local startMission: (Player, Story, string) -&gt; boolean

local function completeMission(player: Player, story: Story, mission: Mission)
	if not Missions.IsCompleted(story, mission.Id) then
		table.insert(story.Completed, mission.Id)
	end
	story.Active = ""
	story.Step = 1
	story.StepProgress = 0
	story.StepStartedAt = 0

	local reward = mission.Reward
	if typeof(reward) == "table" then
		local crypto = reward.Crypto
		if typeof(crypto) == "number" and crypto &gt; 0 then
			-- Standard: die Belohnung ist heiss und muss erst zum Hehler.
			-- Das haelt den Verkaufs-Loop auch bei Story-Geld relevant.
			-- Einzelne Missionen duerfen das ueber Reward.ToBank ueberstimmen.
			local toBank = if reward.ToBank ~= nil then reward.ToBank else Config.Mission.RewardToBank
			if toBank then
				EconomyService.AwardBanked(player, crypto)
			else
				EconomyService.AwardUnsold(player, crypto)
			end
		end
		local unlock = reward.Unlock
		if typeof(unlock) == "string" and unlock ~= "" and not Missions.HasUnlock(story, unlock) then
			table.insert(story.Unlocks, unlock)
		end
	end

	print(("[GHOSTNET] %s hat Mission '%s' abgeschlossen."):format(player.Name, mission.Id))
	SaveService.RequestSave(player)

	for _, callback in completeCallbacks do
		task.spawn(function()
			local ok, err = pcall(callback, player, mission)
			if not ok then
				warn(("[GHOSTNET] OnMissionComplete-Callback fehlgeschlagen: %s"):format(tostring(err)))
			end
		end)
	end

	-- Direkt die naechste anbieten, damit die Story nicht stehen bleibt.
	if Config.Mission.AutoStart then
		local next_ = Missions.FirstAvailable(story)
		if next_ then
			startMission(player, story, next_.Id)
			return
		end
	end

	MissionService.Sync(player)
end

startMission = function(player: Player, story: Story, missionId: string): boolean
	if not Missions.IsAvailable(story, missionId) then
		return false
	end
	story.Active = missionId
	story.Step = 1
	story.StepProgress = 0
	story.StepStartedAt = os.time()
	lastMarker[player] = nil
	SaveService.RequestSave(player)
	MissionService.Sync(player)
	return true
end

local function advance(player: Player, story: Story, mission: Mission)
	story.Step += 1
	story.StepProgress = 0
	story.StepStartedAt = os.time()
	lastMarker[player] = nil

	if story.Step &gt; #mission.Steps then
		completeMission(player, story, mission)
	else
		SaveService.RequestSave(player)
		MissionService.Sync(player)
	end
end

--==========================================================================
-- Ereignisse verarbeiten
-- Der einzige Weg, wie ein Schritt vorankommt. Ob ein Ereignis passt,
-- entscheidet Missions.Progress - pur und im Testlauf abgedeckt.
--==========================================================================

local function applyEvent(player: Player, event: { [string]: any })
	local story = storyOf(player)
	if not story then
		return
	end
	local mission = activeMission(story)
	if not mission then
		return
	end
	local step = currentStep(mission, story)
	if not step then
		-- Kaputter Index (z.B. Mission nachtraeglich gekuerzt): sauber beenden,
		-- statt den Spieler in einer toten Mission haengen zu lassen.
		completeMission(player, story, mission)
		return
	end

	local gain = Missions.Progress(step, event)
	if gain &lt;= 0 then
		return
	end

	story.StepProgress += gain
	if story.StepProgress &gt;= Missions.Required(step) then
		advance(player, story, mission)
	else
		SaveService.RequestSave(player)
		MissionService.Sync(player)
	end
end

-- Oeffentlicher Haken fuer Phase C: der InventoryService meldet Kaeufe hier,
-- statt dass dieses Modul ihn requiret.
function MissionService.NotifyBuy(player: Player, goodId: string, amount: number)
	if typeof(goodId) ~= "string" or typeof(amount) ~= "number" or amount &lt;= 0 then
		return
	end
	applyEvent(player, { Type = "BUY", GoodId = goodId, Amount = math.floor(amount) })
end

--==========================================================================
-- Remote-Handler
--==========================================================================

local function onAccept(player: Player, payload: any)
	if not RateLimiter.Check(player, "MissionAccept") then
		return
	end
	if typeof(payload) ~= "table" then
		return
	end
	local missionId = (payload :: any).MissionId
	if typeof(missionId) ~= "string" or missionId == "" or #missionId &gt; 48 then
		return
	end

	local story = storyOf(player)
	if not story then
		return
	end
	if story.Active ~= "" then
		MissionService.Sync(player) -- laeuft schon eine; Client neu ausrichten
		return
	end

	if not startMission(player, story, missionId) then
		MissionService.Sync(player)
	end
end

local function onAbandon(player: Player, payload: any)
	if not RateLimiter.Check(player, "MissionAbandon") then
		return
	end
	if payload ~= nil and typeof(payload) ~= "table" then
		return
	end
	local story = storyOf(player)
	if not story or story.Active == "" then
		return
	end

	story.Active = ""
	story.Step = 1
	story.StepProgress = 0
	story.StepStartedAt = 0
	lastMarker[player] = nil
	SaveService.RequestSave(player)
	MissionService.Sync(player)
end

-- Ueberspringen ist NICHT dasselbe wie Abbrechen: die Mission gilt als
-- erledigt und der Unlock wird vergeben, nur die Crypto-Belohnung entfaellt.
-- Sonst wuerde ein uebersprungenes Tutorial den Spieler dauerhaft von dem
-- System aussperren, das es freischalten sollte.
local function onSkip(player: Player, payload: any)
	if not RateLimiter.Check(player, "MissionSkip") then
		return
	end
	if payload ~= nil and typeof(payload) ~= "table" then
		return
	end

	local story = storyOf(player)
	if not story or story.Active == "" then
		return
	end
	local mission = activeMission(story)
	if not mission or not Config.Mission.Skippable[mission.Id] then
		return
	end

	if not Missions.IsCompleted(story, mission.Id) then
		table.insert(story.Completed, mission.Id)
	end
	local unlock = mission.Reward and mission.Reward.Unlock
	if typeof(unlock) == "string" and unlock ~= "" and not Missions.HasUnlock(story, unlock) then
		table.insert(story.Unlocks, unlock)
	end

	story.Active = ""
	story.Step = 1
	story.StepProgress = 0
	story.StepStartedAt = 0
	lastMarker[player] = nil

	print(("[GHOSTNET] %s hat Mission '%s' uebersprungen."):format(player.Name, mission.Id))
	SaveService.RequestSave(player)

	if Config.Mission.AutoStart then
		local next_ = Missions.FirstAvailable(story)
		if next_ and startMission(player, story, next_.Id) then
			return
		end
	end
	MissionService.Sync(player)
end

local function onInteract(player: Player, payload: any)
	if not RateLimiter.Check(player, "MissionInteract") then
		return
	end
	if typeof(payload) ~= "table" then
		return
	end
	local contactId = (payload :: any).ContactId
	if typeof(contactId) ~= "string" or contactId == "" or #contactId &gt; 48 then
		return
	end

	local part = MissionService.FindContact(contactId)
	if not part then
		return
	end

	-- Distanz serverseitig, wie ueberall sonst auch.
	local position = Geometry.AlivePosition(player)
	if not position then
		return
	end
	local distance = Geometry.SurfaceDistance(part, position)
	if distance &gt; Config.Mission.ContactRange + Config.Mission.ContactTolerance then
		return
	end

	applyEvent(player, { Type = "TALK", ContactId = contactId })
end

--==========================================================================
-- Takt: GOTO-Distanz und WAIT-Timer
-- Beides kann der Client nicht melden, also schaut der Server selbst nach.
--==========================================================================

local function tick()
	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator &lt; Config.Mission.TickSeconds then
			return
		end
		accumulator = 0

		for _, player in Players:GetPlayers() do
			local story = storyOf(player)
			if not story then
				continue
			end
			local mission = activeMission(story)
			if not mission then
				continue
			end
			local step = currentStep(mission, story)
			if not step then
				continue
			end

			if step.Type == "WAIT" then
				local seconds = step.Seconds or 0
				if story.StepStartedAt &gt; 0 and os.time() - story.StepStartedAt &gt;= seconds then
					applyEvent(player, { Type = "WAIT" })
				end
			elseif step.Type == "GOTO" and step.Target then
				local part = MissionService.FindWaypoint(step.Target)
				local position = Geometry.AlivePosition(player)
				if part and position then
					local distance = Geometry.SurfaceDistance(part, position)
					if distance &lt;= Config.Mission.WaypointRange + Config.Mission.WaypointTolerance then
						applyEvent(player, { Type = "GOTO", WaypointId = step.Target })
					end
				end
			end

			-- Der Marker kann sich bewegen (Hehler in der Naehe, Ziel-Part neu
			-- registriert), deshalb bei jedem Takt nachziehen. syncWaypoint
			-- sendet nur, wenn sich wirklich etwas geaendert hat.
			syncWaypoint(player, step)
		end
	end)
end

--==========================================================================

function MissionService.Init()
	-- Datenfehler sollen beim Hochfahren auffallen, nicht wenn ein Spieler
	-- in einer kaputten Mission feststeckt.
	local valid, errors = Missions.Validate(nil, Config.Mission.MaxSteps)
	if not valid then
		for _, message in errors do
			warn(("[GHOSTNET] Missionsdaten: %s"):format(message))
		end
	end

	HackService.OnHackResolved(function(player, data)
		applyEvent(player, {
			Type = "HACK",
			TargetId = data.TargetId,
			Success = data.Success,
		})
	end)

	SellService.OnSell(function(player, data)
		applyEvent(player, { Type = "SELL", Net = data.Net })
	end)

	Remotes.MissionAccept.OnServerEvent:Connect(onAccept)
	Remotes.MissionAbandon.OnServerEvent:Connect(onAbandon)
	Remotes.MissionInteract.OnServerEvent:Connect(onInteract)
	Remotes.MissionSkip.OnServerEvent:Connect(onSkip)
	Remotes.EndgameChoice.OnServerEvent:Connect(onEndgameChoice)

	-- Die Endgame-Faktoren melden sich beim HackService AN, statt dass der
	-- HackService hier nachfragt. Sonst haetten die beiden einen Kreis.
	HackService.AddTraceModifier(MissionService.TraceFactor)
	HackService.AddRewardModifier(MissionService.RewardFactor)

	SaveService.OnReady(function(player, profile)
		lastMarker[player] = nil
		local story = profile.Story

		-- Aktive Mission zeigt auf etwas, das es nicht mehr gibt (Mission
		-- umbenannt oder entfernt): stillschweigend loesen statt crashen.
		if story.Active ~= "" and not Missions.Get(story.Active) then
			warn(("[GHOSTNET] %s hatte die unbekannte Mission '%s' aktiv - zurueckgesetzt."):format(
				player.Name,
				story.Active
			))
			story.Active = ""
			story.Step = 1
			story.StepProgress = 0
		end

		if Config.Mission.AutoStart and story.Active == "" then
			local next_ = Missions.FirstAvailable(story)
			if next_ then
				startMission(player, story, next_.Id)
				return
			end
		end

		MissionService.Sync(player)
	end)

	Players.PlayerRemoving:Connect(function(player)
		lastMarker[player] = nil
	end)

	tick()

	print(("[GHOSTNET] MissionService bereit. %d Missionen registriert%s."):format(
		Missions.Count(),
		if valid then "" else " (mit Datenfehlern, siehe oben)"
	))
end

return MissionService
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="GN27">
<Properties>
<string name="Name">MonetizationService</string>
<ProtectedString name="Source">-- ServerScriptService/Systems/MonetizationService.luau
--!strict
-- GHOSTNET :: Gamepaesse und Entwicklerprodukte.
--
-- WAS NICHT VERKAUFT WIRD
--   Nichts, das ein Raetsel loest. Keine Auto-Solves, keine Loesungshinweise.
--   Die einzige Faehigkeit, um die es in diesem Spiel geht, darf nicht
--   kaufbar sein. Nichts, das anderen Spielern schadet.
--   Erlaubt sind: Zeitersparnis, Kosmetik, Komfort, Kapazitaet.
--
-- DOPPELVERGABE
--   Roblox liefert einen Beleg WIEDERHOLT aus, solange der Server nicht
--   bestaetigt hat. Deshalb: verarbeitete PurchaseId im Profil merken, erst
--   gutschreiben UND speichern, dann PurchaseGranted zurueckgeben. Kommt
--   derselbe Beleg nochmal, wird sofort PurchaseGranted gemeldet, ohne
--   nochmal zu vergeben.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local EconomyService = require(script.Parent.EconomyService)
local RateLimiter = require(script.Parent.RateLimiter)
local SaveService = require(script.Parent.SaveService)
local TraceService = require(script.Parent.TraceService)

local MonetizationService = {}

--==========================================================================
-- ALLE IDs SIND 0 UND MUESSEN VON NOAH IM CREATOR DASHBOARD ANGELEGT UND
-- HIER EINGETRAGEN WERDEN. ERFINDE KEINE IDs - eine falsche ID schlaegt
-- stumm fehl und ist schwer zu finden.
--
-- Gamepass anlegen:  Creator Dashboard -&gt; Spiel -&gt; Monetization -&gt; Passes
-- Produkt anlegen:   Creator Dashboard -&gt; Spiel -&gt; Monetization -&gt; Developer Products
-- Die Zahl aus der Adresszeile ist die ID.
--==========================================================================

local IDS = {
	Gamepass = {
		ColdRig = 0, -- dauerhaft -25 % Trace-Anstieg
		BigStash = 0, -- +50 % Lagerplatz im Darknet
		VIPTerminal = 0, -- kosmetische Terminal-Themes
		ExtraSlot = 0, -- zweite parallele Mission
	},
	Product = {
		Crypto1k = 0,
		Crypto5k = 0,
		TraceReset = 0, -- Trace sofort auf 0
		CooldownWipe = 0, -- alle Ziel-Cooldowns loeschen
	},
}

MonetizationService.IDS = IDS

-- Was ein Pass bzw. Produkt bewirkt und kostet. Die Zahlen stehen in Config,
-- die Texte hier, weil sie zum Produkt gehoeren und nicht zum Balancing.
local PASS_INFO: { [string]: { Name: string, Text: string } } = {
	ColdRig = {
		Name = "COLD RIG",
		Text = ("Dauerhaft %d%% weniger Trace pro Hack."):format(math.floor(Config.Monetization.ColdRigTrace * 100)),
	},
	BigStash = {
		Name = "BIG STASH",
		Text = ("%d%% mehr Lagerplatz im Darknet."):format(math.floor(Config.Monetization.BigStashBonus * 100)),
	},
	VIPTerminal = { Name = "VIP TERMINAL", Text = "Kosmetische Terminal-Themes. Kein Spielvorteil." },
	ExtraSlot = { Name = "ZWEITER AUFTRAG", Text = "Ein zweiter Auftrag parallel." },
}

local PRODUCT_INFO: { [string]: { Name: string, Text: string } } = {
	Crypto1k = { Name = "1.000 CRY", Text = "Direkt auf die Bank." },
	Crypto5k = { Name = "5.000 CRY", Text = "Direkt auf die Bank." },
	TraceReset = { Name = "SPUR LOESCHEN", Text = "Trace sofort auf 0. Loest kein Raetsel." },
	CooldownWipe = { Name = "COOLDOWNS LOESCHEN", Text = "Alle Ziele sofort wieder frei." },
}

--==========================================================================
-- Besitz von Gamepaessen
--==========================================================================

-- Cache pro Spieler. UserOwnsGamePassAsync ist teuer und kann fehlschlagen -
-- bei einem Fehler darf NICHT angenommen werden, der Spieler besitze nichts.
local owned: { [Player]: { [string]: boolean } } = {}
local checkFailed: { [Player]: { [string]: boolean } } = {}

function MonetizationService.Owns(player: Player, passKey: string): boolean
	local perPlayer = owned[player]
	return perPlayer ~= nil and perPlayer[passKey] == true
end

local function checkPass(player: Player, passKey: string, id: number)
	if id == 0 then
		return -- noch nicht im Dashboard angelegt
	end

	for attempt = 1, Config.Monetization.OwnershipRetries do
		local ok, result = pcall(function()
			return MarketplaceService:UserOwnsGamePassAsync(player.UserId, id)
		end)
		if ok then
			local perPlayer = owned[player]
			if perPlayer then
				perPlayer[passKey] = result == true
			end
			if checkFailed[player] then
				checkFailed[player][passKey] = nil
			end
			return
		end
		warn(("[GHOSTNET] Besitzpruefung '%s' fuer %s fehlgeschlagen (%d/%d): %s"):format(
			passKey,
			player.Name,
			attempt,
			Config.Monetization.OwnershipRetries,
			tostring(result)
		))
		task.wait(Config.Monetization.OwnershipRetryDelay * attempt)
	end

	-- Endgueltig gescheitert: gemerkt, damit ein spaeterer Versuch es
	-- nachholt. NICHT als "besitzt nichts" behandeln.
	if checkFailed[player] then
		checkFailed[player][passKey] = true
	end
end

local function checkAllPasses(player: Player)
	owned[player] = owned[player] or {}
	checkFailed[player] = checkFailed[player] or {}
	for key, id in IDS.Gamepass do
		task.spawn(checkPass, player, key, id)
	end
end

--==========================================================================
-- Effekte der Paesse
-- Alle laufen ueber EconomyService bzw. SaveService, nirgends direkt.
--==========================================================================

-- Wird vom HackService ueber Config gelesen; hier nur die Abfrage.
function MonetizationService.TraceFactor(player: Player): number
	if MonetizationService.Owns(player, "ColdRig") then
		return 1 - Config.Monetization.ColdRigTrace
	end
	return 1
end

function MonetizationService.StashBonus(player: Player): number
	if MonetizationService.Owns(player, "BigStash") then
		return Config.Monetization.BigStashBonus
	end
	return 0
end

--==========================================================================
-- Produkte
--==========================================================================

local function grantProduct(player: Player, productKey: string): boolean
	if productKey == "Crypto1k" then
		EconomyService.AwardBanked(player, Config.Monetization.Crypto1k)
		return true
	elseif productKey == "Crypto5k" then
		EconomyService.AwardBanked(player, Config.Monetization.Crypto5k)
		return true
	elseif productKey == "TraceReset" then
		local profile = SaveService.Get(player)
		if not profile then
			return false
		end
		profile.Trace = 0
		TraceService.Sync(player, true)
		return true
	elseif productKey == "CooldownWipe" then
		local profile = SaveService.Get(player)
		if not profile then
			return false
		end
		table.clear(profile.Cooldowns)
		EconomyService.Sync(player)
		return true
	end
	return false
end

local function productKeyFor(productId: number): string?
	for key, id in IDS.Product do
		if id ~= 0 and id == productId then
			return key
		end
	end
	return nil
end

--==========================================================================
-- ProcessReceipt - der Teil, den man nicht falsch machen darf
--==========================================================================

local function processReceipt(receiptInfo: any): Enum.ProductPurchaseDecision
	local userId = receiptInfo.PlayerId
	local purchaseId = tostring(receiptInfo.PurchaseId)
	local player = Players:GetPlayerByUserId(userId)

	if not player then
		-- Spieler ist weg. NICHT bestaetigen - Roblox liefert den Beleg beim
		-- naechsten Join erneut aus, und dann bekommt er seine Ware.
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local profile = SaveService.Get(player)
	if not profile then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	-- Schon verarbeitet? Dann sofort bestaetigen, ohne nochmal zu vergeben.
	if table.find(profile.PurchaseLog, purchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end

	local key = productKeyFor(receiptInfo.ProductId)
	if not key then
		warn(("[GHOSTNET] Unbekanntes Produkt %s gekauft - Beleg bleibt offen."):format(
			tostring(receiptInfo.ProductId)
		))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local ok, granted = pcall(grantProduct, player, key)
	if not ok or not granted then
		warn(("[GHOSTNET] Produkt '%s' konnte nicht vergeben werden: %s"):format(key, tostring(granted)))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	-- Erst merken, dann speichern, dann bestaetigen.
	table.insert(profile.PurchaseLog, purchaseId)
	while #profile.PurchaseLog &gt; Config.Monetization.PurchaseLogLimit do
		table.remove(profile.PurchaseLog, 1)
	end

	local saved = SaveService.SaveNow(player)
	if not saved then
		-- Nicht bestaetigen: sonst waere die Ware vergeben, aber nicht
		-- gespeichert - beim naechsten Join waere sie weg und der Beleg
		-- verbraucht.
		warn(("[GHOSTNET] Kauf '%s' konnte nicht gespeichert werden - Beleg bleibt offen."):format(key))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	print(("[GHOSTNET] Kauf vergeben: %s an %s (Beleg %s)"):format(key, player.Name, purchaseId))
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

--==========================================================================
-- Anzeige
--==========================================================================

function MonetizationService.Sync(player: Player)
	if not player.Parent then
		return
	end

	local passes: { { [string]: any } } = {}
	for key, id in IDS.Gamepass do
		local info = PASS_INFO[key]
		table.insert(passes, {
			Key = key,
			Id = id,
			Name = if info then info.Name else key,
			Text = if info then info.Text else "",
			Owned = MonetizationService.Owns(player, key),
			Available = id ~= 0,
		})
	end

	local products: { { [string]: any } } = {}
	for key, id in IDS.Product do
		local info = PRODUCT_INFO[key]
		table.insert(products, {
			Key = key,
			Id = id,
			Name = if info then info.Name else key,
			Text = if info then info.Text else "",
			Available = id ~= 0,
		})
	end

	table.sort(passes, function(a, b)
		return (a.Key :: string) &lt; (b.Key :: string)
	end)
	table.sort(products, function(a, b)
		return (a.Key :: string) &lt; (b.Key :: string)
	end)

	Remotes.StoreSync:FireClient(player, { Passes = passes, Products = products })
end

--==========================================================================

-- Der Client bittet nur um den Dialog. Was er kostet und ob er zustande
-- kommt, entscheidet Roblox; was er bewirkt, entscheidet ProcessReceipt.
local function onPrompt(player: Player, payload: any)
	if not RateLimiter.Check(player, "StorePrompt") then
		return
	end
	if typeof(payload) ~= "table" then
		return
	end
	local kind = (payload :: any).Kind
	local key = (payload :: any).Key
	if typeof(key) ~= "string" then
		return
	end

	if kind == "Gamepass" then
		local id = (IDS.Gamepass :: any)[key]
		if typeof(id) == "number" and id ~= 0 then
			pcall(function()
				MarketplaceService:PromptGamePassPurchase(player, id)
			end)
		end
	elseif kind == "Product" then
		local id = (IDS.Product :: any)[key]
		if typeof(id) == "number" and id ~= 0 then
			pcall(function()
				MarketplaceService:PromptProductPurchase(player, id)
			end)
		end
	end
end

function MonetizationService.Init()
	Remotes.StorePrompt.OnServerEvent:Connect(onPrompt)

	MarketplaceService.ProcessReceipt = function(receiptInfo)
		local ok, decision = pcall(processReceipt, receiptInfo)
		if not ok then
			warn(("[GHOSTNET] ProcessReceipt ist abgestuerzt: %s"):format(tostring(decision)))
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		return decision
	end

	-- Live-Aktivierung ohne Rejoin.
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, gamePassId, wasPurchased)
		if not wasPurchased then
			return
		end
		for key, id in IDS.Gamepass do
			if id ~= 0 and id == gamePassId then
				local perPlayer = owned[player]
				if perPlayer then
					perPlayer[key] = true
				end
				print(("[GHOSTNET] %s besitzt jetzt %s."):format(player.Name, key))
				MonetizationService.Sync(player)
				break
			end
		end
	end)

	SaveService.OnReady(function(player)
		checkAllPasses(player)
		task.delay(1, function()
			if player.Parent then
				MonetizationService.Sync(player)
			end
		end)
	end)

	Players.PlayerRemoving:Connect(function(player)
		owned[player] = nil
		checkFailed[player] = nil
	end)

	-- Fehlgeschlagene Besitzpruefungen spaeter nachholen.
	task.spawn(function()
		while true do
			task.wait(Config.Monetization.OwnershipRecheckSeconds)
			for player, failed in checkFailed do
				for key in failed do
					local id = (IDS.Gamepass :: any)[key]
					if typeof(id) == "number" and id ~= 0 then
						task.spawn(checkPass, player, key, id)
					end
				end
			end
		end
	end)

	local configured = 0
	for _, id in IDS.Gamepass do
		if id ~= 0 then
			configured += 1
		end
	end
	for _, id in IDS.Product do
		if id ~= 0 then
			configured += 1
		end
	end

	if configured == 0 then
		print("[GHOSTNET] MonetizationService bereit. Keine IDs eingetragen - der Store ist leer.")
	else
		print(("[GHOSTNET] MonetizationService bereit. %d IDs eingetragen."):format(configured))
	end
end

return MonetizationService
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="GN28">
<Properties>
<string name="Name">PursuitService</string>
<ProtectedString name="Source">-- ServerScriptService/Systems/PursuitService.luau
--!strict
-- GHOSTNET :: Die Polizei.
--
-- KEIN SCHUSSWECHSEL, KEINE WAFFEN. Das ist eine bewusste Design-Entscheidung
-- und kein Rueckstand: Ein Spiel ohne Waffen macht die FLUCHT interessant,
-- unterscheidet sich sofort von jedem GTA-Klon, und erspart die gesamte
-- Kampf-Balance, die man als Einzelner nie sauber hinbekommt.
--
-- Die Polizei rammt, blockiert und verfolgt. Mehr nicht.
--
-- WIE ES ANS BESTEHENDE SYSTEM HAENGT
--   Die Fahndungsstufe kommt aus dem Trace. Gefasstwerden ist ein Bust ueber
--   die vorhandene Kette - kein zweites Straf-System daneben.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Geometry = require(ReplicatedStorage.Shared.Geometry)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local AssetLibrary = require(ReplicatedStorage.Shared.AssetLibrary)

local RoadNetwork = require(script.Parent.RoadNetwork)
local SaveService = require(script.Parent.SaveService)
local TraceService = require(script.Parent.TraceService)

local PursuitService = {}

local P = Config.Pursuit
local rng = Random.new()

type Unit = {
	Model: Model,
	Body: BasePart,
	GroundOffset: number, -- aus der Modellhoehe gerechnet, nicht geraten
	From: number,
	To: number,
	Alpha: number,
	Active: boolean,
}

type Chase = {
	Level: number,
	Bonus: number, -- Stufen aus Taten (Diebstahl, Alarm), nicht aus dem Trace
	OutOfSight: number, -- Sekunden ohne Sichtkontakt
	InRange: number, -- Sekunden dicht dran am Streifenwagen
	Units: { Unit },
}

local chases: { [Player]: Chase } = {}
local container: Folder? = nil

local function ensureContainer(): Folder
	if container and container.Parent then
		return container
	end
	local folder = Instance.new("Folder")
	folder.Name = "GhostNet_Police"
	folder.Parent = workspace
	container = folder
	return folder
end

--==========================================================================
-- Streifenwagen
--==========================================================================

local function buildUnit(): Unit
	-- Derselbe Weg wie beim Verkehr: Vorlage klonen, nicht bauen. Fehlt sie,
	-- steht hier ein magenta Platzhalter - unuebersehbar, aber fahrbereit.
	local model = AssetLibrary.Clone("Vehicles", P.UnitAsset, P.UnitSize)
	model.Name = "Streifenwagen"

	local pivot = model.PrimaryPart
	if not pivot then
		local chassis = AssetLibrary.Find(model, "Chassis")
		if chassis and chassis:IsA("BasePart") then
			pivot = chassis
		else
			warn(("[GHOSTNET] Streifenwagenvorlage '%s' hat weder PrimaryPart noch Chassis."):format(P.UnitAsset))
			pivot = model:FindFirstChildWhichIsA("BasePart", true)
		end
	end
	local body = pivot :: BasePart
	model.PrimaryPart = body

	-- Kulisse: Anchored, keine Physik, keine Abfrage.
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.Anchored = true
			descendant.CanTouch = false
			descendant.CanQuery = false
			descendant.CanCollide = descendant == body
			if descendant ~= body then
				descendant.CastShadow = false
			end
		end
	end

	-- Blaulicht. Neonflaechen statt Lichtquellen fuer die Farbe, EIN
	-- PointLight fuer den Schein - mehr braucht es nicht und mehr kostet
	-- zu viel. Bringt die Vorlage schon Lichter mit, bleibt es dabei.
	if not AssetLibrary.Find(model, "Lights/Blau") then
		local lights = model:FindFirstChild("Lights")
		if not lights then
			local folder = Instance.new("Folder")
			folder.Name = "Lights"
			folder.Parent = model
			lights = folder
		end
		for index, side in { -1, 1 } do
			local bar = Instance.new("Part")
			bar.Name = if index == 1 then "Blau" else "Rot"
			bar.Size = P.LightBarSize
			bar.Color = if side &lt; 0 then P.LightBlue else P.LightRed
			bar.Material = Enum.Material.Neon
			bar.Anchored = true
			bar.CanCollide = false
			bar.CanQuery = false
			bar.CanTouch = false
			bar.CastShadow = false
			-- Bauposition relativ zur Karosserie. KEINE WeldConstraint -
			-- beide Teile sind Anchored, bewegt wird per PivotTo.
			bar.CFrame = body.CFrame * CFrame.new(side * 1.4, body.Size.Y * 0.5 + 0.4, 0)
			bar.Parent = lights
		end

		local light = Instance.new("PointLight")
		light.Color = P.LightBlue
		light.Brightness = P.LightBrightness
		light.Range = P.LightRange
		light.Parent = body
	end

	model.Parent = ensureContainer()
	CollectionService:AddTag(model, Config.SmoothTag)
	return {
		Model = model,
		Body = body,
		GroundOffset = Config.City.RoadThickness * 0.5
			+ model:GetExtentsSize().Y * 0.5
			+ Config.Traffic.GroundClearance,
		From = 1,
		To = 1,
		Alpha = 0,
		Active = true,
	}
end

local function releaseUnit(unit: Unit)
	unit.Active = false
	if unit.Model.Parent then
		unit.Model:Destroy()
	end
end

--==========================================================================
-- Fahndungsstufe
--==========================================================================

function PursuitService.GetLevel(player: Player): number
	local chase = chases[player]
	return if chase then chase.Level else 0
end

-- Taten erhoehen die Stufe direkt, unabhaengig vom Trace: Autodiebstahl,
-- ausgeloester Alarm, spaeter Unfaelle.
function PursuitService.AddHeat(player: Player, amount: number)
	local chase = chases[player]
	if not chase then
		chase = { Level = 0, Bonus = 0, OutOfSight = 0, InRange = 0, Units = {} }
		chases[player] = chase
	end
	chase.Bonus = math.clamp(chase.Bonus + amount, 0, P.MaxLevel)
end

local function computeLevel(player: Player, chase: Chase): number
	local trace = TraceService.Get(player)
	local fromTrace = math.floor(trace / P.TracePerLevel)
	return math.clamp(math.floor(fromTrace + chase.Bonus), 0, P.MaxLevel)
end

--==========================================================================
-- Verfolgung
--==========================================================================

local function sees(unit: Unit, position: Vector3): boolean
	return (unit.Body.Position - position).Magnitude &lt;= P.SpotRange
end

local function moveUnit(unit: Unit, target: Vector3, dt: number)
	-- Streifenwagen fahren auf demselben Graphen wie der Verkehr. Kein
	-- Pathfinding: ein Schritt Richtung Ziel reicht auf einem Gitter.
	local position, direction = RoadNetwork.LanePosition(unit.From, unit.To, unit.Alpha)
	if not position or not direction then
		local node = RoadNetwork.NearestNode(target)
		if node then
			unit.From = node.Id
			unit.To = RoadNetwork.StepToward(node.Id, target) or node.Id
			unit.Alpha = 0
		end
		return
	end

	-- PivotTo, damit das Blaulicht mitfaehrt statt an der Kreuzung zu bleiben.
	local lift = Vector3.new(0, unit.GroundOffset, 0)
	unit.Model:PivotTo(CFrame.lookAt(position + lift, position + direction + lift))

	unit.Alpha += (P.UnitSpeed * dt) / Config.City.BlockSize
	if unit.Alpha &gt;= 1 then
		unit.From = unit.To
		unit.To = RoadNetwork.StepToward(unit.From, target) or unit.From
		unit.Alpha = 0
	end
end

local function syncChase(player: Player, chase: Chase)
	if not player.Parent then
		return
	end
	Remotes.PursuitSync:FireClient(player, {
		Level = chase.Level,
		MaxLevel = P.MaxLevel,
		Escaping = chase.OutOfSight &gt; 0 and chase.Level &gt; 0,
		EscapeSeconds = math.max(0, P.EscapeSeconds - chase.OutOfSight),
		Roadblock = chase.Level &gt;= P.RoadblockLevel,
		Helicopter = chase.Level &gt;= P.HelicopterLevel,
	})
end

local function clearChase(player: Player)
	local chase = chases[player]
	if not chase then
		return
	end
	for _, unit in chase.Units do
		releaseUnit(unit)
	end
	table.clear(chase.Units)
	chase.Level = 0
	chase.Bonus = 0
	chase.OutOfSight = 0
	chase.InRange = 0
	syncChase(player, chase)
end

function PursuitService.Clear(player: Player)
	clearChase(player)
end

local function step(dt: number)
	for _, player in Players:GetPlayers() do
		local chase = chases[player]
		if not chase then
			continue
		end

		local position = Geometry.AlivePosition(player)
		if not position then
			-- Tot oder nicht geladen: keine Verfolgung, aber die Stufe bleibt.
			for _, unit in chase.Units do
				releaseUnit(unit)
			end
			table.clear(chase.Units)
			continue
		end

		chase.Level = computeLevel(player, chase)

		if chase.Level &lt;= 0 then
			if #chase.Units &gt; 0 then
				clearChase(player)
			end
			continue
		end

		-- Anzahl der Wagen aus der Stufe.
		local wanted = math.clamp(chase.Level * P.UnitsPerLevel, 0, P.MaxUnits)
		while #chase.Units &lt; wanted do
			local unit = buildUnit()
			local node = RoadNetwork.NearestNode(position)
			if node then
				-- Startet eine Kreuzung entfernt, damit er nicht im Spieler steht.
				local links = RoadNetwork.Links(node.Id)
				unit.From = if #links &gt; 0 then links[rng:NextInteger(1, #links)] else node.Id
				unit.To = RoadNetwork.StepToward(unit.From, position) or unit.From
			end
			table.insert(chase.Units, unit)
		end
		while #chase.Units &gt; wanted do
			local unit = table.remove(chase.Units)
			if unit then
				releaseUnit(unit)
			end
		end

		local spotted = false
		local closest = math.huge
		for _, unit in chase.Units do
			moveUnit(unit, position, dt)
			local distance = (unit.Body.Position - position).Magnitude
			closest = math.min(closest, distance)
			if sees(unit, position) then
				spotted = true
			end
		end

		if spotted then
			chase.OutOfSight = 0
		else
			chase.OutOfSight += dt
			-- Entkommen: lange genug ausser Sicht, dann faellt die Stufe.
			if chase.OutOfSight &gt;= P.EscapeSeconds then
				chase.Bonus = math.max(0, chase.Bonus - 1)
				chase.OutOfSight = 0
				if computeLevel(player, chase) &lt;= 0 then
					print(("[GHOSTNET] %s ist entkommen."):format(player.Name))
					clearChase(player)
					continue
				end
			end
		end

		-- Gefasst: lange genug dicht dran. Das ist ein Bust ueber die
		-- bestehende Kette, kein neues Straf-System.
		if closest &lt;= P.CatchRange then
			chase.InRange += dt
			if chase.InRange &gt;= P.CatchSeconds then
				warn(("[GHOSTNET] %s wurde gefasst."):format(player.Name))
				local profile = SaveService.Get(player)
				if profile then
					profile.Trace = 0
				end
				TraceService.Add(player, Config.Trace.Max)
				clearChase(player)
				continue
			end
		else
			chase.InRange = math.max(0, chase.InRange - dt)
		end

		-- Passiver Abbau, damit eine alte Tat nicht ewig nachhaengt.
		chase.Bonus = math.max(0, chase.Bonus - P.Decay * dt)

		syncChase(player, chase)
	end
end

--==========================================================================

function PursuitService.Init()
	RoadNetwork.Build()

	SaveService.OnReady(function(player)
		chases[player] = { Level = 0, Bonus = 0, OutOfSight = 0, InRange = 0, Units = {} }
	end)

	Players.PlayerRemoving:Connect(function(player)
		clearChase(player)
		chases[player] = nil
	end)

	-- Nach einem Bust ist die Fahndung vorbei - man ist ja schon dran gewesen.
	TraceService.OnBust(function(player)
		clearChase(player)
	end)

	task.spawn(function()
		local last = os.clock()
		while true do
			task.wait(P.Tick)
			local now = os.clock()
			local dt = now - last
			last = now
			local ok, err = pcall(step, dt)
			if not ok then
				warn(("[GHOSTNET] Verfolgungstakt fehlgeschlagen: %s"):format(tostring(err)))
			end
		end
	end)

	print(("[GHOSTNET] PursuitService bereit. Stufen 1-%d, Entkommen nach %d s ausser Sicht."):format(
		P.MaxLevel,
		P.EscapeSeconds
	))
end

return PursuitService
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="GN29">
<Properties>
<string name="Name">RaidService</string>
<ProtectedString name="Source">-- ServerScriptService/Systems/RaidService.luau
--!strict
-- GHOSTNET :: Mehrstufige Ziele mit Alarm-Uhr.
--
-- DAS PROBLEM, DAS ES LOEST
--   Ein einzelner Hack ist eine ruhige Denkaufgabe. Ein Ueberfall soll sich
--   anders anfuehlen: Sobald das erste Schloss faellt, laeuft eine Uhr. Das
--   ist die erste Situation im Spiel, in der man wirklich schwitzt.
--
-- WIE MAN EINEN UEBERFALL BAUT - ohne eine Zeile Code
--   Attribute an den Hack-Zielen:
--     AlarmGroup  = "STORE"   beide Ziele gehoeren zusammen
--     AlarmStarts = true      an dem Ziel, das die Uhr startet
--     AlarmEnds   = true      an dem Ziel, das sie stoppt
--     FailBusts   = true      ein Fehlschlag hier ist sofort ein Bust
--     RequiresTwo = true      zu zweit laeuft die Uhr halb so schnell
--
-- Die Uhr laeuft PRO SPIELER, nicht pro Gebaeude. Sonst wuerde ein zweiter
-- Spieler den Alarm des ersten erben, und Co-Op wuerde bestrafen statt helfen.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Geometry = require(ReplicatedStorage.Shared.Geometry)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local HackService = require(script.Parent.HackService)
local PursuitService = require(script.Parent.PursuitService)
local HackTargets = require(script.Parent.HackTargets)
local TraceService = require(script.Parent.TraceService)

local RaidService = {}

type Alarm = {
	Group: string,
	Label: string,
	Remaining: number, -- Sekunden, laeuft rueckwaerts
	Total: number,
	Coop: boolean,
	TargetId: string, -- Ziel, das die Uhr stoppt (fuer den Marker)
}

local alarms: { [Player]: Alarm } = {}
local lastSyncAt: { [Player]: number } = {}

--==========================================================================
-- Anzeige
--==========================================================================

local function syncAlarm(player: Player, force: boolean?)
	if not player.Parent then
		return
	end
	local now = os.clock()
	if not force and now - (lastSyncAt[player] or 0) &lt; Config.Raid.AlarmSyncInterval then
		return
	end
	lastSyncAt[player] = now

	local alarm = alarms[player]
	if not alarm then
		Remotes.AlarmSync:FireClient(player, { Active = false })
		return
	end

	Remotes.AlarmSync:FireClient(player, {
		Active = true,
		Label = alarm.Label,
		Remaining = alarm.Remaining,
		Total = alarm.Total,
		WarnAt = Config.Raid.AlarmWarnAt,
		Coop = alarm.Coop,
	})
end

--==========================================================================
-- Co-Op
--==========================================================================

-- Steht ein zweiter Spieler nah genug an einem Ziel mit RequiresTwo?
-- Das ist der einzige Grund im ganzen Spiel, einen Freund mitzubringen -
-- deshalb muss es spuerbar sein und nicht nur ein Prozentpunkt.
function RaidService.HasPartner(player: Player, part: BasePart): boolean
	if part:GetAttribute("RequiresTwo") ~= true then
		return false
	end
	return Geometry.HasNearbyOtherPlayer(player, part, Config.Raid.CoopRange)
end

--==========================================================================
-- Uhr starten und stoppen
--==========================================================================

local function findEndTarget(group: string): string
	for id, target in HackTargets.All() do
		if target.Part:GetAttribute("AlarmGroup") == group and target.Part:GetAttribute("AlarmEnds") == true then
			return id
		end
	end
	return ""
end

local function startAlarm(player: Player, group: string, label: string)
	alarms[player] = {
		Group = group,
		Label = label,
		Remaining = Config.Raid.AlarmSeconds,
		Total = Config.Raid.AlarmSeconds,
		Coop = false,
		TargetId = findEndTarget(group),
	}
	warn(("[GHOSTNET] Alarm '%s' laeuft fuer %s (%d s)."):format(group, player.Name, Config.Raid.AlarmSeconds))
	syncAlarm(player, true)
end

local function stopAlarm(player: Player, reason: string)
	local alarm = alarms[player]
	if not alarm then
		return
	end
	alarms[player] = nil
	print(("[GHOSTNET] Alarm '%s' fuer %s beendet: %s"):format(alarm.Group, player.Name, reason))
	syncAlarm(player, true)
end

-- Die Uhr ist durchgelaufen. Kein Bust, aber ein Trace-Sprung, den man merkt.
local function triggerAlarm(player: Player)
	local alarm = alarms[player]
	if not alarm then
		return
	end
	alarms[player] = nil

	warn(("[GHOSTNET] ALARM ausgeloest: %s in Gruppe '%s'."):format(player.Name, alarm.Group))
	HackService.AbortFor(player, "ALARM")
	TraceService.Add(player, Config.Raid.AlarmTracePenalty)
	-- Ein durchgelaufener Alarm ruft die Polizei. Genau dafuer ist die
	-- Fahndungsstufe da.
	PursuitService.AddHeat(player, 2)

	if player.Parent then
		Remotes.AlarmSync:FireClient(player, {
			Active = false,
			Triggered = true,
			Label = alarm.Label,
			TracePenalty = Config.Raid.AlarmTracePenalty,
		})
	end
end

-- Von aussen ausgeloester Alarm (Wache hat jemanden gesehen). Startet
-- dieselbe Uhr wie ein geknacktes Ziel - kein zweites Alarm-System daneben.
function RaidService.RaiseAlarm(player: Player, group: string, label: string)
	if alarms[player] then
		return
	end
	startAlarm(player, group, label)
end

function RaidService.IsAlarmed(player: Player): boolean
	return alarms[player] ~= nil
end

function RaidService.AlarmSecondsLeft(player: Player): number
	local alarm = alarms[player]
	return if alarm then math.max(0, alarm.Remaining) else 0
end

--==========================================================================
-- Reaktion auf Hacks
--==========================================================================

local function onHackResolved(player: Player, data: { [string]: any })
	local target = HackTargets.Get(data.TargetId)
	if not target then
		return
	end
	local part = target.Part
	local group = part:GetAttribute("AlarmGroup")

	if data.Success ~= true then
		-- Fehlschlag an einem Ziel mit FailBusts: sofort auffliegen, nicht
		-- nur ein normaler Fehlversuch. Genau das macht die Bank teuer.
		if part:GetAttribute("FailBusts") == true then
			warn(("[GHOSTNET] %s ist an einem FailBusts-Ziel gescheitert - sofortiger Bust."):format(player.Name))
			if typeof(group) == "string" then
				stopAlarm(player, "Fehlschlag")
			end
			TraceService.Add(player, Config.Raid.FailBustTrace)
		end
		return
	end

	if typeof(group) ~= "string" or group == "" then
		return
	end

	if part:GetAttribute("AlarmEnds") == true then
		local alarm = alarms[player]
		if alarm and alarm.Group == group then
			stopAlarm(player, "Ziel erreicht")
		end
		return
	end

	if part:GetAttribute("AlarmStarts") == true and not alarms[player] then
		startAlarm(player, group, target.DisplayName)
	end
end

--==========================================================================
-- Takt
--==========================================================================

local function tick()
	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator &lt; 0.25 then
			return
		end
		local step = accumulator
		accumulator = 0

		for player, alarm in alarms do
			if not player.Parent then
				alarms[player] = nil
				continue
			end

			-- Partner in der Naehe des Zielobjekts bremst die Uhr.
			local coop = false
			local endTarget = HackTargets.Get(alarm.TargetId)
			if endTarget then
				coop = RaidService.HasPartner(player, endTarget.Part)
			end
			alarm.Coop = coop

			alarm.Remaining -= step * (if coop then Config.Raid.CoopAlarmFactor else 1)

			if alarm.Remaining &lt;= 0 then
				triggerAlarm(player)
			else
				syncAlarm(player, false)
			end
		end
	end)
end

--==========================================================================

function RaidService.Init()
	HackService.OnHackResolved(onHackResolved)

	Players.PlayerRemoving:Connect(function(player)
		alarms[player] = nil
		lastSyncAt[player] = nil
	end)

	tick()

	print(("[GHOSTNET] RaidService bereit. Alarm %d s, Strafe +%d Trace."):format(
		Config.Raid.AlarmSeconds,
		Config.Raid.AlarmTracePenalty
	))
end

return RaidService
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="GN30">
<Properties>
<string name="Name">RateLimiter</string>
<ProtectedString name="Source">-- ServerScriptService/Systems/RateLimiter.luau
--!strict
-- GHOSTNET :: Token-Bucket pro Spieler und Remote.
-- Jeder Remote-Handler fragt als ALLERERSTES hier nach.

local Players = game:GetService("Players")
local Config = require(game:GetService("ReplicatedStorage").Shared.Config)

type Bucket = { Tokens: number, Last: number, Rate: number, Burst: number }

local RateLimiter = {}

local buckets: { [Player]: { [string]: Bucket } } = {}
-- Wer dauerhaft gegen Limits laeuft, wird geloggt statt still verschluckt.
local offences: { [Player]: number } = {}

local function getBucket(player: Player, key: string): Bucket?
	local limit = (Config.RateLimits :: any)[key]
	if not limit then
		warn(("[GHOSTNET] Kein Rate-Limit fuer '%s' konfiguriert - Aufruf wird verworfen."):format(key))
		return nil
	end

	local perPlayer = buckets[player]
	if not perPlayer then
		perPlayer = {}
		buckets[player] = perPlayer
	end

	local b = perPlayer[key]
	if not b then
		b = { Tokens = limit.Burst, Last = os.clock(), Rate = limit.Rate, Burst = limit.Burst }
		perPlayer[key] = b
	end
	return b
end

-- true  = Aufruf darf verarbeitet werden
-- false = Aufruf wird verworfen
function RateLimiter.Check(player: Player, key: string): boolean
	if not player.Parent then
		return false
	end

	local b = getBucket(player, key)
	if not b then
		return false
	end

	local now = os.clock()
	b.Tokens = math.min(b.Burst, b.Tokens + (now - b.Last) * b.Rate)
	b.Last = now

	if b.Tokens &lt; 1 then
		local n = (offences[player] or 0) + 1
		offences[player] = n
		if n == 25 or n % 250 == 0 then
			warn(("[GHOSTNET] %s ueberschreitet Rate-Limit '%s' (%d Verstoesse)"):format(player.Name, key, n))
		end
		return false
	end

	b.Tokens -= 1
	return true
end

function RateLimiter.Clear(player: Player)
	buckets[player] = nil
	offences[player] = nil
end

Players.PlayerRemoving:Connect(RateLimiter.Clear)

return RateLimiter
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="GN31">
<Properties>
<string name="Name">RoadNetwork</string>
<ProtectedString name="Source">-- ServerScriptService/Systems/RoadNetwork.luau
--!strict
-- GHOSTNET :: Der Strassengraph.
--
-- WARUM DAS EIN GRAPH IST UND KEINE PATHFINDING-ABFRAGE
--   Ein Pfad pro Auto, mehrfach pro Sekunde neu berechnet, frisst den Server
--   bei zweistelliger Fahrzeugzahl auf. Stattdessen liegt hier ein fester
--   Graph aus Kreuzungen und gerichteten Kanten. Ein Verkehrsauto folgt
--   Kante fuer Kante und wuerfelt an jeder Kreuzung - das kostet praktisch
--   nichts und sieht trotzdem lebendig aus.
--
--   Derselbe Graph traegt in Phase 6 die Streifenwagen. Deshalb liegt er
--   hier und nicht im TrafficService.
--
-- Der Graph wird BERECHNET, nicht aus der Welt gelesen. Kein Suchen nach
-- getaggten Parts, keine Instanzen fuer Wegpunkte - nur Zahlen.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Districts = require(ReplicatedStorage.Shared.Districts)

local RoadNetwork = {}

export type Node = {
	Id: number,
	GridX: number,
	GridZ: number,
	Position: Vector3,
	Links: { number }, -- Ids der erreichbaren Nachbarkreuzungen
}

local nodes: { Node } = {}
local byGrid: { [string]: number } = {}
local half = 0

local function key(gridX: number, gridZ: number): string
	return ("%d,%d"):format(gridX, gridZ)
end

--==========================================================================
-- Aufbau
--==========================================================================

function RoadNetwork.Build()
	if #nodes &gt; 0 then
		return
	end

	local grid = Config.City.Grid
	local block = Config.City.BlockSize
	half = math.floor(grid / 2)

	-- Kreuzungen als Gitter. Die Mitte liegt bei (0,0), damit der Spawn im
	-- Zentrum der Altstadt steht.
	for gz = -half, half do
		for gx = -half, half do
			local node: Node = {
				Id = #nodes + 1,
				GridX = gx,
				GridZ = gz,
				Position = Vector3.new(gx * block, 0, gz * block),
				Links = {},
			}
			table.insert(nodes, node)
			byGrid[key(gx, gz)] = node.Id
		end
	end

	-- Kanten zu den vier direkten Nachbarn. Beide Richtungen, damit der
	-- Verkehr an einer Kreuzung immer weiterkommt und nie feststeckt.
	for _, node in nodes do
		for _, offset in { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } } do
			local neighbour = byGrid[key(node.GridX + offset[1], node.GridZ + offset[2])]
			if neighbour then
				table.insert(node.Links, neighbour)
			end
		end
	end
end

--==========================================================================
-- Abfragen
--==========================================================================

function RoadNetwork.Count(): number
	return #nodes
end

function RoadNetwork.Get(id: number): Node?
	return nodes[id]
end

function RoadNetwork.All(): { Node }
	return nodes
end

function RoadNetwork.Links(id: number): { number }
	local node = nodes[id]
	return if node then node.Links else {}
end

-- Naechste Kreuzung zu einer Weltposition. Ueber das Gitter gerechnet statt
-- durch Durchsuchen aller Knoten - das laeuft im Verkehrstakt.
function RoadNetwork.NearestNode(position: Vector3): Node?
	if #nodes == 0 then
		return nil
	end
	local block = Config.City.BlockSize
	local gx = math.clamp(math.round(position.X / block), -half, half)
	local gz = math.clamp(math.round(position.Z / block), -half, half)
	local id = byGrid[key(gx, gz)]
	return if id then nodes[id] else nil
end

function RoadNetwork.RandomNode(rng: Random): Node?
	if #nodes == 0 then
		return nil
	end
	return nodes[rng:NextInteger(1, #nodes)]
end

-- Ein zufaelliger Nachbar, moeglichst nicht der, aus dem man gerade kam.
-- Ohne das drehen die Autos an jeder Kreuzung um und der Verkehr wirkt kaputt.
function RoadNetwork.NextNode(fromId: number, cameFrom: number?, rng: Random): number?
	local links = RoadNetwork.Links(fromId)
	if #links == 0 then
		return nil
	end
	if #links == 1 then
		return links[1]
	end

	local options: { number } = {}
	for _, id in links do
		if id ~= cameFrom then
			table.insert(options, id)
		end
	end
	if #options == 0 then
		return links[rng:NextInteger(1, #links)]
	end
	return options[rng:NextInteger(1, #options)]
end

-- Ein Schritt Richtung Ziel. Kein A*, nur "welcher Nachbar liegt naeher" -
-- das reicht auf einem Gitter voellig und kostet nichts. Damit fahren die
-- Streifenwagen in Phase 6 zum Spieler.
function RoadNetwork.StepToward(fromId: number, target: Vector3): number?
	local links = RoadNetwork.Links(fromId)
	local best: number? = nil
	local bestDistance = math.huge
	for _, id in links do
		local node = nodes[id]
		if node then
			local distance = (node.Position - target).Magnitude
			if distance &lt; bestDistance then
				best, bestDistance = id, distance
			end
		end
	end
	return best
end

-- Fahrspur: rechts der Mitte, damit Gegenverkehr nicht ineinander faehrt.
function RoadNetwork.LanePosition(fromId: number, toId: number, alpha: number): (Vector3?, Vector3?)
	local a = nodes[fromId]
	local b = nodes[toId]
	if not a or not b then
		return nil, nil
	end
	local direction = (b.Position - a.Position)
	local length = direction.Magnitude
	if length &lt; 0.01 then
		return nil, nil
	end
	local unit = direction / length
	local right = Vector3.new(-unit.Z, 0, unit.X)
	local offset = right * Config.City.LaneOffset
	return a.Position + offset + unit * (length * alpha), unit
end

-- In welchem Bezirk liegt diese Position?
function RoadNetwork.DistrictAt(position: Vector3): Districts.District?
	local block = Config.City.BlockSize
	return Districts.At(math.round(position.X / block), math.round(position.Z / block))
end

function RoadNetwork.Init()
	local valid, errors = Districts.Validate()
	if not valid then
		for _, message in errors do
			warn(("[GHOSTNET] Bezirke: %s"):format(message))
		end
	end

	RoadNetwork.Build()
	local edges = 0
	for _, node in nodes do
		edges += #node.Links
	end
	print(("[GHOSTNET] RoadNetwork bereit. %d Kreuzungen, %d Kanten, %d Bezirke."):format(
		#nodes,
		edges,
		Districts.Count()
	))
end

return RoadNetwork
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="GN32">
<Properties>
<string name="Name">SaveService</string>
<ProtectedString name="Source">-- ServerScriptService/Systems/SaveService.luau
--!strict
-- GHOSTNET :: Das Profil. Einzige Stelle im ganzen Projekt, die einen
-- DataStore anfasst.
--
-- WAS HIER DRINSTEHT
--   Alles, was einen Serverwechsel ueberleben muss: Bank, Unverkauftes, Rig,
--   Trace, Ziel-Cooldowns, Statistik. Alle Zeitstempel sind os.time()
--   (Unix-Zeit) - os.clock() ist die Laufzeit DIESES Serverprozesses und
--   damit nach einem Rejoin wertlos.
--
-- SESSION-LOCK
--   Beim Laden schreibt der Server eine frische SessionId ins Profil. Taucht
--   derselbe Spieler auf einem zweiten Server auf, ueberschreibt der neue die
--   Id - der aeltere Server merkt das beim naechsten Speichern, schreibt NICHT
--   mehr und beendet seine Sitzung. Ohne das ueberschreiben sich zwei Server
--   gegenseitig und man kann sich per Server-Hopping Sachen duplizieren.
--
-- WENN DAS LADEN SCHEITERT
--   Wird gekickt. Mit einem leeren Profil weiterspielen zu lassen waere
--   schlimmer: der Save beim Verlassen wuerde echten Fortschritt mit Nullen
--   ueberschreiben.

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Types = require(ReplicatedStorage.Shared.Types)

type Profile = Types.Profile

local SaveService = {}

local store: DataStore? = nil

local profiles: { [Player]: Profile } = {}
local sessionIds: { [Player]: string } = {}
local memoryOnly: { [Player]: boolean } = {} -- Studio-Notbetrieb ohne DataStore
local lastSaveAt: { [Player]: number } = {} -- os.clock()
local savePending: { [Player]: boolean } = {}
local saving: { [Player]: boolean } = {}
local finished: { [Player]: boolean } = {} -- Sitzung beendet, nicht mehr schreiben

local readyCallbacks: { (Player, Profile) -&gt; () } = {}

--==========================================================================
-- Profil-Schema
--==========================================================================

local function defaultStats(): Types.Stats
	return { Hacks = 0, Fails = 0, Busts = 0, Sales = 0, Earned = 0, Upgrades = 0, GoodsBought = 0, GoodsSold = 0 }
end

local function defaultStory(): Types.Story
	return {
		Active = "",
		Step = 1,
		StepProgress = 0,
		StepStartedAt = 0,
		Completed = {},
		Unlocks = {},
		Allegiance = "",
		AllegianceAt = 0,
	}
end

function SaveService.DefaultProfile(): Profile
	local start = Config.Rig.StartLevels
	return {
		SchemaVersion = Config.Save.SchemaVersion,
		Banked = 0,
		Unsold = 0,
		Rig = { CPU = start.CPU, RAM = start.RAM, Cooling = start.Cooling, NetCard = start.NetCard },
		Trace = 0,
		Cooldowns = {},
		Stats = defaultStats(),
		Story = defaultStory(),
		Stash = {},
		PurchaseLog = {},
		Garage = {},
		LastSeen = os.time(),
		SessionId = "",
	}
end

local function toCount(value: any): number?
	if typeof(value) ~= "number" or value ~= value or value == math.huge or value == -math.huge then
		return nil
	end
	return math.max(0, math.floor(value))
end

-- Nur Strings, die als Id taugen. Haelt Muell aus dem Profil, falls jemals
-- kaputte Daten im Store landen.
local function cleanIdList(raw: any, limit: number): { string }
	local out: { string } = {}
	if typeof(raw) ~= "table" then
		return out
	end
	for _, value in raw do
		if typeof(value) == "string" and value ~= "" and #value &lt;= 48 and #out &lt; limit then
			if not table.find(out, value) then
				table.insert(out, value)
			end
		end
	end
	return out
end

-- Migration und Missbrauchsschutz in einem: alles, was fehlt, kommt aus dem
-- Default, alles was da ist, wird auf Typ und Wertebereich geprueft. Neue
-- Felder in kuenftigen Schema-Versionen brauchen deshalb nur hier eine Zeile.
-- Liefert zusaetzlich die Schema-Version, die im Store STAND - die braucht
-- runMigrations, um zu wissen, was noch nachzuziehen ist.
local function sanitize(raw: any): (Profile, number)
	local p = SaveService.DefaultProfile()
	if typeof(raw) ~= "table" then
		return p, Config.Save.SchemaVersion -- frisches Profil, nichts zu migrieren
	end

	local rawVersion = 1
	if typeof(raw.SchemaVersion) == "number" and raw.SchemaVersion &gt;= 1 then
		rawVersion = math.floor(raw.SchemaVersion)
	end

	p.Banked = toCount(raw.Banked) or p.Banked
	p.Unsold = toCount(raw.Unsold) or p.Unsold

	if typeof(raw.Rig) == "table" then
		for _, component in Config.Rig.Components do
			local level = (raw.Rig :: any)[component]
			if typeof(level) == "number" and level == level then
				(p.Rig :: any)[component] = math.clamp(math.floor(level), 1, Config.Rig.MaxLevel)
			end
		end
	end

	if typeof(raw.Trace) == "number" and raw.Trace == raw.Trace then
		p.Trace = math.clamp(raw.Trace, 0, Config.Trace.Max)
	end

	if typeof(raw.Cooldowns) == "table" then
		local now = os.time()
		for id, until_ in raw.Cooldowns do
			-- Abgelaufenes gar nicht erst uebernehmen: haelt das Profil klein.
			if typeof(id) == "string" and #id &lt;= 32 and typeof(until_) == "number" and until_ &gt; now then
				p.Cooldowns[id] = math.floor(until_)
			end
		end
	end

	if typeof(raw.Stats) == "table" then
		for key in defaultStats() do
			local value = toCount((raw.Stats :: any)[key])
			if value then
				(p.Stats :: any)[key] = value
			end
		end
	end

	if typeof(raw.Story) == "table" then
		local story = raw.Story
		if typeof(story.Active) == "string" and #story.Active &lt;= 48 then
			p.Story.Active = story.Active
		end
		p.Story.Step = math.max(1, toCount(story.Step) or 1)
		p.Story.StepProgress = toCount(story.StepProgress) or 0
		p.Story.StepStartedAt = toCount(story.StepStartedAt) or 0
		p.Story.Completed = cleanIdList(story.Completed, 128)
		p.Story.Unlocks = cleanIdList(story.Unlocks, 128)
		if story.Allegiance == "CASH" or story.Allegiance == "BURN" then
			p.Story.Allegiance = story.Allegiance
		end
		p.Story.AllegianceAt = toCount(story.AllegianceAt) or 0
	end

	-- Garage. Nur bekannte Klassen und eine harte Obergrenze, damit ein
	-- kaputtes Profil den Server nicht mit tausend Fahrzeugen flutet.
	if typeof(raw.Garage) == "table" then
		for _, entry in raw.Garage do
			if typeof(entry) == "table" and typeof(entry.ClassId) == "string" and #entry.ClassId &lt;= 32 then
				if #p.Garage &lt; 32 then
					table.insert(p.Garage, {
						ClassId = entry.ClassId,
						Colour = if typeof(entry.Colour) == "string" and #entry.Colour &lt;= 24
							then entry.Colour
							else "Schwarz",
					})
				end
			end
		end
	end

	if typeof(raw.Stash) == "table" then
		for goodId, amount in raw.Stash do
			local count = toCount(amount)
			if typeof(goodId) == "string" and #goodId &lt;= 32 and count and count &gt; 0 then
				p.Stash[goodId] = count
			end
		end
	end

	p.PurchaseLog = cleanIdList(raw.PurchaseLog, Config.Monetization.PurchaseLogLimit)

	p.LastSeen = toCount(raw.LastSeen) or p.LastSeen
	if typeof(raw.SessionId) == "string" then
		p.SessionId = raw.SessionId
	end

	p.SchemaVersion = Config.Save.SchemaVersion
	return p, rawVersion
end

--==========================================================================
-- Migrationen
--
-- sanitize() fuellt fehlende Felder bereits mit Defaults - das allein reicht
-- fuer reine Feld-Ergaenzungen. Hier steht, was DARUEBER HINAUS noetig ist,
-- wenn sich die Bedeutung vorhandener Daten aendert. Schluessel = Zielversion.
-- Ein Altprofil wird nie verworfen und darf nie zum Absturz fuehren.
--==========================================================================

local MIGRATIONS: { [number]: (Profile) -&gt; () } = {
	-- 1 -&gt; 2: Der Story-Block kam dazu. Alte Profile haben ihn nicht; sie
	-- starten bei der ersten Mission, behalten aber Bank, Rig und Cooldowns.
	[2] = function(profile: Profile)
		profile.Story.Active = ""
		profile.Story.Step = 1
		profile.Story.StepProgress = 0
		profile.Story.StepStartedAt = 0
	end,

	-- 2 -&gt; 3: Darknet-Lager kam dazu. Alte Profile starten mit leerem Lager;
	-- Bank, Rig, Trace, Cooldowns und Story bleiben unangetastet.
	[3] = function(profile: Profile)
		profile.Stash = {}
	end,

	-- 3 -&gt; 4: Beleg-Log gegen Doppelvergabe. Alte Profile starten leer; das
	-- ist unkritisch, weil vor Phase F gar nichts gekauft werden konnte.
	[4] = function(profile: Profile)
		profile.PurchaseLog = {}
	end,

	-- 4 -&gt; 5: Fahrzeugbesitz und die Endgame-Entscheidung kamen dazu. Alte
	-- Profile starten ohne Auto und ohne getroffene Wahl; alles andere
	-- bleibt unangetastet.
	[5] = function(profile: Profile)
		profile.Garage = {}
		profile.Story.Allegiance = ""
		profile.Story.AllegianceAt = 0
	end,
}

local function runMigrations(profile: Profile, fromVersion: number, playerName: string)
	if fromVersion &gt;= Config.Save.SchemaVersion then
		return
	end
	for version = fromVersion + 1, Config.Save.SchemaVersion do
		local migrate = MIGRATIONS[version]
		if migrate then
			local ok, err = pcall(migrate, profile)
			if not ok then
				warn(("[GHOSTNET] Migration auf Schema %d fuer %s fehlgeschlagen: %s"):format(
					version,
					playerName,
					tostring(err)
				))
			end
		end
	end
	print(("[GHOSTNET] Profil von %s auf Schema %d -&gt; %d migriert."):format(
		playerName,
		fromVersion,
		Config.Save.SchemaVersion
	))
end

-- Alte Cooldowns wegwerfen, bevor gespeichert wird.
local function pruneCooldowns(profile: Profile)
	local cutoff = os.time() - Config.Cooldown.KeepSeconds
	for id, until_ in profile.Cooldowns do
		if until_ &lt; cutoff then
			profile.Cooldowns[id] = nil
		end
	end
end

-- Flache Kopie fuer den Store, damit ein laufender Save nicht mit dem
-- Live-Profil kollidiert, das der Spieler gerade weiter veraendert.
local function snapshotOf(profile: Profile): Profile
	local copy = table.clone(profile) :: Profile
	copy.Rig = table.clone(profile.Rig)
	copy.Stats = table.clone(profile.Stats)
	copy.Cooldowns = table.clone(profile.Cooldowns)
	return copy
end

--==========================================================================
-- DataStore-Zugriff (immer pcall + Backoff)
--==========================================================================

local function getStore(): DataStore?
	if store then
		return store
	end
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.Save.StoreName)
	end)
	if ok and result then
		store = result
		return store
	end
	return nil
end

local function studioFallbackAllowed(): boolean
	return Config.Save.StudioMemoryFallback and RunService:IsStudio()
end

-- Fuehrt fn mit Wiederholungen aus. Liefert (erfolgreich, Ergebnis).
-- Im Studio wird kuerzer probiert: ist "Studio Access to API Services" aus,
-- scheitert jeder Versuch, und niemand will 7 Sekunden auf den Notbetrieb warten.
local function withRetry(label: string, playerName: string, fn: () -&gt; any): (boolean, any)
	local maxRetries = if studioFallbackAllowed() then Config.Save.StudioRetries else Config.Save.MaxRetries
	local waitTime = Config.Save.RetryBase
	local lastError: any = nil

	for attempt = 1, maxRetries do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		lastError = result
		warn(("[GHOSTNET] %s fuer %s fehlgeschlagen (Versuch %d/%d): %s"):format(
			label,
			playerName,
			attempt,
			maxRetries,
			tostring(result)
		))
		if attempt &lt; maxRetries then
			task.wait(waitTime)
			waitTime *= Config.Save.RetryFactor
		end
	end

	warn(("[GHOSTNET] %s fuer %s endgueltig gescheitert: %s"):format(label, playerName, tostring(lastError)))
	return false, nil
end

--==========================================================================
-- Laden
--==========================================================================

local function fireReady(player: Player, profile: Profile)
	for _, callback in readyCallbacks do
		local ok, err = pcall(callback, player, profile)
		if not ok then
			warn(("[GHOSTNET] Profil-Callback fehlgeschlagen: %s"):format(tostring(err)))
		end
	end
end

local function loadProfile(player: Player)
	local sessionId = HttpService:GenerateGUID(false)
	sessionIds[player] = sessionId

	local dataStore = getStore()
	if not dataStore then
		if studioFallbackAllowed() then
			warn("[GHOSTNET] Kein DataStore erreichbar - Studio-Notbetrieb, es wird NICHTS gespeichert.")
			memoryOnly[player] = true
			local fallback = SaveService.DefaultProfile()
			profiles[player] = fallback
			fireReady(player, fallback)
			return
		end
		player:Kick(Config.Save.KickMessage)
		return
	end

	local key = Config.Save.KeyFormat:format(player.UserId)

	local ok, loaded = withRetry("Profil laden", player.Name, function()
		return dataStore:UpdateAsync(key, function(raw: any): Profile
			local profile, rawVersion = sanitize(raw)
			-- Altprofile nachziehen, BEVOR geschrieben wird. Ein Profil wird
			-- dabei nie verworfen.
			runMigrations(profile, rawVersion, player.Name)

			-- Abkuehlung fuer die Zeit, in der der Spieler offline war. Der
			-- Trace laeuft also nicht "eingefroren" weiter - wer eine Woche
			-- weg war, faengt sauber an.
			local elapsed = math.max(0, os.time() - profile.LastSeen)
			if elapsed &gt; 0 and profile.Trace &gt; 0 then
				profile.Trace = math.max(0, profile.Trace - Config.GetTraceDecay(profile.Rig.Cooling) * elapsed)
			end

			-- Die juengere Sitzung uebernimmt das Schloss.
			profile.SessionId = sessionId
			profile.LastSeen = os.time()
			return profile
		end)
	end)

	if not player.Parent then
		return -- waehrend des Ladens rausgegangen
	end

	if not ok or typeof(loaded) ~= "table" then
		if studioFallbackAllowed() then
			warn(("[GHOSTNET] Laden fuer %s gescheitert - Studio-Notbetrieb ohne Speichern."):format(player.Name))
			memoryOnly[player] = true
			local fallback = SaveService.DefaultProfile()
			profiles[player] = fallback
			fireReady(player, fallback)
			return
		end
		player:Kick(Config.Save.KickMessage)
		return
	end

	local profile = sanitize(loaded)
	profile.SessionId = sessionId
	profiles[player] = profile
	lastSaveAt[player] = os.clock()

	print(("[GHOSTNET] Profil geladen: %s (Bank %d, Unverkauft %d, Trace %.0f)"):format(
		player.Name,
		profile.Banked,
		profile.Unsold,
		profile.Trace
	))

	fireReady(player, profile)
end

--==========================================================================
-- Speichern
--==========================================================================

local function endSession(player: Player, reason: string)
	if finished[player] then
		return
	end
	finished[player] = true
	profiles[player] = nil
	savePending[player] = nil
	if player.Parent then
		warn(("[GHOSTNET] Sitzung von %s beendet: %s"):format(player.Name, reason))
		player:Kick(Config.Save.LockKickMessage)
	end
end

-- final = letzter Save dieser Sitzung, danach wird das Schloss freigegeben.
local function saveProfile(player: Player, final: boolean): boolean
	if memoryOnly[player] then
		return false
	end
	local profile = profiles[player]
	if not profile then
		return false -- nie ein Profil schreiben, das nie geladen wurde
	end
	if saving[player] then
		return false
	end
	saving[player] = true

	profile.LastSeen = os.time()
	pruneCooldowns(profile)

	local snapshot = snapshotOf(profile)
	local mySession = sessionIds[player] or ""
	snapshot.SessionId = if final then "" else mySession

	local dataStore = getStore()
	local lostLock = false

	local ok = false
	if dataStore then
		local key = Config.Save.KeyFormat:format(player.UserId)
		ok = (withRetry("Profil speichern", player.Name, function()
			dataStore:UpdateAsync(key, function(raw: any)
				if
					typeof(raw) == "table"
					and typeof(raw.SessionId) == "string"
					and raw.SessionId ~= ""
					and raw.SessionId ~= mySession
				then
					-- Ein juengerer Server hat uebernommen. nil bricht den
					-- Schreibvorgang ab, statt fremden Fortschritt zu ueberbuegeln.
					lostLock = true
					return nil
				end
				return snapshot
			end)
			return true
		end))
	end

	saving[player] = nil
	lastSaveAt[player] = os.clock()
	savePending[player] = nil

	if lostLock then
		endSession(player, "Session-Lock von einem anderen Server uebernommen")
		return false
	end

	return ok
end

--==========================================================================
-- Oeffentliche Schnittstelle
--==========================================================================

-- Das Live-Profil. nil solange geladen wird oder wenn das Laden gescheitert
-- ist. Jeder Aufrufer muss mit nil umgehen koennen.
function SaveService.Get(player: Player): Profile?
	return profiles[player]
end

function SaveService.IsReady(player: Player): boolean
	return profiles[player] ~= nil
end

-- Nur zur Anzeige/Diagnose: im Studio-Notbetrieb wird nichts gespeichert.
function SaveService.IsMemoryOnly(player: Player): boolean
	return memoryOnly[player] == true
end

-- Wird fuer jeden Spieler genau einmal aufgerufen, sobald sein Profil steht -
-- auch fuer Spieler, die schon da waren, als der Callback registriert wurde.
function SaveService.OnReady(callback: (Player, Profile) -&gt; ())
	table.insert(readyCallbacks, callback)
	for player, profile in profiles do
		task.spawn(callback, player, profile)
	end
end

-- Nach wichtigen Ereignissen (Verkauf, Kauf, Bust). Gedrosselt, damit ein
-- Spieler nicht durch schnelles Klicken das Schreib-Budget leert.
function SaveService.RequestSave(player: Player)
	if profiles[player] then
		savePending[player] = true
	end
end

function SaveService.SaveNow(player: Player): boolean
	return saveProfile(player, false)
end

--==========================================================================

function SaveService.Init()
	Players.PlayerAdded:Connect(function(player)
		task.spawn(loadProfile, player)
	end)
	for _, player in Players:GetPlayers() do
		task.spawn(loadProfile, player)
	end

	Players.PlayerRemoving:Connect(function(player)
		-- Laeuft gerade ein Autosave, warten wir kurz darauf. Sonst wuerde der
		-- Abschluss-Save wegen saving[player] wortlos aussteigen und die
		-- letzten Sekunden Fortschritt waeren weg.
		local deadline = os.clock() + Config.Save.LeaveSaveWait
		while saving[player] and os.clock() &lt; deadline do
			task.wait(0.1)
		end

		saveProfile(player, true)
		profiles[player] = nil
		sessionIds[player] = nil
		memoryOnly[player] = nil
		lastSaveAt[player] = nil
		savePending[player] = nil
		saving[player] = nil
		finished[player] = nil
	end)

	-- Ein Takt fuer Autosave und angeforderte Zwischenspeicherungen.
	task.spawn(function()
		while true do
			task.wait(1)
			local now = os.clock()
			for _, player in Players:GetPlayers() do
				if not profiles[player] or saving[player] then
					continue
				end
				local age = now - (lastSaveAt[player] or now)
				local due = age &gt;= Config.Save.Interval
					or (savePending[player] == true and age &gt;= Config.Save.MinInterval)
				if due then
					saveProfile(player, false)
				end
			end
		end
	end)

	game:BindToClose(function()
		local open = 0
		for _, player in Players:GetPlayers() do
			if profiles[player] then
				open += 1
				task.spawn(function()
					saveProfile(player, true)
					open -= 1
				end)
			end
		end
		local deadline = os.clock() + Config.Save.BindToCloseSeconds
		while open &gt; 0 and os.clock() &lt; deadline do
			task.wait(0.1)
		end
	end)

	print("[GHOSTNET] SaveService bereit.")
end

return SaveService
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="GN33">
<Properties>
<string name="Name">SellService</string>
<ProtectedString name="Source">-- ServerScriptService/Systems/SellService.luau
--!strict
-- GHOSTNET :: Der Hehler. Der Moment, der aus Zahlen eine Entscheidung macht.
--
-- Unverkauftes ist heiss und beim Bust weg. Gebankt ist sicher. Der Weg zum
-- Hehler kostet Zeit, und der Trace laeuft waehrenddessen weiter. Genau
-- deshalb ist "noch ein Ziel mitnehmen oder jetzt abliefern?" die zentrale
-- Frage jeder Runde - und nicht bloss ein Knopf.
--
-- Ein Hehler ist genau wie ein Hack-Ziel nur ein BasePart mit einem Tag
-- ("GhostNetFence"). Kein Code noetig, um einen zweiten aufzustellen.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Geometry = require(ReplicatedStorage.Shared.Geometry)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local EconomyService = require(script.Parent.EconomyService)
local RateLimiter = require(script.Parent.RateLimiter)
local SaveService = require(script.Parent.SaveService)
local TraceService = require(script.Parent.TraceService)

local SellService = {}

-- Wer mitbekommen will, dass verkauft wurde, meldet sich hier an - gleiches
-- Muster wie TraceService.OnBust und HackService.OnHackResolved.
local sellCallbacks: { (Player, { [string]: any }) -&gt; () } = {}

function SellService.OnSell(callback: (Player, { [string]: any }) -&gt; ())
	table.insert(sellCallbacks, callback)
end

--==========================================================================
-- Hehler finden
--==========================================================================

-- Naechster Hehler zum Spieler. Liefert (part, distanz) oder (nil, math.huge).
function SellService.NearestFence(player: Player): (BasePart?, number)
	local position = Geometry.AlivePosition(player)
	if not position then
		return nil, math.huge
	end

	local best: BasePart? = nil
	local bestDistance = math.huge

	for _, inst in CollectionService:GetTagged(Config.FenceTag) do
		if inst:IsA("BasePart") and inst:IsDescendantOf(workspace) then
			local distance = Geometry.SurfaceDistance(inst, position)
			if distance &lt; bestDistance then
				best, bestDistance = inst, distance
			end
		end
	end

	return best, bestDistance
end

--==========================================================================
-- Verkauf
--==========================================================================

local function reply(player: Player, ok: boolean, reason: string, extra: { [string]: any }?)
	if not player.Parent then
		return
	end
	local payload: { [string]: any } = { Ok = ok, Reason = reason }
	if extra then
		for key, value in extra do
			payload[key] = value
		end
	end
	Remotes.SellResult:FireClient(player, payload)
end

local function onSellRequest(player: Player, payload: any)
	if not RateLimiter.Check(player, "SellRequest") then
		return
	end
	-- Der Client schickt hier bewusst nichts Inhaltliches. Kommt trotzdem
	-- etwas anderes als eine Tabelle an, ist das kein gueltiger Aufruf.
	if payload ~= nil and typeof(payload) ~= "table" then
		return
	end

	if not SaveService.IsReady(player) then
		reply(player, false, "LOADING")
		return
	end

	local fence, distance = SellService.NearestFence(player)
	if not fence then
		reply(player, false, "NO_FENCE")
		return
	end

	-- Distanz wird serverseitig geprueft, exakt wie beim Hacken.
	local range = Config.Sell.Range + Config.Sell.Tolerance
	if distance &gt; range then
		reply(player, false, "RANGE", { Distance = math.floor(distance), Range = Config.Sell.Range })
		return
	end

	local unsold = EconomyService.GetUnsold(player)
	if unsold &lt; Config.Sell.MinAmount then
		reply(player, false, "EMPTY")
		return
	end

	-- Gerechnet und gebucht wird ausschliesslich im EconomyService.
	local gross, fee, net = EconomyService.SellUnsold(player, Config.Sell.FeePercent)
	if net &lt;= 0 and gross &lt;= 0 then
		reply(player, false, "EMPTY")
		return
	end

	-- Der Hehler ist nicht nur eine Bank, sondern der sichere Hafen.
	TraceService.Relieve(player, Config.Sell.TraceRelief)
	SaveService.RequestSave(player)

	reply(player, true, "OK", {
		Gross = gross,
		Fee = fee,
		Net = net,
		Relief = Config.Sell.TraceRelief,
		FenceName = fence:GetAttribute("DisplayName") or fence.Name,
	})

	for _, callback in sellCallbacks do
		task.spawn(function()
			local ok, err = pcall(callback, player, { Gross = gross, Fee = fee, Net = net })
			if not ok then
				warn(("[GHOSTNET] OnSell-Callback fehlgeschlagen: %s"):format(tostring(err)))
			end
		end)
	end
end

--==========================================================================

function SellService.Init()
	Remotes.SellRequest.OnServerEvent:Connect(onSellRequest)

	local count = 0
	for _, inst in CollectionService:GetTagged(Config.FenceTag) do
		if inst:IsA("BasePart") then
			count += 1
		end
	end

	print(("[GHOSTNET] SellService bereit. %d Hehler, Gebuehr %d%%, Trace -%d."):format(
		count,
		math.floor(Config.Sell.FeePercent * 100),
		Config.Sell.TraceRelief
	))
end

return SellService
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="GN34">
<Properties>
<string name="Name">ShopService</string>
<ProtectedString name="Source">-- ServerScriptService/Systems/ShopService.luau
--!strict
-- GHOSTNET :: Rig-Upgrades. Der Grund, warum Crypto etwas wert ist.
--
-- Der Client schickt ausschliesslich, WAS er kaufen will. Den Preis rechnet
-- der Server selbst aus Config.GetUpgradeCost - ein manipuliertes "Cost"-Feld
-- aus dem Client gibt es nicht, weil keins gelesen wird.
--
-- Bezahlt wird aus Banked. Unverkauftes zaehlt nicht: wer aufruesten will,
-- muss vorher zum Hehler.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local EconomyService = require(script.Parent.EconomyService)
local RateLimiter = require(script.Parent.RateLimiter)
local SaveService = require(script.Parent.SaveService)

local ShopService = {}

local function isComponent(name: any): boolean
	if typeof(name) ~= "string" then
		return false
	end
	for _, component in Config.Rig.Components do
		if component == name then
			return true
		end
	end
	return false
end

--==========================================================================
-- Kauf
--==========================================================================

-- Antwortet IMMER mit einer Tabelle { Ok, Reason, ... }. Ein RemoteFunction-
-- Handler darf nicht durchfallen, sonst haengt der Client im Invoke.
local function purchase(player: Player, payload: any): { [string]: any }
	if not RateLimiter.Check(player, "ShopPurchase") then
		return { Ok = false, Reason = "RATE" }
	end
	if typeof(payload) ~= "table" then
		return { Ok = false, Reason = "BAD_PAYLOAD" }
	end

	local component = (payload :: any).Component
	if not isComponent(component) then
		return { Ok = false, Reason = "BAD_PAYLOAD" }
	end

	local profile = SaveService.Get(player)
	if not profile then
		return { Ok = false, Reason = "LOADING" }
	end

	local current = (profile.Rig :: any)[component] :: number
	if current &gt;= Config.Rig.MaxLevel then
		return { Ok = false, Reason = "MAX", Level = current, MaxLevel = Config.Rig.MaxLevel }
	end

	local targetLevel = current + 1
	local cost = Config.GetUpgradeCost(component, targetLevel)
	if cost == math.huge then
		return { Ok = false, Reason = "BAD_PAYLOAD" }
	end

	if profile.Banked &lt; cost then
		return {
			Ok = false,
			Reason = "FUNDS",
			Cost = cost,
			Missing = cost - profile.Banked,
			Level = current,
		}
	end

	if not EconomyService.SpendBanked(player, cost) then
		return { Ok = false, Reason = "FUNDS", Cost = cost, Level = current }
	end
	if not EconomyService.SetRigLevel(player, component, targetLevel) then
		-- Kann eigentlich nicht passieren; wenn doch, Geld zurueck statt weg.
		EconomyService.RefundBanked(player, cost)
		EconomyService.Sync(player)
		return { Ok = false, Reason = "INTERNAL" }
	end

	EconomyService.Sync(player)
	SaveService.RequestSave(player)

	print(("[GHOSTNET] %s kauft %s auf Stufe %d fuer %d CRY."):format(player.Name, component, targetLevel, cost))

	return {
		Ok = true,
		Reason = "OK",
		Component = component,
		Level = targetLevel,
		Cost = cost,
		Snapshot = EconomyService.Snapshot(player),
	}
end

--==========================================================================

function ShopService.Init()
	Remotes.ShopPurchase.OnServerInvoke = function(player: Player, payload: any): { [string]: any }
		local ok, result = pcall(purchase, player, payload)
		if not ok then
			warn(("[GHOSTNET] ShopPurchase ist abgestuerzt: %s"):format(tostring(result)))
			return { Ok = false, Reason = "INTERNAL" }
		end
		return result
	end

	print(("[GHOSTNET] ShopService bereit. Erstes Upgrade ab %d CRY."):format(Config.GetUpgradeCost("Cooling", 2)))
end

return ShopService
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="GN35">
<Properties>
<string name="Name">TimeService</string>
<ProtectedString name="Source">-- ServerScriptService/Systems/TimeService.luau
--!strict
-- GHOSTNET :: Das Licht ueber Vantorra.
--
-- ZWEI BETRIEBSARTEN, EIN SCHALTER: Config.World.PermanentDay
--
--   true (Standard)  Dauerhafter heller Tag. Die Sonne steht fest auf
--                    Config.World.DayClock, es gibt keinen Zyklus und
--                    keinen Heartbeat - das Licht wird EINMAL gesetzt.
--                    Alle Tageszeit-Faktoren sind neutral.
--
--   false            Der komplette alte Zyklus laeuft wieder: 24 Stunden
--                    in DayLengthMinutes, weiche Rampe um Auf- und
--                    Untergang, nachts mehr Ertrag und kuerzere NPC-Sicht.
--
--   Der ganze Zyklus-Code steht bewusst noch hier. Umschalten kostet dann
--   genau eine Zahl in Config und keine Zeile Code irgendwo sonst.
--
-- WO IST DER NACHTBONUS HIN
--   Er haengt jetzt am Ort statt an der Uhrzeit: Config.Cover. Ein Ziel mit
--   Attribut Exposed = true steht auf offener Strasse und zahlt mehr, kostet
--   aber auch mehr Trace. Bei dauerhaftem Tag ist das der ehrlichere Ort
--   dafuer - es gibt keine Dunkelheit mehr, in der man verschwinden koennte.
--
-- DER SERVER IST DIE UHR
--   Lighting-Eigenschaften werden vom Server gesetzt und replizieren zu
--   allen Clients. Kein Client rechnet seine eigene Zeit aus - sonst haetten
--   zwei Spieler unterschiedliche Boni.

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local TimeService = {}

local PERMANENT_DAY = Config.World.PermanentDay

local clock = if PERMANENT_DAY then Config.World.DayClock else Config.World.StartClock -- 0..24
local lastPhase = ""

-- Wer auf den Wechsel reagieren will (Haendler auf/zu, Verkehrsdichte).
local phaseCallbacks: { (string) -&gt; () } = {}

function TimeService.OnPhaseChanged(callback: (string) -&gt; ())
	table.insert(phaseCallbacks, callback)
end

--==========================================================================
-- Lesen
--==========================================================================

function TimeService.GetClock(): number
	return clock
end

function TimeService.IsNight(): boolean
	if PERMANENT_DAY then
		return false
	end
	return clock &gt;= Config.World.NightStartHour or clock &lt; Config.World.DayStartHour
end

function TimeService.IsDay(): boolean
	return not TimeService.IsNight()
end

function TimeService.GetPhase(): string
	return if TimeService.IsNight() then "NIGHT" else "DAY"
end

-- Faktor auf Hack-Ertraege. Bei dauerhaftem Tag immer 1 - der Bonus haengt
-- dann am Ziel (Config.Cover), nicht an der Uhrzeit.
function TimeService.RewardMultiplier(): number
	return if TimeService.IsNight() then 1 + Config.World.NightRewardBonus else 1
end

-- Wie weit NPCs sehen. Bei dauerhaftem Tag immer 1; abweichen kann eine
-- Wache dann nur noch ueber ihr eigenes Attribut "SightFactor".
function TimeService.SightFactor(): number
	return if TimeService.IsNight() then Config.World.NightSightFactor else 1
end

-- Wie stark die Darknet-Kurse schwanken duerfen.
-- Wichtig: bei dauerhaftem Tag ist das 1 und NICHT DayMarketCalm. Der
-- ruhige Tag war die Gegenseite einer bewegten Nacht - ohne Nacht waere
-- daraus eine dauerhafte Drosselung des Darknets geworden.
function TimeService.MarketVolatilityFactor(): number
	if PERMANENT_DAY then
		return 1
	end
	return if TimeService.IsNight() then 1 else Config.World.DayMarketCalm
end

function TimeService.FormatClock(): string
	local hours = math.floor(clock)
	local minutes = math.floor((clock - hours) * 60)
	return ("%02d:%02d"):format(hours, minutes)
end

--==========================================================================
-- Stimmung
-- Alles wird ueber einen weichen Faktor 0 (tiefe Nacht) bis 1 (heller Tag)
-- interpoliert, damit nichts springt.
--==========================================================================

local function daylight(): number
	-- Weiche Rampe um Sonnenauf- und -untergang statt harter Kante.
	local dayStart = Config.World.DayStartHour
	local nightStart = Config.World.NightStartHour
	local ramp = 2 -- Stunden Uebergang

	if clock &gt;= dayStart + ramp and clock &lt;= nightStart - ramp then
		return 1
	elseif clock &gt;= dayStart and clock &lt; dayStart + ramp then
		return (clock - dayStart) / ramp
	elseif clock &gt; nightStart - ramp and clock &lt;= nightStart then
		return (nightStart - clock) / ramp
	end
	return 0
end

local atmosphere: Atmosphere? = nil
local bloom: BloomEffect? = nil
local colour: ColorCorrectionEffect? = nil

local function ensureEffects()
	atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
	if not atmosphere then
		local created = Instance.new("Atmosphere")
		created.Name = "Atmosphere"
		created.Haze = if PERMANENT_DAY then 0.6 else 2
		created.Glare = if PERMANENT_DAY then 0.05 else 0.2
		created.Color = if PERMANENT_DAY
			then Color3.fromRGB(212, 220, 232)
			else Color3.fromRGB(150, 160, 175)
		created.Decay = if PERMANENT_DAY
			then Color3.fromRGB(150, 168, 190)
			else Color3.fromRGB(60, 70, 90)
		created.Parent = Lighting
		atmosphere = created
	end
	bloom = Lighting:FindFirstChildOfClass("BloomEffect")
	colour = Lighting:FindFirstChildOfClass("ColorCorrectionEffect")
end

-- Dauerhafter Tag: einmal setzen, danach nie wieder anfassen.
local function applyDaylight()
	local W = Config.World

	Lighting.ClockTime = W.DayClock
	Lighting.GeographicLatitude = 12 -- Sonne hoch, aber nicht senkrecht
	Lighting.Brightness = W.SunBrightness
	Lighting.ExposureCompensation = 0
	Lighting.FogEnd = W.SunFog
	Lighting.FogStart = 0
	Lighting.OutdoorAmbient = W.SunOutdoorAmbient
	Lighting.Ambient = W.SunAmbient

	if atmosphere then
		atmosphere.Density = W.SunAtmosphere
	end
	if bloom then
		bloom.Intensity = W.SunBloom
	end
	if colour then
		colour.Saturation = W.SunSaturation
		colour.TintColor = W.SunTint
		colour.Brightness = 0
	end
end

local function applyLighting()
	local t = daylight()

	Lighting.ClockTime = clock
	Lighting.FogEnd = Config.World.FogNight + (Config.World.FogDay - Config.World.FogNight) * t

	-- Tagsueber kuehles Blaugrau statt sattem Blau: die Stadt soll auch bei
	-- Tag nicht freundlich wirken.
	Lighting.OutdoorAmbient = Color3.fromRGB(20, 23, 33):Lerp(Color3.fromRGB(96, 104, 116), t)
	Lighting.Ambient = Color3.fromRGB(13, 15, 20):Lerp(Color3.fromRGB(58, 63, 72), t)
	Lighting.Brightness = 1 + t * 1.4

	if atmosphere then
		atmosphere.Density = Config.World.AtmosphereDensityNight
			+ (Config.World.AtmosphereDensityDay - Config.World.AtmosphereDensityNight) * t
	end
	if bloom then
		bloom.Intensity = Config.World.BloomNight + (Config.World.BloomDay - Config.World.BloomNight) * t
	end
	if colour then
		colour.Saturation = 0.08 - t * 0.12 -- tagsueber ausgewaschener
		colour.TintColor = Color3.fromRGB(230, 248, 255):Lerp(Color3.fromRGB(226, 230, 234), t)
	end
end

--==========================================================================
-- Senden
--==========================================================================

local function payload(): { [string]: any }
	return {
		Clock = clock,
		Text = TimeService.FormatClock(),
		IsNight = TimeService.IsNight(),
		RewardBonus = TimeService.RewardMultiplier() - 1,
		DayLengthMinutes = Config.World.DayLengthMinutes,
		PermanentDay = PERMANENT_DAY,
	}
end

function TimeService.SyncTo(player: Player)
	if player.Parent then
		Remotes.TimeSync:FireClient(player, payload())
	end
end

local function broadcast()
	local data = payload()
	for _, player in Players:GetPlayers() do
		Remotes.TimeSync:FireClient(player, data)
	end
end

--==========================================================================

function TimeService.Init()
	-- Technology ist umschaltbar, damit man auf schwachen Geraeten von
	-- Future auf ShadowMap zurueckgehen kann, ohne Code anzufassen.
	local ok = pcall(function()
		Lighting.Technology = (Enum.Technology :: any)[Config.World.LightingTechnology]
	end)
	if not ok then
		warn(("[GHOSTNET] Unbekannte Lighting.Technology '%s' - Roblox-Standard bleibt."):format(
			tostring(Config.World.LightingTechnology)
		))
	end

	Lighting.GlobalShadows = true
	ensureEffects()

	Players.PlayerAdded:Connect(function(player)
		task.defer(TimeService.SyncTo, player)
	end)
	for _, player in Players:GetPlayers() do
		task.defer(TimeService.SyncTo, player)
	end

	if PERMANENT_DAY then
		-- Kein Zyklus, also auch kein Heartbeat. Das Licht steht.
		applyDaylight()
		lastPhase = "DAY"
		print(("[GHOSTNET] TimeService bereit. Dauerhafter Tag (%s Uhr)."):format(TimeService.FormatClock()))
		return
	end

	applyLighting()

	-- 24 Spielstunden pro DayLengthMinutes Echtzeit.
	local hoursPerSecond = 24 / (Config.World.DayLengthMinutes * 60)
	local accumulator = 0
	local sinceBroadcast = 0

	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator &lt; Config.World.TimeTick then
			return
		end
		local step = accumulator
		accumulator = 0

		clock = (clock + hoursPerSecond * step) % 24
		applyLighting()

		local phase = TimeService.GetPhase()
		if phase ~= lastPhase then
			lastPhase = phase
			print(("[GHOSTNET] Es wird %s (%s Uhr)."):format(
				if phase == "NIGHT" then "Nacht" else "Tag",
				TimeService.FormatClock()
			))
			for _, callback in phaseCallbacks do
				task.spawn(function()
					local success, err = pcall(callback, phase)
					if not success then
						warn(("[GHOSTNET] Tageszeit-Callback fehlgeschlagen: %s"):format(tostring(err)))
					end
				end)
			end
			broadcast()
			sinceBroadcast = 0
			return
		end

		-- Zwischendurch nur selten senden: der Client hat die Uhr ohnehin
		-- ueber Lighting.ClockTime und braucht das Paket nur fuer den Bonus.
		sinceBroadcast += step
		if sinceBroadcast &gt;= 5 then
			sinceBroadcast = 0
			broadcast()
		end
	end)

	lastPhase = TimeService.GetPhase()
	print(("[GHOSTNET] TimeService bereit. %s Uhr, ein Tag dauert %d Minuten."):format(
		TimeService.FormatClock(),
		Config.World.DayLengthMinutes
	))
end

return TimeService
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="GN36">
<Properties>
<string name="Name">TraceService</string>
<ProtectedString name="Source">-- ServerScriptService/Systems/TraceService.luau
--!strict
-- GHOSTNET :: Der Trace. Ohne Risiko ist Hacken nur Klicken.
--
-- SO FUNKTIONIERT ER
--   Jeder Spieler hat einen Wert von 0 bis Config.Trace.Max. Jeder Hack
--   treibt ihn hoch - ein Fehlschlag billiger als ein Erfolg, ein Abbruch am
--   billigsten, aber nie gratis. Im Leerlauf faellt er wieder, schneller mit
--   besserer Kuehlung. Ein Verkauf beim Hehler nimmt ein grosses Stueck weg.
--
--   Bei Max ist alles Unverkaufte weg, der Trace faellt auf Config.Trace.AfterBust
--   zurueck und Hacks sind kurz gesperrt. Genau diese Drohung macht die Frage
--   "noch ein Ziel oder jetzt abliefern?" zu einer echten Entscheidung.
--
-- ABHAENGIGKEITEN
--   Der Service kennt den HackService NICHT. Wer beim Bust etwas abbrechen
--   will, meldet sich per TraceService.OnBust an - so bleibt die Richtung
--   HackService -&gt; TraceService und es entsteht kein Require-Kreis.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Types = require(ReplicatedStorage.Shared.Types)

local EconomyService = require(script.Parent.EconomyService)
local SaveService = require(script.Parent.SaveService)

type Profile = Types.Profile

local TraceService = {}

-- Alle Zeiten hier sind os.clock(): reine Kurzzeit-Timer innerhalb dieses
-- Serverlaufs. Der Trace-WERT selbst liegt im Profil und wird gespeichert.
local lastActivity: { [Player]: number } = {}
local lockedUntil: { [Player]: number } = {}
local lastSyncAt: { [Player]: number } = {}
local lastSyncValue: { [Player]: number } = {}

local bustCallbacks: { (Player, number) -&gt; () } = {}

--==========================================================================
-- Anzeige
--==========================================================================

local function lockSecondsLeft(player: Player): number
	local until_ = lockedUntil[player]
	if not until_ then
		return 0
	end
	return math.max(0, until_ - os.clock())
end

-- force = sofort schicken (Hack, Verkauf, Bust). Ohne force wird nur
-- geschickt, wenn sich sichtbar etwas geaendert hat - der Abkuehl-Loop
-- laeuft sonst mit 4 Paketen pro Sekunde und Spieler.
function TraceService.Sync(player: Player, force: boolean?, bustInfo: { [string]: any }?)
	if not player.Parent then
		return
	end
	local profile = SaveService.Get(player)
	if not profile then
		return
	end

	local now = os.clock()
	if not force then
		local sinceSync = now - (lastSyncAt[player] or 0)
		local delta = math.abs(profile.Trace - (lastSyncValue[player] or -1))
		if sinceSync &lt; Config.Trace.SyncInterval or delta &lt; Config.Trace.SyncEpsilon then
			return
		end
	end

	lastSyncAt[player] = now
	lastSyncValue[player] = profile.Trace

	Remotes.TraceSync:FireClient(player, {
		Trace = profile.Trace,
		Max = Config.Trace.Max,
		Locked = lockSecondsLeft(player) &gt; 0,
		LockSeconds = lockSecondsLeft(player),
		Bust = bustInfo,
	})
end

--==========================================================================
-- Lesen
--==========================================================================

function TraceService.Get(player: Player): number
	local profile = SaveService.Get(player)
	return if profile then profile.Trace else 0
end

function TraceService.IsLocked(player: Player): boolean
	return lockSecondsLeft(player) &gt; 0
end

function TraceService.LockSecondsLeft(player: Player): number
	return lockSecondsLeft(player)
end

-- Wird beim Bust aufgerufen: (spieler, verlorene Crypto).
function TraceService.OnBust(callback: (Player, number) -&gt; ())
	table.insert(bustCallbacks, callback)
end

--==========================================================================
-- Schreiben
--==========================================================================

local function bust(player: Player, profile: Profile)
	local lost = EconomyService.WipeUnsold(player)
	EconomyService.CountBust(player)

	profile.Trace = Config.Trace.AfterBust
	lockedUntil[player] = os.clock() + Config.Trace.BustLockSeconds
	lastActivity[player] = os.clock()

	warn(("[GHOSTNET] BUST: %s verliert %d CRY."):format(player.Name, lost))

	for _, callback in bustCallbacks do
		task.spawn(callback, player, lost)
	end

	TraceService.Sync(player, true, { Lost = lost, LockSeconds = Config.Trace.BustLockSeconds })
	SaveService.RequestSave(player)
end

-- Der einzige Weg, den Trace zu erhoehen. Wird vom HackService mit dem dort
-- bereits berechneten traceDelta aufgerufen.
function TraceService.Add(player: Player, amount: number)
	if amount &lt;= 0 then
		return
	end
	local profile = SaveService.Get(player)
	if not profile then
		return
	end

	lastActivity[player] = os.clock()
	profile.Trace = math.min(Config.Trace.Max, profile.Trace + amount)

	if profile.Trace &gt;= Config.Trace.Max then
		bust(player, profile)
	else
		TraceService.Sync(player, true)
	end
end

-- Verkauf beim Hehler. Der Hehler ist damit nicht nur eine Bank, sondern der
-- sichere Hafen.
function TraceService.Relieve(player: Player, amount: number)
	if amount &lt;= 0 then
		return
	end
	local profile = SaveService.Get(player)
	if not profile then
		return
	end
	profile.Trace = math.max(0, profile.Trace - amount)
	TraceService.Sync(player, true)
end

--==========================================================================
-- Abkuehlung
--==========================================================================

local function decayLoop()
	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator &lt; Config.Trace.DecayTick then
			return
		end
		local step = accumulator
		accumulator = 0

		local now = os.clock()
		for _, player in Players:GetPlayers() do
			local profile = SaveService.Get(player)
			if not profile then
				continue
			end

			-- Sperre gerade abgelaufen: einmal melden, damit der HUD aufmacht.
			local until_ = lockedUntil[player]
			if until_ and now &gt;= until_ then
				lockedUntil[player] = nil
				TraceService.Sync(player, true)
			end

			if profile.Trace &lt;= 0 then
				continue
			end
			if now - (lastActivity[player] or 0) &lt; Config.Trace.DecayDelay then
				continue
			end

			profile.Trace = math.max(0, profile.Trace - Config.GetTraceDecay(profile.Rig.Cooling) * step)
			TraceService.Sync(player, false)
		end
	end)
end

--==========================================================================

function TraceService.Init()
	SaveService.OnReady(function(player)
		lastActivity[player] = os.clock()
		TraceService.Sync(player, true)
	end)

	Players.PlayerRemoving:Connect(function(player)
		lastActivity[player] = nil
		lockedUntil[player] = nil
		lastSyncAt[player] = nil
		lastSyncValue[player] = nil
	end)

	decayLoop()

	print(("[GHOSTNET] TraceService bereit. Bust bei %d, Abkuehlung %.2f/s."):format(
		Config.Trace.Max,
		Config.Trace.DecayPerSecond
	))
end

return TraceService
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="GN37">
<Properties>
<string name="Name">TrafficService</string>
<ProtectedString name="Source">-- ServerScriptService/Systems/TrafficService.luau
--!strict
-- GHOSTNET :: Verkehr und Fussgaenger.
--
-- DER PERFORMANCEKRITISCHSTE TEIL DES PROJEKTS. Falsch gebaut ruiniert er
-- die Bildrate und damit das Spiel. Deshalb vier harte Entscheidungen:
--
--   1. KEIN PathfindingService. Die Autos folgen dem festen Graphen aus
--      RoadNetwork, Kante fuer Kante. Ein Pfad pro Auto, mehrfach pro
--      Sekunde neu berechnet, frisst den Server auf.
--   2. KEINE Physik. Verkehrsautos sind Anchored und werden per
--      Model:PivotTo bewegt. Sie kollidieren nicht echt - sie bremsen,
--      wenn auf ihrer eigenen Kante jemand vor ihnen ist.
--
--      MERKE, DAS WAR EIN ECHTER BUG: frueher wurde nur die CFrame des
--      Body-Parts gesetzt und das Dach per WeldConstraint "verbunden".
--      Eine WeldConstraint gilt fuer die PHYSIKSIMULATION. Zwischen zwei
--      Anchored-Teilen tut sie gar nichts, und ein direktes Setzen von
--      .CFrame ist keine Simulation. Ergebnis: jedes Auto liess sein Dach
--      an der Spawn-Position stehen und fuhr ohne weiter.
--      -&gt; Modelle IMMER als Ganzes ueber PivotTo bewegen.
--   3. KEIN Humanoid fuer Fussgaenger. Humanoids sind teuer. Hintergrund-
--      leute sind bewegte Modelle ohne Humanoid.
--   4. POOL statt Instance.new/Destroy im Sekundentakt, harte Obergrenze,
--      und nur im Radius um Spieler aktiv.
--
-- Abstandspruefung laeuft NUR gegen die eigene Kante, nicht gegen alle Autos.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Geometry = require(ReplicatedStorage.Shared.Geometry)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local AssetLibrary = require(ReplicatedStorage.Shared.AssetLibrary)
local Vehicles = require(ReplicatedStorage.Shared.Vehicles)

local RateLimiter = require(script.Parent.RateLimiter)
local RoadNetwork = require(script.Parent.RoadNetwork)
local TimeService = require(script.Parent.TimeService)
local PursuitService = require(script.Parent.PursuitService)
local TraceService = require(script.Parent.TraceService)
local VehicleChassis = require(script.Parent.VehicleChassis)

local TrafficService = {}

local T = Config.Traffic
local rng = Random.new()

type Car = {
	Model: Model,
	Body: BasePart, -- PrimaryPart, nur fuer Positionsabfragen
	From: number,
	To: number,
	Alpha: number,
	Speed: number,
	Active: boolean,
	ClassId: string,
	-- Aus der echten Modellhoehe gerechnet, nicht geraten. Ein anderes
	-- Modell hat eine andere Hoehe und soll trotzdem auf der Strasse stehen.
	GroundOffset: number,
}

type Walker = {
	Model: Model,
	Body: BasePart, -- PrimaryPart
	From: number,
	To: number,
	Alpha: number,
	Side: number,
	Active: boolean,
	GroundOffset: number,
}

local cars: { Car } = {}
local walkers: { Walker } = {}
local container: Folder? = nil

-- Belegung pro Kante, damit die Abstandspruefung nicht jedes Auto gegen
-- jedes andere testen muss.
local laneOccupancy: { [string]: { number } } = {}

local function laneKey(from: number, to: number): string
	return ("%d&gt;%d"):format(from, to)
end

-- Oberkante der Fahrbahnplatte. Die Knoten liegen auf y = 0, die Platte ist
-- um sie zentriert.
local ROAD_TOP = Config.City.RoadThickness * 0.5

-- Wie hoch der Pivot des Modells ueber dem Knoten liegen muss, damit das
-- Modell AUF der Strasse steht statt darin oder darueber. Aus der echten
-- Modellhoehe gerechnet - eine feste Zahl waere beim naechsten Modell falsch.
local function groundOffsetFor(model: Model): number
	local ok, extents = pcall(function()
		return model:GetExtentsSize()
	end)
	local height = if ok and extents then extents.Y else 0
	return ROAD_TOP + height * 0.5 + T.GroundClearance
end

--==========================================================================
-- Bauteile aus dem Pool
--==========================================================================

local function ensureContainer(): Folder
	if container and container.Parent then
		return container
	end
	local folder = Instance.new("Folder")
	folder.Name = "GhostNet_Traffic"
	folder.Parent = workspace
	container = folder
	return folder
end

-- Welche Klasse dieses Verkehrsauto ist. Aus dem Katalog, damit ein
-- gestohlenes Auto immer eine echte, kaufbare Klasse ist.
local function randomClass(): Vehicles.VehicleClass
	local list = Vehicles.List
	return list[rng:NextInteger(1, #list)]
end

-- EIN Modell fuer Verkehr und Spielerfahrzeug. Das ist der Punkt: beim
-- Kurzschliessen wird das Verkehrsmodell entfernt und an derselben Stelle
-- das echte Fahrzeug erzeugt - und weil beide dieselbe Vorlage benutzen,
-- sieht man den Wechsel nicht.
--
-- Unterschied zum Spielerfahrzeug: alles Anchored, keine Constraints, kein
-- Antrieb. Kulisse, die sich bewegt.
local function buildCarShell(): (Model, BasePart, string)
	local class = randomClass()
	local model = AssetLibrary.Clone("Vehicles", class.Asset, class.BodySize)
	model.Name = "TrafficCar"

	local pivot = model.PrimaryPart
	if not pivot then
		local chassis = AssetLibrary.Find(model, "Chassis")
		if chassis and chassis:IsA("BasePart") then
			pivot = chassis
		else
			-- Ohne Pivot koennte PivotTo nur die Bounding-Box benutzen und
			-- das Auto stuende schief in der Strasse. Lieber laut sein.
			warn(("[GHOSTNET] Verkehrsvorlage '%s' hat weder PrimaryPart noch Chassis."):format(class.Asset))
			pivot = model:FindFirstChildWhichIsA("BasePart", true)
		end
	end
	local body = pivot :: BasePart
	model.PrimaryPart = body

	-- Kulisse: nichts rechnet Physik, nichts wird abgefragt.
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.Anchored = true
			descendant.CanTouch = false
			descendant.CanQuery = false
			descendant.CanCollide = descendant == body
			if descendant ~= body then
				descendant.CastShadow = false
			end
		end
	end
	body.CanQuery = true -- der Diebstahl-Prompt braucht Abfragbarkeit

	-- Der Diebstahl-Prompt. Halten statt tippen, damit es nicht aus Versehen
	-- passiert.
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "StealPrompt"
	prompt.ActionText = "Kurzschliessen"
	prompt.ObjectText = class.Name
	prompt.HoldDuration = T.StealHoldSeconds
	prompt.MaxActivationDistance = T.StealRange
	prompt.RequiresLineOfSight = false
	prompt.Parent = body

	-- Der Prompt feuert direkt serverseitig. Der Client meldet nichts, was
	-- geprueft werden muesste - er tippt nur.
	prompt.Triggered:Connect(function(player)
		TrafficService.HandleSteal(player)
	end)

	model:SetAttribute("ClassId", class.Id)
	CollectionService:AddTag(model, Config.SmoothTag)
	model.Parent = ensureContainer()
	return model, body, class.Id
end

local function buildWalkerShell(): (Model, BasePart)
	-- Bewusst KEIN Humanoid: ein Humanoid pro Fussgaenger kostet mehr als
	-- der gesamte restliche Fussgaenger zusammen. Das gilt auch fuer ein
	-- fertiges Modell aus Assets/Characters - geklont wird Geometrie, und
	-- ein Humanoid darin waere ein Fehler in der Vorlage.
	local model = AssetLibrary.Clone("Characters", "Pedestrian", T.PedestrianSize)
	model.Name = "Pedestrian"

	local pivot = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
	if not pivot then
		warn("[GHOSTNET] Fussgaengervorlage enthaelt keinen einzigen BasePart.")
		local fallback = Instance.new("Part")
		fallback.Size = T.PedestrianSize
		fallback.Parent = model
		pivot = fallback
	end
	local body = pivot :: BasePart
	model.PrimaryPart = body

	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.Anchored = true
			descendant.CanCollide = false
			descendant.CanQuery = false
			descendant.CanTouch = false
			descendant.CastShadow = false
		end
	end

	CollectionService:AddTag(model, Config.SmoothTag)
	model.Parent = ensureContainer()
	return model, body
end

--==========================================================================
-- Spieler in der Naehe?
--==========================================================================

local function nearAnyPlayer(position: Vector3, radius: number): boolean
	for _, player in Players:GetPlayers() do
		local at = Geometry.AlivePosition(player)
		if at and (at - position).Magnitude &lt;= radius then
			return true
		end
	end
	return false
end

local function randomActiveNode(): number?
	-- Eine Kreuzung in der Naehe irgendeines Spielers - sonst spawnt Verkehr
	-- am anderen Ende der Stadt, wo ihn keiner sieht.
	local candidates: { number } = {}
	for _, player in Players:GetPlayers() do
		local at = Geometry.AlivePosition(player)
		if at then
			local node = RoadNetwork.NearestNode(at)
			if node then
				for _, linkId in node.Links do
					table.insert(candidates, linkId)
				end
			end
		end
	end
	if #candidates == 0 then
		return nil
	end
	return candidates[rng:NextInteger(1, #candidates)]
end

--==========================================================================
-- Verkehr
--==========================================================================

local function placeCar(car: Car)
	local position, direction = RoadNetwork.LanePosition(car.From, car.To, car.Alpha)
	if not position or not direction then
		car.Active = false
		return
	end
	local lift = Vector3.new(0, car.GroundOffset, 0)
	-- PivotTo statt .CFrame: bewegt ALLE Teile des Modells, unabhaengig von
	-- Anchored. Genau das war der Dach-Bug.
	car.Model:PivotTo(CFrame.lookAt(position + lift, position + direction + lift))
end

local function spawnCar()
	local startId = randomActiveNode()
	if not startId then
		return
	end
	local toId = RoadNetwork.NextNode(startId, nil, rng)
	if not toId then
		return
	end

	local free: Car? = nil
	for _, car in cars do
		if not car.Active then
			free = car
			break
		end
	end

	if not free then
		if #cars &gt;= T.MaxActive then
			return
		end
		local model, body, classId = buildCarShell()
		free = {
			Model = model,
			Body = body,
			From = startId,
			To = toId,
			Alpha = 0,
			Speed = T.Speed,
			Active = true,
			ClassId = classId,
			GroundOffset = groundOffsetFor(model),
		}
		table.insert(cars, free :: Car)
	end

	local car = free :: Car
	car.From = startId
	car.To = toId
	car.Alpha = rng:NextNumber(0, 0.4)
	car.Speed = T.Speed + rng:NextNumber(-T.SpeedJitter, T.SpeedJitter)
	car.Active = true
	car.Model.Parent = ensureContainer()
	placeCar(car)
end

local function recycle(car: Car)
	car.Active = false
	car.Model.Parent = nil
end

-- Bremsen, wenn auf der eigenen Kante jemand kurz vor einem faehrt.
local function blockedAhead(car: Car, index: number): boolean
	local ids = laneOccupancy[laneKey(car.From, car.To)]
	if not ids then
		return false
	end
	for _, otherIndex in ids do
		if otherIndex == index then
			continue
		end
		local other = cars[otherIndex]
		if other and other.Active then
			local gap = (other.Alpha - car.Alpha) * Config.City.BlockSize
			if gap &gt; 0 and gap &lt; T.StopDistance then
				return true
			end
		end
	end
	return false
end

local function stepTraffic(dt: number)
	table.clear(laneOccupancy)
	for index, car in cars do
		if car.Active then
			local key = laneKey(car.From, car.To)
			local list = laneOccupancy[key]
			if not list then
				list = {}
				laneOccupancy[key] = list
			end
			table.insert(list, index)
		end
	end

	for index, car in cars do
		if not car.Active then
			continue
		end

		-- Ausserhalb des Radius: anhalten und recyceln statt weiterrechnen.
		if not nearAnyPlayer(car.Body.Position, T.ActiveRadius) then
			recycle(car)
			continue
		end

		if blockedAhead(car, index) then
			continue -- steht, faehrt aber nicht rueckwaerts oder verschwindet
		end

		car.Alpha += (car.Speed * dt) / Config.City.BlockSize
		if car.Alpha &gt;= 1 then
			local nextId = RoadNetwork.NextNode(car.To, car.From, rng)
			if not nextId then
				recycle(car)
				continue
			end
			car.From = car.To
			car.To = nextId
			car.Alpha = 0
		end

		placeCar(car)
	end
end

--==========================================================================
-- Fussgaenger
--==========================================================================

local function placeWalker(walker: Walker)
	local position, direction = RoadNetwork.LanePosition(walker.From, walker.To, walker.Alpha)
	if not position or not direction then
		walker.Active = false
		return
	end
	local right = Vector3.new(-direction.Z, 0, direction.X)
	local offset = right * (walker.Side * (Config.City.RoadWidth * 0.5 + Config.City.SidewalkWidth * 0.4))
	local at = position + offset + Vector3.new(0, walker.GroundOffset, 0)
	-- Frueher wurden Kopf und Rumpf einzeln gesetzt. Ein Modell, ein PivotTo.
	walker.Model:PivotTo(CFrame.lookAt(at, at + direction))
end

local function spawnWalker()
	local startId = randomActiveNode()
	if not startId then
		return
	end
	local toId = RoadNetwork.NextNode(startId, nil, rng)
	if not toId then
		return
	end

	local free: Walker? = nil
	for _, walker in walkers do
		if not walker.Active then
			free = walker
			break
		end
	end

	if not free then
		if #walkers &gt;= T.MaxPedestrians then
			return
		end
		local model, body = buildWalkerShell()
		free = {
			Model = model,
			Body = body,
			From = startId,
			To = toId,
			Alpha = 0,
			Side = 1,
			Active = true,
			-- Gehweg statt Fahrbahn: die Platte ist ein wenig hoeher.
			GroundOffset = groundOffsetFor(model) + Config.City.SidewalkLift,
		}
		table.insert(walkers, free :: Walker)
	end

	local walker = free :: Walker
	walker.From = startId
	walker.To = toId
	walker.Alpha = rng:NextNumber(0, 1)
	walker.Side = if rng:NextNumber() &lt; 0.5 then -1 else 1
	walker.Active = true
	walker.Model.Parent = ensureContainer()
	placeWalker(walker)
end

local function stepWalkers(dt: number)
	for _, walker in walkers do
		if not walker.Active then
			continue
		end
		if not nearAnyPlayer(walker.Body.Position, T.ActiveRadius) then
			walker.Active = false
			walker.Model.Parent = nil
			continue
		end

		walker.Alpha += (T.PedestrianSpeed * dt) / Config.City.BlockSize
		if walker.Alpha &gt;= 1 then
			local nextId = RoadNetwork.NextNode(walker.To, walker.From, rng)
			if not nextId then
				walker.Active = false
				walker.Model.Parent = nil
				continue
			end
			walker.From = walker.To
			walker.To = nextId
			walker.Alpha = 0
		end
		placeWalker(walker)
	end
end

--==========================================================================
-- Diebstahl
-- Aus einem Kulissenauto wird ein echtes Physikfahrzeug. Danach faehrt es
-- sich exakt wie ein gekauftes - es IST dieselbe Klasse.
--==========================================================================

function TrafficService.HandleSteal(player: Player)
	if not RateLimiter.Check(player, "StealVehicle") then
		return
	end
	local position = Geometry.AlivePosition(player)
	if not position then
		return
	end

	-- Naechstes aktives Verkehrsauto in Reichweite. Distanz serverseitig.
	local target: Car? = nil
	local bestDistance = math.huge
	for _, car in cars do
		if not car.Active then
			continue
		end
		local distance = (car.Body.Position - position).Magnitude
		if distance &lt;= T.StealRange + Config.Range.Tolerance and distance &lt; bestDistance then
			target, bestDistance = car, distance
		end
	end
	if not target then
		return
	end

	-- Genau dort weitermachen, wo das Kulissenauto stand. Beide benutzen
	-- dieselbe Vorlage, also darf der Uebergang nicht sichtbar springen:
	-- Pivot des MODELLS uebernehmen, nicht die Position eines Einzelteils.
	local cframe = target.Model:GetPivot()

	-- Die Lackierung mitnehmen, damit es dasselbe Auto bleibt. Die Farbe
	-- steht an der Karosserie, nicht am Chassis.
	local paint: Color3? = nil
	local shellBody = AssetLibrary.Find(target.Model, "Body")
	if shellBody and shellBody:IsA("BasePart") then
		paint = shellBody.Color
	end

	recycle(target)

	local model = VehicleChassis.Build(target.ClassId, cframe, paint)
	if not model then
		return
	end

	-- Autodiebstahl haengt am Trace, statt danebenherzulaufen.
	TraceService.Add(player, T.StealTrace)
	PursuitService.AddHeat(player, 1)
	print(("[GHOSTNET] %s hat ein Auto kurzgeschlossen (+%d Trace)."):format(player.Name, T.StealTrace))
end

--==========================================================================

function TrafficService.ActiveCount(): (number, number)
	local carCount, walkerCount = 0, 0
	for _, car in cars do
		if car.Active then
			carCount += 1
		end
	end
	for _, walker in walkers do
		if walker.Active then
			walkerCount += 1
		end
	end
	return carCount, walkerCount
end

function TrafficService.Init()
	RoadNetwork.Build()
	Remotes.StealVehicle.OnServerEvent:Connect(TrafficService.HandleSteal)

	-- Bewegungstakt. Bewusst ein eigener, gestaffelter Tick statt eines
	-- Heartbeat-Handlers, der ueber alles laeuft.
	task.spawn(function()
		local last = os.clock()
		while true do
			task.wait(T.Tick)
			local now = os.clock()
			local dt = now - last
			last = now
			local ok, err = pcall(function()
				stepTraffic(dt)
				stepWalkers(dt)
			end)
			if not ok then
				warn(("[GHOSTNET] Verkehrstakt fehlgeschlagen: %s"):format(tostring(err)))
			end
		end
	end)

	-- Nachfuellen. Nachts duenner - greift nur, wenn der Tag-/Nachtzyklus
	-- laeuft. Bei Config.World.PermanentDay ist IsNight() immer false, die
	-- Stadt faehrt also dauerhaft am vollen Limit.
	--
	-- ACHTUNG BEIM MESSEN: frueher startete der Server nachts, also mit der
	-- halben Menge. Wer jetzt zum ersten Mal in den MicroProfiler schaut,
	-- sieht die doppelte Last gegenueber dem alten Standardzustand.
	-- T.MaxActive ist und bleibt der wichtigste Regler.
	task.spawn(function()
		while true do
			task.wait(T.SpawnTick)
			if #Players:GetPlayers() == 0 then
				continue
			end
			local carCount, walkerCount = TrafficService.ActiveCount()
			local carTarget = if TimeService.IsNight() then math.floor(T.MaxActive * 0.5) else T.MaxActive
			local walkerTarget = if TimeService.IsNight()
				then math.floor(T.MaxPedestrians * 0.4)
				else T.MaxPedestrians

			if carCount &lt; carTarget then
				spawnCar()
			end
			if walkerCount &lt; walkerTarget then
				spawnWalker()
			end
		end
	end)

	print(("[GHOSTNET] TrafficService bereit. Max %d Autos, %d Fussgaenger, Radius %d."):format(
		T.MaxActive,
		T.MaxPedestrians,
		T.ActiveRadius
	))
end

return TrafficService
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="GN38">
<Properties>
<string name="Name">VehicleChassis</string>
<ProtectedString name="Source">-- ServerScriptService/Systems/VehicleChassis.luau
--!strict
-- GHOSTNET :: Fahrzeuge VERDRAHTEN, nicht bauen.
--
-- WAS SICH GEAENDERT HAT
--   Frueher hat dieses Modul die Karosserie selbst aus Parts zusammengesetzt:
--   ein Kasten Body, ein Kasten Dach, vier Zylinder, zwei Kaestchen Licht.
--   Das ist die Decke - kein Material und kein Licht macht aus einem Quader
--   ein Auto. Ein Auto braucht Motorhaube, Kotfluegel, abfallende Dachlinie,
--   Radkaesten, Fenster mit Rahmen. Das sind zwei Dutzend geformte Flaechen,
--   und die entstehen in Blender oder Studio, nicht zur Laufzeit.
--
--   Jetzt gilt: die Karosserie kommt als fertiges Modell aus
--   ReplicatedStorage/Assets/Vehicles, dieses Modul haengt Physik daran.
--
-- WAS EIN FAHRZEUGMODELL ENTHALTEN MUSS (Config.Assets.VehicleRequired)
--   Sedan (Model)
--   |-- Chassis     Part, unsichtbar, PrimaryPart - die Kollisionsbox
--   |-- Body        MeshPart, die sichtbare Karosserie
--   |-- Glass       MeshPart, Fenster                    (optional)
--   |-- Wheels/     FL, FR, RL, RR   (bei 2 Raedern: F, R)
--   |-- Lights/     HeadL, HeadR, TailL, TailR           (optional)
--   +-- DriveSeat   VehicleSeat
--
--   Name faengt mit F an = gelenkt, mit R an = angetrieben. Damit passt
--   dieselbe Verdrahtung auf Auto und Motorrad.
--
--   Fehlt ein Pflichtteil, gibt es eine klare Meldung mit Modellname UND
--   fehlendem Teil - keinen stillen Absturz und kein halb fahrendes Auto.
--
-- KOLLISION SAUBER GETRENNT
--   Nur Chassis kollidiert mit der Welt. Karosserie, Glas und Lichter sind
--   CanCollide = false. Sonst haengt das Auto an jeder Kante fest, weil
--   zwei Dutzend Einzelflaechen gleichzeitig kollidieren.
--   Raeder kollidieren, aber in einer eigenen CollisionGroup: sie sollen den
--   Boden treffen und nicht die Raeder des Nachbarautos.
--
-- AUFBAU PRO RAD (in dieser Reihenfolge wichtig)
--   Chassis --SpringConstraint--&gt; Radtraeger      Federung
--   Chassis --CylindricalConstraint--&gt; Radtraeger senkrechte Achse:
--                                                 Federweg + LENKUNG (Servo)
--   Radtraeger --CylindricalConstraint--&gt; Rad     seitliche Achse:
--                                                 ANTRIEB (Motor)
--   Der Radtraeger ist noetig, weil eine einzelne Achse nicht gleichzeitig
--   Federweg (senkrecht) und Raddrehung (seitlich) sein kann.
--
-- NETZWERKBESITZ UND SICHERHEIT
--   Beim Einsteigen bekommt der Client den Besitz ueber alle Fahrzeugteile.
--   Ohne das faehrt sich das Auto wie durch Sirup, weil jede Eingabe eine
--   Rundreise zum Server braucht.
--   FOLGE: Der Client besitzt die Fahrzeugphysik. Er kann also Position und
--   Tempo faelschen. Deshalb gibt dieses Modul NIEMALS eine Belohnung und
--   liest NIEMALS eine Position als Beweis. Wer irgendwo ankommen muss, wird
--   ueber einen serverseitigen Trigger geprueft - genau wie beim Hacken.

local CollectionService = game:GetService("CollectionService")
local PhysicsService = game:GetService("PhysicsService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local AssetLibrary = require(ReplicatedStorage.Shared.AssetLibrary)
local Config = require(ReplicatedStorage.Shared.Config)
local Vehicles = require(ReplicatedStorage.Shared.Vehicles)

local VehicleChassis = {}

type VehicleClass = Vehicles.VehicleClass

local FOLDER_NAME = "GhostNet_Vehicles"
local A = Config.Assets

local function container(): Folder
	local existing = workspace:FindFirstChild(FOLDER_NAME)
	if existing and existing:IsA("Folder") then
		return existing
	end
	local folder = Instance.new("Folder")
	folder.Name = FOLDER_NAME
	folder.Parent = workspace
	return folder
end

local function physical(density: number, friction: number, elasticity: number): PhysicalProperties
	return PhysicalProperties.new(density, friction, elasticity, 100, 1)
end

local function attachment(parent: BasePart, name: string, position: Vector3, axis: Vector3, secondary: Vector3): Attachment
	local a = Instance.new("Attachment")
	a.Name = name
	a.Position = position
	a.Axis = axis
	a.SecondaryAxis = secondary
	a.Parent = parent
	return a
end

--==========================================================================
-- PLATZHALTER
--
-- Der einzige Ort in diesem Modul, an dem noch Geometrie entsteht - und das
-- ist Absicht. Solange eine Vorlage fehlt, soll das Spiel FAHRBAR bleiben,
-- aber unuebersehbar unfertig aussehen. Deshalb: magenta Kasten, vier
-- Zylinder, sonst nichts. Kein Dach, keine Lichter, keine Farbwahl.
--
-- Sobald Assets/Vehicles/&lt;Name&gt; existiert, wird dieser Zweig nie wieder
-- betreten. Er ist eine Baustellenabsperrung, kein Fahrzeugdesign.
--==========================================================================

local function placeholderVehicle(class: VehicleClass): Model
	local model = AssetLibrary.Placeholder("Vehicles", class.Asset, class.BodySize)
	local block = model.PrimaryPart :: BasePart

	-- Der Platzhalterklotz wird zur unsichtbaren Kollisionsbox, damit das
	-- Modell denselben Vertrag erfuellt wie eine echte Vorlage.
	block.Name = "Chassis"
	block.Transparency = 1
	block.CanCollide = true

	local body = Instance.new("Part")
	body.Name = "Body"
	body.Size = class.BodySize * A.PlaceholderBodyScale
	body.Color = A.PlaceholderColour
	body.Material = Enum.Material.SmoothPlastic
	body.CFrame = block.CFrame
	body.Parent = model

	local wheels = Instance.new("Folder")
	wheels.Name = "Wheels"
	wheels.Parent = model

	local halfX = class.BodySize.X * 0.5
	local halfZ = class.BodySize.Z * 0.5
	local wheelY = -class.BodySize.Y * 0.5

	local slots: { { name: string, offset: Vector3 } }
	if class.Wheels == 2 then
		slots = {
			{ name = "F", offset = Vector3.new(0, wheelY, -halfZ * 0.78) },
			{ name = "R", offset = Vector3.new(0, wheelY, halfZ * 0.78) },
		}
	else
		slots = {
			{ name = "FL", offset = Vector3.new(-halfX, wheelY, -halfZ * 0.7) },
			{ name = "FR", offset = Vector3.new(halfX, wheelY, -halfZ * 0.7) },
			{ name = "RL", offset = Vector3.new(-halfX, wheelY, halfZ * 0.7) },
			{ name = "RR", offset = Vector3.new(halfX, wheelY, halfZ * 0.7) },
		}
	end

	for _, slot in slots do
		local wheel = Instance.new("Part")
		wheel.Name = slot.name
		wheel.Shape = Enum.PartType.Cylinder
		wheel.Size = Vector3.new(class.WheelWidth, class.WheelRadius * 2, class.WheelRadius * 2)
		wheel.Color = A.PlaceholderColour
		wheel.Material = Enum.Material.SmoothPlastic
		-- Zylinder liegen in Roblox entlang ihrer X-Achse.
		wheel.CFrame = block.CFrame * CFrame.new(slot.offset) * CFrame.Angles(0, 0, math.rad(90))
		wheel.Parent = wheels
	end

	local seat = Instance.new("VehicleSeat")
	seat.Name = "DriveSeat"
	seat.Size = Vector3.new(2.4, 0.4, 2.4)
	seat.CFrame = block.CFrame * CFrame.new(0, class.BodySize.Y * 0.5 + 0.2, 0)
	seat.Transparency = 1
	seat.Parent = model

	return model
end

--==========================================================================
-- Verdrahten
--==========================================================================

-- Ein Rad samt Traeger und den drei Verbindungen. Die POSITION kommt aus
-- dem Modell - wo die Raeder sitzen, entscheidet der, der das Auto gebaut
-- hat, nicht dieser Code.
local function wireWheel(model: Model, chassis: BasePart, wheel: BasePart, class: VehicleClass)
	local V = Config.Vehicle

	local steered = string.sub(wheel.Name, 1, 1) == "F"
	local driven = string.sub(wheel.Name, 1, 1) == "R"
	local offset = chassis.CFrame:PointToObjectSpace(wheel.Position)
	-- Linke Raeder drehen spiegelverkehrt zu den rechten.
	local side = if offset.X &lt; 0 then -1 else 1

	wheel.CanQuery = false
	wheel.CanCollide = true
	wheel.Anchored = false
	wheel.Massless = false
	wheel.CustomPhysicalProperties = physical(V.WheelDensity, class.Grip * V.WheelFriction, V.WheelElasticity)
	pcall(function()
		wheel.CollisionGroup = V.WheelCollisionGroup
	end)

	--== Radtraeger: fast masselos, sonst schlingert das Auto ==============
	local carrier = Instance.new("Part")
	carrier.Name = wheel.Name .. "_Carrier"
	carrier.Size = Vector3.new(0.4, 0.4, 0.4)
	carrier.Transparency = 1
	carrier.CanCollide = false
	carrier.CanQuery = false
	carrier.CanTouch = false
	carrier.CustomPhysicalProperties = physical(V.CarrierDensity, 0.3, 0)
	carrier.CFrame = CFrame.new(wheel.Position)
	carrier.Parent = model

	--== Federung und Lenkung (senkrechte Achse) ===========================
	-- Achse zeigt nach UNTEN: positiver Abstand = ausgefedert.
	local mount = offset + Vector3.new(0, V.SuspensionLength, 0)
	local bodyAttach = attachment(chassis, wheel.Name .. "_Susp", mount, Vector3.new(0, -1, 0), Vector3.new(0, 0, 1))
	local carrierUp = attachment(carrier, "SuspHub", Vector3.zero, Vector3.new(0, -1, 0), Vector3.new(0, 0, 1))

	local spring = Instance.new("SpringConstraint")
	spring.Name = wheel.Name .. "_Suspension"
	spring.Attachment0 = bodyAttach
	spring.Attachment1 = carrierUp
	spring.FreeLength = V.SuspensionLength
	spring.Stiffness = class.SuspensionStiffness
	spring.Damping = V.SuspensionDamping
	spring.LimitsEnabled = true
	spring.MinLength = math.max(0.1, V.SuspensionLength - V.SuspensionTravel)
	spring.MaxLength = V.SuspensionLength + V.SuspensionTravel
	spring.Parent = model

	-- Fuehrt den Traeger senkrecht und dreht ihn beim Lenken.
	local steer = Instance.new("CylindricalConstraint")
	steer.Name = if steered then "Steer" else "Guide"
	steer.Attachment0 = bodyAttach
	steer.Attachment1 = carrierUp
	steer.LimitsEnabled = true
	steer.LowerLimit = math.max(0.1, V.SuspensionLength - V.SuspensionTravel)
	steer.UpperLimit = V.SuspensionLength + V.SuspensionTravel
	steer.ActuatorType = Enum.ActuatorType.None -- die Feder macht die Kraft
	-- Auch nicht gelenkte Raeder bekommen einen Servo auf 0 Grad: sonst
	-- flattern sie frei um die Hochachse.
	steer.AngularActuatorType = Enum.ActuatorType.Servo
	steer.AngularSpeed = V.SteerSpeed * 10
	steer.ServoMaxTorque = class.Acceleration * 4
	steer.TargetAngle = 0
	steer.Parent = model

	--== Antrieb (seitliche Achse) =========================================
	local carrierSide = attachment(carrier, "Axle", Vector3.zero, Vector3.new(side, 0, 0), Vector3.new(0, 1, 0))
	local wheelSide = attachment(wheel, "Hub", Vector3.zero, Vector3.new(side, 0, 0), Vector3.new(0, 1, 0))

	local drive = Instance.new("CylindricalConstraint")
	drive.Name = if driven then "Drive" else "Roll"
	drive.Attachment0 = carrierSide
	drive.Attachment1 = wheelSide
	drive.LimitsEnabled = true
	drive.LowerLimit = 0
	drive.UpperLimit = 0 -- kein seitliches Spiel
	drive.ActuatorType = Enum.ActuatorType.None
	drive.AngularActuatorType = Enum.ActuatorType.Motor
	drive.MotorMaxTorque = 0 -- Leerlauf, der Fahrer setzt das
	drive.MotorMaxAngularAcceleration = math.huge
	drive.AngularVelocity = 0
	drive.Parent = model

	-- Attribute, damit der Client-Controller die Teile findet, ohne dass
	-- hier Namen doppelt gepflegt werden muessen.
	drive:SetAttribute("Driven", driven)
	steer:SetAttribute("Steered", steered)
	steer:SetAttribute("SideSign", side)
end

-- Alles, was man ansieht, aber nicht anfasst: keine Kollision, keine
-- Abfrage, kaum Masse. Sonst haengt das Auto an jeder Bordsteinkante.
local function makeCosmetic(part: BasePart)
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Anchored = false
	part.Massless = true
end

--==========================================================================
-- Ein komplettes Fahrzeug
--==========================================================================

function VehicleChassis.Build(classId: string, cframe: CFrame, colour: Color3?): Model?
	local class = Vehicles.Get(classId)
	if not class then
		warn(("[GHOSTNET] Unbekannte Fahrzeugklasse '%s'."):format(tostring(classId)))
		return nil
	end

	local model: Model
	if AssetLibrary.Has("Vehicles", class.Asset) then
		model = AssetLibrary.Clone("Vehicles", class.Asset, class.BodySize)
	else
		model = placeholderVehicle(class)
	end
	model.Name = ("Vehicle_%s"):format(class.Id)

	--== Vertrag pruefen ===================================================
	local required = if class.Wheels == 2 then A.VehicleRequiredTwoWheel else A.VehicleRequired
	local complete, gaps = AssetLibrary.Verify(model, required)
	if not complete then
		warn(
			("[GHOSTNET] Fahrzeugvorlage '%s' (Klasse %s) ist unvollstaendig. Fehlende Teile: %s"):format(
				class.Asset,
				class.Id,
				table.concat(gaps, ", ")
			)
		)
		warn("           Erwartet wird: " .. table.concat(required, ", "))
		model:Destroy()
		return nil
	end

	local chassis = AssetLibrary.Find(model, "Chassis") :: BasePart
	local seat = AssetLibrary.Find(model, "DriveSeat") :: VehicleSeat
	local wheelFolder = AssetLibrary.Find(model, "Wheels") :: Instance

	if not chassis:IsA("BasePart") then
		warn(("[GHOSTNET] '%s': Chassis ist kein BasePart."):format(class.Asset))
		model:Destroy()
		return nil
	end
	if not seat:IsA("VehicleSeat") then
		warn(("[GHOSTNET] '%s': DriveSeat ist kein VehicleSeat."):format(class.Asset))
		model:Destroy()
		return nil
	end

	model.PrimaryPart = chassis
	model:PivotTo(cframe)

	--== Chassis: die einzige echte Kollisionsbox ==========================
	chassis.Transparency = 1
	chassis.CanCollide = true
	chassis.CanQuery = false
	chassis.Anchored = false
	chassis.Massless = false
	chassis.CustomPhysicalProperties = physical(class.Mass, 0.3, 0.1)

	--== Sichtbares: dekorativ, nie kollidierend ===========================
	for _, descendant in model:GetDescendants() do
		if not descendant:IsA("BasePart") then
			continue
		end
		if descendant == chassis or descendant == seat then
			continue
		end
		if descendant:IsDescendantOf(wheelFolder) then
			continue
		end
		makeCosmetic(descendant)
	end

	-- Lackierung: nur die Karosserie, nicht Glas und nicht die Lichter.
	local body = AssetLibrary.Find(model, "Body")
	if colour and body and body:IsA("BasePart") then
		body.Color = colour
	elseif body and body:IsA("BasePart") and not model:GetAttribute("Placeholder") then
		body.Color = class.Colour
	end

	--== Sitz ==============================================================
	seat.Transparency = 1
	seat.CanQuery = false
	seat.CanCollide = false
	seat.Massless = true
	seat.MaxSpeed = class.MaxSpeed
	seat.Torque = 0 -- der VehicleSeat treibt nichts an, das machen die Raeder
	seat.TurnSpeed = 0

	if not seat:FindFirstChild("EnterPrompt") then
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "EnterPrompt"
		prompt.ActionText = "Einsteigen"
		prompt.ObjectText = class.Name
		prompt.HoldDuration = 0
		prompt.MaxActivationDistance = Config.Vehicle.EnterRange
		prompt.RequiresLineOfSight = false
		prompt.Parent = seat
	end

	-- Der Sitz haengt fest an der Kollisionsbox. Hier ist eine WeldConstraint
	-- richtig: beide Teile sind NICHT anchored, es ist echte Physik.
	local seatWeld = Instance.new("WeldConstraint")
	seatWeld.Part0 = chassis
	seatWeld.Part1 = seat
	seatWeld.Parent = chassis

	-- Alles Kosmetische fest an die Kollisionsbox schweissen. Auch hier:
	-- echte Physik zwischen nicht-anchored Teilen, also wirkt es.
	for _, descendant in model:GetDescendants() do
		if not descendant:IsA("BasePart") then
			continue
		end
		if descendant == chassis or descendant == seat or descendant:IsDescendantOf(wheelFolder) then
			continue
		end
		if descendant.Name:match("_Carrier$") then
			continue
		end
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = chassis
		weld.Part1 = descendant
		weld.Parent = chassis
	end

	--== Raeder ============================================================
	for _, wheel in wheelFolder:GetChildren() do
		if wheel:IsA("BasePart") then
			wireWheel(model, chassis, wheel, class)
		end
	end

	--== Attribute: der Client liest daraus seine Fahrwerte ================
	model:SetAttribute("ClassId", class.Id)
	model:SetAttribute("MaxSpeed", class.MaxSpeed)
	model:SetAttribute("Acceleration", class.Acceleration)
	model:SetAttribute("BrakeForce", class.BrakeForce)
	model:SetAttribute("TurnAngle", class.TurnAngle)
	model:SetAttribute("WheelRadius", class.WheelRadius)
	model:SetAttribute("HeatFactor", class.HeatFactor)
	model:SetAttribute("Damage", 0)

	-- Streaming: das Fahrzeug muss auch dann existieren, wenn der Besitzer
	-- kurz aus der Ladezone faehrt.
	model.ModelStreamingMode = Enum.ModelStreamingMode.Persistent

	CollectionService:AddTag(model, Config.VehicleTag)
	model.Parent = container()
	return model
end

--==========================================================================
-- Besitz und Lebenszyklus
--==========================================================================

local emptySince: { [Model]: number } = {}

local function parts(model: Model): { BasePart }
	local list: { BasePart } = {}
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			table.insert(list, descendant)
		end
	end
	return list
end

-- Ohne Netzwerkbesitz beim Fahrer laeuft die Physik auf dem Server und jede
-- Eingabe braucht eine Rundreise. Das Auto fuehlt sich dann an wie Sirup.
local function setOwner(model: Model, player: Player?)
	for _, part in parts(model) do
		if part.Anchored then
			continue
		end
		pcall(function()
			part:SetNetworkOwner(player)
		end)
	end
end

function VehicleChassis.Despawn(model: Model)
	emptySince[model] = nil
	if model.Parent then
		model:Destroy()
	end
end

local function watchSeat(model: Model)
	local seat = model:FindFirstChild("DriveSeat")
	if not seat or not seat:IsA("VehicleSeat") then
		return
	end

	emptySince[model] = os.clock()

	seat:GetPropertyChangedSignal("Occupant"):Connect(function()
		local occupant = seat.Occupant
		if occupant then
			local character = occupant.Parent
			local player = character and Players:GetPlayerFromCharacter(character)
			if player then
				setOwner(model, player)
				emptySince[model] = nil
				model:SetAttribute("DriverUserId", player.UserId)
				return
			end
		end

		-- Ausgestiegen, gestorben oder rausgeflogen: Besitz zurueck an den
		-- Server, sonst behaelt ein weggegangener Client die Kontrolle.
		setOwner(model, nil)
		emptySince[model] = os.clock()
		model:SetAttribute("DriverUserId", 0)
	end)
end

--==========================================================================

function VehicleChassis.Init()
	local valid, errors = Vehicles.Validate()
	if not valid then
		for _, message in errors do
			warn(("[GHOSTNET] Fahrzeugkatalog: %s"):format(message))
		end
	end

	-- Raeder treffen den Boden, aber nicht die Raeder des Nachbarautos.
	-- Ohne das verhaken sich zwei Fahrzeuge, sobald sie sich beruehren.
	pcall(function()
		local group = Config.Vehicle.WheelCollisionGroup
		PhysicsService:RegisterCollisionGroup(group)
		PhysicsService:CollisionGroupSetCollidable(group, group, false)
	end)

	for _, model in CollectionService:GetTagged(Config.VehicleTag) do
		if model:IsA("Model") then
			watchSeat(model)
		end
	end
	CollectionService:GetInstanceAddedSignal(Config.VehicleTag):Connect(function(inst)
		if inst:IsA("Model") then
			watchSeat(inst)
		end
	end)
	CollectionService:GetInstanceRemovedSignal(Config.VehicleTag):Connect(function(inst)
		if inst:IsA("Model") then
			emptySince[inst] = nil
		end
	end)

	-- Leerstehende Fahrzeuge raeumen. Gestaffelter Takt statt eines
	-- Heartbeat-Handlers ueber alles.
	task.spawn(function()
		while true do
			task.wait(5)
			local now = os.clock()
			for model, since in emptySince do
				if not model.Parent then
					emptySince[model] = nil
				elseif model:GetAttribute("Permanent") ~= true and now - since &gt; Config.Vehicle.IdleDespawn then
					VehicleChassis.Despawn(model)
				end
			end
		end
	end)

	print(("[GHOSTNET] VehicleChassis bereit. %d Klassen, Karosserien aus Assets/Vehicles."):format(Vehicles.Count()))
end

return VehicleChassis
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="GN39">
<Properties>
<string name="Name">VehicleService</string>
<ProtectedString name="Source">-- ServerScriptService/Systems/VehicleService.luau
--!strict
-- GHOSTNET :: Fahrzeugbesitz, Garage und Haendler.
--
-- BESITZ LIEGT IM PROFIL, NICHT IN DER WELT. Ein Fahrzeug in der Stadt ist
-- nur eine Ausleihe: es verschwindet nach Config.Vehicle.IdleDespawn ohne
-- Fahrer, und beim naechsten Join parkt man es neu aus.
--
-- NUR EIN FAHRZEUG GLEICHZEITIG AUSGEPARKT. Ohne diese Grenze stellt jeder
-- Spieler zehn Autos in die Stadt und der Server erstickt.
--
-- PREISE HOLT DER SERVER SELBST. Der Client schickt nur { Action, ClassId }.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Geometry = require(ReplicatedStorage.Shared.Geometry)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Types = require(ReplicatedStorage.Shared.Types)
local Vehicles = require(ReplicatedStorage.Shared.Vehicles)

local EconomyService = require(script.Parent.EconomyService)
local RateLimiter = require(script.Parent.RateLimiter)
local SaveService = require(script.Parent.SaveService)
local TimeService = require(script.Parent.TimeService)
local VehicleChassis = require(script.Parent.VehicleChassis)

local VehicleService = {}

local spawned: { [Player]: Model } = {}

local COLOURS: { [string]: Color3 } = {
	Schwarz = Color3.fromRGB(22, 23, 26),
	Anthrazit = Color3.fromRGB(58, 62, 70),
	Weiss = Color3.fromRGB(214, 218, 224),
	Rot = Color3.fromRGB(168, 34, 48),
	Cyan = Color3.fromRGB(0, 168, 190),
	Gold = Color3.fromRGB(186, 150, 62),
}

local function colourOf(name: string): Color3
	return COLOURS[name] or COLOURS.Schwarz
end

-- Oeffnungszeiten. Bei dauerhaftem Tag gibt es keinen Abend mehr, an dem
-- zugesperrt werden koennte - der Haendler hat dann immer auf. Schaltet man
-- Config.World.PermanentDay wieder aus, gelten sofort wieder die Zeiten.
local function dealerOpen(): boolean
	if Config.World.PermanentDay then
		return true
	end
	local clock = TimeService.GetClock()
	return clock &gt;= Config.Dealer.OpenHour and clock &lt; Config.Dealer.CloseHour
end

--==========================================================================
-- Lesen
--==========================================================================

function VehicleService.Owns(player: Player, classId: string): boolean
	local profile = SaveService.Get(player)
	if not profile then
		return false
	end
	for _, entry in profile.Garage do
		if entry.ClassId == classId then
			return true
		end
	end
	return false
end

-- Zusaetzlicher Darknet-Lagerplatz durch das gerade ausgeparkte Fahrzeug.
-- Genau das ist der mechanische Grund fuer den Transporter.
function VehicleService.StashBonus(player: Player): number
	local model = spawned[player]
	if not model or not model.Parent then
		return 0
	end
	local classId = model:GetAttribute("ClassId")
	if typeof(classId) ~= "string" then
		return 0
	end
	return Vehicles.StashBonus(classId)
end

function VehicleService.Sync(player: Player)
	if not player.Parent then
		return
	end
	local profile = SaveService.Get(player)
	local owned: { { [string]: any } } = {}
	if profile then
		for _, entry in profile.Garage do
			local class = Vehicles.Get(entry.ClassId)
			table.insert(owned, {
				ClassId = entry.ClassId,
				Name = if class then class.Name else entry.ClassId,
				Colour = entry.Colour,
			})
		end
	end

	local current = spawned[player]
	Remotes.GarageSync:FireClient(player, {
		Owned = owned,
		Spawned = if current and current.Parent then current:GetAttribute("ClassId") else "",
		MaxSpawned = Config.Vehicle.MaxSpawned,
		DealerOpen = dealerOpen(),
		Colours = Config.Dealer.ColourOptions,
		RepaintCost = Config.Dealer.RepaintCost,
	})
end

--==========================================================================
-- Ausparken
--==========================================================================

local function nearestSpawnPoint(player: Player): (BasePart?, number)
	local position = Geometry.AlivePosition(player)
	if not position then
		return nil, math.huge
	end
	local best: BasePart? = nil
	local bestDistance = math.huge
	for _, inst in CollectionService:GetTagged(Config.VehicleSpawnTag) do
		if inst:IsA("BasePart") and inst:IsDescendantOf(workspace) then
			local distance = Geometry.SurfaceDistance(inst, position)
			if distance &lt; bestDistance then
				best, bestDistance = inst, distance
			end
		end
	end
	return best, bestDistance
end

function VehicleService.Despawn(player: Player)
	local model = spawned[player]
	spawned[player] = nil
	if model and model.Parent then
		VehicleChassis.Despawn(model)
	end
end

local function result(ok: boolean, reason: string, extra: { [string]: any }?): { [string]: any }
	local payload: { [string]: any } = { Ok = ok, Reason = reason }
	if extra then
		for key, value in extra do
			payload[key] = value
		end
	end
	return payload
end

local function spawnVehicle(player: Player, classId: string): { [string]: any }
	local profile = SaveService.Get(player)
	if not profile then
		return result(false, "LOADING")
	end
	if not VehicleService.Owns(player, classId) then
		return result(false, "NOT_OWNED")
	end

	local point, distance = nearestSpawnPoint(player)
	if not point then
		return result(false, "NO_SPAWN")
	end
	if distance &gt; Config.Vehicle.SpawnRange then
		return result(false, "TOO_FAR", { Distance = math.floor(distance), Range = Config.Vehicle.SpawnRange })
	end

	-- Nur eins gleichzeitig: das alte weg, bevor das neue kommt.
	VehicleService.Despawn(player)

	local colour = "Schwarz"
	for _, entry in profile.Garage do
		if entry.ClassId == classId then
			colour = entry.Colour
			break
		end
	end

	local cframe = point.CFrame * CFrame.new(0, point.Size.Y * 0.5 + 4, 0)
	local model = VehicleChassis.Build(classId, cframe, colourOf(colour))
	if not model then
		return result(false, "INTERNAL")
	end
	model:SetAttribute("OwnerUserId", player.UserId)
	spawned[player] = model

	VehicleService.Sync(player)
	return result(true, "OK", { ClassId = classId })
end

--==========================================================================
-- Kaufen und Lackieren
--==========================================================================

local function nearDealer(player: Player): boolean
	local position = Geometry.AlivePosition(player)
	if not position then
		return false
	end
	for _, inst in CollectionService:GetTagged(Config.DealerTag) do
		if inst:IsA("BasePart") and inst:IsDescendantOf(workspace) then
			if Geometry.SurfaceDistance(inst, position) &lt;= Config.Vehicle.SpawnRange then
				return true
			end
		end
	end
	return false
end

local function buyVehicle(player: Player, classId: string, colour: string): { [string]: any }
	local profile = SaveService.Get(player)
	if not profile then
		return result(false, "LOADING")
	end
	local class = Vehicles.Get(classId)
	if not class then
		return result(false, "UNKNOWN_CLASS")
	end
	if not nearDealer(player) then
		return result(false, "NO_DEALER")
	end
	if not dealerOpen() then
		return result(false, "CLOSED", { Open = Config.Dealer.OpenHour, Close = Config.Dealer.CloseHour })
	end
	if VehicleService.Owns(player, classId) then
		return result(false, "ALREADY_OWNED")
	end

	-- Preis kommt aus den Daten, nicht aus dem Paket.
	local price = class.Price
	if profile.Banked &lt; price then
		return result(false, "FUNDS", { Cost = price, Missing = price - profile.Banked })
	end
	if not EconomyService.SpendBanked(player, price) then
		return result(false, "FUNDS", { Cost = price })
	end

	table.insert(profile.Garage, {
		ClassId = classId,
		Colour = if COLOURS[colour] then colour else "Schwarz",
	})

	EconomyService.Sync(player)
	SaveService.RequestSave(player)
	VehicleService.Sync(player)

	print(("[GHOSTNET] %s kauft %s fuer %d CRY."):format(player.Name, classId, price))
	return result(true, "OK", { ClassId = classId, Cost = price })
end

local function repaint(player: Player, classId: string, colour: string): { [string]: any }
	local profile = SaveService.Get(player)
	if not profile then
		return result(false, "LOADING")
	end
	if not COLOURS[colour] then
		return result(false, "BAD_PAYLOAD")
	end
	if not nearDealer(player) then
		return result(false, "NO_DEALER")
	end

	local entry: Types.OwnedVehicle? = nil
	for _, owned in profile.Garage do
		if owned.ClassId == classId then
			entry = owned
			break
		end
	end
	if not entry then
		return result(false, "NOT_OWNED")
	end

	local cost = Config.Dealer.RepaintCost
	if profile.Banked &lt; cost then
		return result(false, "FUNDS", { Cost = cost, Missing = cost - profile.Banked })
	end
	if not EconomyService.SpendBanked(player, cost) then
		return result(false, "FUNDS", { Cost = cost })
	end

	entry.Colour = colour
	EconomyService.Sync(player)
	SaveService.RequestSave(player)
	VehicleService.Sync(player)
	return result(true, "OK", { Colour = colour, Cost = cost })
end

--==========================================================================
-- Remote
--==========================================================================

local function onAction(player: Player, payload: any): { [string]: any }
	if not RateLimiter.Check(player, "VehicleAction") then
		return result(false, "RATE")
	end
	if typeof(payload) ~= "table" then
		return result(false, "BAD_PAYLOAD")
	end

	local action = (payload :: any).Action
	local classId = (payload :: any).ClassId
	local colour = (payload :: any).Colour

	if action == "DESPAWN" then
		VehicleService.Despawn(player)
		VehicleService.Sync(player)
		return result(true, "OK")
	end

	if typeof(classId) ~= "string" or not Vehicles.Exists(classId) then
		return result(false, "UNKNOWN_CLASS")
	end

	if action == "SPAWN" then
		return spawnVehicle(player, classId)
	elseif action == "BUY" then
		return buyVehicle(player, classId, if typeof(colour) == "string" then colour else "Schwarz")
	elseif action == "REPAINT" then
		return repaint(player, classId, if typeof(colour) == "string" then colour else "Schwarz")
	end

	return result(false, "BAD_PAYLOAD")
end

--==========================================================================

function VehicleService.Init()
	Remotes.VehicleAction.OnServerInvoke = function(player: Player, payload: any): { [string]: any }
		local ok, response = pcall(onAction, player, payload)
		if not ok then
			warn(("[GHOSTNET] VehicleAction ist abgestuerzt: %s"):format(tostring(response)))
			return result(false, "INTERNAL")
		end
		return response
	end

	SaveService.OnReady(function(player)
		VehicleService.Sync(player)
	end)

	Players.PlayerRemoving:Connect(function(player)
		VehicleService.Despawn(player)
	end)

	-- Haendler auf und zu: die Anzeige muss mitbekommen, wenn es Abend wird.
	TimeService.OnPhaseChanged(function()
		for _, player in Players:GetPlayers() do
			if SaveService.IsReady(player) then
				VehicleService.Sync(player)
			end
		end
	end)

	if Config.World.PermanentDay then
		print(("[GHOSTNET] VehicleService bereit. %d gleichzeitig ausgeparkt, Haendler durchgehend offen."):format(
			Config.Vehicle.MaxSpawned
		))
	else
		print(("[GHOSTNET] VehicleService bereit. %d gleichzeitig ausgeparkt, Haendler %d-%d Uhr."):format(
			Config.Vehicle.MaxSpawned,
			Config.Dealer.OpenHour,
			Config.Dealer.CloseHour
		))
	end
end

return VehicleService
</ProtectedString>
</Properties>
</Item>
</Item>
<Item class="Folder" referent="GN47">
<Properties>
<string name="Name">World</string>
</Properties>
<Item class="Script" referent="GN41">
<Properties>
<string name="Name">BankInterior</string>
<ProtectedString name="Source">-- ServerScriptService/World/BankInterior.server.luau
--!strict
-- GHOSTNET :: Die Nakamura Bank von innen.
--
-- Alles hier drin ist GEDECKT (kein Attribut Exposed): drinnen zahlt normal
-- und ist sicherer. Der Aufschlag fuer offene Ziele liegt draussen an der
-- Fassade - siehe Config.Cover.
--
-- DREI EBENEN, DREI WEGE HINEIN. Ein Raubzug, der jedes Mal identisch
-- ablaeuft, ist nach dem dritten Mal langweilig.
--
--   1. Schalterhalle    oeffentlich, Wachen mit Sichtkegel, Deckenkameras
--   2. Sicherheitsbereich  nur ueber die gehackte Schleuse
--   3. Tresorraum       Schliessfaecher plus Haupttresor
--
--   Leise    Kameras vorher hacken, Wachen umgehen -&gt; wenig Trace, volle Beute
--   Schnell  direkt zur Schleuse, Alarm sofort -&gt; Wettlauf gegen die Uhr
--   Von oben ueber Dach und Lueftung, umgeht die Halle -&gt; braucht Tier 3
--
-- Wie ueberall: nur Parts, Tags und Attribute. Die Logik liegt in
-- HackService, RaidService und GuardService.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local FOLDER_NAME = "GhostNet_BankInterior"

if workspace:FindFirstChild(FOLDER_NAME) then
	return
end

local folder = Instance.new("Folder")
folder.Name = FOLDER_NAME
folder.Parent = workspace

-- Liegt hinter der bestehenden Bankfassade aus StoryWorld.
local base = Vector3.new(78, 0, -86)

local function part(name: string, size: Vector3, cframe: CFrame, colour: Color3, material: Enum.Material): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cframe
	p.Color = colour
	p.Material = material
	p.Anchored = true
	p.CanQuery = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = folder
	return p
end

local function hackable(target: BasePart, attributes: { [string]: any })
	for key, value in attributes do
		target:SetAttribute(key, value)
	end
	target:SetAttribute("Offline", false)
	target.CanQuery = true
	CollectionService:AddTag(target, Config.HackableTag)
end

local function light(target: BasePart, colour: Color3, range: number)
	local l = Instance.new("PointLight")
	l.Color = colour
	l.Brightness = 2.5
	l.Range = range
	l.Parent = target
end

--==========================================================================
-- 1) SCHALTERHALLE  -  oeffentlich, zwei Wachen, Deckenkameras
--==========================================================================

part(
	"HalleBoden",
	Vector3.new(32, 1, 26),
	CFrame.new(base + Vector3.new(0, 1, 2)),
	Config.Palette.InnenBoden,
	Enum.Material.Marble
)

part(
	"Schaltertresen",
	Vector3.new(22, 4, 2),
	CFrame.new(base + Vector3.new(0, 3.5, -6)),
	Config.Palette.Holz,
	Enum.Material.Wood
)

-- Zwei Deckenkameras. Wer sie vorher knackt, geht den leisen Weg.
for index, offset in { Vector3.new(-11, 15, 8), Vector3.new(11, 15, 8) } do
	local cam = part(
		("HalleKamera%d"):format(index),
		Vector3.new(1.4, 1.4, 2.6),
		CFrame.new(base + offset) * CFrame.Angles(math.rad(-30), 0, 0),
		Config.Palette.MetallDunkel,
		Enum.Material.Metal
	)
	light(cam, Config.Theme.Magenta, 12)
	hackable(cam, {
		TargetId = ("BANK_HALL_CAM%d"):format(index),
		DisplayName = ("HALLENKAMERA %d // Nakamura"):format(index),
		Difficulty = 3,
		RequiredLevel = 2,
		OnSuccess = "CameraOffline",
		DownTime = 120, -- lange genug, um in Ruhe weiterzuarbeiten
		Cooldown = Config.Raid.BankCooldown,
	})
end

-- Zwei Wachen mit Patrouille. Sie melden, sie greifen nicht an.
for index, route in
	{
		{ A = base + Vector3.new(-12, 3, 10), B = base + Vector3.new(-12, 3, -4) },
		{ A = base + Vector3.new(12, 3, -4), B = base + Vector3.new(12, 3, 10) },
	}
do
	local guard = Instance.new("Model")
	guard.Name = ("Wache%d"):format(index)

	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(2, 5.6, 1.4)
	root.CFrame = CFrame.new(route.A)
	root.Color = Config.Palette.BetonDunkel
	root.Material = Enum.Material.Fabric
	root.Anchored = true
	root.CanCollide = false
	root.CanQuery = false
	root.Parent = guard
	guard.PrimaryPart = root

	local head = Instance.new("Part")
	head.Name = "Kopf"
	head.Size = Vector3.new(1.2, 1.2, 1.2)
	head.Color = Config.Palette.Haut
	head.Anchored = true
	head.CanCollide = false
	head.CanQuery = false
	head.CastShadow = false
	-- Bauposition relativ zum Rumpf. KEINE WeldConstraint: beide Teile sind
	-- Anchored, da bewirkt sie nichts. Bewegt wird das Modell als Ganzes
	-- ueber PivotTo (GuardService.patrol).
	head.CFrame = root.CFrame * CFrame.new(0, 3.4, 0)
	head.Parent = guard

	guard:SetAttribute("PatrolA", route.A)
	guard:SetAttribute("PatrolB", route.B)
	guard:SetAttribute("AlarmGroup", "BANK")
	-- Drinnen sieht man weniger weit als auf der Strasse. Frueher hat das die
	-- Nacht erledigt; seit die Stadt dauerhaft hell ist, macht es der Ort -
	-- und der Ort steht als Attribut am Objekt, nicht im Code.
	guard:SetAttribute("SightFactor", Config.Bank.IndoorSightFactor)
	guard.Parent = folder
	CollectionService:AddTag(guard, Config.GuardTag)
end

--==========================================================================
-- 2) SICHERHEITSBEREICH  -  nur ueber die Schleuse
--==========================================================================

part(
	"SchleusenWand",
	Vector3.new(32, 16, 1.5),
	CFrame.new(base + Vector3.new(0, 8, -9)),
	Config.Palette.Beton,
	Enum.Material.Metal
)

local sluice = part(
	"Schleuse",
	Vector3.new(7, 11, 1),
	CFrame.new(base + Vector3.new(0, 6, -9)),
	Config.Palette.MetallDunkel,
	Enum.Material.DiamondPlate
)
light(sluice, Config.Theme.Cyan, 14)
hackable(sluice, {
	TargetId = "BANK_SLUICE",
	DisplayName = "SCHLEUSE // Sicherheitsbereich",
	Difficulty = 6,
	RequiredLevel = 2,
	OnSuccess = "DoorOpen",
	DownTime = 90,
	Cooldown = Config.Raid.BankCooldown,
	AlarmGroup = "BANK",
	AlarmStarts = true, -- ab hier laeuft die Uhr
})

part(
	"ServerraumBoden",
	Vector3.new(32, 1, 14),
	CFrame.new(base + Vector3.new(0, 1, -17)),
	Config.Palette.InnenBoden,
	Enum.Material.Concrete
)

for index = 1, 4 do
	local rack = part(
		("Serverschrank%d"):format(index),
		Vector3.new(3, 8, 2),
		CFrame.new(base + Vector3.new(-11 + (index - 1) * 7, 5, -20)),
		Config.Palette.MetallDunkel,
		Enum.Material.Metal
	)
	local strip = part(
		("ServerLicht%d"):format(index),
		Vector3.new(2.4, 0.3, 0.2),
		CFrame.new(base + Vector3.new(-11 + (index - 1) * 7, 7.5, -18.9)),
		Config.Theme.Cyan,
		Enum.Material.Neon
	)
	strip.CanCollide = false
	local _ = rack
end

--==========================================================================
-- 3) DER WEG VON OBEN  -  Lueftungsschacht, braucht ein besseres Rig
--==========================================================================

local vent = part(
	"Lueftungsgitter",
	Vector3.new(5, 0.6, 5),
	CFrame.new(base + Vector3.new(0, 18.5, -17)),
	Config.Palette.Metall,
	Enum.Material.DiamondPlate
)
light(vent, Config.Theme.Amber, 10)
hackable(vent, {
	TargetId = "BANK_VENT",
	DisplayName = "LUEFTUNGSGITTER // Dach",
	Difficulty = 5,
	-- Hoeheres Rig noetig, sonst waere der Weg von oben immer die beste Wahl.
	RequiredLevel = Config.Bank.VentRequiredTier,
	OnSuccess = "DoorOpen",
	DownTime = 120,
	Cooldown = Config.Raid.BankCooldown,
	-- Bewusst OHNE AlarmStarts: das ist der Sinn des leisen Wegs.
})

-- Leiter vom Boden aufs Bankdach, damit der obere Weg erreichbar ist.
for y = 4, 18, 4 do
	part(
		"DachLeiter",
		Vector3.new(2.6, 0.4, 1.2),
		CFrame.new(base + Vector3.new(18, y, 12)),
		Config.Palette.Metall,
		Enum.Material.Metal
	).CanCollide = true
end

--==========================================================================
-- 4) TRESORRAUM  -  Schliessfaecher plus Haupttresor
--==========================================================================

part(
	"TresorraumBoden",
	Vector3.new(24, 1, 14),
	CFrame.new(base + Vector3.new(0, 1, -30)),
	Config.Palette.MetallDunkel,
	Enum.Material.Metal
)

-- Mehrere Schliessfaecher: beim schnellen Weg entscheidet die Uhr, wie viele
-- man noch schafft. Genau das macht "schnell" zu einer echten Option.
for index = 1, Config.Bank.VaultBoxes do
	local column = (index - 1) % 3
	local row = math.floor((index - 1) / 3)
	local box = part(
		("Schliessfach%d"):format(index),
		Vector3.new(3, 3, 1),
		CFrame.new(base + Vector3.new(-7 + column * 7, 4 + row * 4, -35)),
		Config.Palette.Metall,
		Enum.Material.Metal
	)
	hackable(box, {
		TargetId = ("BANK_BOX%d"):format(index),
		DisplayName = ("SCHLIESSFACH %d"):format(index),
		Difficulty = 4,
		RequiredLevel = 2,
		Reward = Config.Bank.BoxReward,
		OnSuccess = "AtmPayout",
		DownTime = 20,
		Cooldown = Config.Bank.BoxCooldown,
		AlarmGroup = "BANK",
	})
end

print("[GHOSTNET] Bank-Innenraum gebaut: Halle, Sicherheitsbereich, Tresorraum, Lueftung.")
</ProtectedString>
</Properties>
</Item>
<Item class="Script" referent="GN42">
<Properties>
<string name="Name">City</string>
<ProtectedString name="Source">-- ServerScriptService/World/City.server.luau
--!strict
-- GHOSTNET :: Vantorra.
--
-- Baut Strassen, Gehwege und Haeuser entlang des Graphen aus RoadNetwork.
-- Reine Geometrie - kein Objekt hier traegt Spiellogik.
--
-- ALLE FARBEN KOMMEN AUS Config.Palette
--   Hier steht kein einziger Farbwert. Die Stadt heller oder dunkler zu
--   machen ist eine Aenderung an der Palette, nicht an diesem Skript.
--
-- LEISTUNGSBUDGET (verbindlich, nicht optional)
--   Alles Dekorative: Anchored, CanQuery = false, CanTouch = false,
--   CastShadow = false bei kleinen Teilen. Fenster sind spiegelnde
--   FLAECHEN, keine Lichtquellen - hunderte PointLights waeren auf dem
--   Handy nicht bezahlbar. Bei Tageslicht sieht man sie ohnehin kaum,
--   deshalb entfallen sie unter Config.World.PermanentDay ganz.
--
--   Nur der als "Dense" markierte Bezirk wird voll ausgebaut. Der Rest bleibt
--   Rohbau, bis er dran ist: eine grosse leere Stadt ist schlimmer als ein
--   kleiner voller Block.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local AssetLibrary = require(ReplicatedStorage.Shared.AssetLibrary)
local Config = require(ReplicatedStorage.Shared.Config)
local Districts = require(ReplicatedStorage.Shared.Districts)

local RoadNetwork = require(ServerScriptService:WaitForChild("Systems"):WaitForChild("RoadNetwork"))

local FOLDER_NAME = "GhostNet_City"

if workspace:FindFirstChild(FOLDER_NAME) then
	return
end

RoadNetwork.Build()

local folder = Instance.new("Folder")
folder.Name = FOLDER_NAME
folder.Parent = workspace

local rng = Random.new(Config.World.Seed)
local C = Config.City
local A = Config.Assets

local function decor(name: string, size: Vector3, cframe: CFrame, colour: Color3, material: Enum.Material, parent: Instance?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cframe
	p.Color = colour
	p.Material = material
	p.Anchored = true
	p.CanQuery = false
	p.CanTouch = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if size.X &lt; 6 and size.Y &lt; 6 and size.Z &lt; 6 then
		p.CastShadow = false
	end
	p.Parent = parent or folder
	return p
end

--==========================================================================
-- Strassen
--==========================================================================

local roads = Instance.new("Folder")
roads.Name = "Strassen"
roads.Parent = folder

local props = Instance.new("Folder")
props.Name = "Moeblierung"
props.Parent = folder

local built: { [string]: boolean } = {}

for _, node in RoadNetwork.All() do
	for _, linkId in node.Links do
		-- Jede Kante nur einmal bauen.
		local edgeKey = if node.Id &lt; linkId
			then ("%d-%d"):format(node.Id, linkId)
			else ("%d-%d"):format(linkId, node.Id)
		if built[edgeKey] then
			continue
		end
		built[edgeKey] = true

		local other = RoadNetwork.Get(linkId)
		if not other then
			continue
		end

		local mid = (node.Position + other.Position) * 0.5
		local delta = other.Position - node.Position
		local length = delta.Magnitude
		local horizontal = math.abs(delta.X) &gt; math.abs(delta.Z)
		local size = if horizontal
			then Vector3.new(length, C.RoadThickness, C.RoadWidth)
			else Vector3.new(C.RoadWidth, C.RoadThickness, length)

		local road = decor("Fahrbahn", size, CFrame.new(mid), Config.Palette.Asphalt, Enum.Material.Slate, roads)
		road.Reflectance = Config.World.RoadReflectance
		road.CanCollide = true

		-- Gehwege links und rechts.
		local sidewalkSize = if horizontal
			then Vector3.new(length, C.SidewalkThickness, C.SidewalkWidth)
			else Vector3.new(C.SidewalkWidth, C.SidewalkThickness, length)
		-- Oberkante = Fahrbahnoberkante + SidewalkLift, daraus die Mitte.
		-- Frueher stand hier eine feste 0.3, zu der nichts passte -
		-- Fussgaenger schwebten oder steckten im Bordstein.
		local sidewalkY = C.RoadThickness * 0.5 + C.SidewalkLift - C.SidewalkThickness * 0.5
		for _, side in { -1, 1 } do
			local offset = if horizontal
				then Vector3.new(0, sidewalkY, side * (C.RoadWidth * 0.5 + C.SidewalkWidth * 0.5))
				else Vector3.new(side * (C.RoadWidth * 0.5 + C.SidewalkWidth * 0.5), sidewalkY, 0)
			local walk = decor(
				"Gehweg",
				sidewalkSize,
				CFrame.new(mid + offset),
				Config.Palette.Gehweg,
				Enum.Material.Concrete,
				roads
			)
			walk.CanCollide = true
		end

		-- Mittelmarkierung, matt. Gibt der Strasse eine Richtung.
		local step = 24
		local count = math.floor(length / step)
		for i = 1, count - 1 do
			local along = node.Position:Lerp(other.Position, i / count)
			decor(
				"Markierung",
				if horizontal then Vector3.new(6, 0.06, 0.6) else Vector3.new(0.6, 0.06, 6),
				CFrame.new(along + Vector3.new(0, 0.55, 0)),
				Config.Palette.Markierung,
				Enum.Material.SmoothPlastic,
				roads
			)
		end
	end
end

--==========================================================================
-- Haeuser aus wiederverwendbaren Modulen
-- Erdgeschoss, Standardetagen, Dachabschluss. Vielfalt ueber Farbe, Hoehe
-- und Schilder - nicht ueber Einzelbauten.
--==========================================================================

local blocks = Instance.new("Folder")
blocks.Name = "Bloecke"
blocks.Parent = folder

-- EIN HAUS IST EIN STAPEL, KEIN KLOTZ.
--
-- Frueher stand hier ein Quader mit Betonmaterial. Ein Quader mit
-- Betonmaterial sieht aus wie ein Quader mit Betonmaterial - da hilft kein
-- Licht und keine Farbe. Ein Gebaeude braucht Gliederung: Sockel,
-- Fensterachsen, Gesimse, Dachkante.
--
-- Also wird gestapelt:  Sockel -&gt; n x Etage -&gt; Dach.
-- Die Module liegen fertig unter Assets/Buildings. Vielfalt entsteht aus
-- Etagenzahl, Modulmischung, Farbe und leichter Drehung - aus acht Modulen
-- bekommt man hunderte unterschiedliche Haeuser.
local function building(centre: Vector3, district: Districts.District, dense: boolean, yaw: number)
	local tint = district.Tint
	local floors = rng:NextInteger(A.MinFloors, if dense then A.MaxFloors else A.MinFloors + 1)

	local model = Instance.new("Model")
	model.Name = ("Haus_%s"):format(district.Id)

	local y = 0

	local function place(name: string, height: number, colour: Color3, overhang: number)
		local size = Vector3.new(A.BuildingFootprint + overhang, height, A.BuildingFootprint + overhang)
		local part = AssetLibrary.Clone("Buildings", name, size)
		part:PivotTo(CFrame.new(centre + Vector3.new(0, y + height * 0.5, 0)) * CFrame.Angles(0, yaw, 0))

		local placeholder = part:GetAttribute("Placeholder") == true
		for _, descendant in part:GetDescendants() do
			if descendant:IsA("BasePart") then
				descendant.Anchored = true
				descendant.CanQuery = false
				descendant.CanTouch = false
				if descendant.Size.X &lt; 6 and descendant.Size.Y &lt; 6 and descendant.Size.Z &lt; 6 then
					descendant.CastShadow = false
				end
				-- Nur Platzhalter und ausdruecklich als toenbar markierte
				-- Teile werden eingefaerbt. Ein fertiges Modul soll seine
				-- eigenen Materialien behalten.
				if placeholder or descendant:GetAttribute("Tintable") == true then
					descendant.Color = colour
				end
			end
		end
		part.Parent = model
		y += height
	end

	-- Sockel dunkler als der Rest: Gebaeude sind unten schmutziger, und ohne
	-- diesen Absatz steht das Haus wie hingestellt statt gewachsen da.
	place(A.Bases[rng:NextInteger(1, #A.Bases)], A.BaseHeight, tint:Lerp(Config.Palette.BetonDunkel, A.BaseDarken), 0)

	for _ = 1, floors do
		place(A.Floors[rng:NextInteger(1, #A.Floors)], A.FloorHeight, tint, 0)
	end

	-- Dachkante steht ueber. Ein Dach buendig mit der Fassade sieht immer
	-- nach Klotz aus - das ist die billigste Verbesserung im ganzen Baukasten.
	place(A.Roofs[rng:NextInteger(1, #A.Roofs)], A.RoofHeight, Config.Palette.Dach, A.RoofOverhang * 2)

	-- Feuerleiter: der Weg nach oben. Ohne die ist das begehbare Dach Deko,
	-- und "von oben" waere im Bankraub kein echter Weg.
	if rng:NextNumber() &lt; A.RoofAccessChance then
		local x = centre.X + A.BuildingFootprint * 0.5 + 1
		for rung = 1, math.floor(y / A.RoofAccessStep) do
			local ladder = AssetLibrary.Clone("Props", A.RoofAccess, A.RoofAccessSize)
			ladder:PivotTo(CFrame.new(x, rung * A.RoofAccessStep, centre.Z))
			for _, descendant in ladder:GetDescendants() do
				if descendant:IsA("BasePart") then
					descendant.Anchored = true
					descendant.CanQuery = false
					descendant.CanTouch = false
					descendant.CanCollide = true
					descendant.CastShadow = false
				end
			end
			ladder.Parent = model
		end
	end

	model.Parent = blocks
end

--==========================================================================
-- STRASSENMOEBLIERUNG
--
-- Eine leere Strasse mit perfekten Haeusern wirkt tot. Eine durchschnittliche
-- Strasse mit Kram darauf wirkt echt. Laternen, Ampeln, Muelltonnen, Poller,
-- Verteilerkaesten, Schilder - das ist der billigste Realismus, den es gibt.
--==========================================================================

local function furnish(from: Vector3, to: Vector3, horizontal: boolean)
	local length = (to - from).Magnitude
	local steps = math.floor(length / A.PropSpacing)
	if steps &lt; 1 then
		return
	end

	-- Kante des Gehwegs, auf beiden Seiten.
	local lateral = C.RoadWidth * 0.5 + C.SidewalkWidth * 0.5
	local top = C.RoadThickness * 0.5 + C.SidewalkLift

	for step = 1, steps - 1 do
		for _, side in { -1, 1 } do
			if rng:NextNumber() &gt; A.PropChance then
				continue
			end
			local along = from:Lerp(to, step / steps)
			local sideways = if horizontal
				then Vector3.new(0, 0, side * lateral)
				else Vector3.new(side * lateral, 0, 0)
			local jitter = if horizontal
				then Vector3.new(rng:NextNumber(-A.PropJitter, A.PropJitter), 0, 0)
				else Vector3.new(0, 0, rng:NextNumber(-A.PropJitter, A.PropJitter))

			local name = A.Props[rng:NextInteger(1, #A.Props)]
			local prop = AssetLibrary.Clone("Props", name, A.PropSize)
			local at = along + sideways + jitter + Vector3.new(0, top + A.PropSize.Y * 0.5, 0)
			prop:PivotTo(CFrame.new(at) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0))

			for _, descendant in prop:GetDescendants() do
				if descendant:IsA("BasePart") then
					descendant.Anchored = true
					descendant.CanQuery = false
					descendant.CanTouch = false
					descendant.CanCollide = false -- man soll nicht am Poller haengenbleiben
					descendant.CastShadow = false
				end
			end
			prop.Parent = props
		end
	end
end

-- Ein Baublock liegt zwischen vier Kreuzungen.
local grid = C.Grid
local half = math.floor(grid / 2)
local inner = C.BlockSize - C.RoadWidth - C.SidewalkWidth * 2 - C.BuildingInset

local denseBlocks, roughBlocks = 0, 0

for gz = -half, half - 1 do
	for gx = -half, half - 1 do
		local district = Districts.At(gx, gz)
		if not district then
			continue
		end

		local centre = Vector3.new((gx + 0.5) * C.BlockSize, 0, (gz + 0.5) * C.BlockSize)
		local dense = district.Dense

		-- Ein Block traegt vier Haeuser statt eines Klotzes: das gibt
		-- Gassen, und Gassen sind fuer Motorrad und Flucht wichtig.
		--
		-- KEINE GLEICHEN ABSTAENDE. Jedes Haus wird ein Stueck versetzt und
		-- minimal gedreht. Ein perfektes Raster sieht immer nach Computer
		-- aus, und genau das faellt sofort auf.
		for _, corner in { { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } } do
			local jitter = Vector3.new(
				rng:NextNumber(-A.BuildingJitter, A.BuildingJitter),
				0,
				rng:NextNumber(-A.BuildingJitter, A.BuildingJitter)
			)
			building(
				centre + Vector3.new(corner[1] * inner * 0.25, 0, corner[2] * inner * 0.25) + jitter,
				district,
				dense,
				math.rad(rng:NextNumber(-A.BuildingYaw, A.BuildingYaw))
			)
		end

		if dense then
			denseBlocks += 1
		else
			roughBlocks += 1
		end
	end
end

--==========================================================================
-- Zweiter Durchgang: Moeblierung entlang der Strassen.
-- Bewusst NACH den Haeusern, damit die Props schon wissen, wie hoch der
-- Gehweg liegt, und nicht in einer Fassade landen.
--==========================================================================

local furnished: { [string]: boolean } = {}

for _, node in RoadNetwork.All() do
	for _, linkId in node.Links do
		local edgeKey = if node.Id &lt; linkId
			then ("%d-%d"):format(node.Id, linkId)
			else ("%d-%d"):format(linkId, node.Id)
		if furnished[edgeKey] then
			continue
		end
		furnished[edgeKey] = true

		local other = RoadNetwork.Get(linkId)
		if not other then
			continue
		end
		-- Nur im ausgebauten Bezirk moeblieren. Der Rest ist Rohbau, und
		-- Laternen an einer leeren Flaeche sehen schlimmer aus als nichts.
		local district = RoadNetwork.DistrictAt((node.Position + other.Position) * 0.5)
		if not district or not district.Dense then
			continue
		end

		local delta = other.Position - node.Position
		furnish(node.Position, other.Position, math.abs(delta.X) &gt; math.abs(delta.Z))
	end
end

print(
	("[GHOSTNET] Vantorra gebaut: %d ausgebaute Bloecke, %d im Rohbau, %d Moebel."):format(
		denseBlocks,
		roughBlocks,
		#props:GetChildren()
	)
)
</ProtectedString>
</Properties>
</Item>
<Item class="Script" referent="GN43">
<Properties>
<string name="Name">Dealership</string>
<ProtectedString name="Source">-- ServerScriptService/World/Dealership.server.luau
--!strict
-- GHOSTNET :: Autohaendler, Garage und die Bezirks-Wegpunkte.
--
-- Der Showroom stellt die Fahrzeuge PHYSISCH aus. Der Spieler geht hin,
-- sieht sie, steigt ein und faehrt eine Runde auf dem abgesperrten Gelaende -
-- das ist deutlich besser als ein Menue mit Bildern und kostet kaum mehr.
--
-- Wie ueberall: nur Parts, Tags und Attribute.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Config = require(ReplicatedStorage.Shared.Config)
local Districts = require(ReplicatedStorage.Shared.Districts)
local Vehicles = require(ReplicatedStorage.Shared.Vehicles)

local VehicleChassis = require(ServerScriptService:WaitForChild("Systems"):WaitForChild("VehicleChassis"))

local FOLDER_NAME = "GhostNet_Dealership"

if workspace:FindFirstChild(FOLDER_NAME) then
	return
end

local folder = Instance.new("Folder")
folder.Name = FOLDER_NAME
folder.Parent = workspace

local function part(name: string, size: Vector3, cframe: CFrame, colour: Color3, material: Enum.Material): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cframe
	p.Color = colour
	p.Material = material
	p.Anchored = true
	p.CanQuery = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = folder
	return p
end

local function waypoint(id: string, position: Vector3)
	local p = part("WP_" .. id, Vector3.new(14, 16, 14), CFrame.new(position), Config.Theme.Cyan, Enum.Material.Neon)
	p.Transparency = 1
	p.CanCollide = false
	p.CanTouch = false
	p:SetAttribute("WaypointId", id)
	CollectionService:AddTag(p, Config.WaypointTag)
end

local function sign(target: BasePart, title: string, subtitle: string, colour: Color3, height: number)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Sign"
	gui.Size = UDim2.fromOffset(260, 48)
	gui.StudsOffsetWorldSpace = Vector3.new(0, height, 0)
	gui.MaxDistance = 200

	local head = Instance.new("TextLabel")
	head.BackgroundTransparency = 1
	head.Font = Enum.Font.Code
	head.Text = title
	head.TextColor3 = colour
	head.TextSize = 18
	head.Size = UDim2.new(1, 0, 0.6, 0)
	head.Parent = gui

	local sub = Instance.new("TextLabel")
	sub.BackgroundTransparency = 1
	sub.Font = Enum.Font.Code
	sub.Text = subtitle
	sub.TextColor3 = Config.Theme.TextDim
	sub.TextSize = 12
	sub.Position = UDim2.new(0, 0, 0.6, 0)
	sub.Size = UDim2.new(1, 0, 0.4, 0)
	sub.Parent = gui

	gui.Parent = target
end

--==========================================================================
-- Autohaendler mit Showroom
--==========================================================================

local dealerBase = Vector3.new(-96, 0, 40)

part(
	"ShowroomBoden",
	Vector3.new(74, 1, 40),
	CFrame.new(dealerBase + Vector3.new(0, 0.5, 0)),
	Config.Palette.InnenBoden,
	Enum.Material.Concrete
).CanCollide = true

part(
	"ShowroomRueckwand",
	Vector3.new(74, 18, 1),
	CFrame.new(dealerBase + Vector3.new(0, 9, -20)),
	Config.Palette.InnenWand,
	Enum.Material.Concrete
).CanCollide = true

part(
	"ShowroomDach",
	Vector3.new(75, 1, 41),
	CFrame.new(dealerBase + Vector3.new(0, 18, 0)),
	Config.Palette.Dach,
	Enum.Material.Metal
).CanCollide = true

local counter = part(
	"HaendlerTresen",
	Vector3.new(12, 4, 3),
	CFrame.new(dealerBase + Vector3.new(0, 2.5, -16)),
	Config.Palette.Metall,
	Enum.Material.Metal
)
counter.CanCollide = true
counter.CanQuery = true
counter:SetAttribute("DisplayName", "AUTOHAUS VANTORRA")
CollectionService:AddTag(counter, Config.DealerTag)
sign(
	counter,
	"AUTOHAUS",
	-- Bei dauerhaftem Tag gibt es keinen Feierabend, auf den das Schild
	-- hinweisen koennte. Sonst stuende hier eine Zeit, die nie eintritt.
	if Config.World.PermanentDay
		then "durchgehend offen"
		else ("offen %d-%d Uhr"):format(Config.Dealer.OpenHour, Config.Dealer.CloseHour),
	Config.Theme.Amber,
	4.5
)

local band = part(
	"HaendlerLeuchtband",
	Vector3.new(74, 0.4, 1.2),
	CFrame.new(dealerBase + Vector3.new(0, 17, -19.4)),
	Config.Theme.Amber,
	Enum.Material.Neon
)
band.CanCollide = false

-- Ausstellungsfahrzeuge: physisch da, einsteigbar, Probefahrt auf dem
-- abgesperrten Gelaende. "Permanent", damit der Aufraeumer sie stehen laesst.
for index, class in Vehicles.List do
	local slot = dealerBase + Vector3.new(-30 + (index - 1) * 15, 3.5, 4)
	local model = VehicleChassis.Build(class.Id, CFrame.new(slot) * CFrame.Angles(0, math.rad(180), 0))
	if model then
		model:SetAttribute("Permanent", true)
		model:SetAttribute("Showroom", true)
		local body = model.PrimaryPart
		if body then
			sign(body, class.Name, ("%d CRY  //  %s"):format(class.Price, class.Blurb), Config.Theme.Cyan, 4)
		end
	end
end

waypoint("DEALER", dealerBase + Vector3.new(0, 6, -10))

--==========================================================================
-- Garage: der eigene Ausparkplatz
--==========================================================================

local garageBase = Vector3.new(46, 0, 44)

part(
	"GarageBoden",
	Vector3.new(26, 1, 22),
	CFrame.new(garageBase + Vector3.new(0, 0.5, 0)),
	Config.Palette.InnenBoden,
	Enum.Material.Concrete
).CanCollide = true

part(
	"GarageDach",
	Vector3.new(27, 1, 23),
	CFrame.new(garageBase + Vector3.new(0, 12, 0)),
	Config.Palette.Dach,
	Enum.Material.Metal
).CanCollide = true

for _, side in { -1, 1 } do
	part(
		"GarageWand",
		Vector3.new(1, 12, 22),
		CFrame.new(garageBase + Vector3.new(side * 13, 6, 0)),
		Config.Palette.InnenBoden,
		Enum.Material.Concrete
	).CanCollide = true
end

local spawnPad = part(
	"Ausparkplatz",
	Vector3.new(16, 0.4, 16),
	CFrame.new(garageBase + Vector3.new(0, 1.2, 0)),
	Config.Theme.Cyan,
	Enum.Material.Neon
)
spawnPad.CanCollide = false
spawnPad.Transparency = 0.65
spawnPad.CanQuery = true
CollectionService:AddTag(spawnPad, Config.VehicleSpawnTag)
sign(spawnPad, "GARAGE", "[G] - Fahrzeug ausparken", Config.Theme.Cyan, 5)

waypoint("GARAGE", garageBase + Vector3.new(0, 6, 0))

--==========================================================================
-- Wegpunkte der Bezirke, damit die Story dorthin zeigen kann
--==========================================================================

local block = Config.City.BlockSize
for _, district in Districts.List do
	local position = Vector3.new(district.GridX * block, 6, district.GridZ * block)
	if district.Id == "DOCKS" then
		waypoint("DOCKS", position)
	elseif district.Id == "HEIGHTS" then
		waypoint("HEIGHTS", position)
	elseif district.Id == "FINANCE" then
		waypoint("FINANCE", position)
	end
end

print("[GHOSTNET] Autohaus, Garage und Bezirks-Wegpunkte gebaut.")
</ProtectedString>
</Properties>
</Item>
<Item class="Script" referent="GN44">
<Properties>
<string name="Name">StoryWorld</string>
<ProtectedString name="Source">-- ServerScriptService/World/StoryWorld.server.luau
--!strict
-- GHOSTNET :: Die Orte, an denen die Story spielt.
--
-- Hier steht KEINE Spiellogik - nur Parts, Tags und Attribute. Genau wie bei
-- TestTargets: der HackService, der MissionService und der RaidService lesen
-- die Attribute und wissen dann, was zu tun ist.
--
-- Und das Wichtigste: Nichts davon verschwindet nach der Mission. Das
-- Uebungsterminal bleibt stehen, der Laden bleibt aufbrechbar (Cooldown), das
-- Apartment ist ab M03 der Hub, die Bank ab M05 das Endgame-Ziel.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local FOLDER_NAME = "GhostNet_StoryWorld"

if workspace:FindFirstChild(FOLDER_NAME) then
	return -- schon gebaut (z.B. nach einem Studio-Reload)
end

local folder = Instance.new("Folder")
folder.Name = FOLDER_NAME
folder.Parent = workspace

--==========================================================================
-- Bau-Helfer
--==========================================================================

type PartProps = {
	Name: string,
	Size: Vector3,
	CFrame: CFrame,
	Color: Color3,
	Material: Enum.Material?,
	Transparency: number?,
	CanCollide: boolean?,
	Parent: Instance?,
}

local function makePart(props: PartProps): Part
	local p = Instance.new("Part")
	p.Name = props.Name
	p.Size = props.Size
	p.CFrame = props.CFrame
	p.Color = props.Color
	p.Material = props.Material or Enum.Material.SmoothPlastic
	p.Transparency = props.Transparency or 0
	p.CanCollide = if props.CanCollide == nil then true else props.CanCollide
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = props.Parent or folder
	return p
end

local function makeHackable(part: BasePart, attributes: { [string]: any })
	for key, value in attributes do
		part:SetAttribute(key, value)
	end
	part:SetAttribute("Offline", false)
	CollectionService:AddTag(part, Config.HackableTag)
end

-- Unsichtbarer Trigger fuer GOTO-Schritte. Der MissionService prueft die
-- Distanz dazu serverseitig.
local function makeWaypoint(id: string, position: Vector3)
	local p = makePart({
		Name = "WP_" .. id,
		Size = Vector3.new(8, 12, 8),
		CFrame = CFrame.new(position),
		Color = Config.Theme.Cyan,
		Transparency = 1,
		CanCollide = false,
	})
	p.CanQuery = false
	p.CanTouch = false
	p:SetAttribute("WaypointId", id)
	CollectionService:AddTag(p, Config.WaypointTag)
end

-- Ansprechbares Objekt fuer TALK-Schritte.
local function makeContact(part: BasePart, id: string, displayName: string)
	part:SetAttribute("ContactId", id)
	part:SetAttribute("DisplayName", displayName)
	CollectionService:AddTag(part, Config.ContactTag)
end

local function accentLight(part: BasePart, color: Color3, range: number, brightness: number?)
	local light = Instance.new("PointLight")
	light.Color = color
	light.Brightness = brightness or 2
	light.Range = range
	light.Parent = part
end

local function sign(part: BasePart, title: string, subtitle: string, color: Color3, height: number)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Sign"
	gui.Size = UDim2.fromOffset(240, 46)
	gui.StudsOffsetWorldSpace = Vector3.new(0, height, 0)
	gui.MaxDistance = 180

	local head = Instance.new("TextLabel")
	head.BackgroundTransparency = 1
	head.Font = Enum.Font.Code
	head.Text = title
	head.TextColor3 = color
	head.TextSize = 18
	head.Size = UDim2.new(1, 0, 0.6, 0)
	head.Parent = gui

	local sub = Instance.new("TextLabel")
	sub.BackgroundTransparency = 1
	sub.Font = Enum.Font.Code
	sub.Text = subtitle
	sub.TextColor3 = Config.Theme.TextDim
	sub.TextSize = 13
	sub.Position = UDim2.new(0, 0, 0.6, 0)
	sub.Size = UDim2.new(1, 0, 0.4, 0)
	sub.Parent = gui

	gui.Parent = part
end

--==========================================================================
-- 1) UEBUNGSTERMINAL  -  direkt am Spawn, Schwierigkeit 1
-- Erzeugt bewusst KEINEN Trace (Attribut NoTrace): niemand soll auffliegen,
-- bevor er weiss, was der Balken bedeutet. "Teaches" sagt der HackUI, dass
-- sie das Raetsel beim Oeffnen einmal erklaeren soll.
--==========================================================================
do
	local base = Vector3.new(-11, 0, 8)

	makePart({
		Name = "TerminalSockel",
		Size = Vector3.new(3, 3, 2),
		CFrame = CFrame.new(base + Vector3.new(0, 1.5, 0)),
		Color = Config.Palette.MetallDunkel,
		Material = Enum.Material.Metal,
	})

	local screen = makePart({
		Name = "Wartungsterminal",
		Size = Vector3.new(3.2, 2.4, 0.4),
		CFrame = CFrame.new(base + Vector3.new(0, 4, 0)) * CFrame.Angles(math.rad(-12), 0, 0),
		Color = Config.Theme.Cyan,
		Material = Enum.Material.Neon,
	})
	accentLight(screen, Config.Theme.Cyan, 16, 3)

	makeHackable(screen, {
		TargetId = "TUT_TERMINAL",
		DisplayName = "WARTUNGSTERMINAL // uebung",
		Difficulty = 1,
		HackType = "NodeBreach",
		RequiredLevel = 1,
		OnSuccess = "Offline",
		DownTime = 8,
		Cooldown = 20,
		NoTrace = true,
		Teaches = true,
	})

	sign(screen, "UEBUNG", "kein Risiko - einfach ausprobieren", Config.Theme.Cyan, 3.4)
end

--==========================================================================
-- 2) DER LADEN  -  Kreuzung Nord
-- Zwei gestaffelte Ziele in einer Alarm-Gruppe. Schloss startet die Uhr,
-- Tresor stoppt sie. Bleibt nach M02 als wiederholbarer Ueberfall stehen.
--==========================================================================
do
	local base = Vector3.new(-62, 0, -70)

	makeWaypoint("STORE_FRONT", base + Vector3.new(0, 4, 9))

	-- Huelle
	makePart({
		Name = "LadenBoden",
		Size = Vector3.new(24, 1, 18),
		CFrame = CFrame.new(base + Vector3.new(0, 0.5, -2)),
		Color = Config.Palette.InnenBoden,
		Material = Enum.Material.Concrete,
	})
	makePart({
		Name = "LadenRueckwand",
		Size = Vector3.new(24, 12, 1),
		CFrame = CFrame.new(base + Vector3.new(0, 6, -11)),
		Color = Config.Palette.Beton,
		Material = Enum.Material.Concrete,
	})
	makePart({
		Name = "LadenWandLinks",
		Size = Vector3.new(1, 12, 18),
		CFrame = CFrame.new(base + Vector3.new(-12, 6, -2)),
		Color = Config.Palette.Beton,
		Material = Enum.Material.Concrete,
	})
	makePart({
		Name = "LadenWandRechts",
		Size = Vector3.new(1, 12, 18),
		CFrame = CFrame.new(base + Vector3.new(12, 6, -2)),
		Color = Config.Palette.Beton,
		Material = Enum.Material.Concrete,
	})
	makePart({
		Name = "LadenDach",
		Size = Vector3.new(25, 0.8, 19),
		CFrame = CFrame.new(base + Vector3.new(0, 12, -2)),
		Color = Config.Palette.Dach,
		Material = Enum.Material.Metal,
	})
	-- Front mit Tueroeffnung
	makePart({
		Name = "LadenFrontLinks",
		Size = Vector3.new(9, 12, 1),
		CFrame = CFrame.new(base + Vector3.new(-7.5, 6, 7)),
		Color = Config.Palette.Beton,
		Material = Enum.Material.Concrete,
	})
	makePart({
		Name = "LadenFrontRechts",
		Size = Vector3.new(9, 12, 1),
		CFrame = CFrame.new(base + Vector3.new(7.5, 6, 7)),
		Color = Config.Palette.Beton,
		Material = Enum.Material.Concrete,
	})
	makePart({
		Name = "LadenSturz",
		Size = Vector3.new(6, 3, 1),
		CFrame = CFrame.new(base + Vector3.new(0, 10.5, 7)),
		Color = Config.Palette.Beton,
		Material = Enum.Material.Concrete,
	})

	-- Ziel 1: Tuerschloss. Startet die Alarm-Uhr.
	local lock = makePart({
		Name = "Tuerschloss",
		Size = Vector3.new(6, 9, 0.7),
		CFrame = CFrame.new(base + Vector3.new(0, 4.5, 7)),
		Color = Config.Palette.MetallDunkel,
		Material = Enum.Material.Metal,
	})
	accentLight(lock, Config.Theme.Amber, 14)
	makeHackable(lock, {
		TargetId = "STORE_LOCK",
		DisplayName = "TUERSCHLOSS // Kreuzung Nord",
		Difficulty = 3,
		HackType = "NodeBreach",
		RequiredLevel = 1,
		OnSuccess = "DoorOpen",
		DownTime = 45, -- lange genug offen, um wirklich reinzukommen
		Exposed = true, -- Ladenfront zur Strasse
		Cooldown = Config.Raid.StoreCooldown,
		AlarmGroup = "STORE",
		AlarmStarts = true,
	})
	sign(lock, "LADEN", "Notstrom - Schloss zuerst", Config.Theme.Amber, 6)

	-- Ziel 2: Tresor im Inneren. Stoppt die Uhr.
	makePart({
		Name = "TresorSockel",
		Size = Vector3.new(6, 1, 4),
		CFrame = CFrame.new(base + Vector3.new(0, 1.5, -9)),
		Color = Config.Palette.BetonDunkel,
		Material = Enum.Material.Concrete,
	})
	local safe = makePart({
		Name = "Tresor",
		Size = Vector3.new(5, 5, 3.4),
		CFrame = CFrame.new(base + Vector3.new(0, 4.5, -9)),
		Color = Config.Palette.Metall,
		Material = Enum.Material.Metal,
	})
	accentLight(safe, Config.Theme.Magenta, 14)
	makeHackable(safe, {
		TargetId = "STORE_SAFE",
		DisplayName = "TRESOR // Kreuzung Nord",
		Difficulty = 5,
		HackType = "NodeBreach",
		RequiredLevel = 1,
		OnSuccess = "AtmPayout",
		DownTime = 20,
		Cooldown = Config.Raid.StoreCooldown,
		AlarmGroup = "STORE",
		AlarmEnds = true,
		-- Kein Exposed: der Tresor steht im Laden. Wer erst reinkommt,
		-- arbeitet dort in Ruhe.
	})
end

--==========================================================================
-- 3) DAS APARTMENT  -  ab M03 der Hub
-- Kein Kulissenraum: hier stehen ab Phase C das Darknet und das Lager.
--==========================================================================
do
	local base = Vector3.new(46, 0, 22)

	makeWaypoint("APARTMENT_DOOR", base + Vector3.new(0, 4, 9))

	makePart({
		Name = "ApartmentBoden",
		Size = Vector3.new(20, 1, 18),
		CFrame = CFrame.new(base + Vector3.new(0, 0.5, 0)),
		Color = Config.Palette.Holz,
		Material = Enum.Material.WoodPlanks,
	})
	makePart({
		Name = "ApartmentRueckwand",
		Size = Vector3.new(20, 11, 1),
		CFrame = CFrame.new(base + Vector3.new(0, 6, -9)),
		Color = Config.Palette.Ziegel,
		Material = Enum.Material.Brick,
	})
	makePart({
		Name = "ApartmentWandLinks",
		Size = Vector3.new(1, 11, 18),
		CFrame = CFrame.new(base + Vector3.new(-10, 6, 0)),
		Color = Config.Palette.Ziegel,
		Material = Enum.Material.Brick,
	})
	makePart({
		Name = "ApartmentWandRechts",
		Size = Vector3.new(1, 11, 18),
		CFrame = CFrame.new(base + Vector3.new(10, 6, 0)),
		Color = Config.Palette.Ziegel,
		Material = Enum.Material.Brick,
	})
	makePart({
		Name = "ApartmentDach",
		Size = Vector3.new(21, 0.8, 19),
		CFrame = CFrame.new(base + Vector3.new(0, 11, 0)),
		Color = Config.Palette.InnenDecke,
		Material = Enum.Material.Concrete,
	})
	makePart({
		Name = "ApartmentFrontLinks",
		Size = Vector3.new(7, 11, 1),
		CFrame = CFrame.new(base + Vector3.new(-6.5, 6, 9)),
		Color = Config.Palette.Ziegel,
		Material = Enum.Material.Brick,
	})
	makePart({
		Name = "ApartmentFrontRechts",
		Size = Vector3.new(7, 11, 1),
		CFrame = CFrame.new(base + Vector3.new(6.5, 6, 9)),
		Color = Config.Palette.Ziegel,
		Material = Enum.Material.Brick,
	})
	makePart({
		Name = "ApartmentSturz",
		Size = Vector3.new(6, 4, 1),
		CFrame = CFrame.new(base + Vector3.new(0, 9, 9)),
		Color = Config.Palette.Ziegel,
		Material = Enum.Material.Brick,
	})

	-- Der Rechner. Kontakt fuer TALK-Schritte und ab Phase C der Zugang
	-- zum Darknet.
	makePart({
		Name = "Schreibtisch",
		Size = Vector3.new(8, 0.4, 3),
		CFrame = CFrame.new(base + Vector3.new(0, 3.4, -7)),
		Color = Config.Palette.Holz,
		Material = Enum.Material.Wood,
	})
	local rig = makePart({
		Name = "Rechner",
		Size = Vector3.new(5.4, 3, 0.5),
		CFrame = CFrame.new(base + Vector3.new(0, 5.2, -7.4)) * CFrame.Angles(math.rad(-8), 0, 0),
		Color = Config.Theme.Cyan,
		Material = Enum.Material.Neon,
	})
	accentLight(rig, Config.Theme.Cyan, 20, 3)
	makeContact(rig, "HOME_RIG", "DEIN RECHNER")
	sign(rig, "RECHNER", "[E] - Darknet", Config.Theme.Cyan, 3)

	makePart({
		Name = "ApartmentLampe",
		Size = Vector3.new(19, 0.3, 0.6),
		CFrame = CFrame.new(base + Vector3.new(0, 10.4, 0)),
		Color = Config.Theme.Amber,
		Material = Enum.Material.Neon,
		CanCollide = false,
	})
end

--==========================================================================
-- 4) NAKAMURA BANK  -  das Grossziel (M05, danach mit langem Cooldown)
-- Drei Stufen in einer Alarm-Gruppe. Der Tresorraum bustet bei Fehlschlag
-- und traegt RequiresTwo: zu zweit halbiert sich Trace und Alarmtempo.
--==========================================================================
do
	local base = Vector3.new(78, 0, -86)

	makeWaypoint("BANK_FRONT", base + Vector3.new(0, 4, 16))

	makePart({
		Name = "BankBoden",
		Size = Vector3.new(34, 1, 30),
		CFrame = CFrame.new(base + Vector3.new(0, 0.5, 0)),
		Color = Config.Palette.InnenBoden,
		Material = Enum.Material.Marble,
	})
	makePart({
		Name = "BankRueckwand",
		Size = Vector3.new(34, 18, 1),
		CFrame = CFrame.new(base + Vector3.new(0, 9, -15)),
		Color = Config.Palette.BetonHell,
		Material = Enum.Material.Concrete,
	})
	makePart({
		Name = "BankWandLinks",
		Size = Vector3.new(1, 18, 30),
		CFrame = CFrame.new(base + Vector3.new(-17, 9, 0)),
		Color = Config.Palette.BetonHell,
		Material = Enum.Material.Concrete,
	})
	makePart({
		Name = "BankWandRechts",
		Size = Vector3.new(1, 18, 30),
		CFrame = CFrame.new(base + Vector3.new(17, 9, 0)),
		Color = Config.Palette.BetonHell,
		Material = Enum.Material.Concrete,
	})
	makePart({
		Name = "BankDach",
		Size = Vector3.new(35, 1, 31),
		CFrame = CFrame.new(base + Vector3.new(0, 18, 0)),
		Color = Config.Palette.Dach,
		Material = Enum.Material.Concrete,
	})
	makePart({
		Name = "BankFrontLinks",
		Size = Vector3.new(14, 18, 1),
		CFrame = CFrame.new(base + Vector3.new(-10, 9, 15)),
		Color = Config.Palette.BetonHell,
		Material = Enum.Material.Concrete,
	})
	makePart({
		Name = "BankFrontRechts",
		Size = Vector3.new(14, 18, 1),
		CFrame = CFrame.new(base + Vector3.new(10, 9, 15)),
		Color = Config.Palette.BetonHell,
		Material = Enum.Material.Concrete,
	})
	makePart({
		Name = "BankSturz",
		Size = Vector3.new(6, 8, 1),
		CFrame = CFrame.new(base + Vector3.new(0, 14, 15)),
		Color = Config.Palette.BetonHell,
		Material = Enum.Material.Concrete,
	})

	-- Stufe 1: Aussenkamera. Startet die Uhr.
	makePart({
		Name = "BankKameraArm",
		Size = Vector3.new(0.5, 0.5, 3),
		CFrame = CFrame.new(base + Vector3.new(-6, 15, 16.5)),
		Color = Config.Palette.Metall,
		Material = Enum.Material.Metal,
	})
	local cam = makePart({
		Name = "Aussenkamera",
		Size = Vector3.new(1.6, 1.6, 3),
		CFrame = CFrame.new(base + Vector3.new(-6, 15, 18)) * CFrame.Angles(math.rad(-20), 0, 0),
		Color = Config.Palette.MetallDunkel,
		Material = Enum.Material.Metal,
	})
	accentLight(cam, Config.Theme.Magenta, 16)
	makeHackable(cam, {
		TargetId = "BANK_CAM",
		DisplayName = "CAM-01 // Nakamura Bank",
		Difficulty = 4,
		HackType = "NodeBreach",
		RequiredLevel = 2,
		OnSuccess = "CameraOffline",
		DownTime = 90,
		Cooldown = Config.Raid.BankCooldown,
		AlarmGroup = "BANK",
		AlarmStarts = true,
		Exposed = true, -- haengt aussen ueber dem Eingang
	})
	sign(cam, "NAKAMURA BANK", "drei Schichten, ein Alarm", Config.Theme.Magenta, 3.4)

	-- Stufe 2: Sicherheitstuer.
	local door = makePart({
		Name = "BankSicherheitstuer",
		Size = Vector3.new(6, 12, 0.9),
		CFrame = CFrame.new(base + Vector3.new(0, 6, 15)),
		Color = Config.Palette.MetallDunkel,
		Material = Enum.Material.Metal,
	})
	accentLight(door, Config.Theme.Cyan, 14)
	makeHackable(door, {
		TargetId = "BANK_DOOR",
		DisplayName = "SICHERHEITSTUER // Nakamura Bank",
		Difficulty = 6,
		HackType = "NodeBreach",
		RequiredLevel = 2,
		OnSuccess = "DoorOpen",
		DownTime = 60,
		Cooldown = Config.Raid.BankCooldown,
		AlarmGroup = "BANK",
		Exposed = true, -- Eingangstuer, direkt an der Strasse
	})

	-- Stufe 3: Tresorraum. Fehlschlag = sofort auffliegen. Zu zweit leichter.
	makePart({
		Name = "TresorraumRahmen",
		Size = Vector3.new(12, 12, 2),
		CFrame = CFrame.new(base + Vector3.new(0, 6, -13)),
		Color = Config.Palette.Metall,
		Material = Enum.Material.Metal,
	})
	local vault = makePart({
		Name = "Tresorraum",
		Size = Vector3.new(8, 8, 2.6),
		CFrame = CFrame.new(base + Vector3.new(0, 5, -12)),
		Color = Config.Palette.Metall,
		Material = Enum.Material.DiamondPlate,
	})
	accentLight(vault, Config.Theme.Amber, 20, 3)
	makeHackable(vault, {
		TargetId = "BANK_VAULT",
		DisplayName = "TRESORRAUM // Nakamura Bank",
		Difficulty = 8,
		HackType = "NodeBreach",
		RequiredLevel = 3,
		OnSuccess = "AtmPayout",
		DownTime = 30,
		Cooldown = Config.Raid.BankCooldown,
		AlarmGroup = "BANK",
		AlarmEnds = true,
		FailBusts = true,
		RequiresTwo = true,
	})
	sign(vault, "TRESORRAUM", "Fehlschlag = sofort auffliegen", Config.Theme.Amber, 5)
end

print("[GHOSTNET] Story-Welt gebaut: Uebungsterminal, Laden, Apartment, Nakamura Bank.")
</ProtectedString>
</Properties>
</Item>
<Item class="Script" referent="GN45">
<Properties>
<string name="Name">TestTargets</string>
<ProtectedString name="Source">-- ServerScriptService/World/TestTargets.server.luau
--!strict
-- GHOSTNET :: Drei Testobjekte und ein Hehler fuer Phase 1.
--
-- Wichtig fuer das Gesamtbild: In diesem Skript steht KEINE Hack-Logik.
-- Es baut Parts und setzt Attribute. Genau so entstehen spaeter auch alle
-- echten Ziele in der Stadt - per Hand im Studio oder per Generator.
--
-- Der Hehler steht bewusst am Spawn und damit ein Stueck von den Zielen weg:
-- Der Rueckweg kostet Zeit, waehrend der Trace weiterlaeuft. Ohne diese
-- Distanz waere Verkaufen keine Entscheidung, sondern nur ein Knopf.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local FOLDER_NAME = "GhostNet_TestTargets"

if workspace:FindFirstChild(FOLDER_NAME) then
	return -- schon gebaut (z.B. nach einem Studio-Reload)
end

local folder = Instance.new("Folder")
folder.Name = FOLDER_NAME
folder.Parent = workspace

type PartProps = {
	Name: string,
	Size: Vector3,
	CFrame: CFrame,
	Color: Color3,
	Material: Enum.Material?,
	Transparency: number?,
	CanCollide: boolean?,
	Parent: Instance?,
}

local function makePart(props: PartProps): Part
	local p = Instance.new("Part")
	p.Name = props.Name
	p.Size = props.Size
	p.CFrame = props.CFrame
	p.Color = props.Color
	p.Material = props.Material or Enum.Material.SmoothPlastic
	p.Transparency = props.Transparency or 0
	p.CanCollide = if props.CanCollide == nil then true else props.CanCollide
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = props.Parent or folder
	return p
end

-- Macht aus einem beliebigen Part ein Hack-Ziel. Nur Attribute, sonst nichts.
local function makeHackable(part: BasePart, attributes: { [string]: any })
	for key, value in attributes do
		part:SetAttribute(key, value)
	end
	part:SetAttribute("Offline", false)
	CollectionService:AddTag(part, Config.HackableTag)
end

local function accentLight(part: BasePart, color: Color3, range: number)
	local light = Instance.new("PointLight")
	light.Color = color
	light.Brightness = 2
	light.Range = range
	light.Parent = part
end

-- Schwebender Text ueber einem Part. Nur Deko und Orientierung.
local function signboard(part: BasePart, title: string, subtitle: string, color: Color3, height: number)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Sign"
	gui.Size = UDim2.fromOffset(220, 46)
	gui.StudsOffsetWorldSpace = Vector3.new(0, height, 0)
	gui.AlwaysOnTop = false
	gui.MaxDistance = 140

	local head = Instance.new("TextLabel")
	head.BackgroundTransparency = 1
	head.Font = Enum.Font.Code
	head.Text = title
	head.TextColor3 = color
	head.TextSize = 18
	head.Size = UDim2.new(1, 0, 0.6, 0)
	head.Parent = gui

	local sub = Instance.new("TextLabel")
	sub.BackgroundTransparency = 1
	sub.Font = Enum.Font.Code
	sub.Text = subtitle
	sub.TextColor3 = Config.Theme.TextDim
	sub.TextSize = 13
	sub.Position = UDim2.new(0, 0, 0.6, 0)
	sub.Size = UDim2.new(1, 0, 0.4, 0)
	sub.Parent = gui

	gui.Parent = part
end

--==========================================================================
-- 1) UEBERWACHUNGSKAMERA  -  Schwierigkeit 2
--==========================================================================
do
	local base = Vector3.new(-24, 0, -26)

	makePart({
		Name = "KameraMast",
		Size = Vector3.new(0.8, 12, 0.8),
		CFrame = CFrame.new(base + Vector3.new(0, 6, 0)),
		Color = Config.Palette.Metall,
		Material = Enum.Material.Metal,
	})

	makePart({
		Name = "KameraArm",
		Size = Vector3.new(3.4, 0.5, 0.5),
		CFrame = CFrame.new(base + Vector3.new(1.7, 11.6, 0)),
		Color = Config.Palette.Metall,
		Material = Enum.Material.Metal,
	})

	local head = makePart({
		Name = "Ueberwachungskamera",
		Size = Vector3.new(1.6, 1.6, 3.2),
		CFrame = CFrame.new(base + Vector3.new(3.4, 11.2, 0)) * CFrame.Angles(math.rad(-15), 0, 0),
		Color = Config.Palette.MetallDunkel,
		Material = Enum.Material.Metal,
	})
	accentLight(head, Config.Theme.Magenta, 14)

	makeHackable(head, {
		DisplayName = "CAM-07 // Kreuzung Nord",
		Difficulty = 2,
		HackType = "NodeBreach",
		RequiredLevel = 1,
		OnSuccess = "CameraOffline",
		DownTime = 30,
		-- Haengt an einer Fassade ueber dem Gehweg: jeder sieht einen dabei.
		Exposed = true,
	})
end

--==========================================================================
-- 2) SICHERHEITSTUER  -  Schwierigkeit 4
--==========================================================================
do
	local base = Vector3.new(0, 0, -38)

	makePart({
		Name = "WandLinks",
		Size = Vector3.new(10, 12, 1.2),
		CFrame = CFrame.new(base + Vector3.new(-8, 6, 0)),
		Color = Config.Palette.Beton,
		Material = Enum.Material.Concrete,
	})
	makePart({
		Name = "WandRechts",
		Size = Vector3.new(10, 12, 1.2),
		CFrame = CFrame.new(base + Vector3.new(8, 6, 0)),
		Color = Config.Palette.Beton,
		Material = Enum.Material.Concrete,
	})
	makePart({
		Name = "Sturz",
		Size = Vector3.new(6, 2, 1.2),
		CFrame = CFrame.new(base + Vector3.new(0, 11, 0)),
		Color = Config.Palette.Beton,
		Material = Enum.Material.Concrete,
	})

	local door = makePart({
		Name = "Sicherheitstuer",
		Size = Vector3.new(6, 10, 0.8),
		CFrame = CFrame.new(base + Vector3.new(0, 5, 0)),
		Color = Config.Palette.MetallDunkel,
		Material = Enum.Material.Metal,
	})
	accentLight(door, Config.Theme.Cyan, 12)

	makeHackable(door, {
		-- Kein Exposed: die Tuer liegt an der Rueckseite der Halle. Weniger
		-- Ertrag als der Automat, dafuer sieht einen dort niemand.
		DisplayName = "SEC-DOOR // Lagerhalle B",
		Difficulty = 4,
		HackType = "NodeBreach",
		RequiredLevel = 1,
		OnSuccess = "DoorOpen",
		DownTime = 12,
	})
end

--==========================================================================
-- 3) GELDAUTOMAT  -  Schwierigkeit 6
--==========================================================================
do
	local base = Vector3.new(24, 0, -26)

	makePart({
		Name = "AutomatSockel",
		Size = Vector3.new(5, 1, 3),
		CFrame = CFrame.new(base + Vector3.new(0, 0.5, 0)),
		Color = Config.Palette.BetonDunkel,
		Material = Enum.Material.Concrete,
	})

	local atm = makePart({
		Name = "Geldautomat",
		Size = Vector3.new(4.4, 7, 2.4),
		CFrame = CFrame.new(base + Vector3.new(0, 4.5, 0)),
		Color = Config.Palette.Metall,
		Material = Enum.Material.Metal,
	})

	makePart({
		Name = "AutomatDisplay",
		Size = Vector3.new(3, 2.2, 0.2),
		CFrame = CFrame.new(base + Vector3.new(0, 5.6, 1.25)),
		Color = Config.Theme.Cyan,
		Material = Enum.Material.Neon,
		CanCollide = false,
	})
	accentLight(atm, Config.Theme.Cyan, 16)

	makeHackable(atm, {
		DisplayName = "ATM // Nakamura Bank",
		Difficulty = 6,
		HackType = "NodeBreach",
		RequiredLevel = 1,
		OnSuccess = "AtmPayout",
		Cooldown = 300,
		DownTime = 20,
		-- Steht offen am Gehweg. Das lohnendste Ziel der Uebungszone -
		-- und das, bei dem der Trace am schnellsten hochgeht.
		Exposed = true,
	})
end

--==========================================================================
-- 4) HEHLER  -  hier wird Unverkauftes zu sicherem Guthaben
-- Wie bei den Hack-Zielen gilt: nur ein Part plus Tag. Ein zweiter Hehler
-- irgendwo in der Stadt braucht keine Zeile Code.
--==========================================================================
do
	local base = Vector3.new(0, 0, 20)

	makePart({
		Name = "HehlerRueckwand",
		Size = Vector3.new(12, 9, 1),
		CFrame = CFrame.new(base + Vector3.new(0, 4.5, 2.5)),
		Color = Config.Palette.Beton,
		Material = Enum.Material.Concrete,
	})

	makePart({
		Name = "HehlerDach",
		Size = Vector3.new(13, 0.6, 6),
		CFrame = CFrame.new(base + Vector3.new(0, 9, 0)),
		Color = Config.Palette.Dach,
		Material = Enum.Material.Metal,
	})

	local counter = makePart({
		Name = "Hehler",
		Size = Vector3.new(10, 4, 2.4),
		CFrame = CFrame.new(base + Vector3.new(0, 2, 0)),
		Color = Config.Palette.Metall,
		Material = Enum.Material.Metal,
	})

	makePart({
		Name = "HehlerLeuchtband",
		Size = Vector3.new(10.2, 0.35, 2.6),
		CFrame = CFrame.new(base + Vector3.new(0, 4.1, 0)),
		Color = Config.Theme.Green,
		Material = Enum.Material.Neon,
		CanCollide = false,
	})

	local light = Instance.new("PointLight")
	light.Color = Config.Theme.Green
	light.Brightness = 3
	light.Range = 22
	light.Parent = counter

	counter:SetAttribute("DisplayName", "HEHLER // Kanalgasse")
	CollectionService:AddTag(counter, Config.FenceTag)

	signboard(
		counter,
		"HEHLER",
		("Gebuehr %d%%  //  Trace -%d"):format(math.floor(Config.Sell.FeePercent * 100), Config.Sell.TraceRelief),
		Config.Theme.Green,
		4.6
	)
end

print("[GHOSTNET] Testwelt gebaut: Kamera (D2), Sicherheitstuer (D4), Geldautomat (D6), Hehler am Spawn.")
</ProtectedString>
</Properties>
</Item>
<Item class="Script" referent="GN46">
<Properties>
<string name="Name">TestVehicles</string>
<ProtectedString name="Source">-- ServerScriptService/World/TestVehicles.server.luau
--!strict
-- GHOSTNET :: Ein Fahrzeug jeder Klasse zum Ausprobieren.
--
-- Steht bewusst getrennt vom Rest der Welt: Phase 4 baut den Autohaendler
-- und den Fahrzeugbesitz im Profil. Bis dahin ist das hier der Weg, das
-- Fahrgefuehl zu testen - und danach bleibt es als Uebungsgelaende stehen.
--
-- Attribut "Permanent" verhindert, dass der Leerlauf-Aufraeumer sie
-- wegraeumt. Bei spaeter gekauften Fahrzeugen ist das genau umgekehrt.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Config = require(ReplicatedStorage.Shared.Config)
local Vehicles = require(ReplicatedStorage.Shared.Vehicles)

local VehicleChassis = require(ServerScriptService:WaitForChild("Systems"):WaitForChild("VehicleChassis"))

local FOLDER_NAME = "GhostNet_TestVehicles"

if workspace:FindFirstChild(FOLDER_NAME) then
	return
end

local folder = Instance.new("Folder")
folder.Name = FOLDER_NAME
folder.Parent = workspace

-- Kleiner Parkstreifen neben dem Spawn.
local base = Vector3.new(26, 3, 30)

local pad = Instance.new("Part")
pad.Name = "Parkstreifen"
pad.Size = Vector3.new(20, 1, 14 * Vehicles.Count())
pad.CFrame = CFrame.new(base + Vector3.new(0, -2.5, 14 * Vehicles.Count() * 0.5 - 7))
pad.Color = Config.Palette.Asphalt
pad.Material = Enum.Material.Concrete
pad.Anchored = true
pad.CanQuery = false
pad.TopSurface = Enum.SurfaceType.Smooth
pad.Parent = folder

local built = 0
for index, class in Vehicles.List do
	local position = base + Vector3.new(0, 0, (index - 1) * 14)
	local model = VehicleChassis.Build(class.Id, CFrame.new(position) * CFrame.Angles(0, math.rad(-90), 0))
	if model then
		model:SetAttribute("Permanent", true)
		built += 1

		-- Schild, damit man sieht, welche Klasse man gerade faehrt.
		local body = model.PrimaryPart
		if body then
			local sign = Instance.new("BillboardGui")
			sign.Name = "Sign"
			sign.Size = UDim2.fromOffset(220, 40)
			sign.StudsOffsetWorldSpace = Vector3.new(0, 4, 0)
			sign.MaxDistance = 90

			local title = Instance.new("TextLabel")
			title.BackgroundTransparency = 1
			title.Font = Enum.Font.Code
			title.Text = class.Name
			title.TextColor3 = Config.Theme.Cyan
			title.TextSize = 16
			title.Size = UDim2.new(1, 0, 0.55, 0)
			title.Parent = sign

			local blurb = Instance.new("TextLabel")
			blurb.BackgroundTransparency = 1
			blurb.Font = Enum.Font.Code
			blurb.Text = class.Blurb
			blurb.TextColor3 = Config.Theme.TextDim
			blurb.TextSize = 11
			blurb.Position = UDim2.new(0, 0, 0.55, 0)
			blurb.Size = UDim2.new(1, 0, 0.45, 0)
			blurb.Parent = sign

			sign.Parent = body
		end
	end
end

print(("[GHOSTNET] %d Testfahrzeuge gebaut."):format(built))
</ProtectedString>
</Properties>
</Item>
