<Item class="StarterPlayer" referent="GN78">
<Properties>
<string name="Name">StarterPlayer</string>
</Properties>
<Item class="StarterPlayerScripts" referent="GN79">
<Properties>
<string name="Name">StarterPlayerScripts</string>
</Properties>
<Item class="Folder" referent="GN61">
<Properties>
<string name="Name">UI</string>
</Properties>
<Item class="LocalScript" referent="GN48">
<Properties>
<string name="Name">AdminUI</string>
<ProtectedString name="Source">-- StarterPlayer/StarterPlayerScripts/UI/AdminUI.client.luau
--!strict
-- GHOSTNET :: Admin-Panel, F2.
--
-- WICHTIG: Dieses Skript ist reine Bequemlichkeit. Es entscheidet NICHTS.
-- Ob ein Befehl ausgefuehrt wird, prueft der AdminService in der ersten
-- Zeile jedes Handlers anhand der UserId. Wer dieses Skript manipuliert oder
-- die Remote von Hand feuert, bekommt genau dieselbe Ablehnung.
--
-- Das Panel taucht erst auf, wenn der Server AdminReady geschickt hat.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Remotes = require(ReplicatedStorage.Shared.Remotes)
local UITheme = require(ReplicatedStorage.Shared.UITheme)

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local C = UITheme.Color

local authorised = false
local studio = false
local busy = false

--==========================================================================
-- Aufbau
--==========================================================================

local gui = UITheme.Screen("GhostNetAdmin", 40)
gui.Enabled = false
gui.Parent = playerGui

local window = UITheme.Frame({
	Name = "Window",
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.new(0.9, 0, 0.85, 0),
	BackgroundColor3 = C.Background,
	ClipsDescendants = true,
	Parent = gui,
})
UITheme.Corner(window, 5)
UITheme.Stroke(window, C.Magenta)

local sizeConstraint = Instance.new("UISizeConstraint")
sizeConstraint.MaxSize = Vector2.new(760, 560)
sizeConstraint.MinSize = Vector2.new(320, 320)
sizeConstraint.Parent = window

local titleBar = UITheme.Frame({
	Name = "TitleBar",
	Size = UDim2.new(1, 0, 0, 32),
	BackgroundColor3 = C.Panel,
	Parent = window,
})

local titleLabel = UITheme.Label({
	Name = "Title",
	Text = "GHOSTNET // ADMIN",
	TextColor3 = C.Magenta,
	TextSize = 14,
	Position = UDim2.new(0, 12, 0, 0),
	Size = UDim2.new(0.7, 0, 1, 0),
	Parent = titleBar,
})

local closeButton = UITheme.Button({
	Name = "Close",
	Text = "F2",
	TextSize = 11,
	TextColor3 = C.TextDim,
	BackgroundColor3 = C.PanelLight,
	AnchorPoint = Vector2.new(1, 0.5),
	Position = UDim2.new(1, -8, 0.5, 0),
	Size = UDim2.fromOffset(48, 22),
	Parent = titleBar,
})
UITheme.Corner(closeButton, 3)

--== Eingabefelder =========================================================

local function inputBox(name: string, placeholder: string, x: number, width: number): TextBox
	local box = Instance.new("TextBox")
	box.Name = name
	box.BackgroundColor3 = C.PanelLight
	box.BorderSizePixel = 0
	box.Font = UITheme.Font
	box.TextColor3 = C.Text
	box.TextSize = 13
	box.PlaceholderText = placeholder
	box.PlaceholderColor3 = C.TextDim
	box.Text = ""
	box.ClearTextOnFocus = false
	box.Position = UDim2.new(0, x, 0, 40)
	box.Size = UDim2.fromOffset(width, 28)
	box.Parent = window
	UITheme.Corner(box, 3)
	UITheme.Stroke(box, C.Line)
	return box
end

local playerBox = inputBox("PlayerBox", "Spieler (leer = du)", 12, 170)
local valueBox = inputBox("ValueBox", "Wert / Id", 190, 150)

--== Ausgabe ===============================================================

local output = Instance.new("ScrollingFrame")
output.Name = "Output"
output.BackgroundColor3 = C.Panel
output.BorderSizePixel = 0
output.AnchorPoint = Vector2.new(1, 0)
output.Position = UDim2.new(1, -12, 0, 76)
output.Size = UDim2.new(0.46, 0, 1, -88)
output.CanvasSize = UDim2.new()
output.AutomaticCanvasSize = Enum.AutomaticSize.Y
output.ScrollBarThickness = 4
output.ScrollBarImageColor3 = C.Line
output.Parent = window
UITheme.Corner(output, 3)
UITheme.Stroke(output, C.Line)
UITheme.Padding(output, 8)

local outputLayout = Instance.new("UIListLayout")
outputLayout.SortOrder = Enum.SortOrder.LayoutOrder
outputLayout.Padding = UDim.new(0, 2)
outputLayout.Parent = output

local outputLines: { TextLabel } = {}

local function log(text: string, colour: Color3?)
	local line = UITheme.Label({
		Text = text,
		TextColor3 = colour or C.Text,
		TextSize = 11,
		TextWrapped = true,
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, 0, 0, 0),
		LayoutOrder = #outputLines + 1,
		Parent = output,
	})
	table.insert(outputLines, line)
	while #outputLines &gt; 80 do
		local old = table.remove(outputLines, 1)
		if old then
			old:Destroy()
		end
	end
	output.CanvasPosition = Vector2.new(0, 1e6)
end

--== Befehlsliste ==========================================================

local buttonArea = Instance.new("ScrollingFrame")
buttonArea.Name = "Commands"
buttonArea.BackgroundTransparency = 1
buttonArea.BorderSizePixel = 0
buttonArea.Position = UDim2.new(0, 12, 0, 76)
buttonArea.Size = UDim2.new(0.5, -24, 1, -88)
buttonArea.CanvasSize = UDim2.new()
buttonArea.AutomaticCanvasSize = Enum.AutomaticSize.Y
buttonArea.ScrollBarThickness = 4
buttonArea.ScrollBarImageColor3 = C.Line
buttonArea.Parent = window

local buttonLayout = Instance.new("UIListLayout")
buttonLayout.SortOrder = Enum.SortOrder.LayoutOrder
buttonLayout.Padding = UDim.new(0, 4)
buttonLayout.Parent = buttonArea

local order = 0

local function send(payload: { [string]: any })
	if busy then
		return
	end
	busy = true
	task.spawn(function()
		local ok, response = pcall(function()
			return Remotes.AdminCommand:InvokeServer(payload)
		end)
		busy = false

		if not ok or typeof(response) ~= "table" then
			log("!! Aufruf fehlgeschlagen", C.Magenta)
			return
		end

		log(("%s %s"):format(if response.Ok then "&gt;" else "!!", tostring(response.Text)),
			if response.Ok then C.Cyan else C.Amber)

		-- Tabellenartige Antworten zeilenweise ausgeben.
		for _, key in { "Targets", "Sessions", "Market" } do
			local rows = response[key]
			if typeof(rows) == "table" then
				for _, row in rows do
					local parts: { string } = {}
					for field, value in row do
						table.insert(parts, ("%s=%s"):format(field, tostring(value)))
					end
					table.sort(parts)
					log("   " .. table.concat(parts, "  "), C.TextDim)
				end
			end
		end

		if typeof(response.Json) == "string" then
			log(response.Json, C.Text)
			log("(auch in der Server-Ausgabe zum Kopieren)", C.TextDim)
		end
	end)
end

local function header(text: string)
	order += 1
	local label = UITheme.Label({
		Name = "H",
		Text = text,
		TextColor3 = C.TextDim,
		TextSize = 11,
		Size = UDim2.new(1, -8, 0, 18),
		LayoutOrder = order,
		Parent = buttonArea,
	})
	return label
end

local function command(text: string, build: () -&gt; { [string]: any }, studioOnly: boolean)
	order += 1
	local button = UITheme.Button({
		Name = text,
		Text = text .. (if studioOnly then "   [Studio]" else ""),
		TextSize = 12,
		TextColor3 = if studioOnly then C.Amber else C.Cyan,
		TextXAlignment = Enum.TextXAlignment.Left,
		BackgroundColor3 = C.Panel,
		Size = UDim2.new(1, -8, 0, 30),
		LayoutOrder = order,
		Parent = buttonArea,
	})
	UITheme.Corner(button, 3)
	UITheme.Stroke(button, C.Line)
	UITheme.Padding(button, 8)
	button.Activated:Connect(function()
		send(build())
	end)
end

local function targetPlayer(): string
	return playerBox.Text
end

local function value(): string
	return valueBox.Text
end

local function number(default: number): number
	return tonumber(valueBox.Text) or default
end

header("WIRTSCHAFT")
command("Crypto setzen (Wert = Bank)", function()
	return { Command = "SetCrypto", Player = targetPlayer(), Banked = number(10000) }
end, true)
command("Unverkauft setzen (Wert)", function()
	return { Command = "SetCrypto", Player = targetPlayer(), Unsold = number(500) }
end, true)
command("Rig komplett auf Stufe (Wert)", function()
	return { Command = "SetRig", Player = targetPlayer(), Level = number(5) }
end, true)
command("Trace setzen (Wert)", function()
	return { Command = "SetTrace", Player = targetPlayer(), Value = number(80) }
end, true)
command("Bust ausloesen", function()
	return { Command = "Bust", Player = targetPlayer() }
end, true)

header("MISSIONEN")
command("Zu Mission springen (Wert = Id)", function()
	return { Command = "SetMission", Player = targetPlayer(), MissionId = value() }
end, true)
command("Story zuruecksetzen", function()
	return { Command = "ResetStory", Player = targetPlayer() }
end, true)
command("Unlock vergeben (Wert = Key)", function()
	return { Command = "GrantUnlock", Player = targetPlayer(), Unlock = value() }
end, true)

header("WELT")
command("Alle Ziele auflisten", function()
	return { Command = "ListTargets" }
end, false)
command("Cooldowns loeschen (Wert = TargetId, leer = alle)", function()
	return { Command = "ClearCooldown", Player = targetPlayer(), TargetId = value() }
end, false)
command("Zu Ziel teleportieren (Wert = TargetId)", function()
	return { Command = "Teleport", TargetId = value() }
end, false)

header("MARKT")
command("Kurse anzeigen", function()
	return { Command = "MarketState" }
end, false)
command("Event ausloesen (Wert = Gruppe)", function()
	return { Command = "MarketEvent", Group = value() }
end, true)
command("Preis setzen (Wert = GoodId:Faktor)", function()
	local id, factor = string.match(value(), "^(%w+):([%d%.]+)$")
	return { Command = "SetPrice", GoodId = id or value(), Factor = tonumber(factor) or 1 }
end, true)

header("DEBUG")
command("Aktive Sitzungen", function()
	return { Command = "Sessions" }
end, false)
command("Profil als JSON ausgeben", function()
	return { Command = "DumpProfile", Player = targetPlayer() }
end, false)
command("Speichern erzwingen", function()
	return { Command = "ForceSave", Player = targetPlayer() }
end, false)

--==========================================================================
-- Oeffnen
--==========================================================================

local function toggle()
	if not authorised then
		return
	end
	gui.Enabled = not gui.Enabled
end

closeButton.Activated:Connect(toggle)

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.KeyCode == Enum.KeyCode.F2 then
		toggle()
	elseif input.KeyCode == Enum.KeyCode.Escape and gui.Enabled then
		gui.Enabled = false
	end
end)

Remotes.AdminReady.OnClientEvent:Connect(function(data: any)
	authorised = true
	studio = typeof(data) == "table" and data.Studio == true
	titleLabel.Text = if studio then "GHOSTNET // ADMIN  [STUDIO]" else "GHOSTNET // ADMIN  [LIVE]"
	log("Panel bereit. F2 oeffnet und schliesst.", C.Cyan)
	if not studio then
		log("Live-Modus: Wirtschafts- und Missions-Befehle sind gesperrt.", C.Amber)
	end
end)
</ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="GN49">
<Properties>
<string name="Name">CityUI</string>
<ProtectedString name="Source">-- StarterPlayer/StarterPlayerScripts/UI/CityUI.client.luau
--!strict
-- GHOSTNET :: Garage, Fahndungsstufe und die Endgame-Entscheidung.
--
-- Reine Anzeige. Ob ein Fahrzeug ausgeparkt werden darf, was es kostet und
-- welche Fahndungsstufe gilt, entscheidet ausschliesslich der Server.
--
-- Garage mit [G], die Entscheidung erscheint erst, wenn Mission 10 durch ist.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local UITheme = require(ReplicatedStorage.Shared.UITheme)
local Vehicles = require(ReplicatedStorage.Shared.Vehicles)

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local C = UITheme.Color

local garage = { Owned = {}, Spawned = "", DealerOpen = false, Colours = {}, RepaintCost = 0 }
local pursuit = { Level = 0, Escaping = false, Seconds = 0 }
local endgame = { Unlocked = false, Choice = "", SwitchIn = 0 }
local banked = 0
local busy = false
local selectedColour = "Schwarz"

--==========================================================================
-- Fahndungsstufe: Sterne oben Mitte
--==========================================================================

local gui = UITheme.Screen("GhostNetCity", 13)
gui.Parent = playerGui

local starHolder = UITheme.Frame({
	Name = "Wanted",
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 160),
	Size = UDim2.fromOffset(240, 40),
	BackgroundTransparency = 1,
	Visible = false,
	Parent = gui,
})
local starLayout = Instance.new("UIListLayout")
starLayout.FillDirection = Enum.FillDirection.Horizontal
starLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
starLayout.Padding = UDim.new(0, 6)
starLayout.Parent = starHolder

local stars: { TextLabel } = {}
for index = 1, Config.Pursuit.MaxLevel do
	local star = UITheme.Label({
		Name = "Star",
		Text = "\u{2605}",
		TextColor3 = C.Line,
		TextSize = 26,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromOffset(28, 32),
		LayoutOrder = index,
		Parent = starHolder,
	})
	table.insert(stars, star)
end

local escapeLabel = UITheme.Label({
	Name = "Escape",
	Text = "",
	TextColor3 = C.Amber,
	TextSize = 13,
	TextXAlignment = Enum.TextXAlignment.Center,
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 200),
	Size = UDim2.fromOffset(320, 18),
	Visible = false,
	Parent = gui,
})

local function refreshPursuit()
	starHolder.Visible = pursuit.Level &gt; 0
	escapeLabel.Visible = pursuit.Escaping

	for index, star in stars do
		if index &lt;= pursuit.Level then
			local pulse = 0.5 + 0.5 * math.sin(os.clock() * 6 + index)
			star.TextColor3 = C.Magenta:Lerp(C.Amber, pulse * 0.4)
		else
			star.TextColor3 = C.Line
		end
	end

	if pursuit.Escaping then
		escapeLabel.Text = ("AUSSER SICHT - noch %d s, dann bist du raus"):format(math.ceil(pursuit.Seconds))
	end
end

--==========================================================================
-- Garage
--==========================================================================

local backdrop = UITheme.Frame({
	Name = "Backdrop",
	Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = Color3.new(0, 0, 0),
	BackgroundTransparency = 1,
	Visible = false,
	Parent = gui,
})

local window = UITheme.Frame({
	Name = "Window",
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.new(0.9, 0, 0.82, 0),
	BackgroundColor3 = C.Background,
	ClipsDescendants = true,
	Parent = backdrop,
})
UITheme.Corner(window, 5)
UITheme.Stroke(window, C.CyanDim)

local sizeConstraint = Instance.new("UISizeConstraint")
sizeConstraint.MaxSize = Vector2.new(700, 520)
sizeConstraint.MinSize = Vector2.new(300, 300)
sizeConstraint.Parent = window

local titleBar = UITheme.Frame({
	Name = "TitleBar",
	Size = UDim2.new(1, 0, 0, 34),
	BackgroundColor3 = C.Panel,
	Parent = window,
})

UITheme.Label({
	Name = "Title",
	Text = "GHOSTNET // GARAGE",
	TextColor3 = C.Cyan,
	TextSize = 14,
	Position = UDim2.new(0, 12, 0, 0),
	Size = UDim2.new(0.5, 0, 1, 0),
	Parent = titleBar,
})

local statusLabel = UITheme.Label({
	Name = "Status",
	Text = "",
	TextColor3 = C.TextDim,
	TextSize = 12,
	TextXAlignment = Enum.TextXAlignment.Right,
	AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.new(1, -104, 0, 0),
	Size = UDim2.new(0.5, 0, 1, 0),
	Parent = titleBar,
})

local closeButton = UITheme.Button({
	Name = "Close",
	Text = "SCHLIESSEN",
	TextSize = 11,
	TextColor3 = C.Magenta,
	BackgroundColor3 = C.PanelLight,
	AnchorPoint = Vector2.new(1, 0.5),
	Position = UDim2.new(1, -8, 0.5, 0),
	Size = UDim2.fromOffset(88, 24),
	Parent = titleBar,
})
UITheme.Corner(closeButton, 3)
UITheme.Stroke(closeButton, C.Magenta)

local hintLabel = UITheme.Label({
	Name = "Hint",
	Text = "",
	TextColor3 = C.TextDim,
	TextSize = 12,
	Position = UDim2.new(0, 14, 0, 40),
	Size = UDim2.new(1, -28, 0, 16),
	Parent = window,
})

local list = Instance.new("ScrollingFrame")
list.Name = "List"
list.BackgroundTransparency = 1
list.BorderSizePixel = 0
list.Position = UDim2.new(0, 14, 0, 60)
list.Size = UDim2.new(1, -28, 1, -110)
list.CanvasSize = UDim2.new()
list.AutomaticCanvasSize = Enum.AutomaticSize.Y
list.ScrollBarThickness = 4
list.ScrollBarImageColor3 = C.Line
list.Parent = window

local listLayout = Instance.new("UIListLayout")
listLayout.SortOrder = Enum.SortOrder.LayoutOrder
listLayout.Padding = UDim.new(0, 8)
listLayout.Parent = list

local footer = UITheme.Label({
	Name = "Footer",
	Text = "",
	TextColor3 = C.TextDim,
	TextSize = 12,
	Position = UDim2.new(0, 14, 1, -34),
	Size = UDim2.new(1, -28, 0, 18),
	Parent = window,
})

local function say(text: string, colour: Color3)
	footer.Text = text
	footer.TextColor3 = colour
end

local function send(payload: { [string]: any })
	if busy then
		return
	end
	busy = true
	task.spawn(function()
		local ok, response = pcall(function()
			return Remotes.VehicleAction:InvokeServer(payload)
		end)
		busy = false

		if not ok or typeof(response) ~= "table" then
			say("Aktion fehlgeschlagen.", C.Magenta)
			return
		end
		if response.Ok then
			say("Erledigt.", C.Green)
			return
		end

		-- Klartext mit Zahl, wo es eine gibt.
		local reason = response.Reason
		if reason == "FUNDS" then
			say(("Zu wenig auf der Bank - es fehlen %d CRY."):format(response.Missing or 0), C.Amber)
		elseif reason == "TOO_FAR" then
			say(("Zu weit vom Ausparkplatz - %d Studs, erlaubt sind %d."):format(
				response.Distance or 0,
				response.Range or 0
			), C.Amber)
		elseif reason == "CLOSED" then
			say(("Haendler hat zu - offen von %d bis %d Uhr."):format(response.Open or 0, response.Close or 0), C.Amber)
		elseif reason == "NO_DEALER" then
			say("Du stehst nicht beim Haendler.", C.Amber)
		elseif reason == "NO_SPAWN" then
			say("Kein Ausparkplatz in der Naehe.", C.Amber)
		elseif reason == "NOT_OWNED" then
			say("Das Fahrzeug gehoert dir nicht.", C.Amber)
		elseif reason == "ALREADY_OWNED" then
			say("Hast du schon.", C.TextDim)
		else
			say("Abgelehnt.", C.Amber)
		end
	end)
end

local function clearList()
	for _, child in list:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

local function refreshGarage()
	statusLabel.Text = ("BANK %d CRY"):format(banked)
	hintLabel.Text = if garage.DealerOpen
		then "Haendler offen. Kaufen geht nur am Tresen, Ausparken nur in der Garage."
		else ("Haendler geschlossen (%d-%d Uhr). Ausparken geht trotzdem."):format(
			Config.Dealer.OpenHour,
			Config.Dealer.CloseHour
		)

	if not backdrop.Visible then
		return
	end
	clearList()

	local order = 0
	local ownedIds: { [string]: string } = {}
	for _, entry in garage.Owned do
		ownedIds[entry.ClassId] = entry.Colour
	end

	for _, class in Vehicles.List do
		order += 1
		local owned = ownedIds[class.Id] ~= nil
		local isOut = garage.Spawned == class.Id

		local frame = UITheme.Frame({
			Name = class.Id,
			Size = UDim2.new(1, -8, 0, 78),
			BackgroundColor3 = C.Panel,
			LayoutOrder = order,
			Parent = list,
		})
		UITheme.Corner(frame, 4)
		UITheme.Stroke(frame, if isOut then C.Cyan else C.Line)
		UITheme.Padding(frame, 10)

		UITheme.Label({
			Name = "Name",
			Text = class.Name,
			TextColor3 = if owned then C.Cyan else C.TextDim,
			TextSize = 15,
			Size = UDim2.new(1, -150, 0, 18),
			Parent = frame,
		})
		UITheme.Label({
			Name = "Blurb",
			Text = class.Blurb,
			TextColor3 = C.TextDim,
			TextSize = 11,
			TextWrapped = true,
			Position = UDim2.new(0, 0, 0, 19),
			Size = UDim2.new(1, -150, 0, 26),
			Parent = frame,
		})
		UITheme.Label({
			Name = "Stats",
			Text = ("%d km/h  //  Lager +%d  //  Auffaelligkeit %.1fx"):format(
				math.floor(class.MaxSpeed * 1.1),
				Vehicles.StashBonus(class.Id),
				class.HeatFactor
			),
			TextColor3 = C.Amber,
			TextSize = 11,
			Position = UDim2.new(0, 0, 1, -14),
			Size = UDim2.new(1, 0, 0, 14),
			Parent = frame,
		})

		local button = UITheme.Button({
			Name = "Action",
			Text = "",
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, 0, 0, 4),
			Size = UDim2.fromOffset(132, 44),
			BackgroundColor3 = C.PanelLight,
			Parent = frame,
		})
		UITheme.Corner(button, 4)
		local stroke = UITheme.Stroke(button, C.Line)

		local caption = UITheme.Label({
			Name = "Caption",
			Text = "",
			TextColor3 = C.TextDim,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Center,
			Size = UDim2.fromScale(1, 1),
			Parent = button,
		})

		if isOut then
			caption.Text = "EINPARKEN"
			caption.TextColor3 = C.Magenta
			stroke.Color = C.Magenta
			button.Activated:Connect(function()
				send({ Action = "DESPAWN" })
			end)
		elseif owned then
			caption.Text = "AUSPARKEN"
			caption.TextColor3 = C.Cyan
			stroke.Color = C.Cyan
			button.Activated:Connect(function()
				send({ Action = "SPAWN", ClassId = class.Id })
			end)
		else
			caption.Text = ("%d CRY"):format(class.Price)
			caption.TextColor3 = if banked &gt;= class.Price then C.Amber else C.TextDim
			stroke.Color = if banked &gt;= class.Price then C.Amber else C.Line
			button.Activated:Connect(function()
				send({ Action = "BUY", ClassId = class.Id, Colour = selectedColour })
			end)
		end
	end

	-- Lackfarbe. Rein kosmetisch - keine Leistungsteile, sonst muesste das
	-- Fahrverhalten mehrfach ausbalanciert werden.
	order += 1
	local paint = UITheme.Frame({
		Name = "Paint",
		Size = UDim2.new(1, -8, 0, 60),
		BackgroundColor3 = C.Panel,
		LayoutOrder = order,
		Parent = list,
	})
	UITheme.Corner(paint, 4)
	UITheme.Stroke(paint, C.Line)
	UITheme.Padding(paint, 10)

	UITheme.Label({
		Name = "Title",
		Text = ("LACK  //  %d CRY  //  gewaehlt: %s"):format(garage.RepaintCost, selectedColour),
		TextColor3 = C.TextDim,
		TextSize = 12,
		Size = UDim2.new(1, 0, 0, 14),
		Parent = paint,
	})

	local x = 0
	for _, name in Config.Dealer.ColourOptions do
		local swatch = UITheme.Button({
			Name = name,
			Text = name,
			TextSize = 11,
			TextColor3 = if name == selectedColour then C.Cyan else C.TextDim,
			BackgroundColor3 = C.PanelLight,
			Position = UDim2.new(0, x, 0, 20),
			Size = UDim2.fromOffset(84, 26),
			Parent = paint,
		})
		UITheme.Corner(swatch, 3)
		UITheme.Stroke(swatch, if name == selectedColour then C.Cyan else C.Line)
		swatch.Activated:Connect(function()
			selectedColour = name
			refreshGarage()
		end)
		x += 88
	end
end

local function setOpen(open: boolean)
	backdrop.Visible = open
	if open then
		say("", C.TextDim)
		refreshGarage()
		backdrop.BackgroundTransparency = 1
		window.Size = UDim2.new(0.9, 0, 0.3, 0)
		TweenService:Create(backdrop, UITheme.Tween.Normal, { BackgroundTransparency = 0.45 }):Play()
		TweenService:Create(window, UITheme.Tween.Slow, { Size = UDim2.new(0.9, 0, 0.82, 0) }):Play()
	end
end

closeButton.Activated:Connect(function()
	setOpen(false)
end)

--==========================================================================
-- Endgame-Entscheidung
--==========================================================================

local choicePanel = UITheme.Frame({
	Name = "Endgame",
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -200),
	Size = UDim2.fromOffset(460, 118),
	BackgroundColor3 = C.Panel,
	BackgroundTransparency = 0.05,
	Visible = false,
	Parent = gui,
})
UITheme.Corner(choicePanel, 4)
UITheme.Stroke(choicePanel, C.Magenta)
UITheme.Padding(choicePanel, 12)

UITheme.Label({
	Name = "Title",
	Text = "DU WARST NIE EIN KRIMINELLER. DU WARST EIN TEST.",
	TextColor3 = C.Magenta,
	TextSize = 13,
	Size = UDim2.new(1, 0, 0, 16),
	Parent = choicePanel,
})

local choiceHint = UITheme.Label({
	Name = "Hint",
	Text = "",
	TextColor3 = C.TextDim,
	TextSize = 11,
	TextWrapped = true,
	Position = UDim2.new(0, 0, 0, 18),
	Size = UDim2.new(1, 0, 0, 28),
	Parent = choicePanel,
})

local function choiceButton(text: string, sub: string, colour: Color3, x: number, choice: string)
	local button = UITheme.Button({
		Name = choice,
		Text = "",
		Position = UDim2.new(0, x, 0, 50),
		Size = UDim2.fromOffset(210, 44),
		BackgroundColor3 = C.PanelLight,
		Parent = choicePanel,
	})
	UITheme.Corner(button, 4)
	UITheme.Stroke(button, colour)

	UITheme.Label({
		Name = "Caption",
		Text = text,
		TextColor3 = colour,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 18),
		Position = UDim2.new(0, 0, 0, 4),
		Parent = button,
	})
	UITheme.Label({
		Name = "Sub",
		Text = sub,
		TextColor3 = C.TextDim,
		TextSize = 10,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 14),
		Position = UDim2.new(0, 0, 0, 24),
		Parent = button,
	})

	button.Activated:Connect(function()
		Remotes.EndgameChoice:FireServer({ Choice = choice })
	end)
end

choiceButton("KASSIEREN", "halber Trace, weniger Beute", C.Cyan, 0, "CASH")
choiceButton("VERBRENNEN", "mehr Ertrag, haerteres Spiel", C.Magenta, 222, "BURN")

local function refreshEndgame()
	choicePanel.Visible = endgame.Unlocked
	if not endgame.Unlocked then
		return
	end
	if endgame.Choice == "" then
		choiceHint.Text = "Entscheide dich. Umstellen geht spaeter einmal pro Woche."
	elseif endgame.SwitchIn &gt; 0 then
		choiceHint.Text = ("Aktuell: %s. Umstellbar in %d Stunden."):format(
			if endgame.Choice == "CASH" then "Kassieren" else "Verbrennen",
			math.ceil(endgame.SwitchIn / 3600)
		)
	else
		choiceHint.Text = ("Aktuell: %s. Du kannst jetzt umstellen."):format(
			if endgame.Choice == "CASH" then "Kassieren" else "Verbrennen"
		)
	end
end

--==========================================================================
-- Eingabe und Server-Meldungen
--==========================================================================

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.KeyCode == Enum.KeyCode.G then
		setOpen(not backdrop.Visible)
	elseif input.KeyCode == Enum.KeyCode.Escape and backdrop.Visible then
		setOpen(false)
	end
end)

Remotes.GarageSync.OnClientEvent:Connect(function(data: any)
	if typeof(data) ~= "table" then
		return
	end
	garage.Owned = if typeof(data.Owned) == "table" then data.Owned else {}
	garage.Spawned = if typeof(data.Spawned) == "string" then data.Spawned else ""
	garage.DealerOpen = data.DealerOpen == true
	garage.RepaintCost = tonumber(data.RepaintCost) or 0
	refreshGarage()
end)

Remotes.PursuitSync.OnClientEvent:Connect(function(data: any)
	if typeof(data) ~= "table" then
		return
	end
	pursuit.Level = tonumber(data.Level) or 0
	pursuit.Escaping = data.Escaping == true
	pursuit.Seconds = tonumber(data.EscapeSeconds) or 0
	refreshPursuit()
end)

Remotes.EconomySync.OnClientEvent:Connect(function(snapshot: any)
	if typeof(snapshot) ~= "table" then
		return
	end
	banked = snapshot.Banked or 0
	refreshGarage()
end)

Remotes.MissionSync.OnClientEvent:Connect(function(data: any)
	if typeof(data) ~= "table" then
		return
	end
	endgame.Choice = if typeof(data.Allegiance) == "string" then data.Allegiance else ""
	endgame.SwitchIn = tonumber(data.AllegianceSwitchIn) or 0
	endgame.Unlocked = false
	if typeof(data.Unlocks) == "table" then
		for _, key in data.Unlocks do
			if key == "ENDGAME" then
				endgame.Unlocked = true
				break
			end
		end
	end
	refreshEndgame()
end)

Remotes.HackSessionStarted.OnClientEvent:Connect(function()
	setOpen(false)
end)

refreshPursuit()
refreshEndgame()
</ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="GN50">
<Properties>
<string name="Name">DarknetUI</string>
<ProtectedString name="Source">-- StarterPlayer/StarterPlayerScripts/UI/DarknetUI.client.luau
--!strict
-- GHOSTNET :: Der Darknet-Markt am eigenen Rechner.
--
-- Reine Anzeige. Der Client schickt beim Handeln ausschliesslich
-- { Action, GoodId, Amount } - nie einen Preis. Was etwas kostet, entscheidet
-- allein der Server.
--
-- Der Mini-Chart ist kein Deko-Element: ohne ihn ist jede Kaufentscheidung
-- ein Muenzwurf, und dann ist Handel kein Spiel, sondern Warten.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage.Shared.Config)
local Geometry = require(ReplicatedStorage.Shared.Geometry)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local UITheme = require(ReplicatedStorage.Shared.UITheme)

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local C = UITheme.Color

--==========================================================================
-- Zustand (Abschrift vom Server)
--==========================================================================

local market: { [string]: any } = { Goods = {}, Event = nil }
local stash: { [string]: number } = {}
local slots = { Used = 0, Total = Config.Market.SlotsBase }
local banked = 0
local unlocked = false
local hackOpen = false
local busy = false
local amount = 1

type Row = {
	Frame: Frame,
	Price: TextLabel,
	Trend: TextLabel,
	Owned: TextLabel,
	Chart: Frame,
	Bars: { Frame },
	Buy: TextButton,
	Sell: TextButton,
}

local rows: { [string]: Row } = {}

--==========================================================================
-- Aufbau
--==========================================================================

local gui = UITheme.Screen("GhostNetDarknet", 16)
gui.Parent = playerGui

local prompt = UITheme.Button({
	Name = "OpenPrompt",
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -136),
	Size = UDim2.fromOffset(320, 46),
	BackgroundColor3 = C.Panel,
	BackgroundTransparency = 0.06,
	Text = "",
	Visible = false,
	Parent = gui,
})
UITheme.Corner(prompt, 4)
UITheme.Stroke(prompt, C.Cyan)

UITheme.Label({
	Name = "Caption",
	Text = "[E]  DARKNET OEFFNEN",
	TextColor3 = C.Cyan,
	TextSize = 14,
	TextXAlignment = Enum.TextXAlignment.Center,
	Size = UDim2.fromScale(1, 1),
	Parent = prompt,
})

local backdrop = UITheme.Frame({
	Name = "Backdrop",
	Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = Color3.new(0, 0, 0),
	BackgroundTransparency = 1,
	Visible = false,
	Parent = gui,
})

local window = UITheme.Frame({
	Name = "Window",
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.new(0.94, 0, 0.88, 0),
	BackgroundColor3 = C.Background,
	ClipsDescendants = true,
	Parent = backdrop,
})
UITheme.Corner(window, 5)
UITheme.Stroke(window, C.CyanDim)

local sizeConstraint = Instance.new("UISizeConstraint")
sizeConstraint.MaxSize = Vector2.new(780, 560)
sizeConstraint.MinSize = Vector2.new(320, 320)
sizeConstraint.Parent = window

local titleBar = UITheme.Frame({
	Name = "TitleBar",
	Size = UDim2.new(1, 0, 0, 34),
	BackgroundColor3 = C.Panel,
	Parent = window,
})

UITheme.Label({
	Name = "Title",
	Text = "GHOSTNET // DARKNET",
	TextColor3 = C.Cyan,
	TextSize = 14,
	Position = UDim2.new(0, 12, 0, 0),
	Size = UDim2.new(0.4, 0, 1, 0),
	Parent = titleBar,
})

local walletLabel = UITheme.Label({
	Name = "Wallet",
	Text = "",
	TextColor3 = C.Green,
	TextSize = 13,
	TextXAlignment = Enum.TextXAlignment.Right,
	AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.new(1, -104, 0, 0),
	Size = UDim2.new(0.6, 0, 1, 0),
	Parent = titleBar,
})

local closeButton = UITheme.Button({
	Name = "Close",
	Text = "SCHLIESSEN",
	TextSize = 11,
	TextColor3 = C.Magenta,
	BackgroundColor3 = C.PanelLight,
	AnchorPoint = Vector2.new(1, 0.5),
	Position = UDim2.new(1, -8, 0.5, 0),
	Size = UDim2.fromOffset(88, 24),
	Parent = titleBar,
})
UITheme.Corner(closeButton, 3)
UITheme.Stroke(closeButton, C.Magenta)

--== Kopfzeile: Event und Menge ============================================

local eventLabel = UITheme.Label({
	Name = "Event",
	Text = "",
	TextColor3 = C.Amber,
	TextSize = 13,
	Position = UDim2.new(0, 14, 0, 40),
	Size = UDim2.new(1, -180, 0, 18),
	Parent = window,
})

local amountHolder = UITheme.Frame({
	Name = "Amount",
	AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.new(1, -14, 0, 38),
	Size = UDim2.fromOffset(150, 30),
	BackgroundTransparency = 1,
	Parent = window,
})

local amountLabel = UITheme.Label({
	Name = "Value",
	Text = "1",
	TextColor3 = C.Text,
	TextSize = 15,
	TextXAlignment = Enum.TextXAlignment.Center,
	Position = UDim2.new(0, 46, 0, 0),
	Size = UDim2.fromOffset(58, 30),
	Parent = amountHolder,
})

local function stepButton(text: string, x: number, delta: number): TextButton
	local b = UITheme.Button({
		Name = "Step" .. text,
		Text = text,
		TextSize = 18,
		TextColor3 = C.Cyan,
		BackgroundColor3 = C.PanelLight,
		Position = UDim2.new(0, x, 0, 0),
		Size = UDim2.fromOffset(44, 30),
		Parent = amountHolder,
	})
	UITheme.Corner(b, 3)
	UITheme.Stroke(b, C.Line)
	b.Activated:Connect(function()
		amount = math.clamp(amount + delta, 1, Config.Market.MaxPerTrade)
		amountLabel.Text = tostring(amount)
	end)
	return b
end

stepButton("-", 0, -1)
stepButton("+", 106, 1)

--== Warenliste ============================================================

local list = Instance.new("ScrollingFrame")
list.Name = "List"
list.BackgroundTransparency = 1
list.BorderSizePixel = 0
list.Position = UDim2.new(0, 14, 0, 72)
list.Size = UDim2.new(1, -28, 1, -110)
list.CanvasSize = UDim2.new()
list.AutomaticCanvasSize = Enum.AutomaticSize.Y
list.ScrollBarThickness = 4
list.ScrollBarImageColor3 = C.CyanDim
list.Parent = window

local listLayout = Instance.new("UIListLayout")
listLayout.SortOrder = Enum.SortOrder.LayoutOrder
listLayout.Padding = UDim.new(0, 8)
listLayout.Parent = list

local statusLabel = UITheme.Label({
	Name = "Status",
	Text = "",
	TextColor3 = C.TextDim,
	TextSize = 12,
	Position = UDim2.new(0, 14, 1, -30),
	Size = UDim2.new(1, -28, 0, 18),
	Parent = window,
})

--==========================================================================
-- Eine Zeile je Ware
--==========================================================================

local trade: (string, string) -&gt; ()

local CHART_BARS = 16

local function buildRow(goodId: string, name: string, blurb: string, order: number): Row
	local frame = UITheme.Frame({
		Name = goodId,
		Size = UDim2.new(1, -8, 0, 86),
		BackgroundColor3 = C.Panel,
		LayoutOrder = order,
		Parent = list,
	})
	UITheme.Corner(frame, 4)
	UITheme.Stroke(frame, C.Line)
	UITheme.Padding(frame, 10)

	UITheme.Label({
		Name = "Name",
		Text = name,
		TextColor3 = C.Cyan,
		TextSize = 15,
		Size = UDim2.new(0.42, 0, 0, 17),
		Parent = frame,
	})

	UITheme.Label({
		Name = "Blurb",
		Text = blurb,
		TextColor3 = C.TextDim,
		TextSize = 11,
		TextWrapped = true,
		Position = UDim2.new(0, 0, 0, 18),
		Size = UDim2.new(0.42, 0, 0, 26),
		Parent = frame,
	})

	local price = UITheme.Label({
		Name = "Price",
		Text = "",
		TextColor3 = C.Text,
		TextSize = 14,
		Position = UDim2.new(0, 0, 0, 46),
		Size = UDim2.new(0.42, 0, 0, 16),
		Parent = frame,
	})

	local owned = UITheme.Label({
		Name = "Owned",
		Text = "",
		TextColor3 = C.TextDim,
		TextSize = 11,
		Position = UDim2.new(0, 0, 1, -14),
		Size = UDim2.new(0.42, 0, 0, 14),
		Parent = frame,
	})

	-- Mini-Chart aus schmalen Balken. Kein Bild noetig, keine Asset-Id.
	local chart = UITheme.Frame({
		Name = "Chart",
		Position = UDim2.new(0.44, 0, 0, 2),
		Size = UDim2.new(0.24, 0, 1, -4),
		BackgroundColor3 = C.Background,
		Parent = frame,
	})
	UITheme.Corner(chart, 3)

	local bars: { Frame } = {}
	for i = 1, CHART_BARS do
		local bar = UITheme.Frame({
			Name = "B" .. i,
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new((i - 1) / CHART_BARS, 1, 1, -2),
			Size = UDim2.new(1 / CHART_BARS, -2, 0, 2),
			BackgroundColor3 = C.CyanDim,
			Parent = chart,
		})
		table.insert(bars, bar)
	end

	local trend = UITheme.Label({
		Name = "Trend",
		Text = "",
		TextColor3 = C.TextDim,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Right,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -2, 1, -16),
		Size = UDim2.new(1, -6, 0, 14),
		ZIndex = 2,
		Parent = chart,
	})

	local function actionButton(text: string, colour: Color3, y: number, action: string): TextButton
		local b = UITheme.Button({
			Name = action,
			Text = text,
			TextSize = 13,
			TextColor3 = colour,
			BackgroundColor3 = C.PanelLight,
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, 0, 0, y),
			Size = UDim2.fromOffset(120, 30),
			Parent = frame,
		})
		UITheme.Corner(b, 3)
		UITheme.Stroke(b, colour)
		b.Activated:Connect(function()
			trade(action, goodId)
		end)
		return b
	end

	local buyButton = actionButton("KAUFEN", C.Cyan, 2, "BUY")
	local sellButton = actionButton("VERKAUFEN", C.Green, 36, "SELL")

	return {
		Frame = frame,
		Price = price,
		Trend = trend,
		Owned = owned,
		Chart = chart,
		Bars = bars,
		Buy = buyButton,
		Sell = sellButton,
	}
end

--==========================================================================
-- Anzeige
--==========================================================================

local function refresh()
	walletLabel.Text = ("BANK %d CRY   //   LAGER %d/%d"):format(banked, slots.Used, slots.Total)

	if market.Event then
		eventLabel.Text = market.Event.Text or ""
		eventLabel.TextColor3 = C.Amber
	else
		eventLabel.Text = "Markt ruhig."
		eventLabel.TextColor3 = C.TextDim
	end

	for index, entry in market.Goods do
		local row = rows[entry.Id]
		if not row then
			row = buildRow(entry.Id, entry.Name, entry.Blurb, index)
			rows[entry.Id] = row
		end

		local owned = stash[entry.Id] or 0
		row.Price.Text = ("KAUF %d   //   VERKAUF %d"):format(entry.Buy, entry.Sell)
		row.Owned.Text = ("im Lager: %d   //   Ausschussrisiko %d%%"):format(
			owned,
			math.floor(Config.GetFakeRisk(entry.Risk, slots.Tier or 1) * 100 + 0.5)
		)

		-- Chart: die letzten Faktoren auf die Balkenhoehe abbilden.
		local history = entry.History or {}
		local count = #history
		local lowest, highest = math.huge, -math.huge
		for _, value in history do
			lowest = math.min(lowest, value)
			highest = math.max(highest, value)
		end
		if count == 0 then
			lowest, highest = 0.9, 1.1
		end
		local span = math.max(0.02, highest - lowest)

		for i, bar in row.Bars do
			local historyIndex = count - CHART_BARS + i
			if historyIndex &lt; 1 then
				bar.Visible = false
			else
				bar.Visible = true
				local value = history[historyIndex]
				local fraction = math.clamp((value - lowest) / span, 0, 1)
				bar.Size = UDim2.new(1 / CHART_BARS, -2, 0, 3 + fraction * 40)
				bar.BackgroundColor3 = if value &gt;= 1 then C.Cyan else C.Magenta
			end
		end

		-- Trend gegenueber dem Basispreis, damit man "teuer" von "billig"
		-- unterscheiden kann, ohne zu rechnen.
		local percent = math.floor((entry.Factor - 1) * 100 + 0.5)
		if percent &gt; 2 then
			row.Trend.Text = ("+%d%%"):format(percent)
			row.Trend.TextColor3 = C.Green
		elseif percent &lt; -2 then
			row.Trend.Text = ("%d%%"):format(percent)
			row.Trend.TextColor3 = C.Magenta
		else
			row.Trend.Text = "stabil"
			row.Trend.TextColor3 = C.TextDim
		end

		local canBuy = not busy and banked &gt;= entry.Buy * amount and slots.Used + amount &lt;= slots.Total
		local canSell = not busy and owned &gt;= amount
		row.Buy.TextColor3 = if canBuy then C.Cyan else C.TextDim
		row.Sell.TextColor3 = if canSell then C.Green else C.TextDim
	end
end

--==========================================================================
-- Handeln
--==========================================================================

local REASONS: { [string]: string } = {
	FUNDS = "Zu wenig auf der Bank",
	NO_SPACE = "Lager voll",
	NOT_OWNED = "So viel hast du nicht",
	BAD_AMOUNT = "Ungueltige Menge",
	UNKNOWN_GOOD = "Diese Ware gibt es nicht",
	LOCKED = "Darknet noch nicht freigeschaltet",
	LOADING = "Profil laedt noch",
	RATE = "Zu schnell hintereinander",
	INTERNAL = "Fehler auf dem Server",
}

local function say(text: string, colour: Color3)
	statusLabel.Text = text
	statusLabel.TextColor3 = colour
end

trade = function(action: string, goodId: string)
	if busy then
		return
	end
	busy = true
	refresh()

	task.spawn(function()
		local ok, response = pcall(function()
			return Remotes.Trade:InvokeServer({ Action = action, GoodId = goodId, Amount = amount })
		end)
		busy = false

		if not ok or typeof(response) ~= "table" then
			say("Handel fehlgeschlagen.", C.Magenta)
			refresh()
			return
		end

		if response.Ok then
			if action == "BUY" then
				say(("Gekauft: %d Stueck zu je %d CRY - %d gesamt."):format(
					response.Amount or 0,
					response.Unit or 0,
					response.Total or 0
				), C.Cyan)
			else
				local fakes = response.Fakes or 0
				if fakes &gt; 0 then
					say(("Verkauft: %d von %d echt, %d Ausschuss. +%d CRY."):format(
						response.Sold or 0,
						response.Amount or 0,
						fakes,
						response.Total or 0
					), C.Amber)
				else
					say(("Verkauft: %d Stueck zu je %d CRY. +%d CRY."):format(
						response.Sold or 0,
						response.Unit or 0,
						response.Total or 0
					), C.Green)
				end
			end
			refresh()
			return
		end

		-- Klartext mit Zahl, wo es eine gibt.
		local text = REASONS[response.Reason] or "Abgelehnt"
		if response.Reason == "FUNDS" and response.Missing then
			text = ("Zu wenig auf der Bank - es fehlen %d CRY."):format(response.Missing)
		elseif response.Reason == "NO_SPACE" then
			text = ("Lager voll - noch %d von %d Plaetzen frei."):format(response.Free or 0, response.Slots or 0)
		elseif response.Reason == "NOT_OWNED" then
			text = ("Du hast nur %d davon."):format(response.Owned or 0)
		elseif response.Reason == "BAD_AMOUNT" then
			text = ("Menge muss zwischen 1 und %d liegen."):format(response.Max or Config.Market.MaxPerTrade)
		end
		say(text, C.Amber)
		refresh()
	end)
end

--==========================================================================
-- Oeffnen / Schliessen
--==========================================================================

local nearRig = false

local function setOpen(open: boolean)
	if open and (hackOpen or not unlocked) then
		return
	end
	backdrop.Visible = open
	if open then
		say("", C.TextDim)
		refresh()
		backdrop.BackgroundTransparency = 1
		window.Size = UDim2.new(0.94, 0, 0.3, 0)
		TweenService:Create(backdrop, UITheme.Tween.Normal, { BackgroundTransparency = 0.45 }):Play()
		TweenService:Create(window, UITheme.Tween.Slow, { Size = UDim2.new(0.94, 0, 0.88, 0) }):Play()
	end
end

local function toggle()
	setOpen(not backdrop.Visible)
end

prompt.Activated:Connect(toggle)
closeButton.Activated:Connect(function()
	setOpen(false)
end)

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.KeyCode == Enum.KeyCode.E and nearRig and not backdrop.Visible then
		setOpen(true)
	elseif input.KeyCode == Enum.KeyCode.Escape and backdrop.Visible then
		setOpen(false)
	end
end)

--==========================================================================
-- Server-Meldungen
--==========================================================================

Remotes.MarketSync.OnClientEvent:Connect(function(data: any)
	if typeof(data) ~= "table" or typeof(data.Goods) ~= "table" then
		return
	end
	market = data
	if backdrop.Visible then
		refresh()
	end
end)

Remotes.MarketEvent.OnClientEvent:Connect(function(data: any)
	if typeof(data) ~= "table" or typeof(data.Text) ~= "string" then
		return
	end
	eventLabel.Text = data.Text
	eventLabel.TextColor3 = C.Amber
	UITheme.Flash(eventLabel, C.Amber)
end)

Remotes.InventorySync.OnClientEvent:Connect(function(data: any)
	if typeof(data) ~= "table" then
		return
	end
	stash = {}
	if typeof(data.Stash) == "table" then
		for _, entry in data.Stash do
			if typeof(entry) == "table" and typeof(entry.Id) == "string" then
				stash[entry.Id] = entry.Amount or 0
			end
		end
	end
	slots.Used = tonumber(data.Used) or 0
	slots.Total = tonumber(data.Slots) or Config.Market.SlotsBase
	;(slots :: any).Tier = tonumber(data.Tier) or 1
	if backdrop.Visible then
		refresh()
	end
end)

Remotes.EconomySync.OnClientEvent:Connect(function(snapshot: any)
	if typeof(snapshot) ~= "table" then
		return
	end
	banked = snapshot.Banked or 0
	if backdrop.Visible then
		refresh()
	end
end)

Remotes.MissionSync.OnClientEvent:Connect(function(data: any)
	if typeof(data) ~= "table" or typeof(data.Unlocks) ~= "table" then
		return
	end
	unlocked = false
	for _, key in data.Unlocks do
		if key == Config.Market.RequiredUnlock then
			unlocked = true
			break
		end
	end
	if not unlocked and backdrop.Visible then
		setOpen(false)
	end
end)

Remotes.HackSessionStarted.OnClientEvent:Connect(function()
	hackOpen = true
	setOpen(false)
	prompt.Visible = false
end)

Remotes.HackResolved.OnClientEvent:Connect(function()
	hackOpen = false
end)

--==========================================================================
-- Naehe zum Rechner
--==========================================================================

local CollectionService = game:GetService("CollectionService")

local accumulator = 0
RunService.RenderStepped:Connect(function(dt)
	accumulator += dt
	if accumulator &lt; 0.2 then
		return
	end
	accumulator = 0

	if hackOpen or not unlocked then
		nearRig = false
		prompt.Visible = false
		return
	end

	local position = Geometry.AlivePosition(player)
	if not position then
		nearRig = false
		prompt.Visible = false
		return
	end

	nearRig = false
	for _, inst in CollectionService:GetTagged(Config.ContactTag) do
		if inst:IsA("BasePart") and inst:IsDescendantOf(workspace) then
			if Geometry.SurfaceDistance(inst, position) &lt;= Config.Mission.ContactRange then
				nearRig = true
				break
			end
		end
	end

	prompt.Visible = nearRig and not backdrop.Visible
end)
</ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="GN51">
<Properties>
<string name="Name">HUD</string>
<ProtectedString name="Source">-- StarterPlayer/StarterPlayerScripts/UI/HUD.client.luau
--!strict
-- GHOSTNET :: Dauerhaftes HUD - Wallet, Trace, Ziel-Prompt, Meldungen.
--
-- Der HUD trifft KEINE Entscheidungen. Er zeigt an, was der Server sagt,
-- und schickt beim Druck auf [E] eine Bitte los. Ob sie erlaubt ist,
-- entscheidet ausschliesslich der Server.
--
-- Der Trace-Balken ist das wichtigste Element auf dem Schirm: er muss immer
-- sichtbar sein und ab Config.Trace.WarnAt anfangen zu pulsieren. Die Frage
-- "noch ein Hack oder erst verkaufen?" soll man fuehlen, nicht ausrechnen.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage.Shared.Config)
local Geometry = require(ReplicatedStorage.Shared.Geometry)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local UITheme = require(ReplicatedStorage.Shared.UITheme)

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local C = UITheme.Color

--==========================================================================
-- Zustand
--==========================================================================

local wallet = { Banked = 0, Unsold = 0, Tier = 1 }
local rig = table.clone(Config.Rig.StartLevels)
local trace = { Value = 0, Max = Config.Trace.Max, Locked = false, LockUntil = 0 }
local hackOpen = false
local cooldownUntil: { [string]: number } = {} -- [targetId] = os.clock()

-- Worauf der Prompt gerade zeigt: entweder ein Hack-Ziel oder der Hehler.
local currentKind: string? = nil -- "HACK" | "FENCE"
local currentTargetId: string? = nil

--==========================================================================
-- Aufbau
--==========================================================================

local gui = UITheme.Screen("GhostNetHUD", 10)
gui.Parent = playerGui

--== Wallet oben rechts ====================================================

local walletPanel = UITheme.Frame({
	Name = "Wallet",
	AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.new(1, -18, 0, 18),
	Size = UDim2.fromOffset(240, 62),
	BackgroundColor3 = C.Panel,
	BackgroundTransparency = 0.08,
	Parent = gui,
})
UITheme.Corner(walletPanel, 4)
UITheme.Stroke(walletPanel, C.Line)
UITheme.Padding(walletPanel, 10)

UITheme.Label({
	Name = "Title",
	Text = "UNVERKAUFT",
	TextColor3 = C.TextDim,
	TextSize = 11,
	Size = UDim2.new(1, 0, 0, 12),
	Parent = walletPanel,
})

local walletValue = UITheme.Label({
	Name = "Value",
	Text = "0 CRY",
	TextColor3 = C.Cyan,
	TextSize = 22,
	Position = UDim2.new(0, 0, 0, 14),
	Size = UDim2.new(1, 0, 0, 26),
	Parent = walletPanel,
})

local walletSub = UITheme.Label({
	Name = "Sub",
	Text = "BANK 0   //   TIER 1",
	TextColor3 = C.TextDim,
	TextSize = 12,
	Position = UDim2.new(0, 0, 1, -13),
	Size = UDim2.new(1, 0, 0, 13),
	Parent = walletPanel,
})

--== Trace direkt darunter =================================================

local tracePanel = UITheme.Frame({
	Name = "Trace",
	AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.new(1, -18, 0, 88),
	Size = UDim2.fromOffset(240, 54),
	BackgroundColor3 = C.Panel,
	BackgroundTransparency = 0.08,
	Parent = gui,
})
UITheme.Corner(tracePanel, 4)
local traceStroke = UITheme.Stroke(tracePanel, C.Line)
UITheme.Padding(tracePanel, 10)

local traceTitle = UITheme.Label({
	Name = "Title",
	Text = "TRACE",
	TextColor3 = C.TextDim,
	TextSize = 11,
	Size = UDim2.new(0.5, 0, 0, 12),
	Parent = tracePanel,
})

local traceValue = UITheme.Label({
	Name = "Value",
	Text = "0%",
	TextColor3 = C.Cyan,
	TextSize = 12,
	TextXAlignment = Enum.TextXAlignment.Right,
	Position = UDim2.new(0.5, 0, 0, 0),
	Size = UDim2.new(0.5, 0, 0, 12),
	Parent = tracePanel,
})

local traceTrack = UITheme.Frame({
	Name = "Track",
	Position = UDim2.new(0, 0, 0, 18),
	Size = UDim2.new(1, 0, 0, 12),
	BackgroundColor3 = C.PanelLight,
	Parent = tracePanel,
})
UITheme.Corner(traceTrack, 3)

local traceFill = UITheme.Frame({
	Name = "Fill",
	Size = UDim2.fromScale(0, 1),
	BackgroundColor3 = C.Cyan,
	Parent = traceTrack,
})
UITheme.Corner(traceFill, 3)

local traceHint = UITheme.Label({
	Name = "Hint",
	Text = "ruhig",
	TextColor3 = C.TextDim,
	TextSize = 11,
	Position = UDim2.new(0, 0, 1, -12),
	Size = UDim2.new(1, 0, 0, 12),
	Parent = tracePanel,
})

--== Ziel-Prompt unten Mitte ===============================================

local prompt = UITheme.Button({
	Name = "TargetPrompt",
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -46),
	Size = UDim2.fromOffset(380, 82),
	BackgroundColor3 = C.Panel,
	BackgroundTransparency = 0.06,
	Visible = false,
	Parent = gui,
})
UITheme.Corner(prompt, 4)
local promptStroke = UITheme.Stroke(prompt, C.CyanDim)
UITheme.Padding(prompt, 12)

local promptName = UITheme.Label({
	Name = "Name",
	Text = "",
	TextColor3 = C.Cyan,
	TextSize = 16,
	Size = UDim2.new(1, 0, 0, 18),
	Parent = prompt,
})

local promptInfo = UITheme.Label({
	Name = "Info",
	Text = "",
	TextColor3 = C.TextDim,
	TextSize = 12,
	Position = UDim2.new(0, 0, 0, 22),
	Size = UDim2.new(1, 0, 0, 14),
	Parent = prompt,
})

local promptAction = UITheme.Label({
	Name = "Action",
	Text = "[E]  BREACH",
	TextColor3 = C.Text,
	TextSize = 15,
	Position = UDim2.new(0, 0, 1, -18),
	Size = UDim2.new(1, 0, 0, 16),
	Parent = prompt,
})

--== Meldungen =============================================================

local toastHolder = UITheme.Frame({
	Name = "Toasts",
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -138),
	Size = UDim2.fromOffset(440, 130),
	BackgroundTransparency = 1,
	Parent = gui,
})
local toastLayout = Instance.new("UIListLayout")
toastLayout.SortOrder = Enum.SortOrder.LayoutOrder
toastLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
toastLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
toastLayout.Padding = UDim.new(0, 4)
toastLayout.Parent = toastHolder

local toastOrder = 0

local function toast(text: string, color: Color3)
	toastOrder += 1
	local item = UITheme.Frame({
		Name = "Toast",
		Size = UDim2.fromOffset(440, 26),
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.15,
		LayoutOrder = toastOrder,
		Parent = toastHolder,
	})
	UITheme.Corner(item, 3)
	UITheme.Stroke(item, color)

	local label = UITheme.Label({
		Text = text,
		TextColor3 = color,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 1),
		Parent = item,
	})

	task.delay(3.2, function()
		if not item.Parent then
			return
		end
		TweenService:Create(item, UITheme.Tween.Normal, { BackgroundTransparency = 1 }):Play()
		TweenService:Create(label, UITheme.Tween.Normal, { TextTransparency = 1 }):Play()
		task.wait(0.3)
		item:Destroy()
	end)
end

--== Bust-Blitz ============================================================

local bustFlash = UITheme.Frame({
	Name = "BustFlash",
	Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = C.Magenta,
	BackgroundTransparency = 1,
	Visible = false,
	ZIndex = 80,
	Parent = gui,
})

local bustBanner = UITheme.Label({
	Name = "BustBanner",
	Text = "",
	TextColor3 = C.Magenta,
	TextSize = 40,
	TextXAlignment = Enum.TextXAlignment.Center,
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.36),
	Size = UDim2.new(1, 0, 0, 48),
	TextTransparency = 1,
	ZIndex = 81,
	Parent = gui,
})

local function playBust(lost: number)
	bustFlash.Visible = true
	bustFlash.BackgroundTransparency = 0.35
	bustBanner.Text = ("GESCHNAPPT  //  -%d CRY"):format(lost)
	bustBanner.TextTransparency = 0

	TweenService:Create(bustFlash, TweenInfo.new(0.9, Enum.EasingStyle.Quad), { BackgroundTransparency = 1 }):Play()
	TweenService:Create(bustBanner, TweenInfo.new(2.0, Enum.EasingStyle.Quad), { TextTransparency = 1 }):Play()
	task.delay(2.1, function()
		bustFlash.Visible = false
	end)

	toast(("TRACE 100 - ALLES UNVERKAUFTE VERLOREN (-%d CRY)"):format(lost), C.Magenta)
end

--== Weltmarkierung des naechsten Ziels ====================================

local highlight = Instance.new("Highlight")
highlight.FillColor = C.Cyan
highlight.FillTransparency = 0.86
highlight.OutlineColor = C.Cyan
highlight.OutlineTransparency = 0.15
highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
highlight.Enabled = false
highlight.Parent = gui

--==========================================================================
-- Anzeige aktualisieren
--==========================================================================

local function refreshWallet()
	walletValue.Text = ("%d CRY"):format(wallet.Unsold)
	walletValue.TextColor3 = if wallet.Unsold &gt; 0 then C.Cyan else C.TextDim
	walletSub.Text = ("BANK %d   //   TIER %d"):format(wallet.Banked, wallet.Tier)
end

local function refreshTrace()
	local fraction = math.clamp(trace.Value / math.max(1, trace.Max), 0, 1)
	traceFill.Size = UDim2.fromScale(fraction, 1)
	traceValue.Text = ("%d%%"):format(math.floor(trace.Value + 0.5))

	if trace.Locked then
		traceHint.Text = ("gesperrt // %ds"):format(math.ceil(math.max(0, trace.LockUntil - os.clock())))
		traceHint.TextColor3 = C.Magenta
	elseif trace.Value &gt;= Config.Trace.CriticalAt then
		traceHint.Text = "KRITISCH - sofort verkaufen"
		traceHint.TextColor3 = C.Magenta
	elseif trace.Value &gt;= Config.Trace.WarnAt then
		traceHint.Text = "heiss - besser abliefern"
		traceHint.TextColor3 = C.Amber
	elseif trace.Value &gt; 0 then
		traceHint.Text = "kuehlt ab"
		traceHint.TextColor3 = C.TextDim
	else
		traceHint.Text = "ruhig"
		traceHint.TextColor3 = C.TextDim
	end
end

local function cooldownLeft(id: string): number
	local until_ = cooldownUntil[id]
	if not until_ then
		return 0
	end
	return math.max(0, until_ - os.clock())
end

local function hidePrompt()
	if prompt.Visible then
		prompt.Visible = false
	end
	currentKind = nil
	currentTargetId = nil
	highlight.Enabled = false
	highlight.Adornee = nil
end

local function showFencePrompt(fence: BasePart, distance: number)
	currentKind = "FENCE"
	currentTargetId = nil
	prompt.Visible = true
	highlight.Adornee = fence
	highlight.Enabled = true
	highlight.OutlineColor = C.Green

	local name = fence:GetAttribute("DisplayName")
	promptName.Text = if typeof(name) == "string" and name ~= "" then name else fence.Name
	promptName.TextColor3 = C.Green
	promptStroke.Color = C.Green

	local _, fee, net = Config.GetSellPayout(wallet.Unsold)
	promptInfo.Text = ("%d CRY UNVERKAUFT   //   GEBUEHR %d   //   %.0fm"):format(wallet.Unsold, fee, distance)

	if wallet.Unsold &lt; Config.Sell.MinAmount then
		promptAction.Text = "NICHTS ZU VERKAUFEN"
		promptAction.TextColor3 = C.TextDim
	else
		promptAction.Text = ("[E]  VERKAUFEN  -&gt;  +%d BANK,  TRACE -%d"):format(net, Config.Sell.TraceRelief)
		promptAction.TextColor3 = C.Green
	end
end

local function showHackPrompt(target: BasePart, distance: number, id: string)
	currentKind = "HACK"
	currentTargetId = id
	prompt.Visible = true
	highlight.Adornee = target
	highlight.Enabled = true

	local name = target:GetAttribute("DisplayName")
	promptName.Text = if typeof(name) == "string" and name ~= "" then name else target.Name
	promptName.TextColor3 = C.Cyan

	local difficulty = target:GetAttribute("Difficulty")
	local reward = target:GetAttribute("Reward")
	local diffNum = if typeof(difficulty) == "number" then difficulty else 1
	local rewardNum = if typeof(reward) == "number" and reward &gt;= 0 then reward else Config.GetReward(diffNum)

	promptInfo.Text = ("SCHWIERIGKEIT %d/10   //   %d CRY   //   %.0fm"):format(diffNum, rewardNum, distance)

	local offline = target:GetAttribute("Offline") == true
	local cd = cooldownLeft(id)

	if trace.Locked then
		promptAction.Text = ("AUFGEFLOGEN // %ds RUHE"):format(math.ceil(math.max(0, trace.LockUntil - os.clock())))
		promptAction.TextColor3 = C.Magenta
		highlight.OutlineColor = C.Magenta
		promptStroke.Color = C.Magenta
	elseif offline then
		promptAction.Text = "ZIEL BEREITS OFFLINE"
		promptAction.TextColor3 = C.TextDim
		highlight.OutlineColor = C.Line
		promptStroke.Color = C.Line
	elseif cd &gt; 0 then
		promptAction.Text = ("GESPERRT // %ds"):format(math.ceil(cd))
		promptAction.TextColor3 = C.Amber
		highlight.OutlineColor = C.Amber
		promptStroke.Color = C.Amber
	else
		promptAction.Text = "[E]  BREACH"
		promptAction.TextColor3 = C.Text
		highlight.OutlineColor = C.Cyan
		promptStroke.Color = C.CyanDim
	end
end

-- Sucht das naechste bedienbare Objekt. Hehler und Hack-Ziel konkurrieren:
-- was naeher dran ist, gewinnt den Prompt. Deshalb gibt es nur EINE Taste.
local function scan()
	if hackOpen then
		hidePrompt()
		return
	end

	local position = Geometry.AlivePosition(player)
	if not position then
		hidePrompt()
		return
	end

	local hackRange = Config.GetRange(rig.NetCard)
	local bestHack: BasePart? = nil
	local bestHackDistance = math.huge

	for _, inst in CollectionService:GetTagged(Config.HackableTag) do
		if inst:IsA("BasePart") and inst:IsDescendantOf(workspace) then
			local d = Geometry.SurfaceDistance(inst, position)
			if d &lt;= hackRange and d &lt; bestHackDistance then
				bestHack, bestHackDistance = inst, d
			end
		end
	end

	local bestFence: BasePart? = nil
	local bestFenceDistance = math.huge

	for _, inst in CollectionService:GetTagged(Config.FenceTag) do
		if inst:IsA("BasePart") and inst:IsDescendantOf(workspace) then
			local d = Geometry.SurfaceDistance(inst, position)
			if d &lt;= Config.Sell.Range and d &lt; bestFenceDistance then
				bestFence, bestFenceDistance = inst, d
			end
		end
	end

	if bestFence and bestFenceDistance &lt;= bestHackDistance then
		showFencePrompt(bestFence, bestFenceDistance)
		return
	end

	if bestHack then
		local id = bestHack:GetAttribute("TargetId")
		if typeof(id) ~= "string" then
			hidePrompt() -- Server hat den Part noch nicht registriert
			return
		end
		showHackPrompt(bestHack, bestHackDistance, id)
		return
	end

	hidePrompt()
end

--==========================================================================
-- Eingabe
--==========================================================================

local function activate()
	if hackOpen then
		return
	end
	if currentKind == "FENCE" then
		Remotes.SellRequest:FireServer({})
	elseif currentKind == "HACK" and currentTargetId then
		Remotes.HackRequestStart:FireServer({ TargetId = currentTargetId })
	end
end

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.KeyCode == Enum.KeyCode.E then
		activate()
	end
end)

prompt.Activated:Connect(activate) -- Touch/Klick

--==========================================================================
-- Server-Meldungen
--==========================================================================

Remotes.EconomySync.OnClientEvent:Connect(function(snapshot: any)
	if typeof(snapshot) ~= "table" then
		return
	end
	wallet.Banked = snapshot.Banked or 0
	wallet.Unsold = snapshot.Unsold or 0
	wallet.Tier = snapshot.Tier or 1
	if typeof(snapshot.Rig) == "table" then
		rig = snapshot.Rig
	end
	-- Der Server schickt Restsekunden, keine Zeitstempel - nur so stimmt die
	-- Anzeige auch, wenn die Uhr des Clients anders geht.
	if typeof(snapshot.Cooldowns) == "table" then
		for id, seconds in snapshot.Cooldowns do
			if typeof(id) == "string" and typeof(seconds) == "number" and seconds &gt; 0 then
				cooldownUntil[id] = os.clock() + seconds
			end
		end
	end
	refreshWallet()
end)

Remotes.TraceSync.OnClientEvent:Connect(function(data: any)
	if typeof(data) ~= "table" then
		return
	end
	trace.Value = tonumber(data.Trace) or trace.Value
	trace.Max = tonumber(data.Max) or trace.Max
	trace.Locked = data.Locked == true
	trace.LockUntil = os.clock() + (tonumber(data.LockSeconds) or 0)

	if typeof(data.Bust) == "table" then
		playBust(math.floor(tonumber(data.Bust.Lost) or 0))
	end

	refreshTrace()
end)

Remotes.SellResult.OnClientEvent:Connect(function(data: any)
	if typeof(data) ~= "table" then
		return
	end
	if data.Ok then
		toast(
			("VERKAUFT   %d CRY  -  %d GEBUEHR  =  +%d BANK   //   TRACE -%d"):format(
				data.Gross or 0,
				data.Fee or 0,
				data.Net or 0,
				data.Relief or 0
			),
			C.Green
		)
		return
	end

	if data.Reason == "RANGE" then
		toast(("Zu weit vom Hehler weg - du bist %d Studs entfernt, erlaubt sind %d"):format(
			math.floor(tonumber(data.Distance) or 0),
			math.floor(tonumber(data.Range) or Config.Sell.Range)
		), C.Amber)
		return
	end

	local reasons: { [string]: string } = {
		EMPTY = "Du hast nichts Unverkauftes dabei",
		NO_FENCE = "Kein Hehler in der Naehe",
		LOADING = "Profil laedt noch - gleich nochmal",
	}
	toast(reasons[data.Reason] or "Verkauf abgelehnt", C.Amber)
end)

Remotes.HackSessionStarted.OnClientEvent:Connect(function()
	hackOpen = true
	hidePrompt()
end)

Remotes.HackResolved.OnClientEvent:Connect(function(data: any)
	hackOpen = false
	if typeof(data) ~= "table" then
		return
	end

	if typeof(data.TargetId) == "string" and typeof(data.Cooldown) == "number" and data.Cooldown &gt; 0 then
		cooldownUntil[data.TargetId] = os.clock() + data.Cooldown
	end

	if data.Success then
		toast(("BREACH ERFOLGREICH   +%d CRY   TRACE +%.0f"):format(data.Reward or 0, data.TraceDelta or 0), C.Cyan)
	else
		local reasons: { [string]: string } = {
			TIMEOUT = "ZEIT ABGELAUFEN",
			NO_ATTEMPTS = "RIG UEBERLASTET - KEINE VERSUCHE MEHR",
			OUT_OF_RANGE = "VERBINDUNG ABGERISSEN - ZU WEIT WEG",
			ABORTED = "ABGEBROCHEN",
			TARGET_GONE = "ZIEL VERSCHWUNDEN",
			BUSTED = "AUFGEFLOGEN - VERBINDUNG GEKAPPT",
		}
		local text = reasons[data.Reason] or "BREACH FEHLGESCHLAGEN"
		toast(("%s   TRACE +%.0f"):format(text, data.TraceDelta or 0), C.Magenta)
	end
end)

Remotes.HackDenied.OnClientEvent:Connect(function(data: any)
	if typeof(data) ~= "table" then
		return
	end
	local seconds = tonumber(data.Seconds) or 0

	-- Jede Ablehnung nennt Grund UND Zahl. Ein Spieler, der nicht versteht,
	-- warum sein Klick nichts tut, haelt das Spiel fuer kaputt und geht.
	if data.Reason == "COOLDOWN" then
		if typeof(data.TargetId) == "string" then
			cooldownUntil[data.TargetId] = os.clock() + seconds
		end
		toast(("Ziel noch heiss - %d s"):format(math.ceil(seconds)), C.Amber)
	elseif data.Reason == "LEVEL" then
		if typeof(data.Weakest) == "string" then
			toast(("Braucht Rig-Tier %d - dein schwaechstes Bauteil ist %s %d"):format(
				seconds,
				data.Weakest,
				math.floor(tonumber(data.WeakestLevel) or 1)
			), C.Amber)
		else
			toast(("Braucht Rig-Tier %d"):format(seconds), C.Amber)
		end
	elseif data.Reason == "RANGE" then
		if seconds &gt; 0 then
			toast(("Zu weit weg - %d Studs zu viel. NetCard aufruesten?"):format(math.ceil(seconds)), C.Amber)
		else
			toast("Zu weit weg - naeher ran oder NetCard aufruesten", C.Amber)
		end
	elseif data.Reason == "OFFLINE" then
		toast("Laeuft bereits offline - warte, bis es wieder hochfaehrt", C.TextDim)
	elseif data.Reason == "BUSTED" then
		toast(("Aufgeflogen - noch %d s Ruhe, bevor du wieder ran kannst"):format(math.ceil(seconds)), C.Magenta)
	elseif data.Reason == "LOADING" then
		toast("Profil laedt noch - gleich nochmal", C.TextDim)
	elseif data.Reason == "UNKNOWN_TARGET" then
		toast("Dieses Ziel gibt es nicht mehr", C.TextDim)
	else
		toast("Zugriff verweigert - der Server hat abgelehnt", C.Magenta)
	end
end)

--==========================================================================
-- Schleife
--==========================================================================

refreshWallet()
refreshTrace()

local scanAccumulator = 0
RunService.RenderStepped:Connect(function(dt)
	scanAccumulator += dt
	if scanAccumulator &gt;= 0.15 then
		scanAccumulator = 0
		scan()
		refreshTrace()
	end

	-- Puls ab WarnAt. Je heisser, desto schneller und roter - das ist der
	-- eigentliche Spannungsmesser des Spiels.
	if trace.Value &gt;= Config.Trace.WarnAt then
		local critical = trace.Value &gt;= Config.Trace.CriticalAt
		local speed = if critical then 11 else 6
		local pulse = 0.5 + 0.5 * math.sin(os.clock() * speed)
		local hot = if critical then C.Magenta else C.Amber
		traceFill.BackgroundColor3 = hot:Lerp(C.Text, pulse * 0.35)
		traceStroke.Color = hot
		traceStroke.Thickness = 1 + pulse
		traceTitle.TextColor3 = hot
	else
		traceFill.BackgroundColor3 = C.Cyan
		traceStroke.Color = C.Line
		traceStroke.Thickness = 1
		traceTitle.TextColor3 = C.TextDim
	end
end)

UITheme.Scanlines(walletPanel, 4)
</ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="GN52">
<Properties>
<string name="Name">HackUI</string>
<ProtectedString name="Source">-- StarterPlayer/StarterPlayerScripts/UI/HackUI.client.luau
--!strict
-- GHOSTNET :: Das Fake-Betriebssystem waehrend eines Hacks.
--
-- Dieses Skript kennt die Loesung nicht und rechnet nichts aus. Es zeigt,
-- was der Server geschickt hat, und meldet Klicks zurueck. Der komplette
-- Raetselzustand liegt auf dem Server.
--
-- Alles hier ist Fiktion: ein stilisiertes Minispiel, keine Darstellung
-- realer Technik.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Remotes = require(ReplicatedStorage.Shared.Remotes)
local UITheme = require(ReplicatedStorage.Shared.UITheme)

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local C = UITheme.Color

-- Zelltypen, identisch zu NodeBreach.lua
local OPEN, ICE, RELAY, START, EXIT = 0, 1, 2, 3, 4

local GLYPH = { [OPEN] = "\u{00B7}", [ICE] = "#", [RELAY] = "R", [START] = "S", [EXIT] = "E" }

--==========================================================================
-- Sitzungszustand (nur Anzeige)
--==========================================================================

local session: {
	Id: string,
	Deadline: number,
	TimeLimit: number,
	Width: number,
	Height: number,
	Cells: { number },
	Path: { number },
	RelaysLeft: number,
	AttemptsLeft: number,
	Attempts: number,
	NextStep: number,
	LastAck: number,
	LastSend: number,
	Closing: boolean,
}? = nil

local cellButtons: { [number]: TextButton } = {}
local connectors: { Frame } = {}
local logLines: { TextLabel } = {}
local typingToken = 0

-- Erklaermodus. Der Server setzt ihn ueber das Attribut "Teaches" am Ziel -
-- also nur am Uebungsterminal. Danach nie wieder.
local teaching = false

--==========================================================================
-- Aufbau
--==========================================================================

local gui = UITheme.Screen("GhostNetHackUI", 20)
gui.Enabled = false
gui.Parent = playerGui

local backdrop = UITheme.Frame({
	Name = "Backdrop",
	Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = Color3.new(0, 0, 0),
	BackgroundTransparency = 1,
	Parent = gui,
})

local window = UITheme.Frame({
	Name = "Window",
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.new(0.92, 0, 0.86, 0),
	BackgroundColor3 = C.Background,
	ClipsDescendants = true,
	Parent = backdrop,
})
UITheme.Corner(window, 5)
UITheme.Stroke(window, C.CyanDim)

local sizeConstraint = Instance.new("UISizeConstraint")
sizeConstraint.MaxSize = Vector2.new(820, 580)
sizeConstraint.MinSize = Vector2.new(320, 300)
sizeConstraint.Parent = window

--== Titelleiste ===========================================================

local titleBar = UITheme.Frame({
	Name = "TitleBar",
	Size = UDim2.new(1, 0, 0, 30),
	BackgroundColor3 = C.Panel,
	Parent = window,
})

local titleText = UITheme.Label({
	Name = "Title",
	Text = "GHOSTNET // NODE-BREACH",
	TextColor3 = C.Cyan,
	TextSize = 14,
	Position = UDim2.new(0, 12, 0, 0),
	Size = UDim2.new(0.5, 0, 1, 0),
	Parent = titleBar,
})

local targetText = UITheme.Label({
	Name = "Target",
	Text = "",
	TextColor3 = C.TextDim,
	TextSize = 12,
	TextXAlignment = Enum.TextXAlignment.Right,
	Position = UDim2.new(0.5, 0, 0, 0),
	Size = UDim2.new(0.5, -96, 1, 0),
	Parent = titleBar,
})

local abortButton = UITheme.Button({
	Name = "Abort",
	Text = "ABBRUCH [ESC]",
	TextSize = 11,
	TextColor3 = C.Magenta,
	BackgroundColor3 = C.PanelLight,
	AnchorPoint = Vector2.new(1, 0.5),
	Position = UDim2.new(1, -8, 0.5, 0),
	Size = UDim2.fromOffset(86, 20),
	Parent = titleBar,
})
UITheme.Corner(abortButton, 3)
UITheme.Stroke(abortButton, C.Magenta)

--== Linke Spalte: Terminal + Status =======================================

local sidebar = UITheme.Frame({
	Name = "Sidebar",
	Position = UDim2.new(0, 0, 0, 30),
	Size = UDim2.new(0, 220, 1, -38),
	BackgroundColor3 = C.Background,
	Parent = window,
})
UITheme.Padding(sidebar, 12)

local statusBox = UITheme.Frame({
	Name = "Status",
	Size = UDim2.new(1, 0, 0, 74),
	BackgroundColor3 = C.Panel,
	Parent = sidebar,
})
UITheme.Corner(statusBox, 3)
UITheme.Stroke(statusBox, C.Line)
UITheme.Padding(statusBox, 8)

local relayLabel = UITheme.Label({
	Name = "Relays",
	Text = "RELAYS   -",
	TextSize = 12,
	Size = UDim2.new(1, 0, 0, 16),
	Parent = statusBox,
})

local attemptsLabel = UITheme.Label({
	Name = "AttemptsText",
	Text = "RAM",
	TextSize = 12,
	TextColor3 = C.TextDim,
	Position = UDim2.new(0, 0, 0, 20),
	Size = UDim2.new(1, 0, 0, 14),
	Parent = statusBox,
})

local chipHolder = UITheme.Frame({
	Name = "Chips",
	BackgroundTransparency = 1,
	Position = UDim2.new(0, 0, 0, 38),
	Size = UDim2.new(1, 0, 0, 12),
	Parent = statusBox,
})
local chipLayout = Instance.new("UIListLayout")
chipLayout.FillDirection = Enum.FillDirection.Horizontal
chipLayout.Padding = UDim.new(0, 4)
chipLayout.Parent = chipHolder

local terminal = UITheme.Frame({
	Name = "Terminal",
	Position = UDim2.new(0, 0, 0, 84),
	Size = UDim2.new(1, 0, 1, -84),
	BackgroundColor3 = C.Panel,
	ClipsDescendants = true,
	Parent = sidebar,
})
UITheme.Corner(terminal, 3)
UITheme.Stroke(terminal, C.Line)
UITheme.Padding(terminal, 8)

local termLayout = Instance.new("UIListLayout")
termLayout.SortOrder = Enum.SortOrder.LayoutOrder
termLayout.Padding = UDim.new(0, 2)
termLayout.Parent = terminal

--== Rechte Spalte: Gitter =================================================

local gridArea = UITheme.Frame({
	Name = "GridArea",
	Position = UDim2.new(0, 220, 0, 30),
	Size = UDim2.new(1, -220, 1, -38),
	BackgroundTransparency = 1,
	Parent = window,
})

local grid = UITheme.Frame({
	Name = "Grid",
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.fromScale(0.86, 0.86),
	BackgroundTransparency = 1,
	Parent = gridArea,
})
local gridAspect = Instance.new("UIAspectRatioConstraint")
gridAspect.AspectRatio = 1
gridAspect.Parent = grid

-- Regelzeile fuer den Erklaermodus. Standardmaessig unsichtbar.
local rule = UITheme.Label({
	Name = "Rule",
	Text = "",
	TextColor3 = C.Amber,
	TextSize = 13,
	TextWrapped = true,
	TextXAlignment = Enum.TextXAlignment.Center,
	Position = UDim2.new(0, 8, 0, 2),
	Size = UDim2.new(1, -16, 0, 30),
	Visible = false,
	Parent = gridArea,
})

--== Timer-Balken ==========================================================

local timerTrack = UITheme.Frame({
	Name = "TimerTrack",
	AnchorPoint = Vector2.new(0, 1),
	Position = UDim2.new(0, 0, 1, 0),
	Size = UDim2.new(1, 0, 0, 8),
	BackgroundColor3 = C.PanelLight,
	Parent = window,
})

local timerFill = UITheme.Frame({
	Name = "TimerFill",
	Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = C.Cyan,
	Parent = timerTrack,
})

local timerText = UITheme.Label({
	Name = "TimerText",
	Text = "",
	TextSize = 11,
	TextColor3 = C.Background,
	TextXAlignment = Enum.TextXAlignment.Center,
	Size = UDim2.fromScale(1, 1),
	ZIndex = 3,
	Parent = timerTrack,
})

--== Ergebnis-Overlay ======================================================

local resultOverlay = UITheme.Frame({
	Name = "Result",
	Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = C.Background,
	BackgroundTransparency = 1,
	Visible = false,
	ZIndex = 60,
	Parent = window,
})

local resultTitle = UITheme.Label({
	Name = "ResultTitle",
	Text = "",
	TextSize = 34,
	TextXAlignment = Enum.TextXAlignment.Center,
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.46),
	Size = UDim2.new(1, 0, 0, 40),
	ZIndex = 61,
	Parent = resultOverlay,
})

local resultSub = UITheme.Label({
	Name = "ResultSub",
	Text = "",
	TextSize = 14,
	TextColor3 = C.TextDim,
	TextXAlignment = Enum.TextXAlignment.Center,
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.56),
	Size = UDim2.new(1, 0, 0, 20),
	ZIndex = 61,
	Parent = resultOverlay,
})

UITheme.Scanlines(window, 4)

--==========================================================================
-- Terminal
--==========================================================================

local function pushLog(text: string, color: Color3?, instant: boolean?)
	local line = UITheme.Label({
		Text = "",
		TextSize = 11,
		TextColor3 = color or C.TextDim,
		TextWrapped = true,
		Size = UDim2.new(1, 0, 0, 13),
		LayoutOrder = #logLines + 1,
		Parent = terminal,
	})
	table.insert(logLines, line)

	while #logLines &gt; 16 do
		local old = table.remove(logLines, 1)
		if old then
			old:Destroy()
		end
	end

	if instant then
		line.Text = text
	else
		local token = typingToken
		task.spawn(function()
			UITheme.TypeInto(line, text, 130, function()
				return typingToken ~= token or line.Parent == nil
			end)
		end)
	end
end

local function clearLog()
	typingToken += 1
	for _, line in logLines do
		line:Destroy()
	end
	table.clear(logLines)
end

--==========================================================================
-- Gitter zeichnen
--==========================================================================

local function clearGrid()
	for _, b in cellButtons do
		b:Destroy()
	end
	table.clear(cellButtons)
	for _, c in connectors do
		c:Destroy()
	end
	table.clear(connectors)
end

local function cellCenter(idx: number, w: number, h: number): (number, number)
	local x = (idx - 1) % w + 1
	local y = math.floor((idx - 1) / w) + 1
	return (x - 0.5) / w, (y - 0.5) / h
end

local sendInput: (number) -&gt; ()

local function buildGrid()
	local s = session
	if not s then
		return
	end
	clearGrid()

	local w, h = s.Width, s.Height
	for idx = 1, w * h do
		local cx, cy = cellCenter(idx, w, h)
		local btn = UITheme.Button({
			Name = ("N%d"):format(idx),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(cx, cy),
			Size = UDim2.fromScale(0.78 / w, 0.78 / h),
			BackgroundColor3 = C.PanelLight,
			Text = "",
			TextSize = 13,
			ZIndex = 2,
			Parent = grid,
		})
		UITheme.Corner(btn, 3)
		UITheme.Stroke(btn, C.Line)
		btn.Activated:Connect(function()
			sendInput(idx)
		end)
		cellButtons[idx] = btn
	end
end

local function redrawGrid()
	local s = session
	if not s then
		return
	end

	local inPath: { [number]: boolean } = {}
	for _, idx in s.Path do
		inPath[idx] = true
	end
	local head = s.Path[#s.Path]

	for idx, btn in cellButtons do
		local cell = s.Cells[idx]
		local stroke = btn:FindFirstChildOfClass("UIStroke")

		btn.Text = GLYPH[cell] or ""
		btn.TextColor3 = C.TextDim
		btn.BackgroundColor3 = C.PanelLight
		btn.BackgroundTransparency = 0
		if stroke then
			stroke.Color = C.Line
			stroke.Thickness = 1
		end

		if cell == ICE then
			btn.BackgroundColor3 = C.Background
			btn.TextColor3 = C.Ice
			if stroke then
				stroke.Color = C.Ice
			end
		elseif cell == RELAY then
			btn.TextColor3 = C.Amber
			if stroke then
				stroke.Color = C.Amber
			end
		elseif cell == EXIT then
			btn.TextColor3 = C.Magenta
			if stroke then
				stroke.Color = C.Magenta
			end
		elseif cell == START then
			btn.TextColor3 = C.Cyan
		end

		if inPath[idx] then
			btn.BackgroundColor3 = C.CyanDim
			btn.TextColor3 = C.Background
			if stroke then
				stroke.Color = C.Cyan
			end
		end

		if idx == head then
			btn.BackgroundColor3 = C.Cyan
			btn.TextColor3 = C.Background
			if stroke then
				stroke.Color = C.Cyan
				stroke.Thickness = 2
			end
		end
	end

	-- Erklaermodus: Start und Exit hervorheben und den ersten gueltigen
	-- Nachbarknoten pulsieren lassen. Das verraet die Loesung nicht - es
	-- zeigt nur, was ueberhaupt anklickbar ist. Getarntes ICE sieht auch
	-- hier aus wie ein freier Knoten.
	if teaching and head then
		local width, height = s.Width, s.Height
		local hx = (head - 1) % width + 1
		local hy = math.floor((head - 1) / width) + 1
		local candidates = {}
		if hx &gt; 1 then
			table.insert(candidates, head - 1)
		end
		if hx &lt; width then
			table.insert(candidates, head + 1)
		end
		if hy &gt; 1 then
			table.insert(candidates, head - width)
		end
		if hy &lt; height then
			table.insert(candidates, head + width)
		end

		for _, idx in candidates do
			local cell = s.Cells[idx]
			if cell ~= ICE and not inPath[idx] then
				local btn = cellButtons[idx]
				if btn then
					local stroke = btn:FindFirstChildOfClass("UIStroke")
					if stroke then
						stroke.Color = C.Amber
						stroke.Thickness = 2
					end
				end
				break -- nur EINER pulsiert, sonst ist es wieder Rauschen
			end
		end
	end

	-- Verbindungslinien zwischen den Pfadknoten
	for _, c in connectors do
		c:Destroy()
	end
	table.clear(connectors)

	for i = 1, #s.Path - 1 do
		local ax, ay = cellCenter(s.Path[i], s.Width, s.Height)
		local bx, by = cellCenter(s.Path[i + 1], s.Width, s.Height)
		local horizontal = math.abs(ax - bx) &gt; math.abs(ay - by)
		local link = UITheme.Frame({
			Name = "Link",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale((ax + bx) * 0.5, (ay + by) * 0.5),
			Size = if horizontal
				then UDim2.new(0.34 / s.Width, 0, 0, 3)
				else UDim2.new(0, 3, 0.34 / s.Height, 0),
			BackgroundColor3 = C.Cyan,
			ZIndex = 1,
			Parent = grid,
		})
		table.insert(connectors, link)
	end
end

local function redrawChips()
	local s = session
	if not s then
		return
	end
	for _, child in chipHolder:GetChildren() do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	for i = 1, s.Attempts do
		local chip = UITheme.Frame({
			Name = "Chip",
			Size = UDim2.fromOffset(16, 8),
			BackgroundColor3 = if i &lt;= s.AttemptsLeft then C.Cyan else C.Line,
			LayoutOrder = i,
			Parent = chipHolder,
		})
		UITheme.Corner(chip, 2)
	end
	attemptsLabel.Text = ("RAM   %d / %d VERSUCHE"):format(s.AttemptsLeft, s.Attempts)
	relayLabel.Text = ("RELAYS   %d OFFEN"):format(s.RelaysLeft)
	relayLabel.TextColor3 = if s.RelaysLeft &gt; 0 then C.Amber else C.Cyan
end

--==========================================================================
-- Eingabe an den Server
--==========================================================================

-- Eigene Drossel knapp unter dem Server-Limit. Damit kann der Client sein
-- eigenes Rate-Limit gar nicht erst reissen und aus dem Takt geraten.
local MIN_SEND_INTERVAL = 0.09

sendInput = function(node: number)
	local s = session
	if not s or s.Closing then
		return
	end
	local now = os.clock()
	if now - s.LastSend &lt; MIN_SEND_INTERVAL then
		return
	end
	s.LastSend = now

	local btn = cellButtons[node]
	if btn then
		UITheme.Flash(btn, C.Text)
	end

	Remotes.HackInput:FireServer({
		SessionId = s.Id,
		Step = s.NextStep,
		Payload = { Node = node },
	})
	s.NextStep += 1
end

--==========================================================================
-- Oeffnen / Schliessen
--==========================================================================

local function open()
	gui.Enabled = true
	backdrop.BackgroundTransparency = 1
	window.Size = UDim2.new(0.92, 0, 0.3, 0)
	resultOverlay.Visible = false
	resultOverlay.BackgroundTransparency = 1

	TweenService:Create(backdrop, UITheme.Tween.Normal, { BackgroundTransparency = 0.35 }):Play()
	TweenService:Create(window, UITheme.Tween.Slow, { Size = UDim2.new(0.92, 0, 0.86, 0) }):Play()
end

local function close()
	local s = session
	if s then
		s.Closing = true
	end
	TweenService:Create(backdrop, UITheme.Tween.Normal, { BackgroundTransparency = 1 }):Play()
	local shrink = TweenService:Create(window, UITheme.Tween.Normal, { Size = UDim2.new(0.92, 0, 0.3, 0) })
	shrink:Play()
	shrink.Completed:Connect(function()
		gui.Enabled = false
		clearGrid()
		clearLog()
		session = nil
	end)
end

local function abort()
	local s = session
	if not s or s.Closing then
		return
	end
	Remotes.HackAbort:FireServer({ SessionId = s.Id })
end

abortButton.Activated:Connect(abort)

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.KeyCode == Enum.KeyCode.Escape and gui.Enabled then
		abort()
	end
end)

--==========================================================================
-- Server-Meldungen
--==========================================================================

Remotes.HackSessionStarted.OnClientEvent:Connect(function(data: any)
	if typeof(data) ~= "table" or typeof(data.Public) ~= "table" then
		return
	end
	local public = data.Public
	teaching = data.Tutorial == true

	session = {
		Id = data.SessionId,
		Deadline = data.Deadline,
		TimeLimit = data.TimeLimit,
		Width = public.Width,
		Height = public.Height,
		Cells = public.Cells,
		Path = { public.Start },
		RelaysLeft = public.Relays,
		AttemptsLeft = data.Attempts,
		Attempts = data.Attempts,
		NextStep = 1,
		LastAck = 0,
		LastSend = 0,
		Closing = false,
	}

	titleText.Text = ("GHOSTNET // %s"):format(data.Label or "BREACH")
	targetText.Text = ("%s   [D%d]"):format(data.Target and data.Target.Name or "?", data.Target and data.Target.Difficulty or 0)

	clearLog()
	buildGrid()
	redrawGrid()
	redrawChips()
	open()

	pushLog("&gt; uplink hergestellt", C.Cyan)
	task.delay(0.35, function()
		if session and session.Id == data.SessionId then
			pushLog(("&gt; ziel: %s"):format(string.lower(data.Target and data.Target.Name or "unbekannt")))
		end
	end)
	task.delay(0.8, function()
		if session and session.Id == data.SessionId then
			pushLog("&gt; route vom start zum exit legen", C.Text)
		end
	end)
	task.delay(1.2, function()
		if session and session.Id == data.SessionId then
			pushLog("&gt; alle relays (R) mitnehmen", C.Amber)
		end
	end)
	task.delay(1.6, function()
		if session and session.Id == data.SessionId then
			pushLog("&gt; warnung: getarntes ice im gitter", C.Magenta)
		end
	end)

	-- Die Regel steht IM Spiel, nicht davor. Ein Satz, gross, ueber dem
	-- Gitter - und nur beim Uebungsterminal.
	rule.Visible = teaching
	if teaching then
		rule.Text = "Von S nach E.  Alle R mitnehmen.  # ist gesperrt.  Der gelbe Knoten ist dein naechster Zug."
	end
end)

-- Jede Rueckmeldung sagt, WARUM der Klick nichts getan hat - und wo es eine
-- Zahl gibt, steht sie drin (siehe unten bei RELAYS_MISSING).
local REASON_TEXT: { [string]: { Text: string, Color: Color3 } } = {
	OK = { Text = "&gt; knoten uebernommen", Color = C.Cyan },
	SOLVED = { Text = "&gt; exit erreicht - zugriff gewaehrt", Color = C.Cyan },
	BACKTRACK = { Text = "&gt; letzten knoten zurueckgenommen", Color = C.TextDim },
	NOT_ADJACENT = { Text = "&gt; zu weit: nur direkte nachbarn gehen", Color = C.TextDim },
	REVISIT = { Text = "&gt; dieser knoten liegt schon im pfad", Color = C.TextDim },
	ALREADY_HERE = { Text = "&gt; da stehst du gerade", Color = C.TextDim },
	ICE = { Text = "&gt; ICE (#) blockiert - drumherum", Color = C.Ice },
	RELAYS_MISSING = { Text = "&gt; exit gesperrt: erst alle R mitnehmen", Color = C.Amber },
	MASKED_ICE = { Text = "&gt; GETARNTES ICE - kostet einen versuch", Color = C.Magenta },
	BAD_PAYLOAD = { Text = "&gt; eingabe verworfen", Color = C.Magenta },
}

Remotes.HackFeedback.OnClientEvent:Connect(function(data: any)
	local s = session
	if not s or typeof(data) ~= "table" or data.SessionId ~= s.Id then
		return
	end

	-- Schritt-Zaehler am Server ausrichten, falls er je auseinanderlaufen sollte.
	if typeof(data.Step) == "number" then
		s.LastAck = data.Step
		s.NextStep = math.max(s.NextStep, data.Step + 1)
	end

	if typeof(data.AttemptsLeft) == "number" then
		s.AttemptsLeft = data.AttemptsLeft
	end

	local fb = data.Feedback
	if typeof(fb) == "table" then
		if typeof(fb.Path) == "table" then
			s.Path = fb.Path
		end
		if typeof(fb.RelaysLeft) == "number" then
			s.RelaysLeft = fb.RelaysLeft
		end
		-- Getarntes ICE, das gerade aufgeflogen ist.
		if typeof(fb.Reveal) == "number" then
			s.Cells[fb.Reveal] = ICE
			local btn = cellButtons[fb.Reveal]
			if btn then
				UITheme.Flash(btn, C.Magenta)
			end
		end
	end

	local info = REASON_TEXT[data.Reason]
	if info then
		local text = info.Text
		-- Mit konkreter Zahl, wo der Server eine liefert.
		if data.Reason == "RELAYS_MISSING" and s.RelaysLeft &gt; 0 then
			text = ("&gt; exit gesperrt: noch %d relay(s) offen"):format(s.RelaysLeft)
		elseif data.Reason == "MASKED_ICE" then
			text = ("&gt; GETARNTES ICE - noch %d versuch(e)"):format(math.max(0, s.AttemptsLeft))
		end
		pushLog(text, info.Color, true)
	end

	redrawGrid()
	redrawChips()
end)

local RESOLVE_TEXT: { [string]: string } = {
	SOLVED = "zugriff gewaehrt",
	TIMEOUT = "verbindung zeitueberschreitung",
	NO_ATTEMPTS = "rig ueberlastet",
	OUT_OF_RANGE = "signal verloren",
	ABORTED = "abbruch durch benutzer",
	TARGET_GONE = "ziel nicht mehr erreichbar",
}

Remotes.HackResolved.OnClientEvent:Connect(function(data: any)
	local s = session
	if not s or typeof(data) ~= "table" or data.SessionId ~= s.Id then
		return
	end
	s.Closing = true

	resultOverlay.Visible = true
	TweenService:Create(resultOverlay, UITheme.Tween.Normal, { BackgroundTransparency = 0.12 }):Play()

	if data.Success then
		resultTitle.Text = "BREACH OK"
		resultTitle.TextColor3 = C.Cyan
		resultSub.Text = ("+%d CRY   //   TRACE +%.0f"):format(data.Reward or 0, data.TraceDelta or 0)
		resultSub.TextColor3 = C.Text
	else
		resultTitle.Text = "BREACH FEHLGESCHLAGEN"
		resultTitle.TextColor3 = C.Magenta
		resultSub.Text = ("%s   //   TRACE +%.0f"):format(RESOLVE_TEXT[data.Reason] or "abbruch", data.TraceDelta or 0)
		resultSub.TextColor3 = C.TextDim
	end

	task.delay(1.7, close)
end)

--==========================================================================
-- Timer
--==========================================================================

RunService.RenderStepped:Connect(function()
	local s = session
	if not s or not gui.Enabled then
		return
	end

	local remaining = math.max(0, s.Deadline - workspace:GetServerTimeNow())
	local fraction = if s.TimeLimit &gt; 0 then math.clamp(remaining / s.TimeLimit, 0, 1) else 0

	timerFill.Size = UDim2.fromScale(fraction, 1)
	timerText.Text = ("%.1fs"):format(remaining)

	if s.Closing then
		timerFill.BackgroundColor3 = C.Line
	elseif fraction &lt; 0.25 then
		-- letzte Sekunden: pulsierendes Warnmagenta
		local pulse = 0.5 + 0.5 * math.sin(os.clock() * 12)
		timerFill.BackgroundColor3 = C.Magenta:Lerp(C.Amber, pulse)
	else
		timerFill.BackgroundColor3 = C.Cyan
	end
end)

--==========================================================================
-- Notbremse: Sollte eine Eingabe nie beantwortet werden, setzen wir den
-- Schrittzaehler zurueck, damit die Session nicht stumm haengen bleibt.
--==========================================================================

task.spawn(function()
	while true do
		task.wait(2.5)
		local s = session
		if s and not s.Closing and s.NextStep &gt; s.LastAck + 1 and os.clock() - s.LastSend &gt; 2.5 then
			s.NextStep = s.LastAck + 1
			pushLog("&gt; resync", C.TextDim, true)
		end
	end
end)
</ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="GN53">
<Properties>
<string name="Name">MapUI</string>
<ProtectedString name="Source">-- StarterPlayerScripts/UI/MapUI.client.luau
--!strict
-- GHOSTNET :: Minikarte und grosse Karte.
--
-- ZWEI ANSICHTEN, EINE DATENQUELLE
--   Minikarte    klein unten rechts, folgt dem Spieler, zeigt die Umgebung.
--   Grosse Karte [M] oder Tippen auf die Minikarte: die ganze Stadt mit
--                Bezirksnamen und Legende. Das ist die Antwort auf
--                "wo ist eigentlich was".
--
-- Beide zeichnen dieselben Daten aus Remotes.MapSync. Es gibt keine zweite
-- Karte, die auseinanderlaufen koennte.
--
-- KEINE BILDER, KEINE ASSET-IDS
--   Strassen sind gedrehte Frames, Symbole sind kleine Quadrate. Damit
--   braucht die Karte keine einzige hochgeladene Textur - und Noah muss
--   nichts eintragen, damit sie funktioniert.
--
-- LEISTUNG
--   Der ganze Karteninhalt wird EINMAL gebaut, wenn die Daten ankommen.
--   Pro Bild wird nur die Position des Inhalts-Containers und das
--   Spielersymbol angefasst - nicht jede der rund hundert Strassen.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage.Shared.Config)
local Districts = require(ReplicatedStorage.Shared.Districts)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local UITheme = require(ReplicatedStorage.Shared.UITheme)

local M = Config.Map
local player = Players.LocalPlayer

--==========================================================================
-- Kartenarten nachschlagen
--==========================================================================

local kindById: { [string]: any } = {}
for _, kind in M.Kinds do
	kindById[kind.Id] = kind
end

local function kindColour(id: string): Color3
	local kind = kindById[id]
	return if kind then kind.Colour else UITheme.Color.TextDim
end

local function kindOrder(id: string): number
	local kind = kindById[id]
	return if kind then kind.Order else 1
end

--==========================================================================
-- Ausmasse der Stadt
--
-- Aus Config gerechnet, nicht aus den empfangenen Knoten: so passt die
-- Karte auch dann, wenn gerade nur ein Teil der Stadt getaggt ist.
--==========================================================================

local CITY_HALF = (Config.City.Grid - 1) * 0.5 * Config.City.BlockSize + Config.City.BlockSize * 0.5

--==========================================================================
-- Ein Kartenfenster (Minikarte oder grosse Karte)
--==========================================================================

type Surface = {
	Holder: GuiObject,
	World: Frame, -- verschiebbarer Inhalt
	Scale: number, -- Pixel pro Stud
	Icons: number,
	RoadWidth: number,
	Marker: Frame?, -- Auftrags-Wegpunkt
	Player: Frame,
}

-- Weltkoordinate -&gt; Pixel innerhalb des Inhalts-Containers.
local function toPixels(surface: Surface, x: number, z: number): (number, number)
	return x * surface.Scale, z * surface.Scale
end

local function drawRoad(surface: Surface, ax: number, az: number, bx: number, bz: number)
	local x1, z1 = toPixels(surface, ax, az)
	local x2, z2 = toPixels(surface, bx, bz)
	local dx, dz = x2 - x1, z2 - z1
	local length = math.sqrt(dx * dx + dz * dz)
	if length &lt; 1 then
		return
	end

	local road = UITheme.Frame({
		Name = "Strasse",
		BackgroundColor3 = UITheme.Color.Line,
		BackgroundTransparency = M.RoadTransparency,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset((x1 + x2) * 0.5, (z1 + z2) * 0.5),
		Size = UDim2.fromOffset(length, surface.RoadWidth),
		Rotation = math.deg(math.atan2(dz, dx)),
		ZIndex = 2,
	})
	road.Parent = surface.World
end

local function drawDistrict(surface: Surface, district: Districts.District)
	local block = Config.City.BlockSize
	local extent = (district.Radius * 2 + 1) * block
	local x, z = toPixels(surface, district.GridX * block, district.GridZ * block)

	local area = UITheme.Frame({
		Name = district.Id,
		BackgroundColor3 = district.Neon,
		BackgroundTransparency = M.DistrictTransparency,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(x, z),
		Size = UDim2.fromOffset(extent * surface.Scale, extent * surface.Scale),
		ZIndex = 1,
	})
	UITheme.Corner(area, 4)
	area.Parent = surface.World

	if surface.Icons &gt;= M.BigIcon then
		local label = UITheme.Label({
			Name = "Name",
			Text = district.Name:upper(),
			TextColor3 = district.Neon,
			TextSize = M.DistrictLabelSize,
			TextTransparency = 0.25,
			TextXAlignment = Enum.TextXAlignment.Center,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(x, z - extent * surface.Scale * 0.5 + 12),
			Size = UDim2.fromOffset(160, 16),
			ZIndex = 3,
		})
		label.Parent = surface.World
	end
end

local function drawPoi(surface: Surface, poi: { [string]: any })
	local x, z = toPixels(surface, poi.X, poi.Z)
	local size = surface.Icons

	local dot = UITheme.Frame({
		Name = poi.Kind,
		BackgroundColor3 = kindColour(poi.Kind),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(x, z),
		Size = UDim2.fromOffset(size, size),
		ZIndex = 4 + kindOrder(poi.Kind),
	})
	UITheme.Corner(dot, math.floor(size * 0.5))
	UITheme.Stroke(dot, UITheme.Color.Background, 1)
	dot.Parent = surface.World

	-- Namen nur auf der grossen Karte: auf der Minikarte waere das Kleisterei.
	if surface.Icons &gt;= M.BigIcon and poi.Kind ~= "TARGET" and poi.Kind ~= "EXPOSED" then
		local label = UITheme.Label({
			Name = "Name",
			Text = poi.Name,
			TextColor3 = kindColour(poi.Kind),
			TextSize = 11,
			TextXAlignment = Enum.TextXAlignment.Center,
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromOffset(x, z + size * 0.7),
			Size = UDim2.fromOffset(150, 14),
			ZIndex = 12,
		})
		label.Parent = surface.World
	end
end

local function makePlayerIcon(surface: Surface): Frame
	-- Ein gedrehtes Quadrat als Pfeilersatz: ohne Bild-Asset geht kein
	-- richtiger Pfeil, und ein gekipptes Viereck liest sich gut genug.
	local icon = UITheme.Frame({
		Name = "Spieler",
		BackgroundColor3 = UITheme.Color.Text,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(M.PlayerIcon, M.PlayerIcon),
		Rotation = 45,
		ZIndex = 20,
	})
	UITheme.Stroke(icon, UITheme.Color.Background, 2)
	icon.Parent = surface.Holder
	return icon
end

--==========================================================================
-- Aufbau der Fenster
--==========================================================================

local gui = UITheme.Screen("GhostNetMap", 6)
gui.Parent = player:WaitForChild("PlayerGui")

--== Minikarte =============================================================

local miniButton = UITheme.Button({
	Name = "Minikarte",
	BackgroundColor3 = M.Background,
	-- Unten rechts: oben rechts sitzen schon Wallet, Trace und die
	-- Fahndungssterne, unten links die Knoepfe fuer Shop und Store.
	AnchorPoint = Vector2.new(1, 1),
	Position = UDim2.new(1, -M.MiniMargin, 1, -M.MiniMargin),
	Size = UDim2.fromOffset(M.MiniSize, M.MiniSize),
	ClipsDescendants = true,
	ZIndex = 2,
})
UITheme.Corner(miniButton, 6)
UITheme.Stroke(miniButton, UITheme.Color.Line, 1)
miniButton.Parent = gui

local miniWorld = UITheme.Frame({
	Name = "Inhalt",
	BackgroundTransparency = 1,
	Size = UDim2.fromScale(1, 1),
	ZIndex = 2,
})
miniWorld.Parent = miniButton

local miniHint = UITheme.Label({
	Name = "Hinweis",
	Text = "[M] KARTE",
	TextColor3 = UITheme.Color.TextDim,
	TextSize = 11,
	TextXAlignment = Enum.TextXAlignment.Center,
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -3),
	Size = UDim2.new(1, 0, 0, 14),
	ZIndex = 25,
})
miniHint.Parent = miniButton

local mini: Surface = {
	Holder = miniButton,
	World = miniWorld,
	Scale = (M.MiniSize * 0.5) / M.MiniRange,
	Icons = M.MiniIcon,
	RoadWidth = M.MiniRoadWidth,
	Player = nil :: any,
}
mini.Player = makePlayerIcon(mini)
mini.Player.Position = UDim2.fromScale(0.5, 0.5) -- die Minikarte folgt dem Spieler

--== Grosse Karte ==========================================================

local backdrop = UITheme.Frame({
	Name = "Karte",
	BackgroundColor3 = UITheme.Color.Background,
	BackgroundTransparency = 0.12,
	Size = UDim2.fromScale(1, 1),
	Visible = false,
	ZIndex = 30,
})
backdrop.Parent = gui

local bigSize = 0
local bigScale = 0

local bigPanel = UITheme.Frame({
	Name = "Blatt",
	BackgroundColor3 = M.Background,
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.fromScale(0.72, 0.86),
	ClipsDescendants = true,
	ZIndex = 31,
})
UITheme.Corner(bigPanel, 6)
UITheme.Stroke(bigPanel, UITheme.Color.Cyan, 1)
bigPanel.Parent = backdrop

local bigWorld = UITheme.Frame({
	Name = "Inhalt",
	BackgroundTransparency = 1,
	Size = UDim2.fromScale(1, 1),
	ZIndex = 31,
})
bigWorld.Parent = bigPanel

local bigTitle = UITheme.Label({
	Name = "Titel",
	Text = "VANTORRA",
	TextColor3 = UITheme.Color.Cyan,
	TextSize = 18,
	Position = UDim2.fromOffset(14, 10),
	Size = UDim2.fromOffset(300, 22),
	ZIndex = 40,
})
bigTitle.Parent = bigPanel

local closeButton = UITheme.Button({
	Name = "Schliessen",
	Text = "[M] SCHLIESSEN",
	TextColor3 = UITheme.Color.TextDim,
	AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.new(1, -10, 0, 10),
	Size = UDim2.fromOffset(160, 34), -- gross genug fuer Touch
	ZIndex = 40,
})
UITheme.Corner(closeButton, 4)
closeButton.Parent = bigPanel

local big: Surface = {
	Holder = bigPanel,
	World = bigWorld,
	Scale = 1,
	Icons = M.BigIcon,
	RoadWidth = M.BigRoadWidth,
	Player = nil :: any,
}
big.Player = makePlayerIcon(big)

--== Legende ===============================================================
-- "Wo alles ist" braucht auch: was bedeutet welcher Punkt.

local legend = UITheme.Frame({
	Name = "Legende",
	BackgroundColor3 = UITheme.Color.Panel,
	BackgroundTransparency = 0.15,
	AnchorPoint = Vector2.new(0, 1),
	Position = UDim2.new(0, 10, 1, -10),
	Size = UDim2.fromOffset(230, 22 + #M.Kinds * 18),
	ZIndex = 40,
})
UITheme.Corner(legend, 4)
UITheme.Stroke(legend, UITheme.Color.Line, 1)
legend.Parent = bigPanel

do
	local heading = UITheme.Label({
		Text = "LEGENDE",
		TextColor3 = UITheme.Color.TextDim,
		TextSize = 11,
		Position = UDim2.fromOffset(8, 4),
		Size = UDim2.fromOffset(200, 14),
		ZIndex = 41,
	})
	heading.Parent = legend

	for index, kind in M.Kinds do
		local y = 20 + (index - 1) * 18

		local dot = UITheme.Frame({
			BackgroundColor3 = kind.Colour,
			Position = UDim2.fromOffset(10, y + 4),
			Size = UDim2.fromOffset(8, 8),
			ZIndex = 41,
		})
		UITheme.Corner(dot, 4)
		dot.Parent = legend

		local text = UITheme.Label({
			Text = kind.Label,
			TextSize = 12,
			Position = UDim2.fromOffset(26, y),
			Size = UDim2.fromOffset(196, 16),
			ZIndex = 41,
		})
		text.Parent = legend
	end
end

--==========================================================================
-- Zeichnen, sobald die Daten da sind
--==========================================================================

local drawn = false

local function fillSurface(surface: Surface, payload: { [string]: any })
	for _, child in surface.World:GetChildren() do
		child:Destroy()
	end

	for _, district in Districts.List do
		drawDistrict(surface, district)
	end

	local nodes = payload.Nodes
	for _, edge in payload.Edges do
		local a = nodes[edge[1]]
		local b = nodes[edge[2]]
		if a and b then
			drawRoad(surface, a[1], a[2], b[1], b[2])
		end
	end

	for _, poi in payload.Pois do
		drawPoi(surface, poi)
	end
end

local function onMapSync(payload: { [string]: any })
	if typeof(payload) ~= "table" or typeof(payload.Edges) ~= "table" then
		return
	end

	-- Massstab der grossen Karte: die ganze Stadt soll hineinpassen.
	bigSize = math.min(bigPanel.AbsoluteSize.X, bigPanel.AbsoluteSize.Y)
	bigScale = (bigSize - M.BigPadding * 2) / (CITY_HALF * 2)
	big.Scale = math.max(bigScale, 0.01)

	fillSurface(mini, payload)
	fillSurface(big, payload)

	-- Die grosse Karte steht fest: Stadtmitte in die Blattmitte.
	bigWorld.Position = UDim2.fromScale(0.5, 0.5)
	bigWorld.Size = UDim2.fromOffset(0, 0) -- Kinder liegen als Offset um (0,0)

	drawn = true
end

Remotes.MapSync.OnClientEvent:Connect(onMapSync)

--==========================================================================
-- Auftrags-Wegpunkt
-- Kommt aus WaypointSync, nicht aus MapSync: er wechselt staendig.
--==========================================================================

local waypoint: Vector3? = nil
local waypointIcons: { [string]: Frame } = {}

local function setWaypointIcon(surface: Surface, key: string)
	local existing = waypointIcons[key]
	if existing then
		existing:Destroy()
		waypointIcons[key] = nil
	end
	if not waypoint then
		return
	end

	local x, z = toPixels(surface, waypoint.X, waypoint.Z)
	local icon = UITheme.Frame({
		Name = "Auftrag",
		BackgroundColor3 = kindColour("WAYPOINT"),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(x, z),
		Size = UDim2.fromOffset(surface.Icons + 3, surface.Icons + 3),
		Rotation = 45,
		ZIndex = 18,
	})
	UITheme.Stroke(icon, UITheme.Color.Background, 2)
	icon.Parent = surface.World
	waypointIcons[key] = icon
end

Remotes.WaypointSync.OnClientEvent:Connect(function(payload)
	if typeof(payload) == "table" and typeof(payload.Position) == "Vector3" then
		waypoint = payload.Position
	else
		waypoint = nil
	end
	setWaypointIcon(mini, "mini")
	setWaypointIcon(big, "big")
end)

--==========================================================================
-- Bewegung
--==========================================================================

local function alivePosition(): Vector3?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root.Position
	end
	return nil
end

RunService.RenderStepped:Connect(function()
	if not drawn then
		return
	end
	local position = alivePosition()
	if not position then
		return
	end

	-- Minikarte: der Inhalt wandert unter dem festen Spielersymbol durch.
	-- Genau EINE Eigenschaft pro Bild statt hundert Frames neu zu setzen.
	local px, pz = toPixels(mini, position.X, position.Z)
	miniWorld.Position = UDim2.new(0.5, -px, 0.5, -pz)

	local camera = workspace.CurrentCamera
	if camera then
		local look = camera.CFrame.LookVector
		-- Bildschirm-Y ist Welt-Z: deshalb atan2(X, Z) und nicht umgekehrt.
		local heading = math.deg(math.atan2(look.X, look.Z))
		mini.Player.Rotation = 45 - heading
		big.Player.Rotation = 45 - heading
	end

	if backdrop.Visible then
		local bx, bz = toPixels(big, position.X, position.Z)
		big.Player.Position = UDim2.new(0.5, bx, 0.5, bz)
	end
end)

--==========================================================================
-- Auf und zu
--==========================================================================

local function setOpen(open: boolean)
	backdrop.Visible = open
end

local function toggle()
	setOpen(not backdrop.Visible)
end

miniButton.Activated:Connect(toggle)
closeButton.Activated:Connect(function()
	setOpen(false)
end)

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.KeyCode == Enum.KeyCode.M then
		toggle()
	elseif input.KeyCode == Enum.KeyCode.Escape and backdrop.Visible then
		setOpen(false)
	end
end)

-- Beim Fahren stoert die grosse Karte. Minikarte bleibt.
CollectionService:GetInstanceAddedSignal(Config.VehicleTag):Connect(function()
	setOpen(false)
end)
</ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="GN54">
<Properties>
<string name="Name">MissionUI</string>
<ProtectedString name="Source">-- StarterPlayer/StarterPlayerScripts/UI/MissionUI.client.luau
--!strict
-- GHOSTNET :: Auftragsanzeige und Wegpunkt-Marker.
--
-- Reine Anzeige. Dieses Skript entscheidet nie, ob ein Schritt erfuellt ist -
-- das macht ausschliesslich der Server und schickt das Ergebnis per
-- MissionSync. Der einzige Knopf, den der Client druecken darf, ist [E] auf
-- einen Kontakt (TALK-Schritt), und auch den prueft der Server nochmal.
--
-- Solange keine Mission laeuft, ist hier nichts zu sehen.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage.Shared.Config)
local Geometry = require(ReplicatedStorage.Shared.Geometry)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local UITheme = require(ReplicatedStorage.Shared.UITheme)

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local C = UITheme.Color

--==========================================================================
-- Zustand (nur Abschrift dessen, was der Server geschickt hat)
--==========================================================================

local mission = {
	Active = "",
	Title = "",
	StepIndex = 0,
	StepCount = 0,
	StepText = "",
	StepType = "",
	StepProgress = 0,
	StepRequired = 1,
	StepSeconds = nil :: number?,
	StepStartedAt = 0,
	ContactId = nil :: string?,
}

local marker = {
	Position = nil :: Vector3?,
	Label = "",
}

local hackOpen = false

--==========================================================================
-- Aufbau
--==========================================================================

local gui = UITheme.Screen("GhostNetMissions", 12)
gui.Parent = playerGui

local panel = UITheme.Frame({
	Name = "Mission",
	Position = UDim2.new(0, 18, 0, 18),
	Size = UDim2.fromOffset(300, 92),
	BackgroundColor3 = C.Panel,
	BackgroundTransparency = 0.08,
	Visible = false,
	Parent = gui,
})
UITheme.Corner(panel, 4)
local panelStroke = UITheme.Stroke(panel, C.CyanDim)
UITheme.Padding(panel, 10)

local kicker = UITheme.Label({
	Name = "Kicker",
	Text = "AUFTRAG",
	TextColor3 = C.TextDim,
	TextSize = 11,
	Size = UDim2.new(1, 0, 0, 12),
	Parent = panel,
})

local titleLabel = UITheme.Label({
	Name = "Title",
	Text = "",
	TextColor3 = C.Cyan,
	TextSize = 16,
	TextTruncate = Enum.TextTruncate.AtEnd,
	Position = UDim2.new(0, 0, 0, 14),
	Size = UDim2.new(1, 0, 0, 18),
	Parent = panel,
})

local stepLabel = UITheme.Label({
	Name = "Step",
	Text = "",
	TextColor3 = C.Text,
	TextSize = 13,
	TextWrapped = true,
	Position = UDim2.new(0, 0, 0, 34),
	Size = UDim2.new(1, 0, 0, 30),
	Parent = panel,
})

local progressLabel = UITheme.Label({
	Name = "Progress",
	Text = "",
	TextColor3 = C.TextDim,
	TextSize = 11,
	Position = UDim2.new(0, 0, 1, -12),
	Size = UDim2.new(1, 0, 0, 12),
	Parent = panel,
})

local progressTrack = UITheme.Frame({
	Name = "Track",
	AnchorPoint = Vector2.new(1, 1),
	Position = UDim2.new(1, 0, 1, -2),
	Size = UDim2.fromOffset(110, 4),
	BackgroundColor3 = C.PanelLight,
	Parent = panel,
})
local progressFill = UITheme.Frame({
	Name = "Fill",
	Size = UDim2.fromScale(0, 1),
	BackgroundColor3 = C.Cyan,
	Parent = progressTrack,
})

--== Wegpunkt in der Welt ==================================================
-- Ein unsichtbarer Anker-Part traegt das Billboard. Rein clientseitig - er
-- existiert auf dem Server nicht und kann dort auch nichts ausloesen.

local anchor = Instance.new("Part")
anchor.Name = "GhostNetWaypointAnchor"
anchor.Anchored = true
anchor.CanCollide = false
anchor.CanQuery = false
anchor.CanTouch = false
anchor.Transparency = 1
anchor.Size = Vector3.new(1, 1, 1)

local billboard = Instance.new("BillboardGui")
billboard.Name = "Marker"
billboard.Size = UDim2.fromOffset(190, 44)
billboard.StudsOffsetWorldSpace = Vector3.new(0, 4, 0)
billboard.AlwaysOnTop = true
billboard.MaxDistance = 1000
billboard.Enabled = false
billboard.Adornee = anchor
billboard.Parent = anchor

local markerLabel = UITheme.Label({
	Name = "Text",
	Text = "",
	TextColor3 = C.Cyan,
	TextSize = 15,
	TextXAlignment = Enum.TextXAlignment.Center,
	Size = UDim2.new(1, 0, 0.6, 0),
	Parent = billboard,
})

local markerDistance = UITheme.Label({
	Name = "Distance",
	Text = "",
	TextColor3 = C.TextDim,
	TextSize = 12,
	TextXAlignment = Enum.TextXAlignment.Center,
	Position = UDim2.new(0, 0, 0.6, 0),
	Size = UDim2.new(1, 0, 0.4, 0),
	Parent = billboard,
})

anchor.Parent = workspace

--== Kontakt-Prompt (nur bei TALK-Schritten) ===============================

local contactPrompt = UITheme.Button({
	Name = "ContactPrompt",
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -136),
	Size = UDim2.fromOffset(300, 46), -- Touch-Ziel
	BackgroundColor3 = C.Panel,
	BackgroundTransparency = 0.06,
	Text = "",
	Visible = false,
	Parent = gui,
})
UITheme.Corner(contactPrompt, 4)
UITheme.Stroke(contactPrompt, C.Amber)

UITheme.Label({
	Name = "Caption",
	Text = "[E]  ANSPRECHEN",
	TextColor3 = C.Amber,
	TextSize = 14,
	TextXAlignment = Enum.TextXAlignment.Center,
	Size = UDim2.fromScale(1, 1),
	Parent = contactPrompt,
})

--==========================================================================
-- Anzeige
--==========================================================================

local function refresh()
	local active = mission.Active ~= "" and not hackOpen
	panel.Visible = active
	if not active then
		return
	end

	titleLabel.Text = mission.Title
	stepLabel.Text = mission.StepText

	local required = math.max(1, mission.StepRequired)
	local done = math.clamp(mission.StepProgress, 0, required)

	if required &gt; 1 then
		progressLabel.Text = ("SCHRITT %d/%d   //   %d von %d"):format(
			mission.StepIndex,
			mission.StepCount,
			done,
			required
		)
	else
		progressLabel.Text = ("SCHRITT %d/%d"):format(mission.StepIndex, mission.StepCount)
	end

	local fraction = if mission.StepCount &gt; 0 then (mission.StepIndex - 1 + done / required) / mission.StepCount else 0
	TweenService:Create(progressFill, UITheme.Tween.Normal, { Size = UDim2.fromScale(fraction, 1) }):Play()
end

--==========================================================================
-- Server-Meldungen
--==========================================================================

Remotes.MissionSync.OnClientEvent:Connect(function(data: any)
	if typeof(data) ~= "table" then
		return
	end

	local wasActive = mission.Active
	mission.Active = if typeof(data.Active) == "string" then data.Active else ""
	mission.Title = if typeof(data.Title) == "string" then data.Title else ""
	mission.StepIndex = tonumber(data.StepIndex) or 0
	mission.StepCount = tonumber(data.StepCount) or 0
	mission.StepText = if typeof(data.StepText) == "string" then data.StepText else ""
	mission.StepType = if typeof(data.StepType) == "string" then data.StepType else ""
	mission.StepProgress = tonumber(data.StepProgress) or 0
	mission.StepRequired = tonumber(data.StepRequired) or 1
	mission.StepSeconds = tonumber(data.StepSeconds)
	mission.StepStartedAt = tonumber(data.StepStartedAt) or 0
	mission.ContactId = if typeof(data.ContactId) == "string" then data.ContactId else nil

	-- Neue Mission: Panel kurz aufziehen, damit man es bemerkt.
	if mission.Active ~= "" and mission.Active ~= wasActive then
		panel.Size = UDim2.fromOffset(300, 60)
		panel.Visible = true
		TweenService:Create(panel, UITheme.Tween.Slow, { Size = UDim2.fromOffset(300, 92) }):Play()
		UITheme.Flash(panel, C.CyanDim)
	end

	refresh()
end)

Remotes.WaypointSync.OnClientEvent:Connect(function(data: any)
	if typeof(data) ~= "table" then
		return
	end
	marker.Position = if typeof(data.Position) == "Vector3" then data.Position else nil
	marker.Label = if typeof(data.Label) == "string" then data.Label else ""

	if marker.Position then
		anchor.Position = marker.Position
		markerLabel.Text = marker.Label
		billboard.Enabled = true
	else
		billboard.Enabled = false
	end
end)

Remotes.HackSessionStarted.OnClientEvent:Connect(function()
	hackOpen = true
	panel.Visible = false
	contactPrompt.Visible = false
	billboard.Enabled = false
end)

Remotes.HackResolved.OnClientEvent:Connect(function()
	hackOpen = false
	if marker.Position then
		billboard.Enabled = true
	end
	refresh()
end)

--==========================================================================
-- TALK: der einzige Knopf, den dieses Skript hat
--==========================================================================

local nearContact = false

local function tryInteract()
	if hackOpen or not nearContact then
		return
	end
	local contactId = mission.ContactId
	if mission.StepType ~= "TALK" or not contactId then
		return
	end
	Remotes.MissionInteract:FireServer({ ContactId = contactId })
end

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.KeyCode == Enum.KeyCode.E then
		tryInteract()
	end
end)

contactPrompt.Activated:Connect(tryInteract)

--==========================================================================
-- Schleife: Entfernung am Marker, WAIT-Countdown, Kontakt-Prompt
--==========================================================================

local accumulator = 0
RunService.RenderStepped:Connect(function(dt)
	accumulator += dt
	if accumulator &lt; 0.12 then
		return
	end
	accumulator = 0

	local position = Geometry.AlivePosition(player)

	-- Entfernung zum Wegpunkt.
	if billboard.Enabled and marker.Position and position then
		markerDistance.Text = ("%d m"):format(math.floor((marker.Position - position).Magnitude))
	elseif billboard.Enabled then
		markerDistance.Text = ""
	end

	-- Kontakt in Reichweite? Reine Anzeige - der Server prueft nochmal.
	local wantsContact = mission.Active ~= "" and mission.StepType == "TALK" and not hackOpen
	if wantsContact and marker.Position and position then
		nearContact = (marker.Position - position).Magnitude &lt;= Config.Mission.ContactRange
	else
		nearContact = false
	end
	contactPrompt.Visible = nearContact

	-- WAIT-Schritte zaehlen sichtbar herunter, sonst wirkt das Spiel haengend.
	if mission.Active ~= "" and mission.StepType == "WAIT" and mission.StepSeconds then
		local left = math.max(0, mission.StepStartedAt + mission.StepSeconds - os.time())
		progressLabel.Text = ("SCHRITT %d/%d   //   noch %ds"):format(mission.StepIndex, mission.StepCount, left)
	end
end)

refresh()
</ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="GN55">
<Properties>
<string name="Name">ShopUI</string>
<ProtectedString name="Source">-- StarterPlayer/StarterPlayerScripts/UI/ShopUI.client.luau
--!strict
-- GHOSTNET :: Der Rig-Shop. Hier wird Guthaben zu Fortschritt.
--
-- Das Fenster rechnet NICHTS aus, was zaehlt: Preise stehen in Config und
-- werden vom Server unabhaengig nochmal berechnet. Der Client schickt beim
-- Kauf nur, WELCHES Bauteil gemeint ist.
--
-- Bedienung: Knopf unten links oder Taste [B]. Bewusst von ueberall aus
-- erreichbar - das Rig ist die eigene Ausruestung, kein Ladenregal.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local UITheme = require(ReplicatedStorage.Shared.UITheme)

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local C = UITheme.Color

--==========================================================================
-- Zustand (reine Anzeige)
--==========================================================================

local banked = 0
local rig = table.clone(Config.Rig.StartLevels)
local busy = false
local hackOpen = false

type Row = {
	Frame: Frame,
	Level: TextLabel,
	Effect: TextLabel,
	Button: TextButton,
	Price: TextLabel,
}

local rows: { [string]: Row } = {}

--==========================================================================
-- Aufbau
--==========================================================================

local gui = UITheme.Screen("GhostNetShop", 15)
gui.Parent = playerGui

--== Oeffnen-Knopf unten links ============================================

local openButton = UITheme.Button({
	Name = "OpenShop",
	AnchorPoint = Vector2.new(0, 1),
	Position = UDim2.new(0, 18, 1, -46),
	Size = UDim2.fromOffset(150, 46), -- gross genug fuer Touch
	BackgroundColor3 = C.Panel,
	BackgroundTransparency = 0.06,
	Text = "",
	Parent = gui,
})
UITheme.Corner(openButton, 4)
UITheme.Stroke(openButton, C.CyanDim)

UITheme.Label({
	Name = "Caption",
	Text = "[B]  RIG-SHOP",
	TextColor3 = C.Cyan,
	TextSize = 14,
	TextXAlignment = Enum.TextXAlignment.Center,
	Size = UDim2.fromScale(1, 1),
	Parent = openButton,
})

--== Fenster ===============================================================

local backdrop = UITheme.Frame({
	Name = "Backdrop",
	Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = Color3.new(0, 0, 0),
	BackgroundTransparency = 1,
	Visible = false,
	Parent = gui,
})

local window = UITheme.Frame({
	Name = "Window",
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.new(0.9, 0, 0.8, 0),
	BackgroundColor3 = C.Background,
	ClipsDescendants = true,
	Parent = backdrop,
})
UITheme.Corner(window, 5)
UITheme.Stroke(window, C.CyanDim)

local windowSize = Instance.new("UISizeConstraint")
windowSize.MaxSize = Vector2.new(660, 470)
windowSize.MinSize = Vector2.new(300, 300)
windowSize.Parent = window

local titleBar = UITheme.Frame({
	Name = "TitleBar",
	Size = UDim2.new(1, 0, 0, 34),
	BackgroundColor3 = C.Panel,
	Parent = window,
})

UITheme.Label({
	Name = "Title",
	Text = "GHOSTNET // RIG-SHOP",
	TextColor3 = C.Cyan,
	TextSize = 14,
	Position = UDim2.new(0, 12, 0, 0),
	Size = UDim2.new(0.6, 0, 1, 0),
	Parent = titleBar,
})

local bankLabel = UITheme.Label({
	Name = "Bank",
	Text = "BANK 0 CRY",
	TextColor3 = C.Green,
	TextSize = 13,
	TextXAlignment = Enum.TextXAlignment.Right,
	AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.new(1, -104, 0, 0),
	Size = UDim2.new(0.4, 0, 1, 0),
	Parent = titleBar,
})

local closeButton = UITheme.Button({
	Name = "Close",
	Text = "SCHLIESSEN",
	TextSize = 11,
	TextColor3 = C.Magenta,
	BackgroundColor3 = C.PanelLight,
	AnchorPoint = Vector2.new(1, 0.5),
	Position = UDim2.new(1, -8, 0.5, 0),
	Size = UDim2.fromOffset(88, 24),
	Parent = titleBar,
})
UITheme.Corner(closeButton, 3)
UITheme.Stroke(closeButton, C.Magenta)

local hintLabel = UITheme.Label({
	Name = "Hint",
	Text = "Bezahlt wird von der BANK. Unverkauftes zaehlt nicht - erst zum Hehler.",
	TextColor3 = C.TextDim,
	TextSize = 12,
	Position = UDim2.new(0, 14, 0, 40),
	Size = UDim2.new(1, -28, 0, 16),
	Parent = window,
})

local list = UITheme.Frame({
	Name = "List",
	Position = UDim2.new(0, 14, 0, 62),
	Size = UDim2.new(1, -28, 1, -76),
	BackgroundTransparency = 1,
	Parent = window,
})
local listLayout = Instance.new("UIListLayout")
listLayout.SortOrder = Enum.SortOrder.LayoutOrder
listLayout.Padding = UDim.new(0, 8)
listLayout.Parent = list

--== Eine Zeile je Bauteil =================================================

local buy: (string) -&gt; ()

local function buildRow(component: string, order: number): Row
	local frame = UITheme.Frame({
		Name = component,
		Size = UDim2.new(1, 0, 0, 74),
		BackgroundColor3 = C.Panel,
		LayoutOrder = order,
		Parent = list,
	})
	UITheme.Corner(frame, 4)
	UITheme.Stroke(frame, C.Line)
	UITheme.Padding(frame, 10)

	UITheme.Label({
		Name = "Name",
		Text = (Config.Rig.Labels :: any)[component] or component,
		TextColor3 = C.Cyan,
		TextSize = 16,
		Size = UDim2.new(0.55, 0, 0, 18),
		Parent = frame,
	})

	UITheme.Label({
		Name = "Blurb",
		Text = (Config.Rig.Blurbs :: any)[component] or "",
		TextColor3 = C.TextDim,
		TextSize = 12,
		Position = UDim2.new(0, 0, 0, 20),
		Size = UDim2.new(0.55, 0, 0, 14),
		Parent = frame,
	})

	local level = UITheme.Label({
		Name = "Level",
		Text = "",
		TextColor3 = C.Text,
		TextSize = 13,
		Position = UDim2.new(0, 0, 0, 38),
		Size = UDim2.new(0.55, 0, 0, 15),
		Parent = frame,
	})

	local effect = UITheme.Label({
		Name = "Effect",
		Text = "",
		TextColor3 = C.Amber,
		TextSize = 12,
		Position = UDim2.new(0, 0, 1, -14),
		Size = UDim2.new(1, 0, 0, 14),
		Parent = frame,
	})

	local button = UITheme.Button({
		Name = "Buy",
		Text = "",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 4),
		Size = UDim2.fromOffset(132, 44), -- Touch-Ziel
		BackgroundColor3 = C.PanelLight,
		Parent = frame,
	})
	UITheme.Corner(button, 4)
	UITheme.Stroke(button, C.CyanDim)

	local price = UITheme.Label({
		Name = "Price",
		Text = "",
		TextColor3 = C.Text,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 1),
		Parent = button,
	})

	button.Activated:Connect(function()
		buy(component)
	end)

	return { Frame = frame, Level = level, Effect = effect, Button = button, Price = price }
end

for index, component in Config.Rig.Components do
	rows[component] = buildRow(component, index)
end

--==========================================================================
-- Anzeige
--==========================================================================

local function refresh()
	bankLabel.Text = ("BANK %d CRY"):format(banked)

	for _, component in Config.Rig.Components do
		local row = rows[component]
		local current = (rig :: any)[component] or 1
		local stroke = row.Frame:FindFirstChildOfClass("UIStroke")

		if current &gt;= Config.Rig.MaxLevel then
			row.Level.Text = ("STUFE %d  //  MAXIMUM"):format(current)
			row.Effect.Text = Config.GetRigEffect(component, current)
			row.Price.Text = "AUSGEBAUT"
			row.Price.TextColor3 = C.TextDim
			row.Button.BackgroundColor3 = C.Panel
			row.Button.AutoButtonColor = false
			if stroke then
				stroke.Color = C.Line
			end
			continue
		end

		local targetLevel = current + 1
		local cost = Config.GetUpgradeCost(component, targetLevel)
		local affordable = banked &gt;= cost and not busy

		row.Level.Text = ("STUFE %d  -&gt;  %d"):format(current, targetLevel)
		row.Effect.Text = ("%s   -&gt;   %s"):format(
			Config.GetRigEffect(component, current),
			Config.GetRigEffect(component, targetLevel)
		)
		row.Price.Text = ("%d CRY"):format(cost)
		row.Price.TextColor3 = if affordable then C.Text else C.TextDim
		row.Button.BackgroundColor3 = if affordable then C.PanelLight else C.Panel
		if stroke then
			stroke.Color = if affordable then C.Cyan else C.Line
		end
	end
end

local function flashRow(component: string, color: Color3, text: string)
	local row = rows[component]
	if not row then
		return
	end
	local original = row.Price.Text
	row.Price.Text = text
	row.Price.TextColor3 = color
	UITheme.Flash(row.Frame, color)
	task.delay(1.2, function()
		if row.Price.Text == text then
			row.Price.Text = original
		end
		refresh()
	end)
end

--==========================================================================
-- Kaufen
--==========================================================================

buy = function(component: string)
	if busy then
		return
	end
	local current = (rig :: any)[component] or 1
	if current &gt;= Config.Rig.MaxLevel then
		return
	end

	busy = true
	refresh()

	task.spawn(function()
		local ok, response = pcall(function()
			return Remotes.ShopPurchase:InvokeServer({ Component = component })
		end)

		busy = false

		if not ok or typeof(response) ~= "table" then
			flashRow(component, C.Magenta, "FEHLER")
			refresh()
			return
		end

		if response.Ok then
			-- Der Server schickt die neuen Werte mit; wir raten nichts.
			if typeof(response.Snapshot) == "table" then
				banked = response.Snapshot.Banked or banked
				if typeof(response.Snapshot.Rig) == "table" then
					rig = response.Snapshot.Rig
				end
			end
			flashRow(component, C.Green, "EINGEBAUT")
			return
		end

		local reasons: { [string]: string } = {
			FUNDS = "ZU TEUER",
			MAX = "MAXIMUM",
			LOADING = "LAEDT NOCH",
			RATE = "ZU SCHNELL",
			BAD_PAYLOAD = "UNGUELTIG",
			INTERNAL = "FEHLER",
		}
		flashRow(component, C.Amber, reasons[response.Reason] or "ABGELEHNT")
	end)
end

--==========================================================================
-- Oeffnen / Schliessen
--==========================================================================

local function setOpen(open: boolean)
	if open and hackOpen then
		return -- waehrend eines Hacks kein zweites Fenster
	end
	backdrop.Visible = open
	openButton.Visible = not open

	if open then
		refresh()
		backdrop.BackgroundTransparency = 1
		window.Size = UDim2.new(0.9, 0, 0.3, 0)
		TweenService:Create(backdrop, UITheme.Tween.Normal, { BackgroundTransparency = 0.4 }):Play()
		TweenService:Create(window, UITheme.Tween.Slow, { Size = UDim2.new(0.9, 0, 0.8, 0) }):Play()
	end
end

openButton.Activated:Connect(function()
	setOpen(true)
end)
closeButton.Activated:Connect(function()
	setOpen(false)
end)

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.KeyCode == Enum.KeyCode.B then
		setOpen(not backdrop.Visible)
	elseif input.KeyCode == Enum.KeyCode.Escape and backdrop.Visible then
		setOpen(false)
	end
end)

--==========================================================================
-- Server-Meldungen
--==========================================================================

Remotes.EconomySync.OnClientEvent:Connect(function(snapshot: any)
	if typeof(snapshot) ~= "table" then
		return
	end
	banked = snapshot.Banked or 0
	if typeof(snapshot.Rig) == "table" then
		rig = snapshot.Rig
	end
	refresh()
end)

-- Nach dem ersten Verkauf im Tutorial oeffnet sich der Shop genau EINMAL von
-- selbst. Ausgeloest wird das durch den Abschluss der Tutorial-Mission, also
-- durch eine Handlung des Spielers - nie durch einen Timer.
local TUTORIAL_MISSION = "M01_FIRSTHACK"
local tutorialWasDone: boolean? = nil

Remotes.MissionSync.OnClientEvent:Connect(function(data: any)
	if typeof(data) ~= "table" or typeof(data.Completed) ~= "table" then
		return
	end

	local done = false
	for _, id in data.Completed do
		if id == TUTORIAL_MISSION then
			done = true
			break
		end
	end

	-- Beim ersten Paket nach dem Join nur merken, nicht aufmachen: sonst
	-- springt der Shop bei jedem Rejoin wieder auf.
	if tutorialWasDone == nil then
		tutorialWasDone = done
		return
	end

	if done and not tutorialWasDone then
		tutorialWasDone = true
		task.wait(1.2) -- die Abschluss-Meldung erst lesen lassen
		setOpen(true)
	end
end)

-- Waehrend eines Hacks ist der Shop tabu, sonst klickt man sich aus dem
-- laufenden Raetsel heraus.
Remotes.HackSessionStarted.OnClientEvent:Connect(function()
	hackOpen = true
	setOpen(false)
	openButton.Visible = false
end)

Remotes.HackResolved.OnClientEvent:Connect(function()
	hackOpen = false
	openButton.Visible = not backdrop.Visible
end)

refresh()
</ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="GN56">
<Properties>
<string name="Name">SoundController</string>
<ProtectedString name="Source">-- StarterPlayer/StarterPlayerScripts/UI/SoundController.client.luau
--!strict
-- GHOSTNET :: Spielt die Klaenge aus dem SoundCatalog.
--
-- Der Controller kennt keine einzige Asset-Id. Er fragt den SoundCatalog,
-- und wenn dort noch nichts eingetragen ist, passiert schlicht nichts -
-- das Spiel bleibt lauffaehig, es klingt nur nach nichts.
--
-- Zwei Dinge machen hier den Unterschied:
--   1. Die Tonhoehe der Knoten-Klicks steigt mit der Pfadlaenge. Aus
--      Klickgeraeuschen wird eine aufsteigende Melodie, und ein geloestes
--      Raetsel klingt nach Erfolg.
--   2. Die Ambience wird waehrend eines Hacks leiser, damit die UI-Sounds
--      tragen - und kommt beim Alarm schlagartig laut zurueck.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local SoundCatalog = require(ReplicatedStorage.Shared.SoundCatalog)

local player = Players.LocalPlayer
local S = SoundCatalog.Settings

--==========================================================================
-- Abspielen
--==========================================================================

local holder = Instance.new("Folder")
holder.Name = "GhostNetSounds"
holder.Parent = SoundService

-- Ein Sound pro Aufruf. Bei leerer Id passiert nichts.
local function play(group: string, key: string, volume: number?, pitch: number?): Sound?
	local id = SoundCatalog.Get(group, key)
	if not id then
		return nil
	end

	local sound = Instance.new("Sound")
	sound.SoundId = id
	sound.Volume = volume or S.UIVolume
	sound.PlaybackSpeed = pitch or 1
	sound.Parent = holder
	sound:Play()
	sound.Ended:Once(function()
		sound:Destroy()
	end)
	-- Notbremse, falls Ended bei einer kaputten Id nie feuert.
	task.delay(12, function()
		if sound.Parent then
			sound:Destroy()
		end
	end)
	return sound
end

--== Dauerklaenge ==========================================================

local ambience: Sound? = nil

local function startAmbience()
	local id = SoundCatalog.Get("World", "Ambience")
	if not id then
		return
	end
	local sound = Instance.new("Sound")
	sound.Name = "Ambience"
	sound.SoundId = id
	sound.Looped = true
	sound.Volume = S.AmbienceVolume
	sound.Parent = holder
	sound:Play()
	ambience = sound
end

local function setAmbienceFactor(factor: number)
	local sound = ambience
	if not sound then
		return
	end
	TweenService:Create(sound, TweenInfo.new(S.AmbienceDuckTime), {
		Volume = S.AmbienceVolume * factor,
	}):Play()
end

local criticalLoop: Sound? = nil

local function setCriticalLoop(on: boolean)
	if on and not criticalLoop then
		local id = SoundCatalog.Get("Trace", "Critical")
		if not id then
			return
		end
		local sound = Instance.new("Sound")
		sound.Name = "TraceCritical"
		sound.SoundId = id
		sound.Looped = true
		sound.Volume = S.UIVolume
		sound.Parent = holder
		sound:Play()
		criticalLoop = sound
	elseif not on and criticalLoop then
		criticalLoop:Destroy()
		criticalLoop = nil
	end
end

--==========================================================================
-- Hack: Melodie und Countdown
--==========================================================================

local hack = {
	Open = false,
	PathLength = 0,
	Deadline = 0,
	NextTick = 0,
}

local function nodePitch(): number
	local steps = math.clamp(hack.PathLength, 0, S.MaxSemitones)
	return S.SemitoneRatio ^ steps
end

Remotes.HackSessionStarted.OnClientEvent:Connect(function(data: any)
	hack.Open = true
	hack.PathLength = 0
	hack.Deadline = if typeof(data) == "table" then (tonumber(data.Deadline) or 0) else 0
	hack.NextTick = 0

	play("UI", "HackStart")
	setAmbienceFactor(S.AmbienceDuckFactor)
end)

Remotes.HackFeedback.OnClientEvent:Connect(function(data: any)
	if typeof(data) ~= "table" then
		return
	end

	if data.Reason == "MASKED_ICE" then
		hack.PathLength = 0 -- die Melodie faengt von vorn an
		play("UI", "IceHit", S.UIVolume * 1.2)
		return
	end

	if data.Ok == true then
		local feedback = data.Feedback
		if typeof(feedback) == "table" and typeof(feedback.Path) == "table" then
			hack.PathLength = math.max(0, #feedback.Path - 1)
		else
			hack.PathLength += 1
		end
		play("UI", "NodeSelect", S.UIVolume, nodePitch())
	else
		play("UI", "NodeInvalid", S.UIVolume * 0.8)
	end
end)

Remotes.HackResolved.OnClientEvent:Connect(function(data: any)
	hack.Open = false
	setAmbienceFactor(1)

	if typeof(data) ~= "table" then
		return
	end
	if data.Success == true then
		play("UI", "HackSuccess", S.UIVolume * 1.1)
	else
		play("UI", "HackFail", S.UIVolume)
	end
end)

--==========================================================================
-- Trace
--==========================================================================

local traceState = "RUHIG"

Remotes.TraceSync.OnClientEvent:Connect(function(data: any)
	if typeof(data) ~= "table" then
		return
	end

	if typeof(data.Bust) == "table" then
		play("Trace", "Bust", S.UIVolume * 1.3)
		setCriticalLoop(false)
		traceState = "RUHIG"
		return
	end

	local value = tonumber(data.Trace) or 0
	local next_ = if value &gt;= Config.Trace.CriticalAt
		then "KRITISCH"
		elseif value &gt;= Config.Trace.WarnAt then "WARNUNG"
		else "RUHIG"

	if next_ ~= traceState then
		if next_ == "WARNUNG" then
			play("Trace", "Warn")
			setCriticalLoop(false)
		elseif next_ == "KRITISCH" then
			setCriticalLoop(true)
		else
			setCriticalLoop(false)
		end
		traceState = next_
	end
end)

--==========================================================================
-- Welt, Markt, Alarm
--==========================================================================

local EFFECT_SOUND: { [string]: string } = {
	CameraOffline = "CameraDown",
	DoorOpen = "DoorOpen",
	AtmPayout = "SafeOpen",
}

Remotes.HackResolved.OnClientEvent:Connect(function(data: any)
	if typeof(data) ~= "table" or data.Success ~= true then
		return
	end
	local key = EFFECT_SOUND[tostring(data.Effect)]
	if key then
		play("World", key, S.WorldVolume)
	end
end)

Remotes.SellResult.OnClientEvent:Connect(function(data: any)
	if typeof(data) == "table" and data.Ok == true then
		play("Market", "Sell", S.WorldVolume)
	end
end)

Remotes.EconomySync.OnClientEvent:Connect(function() end) -- bewusst still

Remotes.MarketEvent.OnClientEvent:Connect(function()
	play("Market", "PriceAlert")
end)

Remotes.InventorySync.OnClientEvent:Connect(function() end) -- bewusst still

local alarmActive = false

Remotes.AlarmSync.OnClientEvent:Connect(function(data: any)
	if typeof(data) ~= "table" then
		return
	end
	if data.Active == true then
		if not alarmActive then
			alarmActive = true
			play("World", "Alarm", S.WorldVolume)
			-- Beim Alarm kommt die Ambience schlagartig laut zurueck.
			setAmbienceFactor(S.AmbienceAlarmFactor)
		end
	else
		alarmActive = false
		setAmbienceFactor(if hack.Open then S.AmbienceDuckFactor else 1)
	end
end)

--==========================================================================
-- Countdown: Frequenz steigt zum Ende hin
--==========================================================================

RunService.RenderStepped:Connect(function()
	if not hack.Open or hack.Deadline &lt;= 0 then
		return
	end

	local remaining = hack.Deadline - workspace:GetServerTimeNow()
	if remaining &lt;= 0 or remaining &gt; S.CountdownFrom then
		return
	end

	local now = os.clock()
	if now &lt; hack.NextTick then
		return
	end

	-- Je weniger Zeit, desto kuerzer der Abstand zwischen den Ticks.
	local fraction = math.clamp(remaining / S.CountdownFrom, 0, 1)
	local interval = S.CountdownMinInterval + (S.CountdownMaxInterval - S.CountdownMinInterval) * fraction
	hack.NextTick = now + interval

	play("UI", "Countdown", S.UIVolume * 0.8, 1 + (1 - fraction) * 0.3)
end)

--==========================================================================

startAmbience()

local filled, total = SoundCatalog.Count()
if filled == 0 then
	warn(("[GHOSTNET] Keine Sound-IDs eingetragen (0 von %d). Das Spiel laeuft, ist aber stumm."):format(total))
else
	print(("[GHOSTNET] SoundController bereit. %d von %d IDs eingetragen."):format(filled, total))
end

local _ = player
</ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="GN57">
<Properties>
<string name="Name">StoreUI</string>
<ProtectedString name="Source">-- StarterPlayer/StarterPlayerScripts/UI/StoreUI.client.luau
--!strict
-- GHOSTNET :: Robux-Store, Taste [P].
--
-- Zeigt nur an, was der Server geschickt hat. Der Kauf selbst laeuft ueber
-- Roblox; was er bewirkt, entscheidet ProcessReceipt auf dem Server.
--
-- Solange Noah keine IDs im Creator Dashboard eingetragen hat, ist hier
-- nichts kaufbar - die Eintraege stehen dann als "noch nicht verfuegbar" da,
-- statt still zu fehlen.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Remotes = require(ReplicatedStorage.Shared.Remotes)
local UITheme = require(ReplicatedStorage.Shared.UITheme)

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local C = UITheme.Color

local store = { Passes = {}, Products = {} }
local hackOpen = false

--==========================================================================
-- Aufbau
--==========================================================================

local gui = UITheme.Screen("GhostNetStore", 17)
gui.Parent = playerGui

local openButton = UITheme.Button({
	Name = "OpenStore",
	AnchorPoint = Vector2.new(0, 1),
	Position = UDim2.new(0, 176, 1, -46),
	Size = UDim2.fromOffset(120, 46),
	BackgroundColor3 = C.Panel,
	BackgroundTransparency = 0.06,
	Text = "",
	Parent = gui,
})
UITheme.Corner(openButton, 4)
UITheme.Stroke(openButton, C.Amber)

UITheme.Label({
	Name = "Caption",
	Text = "[P]  STORE",
	TextColor3 = C.Amber,
	TextSize = 14,
	TextXAlignment = Enum.TextXAlignment.Center,
	Size = UDim2.fromScale(1, 1),
	Parent = openButton,
})

local backdrop = UITheme.Frame({
	Name = "Backdrop",
	Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = Color3.new(0, 0, 0),
	BackgroundTransparency = 1,
	Visible = false,
	Parent = gui,
})

local window = UITheme.Frame({
	Name = "Window",
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.new(0.9, 0, 0.85, 0),
	BackgroundColor3 = C.Background,
	ClipsDescendants = true,
	Parent = backdrop,
})
UITheme.Corner(window, 5)
UITheme.Stroke(window, C.Amber)

local sizeConstraint = Instance.new("UISizeConstraint")
sizeConstraint.MaxSize = Vector2.new(640, 520)
sizeConstraint.MinSize = Vector2.new(300, 300)
sizeConstraint.Parent = window

local titleBar = UITheme.Frame({
	Name = "TitleBar",
	Size = UDim2.new(1, 0, 0, 34),
	BackgroundColor3 = C.Panel,
	Parent = window,
})

UITheme.Label({
	Name = "Title",
	Text = "GHOSTNET // STORE",
	TextColor3 = C.Amber,
	TextSize = 14,
	Position = UDim2.new(0, 12, 0, 0),
	Size = UDim2.new(0.6, 0, 1, 0),
	Parent = titleBar,
})

local closeButton = UITheme.Button({
	Name = "Close",
	Text = "SCHLIESSEN",
	TextSize = 11,
	TextColor3 = C.Magenta,
	BackgroundColor3 = C.PanelLight,
	AnchorPoint = Vector2.new(1, 0.5),
	Position = UDim2.new(1, -8, 0.5, 0),
	Size = UDim2.fromOffset(88, 24),
	Parent = titleBar,
})
UITheme.Corner(closeButton, 3)
UITheme.Stroke(closeButton, C.Magenta)

UITheme.Label({
	Name = "Fairness",
	Text = "Nichts hier loest ein Raetsel fuer dich. Zeit, Platz und Aussehen - mehr nicht.",
	TextColor3 = C.TextDim,
	TextSize = 12,
	TextWrapped = true,
	Position = UDim2.new(0, 14, 0, 40),
	Size = UDim2.new(1, -28, 0, 30),
	Parent = window,
})

local list = Instance.new("ScrollingFrame")
list.Name = "List"
list.BackgroundTransparency = 1
list.BorderSizePixel = 0
list.Position = UDim2.new(0, 14, 0, 74)
list.Size = UDim2.new(1, -28, 1, -88)
list.CanvasSize = UDim2.new()
list.AutomaticCanvasSize = Enum.AutomaticSize.Y
list.ScrollBarThickness = 4
list.ScrollBarImageColor3 = C.Line
list.Parent = window

local listLayout = Instance.new("UIListLayout")
listLayout.SortOrder = Enum.SortOrder.LayoutOrder
listLayout.Padding = UDim.new(0, 8)
listLayout.Parent = list

--==========================================================================
-- Anzeige
--==========================================================================

local order = 0

local function clearList()
	order = 0
	for _, child in list:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

local function header(text: string)
	order += 1
	UITheme.Label({
		Name = "H",
		Text = text,
		TextColor3 = C.TextDim,
		TextSize = 11,
		Size = UDim2.new(1, -8, 0, 16),
		LayoutOrder = order,
		Parent = list,
	})
end

local function entry(kind: string, item: { [string]: any })
	order += 1
	local frame = UITheme.Frame({
		Name = tostring(item.Key),
		Size = UDim2.new(1, -8, 0, 68),
		BackgroundColor3 = C.Panel,
		LayoutOrder = order,
		Parent = list,
	})
	UITheme.Corner(frame, 4)
	UITheme.Stroke(frame, C.Line)
	UITheme.Padding(frame, 10)

	UITheme.Label({
		Name = "Name",
		Text = tostring(item.Name),
		TextColor3 = C.Amber,
		TextSize = 15,
		Size = UDim2.new(1, -150, 0, 18),
		Parent = frame,
	})

	UITheme.Label({
		Name = "Text",
		Text = tostring(item.Text),
		TextColor3 = C.TextDim,
		TextSize = 12,
		TextWrapped = true,
		Position = UDim2.new(0, 0, 0, 20),
		Size = UDim2.new(1, -150, 0, 28),
		Parent = frame,
	})

	local button = UITheme.Button({
		Name = "Buy",
		Text = "",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(132, 44), -- Touch-Ziel
		BackgroundColor3 = C.PanelLight,
		Parent = frame,
	})
	UITheme.Corner(button, 4)
	local stroke = UITheme.Stroke(button, C.Line)

	local caption = UITheme.Label({
		Name = "Caption",
		Text = "",
		TextColor3 = C.TextDim,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 1),
		Parent = button,
	})

	if item.Owned == true then
		caption.Text = "GEHOERT DIR"
		caption.TextColor3 = C.Green
		stroke.Color = C.Green
	elseif item.Available ~= true then
		-- Ehrlich anzeigen statt still nichts tun: so sieht Noah sofort,
		-- welche ID im Dashboard noch fehlt.
		caption.Text = "NOCH NICHT DA"
		caption.TextColor3 = C.TextDim
	else
		caption.Text = "KAUFEN"
		caption.TextColor3 = C.Amber
		stroke.Color = C.Amber
		button.Activated:Connect(function()
			Remotes.StorePrompt:FireServer({ Kind = kind, Key = item.Key })
		end)
	end
end

local function refresh()
	clearList()
	header("DAUERHAFT (GAMEPASS)")
	for _, item in store.Passes do
		entry("Gamepass", item)
	end
	header("EINMALIG")
	for _, item in store.Products do
		entry("Product", item)
	end
end

--==========================================================================
-- Oeffnen
--==========================================================================

local function setOpen(open: boolean)
	if open and hackOpen then
		return
	end
	backdrop.Visible = open
	openButton.Visible = not open and not hackOpen
	if open then
		refresh()
		backdrop.BackgroundTransparency = 1
		window.Size = UDim2.new(0.9, 0, 0.3, 0)
		TweenService:Create(backdrop, UITheme.Tween.Normal, { BackgroundTransparency = 0.45 }):Play()
		TweenService:Create(window, UITheme.Tween.Slow, { Size = UDim2.new(0.9, 0, 0.85, 0) }):Play()
	end
end

openButton.Activated:Connect(function()
	setOpen(true)
end)
closeButton.Activated:Connect(function()
	setOpen(false)
end)

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.KeyCode == Enum.KeyCode.P then
		setOpen(not backdrop.Visible)
	elseif input.KeyCode == Enum.KeyCode.Escape and backdrop.Visible then
		setOpen(false)
	end
end)

--==========================================================================
-- Server-Meldungen
--==========================================================================

Remotes.StoreSync.OnClientEvent:Connect(function(data: any)
	if typeof(data) ~= "table" then
		return
	end
	store.Passes = if typeof(data.Passes) == "table" then data.Passes else {}
	store.Products = if typeof(data.Products) == "table" then data.Products else {}
	if backdrop.Visible then
		refresh()
	end
end)

Remotes.HackSessionStarted.OnClientEvent:Connect(function()
	hackOpen = true
	setOpen(false)
	openButton.Visible = false
end)

Remotes.HackResolved.OnClientEvent:Connect(function()
	hackOpen = false
	openButton.Visible = not backdrop.Visible
end)

refresh()
</ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="GN58">
<Properties>
<string name="Name">TargetBeacons</string>
<ProtectedString name="Source">-- StarterPlayer/StarterPlayerScripts/UI/TargetBeacons.client.luau
--!strict
-- GHOSTNET :: Hack-Ziele auf Distanz erkennbar machen.
--
-- Ohne das laeuft man an einem Ziel vorbei, ohne zu merken, dass es eins ist -
-- die Objekte sehen aus wie Kulisse, weil sie welche sind. Ein dezent
-- pulsierendes Akzentlicht loest das, ohne die Ruhe des Spiels zu zerstoeren.
--
-- Laeuft rein clientseitig auf vorhandenen Lichtern. Es werden keine neuen
-- Instanzen erzeugt und nichts an der Welt veraendert, was der Server sieht.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)

type Beacon = {
	Part: BasePart,
	Light: PointLight,
	BaseBrightness: number,
	Phase: number,
}

local beacons: { [BasePart]: Beacon } = {}
local nextPhase = 0

local function track(inst: Instance)
	if not inst:IsA("BasePart") then
		return
	end
	local part = inst :: BasePart
	if beacons[part] then
		return
	end
	local light = part:FindFirstChildOfClass("PointLight")
	if not light then
		return -- kein Akzentlicht, also nichts zu pulsieren
	end

	-- Versetzte Phase, damit nicht die halbe Stadt im Gleichtakt blinkt.
	nextPhase += 1.7
	beacons[part] = {
		Part = part,
		Light = light,
		BaseBrightness = light.Brightness,
		Phase = nextPhase,
	}
end

local function untrack(inst: Instance)
	if inst:IsA("BasePart") then
		beacons[inst :: BasePart] = nil
	end
end

for _, inst in CollectionService:GetTagged(Config.HackableTag) do
	track(inst)
end
CollectionService:GetInstanceAddedSignal(Config.HackableTag):Connect(track)
CollectionService:GetInstanceRemovedSignal(Config.HackableTag):Connect(untrack)

-- Hehler bekommen denselben Effekt, damit man den Rueckweg findet.
for _, inst in CollectionService:GetTagged(Config.FenceTag) do
	track(inst)
end
CollectionService:GetInstanceAddedSignal(Config.FenceTag):Connect(track)
CollectionService:GetInstanceRemovedSignal(Config.FenceTag):Connect(untrack)

local accumulator = 0
RunService.RenderStepped:Connect(function(dt)
	accumulator += dt
	if accumulator &lt; 0.06 then
		return
	end
	accumulator = 0

	local now = os.clock()
	for part, beacon in beacons do
		if not part.Parent then
			beacons[part] = nil
			continue
		end

		-- Offline heisst dunkel. Das ist die einzige Rueckmeldung, die man
		-- aus der Ferne braucht.
		if part:GetAttribute("Offline") == true then
			beacon.Light.Enabled = false
			continue
		end

		beacon.Light.Enabled = true
		local pulse = 0.5 + 0.5 * math.sin(now * Config.World.TargetPulseSpeed + beacon.Phase)
		beacon.Light.Brightness = beacon.BaseBrightness * (1 - Config.World.TargetPulseDepth + Config.World.TargetPulseDepth * pulse * 2)
	end
end)
</ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="GN59">
<Properties>
<string name="Name">TutorialUI</string>
<ProtectedString name="Source">-- StarterPlayer/StarterPlayerScripts/UI/TutorialUI.client.luau
--!strict
-- GHOSTNET :: Der gefuehrte Einstieg - und der Alarm.
--
-- HARTE REGELN FUERS TUTORIAL (aus dem Bauplan, nicht verhandelbar)
--   * Jeder Schritt wird durch eine HANDLUNG ausgeloest, nie durch einen Timer.
--   * Nie zwei Hinweise gleichzeitig sichtbar.
--   * Alles ueberspringbar. Der Zustand liegt im Profil, nicht hier.
--   * Nach Abschluss greift kein einziges Tutorial-Element je wieder.
--
-- Welcher Schritt dran ist, weiss ausschliesslich der Server. Dieses Skript
-- liest nur MissionSync mit und uebersetzt es in einen Satz auf dem Schirm.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local UITheme = require(ReplicatedStorage.Shared.UITheme)

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local C = UITheme.Color

local TUTORIAL_MISSION = "M01_FIRSTHACK"

--==========================================================================
-- Zustand
--==========================================================================

local activeMission = ""
local stepIndex = 0
local tutorialDone = false
local currentHint = ""

--==========================================================================
-- Aufbau
--==========================================================================

local gui = UITheme.Screen("GhostNetTutorial", 18)
gui.Parent = playerGui

--== Der eine Hinweis =======================================================
-- Bewusst genau EIN Feld. Zwei Hinweise gleichzeitig gibt es damit nicht,
-- weil der zweite den ersten ueberschreibt.

local hint = UITheme.Frame({
	Name = "Hint",
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 24),
	Size = UDim2.fromOffset(460, 58),
	BackgroundColor3 = C.Panel,
	BackgroundTransparency = 0.05,
	Visible = false,
	Parent = gui,
})
UITheme.Corner(hint, 4)
UITheme.Stroke(hint, C.Cyan)
UITheme.Padding(hint, 12)

local hintText = UITheme.Label({
	Name = "Text",
	Text = "",
	TextColor3 = C.Text,
	TextSize = 16,
	TextWrapped = true,
	TextXAlignment = Enum.TextXAlignment.Center,
	Size = UDim2.new(1, -70, 1, 0),
	Parent = hint,
})

local skipButton = UITheme.Button({
	Name = "Skip",
	Text = "UEBERSPRINGEN",
	TextSize = 10,
	TextColor3 = C.TextDim,
	BackgroundColor3 = C.PanelLight,
	AnchorPoint = Vector2.new(1, 0.5),
	Position = UDim2.new(1, 0, 0.5, 0),
	Size = UDim2.fromOffset(64, 44), -- Touch-Ziel
	Parent = hint,
})
UITheme.Corner(skipButton, 3)
UITheme.Stroke(skipButton, C.Line)

skipButton.Activated:Connect(function()
	Remotes.MissionSkip:FireServer({})
end)

local function showHint(text: string)
	if text == currentHint then
		return
	end
	currentHint = text

	if text == "" then
		hint.Visible = false
		return
	end

	hintText.Text = text
	if not hint.Visible then
		hint.Visible = true
		hint.Size = UDim2.fromOffset(460, 20)
		TweenService:Create(hint, UITheme.Tween.Slow, { Size = UDim2.fromOffset(460, 58) }):Play()
	else
		UITheme.Flash(hint, C.CyanDim)
	end
end

--== Einmalige Hervorhebung des Trace-Balkens ==============================

local traceCallout = UITheme.Frame({
	Name = "TraceCallout",
	AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.new(1, -18, 0, 150),
	Size = UDim2.fromOffset(240, 62),
	BackgroundColor3 = C.Panel,
	BackgroundTransparency = 0.05,
	Visible = false,
	Parent = gui,
})
UITheme.Corner(traceCallout, 4)
UITheme.Stroke(traceCallout, C.Magenta)
UITheme.Padding(traceCallout, 10)

UITheme.Label({
	Name = "Text",
	Text = "Das da oben ist deine Spur.\nBei 100 verlierst du alles,\nwas du noch nicht verkauft hast.",
	TextColor3 = C.Text,
	TextSize = 12,
	TextWrapped = true,
	Size = UDim2.fromScale(1, 1),
	Parent = traceCallout,
})

local traceCalloutShown = false

local function showTraceCallout()
	if traceCalloutShown or tutorialDone then
		return
	end
	traceCalloutShown = true
	traceCallout.Visible = true
	traceCallout.BackgroundTransparency = 1
	TweenService:Create(traceCallout, UITheme.Tween.Slow, { BackgroundTransparency = 0.05 }):Play()

	task.delay(7, function()
		TweenService:Create(traceCallout, UITheme.Tween.Slow, { BackgroundTransparency = 1 }):Play()
		task.wait(0.5)
		traceCallout.Visible = false
	end)
end

--==========================================================================
-- Alarm-Anzeige (gehoert nicht zum Tutorial, aber in dieselbe Ebene:
-- es ist der zweite Fall, in dem der Spieler SOFORT etwas verstehen muss)
--==========================================================================

local alarmPanel = UITheme.Frame({
	Name = "Alarm",
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 96),
	Size = UDim2.fromOffset(360, 52),
	BackgroundColor3 = C.Panel,
	BackgroundTransparency = 0.05,
	Visible = false,
	Parent = gui,
})
UITheme.Corner(alarmPanel, 4)
local alarmStroke = UITheme.Stroke(alarmPanel, C.Amber)
UITheme.Padding(alarmPanel, 10)

local alarmLabel = UITheme.Label({
	Name = "Text",
	Text = "",
	TextColor3 = C.Amber,
	TextSize = 14,
	Size = UDim2.new(1, 0, 0, 16),
	Parent = alarmPanel,
})

local alarmTrack = UITheme.Frame({
	Name = "Track",
	Position = UDim2.new(0, 0, 0, 20),
	Size = UDim2.new(1, 0, 0, 10),
	BackgroundColor3 = C.PanelLight,
	Parent = alarmPanel,
})
UITheme.Corner(alarmTrack, 3)

local alarmFill = UITheme.Frame({
	Name = "Fill",
	Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = C.Amber,
	Parent = alarmTrack,
})
UITheme.Corner(alarmFill, 3)

local alarm = { Active = false, Remaining = 0, Total = 1, Warn = false, Coop = false }

Remotes.AlarmSync.OnClientEvent:Connect(function(data: any)
	if typeof(data) ~= "table" then
		return
	end

	if data.Active ~= true then
		alarm.Active = false
		alarmPanel.Visible = false
		if data.Triggered == true then
			-- Die Uhr ist durchgelaufen. Der Spieler muss wissen, was das
			-- gekostet hat, sonst wirkt der Trace-Sprung wie ein Bug.
			showHint(("ALARM! Der Laden hat die Polizei gerufen. Trace +%d."):format(
				math.floor(tonumber(data.TracePenalty) or 0)
			))
			task.delay(5, function()
				if currentHint:sub(1, 6) == "ALARM!" then
					showHint("")
				end
			end)
		end
		return
	end

	alarm.Active = true
	alarm.Remaining = tonumber(data.Remaining) or 0
	alarm.Total = math.max(1, tonumber(data.Total) or 1)
	alarm.Warn = alarm.Remaining &lt;= (tonumber(data.WarnAt) or Config.Raid.AlarmWarnAt)
	alarm.Coop = data.Coop == true

	alarmPanel.Visible = true
	alarmLabel.Text = ("ALARM // %s%s"):format(
		if typeof(data.Label) == "string" then data.Label else "",
		if alarm.Coop then "   [PARTNER: halbes Tempo]" else ""
	)
end)

--==========================================================================
-- Tutorial-Ablauf
-- Jeder Zustand haengt an einer Handlung, die der Server bestaetigt hat.
--==========================================================================

local function refreshTutorial()
	if tutorialDone or activeMission ~= TUTORIAL_MISSION then
		showHint("")
		return
	end

	if stepIndex == 1 then
		showHint("Geh zum leuchtenden Terminal und druecke [E].")
	elseif stepIndex == 2 then
		showHint("Geknackt. Die Beute ist noch heiss - bring sie zum Hehler hinter dem Spawn.")
	else
		showHint("")
	end
end

Remotes.MissionSync.OnClientEvent:Connect(function(data: any)
	if typeof(data) ~= "table" then
		return
	end

	activeMission = if typeof(data.Active) == "string" then data.Active else ""
	stepIndex = tonumber(data.StepIndex) or 0

	if typeof(data.Completed) == "table" then
		for _, id in data.Completed do
			if id == TUTORIAL_MISSION then
				tutorialDone = true
			end
		end
	end

	if tutorialDone then
		-- Ab hier greift nie wieder ein Tutorial-Element.
		showHint("")
		hint.Visible = false
		traceCallout.Visible = false
		return
	end

	refreshTutorial()
end)

-- Der erste erfolgreiche Hack ist die Handlung, die den Trace erklaert.
Remotes.HackResolved.OnClientEvent:Connect(function(data: any)
	if tutorialDone or typeof(data) ~= "table" or data.Success ~= true then
		return
	end
	if activeMission == TUTORIAL_MISSION then
		showTraceCallout()
	end
end)

--==========================================================================
-- Schleife: nur der Alarm-Balken muss jeden Frame stimmen
--==========================================================================

RunService.RenderStepped:Connect(function(dt)
	if not alarm.Active then
		return
	end

	-- Lokal weiterzaehlen, damit der Balken fluessig laeuft; der Server
	-- korrigiert alle halbe Sekunde.
	alarm.Remaining = math.max(0, alarm.Remaining - dt)
	local fraction = math.clamp(alarm.Remaining / alarm.Total, 0, 1)
	alarmFill.Size = UDim2.fromScale(fraction, 1)

	local warn = alarm.Remaining &lt;= Config.Raid.AlarmWarnAt
	if warn then
		local pulse = 0.5 + 0.5 * math.sin(os.clock() * 14)
		alarmFill.BackgroundColor3 = C.Magenta:Lerp(C.Amber, pulse)
		alarmStroke.Color = C.Magenta
		alarmStroke.Thickness = 1 + pulse * 1.5
	else
		alarmFill.BackgroundColor3 = C.Amber
		alarmStroke.Color = C.Amber
		alarmStroke.Thickness = 1
	end

	alarmLabel.Text = ("ALARM // noch %ds%s"):format(
		math.ceil(alarm.Remaining),
		if alarm.Coop then "   [PARTNER: halbes Tempo]" else ""
	)
end)
</ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="GN60">
<Properties>
<string name="Name">VehicleController</string>
<ProtectedString name="Source">-- StarterPlayer/StarterPlayerScripts/UI/VehicleController.client.luau
--!strict
-- GHOSTNET :: Fahren.
--
-- WARUM DIE STEUERUNG HIER LIEGT UND NICHT AUF DEM SERVER
--   Beim Einsteigen gibt der Server dem Client den Netzwerkbesitz ueber das
--   Fahrzeug. Die Physik laeuft also lokal. Wuerde der Server die Motoren
--   stellen, braeuchte jeder Gasstoss eine Rundreise - das Auto fuehlt sich
--   dann an wie Sirup. Deshalb setzt der Fahrer seine Constraints selbst.
--
--   Das ist ausdruecklich in Ordnung, weil an Fahrzeugposition und -tempo
--   NICHTS haengt, was Geld oder Fortschritt bewegt. Ankommen wird ueber
--   serverseitige Trigger geprueft, nie ueber eine gemeldete Position.
--
-- DAS FAHRGEFUEHL
--   Ein Auto fuehlt sich nicht schnell an, weil eine Zahl hoch ist, sondern
--   weil die Kamera zurueckweicht, das Sichtfeld aufgeht, der Motor
--   hochdreht und die Reifen quietschen. Genau das steht unten.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local SoundCatalog = require(ReplicatedStorage.Shared.SoundCatalog)
local UITheme = require(ReplicatedStorage.Shared.UITheme)

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local camera = workspace.CurrentCamera

local C = UITheme.Color
local V = Config.Vehicle

--==========================================================================
-- Zustand
--==========================================================================

type Ride = {
	Model: Model,
	Body: BasePart,
	Seat: VehicleSeat,
	Drives: { CylindricalConstraint },
	Steers: { CylindricalConstraint },
	BrakeLights: { BasePart },
	MaxSpeed: number,
	Acceleration: number,
	BrakeForce: number,
	TurnAngle: number,
	WheelRadius: number,
	Steer: number,
	Engine: Sound?,
	Squeal: Sound?,
}

local ride: Ride? = nil
local skidMarks: { BasePart } = {}

--==========================================================================
-- Tacho
--==========================================================================

local gui = UITheme.Screen("GhostNetVehicle", 14)
gui.Enabled = false
gui.Parent = playerGui

local panel = UITheme.Frame({
	Name = "Speedo",
	AnchorPoint = Vector2.new(1, 1),
	Position = UDim2.new(1, -18, 1, -46),
	Size = UDim2.fromOffset(190, 76),
	BackgroundColor3 = C.Panel,
	BackgroundTransparency = 0.08,
	Parent = gui,
})
UITheme.Corner(panel, 4)
UITheme.Stroke(panel, C.CyanDim)
UITheme.Padding(panel, 10)

local nameLabel = UITheme.Label({
	Name = "Name",
	Text = "",
	TextColor3 = C.TextDim,
	TextSize = 11,
	Size = UDim2.new(1, 0, 0, 12),
	Parent = panel,
})

local speedLabel = UITheme.Label({
	Name = "Speed",
	Text = "0",
	TextColor3 = C.Cyan,
	TextSize = 26,
	Position = UDim2.new(0, 0, 0, 14),
	Size = UDim2.new(1, 0, 0, 28),
	Parent = panel,
})

local barTrack = UITheme.Frame({
	Name = "Track",
	Position = UDim2.new(0, 0, 1, -10),
	Size = UDim2.new(1, 0, 0, 6),
	BackgroundColor3 = C.PanelLight,
	Parent = panel,
})
UITheme.Corner(barTrack, 3)

local barFill = UITheme.Frame({
	Name = "Fill",
	Size = UDim2.fromScale(0, 1),
	BackgroundColor3 = C.Cyan,
	Parent = barTrack,
})
UITheme.Corner(barFill, 3)

local hintLabel = UITheme.Label({
	Name = "Hint",
	Text = "[W][S] Gas/Bremse   [A][D] Lenken",
	TextColor3 = C.TextDim,
	TextSize = 10,
	Position = UDim2.new(0, 0, 1, -22),
	Size = UDim2.new(1, 0, 0, 11),
	Parent = panel,
})

--==========================================================================
-- Klang
--==========================================================================

local function makeSound(parent: BasePart, group: string, key: string, volume: number, looped: boolean): Sound?
	local id = SoundCatalog.Get(group, key)
	if not id then
		return nil -- noch keine Id eingetragen: bleibt still, nichts geht kaputt
	end
	local sound = Instance.new("Sound")
	sound.SoundId = id
	sound.Volume = volume
	sound.Looped = looped
	sound.RollOffMaxDistance = 140
	sound.Parent = parent
	if looped then
		sound:Play()
	end
	return sound
end

--==========================================================================
-- Fahrzeug einsammeln
--==========================================================================

local function collect(seat: VehicleSeat): Ride?
	local model = seat.Parent
	if not model or not model:IsA("Model") then
		return nil
	end
	local body = model:FindFirstChild("Body")
	if not body or not body:IsA("BasePart") then
		return nil
	end

	local drives: { CylindricalConstraint } = {}
	local steers: { CylindricalConstraint } = {}
	local brakeLights: { BasePart } = {}

	for _, descendant in model:GetDescendants() do
		if descendant:IsA("CylindricalConstraint") then
			if descendant:GetAttribute("Driven") == true then
				table.insert(drives, descendant)
			elseif descendant:GetAttribute("Steered") ~= nil then
				table.insert(steers, descendant)
			end
		elseif descendant:IsA("BasePart") and descendant.Name == "BrakeLight" then
			table.insert(brakeLights, descendant)
		end
	end

	return {
		Model = model,
		Body = body,
		Seat = seat,
		Drives = drives,
		Steers = steers,
		BrakeLights = brakeLights,
		MaxSpeed = tonumber(model:GetAttribute("MaxSpeed")) or 60,
		Acceleration = tonumber(model:GetAttribute("Acceleration")) or 6000,
		BrakeForce = tonumber(model:GetAttribute("BrakeForce")) or 8000,
		TurnAngle = tonumber(model:GetAttribute("TurnAngle")) or 30,
		WheelRadius = tonumber(model:GetAttribute("WheelRadius")) or 1.5,
		Steer = 0,
		Engine = nil,
		Squeal = nil,
	}
end

--==========================================================================
-- Ein- und Aussteigen
--==========================================================================

local function stop()
	local current = ride
	if not current then
		return
	end
	ride = nil

	-- Motoren aus, sonst faehrt das leere Auto weiter.
	for _, drive in current.Drives do
		if drive.Parent then
			drive.MotorMaxTorque = 0
			drive.AngularVelocity = 0
		end
	end
	for _, steer in current.Steers do
		if steer.Parent then
			steer.TargetAngle = 0
		end
	end
	for _, light in current.BrakeLights do
		if light.Parent then
			light.Color = Color3.fromRGB(120, 20, 30)
		end
	end
	if current.Engine then
		current.Engine:Destroy()
	end
	if current.Squeal then
		current.Squeal:Destroy()
	end

	gui.Enabled = false
	TweenService:Create(camera, TweenInfo.new(0.4), { FieldOfView = V.CameraFovBase }):Play()
end

local function start(seat: VehicleSeat)
	stop()
	local collected = collect(seat)
	if not collected then
		return
	end

	-- Motor und Reifenquietschen. Solange im SoundCatalog nichts eingetragen
	-- ist, liefert makeSound nil und es bleibt einfach still.
	collected.Engine = makeSound(collected.Body, "Vehicle", "Engine", V.EngineVolume, true)
	collected.Squeal = makeSound(collected.Body, "Vehicle", "TyreSqueal", 0, true)

	ride = collected
	nameLabel.Text = tostring(collected.Model:GetAttribute("ClassId") or "FAHRZEUG")
	gui.Enabled = true
end

local function watchCharacter(character: Model)
	local humanoid = character:WaitForChild("Humanoid", 10)
	if not humanoid or not humanoid:IsA("Humanoid") then
		return
	end
	humanoid.Seated:Connect(function(active, seat)
		if active and seat and seat:IsA("VehicleSeat") then
			start(seat)
		else
			stop()
		end
	end)
	-- Tod im Auto: sauber aussteigen, sonst haengt die Kamera fest.
	humanoid.Died:Connect(stop)
end

if player.Character then
	task.spawn(watchCharacter, player.Character)
end
player.CharacterAdded:Connect(watchCharacter)

--==========================================================================
-- Bremsspuren
--==========================================================================

local function leaveSkid(position: Vector3, direction: Vector3)
	if #skidMarks &gt;= V.SkidMaxMarks then
		local oldest = table.remove(skidMarks, 1)
		if oldest then
			oldest:Destroy()
		end
	end

	local mark = Instance.new("Part")
	mark.Size = Vector3.new(0.6, 0.05, 2.4)
	mark.CFrame = CFrame.lookAt(position, position + direction) * CFrame.new(0, 0.03, 0)
	mark.Anchored = true
	mark.CanCollide = false
	mark.CanQuery = false
	mark.CanTouch = false
	mark.CastShadow = false
	mark.Color = Color3.fromRGB(12, 12, 14)
	mark.Material = Enum.Material.SmoothPlastic
	mark.Transparency = 0.3
	mark.Parent = workspace
	table.insert(skidMarks, mark)

	TweenService:Create(mark, TweenInfo.new(V.SkidLifetime), { Transparency = 1 }):Play()
	task.delay(V.SkidLifetime + 0.2, function()
		local index = table.find(skidMarks, mark)
		if index then
			table.remove(skidMarks, index)
		end
		mark:Destroy()
	end)
end

--==========================================================================
-- Der Fahr-Loop
--==========================================================================

RunService.RenderStepped:Connect(function(dt)
	local current = ride
	if not current then
		return
	end
	if not current.Model.Parent or not current.Body.Parent then
		stop()
		return
	end

	local seat = current.Seat
	local throttle = seat.Throttle -- -1 .. 1, liefert Roblox selbst
	local steerInput = seat.Steer -- -1 .. 1

	local velocity = current.Body.AssemblyLinearVelocity
	local speed = velocity.Magnitude
	local forward = current.Body.CFrame.LookVector
	local right = current.Body.CFrame.RightVector
	local forwardSpeed = velocity:Dot(forward)
	local sideSpeed = math.abs(velocity:Dot(right))

	--== Lenken ============================================================
	-- Bei Tempo weniger Einschlag: sonst ueberschlaegt sich jedes Auto beim
	-- ersten Vollausschlag auf der Geraden.
	local speedFactor = 1 - math.clamp(speed / current.MaxSpeed, 0, 1) * V.SteerSpeedFalloff
	local wanted = steerInput * current.TurnAngle * speedFactor
	current.Steer += (wanted - current.Steer) * math.clamp(dt * V.SteerSpeed, 0, 1)

	for _, steerConstraint in current.Steers do
		if steerConstraint.Parent and steerConstraint:GetAttribute("Steered") == true then
			steerConstraint.TargetAngle = current.Steer
		end
	end

	--== Gas und Bremse ====================================================
	local braking = (throttle &lt; -0.1 and forwardSpeed &gt; 1) or (throttle &gt; 0.1 and forwardSpeed &lt; -1)
	local targetAngular = 0
	local torque = 0

	if braking then
		targetAngular = 0
		torque = current.BrakeForce * V.BrakeTorqueScale
	elseif math.abs(throttle) &gt; 0.05 then
		-- Winkelgeschwindigkeit aus Wunschtempo und Radradius.
		targetAngular = (current.MaxSpeed / current.WheelRadius) * throttle
		torque = current.Acceleration * V.TorqueScale
	else
		-- Kein Gas: leichtes Motorbremsen, damit das Auto nicht ewig rollt.
		targetAngular = 0
		torque = current.Acceleration * 0.12
	end

	for _, drive in current.Drives do
		if drive.Parent then
			drive.MotorMaxTorque = torque
			drive.AngularVelocity = targetAngular
		end
	end

	--== Rueckleuchten =====================================================
	for _, light in current.BrakeLights do
		if light.Parent then
			light.Color = if braking then Color3.fromRGB(255, 60, 70) else Color3.fromRGB(120, 20, 30)
		end
	end

	--== Kamera ============================================================
	-- Ohne das fuehlt sich kein Auto schnell an, egal wie hoch die Zahl steht.
	local fraction = math.clamp(speed / current.MaxSpeed, 0, 1)
	local wantedFov = V.CameraFovBase + (V.CameraFovFast - V.CameraFovBase) * fraction
	camera.FieldOfView += (wantedFov - camera.FieldOfView) * math.clamp(dt / math.max(V.CameraFovLerp, 0.01), 0, 1)

	--== Klang =============================================================
	if current.Engine then
		local load = math.max(fraction, math.abs(throttle) * 0.35)
		current.Engine.PlaybackSpeed = V.EnginePitchIdle + (V.EnginePitchMax - V.EnginePitchIdle) * load
	end

	local drifting = sideSpeed &gt; V.SkidThreshold
	if current.Squeal then
		current.Squeal.Volume = if drifting then math.clamp((sideSpeed - V.SkidThreshold) / 20, 0, 0.6) else 0
	end

	--== Bremsspuren =======================================================
	if (drifting or (braking and speed &gt; 25)) and math.random() &lt; 0.5 then
		leaveSkid(current.Body.Position - Vector3.new(0, current.Body.Size.Y * 0.5, 0), forward)
	end

	--== Tacho =============================================================
	speedLabel.Text = ("%d"):format(math.floor(speed * 1.1)) -- Studs/s grob als km/h
	speedLabel.TextColor3 = if fraction &gt; 0.85 then C.Magenta elseif fraction &gt; 0.6 then C.Amber else C.Cyan
	barFill.Size = UDim2.fromScale(fraction, 1)
	barFill.BackgroundColor3 = speedLabel.TextColor3
	hintLabel.Text = if drifting then "GRIP VERLOREN" else "[W][S] Gas/Bremse   [A][D] Lenken"
end)
</ProtectedString>
</Properties>
</Item>
</Item>
