}

--==========================================================================
-- 25. NODE-BREACH
--==========================================================================
Config.NodeBreach = {
	-- Pro Schwierigkeitsband: Gittergroesse, Anzahl Relays, Anteil sichtbares
	-- ICE und Anteil verstecktes ICE (nur DAS kostet Versuche).
	Tiers = {
		{ MaxDifficulty = 2, Width = 5, Height = 5, Relays = 1, Ice = 0.15, MaskedIce = 0.06 },
		{ MaxDifficulty = 4, Width = 6, Height = 6, Relays = 2, Ice = 0.20, MaskedIce = 0.09 },
		{ MaxDifficulty = 6, Width = 6, Height = 6, Relays = 3, Ice = 0.25, MaskedIce = 0.12 },
		{ MaxDifficulty = 8, Width = 7, Height = 7, Relays = 3, Ice = 0.30, MaskedIce = 0.15 },
		{ MaxDifficulty = 10, Width = 8, Height = 8, Relays = 4, Ice = 0.32, MaskedIce = 0.18 },
	},
	PathSearchTries = 12, -- so viele Pfade werden erzeugt, der passendste gewinnt
	PathLengthBonus = 2, -- Wunschlaenge = Width + Height + Bonus
}

--==========================================================================
-- 26. DEFAULTS FUER HACK-ZIELE
-- Ein Part braucht KEIN einziges Attribut. Alles, was fehlt, kommt von hier.
--==========================================================================
Config.TargetDefaults = {
	Difficulty = 1,
	HackType = "NodeBreach",
	Reward = -1, -- -1 = aus Difficulty berechnen
	TraceGain = -1, -- -1 = aus Difficulty berechnen
	Cooldown = -1, -- -1 = Config.Cooldown.Default
	RequiredLevel = 1,
	OnSuccess = "Offline",
	DisplayName = "", -- "" = Instanzname benutzen
	DownTime = 30, -- wie lange der Welteffekt haelt
	-- Steht das Ziel auf offener Strasse? Siehe Config.Cover.
	-- false = gedeckt (drinnen, Hinterhof, Dach): normal bezahlt, sicherer.
	Exposed = false,
	-- Weitere Attribute, die ein Part optional tragen darf und die hier
	-- bewusst KEINEN Default brauchen (nicht gesetzt = Funktion aus):
	--   TargetId   fester Bezeichner, auf den Missionen zeigen koennen
	--   AlarmGroup Name der Ueberfall-Gruppe (siehe Config.Raid)
	--   AlarmStarts / AlarmEnds  startet bzw. stoppt die Alarm-Uhr
	--   FailBusts  true = ein Fehlschlag hier ist sofort ein Bust
	--   RequiresTwo true = zu zweit deutlich leichter (Co-Op)
	--   NoTrace    true = dieses Ziel erzeugt keinen Trace (nur Tutorial)
}

--==========================================================================
-- SESSION / LAUFZEIT
--==========================================================================
Config.Session = {
	TickRate = 0.25, -- Sekunden zwischen Ablauf- und Distanzpruefung
	GraceAfterStart = 0.5, -- kurze Schonfrist, bevor die Distanz geprueft wird
}

--==========================================================================
-- VORLAGEN (ReplicatedStorage/Assets)
--
-- Code platziert Geometrie, Code baut keine Geometrie. Alles Sichtbare liegt
-- als fertiges Modell unter ReplicatedStorage/Assets und wird geklont.
-- Fehlt eine Vorlage, entsteht ein magenta Platzhalter - siehe AssetLibrary.
--==========================================================================
Config.Assets = {
	FolderName = "Assets",

	-- Knallmagenta, damit man einen Platzhalter niemals uebersieht und
	-- niemals versehentlich veroeffentlicht. Bewusst NICHT aus der Palette:
	-- das hier ist kein Weltton, das ist eine Warnung.
	PlaceholderColour = Color3.fromRGB(255, 0, 200),
	PlaceholderTransparency = 0.15,
	PlaceholderLabels = true, -- Schrift ueber dem Platzhalter mit dem Namen
	PlaceholderLabelDistance = 260,

	--== Fahrzeuge =========================================================
	-- Teile, die ein Fahrzeugmodell tragen MUSS, damit VehicleChassis es
	-- verdrahten kann. Fehlt eines, gibt es eine klare Meldung mit
	-- Modellname und fehlendem Teil - keinen stillen Absturz.
	VehicleRequired = {
		"Chassis", -- unsichtbare Kollisionsbox, PrimaryPart
		"Body", -- sichtbare Karosserie
		"Wheels/FL",
		"Wheels/FR",
		"Wheels/RL",
		"Wheels/RR",
		"DriveSeat",
	},
	-- Zweiraeder: F vorne (gelenkt), R hinten (angetrieben).
	VehicleRequiredTwoWheel = {
		"Chassis",
		"Body",
		"Wheels/F",
		"Wheels/R",
		"DriveSeat",
	},
	-- Wie gross die Platzhalter-Karosserie im Verhaeltnis zur Kollisionsbox
	-- ist. Etwas kleiner, damit man den Unterschied sieht.
	PlaceholderBodyScale = 0.92,
	-- Nice-to-have. Fehlen sie, faehrt das Auto trotzdem.
	VehicleOptional = {
		"Glass",
		"Lights/HeadL",
		"Lights/HeadR",
		"Lights/TailL",
		"Lights/TailR",
	},

	--== Gebaeudebaukasten =================================================
	-- Module werden gestapelt: Sockel -&gt; n x Etage -&gt; Dach. Alle Module
	-- haben dieselbe Grundflaeche und eine feste Hoehe, sonst passt der
	-- Stapel nicht. Aus acht Modulen entstehen hunderte Haeuser.
	BuildingFootprint = 28, -- Kantenlaenge eines Moduls in Studs
	BaseHeight = 14, -- Hoehe eines Sockelmoduls
	FloorHeight = 11, -- Hoehe einer Standardetage
	RoofHeight = 4, -- Hoehe des Dachabschlusses
	RoofOverhang = 1.2, -- wie weit die Dachkante uebersteht. 0 = Klotz.

	Bases = { "Base_Shop", "Base_Entry", "Base_Garage" },
	Floors = { "Floor_A", "Floor_B", "Floor_C" },
	Roofs = { "Roof_Flat", "Roof_Tech" },

	-- Wie hoch gestapelt wird. Hoch = Schluchten, runter = Vorstadt.
	MinFloors = 2,
	MaxFloors = 7,
	-- Wie viel dunkler der Sockel ist. 0 = kein Absatz, 1 = fast schwarz.
	BaseDarken = 0.45,
	-- Kein Raster: jedes Haus etwas versetzt und leicht gedreht. Ohne das
	-- sieht die Strasse nach Computer aus, und das faellt sofort auf.
	BuildingJitter = 2.5, -- Studs
	BuildingYaw = 4, -- Grad

	-- Feuerleiter aufs Dach. Ohne die ist ein begehbares Dach nur Deko -
	-- und "von oben" ist im Bankraub ein echter Weg.
	RoofAccess = "Feuerleiter",
	RoofAccessChance = 0.35,
	RoofAccessSize = Vector3.new(2.6, 1, 1.2),
	RoofAccessStep = 4, -- Abstand der Sprossen in Studs

	--== Strassenmoeblierung ===============================================
	-- Eine leere Strasse mit perfekten Haeusern wirkt tot, eine
	-- durchschnittliche Strasse mit Kram darauf wirkt echt.
	Props = { "Laterne", "Ampel", "Muelltonne", "Poller", "Verteiler", "Schild" },
	PropSize = Vector3.new(1.6, 8, 1.6), -- Platzhaltergroesse
	PropSpacing = 26, -- Abstand entlang des Gehwegs
	PropChance = 0.55, -- Anteil der Plaetze, die belegt werden
	PropJitter = 3, -- zufaellige Verschiebung, damit nichts im Raster steht

	Characters = { "Pedestrian", "Guard" },
}

--==========================================================================
-- WELT-FARBEN (Vantorra bei Tag)
--
-- Zwei getrennte Paletten, und das mit Absicht:
--   Config.Palette  = die STADT. Hell, echte Baumaterialien.
--   Config.Theme    = das FAKE-OS in den Fenstern. Bleibt dunkel.
-- Der Kontrast ist der Witz: draussen heller Tag, im Terminal schwarzes
-- Bild mit Cyan. Wer die Stadt umfaerbt, faellt hier an EINER Stelle an.
--
-- Zum Abdunkeln der ganzen Stadt reicht es, diese Werte zu senken - kein
-- World-Skript enthaelt noch eine eigene Farbe.
--==========================================================================
Config.Palette = {
	--== Strasse ==========================================================
	Asphalt = Color3.fromRGB(112, 114, 120),
	Gehweg = Color3.fromRGB(182, 180, 174),
	Markierung = Color3.fromRGB(240, 232, 178),

	--== Gebaeude von aussen ==============================================
	BetonHell = Color3.fromRGB(206, 202, 194),
	Beton = Color3.fromRGB(172, 168, 160),
	BetonDunkel = Color3.fromRGB(126, 123, 118),
	Putz = Color3.fromRGB(216, 200, 172), -- warmer Altbau-Putz
	Ziegel = Color3.fromRGB(172, 112, 92),
	Dach = Color3.fromRGB(138, 136, 132),

	--== Bauteile =========================================================
	Metall = Color3.fromRGB(164, 168, 174),
	MetallDunkel = Color3.fromRGB(108, 112, 120),
	Glas = Color3.fromRGB(190, 212, 226),
	Holz = Color3.fromRGB(158, 118, 82),

	--== Innenraeume ======================================================
	-- Heller als frueher, aber merklich kuehler und matter als draussen:
	-- drinnen ist Deckung, und Deckung soll man sehen koennen.
	InnenBoden = Color3.fromRGB(146, 144, 148),
	InnenWand = Color3.fromRGB(178, 176, 178),
	InnenDecke = Color3.fromRGB(158, 157, 160),

	Haut = Color3.fromRGB(214, 176, 152), -- Wachen-Koepfe
}

table.freeze(Config.Palette)

--==========================================================================
-- UI-FARBEN (Fake-OS) - bleibt dunkel, siehe oben
--==========================================================================
Config.Theme = {
	Background = Color3.fromRGB(6, 8, 11),
	Panel = Color3.fromRGB(13, 17, 23),
	PanelLight = Color3.fromRGB(22, 28, 37),
	Line = Color3.fromRGB(38, 48, 62),
	Cyan = Color3.fromRGB(0, 229, 255),
	CyanDim = Color3.fromRGB(0, 120, 140),
	Magenta = Color3.fromRGB(255, 45, 149),
	Amber = Color3.fromRGB(255, 176, 0),
	Text = Color3.fromRGB(198, 214, 226),
	TextDim = Color3.fromRGB(96, 116, 134),
	Ice = Color3.fromRGB(64, 78, 96),
	Green = Color3.fromRGB(0, 230, 118), -- Verkauf und Bank
}

table.freeze(Config.Theme)

--==========================================================================
-- KARTE
--
-- Zwei Ansichten aus denselben Daten:
--   Minikarte   klein, oben rechts, folgt dem Spieler, zeigt die Umgebung
--   Grosse Karte  [M], die ganze Stadt mit Legende - "wo ist was"
--
-- Steht bewusst NACH Config.Theme: die Symbolfarben sind dieselben wie im
-- Rest des Fake-OS und werden nicht ein zweites Mal gepflegt.
--
-- Die Daten kommen vom SERVER (Remote MapSync), nicht aus dem Workspace.
-- Grund: mit StreamingEnabled hat der Client entfernte Teile gar nicht
-- geladen. Eine Karte, die nur zeigt, was ohnehin schon zu sehen ist,
-- waere nutzlos.
--==========================================================================
Config.Map = {
	--== Minikarte =========================================================
	MiniSize = 190, -- Kantenlaenge in Pixeln
	MiniMargin = 14, -- Abstand zum Bildschirmrand
	-- Wie viele Studs vom Mittelpunkt bis zum Rand sichtbar sind.
	-- Runter = mehr Details, hoch = mehr Uebersicht.
	MiniRange = 300,
	MiniIcon = 9,
	MiniRoadWidth = 5, -- Strassenbreite in Pixeln

	--== Grosse Karte ======================================================
	BigPadding = 70, -- Rand um die Stadt herum
	BigIcon = 13,
	BigRoadWidth = 3,
	BigLabelDistance = 0, -- 0 = Namen immer zeigen

	PlayerIcon = 13,

	-- Obergrenze fuer Hack-Ziele auf der Karte. Bei sehr vielen Zielen
	-- wuerde die Karte sonst zur Punktwolke - und jedes Symbol ist ein Frame.
	MaxTargets = 80,
	-- So lange wird gewartet, bevor nach einer Aenderung neu gesendet wird.
	-- Ohne das feuert der Aufbau der Welt hunderte Sync-Pakete.
	SyncDebounce = 2,

	--== Was auf der Karte auftaucht =======================================
	-- Reihenfolge = Reihenfolge in der Legende.
	-- Order steuert, was oben liegt: Ziele unten, Wegpunkt ganz oben.
	Kinds = {
		{ Id = "TARGET", Label = "Hack-Ziel", Colour = Config.Theme.Cyan, Order = 2 },
		{ Id = "EXPOSED", Label = "Ziel auf offener Strasse", Colour = Config.Theme.Amber, Order = 3 },
		{ Id = "FENCE", Label = "Hehler", Colour = Config.Theme.Green, Order = 5 },
		{ Id = "DEALER", Label = "Autohaus", Colour = Config.Theme.Amber, Order = 5 },
		{ Id = "GARAGE", Label = "Garage", Colour = Config.Theme.Cyan, Order = 5 },
		{ Id = "CONTACT", Label = "Kontakt", Colour = Config.Theme.Magenta, Order = 5 },
		{ Id = "WAYPOINT", Label = "Auftrag", Colour = Config.Theme.Text, Order = 9 },
	},

	-- Bezirke werden als getoente Flaeche mit Namen gezeichnet. Das ist der
	-- eigentliche "wo bin ich hier"-Teil.
	DistrictTransparency = 0.82,
	DistrictLabelSize = 13,
	RoadTransparency = 0.35,
	Background = Config.Theme.Background,
}


return Config
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="GN3">
<Properties>
<string name="Name">Districts</string>
<ProtectedString name="Source">-- ReplicatedStorage/Shared/Districts.luau
--!strict
-- GHOSTNET :: Die Bezirke von Vantorra.
--
-- LEITREGEL AUS DEM BAUPLAN
--   Erst EIN Bezirk fertig und dicht, dann der naechste. Eine grosse leere
--   Stadt ist schlimmer als ein kleiner voller Block. Deshalb hat jeder
--   Bezirk hier eine "Dense"-Angabe: nur die dichten werden voll ausgebaut,
--   die anderen bleiben Rohbau, bis sie dran sind.
--
-- Bezirke sind Daten. Ein neuer Stadtteil = ein Eintrag, kein neues Skript.

local Districts = {}

export type District = {
	Id: string,
	Name: string,
	Character: string,
	-- Mittelpunkt in Gitterkoordinaten (Kreuzungen), nicht in Studs.
	GridX: number,
	GridZ: number,
	Radius: number, -- in Bloecken
	MinDifficulty: number,
	MaxDifficulty: number,
	-- Grundton der Haeuser. Vantorra ist eine HELLE Stadt bei Tag - diese
	-- Werte liegen deshalb im Bereich echter Baumaterialien und nicht mehr
	-- knapp ueber Schwarz. Wer die Stadt abdunkeln will, aendert sie hier
	-- und in Config.Palette, sonst nirgends.
	Tint: Color3,
	Neon: Color3, -- Leitfarbe der Schilder (bleibt kraeftig, auch bei Tag)
	Dense: boolean, -- true = voll ausgebaut
}

Districts.List = {
	{
		Id = "OLDTOWN",
		Name = "Altstadt",
		Character = "Enge Gassen, Putzfassaden, Marktstaende.",
		GridX = 0,
		GridZ = 0,
		-- Radius 2 statt 1: der ausgebaute Bezirk waechst mit der Stadt mit.
		-- Waere er bei 1 geblieben, waere die Altstadt in einer groesseren
		-- Stadt zu einem kleinen Fleck im Rohbau geworden - und "eine grosse
		-- leere Stadt ist schlimmer als ein kleiner voller Block".
		Radius = 2,
		MinDifficulty = 1,
		MaxDifficulty = 3,
		Tint = Color3.fromRGB(214, 196, 168), -- warmer Altbau-Putz
		Neon = Color3.fromRGB(255, 45, 149),
		Dense = true, -- der erste fertige Bezirk
	},
	{
		Id = "DOCKS",
		Name = "Hafen",
		Character = "Container, Lagerhallen, kaum Deckung.",
		GridX = -2,
		GridZ = 1,
		Radius = 1,
		MinDifficulty = 3,
		MaxDifficulty = 5,
		Tint = Color3.fromRGB(154, 162, 168), -- verwitterter Beton, Stahlgrau
		Neon = Color3.fromRGB(0, 229, 255),
		Dense = false,
	},
	{
		Id = "FINANCE",
		Name = "Finanzviertel",
		Character = "Glas, Kameras ueberall, alles einsehbar.",
		GridX = 2,
		GridZ = -1,
		Radius = 1,
		MinDifficulty = 5,
		MaxDifficulty = 7,
		Tint = Color3.fromRGB(190, 206, 220), -- Glasfassade, kuehl
		Neon = Color3.fromRGB(198, 214, 226),
		Dense = false,
	},
	{
		Id = "HEIGHTS",
		Name = "Hoehenzug",
		Character = "Villen, Serpentinen, wenig Verkehr.",
		GridX = 1,
		GridZ = 2,
		Radius = 1,
		MinDifficulty = 6,
		MaxDifficulty = 8,
		Tint = Color3.fromRGB(208, 192, 164), -- Sandstein, Villenputz
		Neon = Color3.fromRGB(255, 176, 0),
		Dense = false,
	},
	{
		Id = "INDUSTRY",
		Name = "Industriegebiet",
		Character = "Weite Flaechen, Zaeune.",
		GridX = -1,
		GridZ = -2,
		Radius = 1,
		MinDifficulty = 4,
		MaxDifficulty = 6,
		Tint = Color3.fromRGB(168, 160, 150), -- Betonplatten, Blechhallen
		Neon = Color3.fromRGB(0, 230, 118),
		Dense = false,
	},
} :: { District }

--==========================================================================

function Districts.Get(id: string): District?
	for _, district in Districts.List do
		if district.Id == id then
			return district
		end
	end
	return nil
end

function Districts.Count(): number
	return #Districts.List
end

-- Welcher Bezirk liegt auf diesen Gitterkoordinaten? nil = Niemandsland.
function Districts.At(gridX: number, gridZ: number): District?
	local best: District? = nil
	local bestDistance = math.huge
	for _, district in Districts.List do
		local dx = gridX - district.GridX
		local dz = gridZ - district.GridZ
		local distance = math.max(math.abs(dx), math.abs(dz))
		if distance &lt;= district.Radius and distance &lt; bestDistance then
			best, bestDistance = district, distance
		end
	end
	return best
end

function Districts.Validate(list: { District }?): (boolean, { string })
	local districts = list or Districts.List
	local errors: { string } = {}
	local seen: { [string]: boolean } = {}
	local occupied: { [string]: string } = {}

	for _, district in districts do
		local label = if typeof(district.Id) == "string" and district.Id ~= "" then district.Id else "#?"

		if typeof(district.Id) ~= "string" or district.Id == "" then
			table.insert(errors, "Id fehlt")
		elseif seen[district.Id] then
			table.insert(errors, ("%s: Id doppelt vergeben"):format(label))
		else
			seen[district.Id] = true
		end

		if typeof(district.Name) ~= "string" or district.Name == "" then
			table.insert(errors, ("%s: Name fehlt"):format(label))
		end
		if district.MinDifficulty &lt; 1 or district.MaxDifficulty &gt; 10 then
			table.insert(errors, ("%s: Schwierigkeit ausserhalb 1-10"):format(label))
		end
		if district.MinDifficulty &gt; district.MaxDifficulty then
			table.insert(errors, ("%s: Min groesser als Max"):format(label))
		end
		if district.Radius &lt; 1 then
			table.insert(errors, ("%s: Radius unter 1"):format(label))
		end

		-- Zwei Bezirke duerfen nicht auf demselben Block liegen, sonst
		-- ueberschreibt einer den anderen beim Bauen.
		local key = ("%d,%d"):format(district.GridX, district.GridZ)
		if occupied[key] then
			table.insert(errors, ("%s ueberlappt %s"):format(label, occupied[key]))
		else
			occupied[key] = label
		end
	end

	-- Genau ein dichter Bezirk zum Start: mehr gleichzeitig anzufangen ist
	-- laut Bauplan ausdruecklich verboten.
	local dense = 0
	for _, district in districts do
		if district.Dense then
			dense += 1
		end
	end
	if dense == 0 then
		table.insert(errors, "kein einziger Bezirk ist ausgebaut")
	end

	return #errors == 0, errors
end

return Districts
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="GN4">
<Properties>
<string name="Name">Geometry</string>
<ProtectedString name="Source">-- ReplicatedStorage/Shared/Geometry.luau
--!strict
-- GHOSTNET :: Die eine Abstandsrechnung, die Server und Client benutzen.
--
-- Warum geteilt: Der HUD zeigt "3 m" an und der Server entscheidet "zu weit".
-- Rechnen beide unterschiedlich, sieht das im Spiel nach einem Bug aus.
-- Deshalb liegt die Formel genau einmal hier.

local Players = game:GetService("Players")

local Geometry = {}

-- Abstand zur OBERFLAECHE des Parts, nicht zum Mittelpunkt. Sonst waeren
-- grosse Objekte (Tueren, Werbetafeln, Tresen) unfair weit weg.
function Geometry.SurfaceDistance(part: BasePart, position: Vector3): number
	if not part.Parent then
		return math.huge
	end
	local rel = part.CFrame:PointToObjectSpace(position)
	local half = part.Size * 0.5
	local clamped = Vector3.new(
		math.clamp(rel.X, -half.X, half.X),
		math.clamp(rel.Y, -half.Y, half.Y),
		math.clamp(rel.Z, -half.Z, half.Z)
	)
	return (rel - clamped).Magnitude
end

-- Position des Spielers, aber nur wenn er wirklich lebendig in der Welt steht.
-- nil heisst: gerade kein gueltiger Character (respawnt, tot, noch nicht geladen).
function Geometry.AlivePosition(player: Player): Vector3?
	local character = player.Character
	if not character then
		return nil
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then
		return nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health &lt;= 0 then
		return nil
	end
	return root.Position
end

-- Steht IRGENDEIN anderer lebender Spieler nah genug an diesem Part?
-- Liegt hier und nicht in einem der Services, weil sowohl HackService (fuer
-- den halbierten Trace) als auch RaidService (fuer die langsamere Alarm-Uhr)
-- die Antwort brauchen - und die beiden duerfen sich nicht gegenseitig
-- requiren.
function Geometry.HasNearbyOtherPlayer(player: Player, part: BasePart, range: number): boolean
	for _, other in Players:GetPlayers() do
		if other == player then
			continue
		end
		local position = Geometry.AlivePosition(other)
		if position and Geometry.SurfaceDistance(part, position) &lt;= range then
			return true
		end
	end
	return false
end

return Geometry
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="GN5">
<Properties>
<string name="Name">Goods</string>
<ProtectedString name="Source">-- ReplicatedStorage/Shared/Goods.luau
--!strict
-- GHOSTNET :: Warenkatalog fuers Darknet.
--
-- Je Ware drei Zahlen, die zusammen ihren Charakter ergeben:
--   Base        Ankerpreis. Der Kurs kehrt langfristig dorthin zurueck.
--   Volatility  wie stark er pro Tick springt (0.04 = bis zu +-4%).
--   Risk        Wahrscheinlichkeit, dass eine Einheit sich als Faelschung
--               entpuppt und beim Verkauf nichts bringt. Sinkt mit dem
--               Analyse-Modul im Rig.
--
-- Die Mischung ist Absicht: billige, ruhige Ware zum Lernen; teure, wilde
-- Ware, bei der man richtig danebenliegen kann. Ohne dieses Gefaelle waere
-- Handel nur Warten.

local Goods = {}

export type Good = {
	Id: string,
	Name: string,
	Blurb: string,
	Base: number,
	Volatility: number,
	Risk: number,
	Group: string, -- fuer Markt-Events ("Razzia: Ausweise +60%")
}

Goods.List = {
	{
		Id = "CREDS",
		Name = "Zugangsdaten",
		Blurb = "Frische Logins. Schnell verderblich, aber immer gefragt.",
		Base = 90,
		Volatility = 0.05,
		Risk = 0.04,
		Group = "DATEN",
	},
	{
		Id = "DATAPACK",
		Name = "Datenpakete",
		Blurb = "Rohdaten aus geknackten Systemen. Ruhiger Kurs.",
		Base = 140,
		Volatility = 0.035,
		Risk = 0.02,
		Group = "DATEN",
	},
	{
		Id = "HARDWARE",
		Name = "Hardware-Teile",
		Blurb = "Ausgebaute Module. Schwer zu faelschen, dafuer traege.",
		Base = 260,
		Volatility = 0.03,
		Risk = 0.01,
		Group = "TECHNIK",
	},
	{
		Id = "EXPLOIT",
		Name = "Exploit-Kits",
		Blurb = "Fertige Einbruchswerkzeuge. Kurs haengt an Razzien.",
		Base = 420,
		Volatility = 0.08,
		Risk = 0.07,
		Group = "TECHNIK",
	},
	{
		Id = "IDCARD",
		Name = "Gefaelschte Ausweise",
		Blurb = "Teuer, wild, und jede zehnte taugt nichts.",
		Base = 610,
		Volatility = 0.11,
		Risk = 0.12,
		Group = "PAPIERE",
	},
} :: { Good }

--==========================================================================

function Goods.Get(id: string): Good?
	for _, good in Goods.List do
		if good.Id == id then
			return good
		end
	end
	return nil
end

function Goods.Count(): number
	return #Goods.List
end

function Goods.Exists(id: any): boolean
	return typeof(id) == "string" and Goods.Get(id) ~= nil
end

-- Pruefung der Katalogdaten. Laeuft beim Serverstart und im Testlauf.
function Goods.Validate(list: { Good }?): (boolean, { string })
	local goods = list or Goods.List
	local errors: { string } = {}
	local seen: { [string]: boolean } = {}

	for index, good in goods do
		local label = if typeof(good.Id) == "string" and good.Id ~= "" then good.Id else ("#" .. index)

		if typeof(good.Id) ~= "string" or good.Id == "" then
			table.insert(errors, ("%s: Id fehlt"):format(label))
		elseif seen[good.Id] then
			table.insert(errors, ("%s: Id doppelt vergeben"):format(label))
		else
			seen[good.Id] = true
		end

		if typeof(good.Name) ~= "string" or good.Name == "" then
			table.insert(errors, ("%s: Name fehlt"):format(label))
		end
		if typeof(good.Group) ~= "string" or good.Group == "" then
			table.insert(errors, ("%s: Group fehlt"):format(label))
		end
		if typeof(good.Base) ~= "number" or good.Base &lt;= 0 then
			table.insert(errors, ("%s: Base muss groesser 0 sein"):format(label))
		end
		if typeof(good.Volatility) ~= "number" or good.Volatility &lt;= 0 or good.Volatility &gt;= 0.5 then
			table.insert(errors, ("%s: Volatility muss zwischen 0 und 0.5 liegen"):format(label))
		end
		if typeof(good.Risk) ~= "number" or good.Risk &lt; 0 or good.Risk &gt;= 1 then
			table.insert(errors, ("%s: Risk muss zwischen 0 und 1 liegen"):format(label))
		end
	end

	return #errors == 0, errors
end

return Goods
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="GN6">
<Properties>
<string name="Name">Missions</string>
<ProtectedString name="Source">-- ReplicatedStorage/Shared/Missions.luau
--!strict
-- GHOSTNET :: Missionsdaten und die reinen Regeln dazu.
--
-- WARUM DATEN UND NICHT SKRIPTE
--   Eine Mission ist ein Tabelleneintrag. Wer eine neue schreibt, fasst nur
--   diese Datei an - der MissionService bleibt unberuehrt. Das Modul kennt
--   weder Spieler noch Remotes noch die Welt: alles hier ist pur und damit
--   im Testlauf ohne Roblox pruefbar.
--
-- LEITREGEL AUS DEM BAUPLAN
--   Jede Mission ist gleichzeitig das Tutorial fuer ein System UND schaltet
--   dieses System dauerhaft frei. Nie eine Mission bauen, deren Inhalt danach
--   verschwindet.
--
-- SCHRITT-TYPEN (mehr gibt es nicht, alles andere setzt sich daraus zusammen)
--   GOTO   Target     = WaypointId eines Parts mit Tag GhostNetWaypoint
--   HACK   TargetId   = TargetId eines Parts mit Tag GhostNetHackable
--   SELL   Amount     = Anzahl Verkaeufe beim Hehler (Standard 1)
--   BUY    GoodId?    = Ware im Darknet, Amount = Stueckzahl (Phase C)
--   WAIT   Seconds    = Wartezeit, serverseitig ueber os.time() gemessen
--   TALK   ContactId  = Kontakt-Part mit Tag GhostNetContact

local Types = require(script.Parent.Types)

local Missions = {}

export type Step = {
	Type: string,
	Text: string,
	Target: string?, -- GOTO
	TargetId: string?, -- HACK
	ContactId: string?, -- TALK
	GoodId: string?, -- BUY
	Amount: number?, -- SELL / BUY
	Seconds: number?, -- WAIT
}

export type Reward = {
	Crypto: number?,
	Unlock: string?,
	-- true = Belohnung geht direkt auf die Bank statt ins heisse Wallet.
	-- Nur da benutzen, wo der Spieler das Geld sofort ausgeben koennen MUSS
	-- (Tutorial). Sonst bleibt Story-Geld heiss und der Hehler relevant.
	ToBank: boolean?,
}

export type Mission = {
	Id: string,
	Title: string,
	Briefing: string,
	Requires: { string },
	Steps: { Step },
	Reward: Reward,
}

--==========================================================================
-- Die Registry
--==========================================================================

-- LEITREGEL, die jede dieser Missionen einhaelt:
--   Sie ist gleichzeitig das Tutorial fuer ein System UND schaltet dieses
--   System dauerhaft frei. Nach M10 hat der Spieler kein "durchgespielt",
--   sondern zehn Systeme, die alle noch laufen.
--
-- SCHREIBREGELN
--   Nie mehr als drei Saetze am Stueck. Briefings sind Nachrichten auf dem
--   Telefon, keine Zwischensequenzen. Wren schreibt knapp, nie freundlich,
--   nie erklaerend. Die Story erklaert NIE eine Mechanik - das macht die
--   Mission selbst.
--
-- Die TargetIds hier muessen zu den Attributen der Parts in
-- ServerScriptService/World passen. Waypoints und Kontakte ebenso.
Missions.List = {
	{
		Id = "M01_FIRSTHACK",
		Title = "Erster Kontakt",
		Briefing = "Ich habe dich beobachtet, und ich kann dich brauchen.\nDa drueben steht ein Wartungsterminal, das keiner vermisst.\n- W",
		Requires = {},
		Steps = {
			{ Type = "HACK", TargetId = "TUT_TERMINAL", Text = "Naeher ran. Dann [E]." },
			{ Type = "SELL", Amount = 1, Text = "Beute zum Hehler bringen" },
		},
		-- ToBank, damit direkt nach dem Tutorial das erste Upgrade drin ist.
		Reward = { Crypto = 200, Unlock = "FREE_HACKING", ToBank = true },
	},
	{
		Id = "M02_STORE",
		Title = "Kalter Anlauf",
		Briefing = "Der Laden an der Kreuzung Nord faehrt nachts auf Notstrom.\nSchloss zuerst, dann der Tresor. Zuegig.",
		Requires = { "M01_FIRSTHACK" },
		Steps = {
			{ Type = "GOTO", Target = "STORE_FRONT", Text = "Geh zum Laden an der Kreuzung Nord" },
			{ Type = "HACK", TargetId = "STORE_LOCK", Text = "Knack das Tuerschloss" },
			{ Type = "HACK", TargetId = "STORE_SAFE", Text = "Tresor oeffnen, bevor der Alarm durchlaeuft" },
			{ Type = "SELL", Amount = 1, Text = "Beute zum Hehler bringen" },
		},
		Reward = { Crypto = 400, Unlock = "STORE_RAIDS" },
	},
	{
		Id = "M03_HOME",
		Title = "Vier Waende",
		Briefing = "Du kannst nicht ewig auf der Strasse arbeiten.\nIch habe dir was besorgt. Fahr den Rechner hoch.",
		Requires = { "M02_STORE" },
		Steps = {
			{ Type = "GOTO", Target = "APARTMENT_DOOR", Text = "Geh nach Hause" },
			{ Type = "TALK", ContactId = "HOME_RIG", Text = "Fahr den Rechner hoch" },
		},
		Reward = { Crypto = 250, Unlock = "DARKNET", ToBank = true },
	},
	{
		Id = "M04_HOTWIRE",
		Title = "Kurzschluss",
		Briefing = "Zu Fuss bist du zu langsam. Nimm dir eins von der Strasse.\nUnd ja, das sehen sie.",
		Requires = { "M03_HOME" },
		Steps = {
			{ Type = "HACK", TargetId = "TUT_TERMINAL", Text = "Uebungsterminal fuer die Zuendung anzapfen" },
			{ Type = "GOTO", Target = "GARAGE", Text = "Auto klauen und zur Garage fahren" },
		},
		Reward = { Crypto = 500, Unlock = "VEHICLES" },
	},
	{
		Id = "M05_WHEELS",
		Title = "Auf Raedern",
		Briefing = "Geklaut ist geklaut. Kauf dir eins, das dir gehoert.\nDer Haendler hat tagsueber auf.",
		Requires = { "M04_HOTWIRE" },
		Steps = {
			{ Type = "GOTO", Target = "DEALER", Text = "Geh zum Autohaendler" },
			{ Type = "SELL", Amount = 2, Text = "Zweimal abliefern - Autos kosten Geld" },
		},
		Reward = { Crypto = 800, Unlock = "DEALERS", ToBank = true },
	},
	{
		Id = "M06_DOCKS",
		Title = "Der Hafen",
		Briefing = "Container 14, Nordkai. Grosse Ware, viel davon.\nNimm was mit Ladeflaeche.",
		Requires = { "M05_WHEELS" },
		Steps = {
			{ Type = "GOTO", Target = "DOCKS", Text = "Fahr zum Nordkai" },
			{ Type = "BUY", Amount = 5, Text = "Fuenf Einheiten Ware aufnehmen" },
			{ Type = "TALK", ContactId = "HOME_RIG", Text = "Zurueck an den Rechner und verkaufen" },
		},
		Reward = { Crypto = 900, Unlock = "DOCKS_ZONE" },
	},
	{
		Id = "M07_BLUELIGHT",
		Title = "Blaulicht",
		Briefing = "Frueher oder spaeter haengen sie dir am Auspuff.\nLern jetzt, wie man sie abschuettelt. Nicht spaeter.",
		Requires = { "M06_DOCKS" },
		Steps = {
			{ Type = "HACK", TargetId = "ATM", Text = "Zieh dir genug Aufmerksamkeit zu" },
			{ Type = "GOTO", Target = "HEIGHTS", Text = "Verschwinde Richtung Hoehenzug" },
			{ Type = "SELL", Amount = 1, Text = "Erst abliefern, wenn du sie los bist" },
		},
		Reward = { Crypto = 1200, Unlock = "HEIGHTS_ZONE" },
	},
	{
		Id = "M08_GLASSHOUSE",
		Title = "Glashaus",
		Briefing = "Vor dem Tresor kommt das Hinsehen. Kameras in der Halle,\nzwei Wachen, eine Schleuse. Fass nichts an.",
		Requires = { "M07_BLUELIGHT" },
		Steps = {
			{ Type = "GOTO", Target = "BANK_FRONT", Text = "Geh zur Nakamura Bank" },
			{ Type = "HACK", TargetId = "BANK_HALL_CAM1", Text = "Erste Hallenkamera abschalten" },
			{ Type = "HACK", TargetId = "BANK_HALL_CAM2", Text = "Zweite Hallenkamera abschalten" },
			{ Type = "WAIT", Seconds = 20, Text = "Warte, bis die Wachen vorbei sind" },
		},
		-- Hier findet der Spieler die Protokolle. Die Wendung steht im
		-- Briefing der naechsten Mission, nicht in einer Zwischensequenz.
		Reward = { Crypto = 1500, Unlock = "FINANCE_ZONE" },
	},
	{
		Id = "M09_VAULT",
		Title = "Der Tresor",
		Briefing = "In den Protokollen stand dein Name, Abteilung Sicherheitsforschung.\nJeder Hack von dir ist verbucht und laengst geschlossen.\nWren hat nie fuer dich gearbeitet - du hast fuer sie gearbeitet.",
		Requires = { "M08_GLASSHOUSE" },
		Steps = {
			{ Type = "HACK", TargetId = "BANK_SLUICE", Text = "Schleuse oeffnen - ab jetzt laeuft die Uhr" },
			{ Type = "HACK", TargetId = "BANK_BOX1", Text = "Schliessfach knacken" },
			{ Type = "HACK", TargetId = "BANK_VAULT", Text = "Tresorraum - zu zweit deutlich leichter" },
			{ Type = "SELL", Amount = 1, Text = "Alles zum Hehler, sofort" },
		},
		Reward = { Crypto = 3500, Unlock = "BANK_RAIDS" },
	},
	{
		Id = "M10_WREN",
		Title = "Wren",
		Briefing = "Sie will dich treffen, am Rechner wie immer.\nDu warst nie ein Krimineller, sondern ein unbezahlter Test.\nJetzt entscheidest du, was du damit machst.",
		Requires = { "M09_VAULT" },
		Steps = {
			{ Type = "TALK", ContactId = "HOME_RIG", Text = "Antworte ihr" },
		},
		-- Keine Crypto: die Belohnung ist die Entscheidung selbst.
		Reward = { Unlock = "ENDGAME" },
	},
} :: { Mission }

-- Nur Doku und Testmaterial. Steht NICHT in der Registry und laeuft im Spiel
-- nie. Zeigt jeden Schritt-Typ genau einmal.
Missions.Example = {
	Id = "M00_BEISPIEL",
	Title = "Beispielmission",
	Briefing = "Zeigt das Schema. Wird nie gespielt.",
	Requires = {},
	Steps = {
		{ Type = "GOTO", Target = "STORE_FRONT", Text = "Geh zum Laden" },
		{ Type = "HACK", TargetId = "STORE_LOCK", Text = "Knack das Schloss" },
		{ Type = "WAIT", Seconds = 5, Text = "Warte, bis die Luft rein ist" },
		{ Type = "TALK", ContactId = "FIXER", Text = "Sprich mit dem Fixer" },
		{ Type = "BUY", GoodId = "EXPLOIT_KIT", Amount = 2, Text = "Kauf zwei Exploit-Kits" },
		{ Type = "SELL", Amount = 1, Text = "Bring die Beute zum Hehler" },
	},
	Reward = { Crypto = 400, Unlock = "STORE_RAIDS" },
} :: Mission

Missions.StepTypes = {
	GOTO = true,
	HACK = true,
	SELL = true,
	BUY = true,
	WAIT = true,
	TALK = true,
}

--==========================================================================
-- Nachschlagen
--==========================================================================

local function indexOf(list: { string }, value: string): number?
	for index, entry in list do
		if entry == value then
			return index
		end
	end
	return nil
end

function Missions.Contains(list: { string }, value: string): boolean
	return indexOf(list, value) ~= nil
end

function Missions.Get(id: string, list: { Mission }?): Mission?
	for _, mission in (list or Missions.List) do
		if mission.Id == id then
			return mission
		end
	end
	return nil
end

function Missions.Count(list: { Mission }?): number
	return #(list or Missions.List)
end

--==========================================================================
-- Verfuegbarkeit
--==========================================================================

-- story ist der Story-Block aus dem Profil. Es wird bewusst derselbe Typ
-- benutzt statt eine zweite Kopie der Form zu pflegen - sonst laufen die
-- beiden bei der naechsten Schema-Aenderung auseinander.
export type StoryView = Types.Story

function Missions.IsCompleted(story: StoryView, id: string): boolean
	return Missions.Contains(story.Completed, id)
end

function Missions.IsAvailable(story: StoryView, id: string, list: { Mission }?): boolean
	local mission = Missions.Get(id, list)
	if not mission then
		return false
	end
	if Missions.IsCompleted(story, id) then
		return false
	end
	for _, required in mission.Requires do
		if not Missions.IsCompleted(story, required) then
			return false
		end
	end
	return true
end

-- Erste Mission in Listenreihenfolge, die jetzt gespielt werden koennte.
function Missions.FirstAvailable(story: StoryView, list: { Mission }?): Mission?
	for _, mission in (list or Missions.List) do
		if Missions.IsAvailable(story, mission.Id, list) then
			return mission
		end
	end
	return nil
end

function Missions.HasUnlock(story: StoryView, key: string): boolean
	return Missions.Contains(story.Unlocks, key)
end

--==========================================================================
-- Fortschritt eines Schrittes
--==========================================================================

-- Wie viel ein Schritt braucht, um zu gelten.
function Missions.Required(step: Step): number
	if step.Type == "WAIT" then
		return 1 -- der Timer laeuft im Service, hier zaehlt nur "fertig"
	end
	local amount = step.Amount
	if typeof(amount) == "number" and amount &gt; 0 then
		return math.floor(amount)
	end
	return 1
end

-- Was ein Ereignis zu diesem Schritt beitraegt. 0 = passt nicht.
--
-- event = { Type = "HACK"|"SELL"|"BUY"|"GOTO"|"TALK"|"WAIT",
--           TargetId?, WaypointId?, ContactId?, GoodId?, Amount?, Success? }
--
-- Diese Funktion ist der einzige Ort, an dem entschieden wird, ob ein Schritt
-- vorankommt. Sie ist pur - der Testlauf faehrt sie ohne Roblox durch.
function Missions.Progress(step: Step, event: { [string]: any }): number
	if typeof(event) ~= "table" or step.Type ~= event.Type then
		return 0
	end

	if step.Type == "GOTO" then
		return if event.WaypointId == step.Target then 1 else 0
	elseif step.Type == "HACK" then
		if event.Success ~= true then
			return 0 -- ein Fehlschlag bringt eine Mission nicht voran
		end
		return if event.TargetId == step.TargetId then 1 else 0
	elseif step.Type == "TALK" then
		return if event.ContactId == step.ContactId then 1 else 0
	elseif step.Type == "SELL" then
		return 1 -- jeder Verkauf zaehlt einmal
	elseif step.Type == "WAIT" then
		return 1 -- nur der Service schickt dieses Ereignis
	elseif step.Type == "BUY" then
		if step.GoodId ~= nil and event.GoodId ~= step.GoodId then
			return 0
		end
		local amount = event.Amount
		if typeof(amount) ~= "number" or amount &lt;= 0 then
			return 0
		end
		return math.floor(amount)
	end

	return 0
end

--==========================================================================
-- Pruefung der Missionsdaten
-- Laeuft beim Serverstart UND im Testlauf. Eine kaputte Mission soll beim
-- Hochfahren auffallen und nicht erst, wenn ein Spieler darin feststeckt.
--==========================================================================

local REQUIRED_FIELD: { [string]: string } = {
	GOTO = "Target",
	HACK = "TargetId",
	TALK = "ContactId",
}

function Missions.Validate(list: { Mission }?, maxSteps: number?): (boolean, { string })
	local missions = list or Missions.List
	local limit = maxSteps or 64
	local errors: { string } = {}

	local seen: { [string]: boolean } = {}
	for index, mission in missions do
		local label = ("Mission #%d"):format(index)

		if typeof(mission.Id) ~= "string" or mission.Id == "" then
			table.insert(errors, ("%s: Id fehlt"):format(label))
			continue
		end
		label = mission.Id

		if seen[mission.Id] then
			table.insert(errors, ("%s: Id doppelt vergeben"):format(label))
		end
		seen[mission.Id] = true

		if typeof(mission.Title) ~= "string" or mission.Title == "" then
			table.insert(errors, ("%s: Title fehlt"):format(label))
		end
		if typeof(mission.Briefing) ~= "string" then
			table.insert(errors, ("%s: Briefing fehlt"):format(label))
		end
		if typeof(mission.Requires) ~= "table" then
			table.insert(errors, ("%s: Requires ist keine Liste"):format(label))
		end
		if typeof(mission.Reward) ~= "table" then
			table.insert(errors, ("%s: Reward fehlt"):format(label))
		end

		if typeof(mission.Steps) ~= "table" or #mission.Steps == 0 then
			table.insert(errors, ("%s: keine Schritte"):format(label))
		elseif #mission.Steps &gt; limit then
			table.insert(errors, ("%s: %d Schritte, erlaubt sind %d"):format(label, #mission.Steps, limit))
		else
			for stepIndex, step in mission.Steps do
				local where = ("%s Schritt %d"):format(label, stepIndex)
				if typeof(step.Type) ~= "string" or not Missions.StepTypes[step.Type] then
					table.insert(errors, ("%s: unbekannter Typ '%s'"):format(where, tostring(step.Type)))
					continue
				end
				if typeof(step.Text) ~= "string" or step.Text == "" then
					table.insert(errors, ("%s: Text fehlt"):format(where))
				end
				local field = REQUIRED_FIELD[step.Type]
				if field and typeof((step :: any)[field]) ~= "string" then
					table.insert(errors, ("%s: %s fehlt fuer %s"):format(where, field, step.Type))
				end
				if step.Type == "WAIT" and (typeof(step.Seconds) ~= "number" or step.Seconds &lt;= 0) then
					table.insert(errors, ("%s: Seconds fehlt oder ist &lt;= 0"):format(where))
				end
				if step.Amount ~= nil and (typeof(step.Amount) ~= "number" or step.Amount &lt;= 0) then
					table.insert(errors, ("%s: Amount muss groesser 0 sein"):format(where))
				end
			end
		end
	end

	-- Vorgaenger muessen existieren.
	for _, mission in missions do
		if typeof(mission.Requires) ~= "table" then
			continue
		end
		for _, required in mission.Requires do
			if not seen[required] then
				table.insert(errors, ("%s: Vorgaenger '%s' gibt es nicht"):format(mission.Id, tostring(required)))
			end
		end
	end

	-- Kreise in den Vorbedingungen. Ohne diese Pruefung waere eine Mission
	-- stumm nie erreichbar, und niemand fuende heraus warum.
	local WHITE, GREY, BLACK = 0, 1, 2
	local colour: { [string]: number } = {}
	local byId: { [string]: Mission } = {}
	for _, mission in missions do
		if typeof(mission.Id) == "string" then
			byId[mission.Id] = mission
			colour[mission.Id] = WHITE
		end
	end

	local function visit(id: string): boolean
		if colour[id] == GREY then
			return true
		end
		if colour[id] == BLACK then
			return false
		end
		colour[id] = GREY
		local mission = byId[id]
		if mission and typeof(mission.Requires) == "table" then
			for _, required in mission.Requires do
				if byId[required] and visit(required) then
					return true
				end
			end
		end
		colour[id] = BLACK
		return false
	end

	for id in byId do
		if colour[id] == WHITE and visit(id) then
			table.insert(errors, ("Kreis in den Vorbedingungen bei '%s'"):format(id))
		end
	end

	return #errors == 0, errors
end

return Missions
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="GN7">
<Properties>
<string name="Name">Remotes</string>
<ProtectedString name="Source">-- ReplicatedStorage/Shared/Remotes.luau
--!strict
-- GHOSTNET :: Erzeugt (Server) bzw. wartet auf (Client) alle Netzwerkobjekte.
-- Neue Remotes werden ausschliesslich in den Listen unten eingetragen.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local FOLDER_NAME = "GhostNetRemotes"

-- C-&gt;S : Client schickt ausschliesslich Eingaben, niemals Ergebnisse.
-- S-&gt;C : Server schickt Zustand und Ergebnisse.
local EVENT_NAMES = {
	"HackRequestStart", -- C-&gt;S  { targetId }
	"HackInput", -- C-&gt;S  { sessionId, step, payload }
	"HackAbort", -- C-&gt;S  { sessionId }
	"HackSessionStarted", -- S-&gt;C  { sessionId, hackType, public, deadline, attempts, ... }
	"HackDenied", -- S-&gt;C  { targetId, reason, seconds }  Start abgelehnt
	"HackFeedback", -- S-&gt;C  { sessionId, step, ok, reason, ... }
	"HackResolved", -- S-&gt;C  { sessionId, success, reason, reward, traceDelta, effect }
	"EconomySync", -- S-&gt;C  { banked, unsold, rig, tier }
	"SellRequest", -- C-&gt;S  { }            Verkauf beim Hehler
	"SellResult", -- S-&gt;C  { ok, reason, gross, fee, net, seconds }
	"TraceSync", -- S-&gt;C  { trace, max, locked, lockSeconds, bust? }
	"MissionSync", -- S-&gt;C  { active, title, briefing, stepIndex, stepText, steps, progress }
	"MissionAccept", -- C-&gt;S  { missionId }
	"MissionAbandon", -- C-&gt;S  { }
	"MissionInteract", -- C-&gt;S  { contactId }   loest TALK-Schritte aus
	"MissionSkip", -- C-&gt;S  { }            Tutorial ueberspringen
	"WaypointSync", -- S-&gt;C  { position, label }  Marker fuer GOTO/HACK/TALK
	"AlarmSync", -- S-&gt;C  { active, label, remaining, total, coop, triggered? }
	"MarketSync", -- S-&gt;C  { goods, event, tickSeconds }   serverweite Kurse
	"MarketEvent", -- S-&gt;C  { text, group }                Kursereignis
	"InventorySync", -- S-&gt;C  { stash, used, slots, tier }
	"AdminReady", -- S-&gt;C  { studio }   nur an autorisierte Spieler
	"StoreSync", -- S-&gt;C  { passes, products }
	"StorePrompt", -- C-&gt;S  { kind, key }   bittet um den Kaufdialog
	"TimeSync", -- S-&gt;C  { clock, isNight, rewardBonus }
	"GarageSync", -- S-&gt;C  { owned, spawned, slots }
	"StealVehicle", -- C-&gt;S  { }            Verkehrsauto kurzschliessen
	"PursuitSync", -- S-&gt;C  { level, escaping, seconds }
	"EndgameChoice", -- C-&gt;S  { choice }    Kassieren oder Verbrennen
	"MapSync", -- S-&gt;C  { nodes, edges, pois }   Kartendaten, siehe MapService
}

local FUNCTION_NAMES: { string } = {
	"ShopPurchase", -- C-&gt;S-&gt;C  { component } -&gt; { ok, reason, level, cost, ... }
	"Trade", -- C-&gt;S-&gt;C  { action, goodId, amount } -&gt; { ok, reason, unit, total, ... }
	"AdminCommand", -- C-&gt;S-&gt;C  { command, ... } -&gt; { ok, text, ... }
	"VehicleAction", -- C-&gt;S-&gt;C  { action, classId, colour } -&gt; { ok, reason, ... }
}

local Remotes = {}

local folder: Folder
if RunService:IsServer() then
	local existing = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
	if existing then
		folder = existing :: Folder
	else
		folder = Instance.new("Folder")
		folder.Name = FOLDER_NAME
		folder.Parent = ReplicatedStorage
	end

	for _, name in EVENT_NAMES do
		if not folder:FindFirstChild(name) then
			local ev = Instance.new("RemoteEvent")
			ev.Name = name
			ev.Parent = folder
		end
	end
	for _, name in FUNCTION_NAMES do
		if not folder:FindFirstChild(name) then
			local fn = Instance.new("RemoteFunction")
			fn.Name = name
			fn.Parent = folder
		end
	end
else
	folder = ReplicatedStorage:WaitForChild(FOLDER_NAME, 30) :: Folder
	if not folder then
		error("[GHOSTNET] Remotes-Ordner nicht gefunden - laeuft der Server-Bootstrap?")
	end
end

-- Zugriff: Remotes.HackInput usw.
setmetatable(Remotes, {
	__index = function(_, key: string): any
		local inst = folder:FindFirstChild(key)
		if not inst then
			if RunService:IsClient() then
				inst = folder:WaitForChild(key, 15)
			end
		end
		if not inst then
			error(("[GHOSTNET] Unbekanntes Remote '%s'"):format(key), 2)
		end
		return inst
	end,
})

return Remotes
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="GN8">
<Properties>
<string name="Name">SoundCatalog</string>
<ProtectedString name="Source">-- ReplicatedStorage/Shared/SoundCatalog.luau
--!strict
-- GHOSTNET :: Alle Klaenge an einem Ort.
--
-- ACHTUNG: ALLE IDs SIND LEER. Noah traegt sie manuell ein.
-- Nutze ausschliesslich Assets aus der offiziellen Roblox Creator Marketplace
-- Audio-Bibliothek oder eigene Uploads. ERFINDE KEINE ASSET-IDS - falsche IDs
-- fuehren zu stummen Sounds ohne Fehlermeldung und sind schwer zu finden.
--
-- So traegt man eine ID ein:
--   Creator Marketplace -&gt; Audio -&gt; Sound anhoeren -&gt; "Asset ID" kopieren
--   und hier als "rbxassetid://DEINE_ID" einsetzen, also die Zahl direkt
--   hinter die beiden Schraegstriche.
--
-- Solange ein Eintrag leer ist, spielt der SoundController ihn einfach nicht
-- ab. Das Spiel laeuft also auch ohne eine einzige ID - es klingt nur nach
-- nichts.

local SoundCatalog = {}

SoundCatalog.Ids = {
	UI = {
		NodeSelect = "", -- kurzer Klick beim Setzen eines Knotens
		NodeInvalid = "", -- dumpfer Fehlton
		IceHit = "", -- harter Treffer, verstecktes ICE
		HackStart = "", -- Terminal faehrt hoch
		HackSuccess = "", -- aufsteigend, befriedigend
		HackFail = "", -- absteigend
		Countdown = "", -- Ticken unter 10 s
		PanelOpen = "", -- Fenster faehrt auf
		PanelClose = "",
		Type = "", -- Tippgeraeusch im Terminal
	},
	Trace = {
		Warn = "", -- ab 70 %
		Critical = "", -- ab 90 %, Loop
		Bust = "", -- Alarm
	},
	Market = {
		Buy = "",
		Sell = "",
		PriceAlert = "", -- Markt-Event
	},
	Vehicle = {
		Engine = "", -- Loop, Tonhoehe steigt mit dem Tempo
		TyreSqueal = "", -- Loop, Lautstaerke steigt mit dem Seitwaertsdrift
		Crash = "", -- Aufprall
		DoorClose = "", -- Einsteigen
	},
	World = {
		Ambience = "", -- dunkler Stadt-Loop
		Rain = "",
		CameraDown = "",
		DoorOpen = "",
		SafeOpen = "",
		Alarm = "",
		Upgrade = "",
	},
}

--==========================================================================
-- Lautstaerken und Verhalten. Diese Zahlen darf man anfassen, die IDs nicht.
--==========================================================================

SoundCatalog.Settings = {
	UIVolume = 0.45,
	WorldVolume = 0.5,
	AmbienceVolume = 0.28,

	-- Waehrend eines Hacks wird die Ambience leiser, damit die UI-Sounds
	-- tragen. Beim Alarm kehrt sie schlagartig laut zurueck.
	AmbienceDuckFactor = 0.25,
	AmbienceDuckTime = 0.4,
	AmbienceAlarmFactor = 1.4,

	-- Die Tonhoehe der Knoten-Klicks steigt mit der Pfadlaenge: jeder
	-- gesetzte Knoten einen Halbton hoeher. Aus Klickgeraeuschen wird eine
	-- aufsteigende Melodie, und ein geloestes Raetsel klingt nach Erfolg
	-- statt nach Klicken.
	SemitoneRatio = 1.059463, -- 2^(1/12)
	MaxSemitones = 14, -- danach wird es schrill

	-- Countdown unter dieser Marke, Frequenz steigt zum Ende hin.
	CountdownFrom = 10,
	CountdownMinInterval = 0.25,
	CountdownMaxInterval = 1.0,
}

--==========================================================================

-- Liefert die Id oder nil, wenn sie noch nicht eingetragen ist.
function SoundCatalog.Get(group: string, key: string): string?
	local bucket = (SoundCatalog.Ids :: any)[group]
	if typeof(bucket) ~= "table" then
		return nil
	end
	local id = bucket[key]
	if typeof(id) ~= "string" or id == "" then
		return nil
	end
	return id
end

-- Wie viele IDs schon eingetragen sind - fuer die Startmeldung.
function SoundCatalog.Count(): (number, number)
	local filled, total = 0, 0
	for _, bucket in SoundCatalog.Ids do
		for _, id in bucket do
			total += 1
			if typeof(id) == "string" and id ~= "" then
				filled += 1
			end
		end
	end
	return filled, total
end

return SoundCatalog
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="GN9">
<Properties>
<string name="Name">Types</string>
<ProtectedString name="Source">-- ReplicatedStorage/Shared/Types.luau
--!strict
-- GHOSTNET :: Gemeinsame Luau-Typen fuer Server und Client.

export type RigLevels = {
	CPU: number,
	RAM: number,
	Cooling: number,
	NetCard: number,
}

-- Zaehler fuers Profil. Phase 3 haengt hier Tagesziele und Ranglisten dran.
export type Stats = {
	Hacks: number, -- erfolgreiche Einbrueche
	Fails: number, -- gescheiterte oder abgebrochene Einbrueche
	Busts: number, -- wie oft der Trace 100 erreicht hat
	Sales: number, -- Verkaeufe beim Hehler
	Earned: number, -- gesamte netto Einnahmen
	Upgrades: number, -- gekaufte Rig-Stufen
	GoodsBought: number, -- im Darknet gekaufte Einheiten
	GoodsSold: number, -- im Darknet verkaufte Einheiten
}

-- Ein gekauftes Fahrzeug. Rein kosmetische Anpassung - keine Leistungsteile,
-- sonst muesste das Fahrverhalten mehrfach ausbalanciert werden.
export type OwnedVehicle = {
	ClassId: string,
	Colour: string,
}

-- Story-Fortschritt im Profil. Der Client bekommt davon nur eine Abschrift
-- ueber MissionSync und meldet nie selbst, dass ein Schritt fertig ist.
export type Story = {
	Active: string, -- "" = gerade keine Mission
	Step: number, -- 1-basierter Index in Mission.Steps
	StepProgress: number, -- fuer Schritte mit Amount &gt; 1
	StepStartedAt: number, -- Unix-Zeit, gebraucht fuer WAIT-Schritte
	Completed: { string }, -- abgeschlossene Missions-Ids
	Unlocks: { string }, -- dauerhaft freigeschaltete Systeme
	Allegiance: string, -- "" | "CASH" | "BURN"  (Mission 10, seit Schema 5)
	AllegianceAt: number, -- Unix-Zeit der letzten Umstellung
}

-- Das gespeicherte Spielerprofil. Einzige Wahrheit fuer alles, was einen
-- Serverwechsel ueberleben muss. Alle Zeitstempel sind os.time() (Unix-Zeit).
export type Profile = {
	SchemaVersion: number,
	Banked: number, -- sicher
	Unsold: number, -- heiss, geht beim Bust verloren
	Rig: RigLevels,
	Trace: number, -- 0 .. Config.Trace.Max
	Cooldowns: { [string]: number }, -- [targetId] = Unix-Zeit, ab der wieder erlaubt
	Stats: Stats,
	Story: Story, -- seit SchemaVersion 2
	Stash: { [string]: number }, -- Darknet-Lager, seit SchemaVersion 3
	PurchaseLog: { string }, -- verarbeitete PurchaseIds, seit SchemaVersion 4
	Garage: { OwnedVehicle }, -- gekaufte Fahrzeuge, seit SchemaVersion 5
	LastSeen: number, -- Unix-Zeit des letzten Speicherns
	SessionId: string, -- Session-Lock gegen Doppel-Sitzungen
}

-- Ein registriertes Hack-Ziel in der Welt.
export type HackTarget = {
	Id: string,
	Part: BasePart,
	DisplayName: string,
	Difficulty: number,
	HackType: string,
	Reward: number,
	TraceGain: number,
	Cooldown: number,
	RequiredLevel: number,
	OnSuccess: string,
	DownTime: number,
	DownUntil: number, -- 0 = einsatzbereit (os.clock, rein serverintern)
}

-- Was der Client ueber ein Node-Breach-Gitter erfahren darf.
-- Verstecktes ICE ist hier als OPEN (0) getarnt.
export type NodeBreachPublic = {
	Width: number,
	Height: number,
	Cells: { number }, -- 0 Open, 1 Ice, 2 Relay, 3 Start, 4 Exit
	Start: number,
	Exit: number,
	Relays: number,
}

-- Serverseitiger Rätselzustand. Verlaesst den Server NIE.
export type NodeBreachState = {
	Width: number,
	Height: number,
	Cells: { number }, -- inkl. 5 = MaskedIce
	Start: number,
	Exit: number,
	RelayTotal: number,
	RelaysVisited: number,
	Path: { number },
	InPath: { [number]: boolean },
	Revealed: { [number]: boolean },
	Solution: { number }, -- fuer den Auto-Solver in Phase 3
}

-- Ergebnis einer einzelnen Spielereingabe, vom Minispiel zurueckgegeben.
export type InputResult = {
	Ok: boolean,
	Reason: string,
	CostsAttempt: boolean,
	Solved: boolean,
	Feedback: { [string]: any },
}

-- Eine laufende Hack-Session auf dem Server.
export type Session = {
	Id: string,
	Player: Player,
	TargetId: string,
	HackType: string,
	Difficulty: number,
	Range: number,
	ExpectedStep: number,
	AttemptsLeft: number,
	Deadline: number, -- workspace:GetServerTimeNow()
	StartedAt: number,
	State: any, -- minispielspezifisch
	Resolved: boolean,
}

return {}
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="GN10">
<Properties>
<string name="Name">UITheme</string>
<ProtectedString name="Source">-- ReplicatedStorage/Shared/UITheme.luau
--!strict
-- GHOSTNET :: Bausteine fuer das Fake-OS-Aussehen.
-- Damit HackUI und HUD nicht dreimal dieselben Farben und Rahmen bauen.

local TweenService = game:GetService("TweenService")
local Config = require(script.Parent.Config)

local UITheme = {}

UITheme.Color = Config.Theme
UITheme.Font = Enum.Font.Code

UITheme.Tween = {
	Fast = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
	Normal = TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
	Slow = TweenInfo.new(0.45, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
}

--== Grundbausteine ========================================================

function UITheme.Frame(props: { [string]: any }): Frame
	local f = Instance.new("Frame")
	f.BackgroundColor3 = UITheme.Color.Panel
	f.BorderSizePixel = 0
	for k, v in props do
		(f :: any)[k] = v
	end
	return f
end

function UITheme.Label(props: { [string]: any }): TextLabel
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Font = UITheme.Font
	l.TextColor3 = UITheme.Color.Text
	l.TextSize = 14
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.RichText = true
	for k, v in props do
		(l :: any)[k] = v
	end
	return l
end

function UITheme.Button(props: { [string]: any }): TextButton
	local b = Instance.new("TextButton")
	b.BackgroundColor3 = UITheme.Color.PanelLight
	b.BorderSizePixel = 0
	b.AutoButtonColor = false
	b.Font = UITheme.Font
	b.TextColor3 = UITheme.Color.Text
	b.TextSize = 14
	b.Text = ""
	for k, v in props do
		(b :: any)[k] = v
	end
	return b
end

-- 1px-Rahmen im Terminal-Look.
function UITheme.Stroke(parent: GuiObject, color: Color3?, thickness: number?): UIStroke
	local s = Instance.new("UIStroke")
	s.Color = color or UITheme.Color.Line
	s.Thickness = thickness or 1
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = parent
	return s
end

function UITheme.Corner(parent: GuiObject, radius: number?): UICorner
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or 3)
	c.Parent = parent
	return c
end

function UITheme.Padding(parent: GuiObject, px: number): UIPadding
	local p = Instance.new("UIPadding")
	p.PaddingTop = UDim.new(0, px)
	p.PaddingBottom = UDim.new(0, px)
	p.PaddingLeft = UDim.new(0, px)
	p.PaddingRight = UDim.new(0, px)
	p.Parent = parent
	return p
end

--== Scanlines =============================================================
-- Prozedural aus duennen Frames gebaut, weil hier keine Textur-Asset-ID
-- hochgeladen werden kann. Optisch identisch, kostet ein paar Instanzen.
-- Liegt oben drauf und schluckt keine Klicks.

function UITheme.Scanlines(parent: GuiObject, spacing: number?): Frame
	local gap = spacing or 4
	local holder = UITheme.Frame({
		Name = "Scanlines",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 50,
		ClipsDescendants = true,
	})

	local lines = math.clamp(math.floor(parent.AbsoluteSize.Y / gap), 20, 220)
	for i = 0, lines do
		local line = UITheme.Frame({
			Name = "L",
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 0.88,
			BorderSizePixel = 0,
			Size = UDim2.new(1, 0, 0, 1),
			Position = UDim2.new(0, 0, 0, i * gap),
			ZIndex = 50,
		})
		line.Parent = holder
	end

	-- langsam wandernder Helligkeitsstreifen
	local sweep = UITheme.Frame({
		Name = "Sweep",
		BackgroundColor3 = UITheme.Color.Cyan,
		BackgroundTransparency = 0.96,
		Size = UDim2.new(1, 0, 0, 90),
		Position = UDim2.new(0, 0, 0, -90),
		ZIndex = 51,
	})
	local grad = Instance.new("UIGradient")
	grad.Rotation = 90
	grad.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.5, 0),
		NumberSequenceKeypoint.new(1, 1),
	})
	grad.Parent = sweep
	sweep.Parent = holder

	task.spawn(function()
		while sweep.Parent do
			sweep.Position = UDim2.new(0, 0, 0, -90)
			local t = TweenService:Create(sweep, TweenInfo.new(3.2, Enum.EasingStyle.Linear), {
				Position = UDim2.new(0, 0, 1, 0),
			})
			t:Play()
			t.Completed:Wait()
			task.wait(2.4)
		end
	end)

	holder.Parent = parent
	return holder
end

--== Terminal-Tippanimation ================================================
-- Gibt eine Funktion zurueck, die eine Zeile Text zeichenweise ausgibt.
-- cancelled() darf true liefern, dann bricht die Ausgabe sofort ab.

function UITheme.TypeInto(label: TextLabel, text: string, cps: number?, cancelled: (() -&gt; boolean)?)
	local speed = cps or 90
	local total = #text
	label.Text = ""
	local shown = 0
	local acc = 0
	while shown &lt; total do
		if cancelled and cancelled() then
			label.Text = text
			return
		end
		acc += task.wait() * speed
		local step = math.floor(acc)
		if step &gt;= 1 then
			acc -= step
			shown = math.min(total, shown + step)
			label.Text = string.sub(text, 1, shown)
		end
	end
	label.Text = text
end

--== Kleine Helfer =========================================================

function UITheme.Flash(obj: GuiObject, color: Color3)
	local original = obj.BackgroundColor3
	obj.BackgroundColor3 = color
	TweenService:Create(obj, UITheme.Tween.Slow, { BackgroundColor3 = original }):Play()
end

function UITheme.Screen(name: string, displayOrder: number): ScreenGui
	local gui = Instance.new("ScreenGui")
	gui.Name = name
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = displayOrder
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	return gui
end

return UITheme
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="GN11">
<Properties>
<string name="Name">Vehicles</string>
<ProtectedString name="Source">-- ReplicatedStorage/Shared/Vehicles.luau
--!strict
-- GHOSTNET :: Fahrzeugklassen als Daten.
--
-- LEITREGEL AUS DEM BAUPLAN
--   Jede Klasse muss einen MECHANISCHEN Grund haben, gefahren zu werden.
--   Ein Auto, das nur schneller ist, macht alle anderen wertlos. Deshalb hat
--   hier jede Klasse genau eine Sache, die sie besser kann als alle anderen -
--   und mindestens eine, die sie schlechter kann.
--
--   Kompakt   billig und unauffaellig  -&gt; weniger Polizei-Aufmerksamkeit
--   Limousine beste Strassenlage       -&gt; bricht als einzige nicht aus
--   Sportwagen schnell                 -&gt; faellt auf, hoher Fahndungszuschlag
--   Van       Lager                    -&gt; traege, aber transportiert Ware
--   Motorrad  wendig                   -&gt; kommt durch Gassen, kein Lager
--
-- Ein Fahrzeug ist wie alles andere in diesem Spiel ein Datensatz. Ein neues
-- Modell = ein Eintrag hier, kein neues Skript.

local Vehicles = {}

export type VehicleClass = {
	Id: string,
	Name: string,
	Blurb: string,
	Price: number, -- Kaufpreis beim Haendler (Phase 4)

	-- Fahrwerte. Alles, was hier fehlt, kommt aus Config.Vehicle.Defaults.
	MaxSpeed: number, -- Studs/s
	Acceleration: number, -- Drehmoment der Antriebsraeder
	BrakeForce: number,
	TurnAngle: number, -- maximaler Lenkeinschlag in Grad
	SuspensionStiffness: number,
	Mass: number, -- Dichte der Karosserie
	Grip: number, -- Reibung der Reifen

	-- Name der Vorlage unter ReplicatedStorage/Assets/Vehicles.
	-- Die Zuordnung steht als Daten hier und wird nicht aus der Id geraten.
	Asset: string,

	-- Masse. Seit der Asset-Pipeline ist das NICHT mehr die Bauanleitung,
	-- sondern nur noch die Groesse des magenta Platzhalters, solange die
	-- Vorlage fehlt - plus die Werte, die der Client fuer Tacho und
	-- Kamera braucht.
	BodySize: Vector3,
	WheelRadius: number,
	WheelWidth: number,
	Wheels: number, -- 2 = Motorrad, 4 = Auto
	Colour: Color3,

	-- Der mechanische Grund, diese Klasse zu fahren.
	StashBonus: number, -- zusaetzlicher Darknet-Lagerplatz im Fahrzeug
	HeatFactor: number, -- 1.0 = normal. Kleiner = unauffaelliger.
}

Vehicles.List = {
	{
		Id = "COMPACT",
		Asset = "Compact",
		Name = "Kompakt",
		Blurb = "Billig, langsam, faellt niemandem auf.",
		Price = 2500,
		MaxSpeed = 62,
		Acceleration = 5200,
		BrakeForce = 7000,
		TurnAngle = 32,
		SuspensionStiffness = 16000,
		Mass = 0.7,
		Grip = 1.6,
		BodySize = Vector3.new(6, 2.6, 11),
		WheelRadius = 1.5,
		WheelWidth = 1.2,
		Wheels = 4,
		Colour = Color3.fromRGB(96, 104, 118),
		StashBonus = 0,
		HeatFactor = 0.7, -- der Grund fuer diese Klasse
	},
	{
		Id = "SEDAN",
		Asset = "Sedan",
		Name = "Limousine",
		Blurb = "Klebt auf der Strasse. Kein Tempowunder, aber nichts bricht aus.",
		Price = 7500,
		MaxSpeed = 78,
		Acceleration = 7000,
		BrakeForce = 9000,
		TurnAngle = 30,
		SuspensionStiffness = 19000,
		Mass = 0.85,
		Grip = 2.4, -- der Grund fuer diese Klasse: beste Strassenlage
		BodySize = Vector3.new(6.4, 2.8, 13),
		WheelRadius = 1.6,
		WheelWidth = 1.3,
		Wheels = 4,
		Colour = Color3.fromRGB(38, 44, 58),
		StashBonus = 2,
		HeatFactor = 1.0,
	},
	{
		Id = "SPORT",
		Asset = "Sports",
		Name = "Sportwagen",
		Blurb = "Schnell und laut. Die Polizei liebt dich dafuer.",
		Price = 34000,
		MaxSpeed = 118,
		Acceleration = 11500,
		BrakeForce = 13000,
		TurnAngle = 27,
		SuspensionStiffness = 26000,
		Mass = 0.8,
		Grip = 2.05, -- schnell, aber zickiger als die Limousine
		BodySize = Vector3.new(6.6, 2.1, 13.5),
		WheelRadius = 1.6,
		WheelWidth = 1.6,
		Wheels = 4,
		Colour = Color3.fromRGB(180, 32, 74),
		StashBonus = 0,
		HeatFactor = 1.6, -- der Preis fuer das Tempo
	},
	{
		Id = "VAN",
		Asset = "Van",
		Name = "Transporter",
		Blurb = "Traege, aber es passt richtig was rein.",
		Price = 16000,
		MaxSpeed = 66,
		Acceleration = 8200,
		BrakeForce = 10000,
		TurnAngle = 26,
		SuspensionStiffness = 22000,
		Mass = 1.2,
		Grip = 1.7,
		BodySize = Vector3.new(7, 5, 15),
		WheelRadius = 1.8,
		WheelWidth = 1.4,
		Wheels = 4,
		Colour = Color3.fromRGB(70, 74, 80),
		StashBonus = 10, -- der Grund fuer diese Klasse
		HeatFactor = 0.9,
	},
	{
		Id = "BIKE",
		Asset = "Bike",
		Name = "Motorrad",
		Blurb = "Passt durch jede Gasse. Platz fuer nichts.",
		Price = 11000,
		MaxSpeed = 96,
		Acceleration = 6800,
		BrakeForce = 6500,
		TurnAngle = 38,
		SuspensionStiffness = 14000,
		Mass = 0.45,
		Grip = 1.9,
		BodySize = Vector3.new(2.2, 2, 8),
		WheelRadius = 1.5,
		WheelWidth = 0.7,
		Wheels = 2,
		Colour = Color3.fromRGB(28, 30, 36),
		StashBonus = -99, -- wird auf 0 geklemmt: kein Lager
		HeatFactor = 0.85,
	},
} :: { VehicleClass }

--==========================================================================

function Vehicles.Get(id: string): VehicleClass?
	for _, class in Vehicles.List do
		if class.Id == id then
			return class
		end
	end
	return nil
end

function Vehicles.Exists(id: any): boolean
	return typeof(id) == "string" and Vehicles.Get(id) ~= nil
end

function Vehicles.Count(): number
	return #Vehicles.List
end

-- Lagerplatz, den dieses Fahrzeug beisteuert. Nie negativ.
function Vehicles.StashBonus(id: string): number
	local class = Vehicles.Get(id)
	if not class then
		return 0
	end
	return math.max(0, class.StashBonus)
end

--==========================================================================
-- Pruefung des Katalogs. Laeuft beim Serverstart und im Testlauf.
--==========================================================================

function Vehicles.Validate(list: { VehicleClass }?): (boolean, { string })
	local classes = list or Vehicles.List
	local errors: { string } = {}
	local seen: { [string]: boolean } = {}

	for index, class in classes do
		local label = if typeof(class.Id) == "string" and class.Id ~= "" then class.Id else ("#" .. index)

		if typeof(class.Id) ~= "string" or class.Id == "" then
			table.insert(errors, ("%s: Id fehlt"):format(label))
		elseif seen[class.Id] then
			table.insert(errors, ("%s: Id doppelt vergeben"):format(label))
		else
			seen[class.Id] = true
		end

		if typeof(class.Name) ~= "string" or class.Name == "" then
			table.insert(errors, ("%s: Name fehlt"):format(label))
		end
		-- Ohne Asset-Namen findet VehicleChassis keine Vorlage und baut fuer
		-- diese Klasse immer nur einen Platzhalter.
		if typeof(class.Asset) ~= "string" or class.Asset == "" then
			table.insert(errors, ("%s: Asset-Name fehlt"):format(label))
		end
		for _, field in { "Price", "MaxSpeed", "Acceleration", "BrakeForce", "TurnAngle", "Mass", "Grip" } do
			local value = (class :: any)[field]
			if typeof(value) ~= "number" or value &lt;= 0 then
				table.insert(errors, ("%s: %s muss groesser 0 sein"):format(label, field))
			end
		end
		if class.Wheels ~= 2 and class.Wheels ~= 4 then
			table.insert(errors, ("%s: Wheels muss 2 oder 4 sein"):format(label))
		end
		if typeof(class.HeatFactor) ~= "number" or class.HeatFactor &lt;= 0 then
			table.insert(errors, ("%s: HeatFactor muss groesser 0 sein"):format(label))
		end
		if typeof(class.BodySize) ~= "Vector3" then
			table.insert(errors, ("%s: BodySize fehlt"):format(label))
		end
	end

	-- Die Leitregel als Pruefung: keine Klasse darf eine andere in JEDER
	-- Hinsicht schlagen, sonst ist die schwaechere tot.
	for _, a in classes do
		for _, b in classes do
			if a.Id == b.Id then
				continue
			end
			local betterEverywhere = a.MaxSpeed &gt;= b.MaxSpeed
				and a.Acceleration &gt;= b.Acceleration
				and Vehicles.StashBonus(a.Id) &gt;= Vehicles.StashBonus(b.Id)
				and a.HeatFactor &lt;= b.HeatFactor
				and a.Price &lt;= b.Price
			if betterEverywhere then
				table.insert(errors, ("%s macht %s vollstaendig ueberfluessig"):format(a.Id, b.Id))
			end
		end
	end

	return #errors == 0, errors
end

return Vehicles
</ProtectedString>
</Properties>
</Item>
