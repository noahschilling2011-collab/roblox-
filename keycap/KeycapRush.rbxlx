<Item class="LocalScript" referent="KC29">
<Properties>
<string name="Name">KeycapRush</string>
<ProtectedString name="Source">--!strict
-- Startet die Controller. Der Client zeigt nur an und schickt Absichten.

local Controllers = script:WaitForChild("Controllers")

local HudController = require(Controllers.HudController)
local ShopController = require(Controllers.ShopController)

HudController.start()
ShopController.start()

print("[KEYCAP] Client bereit.")
</ProtectedString>
</Properties>
<Item class="Folder" referent="KC27">
<Properties>
<string name="Name">Controllers</string>
</Properties>
<Item class="ModuleScript" referent="KC25">
<Properties>
<string name="Name">HudController</string>
<ProtectedString name="Source">--!strict
-- HUD: Vorrat, Rate, Wins, naechstes Tor, Schild, Tutorial-Karte.
-- Baut ausschliesslich mit UiKit - hier steht keine eigene Farbe und
-- keine eigene Pixelzahl.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Theme = require(Shared:WaitForChild("Theme"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local UiKit = require(script.Parent.Parent.UiKit)

local HudController = {}

local player = Players.LocalPlayer

local TOAST_SECONDS = 3.5

function HudController.start()
	local gui = Instance.new("ScreenGui")
	gui.Name = "KeycapHud"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	UiKit.autoScale(gui)

	local margin = Theme.SPACE.L
	local width = Theme.HUD_PANEL_WIDTH

	-- Statuskarte oben links. Die Zeilen sind nach Wichtigkeit gestaffelt:
	-- Vorrat ist die Zahl, auf die der Spieler schaut, Wins die zweite.
	local stats = UiKit.panel(gui, UDim2.new(0, width, 0, Theme.HUD_STATS_HEIGHT), UDim2.new(0, margin, 0, margin))
	local inner = UDim2.new(1, -Theme.SPACE.XL, 0, 0)
	local left = Theme.SPACE.M

	local vorratLabel = UiKit.text(stats, {
		size = inner + UDim2.new(0, 0, 0, 44),
		position = UDim2.new(0, left, 0, Theme.SPACE.S),
		textSize = Theme.TEXT_SIZE.HERO,
		text = "Vorrat 0",
	})
	local rateLabel = UiKit.text(stats, {
		size = inner + UDim2.new(0, 0, 0, 24),
		position = UDim2.new(0, left, 0, 54),
		textSize = Theme.TEXT_SIZE.SMALL,
		color = Theme.TEXT_MUTED,
		text = "+0 pro Sekunde",
	})
	local winsLabel = UiKit.text(stats, {
		size = inner + UDim2.new(0, 0, 0, 34),
		position = UDim2.new(0, left, 0, 84),
		textSize = Theme.TEXT_SIZE.TITLE,
		color = Theme.GOLD_TEXT,
		text = "0 Wins",
	})
	local hintLabel = UiKit.text(stats, {
		size = inner + UDim2.new(0, 0, 0, 22),
		position = UDim2.new(0, left, 0, 124),
		textSize = Theme.TEXT_SIZE.SMALL,
		color = Theme.TEXT_MUTED,
		text = "",
	})

	local shieldButton = UiKit.button(gui, {
		size = UDim2.new(0, width, 0, Theme.TOUCH_MIN),
		position = UDim2.new(0, margin, 0, Theme.HUD_STATS_HEIGHT + margin + Theme.SPACE.S),
		text = "Schild",
		base = Theme.BLUE,
		edge = Theme.BLUE_DARK,
	})

	-- Tutorial-Karte unten mittig. Der Abstand nach unten laesst den
	-- Sprung-Knopf frei, der auf dem Handy unten rechts sitzt.
	local tutorialCard = UiKit.panel(gui, UDim2.new(0.9, 0, 0, 84), UDim2.new(0.05, 0, 1, -200))
	tutorialCard.Visible = false
	local tutorialText = UiKit.text(tutorialCard, {
		size = UDim2.new(1, -Theme.SPACE.XL, 1, -Theme.SPACE.L),
		position = UDim2.new(0, Theme.SPACE.M, 0, Theme.SPACE.S),
		textSize = Theme.TEXT_SIZE.LEAD,
		align = Enum.TextXAlignment.Center,
		wrapped = true,
	})

	local toast = UiKit.text(gui, {
		size = UDim2.new(0, 520, 0, 40),
		position = UDim2.new(0.5, -260, 0, Theme.SPACE.XL),
		textSize = Theme.TEXT_SIZE.LEAD,
		align = Enum.TextXAlignment.Center,
	})
	toast.TextStrokeTransparency = 0.4

	gui.Parent = player:WaitForChild("PlayerGui")

	shieldButton.Activated:Connect(function()
		Remotes.get("ActivateShield"):FireServer()
	end)

	Remotes.get("StateChanged").OnClientEvent:Connect(function(state)
		vorratLabel.Text = ("Vorrat %d"):format(state.vorrat)
		rateLabel.Text = ("+%d pro Sekunde   ·   Tempo %d"):format(state.rate, math.floor(state.speed))
		winsLabel.Text = ("%d Wins"):format(state.wins)

		if state.carrying then
			hintLabel.Text = "Du traegst Beute - lauf nach Hause!"
			hintLabel.TextColor3 = Theme.RED_TEXT
		elseif state.nextStage then
			hintLabel.Text = ("Stage %d ab %d Vorrat"):format(state.nextStage, state.nextStageVorrat)
			hintLabel.TextColor3 = Theme.TEXT_MUTED
		else
			hintLabel.Text = "Alle Tore offen - lauf zu Stage 3!"
			hintLabel.TextColor3 = Theme.GREEN_TEXT
		end

		if state.tutorial then
			tutorialCard.Visible = true
			tutorialText.Text = ("Schritt %d: %s"):format(state.tutorial.step, state.tutorial.text)
		else
			tutorialCard.Visible = false
		end

		if state.shieldLeft &gt; 0 then
			shieldButton.Text = ("Schild aktiv - %ds"):format(state.shieldLeft)
		elseif state.shieldCooldown &gt; 0 then
			shieldButton.Text = ("Schild laedt - %ds"):format(state.shieldCooldown)
		else
			shieldButton.Text = "Schild einschalten"
		end
	end)

	local toastToken = 0
	Remotes.get("Notify").OnClientEvent:Connect(function(text)
		toast.Text = tostring(text)
		toastToken += 1
		local myToken = toastToken
		task.delay(TOAST_SECONDS, function()
			if toastToken == myToken then
				toast.Text = ""
			end
		end)
	end)
end

return HudController
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="KC26">
<Properties>
<string name="Name">ShopController</string>
<ProtectedString name="Source">--!strict
-- Laden: Tasten und Steckplaetze kaufen. Die Preise hier sind nur Anzeige -
-- was ein Kauf kostet, entscheidet allein der Server.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Theme = require(Shared:WaitForChild("Theme"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local EconomyConfig = require(Shared:WaitForChild("Config"):WaitForChild("EconomyConfig"))
local UiKit = require(script.Parent.Parent.UiKit)

local ShopController = {}

local player = Players.LocalPlayer

function ShopController.start()
	local gui = Instance.new("ScreenGui")
	gui.Name = "KeycapShop"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	UiKit.autoScale(gui)

	local margin = Theme.SPACE.L
	-- Sitzt in der linken Spalte unter der Statuskarte und dem Schild-Knopf.
	local shieldBottom = Theme.HUD_STATS_HEIGHT + margin + Theme.SPACE.S + Theme.TOUCH_MIN
	local openButton = UiKit.button(gui, {
		size = UDim2.new(0, Theme.HUD_PANEL_WIDTH, 0, Theme.TOUCH_MIN),
		position = UDim2.new(0, margin, 0, shieldBottom + Theme.SPACE.S),
		text = "Laden",
		base = Theme.GREEN,
		edge = Theme.GREEN_DARK,
	})

	-- Hoehe nicht ausrechnen, sondern vom Layout bestimmen lassen - sonst
	-- passt sie nicht mehr, sobald eine Seltenheit dazukommt.
	local panel = UiKit.panel(gui, UDim2.new(0, Theme.SHOP_PANEL_WIDTH, 0, 0), UDim2.new(0.5, -Theme.SHOP_PANEL_WIDTH / 2, 0.5, -240))
	panel.AutomaticSize = Enum.AutomaticSize.Y
	panel.Visible = false
	UiKit.stack(panel)

	UiKit.text(panel, {
		size = UDim2.new(1, 0, 0, 38),
		textSize = Theme.TEXT_SIZE.TITLE,
		align = Enum.TextXAlignment.Center,
		text = "Tasten kaufen",
		layoutOrder = 0,
	})

	for index, rarityName in EconomyConfig.RARITY_ORDER do
		local rarity = EconomyConfig.RARITIES[rarityName]
		local button = UiKit.button(panel, {
			size = UDim2.new(1, 0, 0, Theme.TOUCH_MIN),
			text = ("%s   +%d/s   %d Wins"):format(rarityName, rarity.vorratPerSecond, rarity.price),
			base = Theme.RARITY_COLORS[rarityName] or Theme.PANEL,
			edge = Theme.PANEL_EDGE,
			layoutOrder = index,
		})
		button.Activated:Connect(function()
			Remotes.get("BuyKey"):FireServer(rarityName)
		end)
	end

	local slotButton = UiKit.button(panel, {
		size = UDim2.new(1, 0, 0, Theme.TOUCH_MIN),
		text = "Steckplatz kaufen",
		base = Theme.GOLD,
		edge = Theme.GOLD_DARK,
		layoutOrder = #EconomyConfig.RARITY_ORDER + 1,
	})
	slotButton.Activated:Connect(function()
		Remotes.get("BuySlot"):FireServer()
	end)

	local closeButton = UiKit.button(panel, {
		size = UDim2.new(1, 0, 0, Theme.TOUCH_MIN),
		text = "Schliessen",
		base = Theme.PANEL,
		edge = Theme.PANEL_EDGE,
		layoutOrder = #EconomyConfig.RARITY_ORDER + 2,
	})
	closeButton.Activated:Connect(function()
		panel.Visible = false
	end)

	gui.Parent = player:WaitForChild("PlayerGui")

	openButton.Activated:Connect(function()
		panel.Visible = not panel.Visible
	end)

	Remotes.get("StateChanged").OnClientEvent:Connect(function(state)
		if state.slotPrice then
			slotButton.Text = ("Steckplatz %d   %d Wins"):format(state.slots + 1, state.slotPrice)
		else
			slotButton.Text = "Alle Steckplaetze gekauft"
		end
		openButton.Text = ("Laden   %d von %d Tasten"):format(state.keyCount, state.slots)
	end)
end

return ShopController
</ProtectedString>
</Properties>
</Item>
</Item>
<Item class="ModuleScript" referent="KC28">
<Properties>
<string name="Name">UiKit</string>
<ProtectedString name="Source">--!strict
-- Bausteine fuer die Oberflaeche. Jeder Controller baut damit, keiner baut
-- eigene Rahmen oder Knoepfe - sonst laufen die Panels optisch auseinander.
--
-- Alle Werte kommen aus Theme. In dieser Datei steht keine Farbe und keine
-- Pixelzahl, die nicht von dort kommt.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Theme = require(Shared:WaitForChild("Theme"))

local UiKit = {}

local function round(instance: Instance)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = Theme.CORNER
	corner.Parent = instance
end

-- Creme-weisse Flaeche mit runden Ecken.
function UiKit.panel(parent: Instance, size: UDim2, position: UDim2): Frame
	local frame = Instance.new("Frame")
	frame.Size = size
	frame.Position = position
	frame.BackgroundColor3 = Theme.PANEL
	frame.BorderSizePixel = 0
	round(frame)
	frame.Parent = parent
	return frame
end

export type TextOptions = {
	size: UDim2,
	position: UDim2?,
	text: string?,
	textSize: number?,
	color: Color3?,
	align: Enum.TextXAlignment?,
	wrapped: boolean?,
	layoutOrder: number?,
}

function UiKit.text(parent: Instance, options: TextOptions): TextLabel
	local element = Instance.new("TextLabel")
	element.Size = options.size
	element.Position = options.position or UDim2.new(0, 0, 0, 0)
	element.BackgroundTransparency = 1
	element.Font = Theme.FONT
	element.TextScaled = false
	element.TextSize = options.textSize or Theme.TEXT_SIZE.BODY
	element.TextColor3 = options.color or Theme.TEXT
	element.TextXAlignment = options.align or Enum.TextXAlignment.Left
	element.TextWrapped = options.wrapped or false
	element.LayoutOrder = options.layoutOrder or 0
	element.Text = options.text or ""
	element.Parent = parent
	return element
end

export type ButtonOptions = {
	size: UDim2,
	position: UDim2?,
	text: string,
	base: Color3,
	edge: Color3,
	textColor: Color3?,
	textSize: number?,
	layoutOrder: number?,
}

-- Knopf mit dunklerer Unterkante. Beim Druecken rutscht die Oberseite auf
-- die Kante - dieselbe Bewegung, die ein echter Tastenanschlag macht.
-- Ohne diese Rueckmeldung fuehlt sich auf dem Handy nichts an, weil es
-- keinen Hover-Zustand gibt.
function UiKit.button(parent: Instance, options: ButtonOptions): TextButton
	local holder = Instance.new("Frame")
	holder.Size = options.size
	holder.Position = options.position or UDim2.new(0, 0, 0, 0)
	holder.BackgroundColor3 = options.edge
	holder.BorderSizePixel = 0
	holder.LayoutOrder = options.layoutOrder or 0
	round(holder)

	local button = Instance.new("TextButton")
	button.Size = UDim2.new(1, 0, 1, -Theme.BUTTON_EDGE_HEIGHT)
	button.Position = UDim2.new(0, 0, 0, 0)
	button.BackgroundColor3 = options.base
	button.BorderSizePixel = 0
	button.AutoButtonColor = false -- eigene Rueckmeldung statt Roblox-Graufilter
	button.Font = Theme.FONT
	button.TextScaled = false
	button.TextSize = options.textSize or Theme.TEXT_SIZE.BODY
	button.TextColor3 = options.textColor or Theme.TEXT
	button.Text = options.text
	round(button)

	local raised = UDim2.new(0, 0, 0, 0)
	local pressed = UDim2.new(0, 0, 0, Theme.BUTTON_EDGE_HEIGHT)
	button.MouseButton1Down:Connect(function()
		button.Position = pressed
	end)
	button.MouseButton1Up:Connect(function()
		button.Position = raised
	end)
	-- Wer den Finger neben dem Knopf loslaesst, bekommt kein MouseButton1Up.
	button.MouseLeave:Connect(function()
		button.Position = raised
	end)

	button.Parent = holder
	holder.Parent = parent
	return button
end

-- Untereinander-Layout mit gleichmaessigem Abstand und Innenrand.
function UiKit.stack(parent: Instance, padding: number?)
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, padding or Theme.SPACE.S)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = parent

	local inset = Instance.new("UIPadding")
	local space = UDim.new(0, Theme.SPACE.M)
	inset.PaddingTop = space
	inset.PaddingBottom = space
	inset.PaddingLeft = space
	inset.PaddingRight = space
	inset.Parent = parent

	return layout
end

-- Skaliert das ganze HUD fuer kleine Bildschirme. Ohne das ist das HUD auf
-- dem Handy zu gross und verdeckt das Spiel.
function UiKit.autoScale(gui: ScreenGui): UIScale
	local scale = Instance.new("UIScale")
	scale.Parent = gui

	local camera = workspace.CurrentCamera

	local function apply()
		local viewport = if camera then camera.ViewportSize else Vector2.new(Theme.SCALE_REFERENCE_WIDTH, 720)
		local factor = viewport.X / Theme.SCALE_REFERENCE_WIDTH
		scale.Scale = math.clamp(factor, Theme.SCALE_MIN, Theme.SCALE_MAX)
	end

	apply()
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(apply)
	end
	return scale
end

return UiKit
</ProtectedString>
</Properties>
</Item>
</Item>
</Item>
</Item>
</roblox>
