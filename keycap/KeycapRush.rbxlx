<Item class="ReplicatedStorage" referent="KC166">
<Properties>
<string name="Name">ReplicatedStorage</string>
</Properties>
<Item class="Folder" referent="KC143">
<Properties>
<string name="Name">Shared</string>
</Properties>
<Item class="Folder" referent="KC137">
<Properties>
<string name="Name">Config</string>
</Properties>
<Item class="ModuleScript" referent="KC134">
<Properties>
<string name="Name">EconomyConfig</string>
<ProtectedString name="Source">--!strict
-- Balancing-Canon fuer KEYCAP RUSH. Werte NUR hier aendern, nie in Services.
--
-- Herkunft der Werte:
--   [KONZEPT]  = steht so im KEYCAP-RUSH-Konzeptdokument (ueber die Bewertung zitiert)
--   [GEMESSEN] = muss in Studio gemessen werden, Platzhalter bis dahin
--   [ABGELEITET] = wird in EconomyLogic aus den obigen berechnet, nicht geraten
--
-- Die Bewertung (docs/KEYCAP_RUSH_BEWERTUNG.md) hat zwei Luecken benannt:
-- Tastenpreis und Produktionsrate pro Seltenheit. Beide stehen hier.

local EconomyConfig = {
	-- ---------------------------------------------------------------
	-- Speed [KONZEPT]
	-- WalkSpeed = BASE + min(vorrat * SPEED_PER_VORRAT, MAX_SPEED_BONUS)
	-- ---------------------------------------------------------------
	BASE_WALK_SPEED = 16,
	SPEED_PER_VORRAT = 0.02,
	MAX_SPEED_BONUS = 84, -- Deckel bei WalkSpeed 100 (Vorrat 4200)
	CARRY_SPEED_FACTOR = 0.6, -- geklaute Taste tragen: 40% langsamer [KONZEPT]

	-- ---------------------------------------------------------------
	-- Stages [KONZEPT]
	-- ---------------------------------------------------------------
	STAGE_GATES = { 30, 50, 75 }, -- Mindest-WalkSpeed pro Stage

	-- Rundlaufzeit Plot -&gt; Cash-Out-Pad -&gt; Plot, in Sekunden. [GEMESSEN]
	-- ACHTUNG: Das sind Schaetzwerte. Sobald der Parcours in Studio steht,
	-- einmal mit Stoppuhr messen und hier eintragen - ALLE Auszahlungs-
	-- faktoren und die Schilddauer haengen daran und rechnen sich neu.
	STAGE_RUN_SECONDS = { 40, 80, 140 },

	-- ---------------------------------------------------------------
	-- Auszahlung [ABGELEITET aus STAGE_RUN_SECONDS]
	-- Wins = floor(vorrat * faktor). Die Faktoren stehen NICHT hier als
	-- feste Zahlen, weil sie sonst nicht zu den Laufzeiten passen.
	-- Siehe EconomyLogic.payoutFactors().
	-- ---------------------------------------------------------------
	BASE_PAYOUT_FACTOR = 0.02, -- Faktor von Stage 1, Anker der Ableitung
	REFERENCE_HOLD_SECONDS = 300, -- typische Sammeldauer zwischen zwei Auszahlungen
	DISTANCE_PREMIUM = 1.12, -- +12% Bonus pro Stage, damit der Umweg etwas bringt

	-- ---------------------------------------------------------------
	-- Tasten: Produktion und Preis [KONZEPT-LUECKE, hier geschlossen]
	-- vorratPerSecond = Produktion. price = Kaufpreis in Wins.
	-- Preis pro Produktionseinheit steigt mit der Seltenheit - dadurch ist
	-- nicht der Preis der Engpass, sondern die Zahl der Steckplaetze.
	-- ---------------------------------------------------------------
	RARITY_ORDER = { "Common", "Uncommon", "Rare", "Epic", "Legendary" },
	RARITIES = {
		Common = { vorratPerSecond = 1, price = 10 },
		Uncommon = { vorratPerSecond = 3, price = 40 },
		Rare = { vorratPerSecond = 9, price = 150 },
		Epic = { vorratPerSecond = 30, price = 600 },
		Legendary = { vorratPerSecond = 100, price = 2500 },
	},

	START_KEY_SLOTS = 10, -- Steckplaetze auf dem Plot beim Start
	MAX_KEY_SLOTS = 20,
	SLOT_PRICE_BASE = 500, -- Preis fuer den 11. Slot
	SLOT_PRICE_GROWTH = 1.6, -- jeder weitere Slot kostet 1.6x

	-- ---------------------------------------------------------------
	-- Diebstahl
	-- Aenderung aus Abschnitt 6 der Bewertung: jede Taste haelt ihren
	-- EIGENEN Vorrat, der Plot-Vorrat ist die Summe. Wer eine Taste klaut,
	-- klaut ihren Vorrat mit. Damit ist Horten nicht mehr gratis.
	-- ---------------------------------------------------------------
	STEAL_VORRAT_SHARE = 0.5, -- Anteil des Tastenvorrats, den der Dieb bekommt
	STEAL_VORRAT_CAP = 5000, -- Rest verfaellt - deckelt den Gluecksgriff
	STEAL_PAIR_COOLDOWN_SECONDS = 90, -- pro Dieb-Opfer-Paar [KONZEPT]
	PRESENCE_HOLD_FACTOR = 2, -- Besitzer zuhause: Klau-Dauer verdoppelt [KONZEPT]

	-- ---------------------------------------------------------------
	-- Schild [ABGELEITET aus STAGE_RUN_SECONDS]
	-- Das Konzept sagt 45 s Schutz / 180 s Abklingzeit. Bei einem
	-- Stage-3-Rundlauf von 140 s schuetzt das genau die Situation nicht,
	-- fuer die es da ist. Siehe EconomyLogic.shieldWindow().
	-- ---------------------------------------------------------------
	SHIELD_COOLDOWN_RATIO = 2, -- Abklingzeit = 2x Schilddauer -&gt; jeder 2. Lauf geschuetzt

	-- ---------------------------------------------------------------
	-- Interaktion [ENTSCHEIDUNG, nicht aus dem Konzept]
	-- ---------------------------------------------------------------
	STEAL_HOLD_SECONDS = 4, -- Halten am Klau-Prompt (x2 wenn Besitzer zuhause)
	CASHOUT_HOLD_SECONDS = 0.6, -- kurzes Halten statt Beruehrung [KONZEPT]
	CARRY_SECONDS = 8, -- so lange traegt man die geklaute Taste sichtbar
	SHOP_HOLD_SECONDS = 0.3,

	-- ---------------------------------------------------------------
	-- Serverweite Ankuendigung [ENTSCHEIDUNG]
	-- Nur die beiden obersten Seltenheiten. Bei jedem Common-Klau waere
	-- die Zeile Rauschen und niemand liest sie mehr - und genau diese
	-- Zeile ist der Screenshot, den Spieler posten.
	-- ---------------------------------------------------------------
	ANNOUNCE_RARITIES = { Epic = true, Legendary = true },

	-- Rate-Limit pro Spieler und Remote (Anfragen pro Sekunde).
	REMOTE_RATE_LIMIT = 6,

	-- Vorrat wird beim Verlassen NICHT gespeichert. Sonst waere Horten
	-- offline risikofrei - genau das Loch, das die per-Taste-Aenderung
	-- schliessen soll. Gespeichert werden Wins, Slots und Tasten.
	PERSIST_VORRAT = false,

	-- ---------------------------------------------------------------
	-- NPC-Plots [ENTSCHEIDUNG]
	-- Absichtlich schwach: sie sollen den leeren Server ueberbruecken,
	-- nicht die beste Einnahmequelle sein. Deshalb nur die zwei untersten
	-- Seltenheiten, gedeckelter Vorrat und eine lange Abklingzeit.
	-- ---------------------------------------------------------------
	NPC_KEY_COUNT = 4,
	NPC_RARITIES = { "Common", "Common", "Uncommon", "Common" },
	NPC_VORRAT_CAP = 1200, -- gedeckelt: kein Horten fuer den Dieb
	NPC_RESPAWN_SECONDS = 60, -- geklaute NPC-Taste kommt danach wieder
	NPC_PAIR_COOLDOWN_SECONDS = 45, -- eigene Abklingzeit pro Dieb und NPC-Plot
}

return EconomyConfig
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="KC135">
<Properties>
<string name="Name">TutorialConfig</string>
<ProtectedString name="Source">--!strict
-- Onboarding-Schritte. Reihenfolge = Spielreihenfolge.
--
-- Ziel: ein neuer Spieler versteht in unter einer Minute, was zu tun ist.
-- Jeder Schritt erklaert GENAU EINE Sache und wird durch eine Handlung
-- abgeschlossen, nicht durch Wegklicken - sonst lernt niemand etwas.
--
-- `event` = was den Schritt abschliesst. "vorrat" ist der Sonderfall: er
-- wird nicht gemeldet, sondern vom Server gegen die Speed-Kurve geprueft.

local TutorialConfig = {
	STEPS = {
		{
			id = "sammeln",
			event = "vorrat",
			requiresVorratForStage = 1, -- genug fuer das erste Tor
			text = "Deine Tasten sammeln von selbst. Je mehr Vorrat, desto schneller laeufst du.",
		},
		{
			id = "auszahlen",
			event = "cashout",
			text = "Du bist schnell genug! Lauf zum goldenen Pad und halte die Taste zum Auszahlen.",
		},
		{
			id = "kaufen",
			event = "buy",
			text = "Wins gibt es im Laden. Kauf dir eine zweite Taste - mehr Tasten, mehr Vorrat.",
		},
		{
			id = "klauen",
			event = "steal",
			text = "Am Ende der Reihe stehen fremde Plots. Halt dort die Klau-Taste und nimm dir eine.",
		},
	},

	DONE_TEXT = "Fertig! Jetzt du: sammeln, auszahlen, aufruesten - und aufpassen, wer bei dir klaut.",
	-- Belohnung fuers Durchspielen: reicht fuer ein paar Common-Tasten,
	-- macht aber niemanden reich.
	REWARD_WINS = 50,
}

return TutorialConfig
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="KC136">
<Properties>
<string name="Name">WorldConfig</string>
<ProtectedString name="Source">--!strict
-- Aufbau der Karte. Alles wird zur Laufzeit aus Parts gebaut, damit die
-- Place-Datei leer bleiben kann. Keine Magic Numbers in den Services.

local WorldConfig = {
	-- Plots: eine Reihe nebeneinander, je Spieler einer.
	PLOT_COUNT = 12, -- Obergrenze fuer die Servergroesse
	PLOT_SIZE = Vector3.new(48, 2, 48),
	PLOT_SPACING = 64, -- Mittenabstand zweier Plots
	PLOT_ORIGIN = Vector3.new(0, 8, 0), -- Mitte des ersten Plots

	-- Chassis unter der Plotplatte. Ohne das schwebt der Plot als nackte
	-- Scheibe; mit Ueberstand liest er sich als Tastatur-Gehaeuse, in dem
	-- die Tasten stecken.
	PLOT_DECK_OVERHANG = 3, -- wie weit das Chassis seitlich ueber die Platte steht
	PLOT_DECK_HEIGHT = 1.6,
	-- Umlaufender erhoehter Rand. Kostet KEINEN zusaetzlichen Part: das
	-- Chassis wird nach oben verlaengert, die Platte sitzt darin.
	PLOT_RIM_HEIGHT = 1,

	-- Schildkuppel ueber dem Plot. Nur sichtbar, solange das Schild laeuft.
	SHIELD_DOME_SCALE = 1.15, -- Durchmesser relativ zur Plotbreite

	-- Beute-Leuchtturm: Lichtsaeule ueber dem Plot, deren Hoehe mit dem
	-- Vorrat waechst. Ein Dieb auf Stage 2 sieht drei Saeulen und weiss
	-- sofort, wohin - ohne in ein Menue zu schauen.
	BEACON_WIDTH = 3,
	BEACON_MIN_HEIGHT = 8,
	BEACON_MAX_HEIGHT = 160,
	-- Bei welchem Vorrat der Leuchtturm seine volle Hoehe hat. Gekoppelt
	-- an den Speed-Deckel: wer so viel hat, ist maximal schnell und
	-- maximal interessant.
	BEACON_FULL_VORRAT = 4200,

	-- Leerer Steckplatz: flache, dunkle Mulde. Damit sieht man aus der
	-- Entfernung, wie voll ein Plot ist - fuer einen Dieb die wichtigste
	-- Information, bevor er hinlaeuft.
	SLOT_MARKER_HEIGHT = 0.2,
	SLOT_MARKER_SCALE = 0.78, -- Anteil der Tastengrundflaeche

	-- Schild an der Vorderkante. War bisher ein unsichtbarer Part mit
	-- schwebendem Text - jetzt eine echte Tafel, an der der Text haengt.
	SIGN_BOARD_SIZE = Vector3.new(16, 4.5, 0.8),

	-- Podest unter dem Auszahlungs-Pad, damit es aus der Ferne als Ziel
	-- erkennbar ist und nicht als Fleck im Boden.
	PAD_RING_OVERHANG = 3.5,
	PAD_RING_HEIGHT = 1.2,

	-- Steckplaetze auf dem Plot: Raster, auf dem die Tasten stehen.
	SLOT_COLUMNS = 5,
	SLOT_SPACING = 9,
	KEY_SIZE = Vector3.new(6, 3, 6),

	-- Silhouette der Tastenkappe. Eine echte Keycap ist unten breiter als
	-- oben und hat einen sichtbaren Absatz zum Sockel - aus 30 m erkennt
	-- man eine Tastatur an der Silhouette, nicht an den Buchstaben.
	--
	-- Gebaut als zwei gestapelte Quader statt aus WedgeParts. Begruendung:
	-- eine echte Schraege braeuchte vier Wedges pro Kappe, das waeren bei
	-- 192 Tasten 768 Parts zusaetzlich - mehr als das gesamte restliche
	-- Budget. Der zweistufige Absatz kostet einen Part und liest sich auf
	-- Spielentfernung gleich.
	KEY_TOP_INSET = 0.82, -- Deckplatte auf 82 % der Grundflaeche
	KEY_TOP_HEIGHT = 0.45,
	KEY_STEM_INSET = 0.68, -- Stem-Ring, schmaler als der Koerper
	KEY_STEM_HEIGHT = 0.6,

	-- Die Legende sitzt nicht mittig, sondern leicht nach oben-links -
	-- so wie auf einer echten Tastatur. Zwei Zahlen, grosse Wirkung.
	KEY_LEGEND_OFFSET = Vector2.new(-0.10, -0.12),

	-- "Zuhause": Radius um die Plotmitte, in dem der Besitzer als anwesend
	-- gilt (verdoppelt die Klau-Dauer).
	PRESENCE_RADIUS = 34,

	-- Parcours: drei Stages, jede weiter weg. Die Cash-Out-Pads stehen am
	-- Ende der jeweiligen Stage.
	STAGE_PAD_POSITIONS = {
		Vector3.new(0, 8, -140),
		Vector3.new(0, 8, -300),
		Vector3.new(0, 8, -520),
	},
	STAGE_PAD_SIZE = Vector3.new(24, 2, 24),

	-- Speed-Tore: wer langsamer ist, kommt nicht durch.
	STAGE_GATE_POSITIONS = {
		Vector3.new(0, 12, -60),
		Vector3.new(0, 12, -210),
		Vector3.new(0, 12, -400),
	},
	STAGE_GATE_SIZE = Vector3.new(40, 12, 2),

	-- Laufwege. Ohne die faellt man ins Leere: zwischen zwei Plots liegen
	-- PLOT_SPACING - PLOT_SIZE.X = 16 Studs Luecke, und zwischen Plotreihe
	-- und Stage 1 war ueberhaupt nichts.
	PATH_WIDTH = 40, -- Breite der Promenade vor den Plots

	-- ---------------------------------------------------------------
	-- Der Parcours. Riesige Tastenkappen mit Luecken dazwischen, die man
	-- nur mit genug WalkSpeed ueberspringt. Die Sprungweite IST das Gate.
	--
	-- Rechnung (Workspace.Gravity 196.2, Humanoid.JumpPower 50, das ist
	-- der Engine-Standard bei UseJumpPower = true):
	--   Anfangsgeschwindigkeit v0 = 50
	--   Flugzeit t = 2 * v0 / g = 2 * 50 / 196.2 = 0,5097 s
	--   Weite   d = WalkSpeed * t
	--     Speed 16 (Start) -&gt;  8,2 Studs
	--     Speed 30 (Gate 1) -&gt; 15,3 Studs
	--     Speed 50 (Gate 2) -&gt; 25,5 Studs
	--     Speed 75 (Gate 3) -&gt; 38,2 Studs
	--
	-- Die Luecken liegen bei 85 % der Maximalweite des jeweiligen
	-- Gate-Speeds. Damit ist das Tor weich: wer knapp darunter liegt,
	-- kommt auch durch, wer deutlich darunter liegt, faellt. Auf 100 %
	-- gesetzt gaebe es keine Marge und jeder Fehltritt waere ein Absturz -
	-- das widerspricht "Landeflaechen grosszuegig, kein Overshoot-Fail".
	-- ACHTUNG: massgeblich ist die DIAGONALE, nicht die Luecke. Wer
	-- seitlich versetzt springt, legt sqrt(luecke^2 + (2*versatz)^2)
	-- zurueck. Mit Versatz 7 und Luecke 21,7 waeren das 25,8 Studs bei
	-- 25,5 Maximalweite - genau auf Gate-Speed kaeme niemand rueber.
	-- Die Luecke bezahlt den Versatz deshalb mit:
	--   Stage 1: Versatz 0  -&gt; Luecke 13,0  Diagonale 13,0  ab Speed 25,5
	--   Stage 2: Versatz 7  -&gt; Luecke 16,5  Diagonale 21,7  ab Speed 42,5
	--   Stage 3: Versatz 11 -&gt; Luecke 23,9  Diagonale 32,5  ab Speed 63,8
	-- ---------------------------------------------------------------
	JUMP_GRAVITY = 196.2, -- ungeprueft: bitte in Studio gegen Workspace.Gravity abgleichen
	JUMP_POWER = 50, -- ungeprueft: haengt an StarterPlayer.CharacterUseJumpPower
	JUMP_MARGIN = 0.85, -- Anteil der Maximalweite, den eine Luecke ausmacht

	STAGES = {
		{ gap = 13, depth = 20, width = 34, sideways = 0, moves = false },
		{ gap = 16.5, depth = 16, width = 26, sideways = 7, moves = false },
		{ gap = 23.9, depth = 13, width = 22, sideways = 11, moves = true },
	},
	-- Bewegliche Kappen in Stage 3: nur senkrecht, langsam, kleine
	-- Amplitude. ungeprueft: ob ein verankerter Part per CFrame den
	-- Spieler zuverlaessig traegt - die Recherche sagt "waagerecht nein,
	-- senkrecht ruckelig ja". Deshalb klein und langsam.
	MOVING_AMPLITUDE = 4,
	MOVING_SECONDS = 2.6,
	MOVING_EVERY = 3, -- jede dritte Kappe bewegt sich

	-- Absturz: unter diese Hoehe gefallen heisst zurueck an den
	-- Stage-Anfang, nicht auf den Plot. Fehler kostet Zeit, nicht den Lauf.
	FALL_Y = -60,
	PROMENADE_DEPTH = 24, -- Streifen vor der Plotreihe, verbindet alle Plots
	PATH_MARGIN = 12, -- wie weit der Weg ueber das letzte Pad hinausgeht

	-- Wie oft der Server den Zustand an die Clients schickt.
	STATE_PUSH_INTERVAL = 0.5,

	-- NPC-Plots [ENTSCHEIDUNG]
	-- Die Bewertung: "Der Loop braucht Mitspieler und du hast keine."
	-- Auf einem leeren Server waere KEYCAP RUSH ein Farm-Spiel. NPC-Plots
	-- sind immer da und immer beklaubar - sie fuellen die Luecke, ohne den
	-- Wettbewerb zwischen echten Spielern zu ersetzen.
	NPC_PLOT_COUNT = 3, -- belegen die letzten Plots der Reihe
	NPC_NAMES = { "Alte Tastatur", "Fundbuero", "Schrottplatz" },

	-- Tastenbeschriftung. Eine Taste ohne Buchstabe ist ein Wuerfel - der
	-- Buchstabe ist die ganze optische Identitaet des Spiels. Reihenfolge
	-- wie auf einer Tastatur, damit ein voller Plot lesbar wirkt.
	KEY_LEGENDS = {
		"A", "S", "D", "F", "G",
		"H", "J", "K", "L", "Q",
		"W", "E", "R", "T", "Y",
		"U", "I", "O", "P", "Z",
	},

	-- Beleuchtung: Schreibtisch bei Nacht. Die Szene wird vom Monitor am
	-- Rand und von den Tasten beleuchtet, nicht von der Sonne. [ENTSCHEIDUNG]
	LIGHTING = {
		AMBIENT = Color3.fromRGB(14, 15, 22), -- fast schwarz, leicht blaeulich
		OUTDOOR_AMBIENT = Color3.fromRGB(20, 24, 36),
		BRIGHTNESS = 0.6, -- Sonne fast aus
		CLOCK_TIME = 0.5, -- kurz nach Mitternacht
		GEOGRAPHIC_LATITUDE = 0,
		ENVIRONMENT_DIFFUSE = 0.15,
		ENVIRONMENT_SPECULAR = 0.9, -- Metall soll das Monitorlicht spiegeln
		EXPOSURE_COMPENSATION = 0.35, -- hebt die dunklen Toene wieder an

		-- Dunst duenn: dichter Dunst frisst in einer Nachtszene den Kontrast.
		ATMOSPHERE_DENSITY = 0.12,
		ATMOSPHERE_HAZE = 0.4,
		ATMOSPHERE_GLARE = 0,
		ATMOSPHERE_COLOR = Color3.fromRGB(28, 32, 46),
		ATMOSPHERE_DECAY = Color3.fromRGB(12, 14, 24),

		-- Bloom scharf. Vorher stand die Schwelle bei 1.4 und es gab zwei
		-- Neon-Parts - deshalb sah man ihn nie. Unter 1 greift er auch bei
		-- normal hellen Flaechen, die leuchtenden Tasten bekommen einen Hof.
		BLOOM_INTENSITY = 1.1,
		BLOOM_SIZE = 32,
		BLOOM_THRESHOLD = 0.85,

		-- Zwei Zahlen, grosse Wirkung: Saettigung hoch, Kontrast leicht hoch,
		-- Farbstich ins Kuehle.
		CC_BRIGHTNESS = 0,
		CC_CONTRAST = 0.12,
		CC_SATURATION = 0.22,
		CC_TINT = Color3.fromRGB(226, 234, 255),

		SUNRAYS_INTENSITY = 0.04, -- dezent, es ist Nacht
		SUNRAYS_SPREAD = 0.6,

		-- Tiefenunschaerfe sehr schwach. Zu viel kostet auf dem Handy.
		DOF_FAR_INTENSITY = 0.28,
		DOF_FOCUS_DISTANCE = 60,
		DOF_IN_FOCUS_RADIUS = 140,
		DOF_NEAR_INTENSITY = 0,

		-- Der Monitor. Kein Objekt, sondern eine Lichtquelle: eine grosse,
		-- schwach leuchtende Flaeche, die die Szene von einer Seite kalt
		-- anleuchtet. Das ist der Trick, der die Nacht-Stimmung macht.
		MONITOR_SIZE = Vector3.new(2, 320, 560),
		MONITOR_POSITION = Vector3.new(-720, 170, -180),
		MONITOR_COLOR = Color3.fromRGB(150, 180, 255),
		MONITOR_LIGHT_BRIGHTNESS = 2.2,
		MONITOR_LIGHT_RANGE = 900,
		MONITOR_TRANSPARENCY = 0.15,
	},

	-- Part-Budget: obere Schranke fuer alles, was der Server baut.
	-- Auf dem Handy ist die Zahl gleichzeitig sichtbarer ProximityPrompts
	-- oft das engere Limit als die reine Part-Zahl. UNGEPRUEFT - nicht gemessen.
	PART_BUDGET = 3000,
}

return WorldConfig
</ProtectedString>
</Properties>
</Item>
</Item>
<Item class="ModuleScript" referent="KC138">
<Properties>
<string name="Name">EconomyLogic</string>
<ProtectedString name="Source">--!strict
-- Reine Rechenlogik der KEYCAP-RUSH-Oekonomie. Kein Roblox-API, keine
-- Instanzen - damit laeuft dieses Modul in der Test-VM (keycap/tests) und
-- auf dem Server dieselbe Rechnung. Der Client bekommt nur Ergebnisse.

local EconomyConfig = require(script.Parent.Config.EconomyConfig)

local EconomyLogic = {}

-- ---------------------------------------------------------------------
-- Speed
-- ---------------------------------------------------------------------

function EconomyLogic.walkSpeed(vorrat: number): number
	local bonus = math.min(vorrat * EconomyConfig.SPEED_PER_VORRAT, EconomyConfig.MAX_SPEED_BONUS)
	return EconomyConfig.BASE_WALK_SPEED + bonus
end

function EconomyLogic.carryWalkSpeed(vorrat: number): number
	return EconomyLogic.walkSpeed(vorrat) * EconomyConfig.CARRY_SPEED_FACTOR
end

-- Umkehrung: wie viel Vorrat braucht es fuer diese WalkSpeed?
function EconomyLogic.vorratForSpeed(speed: number): number
	local bonus = speed - EconomyConfig.BASE_WALK_SPEED
	if bonus &lt;= 0 then
		return 0
	end
	return bonus / EconomyConfig.SPEED_PER_VORRAT
end

function EconomyLogic.vorratForStage(stageIndex: number): number
	local gate = EconomyConfig.STAGE_GATES[stageIndex]
	assert(gate ~= nil, "unbekannte Stage: " .. tostring(stageIndex))
	return EconomyLogic.vorratForSpeed(gate)
end

function EconomyLogic.canEnterStage(vorrat: number, stageIndex: number): boolean
	local gate = EconomyConfig.STAGE_GATES[stageIndex]
	if gate == nil then
		return false
	end
	return EconomyLogic.walkSpeed(vorrat) &gt;= gate
end

-- ---------------------------------------------------------------------
-- Auszahlung
--
-- Die Faktoren werden aus den Rundlaufzeiten abgeleitet, nicht gesetzt.
-- Grundgedanke: Wins/h an Pad i sind f_i * R * T / (T + t_i) * 3600.
-- Waeren alle Pads gleich gut, gaelte f_i proportional zu (T + t_i) -
-- dann entscheidet nur noch das Risiko. Genau das will das Design, also
-- nehmen wir diese Gleichstellung und legen pro Stage einen kleinen
-- Bonus (DISTANCE_PREMIUM) drauf, damit der Umweg sich lohnt, aber
-- nicht dominiert.
-- ---------------------------------------------------------------------

function EconomyLogic.payoutFactors(): { number }
	local runs = EconomyConfig.STAGE_RUN_SECONDS
	local hold = EconomyConfig.REFERENCE_HOLD_SECONDS
	local base = EconomyConfig.BASE_PAYOUT_FACTOR
	local premium = EconomyConfig.DISTANCE_PREMIUM

	local factors = {}
	for i = 1, #runs do
		local equalised = (hold + runs[i]) / (hold + runs[1])
		factors[i] = base * equalised * premium ^ (i - 1)
	end
	return factors
end

function EconomyLogic.payout(vorrat: number, stageIndex: number): number
	local factor = EconomyLogic.payoutFactors()[stageIndex]
	assert(factor ~= nil, "unbekannte Stage: " .. tostring(stageIndex))
	return math.floor(vorrat * factor)
end

-- Wins pro Stunde bei Produktionsrate `rate`, wenn alle `holdSeconds`
-- an Pad `stageIndex` ausgezahlt wird. Das ist die Formel aus Abschnitt 2
-- der Bewertung - sie steigt streng monoton in holdSeconds und laeuft in
-- eine Asymptote, hat also KEIN Optimum bei 10 Minuten.
function EconomyLogic.winsPerHour(rate: number, holdSeconds: number, stageIndex: number): number
	local run = EconomyConfig.STAGE_RUN_SECONDS[stageIndex]
	local factor = EconomyLogic.payoutFactors()[stageIndex]
	assert(run ~= nil and factor ~= nil, "unbekannte Stage: " .. tostring(stageIndex))
	return factor * rate * holdSeconds / (holdSeconds + run) * 3600
end

-- ---------------------------------------------------------------------
-- Tasten
-- ---------------------------------------------------------------------

function EconomyLogic.rarity(name: string)
	local r = EconomyConfig.RARITIES[name]
	assert(r ~= nil, "unbekannte Seltenheit: " .. tostring(name))
	return r
end

-- Wie lange braucht eine Taste, bis sie sich bezahlt gemacht hat?
-- Gerechnet an Stage 1, weil das der Pad ist, den ein neuer Spieler nimmt.
function EconomyLogic.paybackSeconds(name: string): number
	local r = EconomyLogic.rarity(name)
	local winsPerSecond = EconomyLogic.payoutFactors()[1] * r.vorratPerSecond
	return r.price / winsPerSecond
end

-- Preis pro Produktionseinheit. Steigt bewusst mit der Seltenheit.
function EconomyLogic.pricePerRate(name: string): number
	local r = EconomyLogic.rarity(name)
	return r.price / r.vorratPerSecond
end

-- Preis fuer den naechsten Steckplatz. `owned` = aktuelle Slot-Zahl.
function EconomyLogic.slotPrice(owned: number): number?
	if owned &gt;= EconomyConfig.MAX_KEY_SLOTS then
		return nil
	end
	local steps = owned - EconomyConfig.START_KEY_SLOTS
	if steps &lt; 0 then
		steps = 0
	end
	return math.floor(EconomyConfig.SLOT_PRICE_BASE * EconomyConfig.SLOT_PRICE_GROWTH ^ steps)
end

-- ---------------------------------------------------------------------
-- Diebstahl
-- ---------------------------------------------------------------------

-- Wie viel Vorrat wandert beim Klau mit? Rest verfaellt (nicht an das
-- Opfer zurueck - sonst waere Klauen fuer das Opfer folgenlos).
function EconomyLogic.stealTransfer(keyVorrat: number): number
	local share = keyVorrat * EconomyConfig.STEAL_VORRAT_SHARE
	return math.floor(math.min(share, EconomyConfig.STEAL_VORRAT_CAP))
end

-- Plot-Vorrat ist die Summe der Tastenvorraete - eine einzige Quelle,
-- kein zweiter Zaehler daneben.
function EconomyLogic.plotVorrat(keyVorrats: { number }): number
	local sum = 0
	for _, v in keyVorrats do
		sum += v
	end
	return sum
end

function EconomyLogic.plotRate(keyRarities: { string }): number
	local rate = 0
	for _, name in keyRarities do
		rate += EconomyLogic.rarity(name).vorratPerSecond
	end
	return rate
end

-- ---------------------------------------------------------------------
-- Schild
--
-- Muss mindestens einen kompletten Rundlauf zum weitesten Pad abdecken,
-- sonst schuetzt es genau die Situation nicht, fuer die es da ist.
-- ---------------------------------------------------------------------

function EconomyLogic.shieldWindow(): (number, number)
	local longest = 0
	for _, t in EconomyConfig.STAGE_RUN_SECONDS do
		longest = math.max(longest, t)
	end
	local duration = math.ceil(longest / 10) * 10 -- auf 10 s aufgerundet
	return duration, duration * EconomyConfig.SHIELD_COOLDOWN_RATIO
end

return EconomyLogic
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="KC139">
<Properties>
<string name="Name">RateLimit</string>
<ProtectedString name="Source">--!strict
-- Rate-Limit pro Spieler und Kanal. Jede Remote am Server-Eingang benutzt
-- das - sonst kann ein Client den Server mit Anfragen fluten.

local RateLimit = {}

local buckets: { [string]: { tokens: number, last: number } } = {}

-- true = erlaubt. `perSecond` ist zugleich die Eimergroesse, ein Spieler
-- kann also kurz bursten und muss dann warten.
function RateLimit.allow(userId: number, channel: string, perSecond: number): boolean
	local id = userId .. "|" .. channel
	local now = os.clock()
	local bucket = buckets[id]
	if not bucket then
		buckets[id] = { tokens = perSecond - 1, last = now }
		return true
	end
	bucket.tokens = math.min(perSecond, bucket.tokens + (now - bucket.last) * perSecond)
	bucket.last = now
	if bucket.tokens &lt; 1 then
		return false
	end
	bucket.tokens -= 1
	return true
end

function RateLimit.forget(userId: number)
	for id in buckets do
		if id:sub(1, #tostring(userId) + 1) == userId .. "|" then
			buckets[id] = nil
		end
	end
end

return RateLimit
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="KC140">
<Properties>
<string name="Name">Remotes</string>
<ProtectedString name="Source">--!strict
-- Einziger Ort, an dem RemoteEvents/-Functions entstehen. Server legt an,
-- Client wartet darauf. Der Client sendet nur ABSICHTEN - jede Pruefung
-- (Besitz, Kosten, Distanz, Cooldown) passiert im Service dahinter.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local FOLDER_NAME = "KeycapRemotes"

local EVENTS = {
	"StateChanged", -- Server -&gt; Client: {wins, vorrat, rate, slots, keys, speed}
	"Notify", -- Server -&gt; Client: kurze Meldung (Klau, Auszahlung, Fehler)
	"BuyKey", -- Client -&gt; Server: rarityName
	"BuySlot", -- Client -&gt; Server: (keine Argumente)
	"ActivateShield", -- Client -&gt; Server: (keine Argumente)
	"Alert", -- Server -&gt; Client: {kind, title, body} - grosse Einblendung
	"Announce", -- Server -&gt; alle: {rarity, text} - serverweite Zeile
}

local Remotes = {}

local folder: Folder
if RunService:IsServer() then
	folder = ReplicatedStorage:FindFirstChild(FOLDER_NAME) :: Folder
	if not folder then
		local created = Instance.new("Folder")
		created.Name = FOLDER_NAME
		created.Parent = ReplicatedStorage
		folder = created
	end
	for _, name in EVENTS do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
	end
else
	folder = ReplicatedStorage:WaitForChild(FOLDER_NAME) :: Folder
end

local cache: { [string]: RemoteEvent } = {}

function Remotes.get(name: string): RemoteEvent
	local cached = cache[name]
	if cached then
		return cached
	end
	local remote = folder:WaitForChild(name, 10)
	assert(remote and remote:IsA("RemoteEvent"), "Remote fehlt: " .. name)
	cache[name] = remote :: RemoteEvent
	return remote :: RemoteEvent
end

return Remotes
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="KC141">
<Properties>
<string name="Name">Theme</string>
<ProtectedString name="Source">--!strict
-- Design-System. Farben, Schrift, Abstaende und Groessen stehen NUR hier -
-- weder Controller noch Services setzen eigene Werte.
--
-- Stil: hell und freundlich, creme-weisse Flaechen, kraeftige Akzente,
-- runde Ecken, Knoepfe mit dunklerer Unterkante. Kein dunkles Dashboard.

local Theme = {
	FONT = Enum.Font.FredokaOne,

	-- ---------------------------------------------------------------
	-- Farben
	-- ---------------------------------------------------------------
	PANEL = Color3.fromRGB(252, 249, 240), -- creme-weiss
	PANEL_EDGE = Color3.fromRGB(214, 206, 188),
	-- Tinte. Eine einzige fast-schwarze Farbe fuer Schrift auf bunten
	-- Flaechen, fuer die Umrandung um jedes Element und fuer die Kante
	-- unter jedem Knopf. Dass sie ueberall wiederkehrt, ist das, was den
	-- Look zusammenhaelt - siehe DESIGN.md.
	INK = Color3.fromRGB(24, 20, 18),
	OUTLINE_THICKNESS = 3, -- Umrandung von Panels und Knoepfen
	GRADIENT_LIFT = 0.14, -- Verlauf: oben um diesen Anteil heller

	TEXT = Color3.fromRGB(58, 52, 44),
	TEXT_MUTED = Color3.fromRGB(108, 100, 88),

	-- Knopfschrift ist IMMER dunkel, nie weiss. Weiss auf diesen hellen
	-- Akzenten kommt nur auf 2,4:1 - fuer Kinder auf einem Handy im
	-- Hellen unlesbar. Dunkle Schrift schafft ueberall mindestens 4,5:1,
	-- und die Akzente bleiben so kraeftig, wie sie sein sollen.
	-- Nachgerechnet im Testlauf, nicht geschaetzt.
	GREEN = Color3.fromRGB(64, 196, 86),
	GREEN_DARK = Color3.fromRGB(38, 138, 56),
	BLUE = Color3.fromRGB(56, 166, 246),
	BLUE_DARK = Color3.fromRGB(30, 112, 182),
	GOLD = Color3.fromRGB(255, 190, 32),
	GOLD_DARK = Color3.fromRGB(200, 138, 12),
	RED = Color3.fromRGB(246, 84, 74), -- nur fuer Flaechen
	RED_DARK = Color3.fromRGB(180, 48, 40), -- Kante unter einer roten Flaeche
	PURPLE = Color3.fromRGB(176, 102, 244),
	PURPLE_DARK = Color3.fromRGB(126, 62, 190),

	-- Textfarben der Akzente. Bewusst eigene Werte statt der _DARK-Kanten:
	-- eine Knopfkante muss nur dunkler sein als ihre Flaeche, eine Schrift
	-- muss 4,5:1 gegen das creme-weisse Panel schaffen. GOLD_DARK kommt dort
	-- nur auf 2,45:1 - als grosse Wins-Zahl waere das unlesbar gewesen.
	GOLD_TEXT = Color3.fromRGB(140, 96, 10),
	GREEN_TEXT = Color3.fromRGB(44, 116, 54),
	RED_TEXT = Color3.fromRGB(186, 68, 62),

	-- Die Kappe. Eine echte Keycap-Farbwelt, kein Regenbogen: warmes
	-- Off-White, Salbei, Petrol, Violett, Bernstein.
	-- Rare und Epic sind gegenueber dem Entwurf zwei Toene dunkler - mit
	-- den Originalwerten schaffte die Legende nur 3,91 bzw. 3,84:1.
	RARITY_COLORS = {
		Common = Color3.fromRGB(232, 228, 218),
		Uncommon = Color3.fromRGB(127, 168, 138),
		Rare = Color3.fromRGB(53, 111, 147),
		Epic = Color3.fromRGB(123, 79, 196),
		Legendary = Color3.fromRGB(255, 159, 28),
	},

	-- ---------------------------------------------------------------
	-- WELT — "Du bist winzig auf einem Schreibtisch. Nachts."
	--
	-- Der Boden ist eine Schreibtischmatte, die Plots stehen auf einer
	-- Tastaturplatte. Alles dunkel und kuehl; das Licht kommt vom Monitor
	-- am Rand und von den Tasten selbst, nicht von der Sonne.
	--
	-- WICHTIG zur Kante: auf dem hellen HUD ist die Kante DUNKEL (INK).
	-- Auf der dunklen Welt geht das nicht - INK hat Leuchtdichte 0,0074,
	-- die Matte 0,0073, die Tinte waere heller als der Boden. Weltkanten
	-- sind deshalb AUFHELLEND (SEAM). Zwei Gruende, zwei Farben.
	--
	-- Die Tonwerte liegen dicht beieinander (1,1-1,4:1). Das ist Absicht -
	-- eine dunkle Szene lebt von feinen Abstufungen. Lesbarkeit tragen
	-- Kanten und Licht, nicht Flaechenkontrast.
	-- ---------------------------------------------------------------
	WORLD = {
		MAT = Color3.fromRGB(20, 20, 28), -- Schreibtischmatte, der Boden
		MAT_MATERIAL = Enum.Material.Fabric,
		SEAM = Color3.fromRGB(46, 46, 62), -- Naht und Kante, hellt auf
		SEAM_MATERIAL = Enum.Material.Fabric,
		PLATE = Color3.fromRGB(34, 34, 44), -- Tastaturplatte, traegt die Plots
		PLATE_MATERIAL = Enum.Material.Metal,
		CHASSIS = Color3.fromRGB(51, 51, 63), -- Rahmen um die Platte
		CHASSIS_MATERIAL = Enum.Material.Metal,
		SOCKET = Color3.fromRGB(14, 14, 20), -- leere Mulde, dunkler als die Platte
		SOCKET_MATERIAL = Enum.Material.SmoothPlastic,
		PATH = Color3.fromRGB(26, 26, 36), -- Weg und Promenade
		PATH_MATERIAL = Enum.Material.Fabric,

		-- Signalfarbe. NUR fuer Cash-Out-Pad, Schildkuppel und
		-- Beute-Leuchtturm. Wenn Cyan leuchtet, passiert etwas - deshalb
		-- kommt die Farbe sonst nirgends vor.
		SIGNAL = Color3.fromRGB(61, 224, 224),
		SIGNAL_DIM = Color3.fromRGB(28, 128, 128),
	},

	-- Dunkle Kante je Seltenheit. Ohne die ist eine Taste eine flache
	-- Flaeche - weder der 3D-Effekt der Knoepfe noch das Kantenlicht der
	-- Tasten in der Welt haben sonst einen Wert, aus dem sie sich rechnen.
	-- Der Stem-Ring unter der Kappe, der sie vom Sockel absetzt. Jeweils
	-- 55 % der Kappenhelligkeit - dieselbe Beziehung wie Knopf zu Kante.
	RARITY_EDGE = {
		Common = Color3.fromRGB(128, 125, 120),
		Uncommon = Color3.fromRGB(70, 92, 76),
		Rare = Color3.fromRGB(29, 61, 81),
		Epic = Color3.fromRGB(68, 43, 108),
		Legendary = Color3.fromRGB(140, 87, 15),
	},

	-- Schrift AUF der jeweiligen Seltenheitsfarbe. Nachgerechnet gegen die
	-- eigene Flaeche: Common 6,2:1 - Uncommon 5,1:1 - Rare 4,6:1 -
	-- Epic 5,4:1 - Legendary 5,1:1. Weiss waere auf allen fuenf unlesbar.
	-- Die Legende, also der Buchstabe auf der Kappe. Nachgerechnet gegen
	-- die eigene Kappe: Common 11,8 - Uncommon 5,6 - Rare 4,9 - Epic 4,8 -
	-- Legendary 8,2:1. Helle Kappen tragen dunkle Legenden und umgekehrt.
	RARITY_INK = {
		Common = Color3.fromRGB(42, 38, 32),
		Uncommon = Color3.fromRGB(28, 42, 32),
		Rare = Color3.fromRGB(232, 244, 250),
		Epic = Color3.fromRGB(244, 234, 255),
		Legendary = Color3.fromRGB(42, 26, 0),
	},

	-- Rang 1-5. Traegt alles, was die Seltenheit OHNE Farbe zeigt:
	-- Zahl der Punkte im Laden, Rahmenstaerke, Kantenlicht in der Welt.
	-- Farbe allein reicht auf einem billigen Display in der Sonne nicht.
	-- Material je Stufe. Ab Rare wird die Kappe glaenzender, Legendary
	-- bekommt Metall - aus der Entfernung unterscheidbar, auch wenn ein
	-- billiges Display die Farbe verwaescht.
	RARITY_MATERIAL = {
		Common = Enum.Material.SmoothPlastic,
		Uncommon = Enum.Material.SmoothPlastic,
		Rare = Enum.Material.Plastic,
		Epic = Enum.Material.Plastic,
		Legendary = Enum.Material.Metal,
	},

	-- Reichweite des PointLights in der Kappe. 0 = kein Licht.
	-- Das ist keine Deko: Rare und Epic schaffen gegen die Tastaturplatte
	-- nur 2,89 bzw. 2,82:1 - ohne eigenes Licht verschwinden sie darauf.
	RARITY_LIGHT_RANGE = {
		Common = 0,
		Uncommon = 0,
		Rare = 12,
		Epic = 16,
		Legendary = 24,
	},
	RARITY_LIGHT_BRIGHTNESS = 1.4,

	RARITY_RANK = {
		Common = 1,
		Uncommon = 2,
		Rare = 3,
		Epic = 4,
		Legendary = 5,
	},

	-- Hoehenfaktor der Taste in der Welt (mal WorldConfig.KEY_SIZE.Y).
	-- Die Grundflaeche bleibt gleich, damit das Steckplatz-Raster passt -
	-- unterschiedlich ist die Hoehe. Aus 20 m ist das der erste Unterschied,
	-- den man sieht, noch vor der Farbe.
	KEY_CROWN = {
		Common = 1,
		Uncommon = 1.2,
		Rare = 1.5,
		Epic = 1.9,
		Legendary = 2.4,
	},
	KEY_RIM_BASE = 0.04, -- Kantenlicht Grundstaerke (Studs)
	KEY_RIM_STEP = 0.03, -- plus je Rang
	KEY_LABEL_DISTANCE = 160, -- Sichtweite der schwebenden Vorratszahl

	-- ---------------------------------------------------------------
	-- Abstaende. Eine Skala, keine krummen Zwischenwerte.
	-- ---------------------------------------------------------------
	SPACE = { XS = 4, S = 8, M = 12, L = 16, XL = 24, XXL = 40 },

	-- ---------------------------------------------------------------
	-- Schriftgroessen in Pixeln (bei UIScale 1).
	-- ---------------------------------------------------------------
	-- DISPLAY und BLAST sind neu. HERO 38 war der groesste Grad; der Vorrat
	-- ist aber die Zahl, um die sich das ganze Spiel dreht, und muss die
	-- groesste auf dem Bildschirm sein. BLAST nur fuer den Cash-Out.
	TEXT_SIZE = { SMALL = 16, BODY = 20, LEAD = 24, TITLE = 30, HERO = 38, DISPLAY = 56, BLAST = 96 },

	-- ---------------------------------------------------------------
	-- Formen
	-- ---------------------------------------------------------------
	CORNER = UDim.new(0, 16), -- gross wirkt nach Spielzeug, klein nach Technik
	BUTTON_EDGE_HEIGHT = 4, -- dunklere Unterkante fuer den 3D-Effekt
	-- Kleinstes Touch-Ziel. Alles Anklickbare ist mindestens so hoch -
	-- darunter trifft ein Kinderdaumen auf dem Handy nicht zuverlaessig.
	TOUCH_MIN = 56,

	-- ---------------------------------------------------------------
	-- Layout des HUD
	-- ---------------------------------------------------------------
	-- Reservierte Bildschirmbereiche. Oben links sitzt der Roblox-Menue-
	-- knopf: die Statuskarte lag vorher bei y=16 und damit darunter.
	HUD_TOP_INSET = 72, -- ab hier faengt eigene UI oben an
	HUD_BOTTOM_INSET = 120, -- darunter: Stick links, Sprung-Knopf rechts

	HUD_PANEL_WIDTH = 320,
	-- 156 -&gt; 240: der Tempo-Balken mit den drei Tor-Markierungen und der
	-- groessere Vorrat (DISPLAY 56 statt HERO 38) brauchen die Hoehe.
	HUD_STATS_HEIGHT = 240,

	-- Handy quer: Statuskarte wird zum Streifen oben mittig, die Knoepfe
	-- wandern an den rechten Rand. Sonst liegt das HUD unter dem Stick.
	HUD_STATS_COMPACT_HEIGHT = 108,
	HUD_COMPACT_WIDTH = 320,
	HUD_COMPACT_BUTTON_WIDTH = 76,
	COMPACT_MAX_WIDTH = 900,
	COMPACT_MAX_HEIGHT = 520,

	HUD_TUTORIAL_WIDTH = 720,
	HUD_TUTORIAL_COMPACT_WIDTH = 460,
	HUD_TUTORIAL_HEIGHT = 96,

	-- Tempo-Balken
	BAR_HEIGHT = 20,
	BAR_HEIGHT_COMPACT = 12,
	BAR_MARK_WIDTH = 4,

	-- Seltenheitspunkte
	PIP = 10,
	PIP_GAP = 4,
	PIP_CORNER = 3,

	-- Taste als Bild im Laden
	KEYCAP_EDGE = 8, -- Unterkante der kleinen Taste
	KEY_THUMB = 64, -- Hoehe einer Legendary
	KEY_THUMB_STEP = 6, -- je Rang niedriger

	-- 400 -&gt; 560: eine Zeile traegt Tastenbild, Name, Punkte, Produktion
	-- und Kaufknopf. Bei 400 stand der Preis im Namen - genau das war der
	-- Grund, warum man die Seltenheit lesen musste statt sie zu sehen.
	SHOP_PANEL_WIDTH = 560,
	SHOP_ROW_HEIGHT = 88,
	SHOP_ROW_STROKE = 1, -- plus Rang: Common 2, Legendary 6
	SHOP_LIST_HEIGHT = 472,
	SHOP_LIST_HEIGHT_COMPACT = 208,
	SHOP_BUY_WIDTH = 128,
	SCROLLBAR = 6,

	-- Meldungen
	TOAST_WIDTH = 520,
	TOAST_HEIGHT = 40,
	BANNER_WIDTH = 640, -- laesst links das Menue und rechts den Chat frei
	BANNER_HEIGHT = 44,
	BANNER_SECONDS = 4,
	ALERT_WIDTH = 560,
	ALERT_HEIGHT = 168,
	ALERT_BAR = 8,
	ALERT_SECONDS = 4,

	-- Bewegung
	BUMP_SCALE = 1.08, -- Vorrat-Zahl beim Wachsen
	FLOAT_RISE = 52, -- wie weit die +Zahl steigt
	CRAWLER_WIDTH = 80,
	CRAWLER_HEIGHT = 4,

	-- ---------------------------------------------------------------
	-- UIScale: das HUD ist in festen Pixeln gebaut und wird fuer kleine
	-- Bildschirme heruntergerechnet. Referenz ist eine 1280 Pixel breite
	-- Ansicht; darunter wird verkleinert, darueber nicht vergroessert
	-- (sonst wirkt das HUD auf dem Monitor klobig).
	-- ---------------------------------------------------------------
	SCALE_REFERENCE_WIDTH = 1280,
	SCALE_MIN = 0.7,
	SCALE_MAX = 1,
}

return Theme
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="KC142">
<Properties>
<string name="Name">WorldLayout</string>
<ProtectedString name="Source">--!strict
-- Wo was in der Welt steht. Reine Rechnung, kein Roblox-API - damit der
-- Server und das Build-Script (tools/build-rbxlx.mjs) dieselben Positionen
-- benutzen und die Vorschau in der Studio-Datei exakt dem entspricht, was
-- beim Druecken von Play entsteht.

local WorldConfig = require(script.Parent.Config.WorldConfig)

local WorldLayout = {}

export type Box = { size: Vector3, position: Vector3 }

function WorldLayout.plotPosition(index: number): Vector3
	local origin = WorldConfig.PLOT_ORIGIN
	local offset = (index - 1) * WorldConfig.PLOT_SPACING
	local centering = (WorldConfig.PLOT_COUNT - 1) * WorldConfig.PLOT_SPACING / 2
	return Vector3.new(origin.X + offset - centering, origin.Y, origin.Z)
end

function WorldLayout.signPosition(plotCenter: Vector3): Vector3
	return Vector3.new(plotCenter.X, plotCenter.Y + 8, plotCenter.Z + WorldConfig.PLOT_SIZE.Z / 2)
end

function WorldLayout.slotPosition(plotCenter: Vector3, slotIndex: number): Vector3
	local columns = WorldConfig.SLOT_COLUMNS
	local col = (slotIndex - 1) % columns
	local row = math.floor((slotIndex - 1) / columns)
	local spacing = WorldConfig.SLOT_SPACING
	local xOffset = (col - (columns - 1) / 2) * spacing
	local zOffset = (row - 1) * spacing
	local top = plotCenter.Y + WorldConfig.PLOT_SIZE.Y / 2 + WorldConfig.KEY_SIZE.Y / 2
	return Vector3.new(plotCenter.X + xOffset, top, plotCenter.Z + zOffset)
end

-- Streifen vor der Plotreihe. Verbindet alle Plots - zwischen zweien liegen
-- sonst PLOT_SPACING - PLOT_SIZE.X Studs Luecke.
function WorldLayout.promenade(): Box
	local origin = WorldConfig.PLOT_ORIGIN
	local z = origin.Z + WorldConfig.PLOT_SIZE.Z / 2 + WorldConfig.PROMENADE_DEPTH / 2
	return {
		size = Vector3.new(
			WorldConfig.PLOT_COUNT * WorldConfig.PLOT_SPACING,
			WorldConfig.PLOT_SIZE.Y,
			WorldConfig.PROMENADE_DEPTH
		),
		position = Vector3.new(origin.X, origin.Y, z),
	}
end

-- Weg von der Promenade bis hinter das letzte Pad.
function WorldLayout.path(): Box
	local origin = WorldConfig.PLOT_ORIGIN
	local promenade = WorldLayout.promenade()
	local startZ = promenade.position.Z + WorldConfig.PROMENADE_DEPTH / 2

	local farthestZ = 0
	for _, position in WorldConfig.STAGE_PAD_POSITIONS do
		farthestZ = math.min(farthestZ, position.Z)
	end
	local endZ = farthestZ - WorldConfig.STAGE_PAD_SIZE.Z / 2 - WorldConfig.PATH_MARGIN

	return {
		size = Vector3.new(WorldConfig.PATH_WIDTH, WorldConfig.PLOT_SIZE.Y, startZ - endZ),
		position = Vector3.new(origin.X, origin.Y, (startZ + endZ) / 2),
	}
end

-- Maximale Sprungweite bei gegebener WalkSpeed. Schiefer Wurf, gleiche
-- Hoehe: t = 2 * v0 / g, d = speed * t.
function WorldLayout.jumpDistance(speed: number): number
	local flugzeit = 2 * WorldConfig.JUMP_POWER / WorldConfig.JUMP_GRAVITY
	return speed * flugzeit
end

-- Wie schnell muss man mindestens sein, um diese Luecke zu schaffen?
function WorldLayout.speedForGap(gap: number): number
	local flugzeit = 2 * WorldConfig.JUMP_POWER / WorldConfig.JUMP_GRAVITY
	return gap / flugzeit
end

-- Die tatsaechlich zu ueberspringende Strecke einer Stage. Nicht die
-- Luecke: wer seitlich versetzt springt, legt die Diagonale zurueck.
function WorldLayout.stageJumpDistance(stageIndex: number): number
	local stage = WorldConfig.STAGES[stageIndex]
	assert(stage ~= nil, "unbekannte Stage: " .. tostring(stageIndex))
	local seitlich = stage.sideways * 2
	return math.sqrt(stage.gap ^ 2 + seitlich ^ 2)
end

-- Die Plattformen einer Stage, von der Promenade weg Richtung Pad.
-- Jede Plattform ist eine Riesen-Tastenkappe; zwischen ihnen liegt die
-- Luecke aus WorldConfig.STAGES.
export type Platform = { size: Vector3, position: Vector3, moves: boolean }

function WorldLayout.stagePlatforms(stageIndex: number): { Platform }
	local stage = WorldConfig.STAGES[stageIndex]
	assert(stage ~= nil, "unbekannte Stage: " .. tostring(stageIndex))

	local origin = WorldConfig.PLOT_ORIGIN
	-- Start: hinter der Promenade bei Stage 1, sonst hinter dem vorigen Pad.
	local startZ
	if stageIndex == 1 then
		local promenade = WorldLayout.promenade()
		startZ = promenade.position.Z - WorldConfig.PROMENADE_DEPTH / 2
	else
		local vorigesPad = WorldConfig.STAGE_PAD_POSITIONS[stageIndex - 1]
		startZ = vorigesPad.Z - WorldConfig.STAGE_PAD_SIZE.Z / 2
	end
	local endZ = WorldConfig.STAGE_PAD_POSITIONS[stageIndex].Z + WorldConfig.STAGE_PAD_SIZE.Z / 2

	local schritt = stage.depth + stage.gap
	local strecke = startZ - endZ
	local anzahl = math.max(1, math.floor(strecke / schritt))

	local platforms: { Platform } = {}
	for i = 1, anzahl do
		-- Erste Plattform eine Luecke hinter dem Start, letzte eine Luecke
		-- vor dem Pad - so ist der Ein- und Ausstieg derselbe Sprung.
		local z = startZ - stage.gap - stage.depth / 2 - (i - 1) * schritt
		local seitlich = 0
		if stage.sideways &gt; 0 then
			seitlich = if i % 2 == 0 then stage.sideways else -stage.sideways
		end
		table.insert(platforms, {
			size = Vector3.new(stage.width, WorldConfig.PLOT_SIZE.Y, stage.depth),
			position = Vector3.new(origin.X + seitlich, origin.Y, z),
			moves = stage.moves and i % WorldConfig.MOVING_EVERY == 0,
		})
	end
	return platforms
end

return WorldLayout
</ProtectedString>
</Properties>
</Item>
</Item>
</Item>
<Item class="ServerScriptService" referent="KC167">
<Properties>
<string name="Name">ServerScriptService</string>
</Properties>
<Item class="Script" referent="KC158">
<Properties>
<string name="Name">KeycapRush</string>
<ProtectedString name="Source">--!strict
-- Startet alle Services in fester Reihenfolge.
--
-- Die Reihenfolge ist nicht beliebig:
--   Remotes zuerst, sonst sucht ein Client sie vergeblich.
--   Plots bauen, dann NPC-Plots belegen, dann erst Spieler zulassen -
--   sonst nimmt ein frueh beigetretener Spieler den Platz eines NPC-Plots.
--   StealService vor allem, was Tasten erzeugen kann.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
require(Shared:WaitForChild("Remotes")) -- legt die RemoteEvents an

local WorldConfig = require(Shared:WaitForChild("Config"):WaitForChild("WorldConfig"))

local Services = script:WaitForChild("Services")

local DataService = require(Services.DataService)
local LightingService = require(Services.LightingService)
local PlotService = require(Services.PlotService)
local NpcPlotService = require(Services.NpcPlotService)
local ProductionService = require(Services.ProductionService)
local SpeedService = require(Services.SpeedService)
local CarryService = require(Services.CarryService)
local TutorialService = require(Services.TutorialService)
local CourseService = require(Services.CourseService)
local StealService = require(Services.StealService)
local ShopService = require(Services.ShopService)
local RunTimerService = require(Services.RunTimerService)
local StateService = require(Services.StateService)

print("[KEYCAP] Server startet ...")

-- Die Studio-Datei enthaelt eine gebackene Vorschau der Welt, damit beim
-- Oeffnen nicht nur ein leerer Boden dasteht. Der Server baut dieselbe Welt
-- gleich selbst - die Vorschau muss also weg, sonst haengt alles doppelt drin.
local vorschau = workspace:FindFirstChild("WeltVorschau")
if vorschau then
	vorschau:Destroy()
	print("[KEYCAP] Gebackene Vorschau entfernt, Server baut die Welt neu")
end

DataService.start()
LightingService.start()
PlotService.buildWorld()
NpcPlotService.start()
PlotService.start()
TutorialService.start()
CourseService.start()
ProductionService.start()
SpeedService.start()
CarryService.start()
StealService.start()
ShopService.start()
RunTimerService.start()
StateService.start()

-- Part-Budget: die Bewertung nennt 3000 als Ziel. Hier steht, wo wir
-- wirklich landen - wenn die Zahl beim Bauen der Karte steigt, faellt es
-- beim Serverstart auf und nicht erst auf dem Handy.
local parts = PlotService.countParts()
if parts &gt; WorldConfig.PART_BUDGET then
	warn(("[KEYCAP] Part-Budget gerissen: %d von %d"):format(parts, WorldConfig.PART_BUDGET))
else
	print(("[KEYCAP] Parts in workspace: %d von %d erlaubt"):format(parts, WorldConfig.PART_BUDGET))
end

print("[KEYCAP] Server bereit.")
</ProtectedString>
</Properties>
<Item class="Folder" referent="KC157">
<Properties>
<string name="Name">Services</string>
</Properties>
<Item class="ModuleScript" referent="KC144">
<Properties>
<string name="Name">CarryService</string>
<ProtectedString name="Source">--!strict
-- Sichtbares Tragen der Beute.
--
-- Die Bewertung nennt das den Clip-Moment: "Diebstahl muss fuer Umstehende
-- lesbar sein, sonst passiert er sozial gar nicht." Wer klaut, traegt die
-- Taste ueber dem Kopf, ist langsamer (SpeedService) und ist damit fuer
-- alle als Dieb erkennbar.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local EconomyConfig = require(Shared.Config.EconomyConfig)
local WorldConfig = require(Shared.Config.WorldConfig)
local Theme = require(Shared.Theme)

local CarryService = {}

local active: { [number]: Model } = {} -- userId -&gt; Trage-Modell

local function clear(userId: number)
	local model = active[userId]
	if model then
		model:Destroy()
		active[userId] = nil
	end
end

-- Haengt eine sichtbare Taste ueber den Kopf des Diebes. Wird nach
-- CARRY_SECONDS automatisch entfernt.
function CarryService.show(player: Player, rarity: string, vorrat: number)
	clear(player.UserId)

	local character = player.Character
	local head = character and character:FindFirstChild("Head")
	if not head or not head:IsA("BasePart") then
		return
	end

	local model = Instance.new("Model")
	model.Name = "Beute"

	local part = Instance.new("Part")
	part.Name = "Key"
	part.Size = WorldConfig.KEY_SIZE * 0.5
	part.CFrame = head.CFrame * CFrame.new(0, 3.5, 0)
	part.Anchored = false
	part.CanCollide = false
	part.CanQuery = false
	part.Massless = true -- darf die Physik des Diebes nicht veraendern
	part.Material = Enum.Material.SmoothPlastic
	part.Color = Theme.RARITY_COLORS[rarity] or Theme.WORLD.PLATE
	part.Parent = model

	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.new(0, 190, 0, 46)
	billboard.StudsOffset = Vector3.new(0, 2.4, 0)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = 260

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.Font = Theme.FONT
	label.TextScaled = true
	label.TextColor3 = Theme.RED
	label.TextStrokeTransparency = 0.35
	label.Text = ("BEUTE: %s (%d)"):format(rarity, vorrat)
	label.Parent = billboard
	billboard.Parent = part

	-- Reihenfolge zaehlt: erst in die Welt haengen, dann schweissen. Andersherum
	-- ist das Teil einen Frame lang ein freier Koerper und faellt sichtbar weg.
	-- Zwischen diesen Zeilen wird nicht geyieldet, also sieht die Physik nie
	-- einen ungeschweissten Zustand.
	model.Parent = character

	local weld = Instance.new("WeldConstraint")
	weld.Part0 = head
	weld.Part1 = part
	weld.Parent = part

	active[player.UserId] = model

	task.delay(EconomyConfig.CARRY_SECONDS, function()
		if active[player.UserId] == model then
			clear(player.UserId)
		end
	end)
end

function CarryService.start()
	Players.PlayerRemoving:Connect(function(player)
		clear(player.UserId)
	end)
	-- Beim Respawn haengt nichts mehr am neuen Charakter - Zustand
	-- aufraeumen, damit kein verwaistes Modell zurueckbleibt.
	local function watch(player: Player)
		player.CharacterAdded:Connect(function()
			clear(player.UserId)
		end)
	end
	for _, player in Players:GetPlayers() do
		watch(player)
	end
	Players.PlayerAdded:Connect(watch)
	print("[KEYCAP] CarryService laeuft (" .. EconomyConfig.CARRY_SECONDS .. "s sichtbar)")
end

return CarryService
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="KC145">
<Properties>
<string name="Name">CourseService</string>
<ProtectedString name="Source">--!strict
-- Parcours: Speed-Tore und Cash-Out-Pads.
--
-- Auszahlen ist bewusst ein ProximityPrompt, kein Beruehrungs-Trigger:
-- ein versehentlicher Vorrat-Reset waere der schlimmste Moment im Spiel.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local EconomyConfig = require(Shared.Config.EconomyConfig)
local EconomyLogic = require(Shared.EconomyLogic)
local WorldConfig = require(Shared.Config.WorldConfig)
local Theme = require(Shared.Theme)
local WorldLayout = require(Shared.WorldLayout)
local Remotes = require(Shared.Remotes)
local DataService = require(script.Parent.DataService)
local ProductionService = require(script.Parent.ProductionService)
local RunTimerService = require(script.Parent.RunTimerService)
local TutorialService = require(script.Parent.TutorialService)

local CourseService = {}

local pads: { BasePart } = {}
local lastBlock: { [number]: number } = {} -- userId -&gt; os.clock, entprellt das Tor

local function notify(player: Player, text: string)
	Remotes.get("Notify"):FireClient(player, text)
end

-- Kein Tor mehr, sondern ein Schild. Die alte Wand war CanCollide = false
-- und schob bei Beruehrung 12 Studs zurueck, entprellt mit 1,5 s - ein
-- Spieler mit Basis-Speed 16 legt in dieser Zeit 24 Studs zurueck und kam
-- mit +12 Studs pro Zyklus einfach durch. Jetzt ist die Sprungweite das
-- Gate, und das Schild sagt nur, was man dafuer braucht.
local function buildSign(stageIndex: number)
	-- Die Diagonale, nicht die Luecke - sonst nennt das Schild eine zu
	-- niedrige Zahl und der Spieler faellt trotzdem.
	local noetig = WorldLayout.speedForGap(WorldLayout.stageJumpDistance(stageIndex))

	local board = Instance.new("Part")
	board.Name = "StageSign" .. stageIndex
	board.Size = WorldConfig.STAGE_GATE_SIZE
	board.Position = WorldConfig.STAGE_GATE_POSITIONS[stageIndex]
	board.Anchored = true
	board.CanCollide = false
	board.CanQuery = false
	board.Material = Enum.Material.Neon
	board.Color = Theme.WORLD.SIGNAL_DIM
	board.Transparency = 0.35
	board.Parent = workspace

	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.new(0, 320, 0, 90)
	billboard.StudsOffset = Vector3.new(0, 8, 0)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = 400

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.Font = Theme.FONT
	label.TextScaled = true
	label.TextColor3 = Theme.WORLD.SIGNAL
	label.TextStrokeTransparency = 0.3
	label.Text = ("STAGE %d\nSpruenge ab Tempo %d"):format(stageIndex, math.ceil(noetig))
	label.Parent = billboard
	billboard.Parent = board
end

local function cashOut(player: Player, stageIndex: number, pad: BasePart)
	local profile = DataService.get(player)
	if not profile then
		return
	end

	-- Distanz serverseitig nachpruefen, nicht dem Prompt vertrauen.
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then
		return
	end
	if (root.Position - pad.Position).Magnitude &gt; pad.Size.X then
		return
	end

	local vorrat = ProductionService.totalVorrat(profile)
	if not EconomyLogic.canEnterStage(vorrat, stageIndex) then
		notify(player, "Du bist zu langsam fuer dieses Pad.")
		return
	end

	local wins = EconomyLogic.payout(vorrat, stageIndex)
	if wins &lt;= 0 then
		notify(player, "Zu wenig Vorrat - das lohnt sich noch nicht.")
		return
	end

	profile.wins += wins
	profile.totalCashedOut += wins
	for _, key in profile.keys do
		key.vorrat = 0 -- Auszahlen leert ALLE Tasten
	end

	DataService.syncLeaderstats(player)
	RunTimerService.markCashOut(player, stageIndex)
	TutorialService.report(player, "cashout")
	notify(player, ("+%d Wins ausgezahlt (Stage %d)."):format(wins, stageIndex))
	-- Die Belohnung braucht mehr als eine Zeile oben am Rand: der Vorrat
	-- ist gerade komplett weg, das muss sich gross anfuehlen.
	Remotes.get("Alert"):FireClient(player, {
		kind = "cashout",
		title = ("+%d"):format(wins),
		body = ("Wins - Vorrat %d geleert an Stage %d"):format(vorrat, stageIndex),
	})
end

local function buildPad(stageIndex: number)
	local pad = Instance.new("Part")
	pad.Name = "CashOut" .. stageIndex
	pad.Size = WorldConfig.STAGE_PAD_SIZE
	pad.Position = WorldConfig.STAGE_PAD_POSITIONS[stageIndex]
	pad.Anchored = true
	pad.TopSurface = Enum.SurfaceType.Smooth
	pad.Material = Enum.Material.Neon
	pad.Color = Theme.WORLD.SIGNAL
	pad.Parent = workspace
	pads[stageIndex] = pad

	-- Podest unter dem Pad: derselbe Aufbau wie Plotplatte auf Chassis und
	-- Knopf auf Unterkante. Aus der Entfernung wird daraus ein Ziel statt
	-- eines Flecks im Boden.
	local ring = Instance.new("Part")
	ring.Name = "CashOutRing" .. stageIndex
	ring.Size = Vector3.new(
		WorldConfig.STAGE_PAD_SIZE.X + WorldConfig.PAD_RING_OVERHANG * 2,
		WorldConfig.PAD_RING_HEIGHT,
		WorldConfig.STAGE_PAD_SIZE.Z + WorldConfig.PAD_RING_OVERHANG * 2
	)
	ring.Position = pad.Position
		- Vector3.new(0, WorldConfig.STAGE_PAD_SIZE.Y / 2 + WorldConfig.PAD_RING_HEIGHT / 2, 0)
	ring.Anchored = true
	ring.TopSurface = Enum.SurfaceType.Smooth
	ring.BottomSurface = Enum.SurfaceType.Smooth
	ring.Material = Theme.WORLD.PLATE_MATERIAL
	ring.Color = Theme.WORLD.SIGNAL_DIM
	ring.Parent = workspace

	local factors = EconomyLogic.payoutFactors()

	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.new(0, 280, 0, 80)
	billboard.StudsOffset = Vector3.new(0, 7, 0)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = 300

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.Font = Theme.FONT
	label.TextScaled = true
	label.TextColor3 = Theme.TEXT
	label.TextStrokeTransparency = 0.4
	label.Text = ("AUSZAHLEN %d\n%.1f%% vom Vorrat"):format(stageIndex, factors[stageIndex] * 100)
	label.Parent = billboard
	billboard.Parent = pad

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Auszahlen"
	prompt.ObjectText = "Stage " .. stageIndex
	prompt.HoldDuration = EconomyConfig.CASHOUT_HOLD_SECONDS
	prompt.MaxActivationDistance = 14
	prompt.RequiresLineOfSight = false
	prompt.Parent = pad
	prompt.Triggered:Connect(function(player)
		cashOut(player, stageIndex, pad)
	end)
end

-- Boden. Die Plots stehen mit Luecke nebeneinander und der Parcours haengt
-- in der Luft - ohne diese beiden Flaechen faellt jeder Spieler beim ersten
-- Schritt vom Plot herunter.
-- Boden. Die Plots stehen mit Luecke nebeneinander und der Parcours haengt
-- in der Luft - ohne diese beiden Flaechen faellt jeder Spieler beim ersten
-- Schritt vom Plot herunter. Die Masse kommen aus WorldLayout, damit die
-- Vorschau in der Studio-Datei exakt dasselbe zeigt.
local function slab(name: string, box, farbe: Color3, material: Enum.Material): BasePart
	local part = Instance.new("Part")
	part.Name = name
	part.Size = box.size
	part.Position = box.position
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Material = material
	part.Color = farbe
	part.Parent = workspace
	return part
end

-- Die Promenade verbindet die Plots. Der lange, ebene Weg dahinter ist
-- WEG - an seiner Stelle steht jetzt der Parcours. Ein huebscher leerer
-- Gang bleibt ein leerer Gang.
local function buildGround()
	slab("Promenade", WorldLayout.promenade(), Theme.WORLD.PATH, Theme.WORLD.PATH_MATERIAL)
end

-- Eine Plattform ist eine Riesen-Tastenkappe: Koerper plus schmalere
-- Deckplatte, dieselbe Silhouette wie die Tasten auf den Plots.
local function buildPlatform(stageIndex: number, index: number, platform): BasePart
	local koerper = Instance.new("Part")
	koerper.Name = ("Stage%dPlatform%d"):format(stageIndex, index)
	koerper.Size = platform.size
	koerper.Position = platform.position
	koerper.Anchored = true
	koerper.TopSurface = Enum.SurfaceType.Smooth
	koerper.Material = Theme.WORLD.PLATE_MATERIAL
	koerper.Color = Theme.WORLD.PLATE
	koerper.Parent = workspace

	local deckel = Instance.new("Part")
	deckel.Name = koerper.Name .. "Top"
	deckel.Size = Vector3.new(
		platform.size.X * WorldConfig.KEY_TOP_INSET,
		WorldConfig.KEY_TOP_HEIGHT,
		platform.size.Z * WorldConfig.KEY_TOP_INSET
	)
	deckel.Position = platform.position
		+ Vector3.new(0, platform.size.Y / 2 + WorldConfig.KEY_TOP_HEIGHT / 2, 0)
	deckel.Anchored = true
	deckel.TopSurface = Enum.SurfaceType.Smooth
	deckel.Material = Theme.WORLD.CHASSIS_MATERIAL
	deckel.Color = Theme.WORLD.CHASSIS
	deckel.Parent = workspace

	if platform.moves then
		-- Senkrecht, langsam, kleine Amplitude.
		-- ungeprueft: ob ein verankerter Part per CFrame-Tween den Spieler
		-- zuverlaessig traegt. Die Recherche sagt: waagerecht nein,
		-- senkrecht ueber die Kollisionsaufloesung ruckelig ja. Deshalb
		-- nur 4 Studs Hub und 2,6 s pro Richtung.
		local info = TweenInfo.new(
			WorldConfig.MOVING_SECONDS,
			Enum.EasingStyle.Sine,
			Enum.EasingDirection.InOut,
			-1, -- endlos
			true -- hin und zurueck
		)
		local hub = Vector3.new(0, WorldConfig.MOVING_AMPLITUDE, 0)
		TweenService:Create(koerper, info, { Position = platform.position + hub }):Play()
		TweenService:Create(deckel, info, { Position = deckel.Position + hub }):Play()
	end

	return koerper
end

-- Absturz setzt an den Anfang DER STAGE zurueck, nicht auf den Plot.
-- Fehler kostet Zeit, nicht den Lauf.
function CourseService.startFallWatch()
	local accumulator = 0
	RunService.Heartbeat:Connect(function(deltaTime)
		accumulator += deltaTime
		if accumulator &lt; 0.25 then
			return
		end
		accumulator = 0

		for _, player in Players:GetPlayers() do
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if not root or not root:IsA("BasePart") or root.Position.Y &gt; WorldConfig.FALL_Y then
				continue
			end
			-- Welche Stage war das? Die, deren Plattformen den Absturzort
			-- in Z umschliessen; sonst zurueck auf die Promenade.
			local ziel = WorldLayout.promenade().position + Vector3.new(0, 6, 0)
			for stageIndex = 1, #WorldConfig.STAGES do
				local platforms = WorldLayout.stagePlatforms(stageIndex)
				local erste, letzte = platforms[1], platforms[#platforms]
				if erste and letzte and root.Position.Z &lt;= erste.position.Z and root.Position.Z &gt;= letzte.position.Z then
					ziel = erste.position + Vector3.new(0, 6, 0)
					break
				end
			end
			character:PivotTo(CFrame.new(ziel))
		end
	end)
end

function CourseService.start()
	buildGround()
	local plattformen = 0
	for stageIndex = 1, #WorldConfig.STAGES do
		buildSign(stageIndex)
		buildPad(stageIndex)
		for index, platform in WorldLayout.stagePlatforms(stageIndex) do
			buildPlatform(stageIndex, index, platform)
			plattformen += 1
		end
	end
	CourseService.startFallWatch()
	local duration, cooldown = EconomyLogic.shieldWindow()
	print(("[KEYCAP] CourseService: %d Stages, %d Plattformen, Schild %ds/%ds"):format(#pads, plattformen, duration, cooldown))
end

return CourseService
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="KC146">
<Properties>
<string name="Name">DataService</string>
<ProtectedString name="Source">--!strict
-- Profil-Speicher mit Session-Lock, Autosave und Speichern beim Verlassen.
--
-- Warum handgeschrieben statt ProfileService: das Konzept verbietet fremde
-- Bibliotheken. Der Lock ist deshalb hier drin - ohne ihn koennen zwei
-- Server dasselbe Profil schreiben und beim Server-Hopping gehen Tasten
-- verloren oder verdoppeln sich.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local EconomyConfig = require(Shared.Config.EconomyConfig)

-- 2: tutorialStep dazu. Profile aus Version 1 bekommen ihn per Migration
-- auf 1 gesetzt und laufen das Tutorial einmal - das Spiel ist nie
-- veroeffentlicht worden, es gibt also niemanden, den das stoert.
local SCHEMA_VERSION = 2
local STORE_NAME = "KeycapRush_Profiles_v1"
local LOCK_STALE_SECONDS = 120 -- aelterer Lock gilt als abgestuerzter Server
-- Ein Schreibvorgang erneuert Daten UND Lock, deshalb nur ein Intervall.
-- Nicht bei jeder Aenderung speichern - der Vorrat waechst sekuendlich und
-- DataStore drosselt Schreibvorgaenge.
local AUTOSAVE_SECONDS = 45
local MAX_RETRIES = 4

export type Key = { rarity: string, vorrat: number }
export type Profile = {
	schemaVersion: number,
	wins: number,
	slots: number,
	keys: { Key },
	totalStolen: number,
	totalCashedOut: number,
	tutorialStep: number,
}

local DataService = {}
DataService.__index = DataService

local store = DataStoreService:GetDataStore(STORE_NAME)
local profiles: { [number]: Profile } = {}
local loading: { [number]: boolean } = {}

local function defaultProfile(): Profile
	local keys: { Key } = {}
	-- Startausstattung: zwei Common-Tasten, damit sofort etwas produziert.
	for _ = 1, 2 do
		table.insert(keys, { rarity = "Common", vorrat = 0 })
	end
	return {
		schemaVersion = SCHEMA_VERSION,
		wins = 0,
		slots = EconomyConfig.START_KEY_SLOTS,
		keys = keys,
		totalStolen = 0,
		totalCashedOut = 0,
		tutorialStep = 1,
	}
end

-- Generische Migration: fehlende Felder aus dem Default auffuellen. Kein
-- Loeschen unbekannter Felder, damit ein Rollback nichts vernichtet.
local function migrate(raw: any): Profile
	local base = defaultProfile()
	if type(raw) ~= "table" then
		return base
	end
	for field, value in base :: any do
		if raw[field] == nil then
			raw[field] = value
		end
	end
	raw.schemaVersion = SCHEMA_VERSION
	-- Vorrat wird bewusst nicht uebernommen (siehe PERSIST_VORRAT).
	if not EconomyConfig.PERSIST_VORRAT then
		for _, key in raw.keys do
			key.vorrat = 0
		end
	end
	return raw :: Profile
end

local function retry&lt;T&gt;(label: string, fn: () -&gt; T): (boolean, T?)
	local delaySeconds = 1
	for attempt = 1, MAX_RETRIES do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		warn(("[DataService] %s fehlgeschlagen (Versuch %d): %s"):format(label, attempt, tostring(result)))
		if attempt &lt; MAX_RETRIES then
			task.wait(delaySeconds)
			delaySeconds *= 2
		end
	end
	return false, nil
end

local function storeKey(userId: number): string
	return "player_" .. userId
end

-- Lock nehmen und Profil holen. Gibt nil zurueck, wenn ein anderer Server
-- das Profil noch haelt - dann darf der Spieler NICHT spielen.
local function acquire(userId: number): Profile?
	local jobId = if RunService:IsStudio() then "studio" else game.JobId
	local blocked = false
	local loaded: any = nil

	-- Ein einziger UpdateAsync: Lock nehmen UND die Daten mitlesen. Ein
	-- zusaetzliches GetAsync waere ein zweiter Request ohne Mehrwert.
	local ok = retry("Lock " .. userId, function()
		blocked = false
		loaded = nil
		store:UpdateAsync(storeKey(userId), function(raw)
			local entry = raw
			if type(entry) ~= "table" or entry.data == nil then
				entry = { lock = nil, data = entry }
			end
			local lock = entry.lock
			if lock and lock.jobId ~= jobId and (os.time() - (lock.at or 0)) &lt; LOCK_STALE_SECONDS then
				blocked = true
				return nil -- nichts schreiben, fremder Lock ist frisch
			end
			entry.lock = { jobId = jobId, at = os.time() }
			loaded = entry.data
			return entry
		end)
		return true
	end)

	if not ok or blocked then
		return nil
	end
	return migrate(loaded)
end

local function write(userId: number, profile: Profile, releaseLock: boolean): boolean
	local jobId = if RunService:IsStudio() then "studio" else game.JobId
	local ok = retry("Speichern " .. userId, function()
		store:UpdateAsync(storeKey(userId), function(raw)
			local entry = if type(raw) == "table" and raw.data ~= nil then raw else { lock = nil }
			local lock = entry.lock
			-- Nur schreiben, wenn wir den Lock halten (oder er verwaist ist).
			if lock and lock.jobId ~= jobId and (os.time() - (lock.at or 0)) &lt; LOCK_STALE_SECONDS then
				return nil
			end
			entry.data = profile
			entry.lock = if releaseLock then nil else { jobId = jobId, at = os.time() }
			return entry
		end)
		return true
	end)
	return ok
end

function DataService.get(player: Player): Profile?
	return profiles[player.UserId]
end

function DataService.save(player: Player, releaseLock: boolean): boolean
	local profile = profiles[player.UserId]
	if not profile then
		return false
	end
	return write(player.UserId, profile, releaseLock)
end

local function onPlayerAdded(player: Player)
	loading[player.UserId] = true
	local profile = acquire(player.UserId)
	loading[player.UserId] = nil

	if not profile then
		if player.Parent then
			player:Kick("Deine Daten werden noch von einem anderen Server benutzt. Bitte in einer Minute nochmal beitreten.")
		end
		return
	end
	if not player.Parent then
		write(player.UserId, profile, true) -- schon wieder weg: Lock freigeben
		return
	end
	profiles[player.UserId] = profile

	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local wins = Instance.new("IntValue")
	wins.Name = "Wins"
	wins.Value = profile.wins
	wins.Parent = stats
	local stolen = Instance.new("IntValue")
	-- Die Bewertung: die Rangliste eines Klau-Spiels soll Beute zeigen.
	stolen.Name = "Beute"
	stolen.Value = profile.totalStolen
	stolen.Parent = stats
	stats.Parent = player
end

local function onPlayerRemoving(player: Player)
	if profiles[player.UserId] then
		write(player.UserId, profiles[player.UserId], true)
		profiles[player.UserId] = nil
	end
end

function DataService.syncLeaderstats(player: Player)
	local profile = profiles[player.UserId]
	local stats = player:FindFirstChild("leaderstats")
	if not profile or not stats then
		return
	end
	local wins = stats:FindFirstChild("Wins")
	if wins and wins:IsA("IntValue") then
		wins.Value = profile.wins
	end
	local stolen = stats:FindFirstChild("Beute")
	if stolen and stolen:IsA("IntValue") then
		stolen.Value = profile.totalStolen
	end
end

function DataService.start()
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end
	Players.PlayerAdded:Connect(function(player)
		task.spawn(onPlayerAdded, player)
	end)
	Players.PlayerRemoving:Connect(onPlayerRemoving)

	-- Autosave: erneuert in einem Zug die Daten und den Lock, damit kein
	-- anderer Server das Profil uebernimmt, solange der Spieler hier ist.
	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_SECONDS)
			for userId, profile in profiles do
				write(userId, profile, false)
			end
		end
	end)

	game:BindToClose(function()
		for userId, profile in profiles do
			write(userId, profile, true)
		end
	end)

	print("[KEYCAP] DataService bereit (Schema " .. SCHEMA_VERSION .. ")")
end

return DataService
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="KC147">
<Properties>
<string name="Name">LightingService</string>
<ProtectedString name="Source">--!strict
-- Beleuchtung: Schreibtisch bei Nacht.
--
-- Die Szene wird NICHT von der Sonne beleuchtet, sondern von zwei Quellen:
-- der Monitorflaeche am linken Rand und den leuchtenden Tasten selbst.
-- Deshalb steht die Sonne fast aus und die Uhrzeit kurz nach Mitternacht.
--
-- Wird beim Serverstart gesetzt statt in Studio geklickt, damit die Werte
-- versioniert sind und beim naechsten Rojo-Sync nicht verschwinden.
-- Keine Asset-IDs: eine Sky-Textur braeuchte eine hochgeladene Datei.

local Lighting = game:GetService("Lighting")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local WorldConfig = require(Shared.Config.WorldConfig)

local LightingService = {}

-- Vorhandene Effekte ersetzen statt stapeln: sonst haengt nach einem
-- zweiten Serverstart in Studio alles doppelt drin.
local function ersetze(klasse: string): Instance
	local alt = Lighting:FindFirstChildOfClass(klasse)
	if alt then
		alt:Destroy()
	end
	return Instance.new(klasse)
end

function LightingService.start()
	local config = WorldConfig.LIGHTING

	Lighting.Ambient = config.AMBIENT
	Lighting.OutdoorAmbient = config.OUTDOOR_AMBIENT
	Lighting.Brightness = config.BRIGHTNESS
	Lighting.ClockTime = config.CLOCK_TIME
	Lighting.GeographicLatitude = config.GEOGRAPHIC_LATITUDE
	Lighting.EnvironmentDiffuseScale = config.ENVIRONMENT_DIFFUSE
	Lighting.EnvironmentSpecularScale = config.ENVIRONMENT_SPECULAR
	Lighting.ExposureCompensation = config.EXPOSURE_COMPENSATION

	local atmosphere = ersetze("Atmosphere") :: Atmosphere
	atmosphere.Density = config.ATMOSPHERE_DENSITY
	atmosphere.Haze = config.ATMOSPHERE_HAZE
	atmosphere.Glare = config.ATMOSPHERE_GLARE
	atmosphere.Color = config.ATMOSPHERE_COLOR
	atmosphere.Decay = config.ATMOSPHERE_DECAY
	atmosphere.Parent = Lighting

	local bloom = ersetze("BloomEffect") :: BloomEffect
	bloom.Intensity = config.BLOOM_INTENSITY
	bloom.Size = config.BLOOM_SIZE
	bloom.Threshold = config.BLOOM_THRESHOLD
	bloom.Parent = Lighting

	local correction = ersetze("ColorCorrectionEffect") :: ColorCorrectionEffect
	correction.Brightness = config.CC_BRIGHTNESS
	correction.Contrast = config.CC_CONTRAST
	correction.Saturation = config.CC_SATURATION
	correction.TintColor = config.CC_TINT
	correction.Parent = Lighting

	local sunRays = ersetze("SunRaysEffect") :: SunRaysEffect
	sunRays.Intensity = config.SUNRAYS_INTENSITY
	sunRays.Spread = config.SUNRAYS_SPREAD
	sunRays.Parent = Lighting

	local depth = ersetze("DepthOfFieldEffect") :: DepthOfFieldEffect
	depth.FarIntensity = config.DOF_FAR_INTENSITY
	depth.FocusDistance = config.DOF_FOCUS_DISTANCE
	depth.InFocusRadius = config.DOF_IN_FOCUS_RADIUS
	depth.NearIntensity = config.DOF_NEAR_INTENSITY
	depth.Parent = Lighting

	LightingService.buildMonitor()

	-- Lighting.Technology laesst sich nach meinem Kenntnisstand NICHT zur
	-- Laufzeit setzen - es ist eine Eigenschaft der Place-Datei, nicht der
	-- Szene. Deshalb steht hier keine Zuweisung, sondern eine Meldung:
	-- Noah muss das einmal in Studio klicken. Wo, steht in der README.
	-- ungeprueft: bitte verifizieren, ob Technology doch schreibbar ist
	print(("[KEYCAP] LightingService: Nacht (Uhrzeit %.1f, Helligkeit %.1f, Bloom-Schwelle %.2f)")
		:format(config.CLOCK_TIME, config.BRIGHTNESS, config.BLOOM_THRESHOLD))
	print("[KEYCAP] HINWEIS: Lighting.Technology muss EINMAL in Studio auf Future gestellt werden.")
end

-- Der Monitor am Rand. Kein Objekt zum Anschauen, sondern die Lichtquelle,
-- die der ganzen Szene ihre Richtung gibt.
function LightingService.buildMonitor()
	local alt = workspace:FindFirstChild("Monitor")
	if alt then
		alt:Destroy()
	end

	local config = WorldConfig.LIGHTING
	local screen = Instance.new("Part")
	screen.Name = "Monitor"
	screen.Size = config.MONITOR_SIZE
	screen.Position = config.MONITOR_POSITION
	screen.Anchored = true
	screen.CanCollide = false
	screen.CanQuery = false
	screen.CastShadow = false
	screen.Material = Enum.Material.Neon
	screen.Color = config.MONITOR_COLOR
	screen.Transparency = config.MONITOR_TRANSPARENCY

	-- SurfaceLight statt PointLight: das Licht soll von einer FLAECHE
	-- kommen und in eine Richtung fallen, nicht kugelfoermig abstrahlen.
	local light = Instance.new("SurfaceLight")
	light.Face = Enum.NormalId.Right -- zeigt zur Spielflaeche
	light.Brightness = config.MONITOR_LIGHT_BRIGHTNESS
	light.Range = config.MONITOR_LIGHT_RANGE
	light.Color = config.MONITOR_COLOR
	light.Angle = 90
	light.Shadows = false -- Schatten von einer Flaechenquelle sind teuer
	light.Parent = screen

	screen.Parent = workspace
end

return LightingService
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="KC148">
<Properties>
<string name="Name">NpcPlotService</string>
<ProtectedString name="Source">--!strict
-- NPC-Plots: Klau-Ziele, die immer da sind.
--
-- Die Bewertung: "Der Loop braucht Mitspieler und du hast keine." Auf einem
-- frischen Server mit zwei Leuten waere KEYCAP RUSH ein Farm-Spiel mit
-- gelegentlichem Aergern. Diese Plots ueberbruecken das - bewusst schwach,
-- damit sie den Wettbewerb zwischen echten Spielern nicht ersetzen.

local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local EconomyConfig = require(Shared.Config.EconomyConfig)
local EconomyLogic = require(Shared.EconomyLogic)
local WorldConfig = require(Shared.Config.WorldConfig)
local PlotService = require(script.Parent.PlotService)

local NpcPlotService = {}

type NpcKey = { rarity: string, vorrat: number }
type NpcPlot = { plot: PlotService.Plot, keys: { NpcKey }, respawnAt: { [number]: number } }

local npcPlots: { [number]: NpcPlot } = {} -- plotIndex -&gt; NpcPlot
local LABEL_INTERVAL = 2

local function makeKeys(): { NpcKey }
	local keys: { NpcKey } = {}
	for index = 1, EconomyConfig.NPC_KEY_COUNT do
		local rarity = EconomyConfig.NPC_RARITIES[index] or "Common"
		table.insert(keys, { rarity = rarity, vorrat = 0 })
	end
	return keys
end

function NpcPlotService.isNpcPlot(plotIndex: number): boolean
	return npcPlots[plotIndex] ~= nil
end

function NpcPlotService.keysOf(plotIndex: number): { NpcKey }?
	local entry = npcPlots[plotIndex]
	return if entry then entry.keys else nil
end

-- Eine NPC-Taste wird geklaut: Vorrat wandert anteilig mit, die Taste
-- selbst bleibt als leerer Platzhalter stehen und fuellt sich wieder.
-- So gehen dem Server nie die Ziele aus.
function NpcPlotService.takeKey(plotIndex: number, keyIndex: number): NpcKey?
	local entry = npcPlots[plotIndex]
	if not entry then
		return nil
	end
	local key = entry.keys[keyIndex]
	if not key then
		return nil
	end
	if (entry.respawnAt[keyIndex] or 0) &gt; os.clock() then
		return nil -- diese Taste wurde gerade erst geleert
	end

	local taken = { rarity = key.rarity, vorrat = EconomyLogic.stealTransfer(key.vorrat) }
	key.vorrat = 0
	entry.respawnAt[keyIndex] = os.clock() + EconomyConfig.NPC_RESPAWN_SECONDS
	return taken
end

function NpcPlotService.start()
	for slot = 1, WorldConfig.NPC_PLOT_COUNT do
		local name = WorldConfig.NPC_NAMES[slot] or ("NPC " .. slot)
		local plot = PlotService.claimForNpc(slot, name)
		if plot then
			local entry: NpcPlot = { plot = plot, keys = makeKeys(), respawnAt = {} }
			npcPlots[plot.index] = entry
			PlotService.renderKeys(plot, entry.keys)
		end
	end

	local sinceLabel = 0
	RunService.Heartbeat:Connect(function(deltaTime)
		local now = os.clock()
		for _, entry in npcPlots do
			for keyIndex, key in entry.keys do
				if (entry.respawnAt[keyIndex] or 0) &gt; now then
					continue -- pausiert nach dem Klau
				end
				local rate = EconomyLogic.rarity(key.rarity).vorratPerSecond
				key.vorrat = math.min(key.vorrat + rate * deltaTime, EconomyConfig.NPC_VORRAT_CAP)
			end
		end

		sinceLabel += deltaTime
		if sinceLabel &gt;= LABEL_INTERVAL then
			sinceLabel = 0
			for _, entry in npcPlots do
				PlotService.refreshLabels(entry.plot, entry.keys)
			end
		end
	end)

	local count = 0
	for _ in npcPlots do
		count += 1
	end
	print(("[KEYCAP] NpcPlotService: %d NPC-Plots, Vorrat gedeckelt bei %d"):format(count, EconomyConfig.NPC_VORRAT_CAP))
end

return NpcPlotService
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="KC149">
<Properties>
<string name="Name">PlotService</string>
<ProtectedString name="Source">--!strict
-- Baut die Plots, vergibt sie an Spieler oder an NPC-Besitzer und haelt die
-- Tasten-Parts synchron mit der jeweiligen Tastenliste.
--
-- Ein Plot gehoert entweder niemandem, einem Spieler oder einem NPC. Die
-- Tasten-Parts sehen in allen Faellen gleich aus - ein Dieb soll nicht auf
-- den ersten Blick erkennen, ob es sich "lohnt", sondern hinlaufen muessen.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local EconomyConfig = require(Shared.Config.EconomyConfig)
local WorldConfig = require(Shared.Config.WorldConfig)
local Theme = require(Shared.Theme)
local WorldLayout = require(Shared.WorldLayout)
local DataService = require(script.Parent.DataService)

local PlotService = {}

export type OwnerKind = "none" | "player" | "npc"
export type Plot = {
	index: number,
	model: Model,
	base: BasePart,
	keyFolder: Folder,
	slotFolder: Folder,
	dome: BasePart,
	beacon: BasePart,
	ownerKind: OwnerKind,
	ownerUserId: number?,
	signLabel: TextLabel,
}
export type KeyRef = { kind: OwnerKind, userId: number?, plotIndex: number, index: number }

local plots: { Plot } = {}
local plotByUser: { [number]: Plot } = {}
-- Rueckweg vom Part zum Eintrag, damit StealService nichts raten muss.
local keyOwner: { [BasePart]: KeyRef } = {}
-- Schildzustand je Spieler. StealService MELDET ihn hierher, statt dass
-- PlotService ihn dort abfragt - sonst wuerden sich die beiden Module
-- gegenseitig require-n.
local shielded: { [number]: boolean } = {}

function PlotService.buildWorld()
	if built then
		return
	end
	built = true

	local container = Instance.new("Folder")
	container.Name = "Plots"

	for index = 1, WorldConfig.PLOT_COUNT do
		local model = Instance.new("Model")
		model.Name = "Plot" .. index

		local base = Instance.new("Part")
		base.Name = "Base"
		base.Size = WorldConfig.PLOT_SIZE
		base.Position = WorldLayout.plotPosition(index)
		base.Anchored = true
		base.TopSurface = Enum.SurfaceType.Smooth
		base.BottomSurface = Enum.SurfaceType.Smooth
		base.Color = Theme.WORLD.PLATE
		base.Material = Theme.WORLD.PLATE_MATERIAL
		base.Parent = model

		-- Chassis: etwas groesser und dunkler, sitzt unter der Platte. Damit
		-- liest sich der Plot als Tastatur-Gehaeuse statt als schwebende
		-- Scheibe. Dieselbe Sprache wie die Knopf-Unterkante im HUD.
		local deck = Instance.new("Part")
		deck.Name = "Deck"
		-- Das Chassis ist eine Wanne, kein Sockel: es reicht PLOT_RIM_HEIGHT
		-- ueber die Plattenoberkante und bildet damit den umlaufenden Rand
		-- einer Tastaturplatte - ohne einen zusaetzlichen Part.
		local deckHoehe = WorldConfig.PLOT_DECK_HEIGHT + WorldConfig.PLOT_SIZE.Y + WorldConfig.PLOT_RIM_HEIGHT
		deck.Size = Vector3.new(
			WorldConfig.PLOT_SIZE.X + WorldConfig.PLOT_DECK_OVERHANG * 2,
			deckHoehe,
			WorldConfig.PLOT_SIZE.Z + WorldConfig.PLOT_DECK_OVERHANG * 2
		)
		deck.Position = base.Position
			+ Vector3.new(0, WorldConfig.PLOT_SIZE.Y / 2 + WorldConfig.PLOT_RIM_HEIGHT - deckHoehe / 2, 0)
		deck.Anchored = true
		deck.TopSurface = Enum.SurfaceType.Smooth
		deck.BottomSurface = Enum.SurfaceType.Smooth
		deck.Color = Theme.WORLD.CHASSIS
		deck.Material = Theme.WORLD.CHASSIS_MATERIAL
		deck.Parent = model

		-- Leere Steckplaetze als flache Mulden. Sie werden EINMAL gebaut und
		-- danach nur ein- und ausgeblendet - renderKeys darf sie nicht
		-- zerstoeren, sonst kostet jeder Kauf und jeder Klau 20 Instanzen
		-- mehr.
		local slotFolder = Instance.new("Folder")
		slotFolder.Name = "Slots"
		for slot = 1, EconomyConfig.MAX_KEY_SLOTS do
			local marker = Instance.new("Part")
			marker.Name = "Slot" .. slot
			marker.Size = Vector3.new(
				WorldConfig.KEY_SIZE.X * WorldConfig.SLOT_MARKER_SCALE,
				WorldConfig.SLOT_MARKER_HEIGHT,
				WorldConfig.KEY_SIZE.Z * WorldConfig.SLOT_MARKER_SCALE
			)
			local raster = WorldLayout.slotPosition(base.Position, slot)
			marker.Position = Vector3.new(
				raster.X,
				base.Position.Y + WorldConfig.PLOT_SIZE.Y / 2 + WorldConfig.SLOT_MARKER_HEIGHT / 2,
				raster.Z
			)
			marker.Anchored = true
			marker.CanCollide = false
			marker.CanQuery = false
			marker.TopSurface = Enum.SurfaceType.Smooth
			marker.Color = Theme.WORLD.SOCKET
			marker.Material = Theme.WORLD.SOCKET_MATERIAL
			marker.Parent = slotFolder
		end
		slotFolder.Parent = model

		-- Schild: echte Tafel statt unsichtbarer Part. Der Text haengt
		-- weiterhin als BillboardGui darueber, damit er aus der Entfernung
		-- lesbar bleibt.
		local sign = Instance.new("Part")
		sign.Name = "Sign"
		sign.Size = WorldConfig.SIGN_BOARD_SIZE
		sign.Position = WorldLayout.signPosition(base.Position)
		sign.Anchored = true
		sign.CanCollide = false
		sign.TopSurface = Enum.SurfaceType.Smooth
		sign.Color = Theme.WORLD.PLATE
		sign.Material = Theme.WORLD.PLATE_MATERIAL
		sign.Parent = model

		local signEdge = Instance.new("SelectionBox")
		signEdge.Adornee = sign
		signEdge.Color3 = Theme.WORLD.SEAM
		signEdge.LineThickness = 0.06
		signEdge.SurfaceTransparency = 1
		signEdge.Parent = sign

		local billboard = Instance.new("BillboardGui")
		billboard.Name = "Label"
		billboard.Size = UDim2.new(0, 260, 0, 60)
		billboard.AlwaysOnTop = true
		billboard.MaxDistance = 220

		local label = Instance.new("TextLabel")
		label.Size = UDim2.new(1, 0, 1, 0)
		label.BackgroundTransparency = 1
		label.Font = Theme.FONT
		label.TextScaled = true
		label.TextColor3 = Theme.TEXT
		label.TextStrokeTransparency = 0.4
		label.Text = "Frei"
		label.Parent = billboard
		billboard.Parent = sign

		-- Schildkuppel. Halbdurchsichtig, mit sichtbarem Rand, normalerweise
		-- unsichtbar. Ein Text, der sagt "Schild ist an", waere aus zehn
		-- Metern nicht lesbar - eine Kuppel schon.
		local dome = Instance.new("Part")
		dome.Name = "Shield"
		dome.Shape = Enum.PartType.Ball
		local domeSize = WorldConfig.PLOT_SIZE.X * WorldConfig.SHIELD_DOME_SCALE
		dome.Size = Vector3.new(domeSize, domeSize, domeSize)
		dome.Position = base.Position
		dome.Anchored = true
		dome.CanCollide = false
		dome.CanQuery = false
		dome.CastShadow = false
		dome.Material = Enum.Material.Glass
		dome.Color = Theme.WORLD.SIGNAL
		dome.Transparency = 1 -- aus, bis das Schild laeuft
		dome.Parent = model

		local domeRim = Instance.new("SelectionBox")
		domeRim.Adornee = dome
		domeRim.Color3 = Theme.WORLD.SIGNAL
		domeRim.LineThickness = 0.08
		domeRim.SurfaceTransparency = 1
		domeRim.Visible = false
		domeRim.Parent = dome

		-- Beute-Leuchtturm. Als schmaler Neon-Part gebaut, NICHT als Beam:
		-- ein Beam wird jeden Frame kameraabhaengig neu ausgerichtet, ein
		-- verankerter Neon-Part kostet auf dem Handy nichts.
		local beacon = Instance.new("Part")
		beacon.Name = "Beacon"
		beacon.Size = Vector3.new(WorldConfig.BEACON_WIDTH, WorldConfig.BEACON_MIN_HEIGHT, WorldConfig.BEACON_WIDTH)
		beacon.Position = base.Position + Vector3.new(0, WorldConfig.BEACON_MIN_HEIGHT / 2, 0)
		beacon.Anchored = true
		beacon.CanCollide = false
		beacon.CanQuery = false
		beacon.CastShadow = false
		beacon.Material = Enum.Material.Neon
		beacon.Color = Theme.WORLD.SIGNAL
		beacon.Transparency = 1 -- aus, solange der Plot niemandem gehoert
		beacon.Parent = model

		local keyFolder = Instance.new("Folder")
		keyFolder.Name = "Keys"
		keyFolder.Parent = model

		model.PrimaryPart = base
		model.Parent = container

		plots[index] = {
			index = index,
			model = model,
			base = base,
			keyFolder = keyFolder,
			slotFolder = slotFolder,
			dome = dome,
			beacon = beacon,
			ownerKind = "none",
			ownerUserId = nil,
			signLabel = label,
		}
	end

	container.Parent = workspace
end

local function clearKeys(plot: Plot)
	for _, child in plot.keyFolder:GetChildren() do
		if child:IsA("BasePart") then
			keyOwner[child] = nil
		end
		child:Destroy()
	end
end

-- Belegte Steckplaetze verstecken ihre Mulde, freie zeigen sie. Die Parts
-- werden dabei nur ein- und ausgeblendet, nicht erzeugt oder zerstoert.
local function updateSlotMarkers(plot: Plot, belegt: number, slots: number)
	for slot = 1, EconomyConfig.MAX_KEY_SLOTS do
		local marker = plot.slotFolder:FindFirstChild("Slot" .. slot)
		if marker and marker:IsA("BasePart") then
			if slot &lt;= belegt then
				marker.Transparency = 1 -- unter der Taste, nicht sichtbar
			elseif slot &lt;= slots then
				marker.Transparency = 0 -- frei und kaufbar
			else
				marker.Transparency = 1 -- Steckplatz noch nicht gekauft
			end
		end
	end
end

-- Baut die Tasten-Parts eines Plots neu. `keys` ist die Liste, die dieser
-- Plot gerade haelt - beim Spieler das Profil, beim NPC die NPC-Liste.
function PlotService.renderKeys(plot: Plot, keys: { { rarity: string, vorrat: number } }, slots: number?)
	clearKeys(plot)
	updateSlotMarkers(plot, #keys, slots or #keys)

	for index, key in keys do
		-- Hoehe, Kantenlicht und Material haengen an der Seltenheit. Eine
		-- Legendary muss sich aus 20 m von einer Common unterscheiden
		-- lassen - daran haengt, ob ein Dieb weiss, wo der Weg sich lohnt.
		local rank = Theme.RARITY_RANK[key.rarity] or 1
		local crown = Theme.KEY_CROWN[key.rarity] or 1
		local extra = WorldConfig.KEY_SIZE.Y * (crown - 1)

		local part = Instance.new("Part")
		part.Name = "Key" .. index
		part.Size = Vector3.new(WorldConfig.KEY_SIZE.X, WorldConfig.KEY_SIZE.Y * crown, WorldConfig.KEY_SIZE.Z)
		-- Grundflaeche bleibt, die Taste waechst nach oben: das Raster aus
		-- WorldLayout.slotPosition passt weiter.
		part.Position = WorldLayout.slotPosition(plot.base.Position, index) + Vector3.new(0, extra / 2, 0)
		part.Anchored = true
		part.TopSurface = Enum.SurfaceType.Smooth
		part.Material = Theme.RARITY_MATERIAL[key.rarity] or Enum.Material.SmoothPlastic
		part.Color = Theme.RARITY_COLORS[key.rarity] or Theme.WORLD.PLATE

		-- Deckplatte: schmaler als der Koerper, sitzt oben drauf. Der
		-- Absatz dazwischen IST die Keycap-Silhouette.
		local top = Instance.new("Part")
		top.Name = "Top"
		top.Size = Vector3.new(
			WorldConfig.KEY_SIZE.X * WorldConfig.KEY_TOP_INSET,
			WorldConfig.KEY_TOP_HEIGHT,
			WorldConfig.KEY_SIZE.Z * WorldConfig.KEY_TOP_INSET
		)
		top.Position = part.Position
			+ Vector3.new(0, part.Size.Y / 2 + WorldConfig.KEY_TOP_HEIGHT / 2, 0)
		top.Anchored = true
		top.CanCollide = false
		top.TopSurface = Enum.SurfaceType.Smooth
		top.Material = part.Material
		top.Color = part.Color
		top.Parent = plot.keyFolder

		-- Stem-Ring: dunkel, schmaler, setzt die Kappe vom Sockel ab.
		local stem = Instance.new("Part")
		stem.Name = "Stem"
		stem.Size = Vector3.new(
			WorldConfig.KEY_SIZE.X * WorldConfig.KEY_STEM_INSET,
			WorldConfig.KEY_STEM_HEIGHT,
			WorldConfig.KEY_SIZE.Z * WorldConfig.KEY_STEM_INSET
		)
		stem.Position = part.Position
			- Vector3.new(0, part.Size.Y / 2 - WorldConfig.KEY_STEM_HEIGHT / 2, 0)
		stem.Anchored = true
		stem.CanCollide = false
		stem.TopSurface = Enum.SurfaceType.Smooth
		stem.Material = Theme.WORLD.SOCKET_MATERIAL
		stem.Color = Theme.RARITY_EDGE[key.rarity] or Theme.WORLD.SEAM
		stem.Parent = plot.keyFolder

		-- Licht ab Rare. Das ist keine Deko: Rare und Epic schaffen gegen
		-- die Tastaturplatte nur 2,89 bzw. 2,82:1 - ohne eigenes Licht
		-- verschwinden sie auf dem dunklen Untergrund.
		local reichweite = Theme.RARITY_LIGHT_RANGE[key.rarity] or 0
		if reichweite &gt; 0 then
			local glow = Instance.new("PointLight")
			glow.Color = Theme.RARITY_COLORS[key.rarity] or Theme.WORLD.SIGNAL
			glow.Range = reichweite
			glow.Brightness = Theme.RARITY_LIGHT_BRIGHTNESS
			glow.Shadows = false -- Schatten von 192 Lichtern waeren nicht bezahlbar
			glow.Parent = top
		end

		-- Kantenlicht statt Schatten: Roblox-UI kann keinen Schatten, und
		-- in der Welt zeichnet eine SelectionBox die Kanten sauber nach.
		local rim = Instance.new("SelectionBox")
		rim.Adornee = part
		rim.Color3 = Theme.RARITY_EDGE[key.rarity] or Theme.WORLD.SEAM
		rim.LineThickness = Theme.KEY_RIM_BASE + Theme.KEY_RIM_STEP * rank
		rim.SurfaceTransparency = 1
		rim.Parent = part

		local billboard = Instance.new("BillboardGui")
		billboard.Name = "Info"
		billboard.Size = UDim2.new(0, 190, 0, 68)
		billboard.StudsOffset = Vector3.new(0, 2.6 + extra / 2, 0)
		billboard.AlwaysOnTop = false
		billboard.MaxDistance = Theme.KEY_LABEL_DISTANCE

		-- Seltenheit klein darueber, Vorrat gross darunter. Aus der Ferne
		-- bleibt nur die Zahl lesbar - und genau die entscheidet.
		local rarityLabel = Instance.new("TextLabel")
		rarityLabel.Name = "Rarity"
		rarityLabel.Size = UDim2.new(1, 0, 0.36, 0)
		rarityLabel.BackgroundTransparency = 1
		rarityLabel.Font = Theme.FONT
		rarityLabel.TextScaled = true
		rarityLabel.TextColor3 = Theme.RARITY_COLORS[key.rarity] or Theme.PANEL
		rarityLabel.TextStrokeTransparency = 0.25
		rarityLabel.Text = string.upper(key.rarity)
		rarityLabel.Parent = billboard

		local label = Instance.new("TextLabel")
		label.Name = "Vorrat"
		label.Size = UDim2.new(1, 0, 0.64, 0)
		label.Position = UDim2.new(0, 0, 0.36, 0)
		label.BackgroundTransparency = 1
		label.Font = Theme.FONT
		label.TextScaled = true
		label.TextColor3 = Theme.PANEL
		label.TextStrokeTransparency = 0.2
		label.Text = "0"
		label.Parent = billboard
		billboard.Parent = part

		-- Buchstabe auf der Oberseite: macht aus dem Wuerfel eine Taste.
		local legend = Instance.new("SurfaceGui")
		legend.Name = "Legend"
		legend.Face = Enum.NormalId.Top
		legend.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		legend.PixelsPerStud = 50

		local letter = Instance.new("TextLabel")
		-- Nicht randlos mittig, sondern leicht nach oben-links - so sitzt
		-- die Legende auf einer echten Tastatur.
		letter.Position = UDim2.new(WorldConfig.KEY_LEGEND_OFFSET.X, 0, WorldConfig.KEY_LEGEND_OFFSET.Y, 0)
		letter.Size = UDim2.new(1, 0, 1, 0)
		letter.BackgroundTransparency = 1
		letter.Font = Theme.FONT
		letter.TextScaled = true
		letter.TextColor3 = Theme.RARITY_INK[key.rarity] or Theme.TEXT
		letter.Text = WorldConfig.KEY_LEGENDS[index] or "?"
		letter.Parent = legend
		legend.Parent = top

		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "Steal"
		prompt.ActionText = "Klauen"
		prompt.ObjectText = key.rarity
		prompt.HoldDuration = EconomyConfig.STEAL_HOLD_SECONDS
		prompt.MaxActivationDistance = 10
		prompt.RequiresLineOfSight = false
		prompt.Parent = part

		part.Parent = plot.keyFolder
		keyOwner[part] = {
			kind = plot.ownerKind,
			userId = plot.ownerUserId,
			plotIndex = plot.index,
			index = index,
		}
	end
end

-- Bequemer Weg fuer den Spielerfall: Liste kommt aus dem Profil.
function PlotService.rebuildKeys(userId: number)
	local plot = plotByUser[userId]
	if not plot then
		return
	end
	local player = Players:GetPlayerByUserId(userId)
	local profile = if player then DataService.get(player) else nil
	if not profile then
		clearKeys(plot)
		return
	end
	PlotService.renderKeys(plot, profile.keys, profile.slots)
end

-- Beschriftungen aktualisieren (eigener Takt, damit nicht jede Sekunde
-- hunderte Labels repliziert werden).
-- Der Leuchtturm waechst mit dem Vorrat des Plots. Das ist keine Deko: das
-- Design sagt, die Rangliste soll eine Beutekarte sein - eine Lichtsaeule
-- sagt dasselbe, aber man sieht sie quer ueber die Karte, ohne ein Menue
-- zu oeffnen. Bei einem geschuetzten Plot geht sie aus, dann sieht man von
-- weitem, dass sich der Weg nicht lohnt.
function PlotService.updateBeacon(plot: Plot, vorrat: number, geschuetzt: boolean)
	local beacon = plot.beacon
	if plot.ownerKind == "none" or geschuetzt then
		beacon.Transparency = 1
		return
	end

	local anteil = math.clamp(vorrat / WorldConfig.BEACON_FULL_VORRAT, 0, 1)
	local hoehe = WorldConfig.BEACON_MIN_HEIGHT
		+ (WorldConfig.BEACON_MAX_HEIGHT - WorldConfig.BEACON_MIN_HEIGHT) * anteil
	beacon.Size = Vector3.new(WorldConfig.BEACON_WIDTH, hoehe, WorldConfig.BEACON_WIDTH)
	beacon.Position = plot.base.Position + Vector3.new(0, hoehe / 2, 0)
	-- Leerer Plot: schwach sichtbar. Voller Plot: kraeftig.
	beacon.Transparency = 0.75 - 0.45 * anteil
end

-- Kuppel an oder aus. Ein Text "Schild ist an" waere aus zehn Metern nicht
-- lesbar, eine Kuppel schon.
function PlotService.isShielded(userId: number): boolean
	return shielded[userId] == true
end

function PlotService.setShielded(userId: number, aktiv: boolean)
	shielded[userId] = aktiv
	local plot = plotByUser[userId]
	if not plot then
		return
	end
	plot.dome.Transparency = if aktiv then 0.82 else 1
	local rim = plot.dome:FindFirstChildOfClass("SelectionBox")
	if rim then
		rim.Visible = aktiv
	end
	if aktiv then
		plot.beacon.Transparency = 1
	end
end

function PlotService.refreshLabels(plot: Plot, keys: { { rarity: string, vorrat: number } })
	for _, part in plot.keyFolder:GetChildren() do
		if not part:IsA("BasePart") then
			continue
		end
		local ref = keyOwner[part]
		local key = if ref then keys[ref.index] else nil
		local billboard = part:FindFirstChild("Info")
		local label = if billboard then billboard:FindFirstChild("Vorrat") else nil
		if key and label and label:IsA("TextLabel") then
			-- Nur noch die Zahl: die Seltenheit steht im eigenen Label
			-- darueber und aendert sich nicht.
			label.Text = tostring(math.floor(key.vorrat))
		end
	end
end

function PlotService.refreshKeyLabels(userId: number)
	local plot = plotByUser[userId]
	local player = Players:GetPlayerByUserId(userId)
	local profile = if player then DataService.get(player) else nil
	if plot and profile then
		PlotService.refreshLabels(plot, profile.keys)
		local vorrat = 0
		for _, key in profile.keys do
			vorrat += key.vorrat
		end
		PlotService.updateBeacon(plot, vorrat, PlotService.isShielded(userId))
	end
end

-- NPC-Plots belegen die letzten Plots der Reihe, damit die Spieler vorne
-- nebeneinander stehen.
function PlotService.claimForNpc(slot: number, name: string): Plot?
	local index = WorldConfig.PLOT_COUNT - slot + 1
	local plot = plots[index]
	if not plot or plot.ownerKind ~= "none" then
		return nil
	end
	plot.ownerKind = "npc"
	plot.ownerUserId = nil
	plot.signLabel.Text = name
	plot.signLabel.TextColor3 = Theme.TEXT_MUTED
	return plot
end

function PlotService.assign(player: Player): boolean
	for _, plot in plots do
		if plot.ownerKind == "none" then
			plot.ownerKind = "player"
			plot.ownerUserId = player.UserId
			plotByUser[player.UserId] = plot
			plot.signLabel.Text = player.DisplayName
			plot.signLabel.TextColor3 = Theme.TEXT
			PlotService.rebuildKeys(player.UserId)
			return true
		end
	end
	return false
end

-- Verlassene Plots: Plot und Tasten verschwinden mit dem Besitzer.
-- Entscheidung (im Konzept undefiniert): sonst waeren herrenlose Plots
-- unbewachte Beutekisten und der Anwesenheits-Bonus haette keinen Wert.
function PlotService.release(userId: number)
	local plot = plotByUser[userId]
	if not plot then
		return
	end
	clearKeys(plot)
	updateSlotMarkers(plot, 0, 0)
	plot.beacon.Transparency = 1
	plot.dome.Transparency = 1
	shielded[userId] = nil
	plot.ownerKind = "none"
	plot.ownerUserId = nil
	plot.signLabel.Text = "Frei"
	plotByUser[userId] = nil
end

function PlotService.getPlot(userId: number): Plot?
	return plotByUser[userId]
end

function PlotService.plotAt(index: number): Plot?
	return plots[index]
end

function PlotService.keyRefFromPart(part: BasePart): KeyRef?
	return keyOwner[part]
end

-- Ist der Besitzer zuhause? Verdoppelt die Klau-Dauer.
function PlotService.isOwnerHome(userId: number): boolean
	local plot = plotByUser[userId]
	local player = Players:GetPlayerByUserId(userId)
	if not plot or not player then
		return false
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then
		return false
	end
	return (root.Position - plot.base.Position).Magnitude &lt;= WorldConfig.PRESENCE_RADIUS
end

function PlotService.spawnPositionFor(userId: number): Vector3?
	local plot = plotByUser[userId]
	if not plot then
		return nil
	end
	return plot.base.Position + Vector3.new(0, 6, WorldConfig.PLOT_SIZE.Z / 2 - 4)
end

-- Zaehlt alles, was der Server gebaut hat - fuer das Part-Budget.
function PlotService.countParts(): number
	local count = 0
	for _, descendant in workspace:GetDescendants() do
		if descendant:IsA("BasePart") then
			count += 1
		end
	end
	return count
end

-- Plot zuweisen, sobald das Profil geladen ist, und den Spieler dorthin
-- setzen. Das Profil kommt asynchron aus dem DataStore, deshalb warten
-- wir kurz darauf statt anzunehmen, dass es schon da ist.
local function onPlayerAdded(player: Player)
	local deadline = os.clock() + 20
	while os.clock() &lt; deadline do
		if DataService.get(player) then
			break
		end
		task.wait(0.25)
	end
	if not player.Parent or not DataService.get(player) then
		return
	end
	if not PlotService.assign(player) then
		player:Kick("Der Server ist voll - alle Plots sind vergeben.")
		return
	end

	local function place(character: Model)
		local target = PlotService.spawnPositionFor(player.UserId)
		if target then
			character:PivotTo(CFrame.new(target))
		end
	end
	if player.Character then
		place(player.Character)
	end
	player.CharacterAdded:Connect(place)
end

function PlotService.start()
	PlotService.buildWorld()
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end
	Players.PlayerAdded:Connect(function(player)
		task.spawn(onPlayerAdded, player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		PlotService.release(player.UserId)
	end)
	print("[KEYCAP] PlotService: " .. WorldConfig.PLOT_COUNT .. " Plots gebaut")
end

return PlotService
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="KC150">
<Properties>
<string name="Name">ProductionService</string>
<ProtectedString name="Source">--!strict
-- Jede Taste produziert ihren EIGENEN Vorrat. Der Plot-Vorrat ist die
-- Summe - es gibt keinen zweiten Zaehler daneben. Das ist die Aenderung
-- aus Abschnitt 6 der Bewertung: dadurch klaut ein Dieb echten Vorrat mit
-- und Horten ist nicht mehr gratis.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local EconomyLogic = require(Shared.EconomyLogic)
local WorldConfig = require(Shared.Config.WorldConfig)
local DataService = require(script.Parent.DataService)
local PlotService = require(script.Parent.PlotService)

local LABEL_INTERVAL = 2 -- Sekunden zwischen zwei Label-Updates

local ProductionService = {}

function ProductionService.totalVorrat(profile: DataService.Profile): number
	local sum = 0
	for _, key in profile.keys do
		sum += key.vorrat
	end
	return sum
end

function ProductionService.rate(profile: DataService.Profile): number
	local rate = 0
	for _, key in profile.keys do
		rate += EconomyLogic.rarity(key.rarity).vorratPerSecond
	end
	return rate
end

function ProductionService.start()
	local sinceLabel = 0

	RunService.Heartbeat:Connect(function(deltaTime)
		for _, player in Players:GetPlayers() do
			local profile = DataService.get(player)
			if not profile then
				continue
			end
			-- Produktion laeuft ortsunabhaengig weiter, auch waehrend des
			-- Laufs zum Pad. Nur der Vorrat auf dem Plot ist klaubar.
			for _, key in profile.keys do
				key.vorrat += EconomyLogic.rarity(key.rarity).vorratPerSecond * deltaTime
			end
		end

		sinceLabel += deltaTime
		if sinceLabel &gt;= LABEL_INTERVAL then
			sinceLabel = 0
			for _, player in Players:GetPlayers() do
				PlotService.refreshKeyLabels(player.UserId)
			end
		end
	end)

	print("[KEYCAP] ProductionService laeuft (Label-Takt " .. LABEL_INTERVAL .. "s)")
end

-- Wie oft der Zustand an die Clients geht, steht in WorldConfig - hier nur
-- als Erinnerung, dass ProductionService selbst nichts an Clients schickt.
ProductionService.STATE_PUSH_INTERVAL = WorldConfig.STATE_PUSH_INTERVAL

return ProductionService
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="KC151">
<Properties>
<string name="Name">RunTimerService</string>
<ProtectedString name="Source">--!strict
-- Misst, wie lange ein Rundlauf Plot -&gt; Pad -&gt; Plot wirklich dauert.
--
-- Die Bewertung: "Miss zuerst, wie lange Stage 1 und Stage 3 hin und zurueck
-- wirklich dauern, und setz die Faktoren dann knapp unter dieses Verhaeltnis."
-- STAGE_RUN_SECONDS ist der einzige geschaetzte Wert im Balancing - alle
-- Auszahlungsfaktoren und die Schilddauer haengen daran. Statt Stoppuhr
-- misst der Server selbst und schreibt das Ergebnis ins Output-Fenster.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local EconomyConfig = require(Shared.Config.EconomyConfig)
local PlotService = require(script.Parent.PlotService)

local RunTimerService = {}

local CHECK_INTERVAL = 0.5
local REPORT_EVERY = 3 -- nach so vielen Laeufen je Stage einmal berichten

type Run = { away: boolean, leftAt: number, stage: number?, cashOuts: number }

local runs: { [number]: Run } = {}
local samples: { [number]: { number } } = {} -- stageIndex -&gt; Rundlaufzeiten

-- Wird von CourseService nach einer erfolgreichen Auszahlung gerufen.
function RunTimerService.markCashOut(player: Player, stageIndex: number)
	local run = runs[player.UserId]
	if run and run.away then
		run.stage = stageIndex
		run.cashOuts += 1
	end
end

function RunTimerService.average(stageIndex: number): (number?, number)
	local list = samples[stageIndex]
	if not list or #list == 0 then
		return nil, 0
	end
	local sum = 0
	for _, value in list do
		sum += value
	end
	return sum / #list, #list
end

-- Gibt die gemessenen Zeiten als fertige Config-Zeile aus, damit sie ohne
-- Nachdenken in EconomyConfig.STAGE_RUN_SECONDS uebernommen werden kann.
function RunTimerService.report(): string
	local parts = {}
	for stageIndex = 1, #EconomyConfig.STAGE_RUN_SECONDS do
		local average, count = RunTimerService.average(stageIndex)
		if average then
			table.insert(parts, ("%d (%d Laeufe)"):format(math.floor(average + 0.5), count))
		else
			table.insert(parts, "? (0 Laeufe)")
		end
	end
	return "STAGE_RUN_SECONDS = { " .. table.concat(parts, ", ") .. " }"
end

local function record(userId: number, stageIndex: number, seconds: number)
	samples[stageIndex] = samples[stageIndex] or {}
	table.insert(samples[stageIndex], seconds)
	local list = samples[stageIndex]
	if #list % REPORT_EVERY == 0 then
		local average = RunTimerService.average(stageIndex)
		print(("[KEYCAP] Messung Stage %d: %.1fs dieser Lauf, Schnitt %.1fs aus %d Laeufen"):format(
			stageIndex,
			seconds,
			average or seconds,
			#list
		))
		print("[KEYCAP] " .. RunTimerService.report())
	end
end

function RunTimerService.start()
	local accumulator = 0

	RunService.Heartbeat:Connect(function(deltaTime)
		accumulator += deltaTime
		if accumulator &lt; CHECK_INTERVAL then
			return
		end
		accumulator = 0
		local now = os.clock()

		for _, player in Players:GetPlayers() do
			local home = PlotService.isOwnerHome(player.UserId)
			local run = runs[player.UserId]

			if not run then
				runs[player.UserId] = { away = false, leftAt = now, stage = nil, cashOuts = 0 }
				continue
			end

			if home and run.away then
				-- Nur zaehlen, wenn unterwegs GENAU EINMAL ausgezahlt wurde.
				-- Wer erst an Stage 1 und dann an Stage 3 kassiert, liefert
				-- fuer beide eine zu lange Zeit - so eine Runde ist als
				-- Messwert unbrauchbar und wird verworfen.
				if run.stage and run.cashOuts == 1 then
					record(player.UserId, run.stage, now - run.leftAt)
				end
				run.away = false
				run.stage = nil
				run.cashOuts = 0
			elseif not home and not run.away then
				run.away = true
				run.leftAt = now
				run.stage = nil
				run.cashOuts = 0
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		runs[player.UserId] = nil
	end)

	print("[KEYCAP] RunTimerService misst Rundlaufzeiten")
end

return RunTimerService
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="KC152">
<Properties>
<string name="Name">ShopService</string>
<ProtectedString name="Source">--!strict
-- Kauf von Tasten und Steckplaetzen. Der Client schickt nur eine Absicht -
-- Preis, Kontostand und Platz prueft ausschliesslich der Server.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local EconomyConfig = require(Shared.Config.EconomyConfig)
local EconomyLogic = require(Shared.EconomyLogic)
local Remotes = require(Shared.Remotes)
local RateLimit = require(Shared.RateLimit)
local DataService = require(script.Parent.DataService)
local PlotService = require(script.Parent.PlotService)
local TutorialService = require(script.Parent.TutorialService)

local ShopService = {}

local function notify(player: Player, text: string)
	Remotes.get("Notify"):FireClient(player, text)
end

local function isKnownRarity(name: any): boolean
	if type(name) ~= "string" then
		return false
	end
	return EconomyConfig.RARITIES[name] ~= nil
end

local function onBuyKey(player: Player, rarityName: any)
	if not RateLimit.allow(player.UserId, "buyKey", EconomyConfig.REMOTE_RATE_LIMIT) then
		return
	end
	if not isKnownRarity(rarityName) then
		return -- Typ-Check am Server-Eingang: unbekannte Werte still verwerfen
	end
	local profile = DataService.get(player)
	if not profile then
		return
	end
	if #profile.keys &gt;= profile.slots then
		notify(player, "Alle Steckplaetze belegt - erst einen Slot kaufen.")
		return
	end
	local price = EconomyLogic.rarity(rarityName).price
	if profile.wins &lt; price then
		notify(player, ("Zu wenig Wins: %d von %d."):format(profile.wins, price))
		return
	end

	profile.wins -= price
	table.insert(profile.keys, { rarity = rarityName, vorrat = 0 })
	PlotService.rebuildKeys(player.UserId)
	DataService.syncLeaderstats(player)
	TutorialService.report(player, "buy")
	notify(player, ("%s gekauft (-%d Wins)."):format(rarityName, price))
end

local function onBuySlot(player: Player)
	if not RateLimit.allow(player.UserId, "buySlot", EconomyConfig.REMOTE_RATE_LIMIT) then
		return
	end
	local profile = DataService.get(player)
	if not profile then
		return
	end
	local price = EconomyLogic.slotPrice(profile.slots)
	if not price then
		notify(player, "Du hast schon alle Steckplaetze.")
		return
	end
	if profile.wins &lt; price then
		notify(player, ("Zu wenig Wins: %d von %d."):format(profile.wins, price))
		return
	end

	profile.wins -= price
	profile.slots += 1
	DataService.syncLeaderstats(player)
	notify(player, ("Steckplatz %d gekauft (-%d Wins)."):format(profile.slots, price))
end

function ShopService.start()
	Remotes.get("BuyKey").OnServerEvent:Connect(onBuyKey)
	Remotes.get("BuySlot").OnServerEvent:Connect(onBuySlot)
	Players.PlayerRemoving:Connect(function(player)
		RateLimit.forget(player.UserId)
	end)
	print("[KEYCAP] ShopService laeuft")
end

return ShopService
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="KC153">
<Properties>
<string name="Name">SpeedService</string>
<ProtectedString name="Source">--!strict
-- Setzt die WalkSpeed aus dem Vorrat. Server-autoritativ: der Client
-- rechnet nichts aus und schickt nichts - er sieht nur das Ergebnis.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local EconomyLogic = require(Shared.EconomyLogic)
local EconomyConfig = require(Shared.Config.EconomyConfig)
local DataService = require(script.Parent.DataService)
local ProductionService = require(script.Parent.ProductionService)

local SpeedService = {}

-- Wer eine geklaute Taste traegt, ist langsamer. Wird von StealService
-- gesetzt und laeuft nach CARRY_SECONDS aus.
local carrying: { [number]: number } = {} -- userId -&gt; Ablaufzeitpunkt (os.clock)

function SpeedService.setCarrying(userId: number, seconds: number)
	carrying[userId] = os.clock() + seconds
end

function SpeedService.clearCarrying(userId: number)
	carrying[userId] = nil
end

function SpeedService.isCarrying(userId: number): boolean
	local until_ = carrying[userId]
	return until_ ~= nil and os.clock() &lt; until_
end

function SpeedService.speedFor(player: Player): number
	local profile = DataService.get(player)
	if not profile then
		return EconomyConfig.BASE_WALK_SPEED
	end
	local vorrat = ProductionService.totalVorrat(profile)
	if SpeedService.isCarrying(player.UserId) then
		return EconomyLogic.carryWalkSpeed(vorrat)
	end
	return EconomyLogic.walkSpeed(vorrat)
end

function SpeedService.start()
	local accumulator = 0

	RunService.Heartbeat:Connect(function(deltaTime)
		accumulator += deltaTime
		if accumulator &lt; 0.25 then
			return
		end
		accumulator = 0

		for _, player in Players:GetPlayers() do
			local character = player.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			if humanoid then
				humanoid.WalkSpeed = SpeedService.speedFor(player)
			end
		end
	end)

	print("[KEYCAP] SpeedService laeuft")
end

return SpeedService
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="KC154">
<Properties>
<string name="Name">StateService</string>
<ProtectedString name="Source">--!strict
-- Schickt den Spielzustand an die Clients. Der Client rechnet nichts aus,
-- er zeigt nur an, was hier drin steht.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local EconomyLogic = require(Shared.EconomyLogic)
local WorldConfig = require(Shared.Config.WorldConfig)
local Remotes = require(Shared.Remotes)
local DataService = require(script.Parent.DataService)
local ProductionService = require(script.Parent.ProductionService)
local SpeedService = require(script.Parent.SpeedService)
local StealService = require(script.Parent.StealService)
local TutorialService = require(script.Parent.TutorialService)

local StateService = {}

function StateService.start()
	local remote = Remotes.get("StateChanged")

	task.spawn(function()
		while true do
			task.wait(WorldConfig.STATE_PUSH_INTERVAL)
			for _, player in Players:GetPlayers() do
				local profile = DataService.get(player)
				if not profile then
					continue
				end
				local vorrat = ProductionService.totalVorrat(profile)
				local shieldLeft, shieldCooldown = StealService.shieldState(player.UserId)
				local nextStage = nil
				for stageIndex = 1, #EconomyLogic.payoutFactors() do
					if not EconomyLogic.canEnterStage(vorrat, stageIndex) then
						nextStage = stageIndex
						break
					end
				end

				remote:FireClient(player, {
					wins = profile.wins,
					vorrat = math.floor(vorrat),
					rate = ProductionService.rate(profile),
					speed = SpeedService.speedFor(player),
					slots = profile.slots,
					keyCount = #profile.keys,
					slotPrice = EconomyLogic.slotPrice(profile.slots),
					carrying = SpeedService.isCarrying(player.UserId),
					shieldLeft = math.floor(shieldLeft),
					shieldCooldown = math.floor(shieldCooldown),
					-- naechstes Tor, das noch nicht offen ist (nil = alle offen)
					nextStage = nextStage,
					nextStageVorrat = if nextStage then EconomyLogic.vorratForStage(nextStage) else nil,
					-- nil = Tutorial durch
					tutorial = TutorialService.stateFor(player),
				})
			end
		end
	end)

	print("[KEYCAP] StateService sendet alle " .. WorldConfig.STATE_PUSH_INTERVAL .. "s")
end

return StateService
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="KC155">
<Properties>
<string name="Name">StealService</string>
<ProtectedString name="Source">--!strict
-- Diebstahl und Schild.
--
-- Geklaut wird eine TASTE MITSAMT IHREM VORRAT (Abschnitt 6 der Bewertung).
-- Der Dieb bekommt nur einen Anteil, der Rest verfaellt - sonst waere ein
-- Klau bei einem Horter ein Sofortsieg.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local EconomyConfig = require(Shared.Config.EconomyConfig)
local EconomyLogic = require(Shared.EconomyLogic)
local Remotes = require(Shared.Remotes)
local RateLimit = require(Shared.RateLimit)
local DataService = require(script.Parent.DataService)
local PlotService = require(script.Parent.PlotService)
local SpeedService = require(script.Parent.SpeedService)
local CarryService = require(script.Parent.CarryService)
local NpcPlotService = require(script.Parent.NpcPlotService)
local TutorialService = require(script.Parent.TutorialService)

local StealService = {}

local pairCooldown: { [string]: number } = {} -- "dieb|opfer" -&gt; os.clock
local shieldUntil: { [number]: number } = {}
local shieldReadyAt: { [number]: number } = {}

local function notify(player: Player, text: string)
	Remotes.get("Notify"):FireClient(player, text)
end

function StealService.isShielded(userId: number): boolean
	return (shieldUntil[userId] or 0) &gt; os.clock()
end

function StealService.shieldState(userId: number): (number, number)
	local now = os.clock()
	return math.max(0, (shieldUntil[userId] or 0) - now), math.max(0, (shieldReadyAt[userId] or 0) - now)
end

local function activateShield(player: Player)
	if not RateLimit.allow(player.UserId, "shield", EconomyConfig.REMOTE_RATE_LIMIT) then
		return
	end
	local now = os.clock()
	if (shieldReadyAt[player.UserId] or 0) &gt; now then
		notify(player, "Schild laedt noch.")
		return
	end
	local duration, cooldown = EconomyLogic.shieldWindow()
	shieldUntil[player.UserId] = now + duration
	shieldReadyAt[player.UserId] = now + cooldown
	notify(player, ("Schild an - %ds geschuetzt."):format(duration))
end

-- Gemeinsame Vorpruefungen fuer jeden Klau. Gibt das Profil des Diebes
-- zurueck, oder nil mit dem Grund als Meldung.
local function checkThief(thief: Player, part: BasePart): any
	if not RateLimit.allow(thief.UserId, "steal", EconomyConfig.REMOTE_RATE_LIMIT) then
		return nil
	end
	local profile = DataService.get(thief)
	if not profile then
		return nil
	end
	if #profile.keys &gt;= profile.slots then
		notify(thief, "Kein freier Steckplatz - erst einen Slot kaufen.")
		return nil
	end
	-- Distanz serverseitig pruefen, nicht dem Prompt vertrauen.
	local character = thief.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then
		return nil
	end
	if (root.Position - part.Position).Magnitude &gt; 16 then
		return nil
	end
	return profile
end

local function stealFromNpc(thief: Player, part: BasePart, ref)
	local thiefProfile = checkThief(thief, part)
	if not thiefProfile then
		return
	end

	local pairId = thief.UserId .. "|npc" .. ref.plotIndex
	local now = os.clock()
	if (pairCooldown[pairId] or 0) &gt; now then
		local left = math.ceil((pairCooldown[pairId] :: number) - now)
		notify(thief, ("An diesem Plot erst wieder in %ds."):format(left))
		return
	end

	local taken = NpcPlotService.takeKey(ref.plotIndex, ref.index)
	if not taken then
		notify(thief, "Diese Taste ist gerade leer.")
		return
	end

	table.insert(thiefProfile.keys, { rarity = taken.rarity, vorrat = taken.vorrat })
	thiefProfile.totalStolen += 1
	pairCooldown[pairId] = now + EconomyConfig.NPC_PAIR_COOLDOWN_SECONDS

	SpeedService.setCarrying(thief.UserId, EconomyConfig.CARRY_SECONDS)
	CarryService.show(thief, taken.rarity, taken.vorrat)
	PlotService.rebuildKeys(thief.UserId)
	DataService.syncLeaderstats(thief)
	TutorialService.report(thief, "steal")
	notify(thief, ("Mitgenommen: %s mit %d Vorrat."):format(taken.rarity, taken.vorrat))
end

local function stealFromPlayer(thief: Player, part: BasePart, ref)
	if ref.userId == thief.UserId then
		notify(thief, "Das ist deine eigene Taste.")
		return
	end

	local victim = Players:GetPlayerByUserId(ref.userId)
	local victimProfile = if victim then DataService.get(victim) else nil
	if not victim or not victimProfile then
		return
	end

	if StealService.isShielded(victim.UserId) then
		notify(thief, "Der Plot ist geschuetzt.")
		return
	end

	-- Abklingzeit pro Dieb-Opfer-Paar: verhindert, dass ein starker Spieler
	-- einen schwachen dauerhaft leerraeumt.
	local pairId = thief.UserId .. "|" .. victim.UserId
	local now = os.clock()
	if (pairCooldown[pairId] or 0) &gt; now then
		local left = math.ceil((pairCooldown[pairId] :: number) - now)
		notify(thief, ("Bei diesem Spieler erst wieder in %ds."):format(left))
		return
	end

	local thiefProfile = checkThief(thief, part)
	if not thiefProfile then
		return
	end

	local key = victimProfile.keys[ref.index]
	if not key then
		return -- Liste hat sich zwischenzeitlich geaendert
	end

	local carried = EconomyLogic.stealTransfer(key.vorrat)
	local lost = math.floor(key.vorrat)
	table.remove(victimProfile.keys, ref.index)
	table.insert(thiefProfile.keys, { rarity = key.rarity, vorrat = carried })
	thiefProfile.totalStolen += 1

	pairCooldown[pairId] = now + EconomyConfig.STEAL_PAIR_COOLDOWN_SECONDS
	SpeedService.setCarrying(thief.UserId, EconomyConfig.CARRY_SECONDS)
	CarryService.show(thief, key.rarity, carried)

	PlotService.rebuildKeys(victim.UserId)
	PlotService.rebuildKeys(thief.UserId)
	DataService.syncLeaderstats(thief)

	TutorialService.report(thief, "steal")
	notify(thief, ("Geklaut: %s mit %d Vorrat."):format(key.rarity, carried))
	notify(victim, ("%s hat deine %s geklaut (%d Vorrat weg)."):format(thief.DisplayName, key.rarity, lost))

	-- Das Opfer soll nicht informiert werden, sondern wuetend: Name des
	-- Diebs gross, die verlorene Zahl darunter, rote Kante, Ruettler.
	Remotes.get("Alert"):FireClient(victim, {
		kind = "stolen",
		title = string.upper(thief.DisplayName),
		body = ("hat deine %s geklaut - %d Vorrat weg"):format(key.rarity, lost),
	})

	if EconomyConfig.ANNOUNCE_RARITIES[key.rarity] then
		Remotes.get("Announce"):FireAllClients({
			rarity = key.rarity,
			text = ("%s reisst bei %s eine %s - %d Vorrat unterwegs"):format(
				thief.DisplayName,
				victim.DisplayName,
				string.upper(key.rarity),
				carried
			),
		})
	end
end

local function attemptSteal(thief: Player, part: BasePart)
	local ref = PlotService.keyRefFromPart(part)
	if not ref then
		return
	end
	if ref.kind == "npc" then
		stealFromNpc(thief, part, ref)
	elseif ref.kind == "player" and ref.userId then
		stealFromPlayer(thief, part, ref)
	end
end

-- Anwesenheit des Besitzers verdoppelt die Klau-Dauer. ProximityPrompt hat
-- keine Einstellung pro Spieler, also wird die Dauer am Prompt selbst
-- nachgezogen.
-- Schildzustand an PlotService melden, damit Kuppel und Leuchtturm
-- umschalten. Laeuft im selben Sekundentakt wie die Haltedauern.
local function refreshShields()
	for _, player in Players:GetPlayers() do
		PlotService.setShielded(player.UserId, StealService.isShielded(player.UserId))
	end
end

local function refreshHoldDurations()
	-- Nur Spielerplots: an einem NPC-Plot ist nie jemand zuhause.
	for _, player in Players:GetPlayers() do
		local plot = PlotService.getPlot(player.UserId)
		if not plot then
			continue
		end
		local factor = if PlotService.isOwnerHome(player.UserId) then EconomyConfig.PRESENCE_HOLD_FACTOR else 1
		local duration = EconomyConfig.STEAL_HOLD_SECONDS * factor
		for _, part in plot.keyFolder:GetChildren() do
			local prompt = part:FindFirstChild("Steal")
			if prompt and prompt:IsA("ProximityPrompt") then
				prompt.HoldDuration = duration
			end
		end
	end
end

function StealService.start()
	local plots = workspace:WaitForChild("Plots")

	local function hook(descendant: Instance)
		if not descendant:IsA("ProximityPrompt") or descendant.Name ~= "Steal" then
			return
		end
		local part = descendant.Parent
		if part and part:IsA("BasePart") then
			descendant.Triggered:Connect(function(thief)
				attemptSteal(thief, part)
			end)
		end
	end

	plots.DescendantAdded:Connect(hook)
	-- Prompts, die vor diesem Verbinden schon existierten, nachziehen:
	-- PlotService vergibt Plots asynchron und kann schneller sein.
	for _, descendant in plots:GetDescendants() do
		hook(descendant)
	end

	Remotes.get("ActivateShield").OnServerEvent:Connect(activateShield)

	Players.PlayerRemoving:Connect(function(player)
		shieldUntil[player.UserId] = nil
		shieldReadyAt[player.UserId] = nil
		RateLimit.forget(player.UserId)
		SpeedService.clearCarrying(player.UserId)
	end)

	local accumulator = 0
	RunService.Heartbeat:Connect(function(deltaTime)
		accumulator += deltaTime
		if accumulator &gt;= 1 then
			accumulator = 0
			refreshHoldDurations()
			refreshShields()
		end
	end)

	print("[KEYCAP] StealService laeuft")
end

return StealService
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="KC156">
<Properties>
<string name="Name">TutorialService</string>
<ProtectedString name="Source">--!strict
-- Onboarding. Der Fortschritt liegt im Profil, nicht im Client - nach einem
-- Rejoin faengt niemand von vorne an, und der Client kann sich die
-- Abschluss-Belohnung nicht selbst geben.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local EconomyLogic = require(Shared.EconomyLogic)
local TutorialConfig = require(Shared.Config.TutorialConfig)
local Remotes = require(Shared.Remotes)
local DataService = require(script.Parent.DataService)
local ProductionService = require(script.Parent.ProductionService)

local TutorialService = {}

local function notify(player: Player, text: string)
	Remotes.get("Notify"):FireClient(player, text)
end

local function currentStep(profile: DataService.Profile)
	return TutorialConfig.STEPS[profile.tutorialStep]
end

local function advance(player: Player, profile: DataService.Profile)
	profile.tutorialStep += 1
	if profile.tutorialStep &gt; #TutorialConfig.STEPS then
		profile.wins += TutorialConfig.REWARD_WINS
		DataService.syncLeaderstats(player)
		notify(player, ("%s  (+%d Wins)"):format(TutorialConfig.DONE_TEXT, TutorialConfig.REWARD_WINS))
	end
end

-- Wird von CourseService, ShopService und StealService gerufen. Der Name
-- muss zum `event` des aktuellen Schritts passen, sonst passiert nichts -
-- so kann kein Schritt uebersprungen werden.
function TutorialService.report(player: Player, event: string)
	local profile = DataService.get(player)
	if not profile then
		return
	end
	local step = currentStep(profile)
	if step and step.event == event then
		advance(player, profile)
	end
end

-- Zustand fuer den Client. Gibt nil zurueck, wenn das Tutorial durch ist.
--
-- ACHTUNG: Diese Funktion kann den Fortschritt WEITERSCHALTEN. Der erste
-- Schritt haengt an einer Zahl statt an einer Handlung, es gibt also nichts,
-- was ihn melden koennte - er wird hier beim Abfragen geprueft. StateService
-- ruft das im festen Takt, damit ist das der einzige Ort, an dem gepollt wird.
function TutorialService.stateFor(player: Player): { step: number, text: string }?
	local profile = DataService.get(player)
	if not profile then
		return nil
	end
	local step = currentStep(profile)
	if not step then
		return nil
	end

	-- Der erste Schritt haengt an einer Zahl, nicht an einer Handlung:
	-- sobald genug Vorrat da ist, ist er erledigt.
	if step.event == "vorrat" and step.requiresVorratForStage then
		local vorrat = ProductionService.totalVorrat(profile)
		if EconomyLogic.canEnterStage(vorrat, step.requiresVorratForStage) then
			advance(player, profile)
			step = currentStep(profile)
			if not step then
				return nil
			end
		end
	end

	return { step = profile.tutorialStep, text = step.text }
end

function TutorialService.start()
	print(("[KEYCAP] TutorialService: %d Schritte, %d Wins Belohnung"):format(
		#TutorialConfig.STEPS,
		TutorialConfig.REWARD_WINS
	))
end

return TutorialService
</ProtectedString>
</Properties>
</Item>
</Item>
</Item>
</Item>
<Item class="Lighting" referent="KC168">
<Properties>
<string name="Name">Lighting</string>
<token name="Technology">4</token>
</Properties>
</Item>
<Item class="StarterPlayer" referent="KC169">
<Properties>
<string name="Name">StarterPlayer</string>
</Properties>
<Item class="StarterPlayerScripts" referent="KC170">
<Properties>
<string name="Name">StarterPlayerScripts</string>
</Properties>
<Item class="LocalScript" referent="KC163">
<Properties>
<string name="Name">KeycapRush</string>
<ProtectedString name="Source">--!strict
-- Startet die Controller. Der Client zeigt nur an und schickt Absichten.

local Controllers = script:WaitForChild("Controllers")

local HudController = require(Controllers.HudController)
local ShopController = require(Controllers.ShopController)

HudController.start()
ShopController.start()

print("[KEYCAP] Client bereit.")
</ProtectedString>
</Properties>
<Item class="Folder" referent="KC161">
<Properties>
<string name="Name">Controllers</string>
</Properties>
<Item class="ModuleScript" referent="KC159">
<Properties>
<string name="Name">HudController</string>
<ProtectedString name="Source">--!strict
-- HUD: Vorrat, Rate, Wins, Tempo-Balken, Schild, Onboarding, Meldungen.
-- Baut ausschliesslich mit UiKit - hier steht keine eigene Farbe und keine
-- eigene Pixelzahl, die nicht aus Theme kommt.
--
-- Zwei Layouts, ein Codepfad:
--   breit    Statuskarte links unter dem Roblox-Menue, Knoepfe darunter
--   compact  Statuskarte als Streifen oben mittig, Knoepfe am rechten Rand
--
-- Reservierte Bildschirmbereiche, in die nichts gehoert: oben links der
-- Roblox-Menueknopf (deshalb HUD_TOP_INSET), oben rechts der Chat, unten
-- links der Stick und unten rechts der Sprung-Knopf (HUD_BOTTOM_INSET).
--
-- [BEKANNTE LUECKE] Das Layout wird beim Start einmal gewaehlt. Dreht ein
-- Spieler das Handy im Spiel, wechselt es erst beim naechsten Respawn.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Theme = require(Shared:WaitForChild("Theme"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local EconomyConfig = require(Shared:WaitForChild("Config"):WaitForChild("EconomyConfig"))
local TutorialConfig = require(Shared:WaitForChild("Config"):WaitForChild("TutorialConfig"))
local UiKit = require(script.Parent.Parent.UiKit)

local HudController = {}

local player = Players.LocalPlayer

local TOAST_SECONDS = 3.5
local FLOAT_COOLDOWN = 0.6 -- so oft darf hoechstens eine +Zahl aufsteigen

-- Bruchteil der Tempo-Skala. Sie laeuft von BASE_WALK_SPEED bis
-- BASE_WALK_SPEED + MAX_SPEED_BONUS - dieselbe Rechnung fuer den Balken
-- und fuer die Markierungen der Tore, damit beide zusammenpassen.
local function speedFraction(speed: number): number
	return math.clamp((speed - EconomyConfig.BASE_WALK_SPEED) / EconomyConfig.MAX_SPEED_BONUS, 0, 1)
end

function HudController.start()
	local gui = Instance.new("ScreenGui")
	gui.Name = "KeycapHud"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	UiKit.autoScale(gui)

	local compact = UiKit.compact()
	local margin = Theme.SPACE.L
	local pad = Theme.SPACE.M

	local width = if compact then Theme.HUD_COMPACT_WIDTH else Theme.HUD_PANEL_WIDTH
	local height = if compact then Theme.HUD_STATS_COMPACT_HEIGHT else Theme.HUD_STATS_HEIGHT
	local statsPosition = if compact
		then UDim2.new(0.5, -width / 2, 0, Theme.SPACE.S)
		else UDim2.new(0, margin, 0, Theme.HUD_TOP_INSET)

	local stats = UiKit.panel(gui, UDim2.new(0, width, 0, height), statsPosition)
	local inner = UDim2.new(1, -pad * 2, 0, 0)

	-- Zeilenraster der Statuskarte. Zwei Rhythmen, einer je Layout.
	local yLabel = if compact then 6 else 12
	local yVorrat = if compact then 24 else 34
	local yRate = if compact then 66 else 96
	local yBar = if compact then 86 else 168

	UiKit.text(stats, {
		size = inner + UDim2.new(0, 0, 0, 20),
		position = UDim2.new(0, pad, 0, yLabel),
		textSize = Theme.TEXT_SIZE.SMALL,
		color = Theme.TEXT_MUTED,
		text = "VORRAT",
	})

	-- Wins sind die zweite Zahl: klein, aber in Gold, damit sie nicht mit
	-- dem Vorrat konkurriert und trotzdem sofort gefunden wird.
	local winsLabel = UiKit.text(stats, {
		size = inner + UDim2.new(0, 0, 0, 30),
		position = UDim2.new(0, pad, 0, yLabel - Theme.SPACE.XS),
		textSize = if compact then Theme.TEXT_SIZE.BODY else Theme.TEXT_SIZE.TITLE,
		color = Theme.GOLD_TEXT,
		align = Enum.TextXAlignment.Right,
		text = "0 Wins",
	})

	-- Die groesste Zahl auf dem Bildschirm. Alles andere ordnet sich ihr
	-- unter - sie ist der Grund, warum jemand ueberhaupt hier steht.
	local vorratLabel = UiKit.text(stats, {
		size = inner + UDim2.new(0, 0, 0, (if compact then 44 else 60)),
		position = UDim2.new(0, pad, 0, yVorrat),
		textSize = if compact then Theme.TEXT_SIZE.HERO else Theme.TEXT_SIZE.DISPLAY,
		text = "0",
	})
	local bumpVorrat = UiKit.bump(vorratLabel)

	local rateLabel = UiKit.text(stats, {
		size = inner + UDim2.new(0, 0, 0, 20),
		position = UDim2.new(0, pad, 0, yRate),
		textSize = Theme.TEXT_SIZE.SMALL,
		color = Theme.TEXT_MUTED,
		text = "+0 pro Sekunde",
	})

	local tempoLabel: TextLabel? = nil
	local hintLabel: TextLabel? = nil

	if not compact then
		local divider = Instance.new("Frame")
		divider.Size = UDim2.new(1, -pad * 2, 0, 1)
		divider.Position = UDim2.new(0, pad, 0, 124)
		divider.BackgroundColor3 = Theme.PANEL_EDGE
		divider.BorderSizePixel = 0
		divider.Parent = stats

		tempoLabel = UiKit.text(stats, {
			size = inner + UDim2.new(0, 0, 0, 26),
			position = UDim2.new(0, pad, 0, 136),
			textSize = Theme.TEXT_SIZE.BODY,
			text = "TEMPO 16",
		})
		hintLabel = UiKit.text(stats, {
			size = inner + UDim2.new(0, 0, 0, 22),
			position = UDim2.new(0, pad, 0, 138),
			textSize = Theme.TEXT_SIZE.SMALL,
			color = Theme.TEXT_MUTED,
			align = Enum.TextXAlignment.Right,
			text = "",
		})
	end

	-- Eigene Flaeche fuer den Balken: die Bruchteile der Tor-Markierungen
	-- muessen sich auf die Balkenbreite beziehen, nicht auf die Karte.
	local barArea = Instance.new("Frame")
	barArea.BackgroundTransparency = 1
	barArea.Size = UDim2.new(1, -pad * 2, 0, (if compact then Theme.BAR_HEIGHT_COMPACT else 44))
	barArea.Position = UDim2.new(0, pad, 0, yBar)
	barArea.Parent = stats

	local marks: { number } = {}
	for _, gate in EconomyConfig.STAGE_GATES do
		table.insert(marks, speedFraction(gate))
	end

	local bar = UiKit.speedBar(barArea, {
		size = UDim2.new(1, 0, 0, (if compact then Theme.BAR_HEIGHT_COMPACT else Theme.BAR_HEIGHT)),
		marks = marks,
	})

	-- Beschriftung der Tore. Auf dem Handy fallen sie weg: dort tragen die
	-- Markierungen allein, sonst frisst die Zeile die halbe Karte.
	if not compact then
		for _, gate in EconomyConfig.STAGE_GATES do
			UiKit.text(barArea, {
				size = UDim2.new(0, 40, 0, 20),
				position = UDim2.new(speedFraction(gate), -20, 0, Theme.BAR_HEIGHT + Theme.SPACE.XS),
				textSize = Theme.TEXT_SIZE.SMALL,
				color = Theme.TEXT_MUTED,
				align = Enum.TextXAlignment.Center,
				text = tostring(gate),
			})
		end
	end

	-- Schild-Knopf. Drei Zustaende, drei Farben, jeweils dunkle Schrift.
	local buttonWidth = if compact then Theme.HUD_COMPACT_BUTTON_WIDTH else width
	local shieldPosition = if compact
		then UDim2.new(1, -(buttonWidth + pad), 0, Theme.HUD_TOP_INSET)
		else UDim2.new(0, margin, 0, Theme.HUD_TOP_INSET + Theme.HUD_STATS_HEIGHT + Theme.SPACE.S)

	local shieldButton = UiKit.button(gui, {
		size = UDim2.new(0, buttonWidth, 0, Theme.TOUCH_MIN),
		position = shieldPosition,
		text = "Schild",
		textSize = if compact then Theme.TEXT_SIZE.SMALL else Theme.TEXT_SIZE.BODY,
		base = Theme.BLUE,
		edge = Theme.BLUE_DARK,
	})

	-- Onboarding-Karte unten mittig, oberhalb der Daumen-Zone. Jede Karte
	-- traegt einen Satz, die Schritt-Punkte und einen wandernden Balken -
	-- ohne Bewegung liest ein neuer Spieler den Text nicht.
	local tutorialWidth = if compact then Theme.HUD_TUTORIAL_COMPACT_WIDTH else Theme.HUD_TUTORIAL_WIDTH
	local tutorialCard = UiKit.panel(
		gui,
		UDim2.new(0, tutorialWidth, 0, Theme.HUD_TUTORIAL_HEIGHT),
		UDim2.new(0.5, -tutorialWidth / 2, 1, -(Theme.HUD_TUTORIAL_HEIGHT + Theme.HUD_BOTTOM_INSET))
	)
	tutorialCard.Visible = false
	tutorialCard.ClipsDescendants = true

	local tutorialText = UiKit.text(tutorialCard, {
		size = UDim2.new(1, -Theme.SPACE.XL, 0, 52),
		position = UDim2.new(0, pad, 0, pad),
		textSize = Theme.TEXT_SIZE.LEAD,
		align = Enum.TextXAlignment.Center,
		wrapped = true,
	})
	local stepCount = #TutorialConfig.STEPS
	local dotsWidth = stepCount * Theme.PIP + (stepCount - 1) * Theme.PIP_GAP
	local tutorialDots = UiKit.dots(tutorialCard, {
		count = stepCount,
		position = UDim2.new(0.5, -dotsWidth / 2, 0, 68),
	})
	UiKit.crawler(tutorialCard, Theme.GOLD)

	-- Meldungen: kurze Zeile fuer den Spieler selbst, Banner fuer den
	-- ganzen Server, Karte fuer Klau und Auszahlung.
	local toastY = if compact then Theme.HUD_STATS_COMPACT_HEIGHT + Theme.SPACE.L else Theme.SPACE.XXL + Theme.SPACE.XL
	local toast = UiKit.text(gui, {
		size = UDim2.new(0, Theme.TOAST_WIDTH, 0, Theme.TOAST_HEIGHT),
		position = UDim2.new(0.5, -Theme.TOAST_WIDTH / 2, 0, toastY),
		textSize = Theme.TEXT_SIZE.LEAD,
		align = Enum.TextXAlignment.Center,
	})
	toast.TextStrokeTransparency = 0.4
	toast.ZIndex = 3

	-- Breit sitzt die serverweite Zeile oben mittig. Auf dem Handy liegt
	-- dort der Statusstreifen, also rutscht sie unter die Toast-Zeile.
	local bannerY = if compact then toastY + Theme.TOAST_HEIGHT + Theme.SPACE.S else Theme.SPACE.S
	local showBanner = UiKit.banner(gui, UDim2.new(0.5, -Theme.BANNER_WIDTH / 2, 0, bannerY))
	local showAlert = UiKit.alert(gui)

	gui.Parent = player:WaitForChild("PlayerGui")

	shieldButton.Activated:Connect(function()
		Remotes.get("ActivateShield"):FireServer()
	end)

	local lastVorrat = 0
	local lastFloat = 0

	Remotes.get("StateChanged").OnClientEvent:Connect(function(state)
		local vorrat = math.floor(state.vorrat)
		vorratLabel.Text = UiKit.number(vorrat)
		winsLabel.Text = ("%s Wins"):format(UiKit.number(state.wins))
		if compact and state.carrying then
			-- Im schmalen Layout gibt es keine Hinweiszeile: die Ratenzeile
			-- uebernimmt den einen Zustand, der wirklich draengt.
			rateLabel.Text = "BEUTE - lauf nach Hause!"
			rateLabel.TextColor3 = Theme.RED_TEXT
		elseif compact then
			rateLabel.Text = ("+%d pro Sekunde   ·   Tempo %d"):format(state.rate, math.floor(state.speed))
			rateLabel.TextColor3 = Theme.TEXT_MUTED
		else
			rateLabel.Text = ("+%d pro Sekunde"):format(state.rate)
		end

		-- Wachsen sichtbar machen: die Zahl selbst zuckt, daneben steigt
		-- der Zuwachs auf. Hoechstens alle FLOAT_COOLDOWN Sekunden, sonst
		-- flimmert die Karte.
		local gained = vorrat - lastVorrat
		if gained &gt; 0 then
			bumpVorrat()
			local now = os.clock()
			if now - lastFloat &gt;= FLOAT_COOLDOWN then
				lastFloat = now
				UiKit.floatUp(stats, {
					text = ("+%s"):format(UiKit.number(gained)),
					position = UDim2.new(1, -(140 + Theme.SPACE.M), 0, yVorrat),
				})
			end
		end
		lastVorrat = vorrat

		bar.set(speedFraction(state.speed))

		if tempoLabel then
			tempoLabel.Text = ("TEMPO %d"):format(math.floor(state.speed))
		end

		if hintLabel then
			if state.carrying then
				hintLabel.Text = "Beute! Lauf nach Hause"
				hintLabel.TextColor3 = Theme.RED_TEXT
			elseif state.nextStage then
				hintLabel.Text = ("Stage %d ab %s"):format(state.nextStage, UiKit.number(state.nextStageVorrat))
				hintLabel.TextColor3 = Theme.TEXT_MUTED
			else
				hintLabel.Text = "Alle Tore offen"
				hintLabel.TextColor3 = Theme.GREEN_TEXT
			end
		end

		if state.tutorial then
			tutorialCard.Visible = true
			tutorialText.Text = state.tutorial.text
			tutorialDots.set(state.tutorial.step)
		else
			tutorialCard.Visible = false
		end

		if state.shieldLeft &gt; 0 then
			-- Laeuft: gruen. Gruen heisst im ganzen Spiel "das ist gut fuer
			-- dich", und geschuetzt zu sein ist der gute Zustand.
			shieldButton.Text = ("Schild %ds"):format(state.shieldLeft)
			UiKit.setButtonColors(shieldButton, Theme.GREEN, Theme.GREEN_DARK)
		elseif state.shieldCooldown &gt; 0 then
			shieldButton.Text = ("Laedt %ds"):format(state.shieldCooldown)
			UiKit.setButtonColors(shieldButton, Theme.PANEL_EDGE, Theme.TEXT_MUTED)
		else
			shieldButton.Text = if compact then "Schild" else "Schild einschalten"
			UiKit.setButtonColors(shieldButton, Theme.BLUE, Theme.BLUE_DARK)
		end
	end)

	local toastToken = 0
	Remotes.get("Notify").OnClientEvent:Connect(function(text)
		toast.Text = tostring(text)
		toastToken += 1
		local myToken = toastToken
		task.delay(TOAST_SECONDS, function()
			if toastToken == myToken then
				toast.Text = ""
			end
		end)
	end)

	Remotes.get("Alert").OnClientEvent:Connect(function(payload)
		if typeof(payload) ~= "table" then
			return
		end
		showAlert(tostring(payload.kind), tostring(payload.title), tostring(payload.body))
	end)

	Remotes.get("Announce").OnClientEvent:Connect(function(payload)
		if typeof(payload) ~= "table" then
			return
		end
		showBanner(tostring(payload.text), payload.rarity)
	end)
end

return HudController
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="KC160">
<Properties>
<string name="Name">ShopController</string>
<ProtectedString name="Source">--!strict
-- Laden: Tasten und Steckplaetze kaufen. Die Preise hier sind nur Anzeige -
-- was ein Kauf kostet, entscheidet allein der Server.
--
-- Das Gestaltungsproblem dieser Liste: die Seltenheit muss auf einen Blick
-- erkennbar sein, ohne dass man liest. Deshalb traegt sie vier Signale
-- gleichzeitig (in UiKit.keyRow): Farbe, Rahmenstaerke, Zahl der Punkte
-- und Hoehe der Taste. Farbe allein reicht nicht - das Spiel wird auf
-- billigen Displays in der Sonne gespielt.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Theme = require(Shared:WaitForChild("Theme"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local EconomyConfig = require(Shared:WaitForChild("Config"):WaitForChild("EconomyConfig"))
local WorldConfig = require(Shared:WaitForChild("Config"):WaitForChild("WorldConfig"))
local UiKit = require(script.Parent.Parent.UiKit)

local ShopController = {}

local player = Players.LocalPlayer

function ShopController.start()
	local gui = Instance.new("ScreenGui")
	gui.Name = "KeycapShop"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	UiKit.autoScale(gui)

	local compact = UiKit.compact()
	local margin = Theme.SPACE.L
	local pad = Theme.SPACE.M

	-- Sitzt in derselben Spalte wie das HUD: breit unter dem Schild-Knopf,
	-- auf dem Handy als zweiter Knopf am rechten Rand.
	local buttonWidth = if compact then Theme.HUD_COMPACT_BUTTON_WIDTH else Theme.HUD_PANEL_WIDTH
	local shieldBottom = Theme.HUD_TOP_INSET + Theme.HUD_STATS_HEIGHT + Theme.SPACE.S + Theme.TOUCH_MIN
	local openPosition = if compact
		then UDim2.new(1, -(buttonWidth + pad), 0, Theme.HUD_TOP_INSET + Theme.TOUCH_MIN + Theme.SPACE.S)
		else UDim2.new(0, margin, 0, shieldBottom + Theme.SPACE.S)

	local openButton = UiKit.button(gui, {
		size = UDim2.new(0, buttonWidth, 0, Theme.TOUCH_MIN),
		position = openPosition,
		text = "Laden",
		textSize = if compact then Theme.TEXT_SIZE.SMALL else Theme.TEXT_SIZE.BODY,
		base = Theme.GREEN,
		edge = Theme.GREEN_DARK,
	})

	-- Hoehe nicht ausrechnen, sondern vom Layout bestimmen lassen - sonst
	-- passt sie nicht mehr, sobald eine Seltenheit dazukommt. Oben
	-- verankert, damit das Panel auf 360 px Hoehe nicht unten rausfaellt.
	local panelWidth = if compact then Theme.HUD_TUTORIAL_COMPACT_WIDTH else Theme.SHOP_PANEL_WIDTH
	local panel = UiKit.panel(
		gui,
		UDim2.new(0, panelWidth, 0, 0),
		UDim2.new(0.5, -panelWidth / 2, 0, Theme.SPACE.L)
	)
	panel.AutomaticSize = Enum.AutomaticSize.Y
	panel.Visible = false
	panel.ZIndex = 2
	UiKit.stack(panel)

	UiKit.text(panel, {
		size = UDim2.new(1, 0, 0, 38),
		textSize = Theme.TEXT_SIZE.TITLE,
		align = Enum.TextXAlignment.Center,
		text = "Tasten kaufen",
		layoutOrder = 0,
	})

	-- Scrollflaeche: fuenf Zeilen a 88 px passen breit hin, auf einem
	-- Handy quer nicht. Statt zwei Layouts scrollt die Liste.
	local list = Instance.new("ScrollingFrame")
	list.Size = UDim2.new(1, 0, 0, (if compact then Theme.SHOP_LIST_HEIGHT_COMPACT else Theme.SHOP_LIST_HEIGHT))
	list.BackgroundTransparency = 1
	list.BorderSizePixel = 0
	list.CanvasSize = UDim2.new(0, 0, 0, 0)
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.ScrollBarThickness = Theme.SCROLLBAR
	list.ScrollBarImageColor3 = Theme.PANEL_EDGE
	list.ScrollingDirection = Enum.ScrollingDirection.Y
	list.LayoutOrder = 1
	list.Parent = panel
	UiKit.column(list)

	for index, rarityName in EconomyConfig.RARITY_ORDER do
		local rarity = EconomyConfig.RARITIES[rarityName]
		local buy = UiKit.keyRow(list, {
			rarity = rarityName,
			letter = WorldConfig.KEY_LEGENDS[index] or "A",
			title = rarityName,
			rateText = ("+%d Vorrat pro Sekunde"):format(rarity.vorratPerSecond),
			priceText = ("%s Wins"):format(UiKit.number(rarity.price)),
			layoutOrder = index,
		})
		buy.Activated:Connect(function()
			Remotes.get("BuyKey"):FireServer(rarityName)
		end)
	end

	local slotButton = UiKit.button(panel, {
		size = UDim2.new(1, 0, 0, Theme.TOUCH_MIN),
		text = "Steckplatz kaufen",
		base = Theme.GOLD,
		edge = Theme.GOLD_DARK,
		layoutOrder = 2,
	})
	slotButton.Activated:Connect(function()
		Remotes.get("BuySlot"):FireServer()
	end)

	local closeButton = UiKit.button(panel, {
		size = UDim2.new(1, 0, 0, Theme.TOUCH_MIN),
		text = "Schliessen",
		base = Theme.PANEL,
		edge = Theme.PANEL_EDGE,
		layoutOrder = 3,
	})
	closeButton.Activated:Connect(function()
		panel.Visible = false
	end)

	gui.Parent = player:WaitForChild("PlayerGui")

	openButton.Activated:Connect(function()
		panel.Visible = not panel.Visible
	end)

	Remotes.get("StateChanged").OnClientEvent:Connect(function(state)
		if state.slotPrice then
			slotButton.Text = ("Steckplatz %d   %s Wins"):format(state.slots + 1, UiKit.number(state.slotPrice))
		else
			slotButton.Text = "Alle Steckplaetze gekauft"
		end
		openButton.Text = if compact
			then ("Laden %d/%d"):format(state.keyCount, state.slots)
			else ("Laden   %d von %d Tasten"):format(state.keyCount, state.slots)
	end)
end

return ShopController
</ProtectedString>
</Properties>
</Item>
</Item>
<Item class="ModuleScript" referent="KC162">
<Properties>
<string name="Name">UiKit</string>
<ProtectedString name="Source">--!strict
-- Bausteine fuer die Oberflaeche. Jeder Controller baut damit, keiner baut
-- eigene Rahmen oder Knoepfe - sonst laufen die Panels optisch auseinander.
--
-- Alle Werte kommen aus Theme. In dieser Datei steht keine Farbe und keine
-- Pixelzahl, die nicht von dort kommt.
--
-- Was Roblox-UI NICHT kann und was hier deshalb fehlt: kein Blur hinter
-- Elementen, kein Schatten als Effekt, kein Radialverlauf. Die Trennung
-- zwischen Panel und Welt macht der Rahmen, Tiefe macht die dunklere
-- Unterkante, Verlaeufe laufen linear ueber eine Achse.

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Theme = require(Shared:WaitForChild("Theme"))

local UiKit = {}

local function round(instance: Instance, radius: UDim?)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = radius or Theme.CORNER
	corner.Parent = instance
end

-- Handy quer: schmaler Bildschirm, Daumen an beiden unteren Ecken. Dann
-- baut das HUD anders auf. Wird beim Start einmal gefragt.
function UiKit.compact(): boolean
	if not UserInputService.TouchEnabled then
		return false
	end
	local camera = workspace.CurrentCamera
	if not camera then
		return false
	end
	local viewport = camera.ViewportSize
	return viewport.X &lt; Theme.COMPACT_MAX_WIDTH or viewport.Y &lt; Theme.COMPACT_MAX_HEIGHT
end

-- Tausenderpunkte. "2.470" liest ein Kind schneller als "2470", und der
-- Vorrat ist im Normalfall vierstellig.
function UiKit.number(value: number): string
	local text = tostring(math.floor(math.abs(value)))
	local out = ""
	local count = 0
	for i = #text, 1, -1 do
		out = string.sub(text, i, i) .. out
		count += 1
		if count % 3 == 0 and i &gt; 1 then
			out = "." .. out
		end
	end
	if value &lt; 0 then
		return "-" .. out
	end
	return out
end

function UiKit.stroke(target: Instance, color: Color3, thickness: number?): UIStroke
	local stroke = Instance.new("UIStroke")
	stroke.Color = color
	stroke.Thickness = thickness or 2
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = target
	return stroke
end

-- Linearer Verlauf ueber eine Achse. 90 = oben nach unten.
-- Dieselbe Farbe um GRADIENT_LIFT aufgehellt. Der Verlauf von hier nach
-- unten gibt einer Flaeche die Plastik, die Roblox-UI ohne Schatten fehlt.
function UiKit.lift(color: Color3): Color3
	local factor = 1 + Theme.GRADIENT_LIFT
	return Color3.new(
		math.min(1, color.R * factor),
		math.min(1, color.G * factor),
		math.min(1, color.B * factor)
	)
end

function UiKit.gradient(target: Instance, from: Color3, to: Color3, rotation: number?): UIGradient
	local gradient = Instance.new("UIGradient")
	gradient.Color = ColorSequence.new(from, to)
	gradient.Rotation = rotation or 90
	gradient.Parent = target
	return gradient
end

-- Creme-weisse Flaeche mit runden Ecken und Kante.
function UiKit.panel(parent: Instance, size: UDim2, position: UDim2): Frame
	local frame = Instance.new("Frame")
	frame.Size = size
	frame.Position = position
	frame.BackgroundColor3 = Theme.PANEL
	frame.BorderSizePixel = 0
	round(frame)
	-- Umrandung in Tinte statt zarter Kante: ohne sie schwimmt eine helle
	-- Flaeche im Bild, mit ihr steht sie darauf. Der groesste einzelne
	-- Unterschied zum bisherigen Pastell-Look.
	UiKit.stroke(frame, Theme.INK, Theme.OUTLINE_THICKNESS)
	frame.Parent = parent
	return frame
end

export type TextOptions = {
	size: UDim2,
	position: UDim2?,
	text: string?,
	textSize: number?,
	color: Color3?,
	align: Enum.TextXAlignment?,
	wrapped: boolean?,
	layoutOrder: number?,
}

function UiKit.text(parent: Instance, options: TextOptions): TextLabel
	local element = Instance.new("TextLabel")
	element.Size = options.size
	element.Position = options.position or UDim2.new(0, 0, 0, 0)
	element.BackgroundTransparency = 1
	element.Font = Theme.FONT
	element.TextScaled = false
	element.TextSize = options.textSize or Theme.TEXT_SIZE.BODY
	element.TextColor3 = options.color or Theme.TEXT
	element.TextXAlignment = options.align or Enum.TextXAlignment.Left
	element.TextWrapped = options.wrapped or false
	element.LayoutOrder = options.layoutOrder or 0
	element.Text = options.text or ""
	element.Parent = parent
	return element
end

export type ButtonOptions = {
	size: UDim2,
	position: UDim2?,
	text: string,
	base: Color3,
	edge: Color3,
	textColor: Color3?,
	textSize: number?,
	layoutOrder: number?,
}

-- Knopf mit dunklerer Unterkante. Beim Druecken rutscht die Oberseite auf
-- die Kante - dieselbe Bewegung, die ein echter Tastenanschlag macht.
-- Ohne diese Rueckmeldung fuehlt sich auf dem Handy nichts an, weil es
-- keinen Hover-Zustand gibt.
function UiKit.button(parent: Instance, options: ButtonOptions): TextButton
	local holder = Instance.new("Frame")
	holder.Size = options.size
	holder.Position = options.position or UDim2.new(0, 0, 0, 0)
	holder.BackgroundColor3 = options.edge
	holder.BorderSizePixel = 0
	holder.LayoutOrder = options.layoutOrder or 0
	round(holder)

	local button = Instance.new("TextButton")
	button.Size = UDim2.new(1, 0, 1, -Theme.BUTTON_EDGE_HEIGHT)
	button.Position = UDim2.new(0, 0, 0, 0)
	button.BackgroundColor3 = options.base
	button.BorderSizePixel = 0
	button.AutoButtonColor = false -- eigene Rueckmeldung statt Roblox-Graufilter
	button.Font = Theme.FONT
	button.TextScaled = false
	button.TextSize = options.textSize or Theme.TEXT_SIZE.BODY
	button.TextColor3 = options.textColor or Theme.INK
	button.Text = options.text
	round(button)
	-- Verlauf oben heller, dazu dieselbe Tinten-Umrandung wie die Panels.
	-- Zusammen mit der dunkleren Unterkante im Halter ergibt das drei
	-- Tiefenebenen ohne einen einzigen Schatten.
	UiKit.gradient(button, UiKit.lift(options.base), options.base)
	UiKit.stroke(button, Theme.INK, Theme.OUTLINE_THICKNESS)

	local raised = UDim2.new(0, 0, 0, 0)
	local pressed = UDim2.new(0, 0, 0, Theme.BUTTON_EDGE_HEIGHT)
	button.MouseButton1Down:Connect(function()
		button.Position = pressed
	end)
	button.MouseButton1Up:Connect(function()
		button.Position = raised
	end)
	-- Wer den Finger neben dem Knopf loslaesst, bekommt kein MouseButton1Up.
	button.MouseLeave:Connect(function()
		button.Position = raised
	end)

	button.Parent = holder
	holder.Parent = parent
	return button
end

-- Farbe eines bestehenden Knopfes umsetzen (Zustaende des Schild-Knopfes).
-- Die Kante sitzt im Halter darunter, deshalb beide.
function UiKit.setButtonColors(button: TextButton, base: Color3, edge: Color3)
	button.BackgroundColor3 = base
	local holder = button.Parent
	if holder and holder:IsA("Frame") then
		holder.BackgroundColor3 = edge
	end
	-- Ohne das behaelt ein umgefaerbter Knopf den Verlauf der alten Farbe.
	local gradient = button:FindFirstChildOfClass("UIGradient")
	if gradient then
		gradient.Color = ColorSequence.new(UiKit.lift(base), base)
	end
end

-- Untereinander-Layout mit gleichmaessigem Abstand und Innenrand.
function UiKit.stack(parent: Instance, padding: number?)
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, padding or Theme.SPACE.S)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = parent

	local inset = Instance.new("UIPadding")
	local space = UDim.new(0, Theme.SPACE.M)
	inset.PaddingTop = space
	inset.PaddingBottom = space
	inset.PaddingLeft = space
	inset.PaddingRight = space
	inset.Parent = parent

	return layout
end

-- Nur Layout, kein Innenrand - fuer Listen in einer Scrollflaeche und fuer
-- Reihen, die von links nach rechts laufen.
function UiKit.column(parent: Instance, padding: number?): UIListLayout
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, padding or Theme.SPACE.S)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = parent
	return layout
end

export type KeycapOptions = {
	size: UDim2,
	position: UDim2?,
	rarity: string,
	letter: string?,
	layoutOrder: number?,
}

-- Kleine Taste als Bild: Unterkante in der Kantenfarbe, Oberseite mit
-- linearem Verlauf, Buchstabe in der dunklen Seltenheitsfarbe. Gleiche
-- Bauweise wie die Knoepfe, damit der Laden zur Welt passt.
function UiKit.keycap(parent: Instance, options: KeycapOptions): Frame
	local base = Theme.RARITY_COLORS[options.rarity] or Theme.PANEL
	local edge = Theme.RARITY_EDGE[options.rarity] or Theme.PANEL_EDGE
	local ink = Theme.RARITY_INK[options.rarity] or Theme.TEXT
	local level = Theme.RARITY_RANK[options.rarity] or 1

	local holder = Instance.new("Frame")
	holder.Size = options.size
	holder.Position = options.position or UDim2.new(0, 0, 0, 0)
	holder.BackgroundColor3 = edge
	holder.BorderSizePixel = 0
	holder.LayoutOrder = options.layoutOrder or 0
	round(holder)

	local top = Instance.new("Frame")
	top.Size = UDim2.new(1, -Theme.SPACE.S, 1, -Theme.KEYCAP_EDGE)
	top.Position = UDim2.new(0, Theme.SPACE.XS, 0, 0)
	top.BackgroundColor3 = base
	top.BorderSizePixel = 0
	round(top)
	-- Derselbe Aufhell-Faktor wie bei den Knoepfen. Vorher stand hier ein
	-- eigener Wert (0.3 Richtung Weiss) - damit waren Tasten im Laden
	-- anders hell als Knoepfe daneben.
	UiKit.gradient(top, UiKit.lift(base), base, 90)
	top.Parent = holder

	local letter = Instance.new("TextLabel")
	letter.Size = UDim2.new(1, 0, 1, 0)
	letter.BackgroundTransparency = 1
	letter.Font = Theme.FONT
	letter.TextScaled = true
	letter.TextColor3 = ink
	letter.Text = options.letter or "A"
	letter.Parent = top

	-- Legendary bekommt zusaetzlich einen Rahmen mit Verlauf. Ein Rahmen
	-- darf einen Verlauf haben, eine Flaeche kein Leuchten - das ist in
	-- Roblox-UI der einzige Weg, "es leuchtet" zu sagen.
	if level &gt;= 5 then
		local rim = UiKit.stroke(holder, edge, 3)
		UiKit.gradient(rim, Theme.GOLD, edge, 90)
	end

	holder.Parent = parent
	return holder
end

-- Fuenf Punkte, davon so viele gefuellt wie der Rang. Die Seltenheit muss
-- ohne Lesen erkennbar sein, und Farbe allein reicht auf einem billigen
-- Display in der Sonne nicht.
function UiKit.pips(parent: Instance, options: { rarity: string, position: UDim2 }): Frame
	local level = Theme.RARITY_RANK[options.rarity] or 1
	local fill = Theme.RARITY_EDGE[options.rarity] or Theme.PANEL_EDGE

	local row = Instance.new("Frame")
	row.BackgroundTransparency = 1
	row.Size = UDim2.new(0, Theme.PIP * 5 + Theme.PIP_GAP * 4, 0, Theme.PIP)
	row.Position = options.position
	UiKit.column(row, Theme.PIP_GAP).FillDirection = Enum.FillDirection.Horizontal

	for index = 1, 5 do
		local pip = Instance.new("Frame")
		pip.Size = UDim2.new(0, Theme.PIP, 0, Theme.PIP)
		pip.BorderSizePixel = 0
		pip.LayoutOrder = index
		pip.BackgroundColor3 = if index &lt;= level then fill else Theme.PANEL_EDGE
		pip.BackgroundTransparency = if index &lt;= level then 0 else 0.55
		round(pip, UDim.new(0, Theme.PIP_CORNER))
		pip.Parent = row
	end

	row.Parent = parent
	return row
end

export type SpeedBarOptions = {
	size: UDim2,
	position: UDim2?,
	marks: { number },
}

-- Tempo-Balken mit Markierungen an den Stage-Toren: der Spieler soll
-- sehen, wie weit er kommt, ohne zwei Zahlen zu vergleichen.
function UiKit.speedBar(parent: Instance, options: SpeedBarOptions)
	local track = Instance.new("Frame")
	track.Size = options.size
	track.Position = options.position or UDim2.new(0, 0, 0, 0)
	track.BackgroundColor3 = Theme.PANEL_EDGE
	track.BorderSizePixel = 0
	track.ClipsDescendants = true
	round(track, UDim.new(1, 0))

	local fill = Instance.new("Frame")
	fill.Size = UDim2.new(0, 0, 1, 0)
	fill.BackgroundColor3 = Theme.GREEN
	fill.BorderSizePixel = 0
	round(fill, UDim.new(1, 0))
	UiKit.gradient(fill, Theme.GREEN, Theme.GOLD, 0)
	fill.Parent = track

	for _, fraction in options.marks do
		local mark = Instance.new("Frame")
		mark.Size = UDim2.new(0, Theme.BAR_MARK_WIDTH, 1, 0)
		mark.Position = UDim2.new(fraction, -Theme.BAR_MARK_WIDTH / 2, 0, 0)
		mark.BackgroundColor3 = Theme.TEXT
		mark.BorderSizePixel = 0
		mark.ZIndex = 2
		mark.Parent = track
	end

	track.Parent = parent

	local api = {}
	function api.set(fraction: number)
		TweenService:Create(fill, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = UDim2.new(math.clamp(fraction, 0, 1), 0, 1, 0),
		}):Play()
	end
	return api
end

-- Die Vorrat-Zahl muss beim Wachsen spuerbar sein: 90 ms hoch auf 1.08,
-- 130 ms zurueck. Kurz genug, dass es bei jedem Tick nicht nervt.
function UiKit.bump(target: GuiObject)
	local scale = Instance.new("UIScale")
	scale.Parent = target
	local up = TweenService:Create(scale, TweenInfo.new(0.09, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Scale = Theme.BUMP_SCALE,
	})
	local down = TweenService:Create(scale, TweenInfo.new(0.13, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
		Scale = 1,
	})
	up.Completed:Connect(function()
		down:Play()
	end)
	return function()
		up:Play()
	end
end

-- Steigende Plus-Zahl: macht den Zuwachs sichtbar, ohne die grosse Zahl zu
-- stoeren. Steigt FLOAT_RISE Pixel in 700 ms und blendet dabei aus.
function UiKit.floatUp(parent: Instance, options: { text: string, position: UDim2, color: Color3? })
	local label = UiKit.text(parent, {
		size = UDim2.new(0, 140, 0, 26),
		position = options.position,
		text = options.text,
		textSize = Theme.TEXT_SIZE.BODY,
		color = options.color or Theme.GREEN_TEXT,
	})
	label.ZIndex = 5

	local target = UDim2.new(
		options.position.X.Scale,
		options.position.X.Offset,
		options.position.Y.Scale,
		options.position.Y.Offset - Theme.FLOAT_RISE
	)
	TweenService:Create(label, TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Position = target,
		TextTransparency = 1,
	}):Play()
	task.delay(0.8, function()
		label:Destroy()
	end)
end

-- Endlos wandernder Balken. Auf jeder Onboarding-Karte muss sich etwas
-- bewegen - ein neuer Spieler darf nie auf einen Text starren, der
-- stillsteht.
function UiKit.crawler(parent: Instance, color: Color3): Frame
	local bar = Instance.new("Frame")
	bar.Size = UDim2.new(0, Theme.CRAWLER_WIDTH, 0, Theme.CRAWLER_HEIGHT)
	bar.Position = UDim2.new(0, 0, 1, -Theme.CRAWLER_HEIGHT)
	bar.BackgroundColor3 = color
	bar.BorderSizePixel = 0
	bar.Parent = parent

	TweenService:Create(
		bar,
		TweenInfo.new(2.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
		{ Position = UDim2.new(1, -Theme.CRAWLER_WIDTH, 1, -Theme.CRAWLER_HEIGHT) }
	):Play()
	return bar
end

-- Schritt-Punkte des Onboardings: zeigt, dass es endlich ist.
function UiKit.dots(parent: Instance, options: { count: number, position: UDim2 })
	local row = Instance.new("Frame")
	row.BackgroundTransparency = 1
	row.Size = UDim2.new(0, options.count * Theme.PIP + (options.count - 1) * Theme.PIP_GAP, 0, Theme.PIP)
	row.Position = options.position
	UiKit.column(row, Theme.PIP_GAP).FillDirection = Enum.FillDirection.Horizontal

	local dots: { Frame } = {}
	for index = 1, options.count do
		local dot = Instance.new("Frame")
		dot.Size = UDim2.new(0, Theme.PIP, 0, Theme.PIP)
		dot.BorderSizePixel = 0
		dot.LayoutOrder = index
		dot.BackgroundColor3 = Theme.PANEL_EDGE
		round(dot, UDim.new(1, 0))
		dot.Parent = row
		table.insert(dots, dot)
	end
	row.Parent = parent

	local api = {}
	function api.set(step: number)
		for index, dot in dots do
			dot.BackgroundColor3 = if index &lt;= step then Theme.GREEN else Theme.PANEL_EDGE
		end
	end
	return api
end

-- Serverweite Zeile. Faehrt ein, bleibt BANNER_SECONDS, faehrt aus. Farbe
-- kommt aus der Seltenheit, damit man ohne Lesen weiss, wie fett der Klau
-- war.
function UiKit.banner(parent: Instance, position: UDim2)
	local hidden = UDim2.new(position.X.Scale, position.X.Offset, 0, -Theme.BANNER_HEIGHT)

	local holder = Instance.new("Frame")
	holder.Size = UDim2.new(0, Theme.BANNER_WIDTH, 0, Theme.BANNER_HEIGHT)
	holder.Position = hidden
	holder.BackgroundColor3 = Theme.GOLD
	holder.BorderSizePixel = 0
	holder.Visible = false
	holder.ZIndex = 4
	round(holder)
	local stroke = UiKit.stroke(holder, Theme.GOLD_DARK, 3)

	local label = UiKit.text(holder, {
		size = UDim2.new(1, -Theme.SPACE.XL, 1, 0),
		position = UDim2.new(0, Theme.SPACE.M, 0, 0),
		textSize = Theme.TEXT_SIZE.BODY,
		align = Enum.TextXAlignment.Center,
	})
	holder.Parent = parent

	local token = 0
	return function(text: string, rarity: string?)
		local base = if rarity then Theme.RARITY_COLORS[rarity] else nil
		local edge = if rarity then Theme.RARITY_EDGE[rarity] else nil
		local ink = if rarity then Theme.RARITY_INK[rarity] else nil
		holder.BackgroundColor3 = base or Theme.GOLD
		stroke.Color = edge or Theme.GOLD_DARK
		label.TextColor3 = ink or Theme.GOLD_TEXT
		label.Text = text

		token += 1
		local mine = token
		holder.Visible = true
		holder.Position = hidden
		TweenService:Create(holder, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Position = position,
		}):Play()

		task.delay(Theme.BANNER_SECONDS, function()
			if token ~= mine then
				return
			end
			TweenService:Create(holder, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
				Position = hidden,
			}):Play()
			task.delay(0.25, function()
				if token == mine then
					holder.Visible = false
				end
			end)
		end)
	end
end

-- Grosse Einblendung fuer Klau und Auszahlung.
--
-- Die Flaeche bleibt creme-weiss, die Farbe steckt in Kante, Kopfbalken
-- und Schrift: Rot als Textfarbe schafft auf dem Panel 4,9:1, dunkle
-- Schrift auf einer roten Flaeche nur 3,6:1. Rot ist im Theme
-- ausdruecklich "nur fuer Flaechen" - also traegt hier der Balken das Rot
-- und nicht der Text.
function UiKit.alert(parent: Instance)
	local shown = UDim2.new(0.5, -Theme.ALERT_WIDTH / 2, 0.2, 0)

	local card = UiKit.panel(parent, UDim2.new(0, Theme.ALERT_WIDTH, 0, Theme.ALERT_HEIGHT), shown)
	card.Visible = false
	card.ZIndex = 6
	card.ClipsDescendants = true
	-- Panel bringt seine Kante schon mit: umfaerben, nicht verdoppeln.
	local stroke = card:FindFirstChildOfClass("UIStroke") or UiKit.stroke(card, Theme.RED_DARK, 4)
	stroke.Color = Theme.RED_DARK
	stroke.Thickness = 4

	local bar = Instance.new("Frame")
	bar.Size = UDim2.new(1, 0, 0, Theme.ALERT_BAR)
	bar.BackgroundColor3 = Theme.RED
	bar.BorderSizePixel = 0
	bar.Parent = card

	local title = UiKit.text(card, {
		size = UDim2.new(1, -Theme.SPACE.XL, 0, 68),
		position = UDim2.new(0, Theme.SPACE.M, 0, Theme.SPACE.L),
		textSize = Theme.TEXT_SIZE.TITLE,
		color = Theme.RED_TEXT,
		align = Enum.TextXAlignment.Center,
	})
	local body = UiKit.text(card, {
		size = UDim2.new(1, -Theme.SPACE.XL, 0, 52),
		position = UDim2.new(0, Theme.SPACE.M, 0, 96),
		textSize = Theme.TEXT_SIZE.LEAD,
		align = Enum.TextXAlignment.Center,
		wrapped = true,
	})
	local bumpTitle = UiKit.bump(title)

	local token = 0
	return function(kind: string, titleText: string, bodyText: string)
		local cashout = kind == "cashout"
		stroke.Color = if cashout then Theme.GOLD_DARK else Theme.RED_DARK
		bar.BackgroundColor3 = if cashout then Theme.GOLD else Theme.RED
		title.TextColor3 = if cashout then Theme.GOLD_TEXT else Theme.RED_TEXT
		title.TextSize = if cashout then Theme.TEXT_SIZE.BLAST else Theme.TEXT_SIZE.TITLE
		title.Text = titleText
		body.Text = bodyText

		card.Visible = true
		card.Position = shown
		bumpTitle()

		-- Ruettler beim Klau: zwei kurze Ausschlaege, dann steht die Karte.
		if not cashout then
			local left = UDim2.new(0.5, -Theme.ALERT_WIDTH / 2 - Theme.SPACE.S, 0.2, 0)
			local right = UDim2.new(0.5, -Theme.ALERT_WIDTH / 2 + Theme.SPACE.S, 0.2, 0)
			task.spawn(function()
				for _, target in { left, right, shown } do
					TweenService:Create(card, TweenInfo.new(0.06, Enum.EasingStyle.Linear), {
						Position = target,
					}):Play()
					task.wait(0.07)
				end
			end)
		end

		token += 1
		local mine = token
		task.delay(Theme.ALERT_SECONDS, function()
			if token == mine then
				card.Visible = false
			end
		end)
	end
end

export type KeyRowOptions = {
	rarity: string,
	letter: string,
	title: string,
	rateText: string,
	priceText: string,
	layoutOrder: number?,
}

-- Eine Ladenzeile. Die Seltenheit steht viermal drin, ohne dass man ein
-- Wort lesen muss: Farbe, Rahmenstaerke, Punkte und Hoehe der Taste.
function UiKit.keyRow(parent: Instance, options: KeyRowOptions): TextButton
	local level = Theme.RARITY_RANK[options.rarity] or 1
	local edge = Theme.RARITY_EDGE[options.rarity] or Theme.PANEL_EDGE
	local pad = Theme.SPACE.M

	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, -(Theme.SCROLLBAR + Theme.SPACE.XS), 0, Theme.SHOP_ROW_HEIGHT)
	row.BackgroundColor3 = Theme.PANEL
	row.BorderSizePixel = 0
	row.LayoutOrder = options.layoutOrder or 0
	round(row)
	UiKit.stroke(row, edge, Theme.SHOP_ROW_STROKE + level)

	local thumbHeight = Theme.KEY_THUMB - (5 - level) * Theme.KEY_THUMB_STEP
	UiKit.keycap(row, {
		size = UDim2.new(0, Theme.KEY_THUMB, 0, thumbHeight),
		-- unten ausgerichtet: die Hoehenleiter der Seltenheiten ist im
		-- Laden dieselbe wie auf dem Plot.
		position = UDim2.new(0, pad, 0, Theme.SHOP_ROW_HEIGHT - pad - thumbHeight),
		rarity = options.rarity,
		letter = options.letter,
	})

	local textLeft = pad + Theme.KEY_THUMB + Theme.SPACE.M
	local textWidth = -(textLeft + Theme.SHOP_BUY_WIDTH + pad * 2)
	UiKit.text(row, {
		size = UDim2.new(1, textWidth, 0, 24),
		position = UDim2.new(0, textLeft, 0, Theme.SPACE.M),
		textSize = Theme.TEXT_SIZE.BODY,
		text = options.title,
	})
	UiKit.pips(row, {
		rarity = options.rarity,
		position = UDim2.new(0, textLeft, 0, 42),
	})
	UiKit.text(row, {
		size = UDim2.new(1, textWidth, 0, 20),
		position = UDim2.new(0, textLeft, 0, 58),
		textSize = Theme.TEXT_SIZE.SMALL,
		color = Theme.TEXT_MUTED,
		text = options.rateText,
	})

	local buy = UiKit.button(row, {
		size = UDim2.new(0, Theme.SHOP_BUY_WIDTH, 0, Theme.TOUCH_MIN),
		position = UDim2.new(1, -(Theme.SHOP_BUY_WIDTH + pad), 0, (Theme.SHOP_ROW_HEIGHT - Theme.TOUCH_MIN) / 2),
		text = options.priceText,
		base = Theme.GREEN,
		edge = Theme.GREEN_DARK,
	})

	row.Parent = parent
	return buy
end

-- Skaliert das ganze HUD fuer kleine Bildschirme. Ohne das ist das HUD auf
-- dem Handy zu gross und verdeckt das Spiel.
function UiKit.autoScale(gui: ScreenGui): UIScale
	local scale = Instance.new("UIScale")
	scale.Parent = gui

	local camera = workspace.CurrentCamera

	local function apply()
		local viewport = if camera then camera.ViewportSize else Vector2.new(Theme.SCALE_REFERENCE_WIDTH, 720)
		local factor = viewport.X / Theme.SCALE_REFERENCE_WIDTH
		scale.Scale = math.clamp(factor, Theme.SCALE_MIN, Theme.SCALE_MAX)
	end

	apply()
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(apply)
	end
	return scale
end

return UiKit
</ProtectedString>
</Properties>
</Item>
</Item>
</Item>
</Item>
</roblox>
